AIJ.addJoker {
  key = 'animatronic',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 12, y = 7 },
  config = { handsize_mod = 1, handsize = 0, cap = 4 },
  vars = function(card)
    local id = 'animatronic'
    return { AIJ.val(card, id, 'handsize_mod'), AIJ.val(card, id, 'handsize'), AIJ.val(card, id, 'cap') }
  end,
  blueprint_compat = false,
  onAdded = function(joker, state) state.handSize = state.handSize + AIJ.num(joker, 'handsize') end,
  onRemoved = function(joker, state) state.handSize = state.handSize - AIJ.num(joker, 'handsize') end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local size = AIJ.num(joker, 'handsize')
      if step.hand.contains and step.hand.contains.STRAIGHT then
        if size < AIJ.num(joker, 'cap') then
          local d = math.min(AIJ.num(joker, 'handsize_mod'), AIJ.num(joker, 'cap') - size)
          AIJ.set(joker, 'handsize', size + d)
          state.handSize = state.handSize + d
          result:say('+' .. AIJ.fmt(d) .. ' Hand Size', colors.ORANGE)
        end
      elseif size > 0 then
        state.handSize = state.handSize - size
        AIJ.set(joker, 'handsize', 0)
        result:say('Reset', colors.RED)
      end
    end,
  },
}

