    ["j_aij_cheddar_credits_joker"] = { name = "Cheddar", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_cheerio"] = { name = "Cheerio", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points, loses [color=\"#3772ff\"][b]Points[/b][/color] equal to [color=\"#f3a712\"][b]money[/b][/color] spent [color=\"#1bb18c\"][b]rerolling[/b][/color]" },
    ["j_aij_cheese_squigglies"] = { name = "Cheese Squigglies", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult per [color=\"#1bb18c\"][b]reroll[/b][/color] in the Shop, [color=\"#f3a712\"][b]eaten[/b][/color] after [color=\"#f3a712\"][b]#4#[/b][/color] rerolls\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult, [/color][color=\"#f3a712\"][b]#3#[/b][/color][color=\"#9a9a9a\"]/[/color][color=\"#f3a712\"][b]#4#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_chef"] = { name = "Chef", text = "[color=\"#f3a712\"][b]Timed [/b][/color][color=\"#009dff\"][b]Common[/b][/color] Jokers are [color=\"#5d5dff\"][b]Inverted[/b][/color] and [color=\"#f3a712\"][b]free[/b][/color]" },
