== file jokers/batch03.lua (1806 lines)
local AIJ = cardlike.require('lib.aij')

local ENHANCED = '#8389dd'

local function grey(text) return colorize(text, colors.GREY) end

local function owned(id)
  local out = {}
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function rankOf(card)
  if AIJ.noRank(card) then return nil end
  return AIJ.safe(card.getRank, card)
end

local function isSuit(card, suit)
  if AIJ.noRank(card) then return false end
  return AIJ.isSuit(card, suit) == true
end

local function isFace(card)
  return AIJ.safe(card.isFace, card) == true
end

local function msg(key, fallback, v1)
  return AIJ.fill(AIJ.msg(key, fallback), { v1 })
end

local function fixCardWords(text)
  return (text:gsub('(%a+) card(%[/b%]%[/color%]) [Cc]ard(s?)', '%1 card%3%2'))
end

local function withNote(key, varsFn, note)
  local d = AIJ.desc('Joker', 'j_aij_' .. key, varsFn)
  return function(r)
    local text = fixCardWords(type(d) == 'function' and d(r) or d)
    local n = type(note) == 'function' and note(r and r.card) or note
    if n and n ~= '' then text = text .. '\n' .. grey(n) end
    return text
  end
end

local function jokerName(id)
  if not id or id == '' then return 'None' end
  local info = cardlike.contentInfo('joker', id)
  return info and info.name or AIJ.short(id)
end

local BUILTIN_ENHANCEMENTS = { 'Chipped', 'Multicard', 'Fragile', 'Wooden', 'Rock', 'Gilded', 'Paperback', 'Plaid' }
local function randomEnhancement(state)
  local list, seen = {}, { Default = true, Prismatic = true }
  for _, e in ipairs(BUILTIN_ENHANCEMENTS) do list[#list + 1] = e; seen[e] = true end
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id and not seen[e.id] then list[#list + 1] = e.id; seen[e.id] = true end
  end
  return AIJ.pick(list, state)
end

local function isInverted(card)
  return AIJ.hasEdition(card, 'e_negative')
end

local FRUIT_HAND = {
  fruit_card_0 = 'STRAIGHT', fruit_card_1 = 'FULL_HOUSE', fruit_card_2 = 'TWO_PAIR', fruit_card_3 = 'HIGH_CARD',
  fruit_card_4 = 'PAIR', fruit_card_5 = 'THREE_OF_A_KIND', fruit_card_6 = 'FLUSH_HOUSE', fruit_card_7 = 'FLUSH_FIVE',
  fruit_card_8 = 'FIVE_OF_A_KIND', fruit_card_9 = 'FOUR_OF_A_KIND', fruit_card_10 = 'FLUSH', fruit_card_11 = 'STRAIGHT_FLUSH',
}

local function consumableType(card)
  local info = card and card.lastInfo or {}
  return info.type or AIJ.safe(card.getConsumableType, card)
end

local DEFS = {}

local function add(def)
  local full = AIJ.addJoker(def)
  if full then
    DEFS[full] = {
      triggers = def.triggers,
      copyable = not (def.copyable == false or def.blueprint_compat == false),
      description = def.description or AIJ.desc('Joker', 'j_aij_' .. def.key, def.vars),
      dollarsAtRoundEnd = def.dollarsAtRoundEnd,
      buttons = def.buttons,
    }
  end
  return full
end

local function defOf(id)
  if not id then return nil end
  return AIJ.jokerDefs[id] or DEFS[id]
end

local COPIERS = { 'borra', 'clay_joker', 'czar', 'dacosta', 'doodle', 'elder', 'error_404', 'first_draft', 'joker_png', 'whats_left' }
local function isCopier(id)
  for _, k in ipairs(COPIERS) do if AIJ.isId(id, k) then return true end end
  return false
end

local function copyableDef(card, self)
  if type(card) ~= 'table' or card == self or AIJ.isDebuffed(card) then return nil end
  local def = defOf(AIJ.defId(card))
  if not def or def.copyable == false or not def.triggers then return nil end
  return def
end

local COPY_TRIGGERS = {
  'beforeRound', 'drawInitialCards', 'beforeAllCardsScored', 'beforeScore', 'onScore', 'enhancementScore',
  'onScoreInHand', 'afterAllCardsScored', 'onOtherJoker', 'finalScoring', 'afterHand', 'onDiscard', 'afterRound',
  'repeatCard', 'repeatHeldCard', 'destroyCard', 'onDiscardCard',
  'onRoundStart', 'onHandDrawn', 'onConsumableUsed', 'onCardBought', 'onCardSold', 'onCardObtained', 'onShopEnter',
  'onShopExit', 'onShopReroll', 'onPackOpened', 'onPackSkipped', 'onBlindSkipped', 'onBossRerolled', 'onBlindDefeated',
  'onCashOut', 'onAnteChanged', 'onMoneyChanged', 'onCardsAdded', 'onCardsRemoved', 'onCardsDestroyed',
}
local COUNT_RETURN = { repeatCard = true, repeatHeldCard = true }
local BOOL_RETURN = { destroyCard = true, onDiscardCard = true }

local function combine(name, a, b)
  if COUNT_RETURN[name] then
    local n = (tonumber(a) or 0) + (tonumber(b) or 0)
    return n > 0 and n or nil
  end
  if BOOL_RETURN[name] then return (a == true or b == true) or nil end
  return nil
end

local busy = {}
local function runCopies(name, joker, state, step, result, targets)
  if not targets or #targets == 0 or type(joker) ~= 'table' then return nil end
  local key = joker.uid or joker
  if busy[key] then return nil end
  busy[key] = true
  local total, any = 0, false
  local ok, err = pcall(function()
    for _, t in ipairs(targets) do
      local fn = t.def and t.def.triggers and t.def.triggers[name]
      if fn then
        local s = {}
        for k, v in pairs(step or {}) do s[k] = v end
        if not t.own then s.copiedBy = (step and step.copiedBy) or joker end
        local destroyed = result and result.destroyed
        local r = fn(t.card, state, s, result)
        if result and not t.own then result.destroyed = destroyed end
        if type(r) == 'number' then total = total + r elseif r == true then any = true end
      end
    end
  end)
  busy[key] = nil
  if not ok then error(err, 0) end
  if COUNT_RETURN[name] then return total > 0 and total or nil end
  if BOOL_RETURN[name] then return any or nil end
  return nil
end

local function copierTriggers(targetsFn, own, skip)
  own = own or {}
  local t = {}
  for _, name in ipairs(COPY_TRIGGERS) do
    local mine = own[name]
    if skip and skip[name] then
      t[name] = mine
    else
      t[name] = function(joker, state, step, result)
        local a = mine and mine(joker, state, step, result) or nil
        local b = runCopies(name, joker, state, step, result, targetsFn(joker, state) or {})
        return combine(name, a, b)
      end
    end
  end
  for name, fn in pairs(own) do if t[name] == nil then t[name] = fn end end
  return t
end

local function neighbourTargets(joker)
  local jokers = cardlike.cards('jokers') or {}
  local i
  for k, j in ipairs(jokers) do if j == joker then i = k break end end
  local out = {}
  if not i then return out end
  for _, n in ipairs({ jokers[i - 1], jokers[i + 1] }) do
    local def = copyableDef(n, joker)
    if def then out[#out + 1] = { card = n, def = def } end
  end
  return out
end

local function jokerByUid(uid)
  if not uid then return nil end
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if tostring(j.uid) == tostring(uid) then return j end
  end
  return nil
end

local COPY_POOL = { 'clay_joker', 'czar', 'doodle', 'elder', 'error_404', 'first_draft', 'joker_png', 'whats_left' }
local function copyJokerPool(state)
  local list = {}
  for _, k in ipairs({ 'j_blueprint', 'j_brainstorm' }) do
    local v = AIJ.vanilla(k)
    if v and not state:hasJoker(v) then list[#list + 1] = v end
  end
  for _, k in ipairs(COPY_POOL) do
    if AIJ.has(k, 'joker') and AIJ.jokerRarity[AIJ.id(k)] ~= 'Legendary' and not state:hasJoker(AIJ.id(k)) then
      list[#list + 1] = AIJ.id(k)
    end
  end
  return list
end

add {
  key = 'copycat',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 23, y = 40 },
  config = { rounds_held = 0, total_rounds = 3 },
  vars = function(card)
    return { AIJ.val(card, 'copycat', 'rounds_held'), AIJ.val(card, 'copycat', 'total_rounds') }
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = AIJ.add(joker, 'rounds_held', 1)
      local total = AIJ.num(joker, 'total_rounds')
      if n < total then result:say(AIJ.fmt(n) .. '/' .. AIJ.fmt(total), colors.ORANGE)
      elseif n == total then result:say(AIJ.msg('k_active_ex', 'Active!'), colors.ORANGE) end
    end,
    onSold = function(joker, state, step, result)
      if AIJ.num(joker, 'rounds_held') < AIJ.num(joker, 'total_rounds') then return end
      local pool = copyJokerPool(state)
      local id = AIJ.pick(pool, state)
      if not id then id = AIJ.has('error_404', 'joker') and AIJ.id('error_404') or AIJ.vanilla('j_blueprint') end
      cardlike.createJoker(id, { force = true })
    end,
  },
}

add {
  key = 'corndog',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 24 },
  blueprint_compat = false,
  config = { hands = 10 },
  vars = function(card) return { AIJ.val(card, 'corndog', 'hands') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = AIJ.add(joker, 'hands', -1)
      result:say(n > 0 and (AIJ.fmt(n) .. ' left') or AIJ.msg('k_aij_change_ex', 'Change!'), colors.ORANGE)
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.num(joker, 'hands') <= 0 then
        result:destroySelf()
        result:say(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.RED)
      end
    end,
  },
}

cardlike.filter('handType', function(value)
  if type(value) ~= 'table' or value.handType == 'STRAIGHT_FLUSH' then return nil end
  if #owned('corndog') == 0 then return nil end
  return { handType = 'STRAIGHT_FLUSH', scoring = value.scoring }
end)

local function memphisRemove(joker, state)
  local n = AIJ.num(joker, 'pending_slots')
  if n > 0 and state and state.cardsAvailableInShopCount then
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount - n
  end
  AIJ.set(joker, 'pending_slots', 0)
end

add {
  key = 'corporate_memphis',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 43 },
  blueprint_compat = false,
  config = { bonus_slots = 2, pending_slots = 0 },
  vars = function(card)
    return { AIJ.val(card, 'corporate_memphis', 'bonus_slots'), AIJ.val(card, 'corporate_memphis', 'pending_slots') }
  end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = AIJ.num(joker, 'bonus_slots')
      state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + n
      AIJ.add(joker, 'pending_slots', n)
      result:say(msg('a_aij_slots', '+#1# Slots', n), colors.CHIPS)
    end,
    onShopExit = function(joker, state, step, result)
      if step.copiedBy then return end
      memphisRemove(joker, state)
    end,
  },
  onRemoved = function(joker, state) memphisRemove(joker, state) end,
}

add {
  key = 'corpse_paint',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 8 },
  blueprint_compat = false,
  config = { odds = 2, hand_size = 1, max_hand_size = 0 },
  vars = function(card)
    return { AIJ.prob(), AIJ.val(card, 'corpse_paint', 'odds'), AIJ.val(card, 'corpse_paint', 'hand_size'),
      AIJ.val(card, 'corpse_paint', 'max_hand_size') }
  end,
  in_pool = function(state)
    for _, c in ipairs(state and state.allCards or {}) do
      if isInverted(c) then return true end
    end
    return false
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or not isInverted(step.card) then return end
      step.card:setEdition('default')
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then
        local n = AIJ.num(joker, 'hand_size')
        state.handSize = state.handSize + n
        AIJ.add(joker, 'max_hand_size', n)
        result:say('+' .. AIJ.fmt(n) .. ' Hand Size', colors.ORANGE)
      end
    end,
  },
  onRemoved = function(joker, state)
    local n = AIJ.num(joker, 'max_hand_size')
    if n ~= 0 then state.handSize = state.handSize - n end
  end,
}

local function coryatTicket(state)
  local list = {}
  for _, t in ipairs(cardlike.listContent('ticket') or {}) do
    local n = tonumber(tostring(t.id or ''):match('^ticket_(%d+)$'))
    if n and not state:hasTicket(t.id) and (n % 2 == 0 or state:hasTicket('ticket_' .. (n - 1))) then
      list[#list + 1] = t.id
    end
  end
  return AIJ.pick(list, state)
end

AIJ.onNewRun(function(run) run.coryat_offer = nil end)

local function coryatOffer(state)
  local offer = AIJ.run.coryat_offer
  if type(offer) ~= 'table' or offer.ante ~= state.ante then
    offer = { ante = state.ante, id = coryatTicket(state), bought = false }
    AIJ.run.coryat_offer = offer
  end
  if offer.id and not offer.bought and not state:hasTicket(offer.id) then cardlike.addShopItem(offer.id) end
end

add {
  key = 'coryat',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 9, y = 6 }, soul_pos = { x = 9, y = 7 },
  lite = true,
  blueprint_compat = false,
  config = { shop = 3, booster = 2, voucher = 1 },
  vars = function(card)
    return { AIJ.val(card, 'coryat', 'shop'), AIJ.val(card, 'coryat', 'booster'), AIJ.val(card, 'coryat', 'voucher') }
  end,
  onAdded = function(joker, state)
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + AIJ.num(joker, 'shop')
    state.packsAvailableInShopCount = state.packsAvailableInShopCount + AIJ.num(joker, 'booster')
  end,
  onRemoved = function(joker, state)
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount - AIJ.num(joker, 'shop')
    state.packsAvailableInShopCount = state.packsAvailableInShopCount - AIJ.num(joker, 'booster')
  end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      coryatOffer(state)
    end,
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      coryatOffer(state)
    end,
    onCardBought = function(joker, state, step, result)
      local offer = AIJ.run.coryat_offer
      if type(offer) == 'table' and step.card and AIJ.defId(step.card) == offer.id then offer.bought = true end
    end,
  },
}

local function cosmoBalance(state, result)
  if #owned('cosmological_constant') == 0 then return end
  local c, m = tonumber(state.currentChips) or 0, tonumber(state.currentMult) or 0
  local avg = math.floor((c + m) / 2)
  state.currentChips = avg
  state.currentMult = avg
  if result then result:say('Balanced!', AIJ.colors.PLASMA) end
end

local okPlanets, Planets = pcall(cardlike.require, 'items.planets')
if okPlanets and type(Planets) == 'table' and Planets.onHandBase then
  Planets.onHandBase(function(state, handType, result) cosmoBalance(state, result) end)
else
  local cosmoPending = false
  cardlike.on('beforeAllCardsScored', function() cosmoPending = true end)
  cardlike.on('beforeScore', function(state, step, result)
    if not cosmoPending then return end
    cosmoPending = false
    cosmoBalance(state, result)
  end)
end

