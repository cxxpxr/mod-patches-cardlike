local function consumableSellTotal(state)
  local total = 0
  for _, c in ipairs((state and state.consumables) or {}) do
    total = total + (tonumber(AIJ.safe(c.getSellValue, c)) or 0)
  end
  return total
end

add {
  key = 'candy_wrapper',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 6, y = 16 },
  config = { mult_per_dollar = 4 },
  vars = function(card)
    local per = AIJ.val(card, 'candy_wrapper', 'mult_per_dollar')
    return { per, card and per * consumableSellTotal(cardlike.state) or 0 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = consumableSellTotal(state) * AIJ.num(joker, 'mult_per_dollar')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local CAROUSEL = { { 'Hearts', 'Clubs' }, { 'Clubs', 'Diamonds' }, { 'Diamonds', 'Spades' }, { 'Spades', 'Hearts' } }
add {
  key = 'carousel',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 0 },
  triggers = {
    afterHand = function(joker, state, step, result)
      local n = 0
      for _, c in ipairs((step.hand and step.hand.playedCards) or {}) do
        if AIJ.exists(c) and not AIJ.noRank(c) then
          for _, pair in ipairs(CAROUSEL) do
            if c:isSuit(pair[1]) then
              c:setSuit(pair[2])
              c:punch()
              n = n + 1
              break
            end
          end
        end
      end
      if n > 0 then result:say('Spin!') end
    end,
  },
}

