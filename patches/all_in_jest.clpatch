    ["tag_aij_grand_astrologer"] = { name = "Grand Astrologer Pin", text = "The next used [color=\"#13afce\"][b]Fruit[/b][/color] card levels up all Poker hands [color=\"#f3a712\"][b]2-4[/b][/color] times" },
