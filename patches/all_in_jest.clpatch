AIJ.onNewRun(function(run) run.urchin_skips = 0 end)
cardlike.on('onBlindSkipped', function() AIJ.run.urchin_skips = (AIJ.run.urchin_skips or 0) + 1 end)

AIJ.addJoker {
  key = 'urchin',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 14, y = 9 },
  config = { money_mod = 2 },
  blueprint_compat = false,
  vars = function(card)
    local m = AIJ.val(card, 'urchin', 'money_mod')
    return { m * (AIJ.run.urchin_skips or 0), m }
  end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      if not step.copiedBy then result:say('Upgrade!', colors.ORANGE) end
    end,
  },
  dollarsAtRoundEnd = function(joker, state)
    return (AIJ.run.urchin_skips or 0) * AIJ.num(joker, 'money_mod')
  end,
}

AIJ.addJoker {
  key = 'valentine',
  lite = true,
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 20, y = 16 },
  config = { x_mult = 1.5 },
  vars = function(card) return { AIJ.val(card, 'valentine', 'x_mult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local count, pairs_ = {}, 0
      for _, c in ipairs(step.hand.allCards or {}) do
        local r = rankOf(c)
        if r then count[r] = (count[r] or 0) + 1 end
      end
      for _, n in pairs(count) do if n >= 2 then pairs_ = pairs_ + 1 end end
      if pairs_ > 0 then result:add(xMult(AIJ.num(joker, 'x_mult') * pairs_)) end
    end,
  },
}

local ERKKI_TIMINGS = { 'before', 'after_cards', 'joker_main', 'after_jokers' }

AIJ.addJoker {
  key = 'vanha_erkki',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 0, y = 32 },
  config = { chosen_timing = 'joker_main', xmult = 3 },
  vars = function(card) return { AIJ.val(card, 'vanha_erkki', 'xmult') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'chosen_timing', ERKKI_TIMINGS[state:random(1, #ERKKI_TIMINGS)])
    end,

    beforeScore = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if AIJ.get(joker, 'chosen_timing') == 'before' and step.firstTime and step.card == cards[1] then
        result:add(xMult(AIJ.num(joker, 'xmult')))
      end
    end,
    onScore = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if AIJ.get(joker, 'chosen_timing') == 'after_cards' and step.firstTime and step.card == cards[#cards] then
        result:add(xMult(AIJ.num(joker, 'xmult')))
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      if AIJ.get(joker, 'chosen_timing') == 'joker_main' then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
    finalScoring = function(joker, state, step, result)
      if AIJ.get(joker, 'chosen_timing') == 'after_jokers' then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

local VD_SPENT = 'aij_b10_vd_spent'
local vdShop = {}

local function vdSnapshot(state, skipUid)
  vdShop = {}
  for _, c in ipairs(state.shopCards or {}) do
    local info = c.lastInfo or {}
    if c.uid ~= skipUid then
      if info.kind == 'joker' and info.joker then vdShop[#vdShop + 1] = { kind = 'joker', id = info.joker }
      elseif info.kind == 'consumable' and info.consumable then vdShop[#vdShop + 1] = { kind = 'consumable', id = info.consumable } end
    end
  end
end

local function vdActive(state)
  local out = {}
  for _, j in ipairs(owned('vecchio_dolore', state)) do
    if AIJ.get(j, VD_SPENT) ~= true then out[#out + 1] = j end
  end
  return out
end

local function vdReDebuff(state)
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.is(j, 'vecchio_dolore') and AIJ.get(j, VD_SPENT) == true and not AIJ.isDebuffed(j) then
      AIJ.safe(j.setDebuffState, j, true)
    end
  end
end

cardlike.on('onShopEnter', function(state) vdReDebuff(state) if #vdActive(state) > 0 then vdSnapshot(state) end end)
cardlike.on('onRoundStart', function(state) vdReDebuff(state) end)
cardlike.on('onCardBought', function(state, step)
  if #vdActive(state) > 0 then vdSnapshot(state, step.card and step.card.uid) end
end)
cardlike.on('onShopReroll', function(state)
  local active = vdActive(state)
  if #active > 0 then
    for _, j in ipairs(active) do
      for _, item in ipairs(vdShop) do
        if item.kind == 'joker' then cardlike.createJoker(item.id, { edition = 'Inverted' })
        else cardlike.createConsumable(item.id, { edition = 'Inverted' }) end
      end
      AIJ.set(j, VD_SPENT, true)
      AIJ.safe(j.setDebuffState, j, true)
      j:popup('Disabled!', colors.ORANGE)
    end
  end
  if #vdActive(state) > 0 then vdSnapshot(state) end
end)

