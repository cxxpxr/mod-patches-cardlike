    ["j_aij_ultrasound"] = { name = "Ultrasound", text = "Selecting a [color=\"#f3a712\"][b]Pack[/b][/color] shows one of its contents" },
    ["j_aij_undead_joker"] = { name = "Undead Joker", text = "" },
    ["j_aij_unicursal_joker"] = { name = "Unicursal Joker", text = "" },
    ["j_aij_unobtanium"] = { name = "Unobtanium", text = "If played hand is [color=\"#f3a712\"][b]Five of a Kind[/b][/color], retrigger all scoring cards" },
