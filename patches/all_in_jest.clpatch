          local e = 'Multicard'
          if roll > 0.66 then e = 'Chipped' elseif roll > 0.33 then e = 'Paperback' end
          c:setEnhancement(e)
          c:punch()
          any = true
        end
      end
      if any then result:say(AIJ.msg('k_aij_change_ex', 'Change!'), colors.PURPLE) end
