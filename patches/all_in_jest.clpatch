  config = { consumable_slots = 3 },
  blueprint_compat = false,
  pools = { Food = true },
  vars = function(card) return { AIJ.val(card, 'totally_nuts', 'consumable_slots') } end,
  onAdded = function(joker, state)
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) + AIJ.num(joker, 'consumable_slots')
  end,
  onRemoved = function(joker, state)
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) - AIJ.num(joker, 'consumable_slots')
  end,
  triggers = {
    onCardSold = function(joker, state, step, result)
      if step.copiedBy or not step.card or kindOf(step.card) ~= 'consumable' then return end
      result:say('Eaten!', colors.ORANGE)
      result:destroySelf()
