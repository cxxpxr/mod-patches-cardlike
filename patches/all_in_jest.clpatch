local function jackWild(state) return AIJ.owns('jack_of_all_trades', state) end
AIJ.cardSuitIf(function(state, card, suit)
  if type(card) ~= 'table' or not jackWild(state) or AIJ.noRank(card) then return false end
  return (info(card).rank or AIJ.safe(card.getRank, card)) == 11
end)

local FLUSHED = {
  HIGH_CARD = 'FLUSH', PAIR = 'FLUSH', TWO_PAIR = 'FLUSH', THREE_OF_A_KIND = 'FLUSH', FOUR_OF_A_KIND = 'FLUSH',
  STRAIGHT = 'STRAIGHT_FLUSH', FULL_HOUSE = 'FLUSH_HOUSE', FIVE_OF_A_KIND = 'FLUSH_FIVE',
}
cardlike.filter('handType', function(value, cards)
  local state = cardlike.state
  if not state or type(value) ~= 'table' or not jackWild(state) then return nil end
  local to = FLUSHED[value.handType]
  if not to then return nil end
  cards = cards or {}
  local need = state:hasJoker(AIJ.vanilla('j_four_fingers') or 'joker_fourk') and 4 or 5
  if #cards < need then return nil end
  for _, suit in ipairs(AIJ.SUITS) do
    local n, uids = 0, {}
    for _, c in ipairs(cards) do
      local i = info(c)
      local isJack = not AIJ.noRank(c) and i.rank == 11
      if isJack or (i.suits and i.suits[suit]) then n = n + 1 uids[#uids + 1] = c.uid end
    end
    if n >= need then
      if to == 'STRAIGHT_FLUSH' then
        local low = 99
        for _, c in ipairs(cards) do low = math.min(low, info(c).rank or 0) end
        if low >= 10 and state.hands and state.hands.ROYAL_FLUSH then to = 'ROYAL_FLUSH' end
      end
      local scoring = {}
      local seen = {}
      for _, u in ipairs(value.scoring or {}) do scoring[#scoring + 1] = u seen[u] = true end
      for _, u in ipairs(uids) do if not seen[u] then scoring[#scoring + 1] = u end end
      return { handType = to, scoring = scoring }
    end
  end
  return nil
end)
