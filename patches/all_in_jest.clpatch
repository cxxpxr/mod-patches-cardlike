      result:say('+' .. AIJ.fmt(g) .. ' Mult', colors.MULT)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy or AIJ.num(joker, 'mult') <= 0 then return end
      AIJ.set(joker, 'mult', 0)
      result:say(AIJ.msg('k_reset', 'Reset'), colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

