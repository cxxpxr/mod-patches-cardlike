AIJ.addJoker {
  key = 'sky_trees', ignore = not AIJ.setting('moons_enabled'),
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 12 },
  blueprint_compat = false,
  description = colorize(bold('Fruit Stamps'), colors.ORANGE) .. ' create the '
    .. colorize(bold('Mult'), colors.MULT) .. ' and the ' .. colorize(bold('Points'), colors.CHIPS)
    .. ' ' .. colorize(bold('Moon'), AIJ.colors.PLANET) .. ' of the played hand in place of its '
    .. colorize(bold('Fruit card'), AIJ.colors.PLANET),
  in_pool = function(state) return deckHasStamp(state, 'Blue') end,
}

cardlike.on('afterHand', function(state, step)
  skyWindow = nil
  if not active(state, 'sky_trees') then return end
  if countCards(state.cardsInHand, function(c) return AIJ.hasStamp(c, 'Blue') end) > 0 then
    skyWindow = baseHand(step.hand and step.hand.handType)
  end
end)
cardlike.on('afterRound', function() skyWindow = nil end)
cardlike.on('onRoundStart', function() skyWindow = nil end)
cardlike.on('onCardObtained', function(state, step)
  local c = step.card
  if not skyWindow or type(c) ~= 'table' or not active(state, 'sky_trees') then return end
  local id = AIJ.defId(c)
  if not id or not tostring(id):find('^fruit_card_') or P.handOf(id) ~= skyWindow then return end
  local multMoon, chipsMoon = moonOf(skyWindow, 'mult'), moonOf(skyWindow, 'chips')
  if not multMoon or not AIJ.has(multMoon, 'consumable') then return end
  c:setConsumableDef(AIJ.id(multMoon))
  c:popup(AIJ.msg('k_aij_plus_two_moons', '+2 Moons'), AIJ.colors.PLANET)
  if chipsMoon and AIJ.has(chipsMoon, 'consumable') then cardlike.createConsumable(AIJ.id(chipsMoon)) end
end)

local skyPending = { hand = nil, levels = 0 }

AIJ.addJoker {
  key = 'skytower',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 5, y = 26 },
  config = { levels = 5 },
  vars = function(card) return { AIJ.val(card, 'skytower', 'levels') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      local t = step.hand.handType
      local most = playRanking(state, baseHand(t), 1)
      if most == baseHand(t) then return end
      local n = AIJ.num(joker, 'levels')
      if skyPending.hand and skyPending.hand ~= t then return end
      state:upgradeHand(t, n)
      skyPending.hand = t
      skyPending.levels = skyPending.levels + n
      result:say('+' .. AIJ.fmt(n) .. ' Levels', colors.ORANGE)
    end,
  },
}

local function skytowerUndo(state)
  if skyPending.hand and skyPending.levels ~= 0 and state then state:upgradeHand(skyPending.hand, -skyPending.levels) end
  skyPending.hand, skyPending.levels = nil, 0
end
cardlike.on('afterHand', function(state) skytowerUndo(state) end)
cardlike.on('onRoundStart', function(state) skytowerUndo(state) end)

