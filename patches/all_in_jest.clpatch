local VANILLA_ENHANCEMENTS = { 'm_bonus', 'm_mult', 'm_wild', 'm_glass', 'm_steel', 'm_gold', 'm_lucky' }
local VANILLA_STAMPS = { 'Red', 'Gold', 'Blue', 'Purple' }

local function nicholaEnhancements()
  local out = {}
  for _, k in ipairs(VANILLA_ENHANCEMENTS) do out[#out + 1] = AIJ.vanilla(k) end
  for _, k in ipairs(AIJ.lists.enhancements) do
    if k ~= 'canvas' and AIJ.has(k, 'enhancement') then out[#out + 1] = AIJ.id(k) end
  end
  return out
end

local function nicholaStamps()
  local out = {}
  for _, k in ipairs(VANILLA_STAMPS) do out[#out + 1] = AIJ.vanilla(k) end
  for _, k in ipairs(AIJ.lists.stamps) do
    if AIJ.has(k, 'stamp') then out[#out + 1] = AIJ.id(k) end
  end
  return out
end

AIJ.addJoker {
  key = 'nichola',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 6, y = 2 }, soul_pos = { x = 6, y = 3 }, lite = true,
  triggers = {
    drawInitialCards = function(joker, state, step, result)
      local card = cardlike.addPlayingCard({
        rank = 12,
        suit = AIJ.pick(AIJ.SUITS, state),
        enhancement = AIJ.pick(nicholaEnhancements(), state),
        edition = randomEdition(state, false),
        stamp = AIJ.pick(nicholaStamps(), state),
      }, { area = 'hand' })
      if card then result:say('+Queen') end
    end,
  },
}

AIJ.addJoker {
  key = 'nihilartikel',
