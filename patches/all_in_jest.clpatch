local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.tarots')

local P = {}

AIJ.onNewRun(function(run) run.moon_bonus = {} end)

local function bonusOf(h)
  local all = AIJ.run.moon_bonus or {}
  local b = all[h]
  return b and (b.chips or 0) or 0, b and (b.mult or 0) or 0
end
P.bonusOf = bonusOf

local function moonAmount(state, h, kind)
  local info = H.handInfo(state, h)
  if kind == 'chips' then return 2 * ((info and info.chipsPerLevel) or 10) end
  return 2 * ((info and info.multPerLevel) or 1)
end

function P.addMoonBonus(state, h, kind, times)
  times = times or 1
  AIJ.run.moon_bonus = AIJ.run.moon_bonus or {}
  local b = AIJ.run.moon_bonus[h] or { chips = 0, mult = 0, moons = 0 }
  local add = moonAmount(state, h, kind) * times
  if kind == 'chips' then b.chips = (b.chips or 0) + add else b.mult = (b.mult or 0) + add end
  b.moons = (b.moons or 0) + times
  AIJ.run.moon_bonus[h] = b
  return add
end

local baseListeners = {}
function P.onHandBase(fn) baseListeners[#baseListeners + 1] = fn end

local pendingHand = nil
cardlike.on('beforeAllCardsScored', function(state, step)
  pendingHand = step and step.hand and step.hand.handType or nil
end)

local function applyBase(state, result)
  local h = pendingHand
  pendingHand = nil
  if not h then return end
  local c, m = bonusOf(h)
  if c ~= 0 then
    state.currentChips = (state.currentChips or 0) + c
    if result then result:say('+' .. AIJ.fmt(c) .. ' Points', colors.CHIPS) end
  end
  if m ~= 0 then
    state.currentMult = (state.currentMult or 0) + m
    if result then result:say('+' .. AIJ.fmt(m) .. ' Mult', colors.MULT) end
  end
  for _, fn in ipairs(baseListeners) do pcall(fn, state, h, result) end
end

cardlike.on('beforeScore', function(state, step, result) if pendingHand then applyBase(state, result) end end)
cardlike.on('onScoreInHand', function(state, step, result) if pendingHand then applyBase(state, result) end end)
cardlike.on('afterAllCardsScored', function(state, step, result) if pendingHand then applyBase(state, result) end end)

local SOFTLOCK = { FLUSH_HOUSE = true, FLUSH_FIVE = true, FIVE_OF_A_KIND = true }
P.moons = {
  { key = 'vulcanoid', hand = 'PAIR', kind = 'mult', pos = { x = 0, y = 0 } },
  { key = 'phaethon', hand = 'PAIR', kind = 'chips', pos = { x = 0, y = 2 } },
  { key = 'zoozve', hand = 'THREE_OF_A_KIND', kind = 'mult', pos = { x = 1, y = 0 } },
  { key = '2013_nd15', hand = 'THREE_OF_A_KIND', kind = 'chips', pos = { x = 1, y = 2 } },
  { key = 'luna', hand = 'FULL_HOUSE', kind = 'mult', pos = { x = 2, y = 0 } },
  { key = 'kamooalewa', hand = 'FULL_HOUSE', kind = 'chips', pos = { x = 2, y = 2 } },
  { key = 'phobos', hand = 'FOUR_OF_A_KIND', kind = 'mult', pos = { x = 3, y = 0 } },
  { key = 'deimos', hand = 'FOUR_OF_A_KIND', kind = 'chips', pos = { x = 3, y = 2 } },
  { key = 'europa', hand = 'FLUSH', kind = 'mult', pos = { x = 4, y = 0 } },
  { key = 'callisto', hand = 'FLUSH', kind = 'chips', pos = { x = 4, y = 2 } },
  { key = 'titan', hand = 'STRAIGHT', kind = 'mult', pos = { x = 5, y = 0 } },
  { key = 'iapetus', hand = 'STRAIGHT', kind = 'chips', pos = { x = 5, y = 2 } },
  { key = 'umbriel', hand = 'TWO_PAIR', kind = 'mult', pos = { x = 0, y = 1 } },
  { key = 'oberon', hand = 'TWO_PAIR', kind = 'chips', pos = { x = 0, y = 3 } },
  { key = 'triton', hand = 'STRAIGHT_FLUSH', kind = 'mult', pos = { x = 1, y = 1 } },
  { key = 'proteus', hand = 'STRAIGHT_FLUSH', kind = 'chips', pos = { x = 1, y = 3 } },
  { key = 'nix', hand = 'HIGH_CARD', kind = 'mult', pos = { x = 2, y = 1 } },
  { key = 'charon', hand = 'HIGH_CARD', kind = 'chips', pos = { x = 2, y = 3 } },
  { key = 'planet_nine', hand = 'FIVE_OF_A_KIND', kind = 'mult', pos = { x = 3, y = 1 }, name = 'Planet Nine' },
  { key = 'nibiru', hand = 'FIVE_OF_A_KIND', kind = 'chips', pos = { x = 3, y = 3 } },
  { key = 'pallas', hand = 'FLUSH_HOUSE', kind = 'mult', pos = { x = 4, y = 1 } },
  { key = '2000_eu16', hand = 'FLUSH_HOUSE', kind = 'chips', pos = { x = 4, y = 3 } },
  { key = 'dysnomia', hand = 'FLUSH_FIVE', kind = 'mult', pos = { x = 5, y = 1 } },
  { key = 'kuiper', hand = 'FLUSH_FIVE', kind = 'chips', pos = { x = 5, y = 3 } },
}
P.moonByKey = {}
for _, m in ipairs(P.moons) do P.moonByKey[m.key] = m end

local function moonDescription(m)
  local word = m.kind == 'chips' and 'Points' or 'Mult'
  local col = m.kind == 'chips' and colors.CHIPS or colors.MULT
  return function(r)
    local s = cardlike.state
    local handName = AIJ.handName(m.hand)
    local head = colorize(bold('Moon'), AIJ.colors.PLANET) .. ': permanently add '
    if s and s.hands then
      local c, mu = bonusOf(m.hand)
      local now = m.kind == 'chips' and c or mu
      return head .. colorize(bold('+' .. AIJ.fmt(moonAmount(s, m.hand, m.kind))), col) .. ' ' .. word
        .. ' to ' .. colorize(bold(handName), colors.ORANGE)
        .. '\n' .. colorize('(Moon bonus now ', colors.GREY) .. colorize(bold('+' .. AIJ.fmt(now)), col)
        .. colorize(' ' .. word .. ')', colors.GREY)
    end
    return head .. 'twice the ' .. colorize(bold(word), col) .. ' of one level to '
      .. colorize(bold(handName), colors.ORANGE)
  end
end

if AIJ.setting('moons_enabled') then
  for _, m in ipairs(P.moons) do
    H.add {
      key = m.key, type = 'fruit', set = 'Planet', pos = m.pos, cost = 3, readableName = m.name,
      config = {},
      description = moonDescription(m),
      action = function(ctx)
        local add = P.addMoonBonus(ctx.state, m.hand, m.kind)
        cardlike.centerText(AIJ.handName(m.hand) .. ': +' .. AIJ.fmt(add) .. (m.kind == 'chips' and ' Points' or ' Mult'), 1.5)
      end,
    }
  end
end

local function anyPlayed(state)
  for _, h in ipairs(H.visibleHands(state)) do
    local info = H.handInfo(state, h)
    if info and (info.played or 0) > 0 then return true end
  end
  return false
end

H.add {
  key = 'dark_star', type = 'fruit', set = 'Planet', pos = { x = 7, y = 1 }, cost = 3,
  config = {},
  canUse = function(ctx) return anyPlayed(ctx.state) and '' or 'No hand played yet' end,
  action = function(ctx)
    local state = ctx.state
    for _, h in ipairs(H.allHands(state)) do
      local info = H.handInfo(state, h)
      if info and (info.played or 0) == 0 then state:upgradeHand(h, 1) end
    end
  end,
}

local BUILTIN_MENTIONS = {
  joker_rude_joker = { 'PAIR' }, joker_cheeky_joker = { 'PAIR' }, joker_deux = { 'PAIR' },
  joker_weird_joker = { 'THREE_OF_A_KIND' }, joker_cutesy_joker = { 'THREE_OF_A_KIND' }, joker_trois = { 'THREE_OF_A_KIND' },
  joker_confident_joker = { 'TWO_PAIR' }, joker_silly_joker = { 'TWO_PAIR' }, joker_two_pear = { 'TWO_PAIR' },
  joker_kid_joker = { 'STRAIGHT' }, joker_worried_joker = { 'STRAIGHT' }, joker_quinte = { 'STRAIGHT' },
  joker_straight_edge = { 'STRAIGHT' }, joker_straight_laced = { 'STRAIGHT' },
  joker_polite_joker = { 'FLUSH' }, joker_tricky_joker = { 'FLUSH' }, joker_couleur = { 'FLUSH' },
  joker_quatre = { 'FOUR_OF_A_KIND' }, joker_prophet = { 'STRAIGHT_FLUSH' }, joker_fourk = { 'FLUSH', 'STRAIGHT' },
}

local function plain(text)
  return (tostring(text or ''):gsub('%[/?b%]', ''):gsub('%[color=[^%]]*%]', ''):gsub('%[/color%]', ''))
end

local function mentionedHands(state)
  local avail = H.visibleHands(state)
  if not AIJ.contains(avail, 'ROYAL_FLUSH') then avail[#avail + 1] = 'ROYAL_FLUSH' end
  local out, seen = {}, {}
  local function add(h) if not seen[h] then seen[h] = true out[#out + 1] = h end end
  for _, j in ipairs(state.jokers or {}) do
    local id = AIJ.defId(j)
    local short = AIJ.short(id)
    if BUILTIN_MENTIONS[id] then
      for _, h in ipairs(BUILTIN_MENTIONS[id]) do if AIJ.contains(avail, h) then add(h) end end
    else
      local e = AIJ.loc('Joker', 'j_aij_' .. tostring(short))
      local text = e and plain(e.text) or ''
      for _, h in ipairs(avail) do
        local name = AIJ.handName(h)
        local like = false
        for _, o in ipairs(avail) do
          local oname = AIJ.handName(o)
          if o ~= h and oname:find(name, 1, true) and text:find(oname, 1, true) then like = true end
        end
        if not like and text:find(name, 1, true) then add(h) end
      end
    end
  end
  return out
end
P.mentionedHands = mentionedHands

H.add {
  key = 'rogue', type = 'fruit', set = 'Planet', pos = { x = 6, y = 6 }, cost = 3, readableName = 'Rogue Planet',
  config = {},
  canUse = function(ctx) return #mentionedHands(ctx.state) > 0 and '' or 'No Joker names a hand' end,
  action = function(ctx)
    for _, h in ipairs(mentionedHands(ctx.state)) do ctx.state:upgradeHand(h, 1) end
  end,
}

H.add {
  key = 'sol', type = 'fruit', set = 'Planet', pos = { x = 7, y = 0 }, cost = 3, handType = 'ROYAL_FLUSH',
  config = {},
  vars = function(card)
    local s = cardlike.state
    local info = s and H.handInfo(s, 'ROYAL_FLUSH')
    return {
      info and info.level or 1, AIJ.handName('ROYAL_FLUSH'),
      info and info.chipsPerLevel or 40, info and info.multPerLevel or 4,
      colours = { colors.ORANGE },
    }
  end,
  action = function(ctx) ctx.state:upgradeHand('ROYAL_FLUSH', 1) end,
}

local VANILLA_FRUIT_HAND = {
  fruit_card_0 = 'STRAIGHT', fruit_card_1 = 'FULL_HOUSE', fruit_card_2 = 'TWO_PAIR', fruit_card_3 = 'HIGH_CARD',
  fruit_card_4 = 'PAIR', fruit_card_5 = 'THREE_OF_A_KIND', fruit_card_6 = 'FLUSH_HOUSE', fruit_card_7 = 'FLUSH_FIVE',
  fruit_card_8 = 'FIVE_OF_A_KIND', fruit_card_9 = 'FOUR_OF_A_KIND', fruit_card_10 = 'FLUSH', fruit_card_11 = 'STRAIGHT_FLUSH',
}

function P.handOf(id)
  if VANILLA_FRUIT_HAND[id] then return VANILLA_FRUIT_HAND[id] end
  local short = AIJ.short(id)
  if short ~= id then
    local m = P.moonByKey[short]
    if m then return m.hand end
    if short == 'sol' then return 'ROYAL_FLUSH' end
  end
  return nil
end

local function presentHands()
  local out = {}
  for _, area in ipairs({ 'consumables', 'shop', 'pack' }) do
    for _, info in ipairs(cardlike.cardInfos(area) or {}) do
      local h = info.consumable and P.handOf(info.consumable)
      if h then out[h] = true end
    end
  end
  return out
end

local THIRD = { dark_star = true, rogue = true }

cardlike.filter('consumablePool', function(ids, t)
  if t ~= 'fruit' then return nil end
  local state = cardlike.state
  if not state or state.money == nil then return nil end
  local blocking = AIJ.setting('moons_blocking') and presentHands() or nil
  local keep, changed = {}, false
  for _, id in ipairs(ids) do
    local ok = true
    local short = AIJ.short(id)
    if short ~= id then
      local m = P.moonByKey[short]
      if m and SOFTLOCK[m.hand] then
        local info = H.handInfo(state, m.hand)
        ok = info ~= nil and (info.played or 0) > 0
      elseif short == 'dark_star' then
        ok = (state.ante or 1) >= 4 and anyPlayed(state)
      elseif short == 'rogue' then
        ok = #mentionedHands(state) > 0
      elseif short == 'sol' then
        local info = H.handInfo(state, 'ROYAL_FLUSH')
        ok = info ~= nil and (info.played or 0) >= 1
      end
      if ok and THIRD[short] then ok = cardlike.random() < 1 / 3 end
    end
    if ok and blocking then
      local h = P.handOf(id)
      if h and blocking[h] then ok = false end
    end
    if ok then keep[#keep + 1] = id else changed = true end
  end
  if changed then return keep end
end)

return P


== file items/settings.lua (54 lines)
local AIJ = cardlike.require('lib.aij')
local ui = cardlike.ui
local S = AIJ.settings

local function plain(text) return (tostring(text or ''):gsub('%[/?b%]', ''):gsub('%[color="[^"]*"%]', ''):gsub('%[/color%]', '')) end

local TOGGLES = {
  { key = 'aij_lite', label = 'All in Jest Lite',
    tip = 'Only a hand-picked selection of the most vanilla-like content (reload the game to apply)' },
  { key = 'moons_enabled', label = 'Enable Moons',
    tip = 'Points and Mult Fruit cards (Moons) can appear (reload the game to apply)' },
  { key = 'moons_blocking', label = 'Moon Blocking',
    tip = 'While Moons are on, Fruit cards for the same hand do not appear at the same time' },
  { key = 'blue_stake_rework', label = 'Lazuli Stake Rework',
    tip = 'Lazuli Stake keeps all its pack slots, but the Boss Blind of ante 4 or 5 is a Pit Blind' },
  { key = 'no_copy_neg', label = 'Copy Inverted Playing Cards',
    tip = 'Copies of Inverted playing cards keep the edition. While off, copies lose it' },
}
local MULT_OPTIONS = { 'Off', 'Standard', 'Strong' }

local function row(t)
  return ui.row { gap = 16, align = 'center', minWidth = 760,
    ui.column { gap = 2, minWidth = 600,
      ui.text { text = t.label, size = 22 },
      ui.text { text = t.tip, size = 15, color = colors.GREY, maxWidth = 560 },
    },
    ui.toggle { value = function() return S[t.key] == true end, onChange = function(v) S[t.key] = v end },
  }
end

cardlike.onSettings(function()
  ui.open {
    modal = true,
    content = function()
      local col = { style = 'window', gap = 12, align = 'center',
        ui.text { text = 'All in Jest', size = 34, color = AIJ.colors.MOD },
        ui.text { text = 'Settings', size = 20, color = colors.GREY },
      }
      for _, t in ipairs(TOGGLES) do col[#col + 1] = row(t) end
      col[#col + 1] = ui.row { gap = 16, align = 'center', minWidth = 760,
        ui.column { gap = 2, minWidth = 460,
          ui.text { text = plain(AIJ.msg('aij_mult_appearance', 'More common Mult')), size = 22 },
          ui.text { text = 'Mult Jokers appear more often until you get one', size = 15, color = colors.GREY, maxWidth = 460 },
        },
        ui.choice { options = MULT_OPTIONS, width = 240,
          value = function() return tonumber(S.mult_appearance) or 1 end,
          onChange = function(i) S.mult_appearance = i end },
      }
      col[#col + 1] = ui.button { label = 'Close', onPress = function() ui.closeAll() end }
      return ui.column(col)
    end,
  }
end)


== file items/spectrals.lua (375 lines)
local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.tarots')

local function planets()
  local ok, P = pcall(cardlike.require, 'items.planets')
  if ok and type(P) == 'table' then return P end
  return nil
end

local function rightmostJoker(state)
  local list = H.byIndex(state.jokers)
  return list[#list]
end

local function availableGameCards()
  local banned = AIJ.run.barathrum_banned or {}
  local out = {}
  for _, c in ipairs(cardlike.listContent('consumable') or {}) do
    if c.type == 'game' and not banned[c.id] then out[#out + 1] = c end
  end
  return out
end

H.add {
  key = 'barathrum', type = 'admin', set = 'Spectral', pos = { x = 9, y = 8 }, cost = 4,
  config = { select = 2 },
  vars = function(card) return { AIJ.val(card, 'barathrum', 'select') } end,
  canUse = function(ctx)
    if #availableGameCards() < H.v(ctx, 'barathrum', 'select') then return 'Not enough Game cards left' end
    return ''
  end,
  action = function(ctx)
    local left = math.max(1, math.floor(H.v(ctx, 'barathrum', 'select')))
    local handle
    handle = H.pickPanel {
      title = 'Barathrum',
      text = function() return 'Remove ' .. left .. ' more Game card' .. (left == 1 and '' or 's') .. ' from the pool' end,
      columns = 6,
      items = function()
        local items = {}
        for _, c in ipairs(availableGameCards()) do
          items[#items + 1] = {
            label = c.name or c.id,
            color = AIJ.colors.TAROT,
            onPress = function()
              AIJ.run.barathrum_banned = AIJ.run.barathrum_banned or {}
              AIJ.run.barathrum_banned[c.id] = true
              left = left - 1
              if left <= 0 and handle then handle.close() end
            end,
          }
        end
        return items
      end,
    }
  end,
}

local function gegenscheinTargets(state)
  local out = {}
  for _, h in ipairs(H.allHands(state)) do
    local info = H.handInfo(state, h)
    local secret = H.SECRET_HANDS[h] or (not H.BASE_HANDS[h] and h ~= 'ROYAL_FLUSH')
    if secret and info and (info.played or 0) > (info.level or 1) then out[#out + 1] = h end
  end
  return out
end

H.add {
  key = 'gegenschein', type = 'admin', set = 'Spectral', pos = { x = 7, y = 2 }, cost = 4, hidden = true,
  config = {},
  canUse = function(ctx) return #gegenscheinTargets(ctx.state) > 0 and '' or 'No secret hand to level' end,
  action = function(ctx)
    local state = ctx.state
    for _, h in ipairs(gegenscheinTargets(state)) do
      local info = H.handInfo(state, h)
      state:upgradeHand(h, info.played - info.level)
    end
  end,
}

H.add {
  key = 'gravastar', type = 'admin', set = 'Spectral', pos = { x = 3, y = 4 }, cost = 4, hidden = true,
  config = {},
  description = colorize(bold('Levels up'), colors.ORANGE) .. ' the ' .. colorize(bold('Points'), colors.CHIPS)
    .. ' of all ' .. colorize(bold('poker hands'), colors.PURPLE)
    .. '\n' .. colorize('(Each hand gains twice its Points per level)', colors.GREY),
  action = function(ctx)
    local P = planets()
    if not P then return end
    for _, h in ipairs(H.allHands(ctx.state)) do P.addMoonBonus(ctx.state, h, 'chips') end
    cardlike.centerText('All hands: + Points', 1.5)
  end,
}

H.add {
  key = 'pulsar', type = 'admin', set = 'Spectral', pos = { x = 2, y = 4 }, cost = 4, hidden = true,
  config = {},
  description = colorize(bold('Levels up'), colors.ORANGE) .. ' the ' .. colorize(bold('Mult'), colors.MULT)
    .. ' of all ' .. colorize(bold('poker hands'), colors.PURPLE)
    .. '\n' .. colorize('(Each hand gains twice its Mult per level)', colors.GREY),
  action = function(ctx)
    local P = planets()
    if not P then return end
    for _, h in ipairs(H.allHands(ctx.state)) do P.addMoonBonus(ctx.state, h, 'mult') end
    cardlike.centerText('All hands: + Mult', 1.5)
