    ["j_aij_bat_credit_card"] = { name = "Bat Credit Card", text = "" },
    ["j_aij_beale"] = { name = "Beale", text = "" },
    ["j_aij_beanstalk"] = { name = "Beanstalk", text = "[color=\"#f3a712\"][b]Jacks[/b][/color] [color=\"#f3a712\"][b]cannot[/b][/color] be [color=\"#ff007f\"][b]debuffed,[/b][/color] [color=\"#f3a712\"][b]flipped[/b][/color], or [color=\"#f3a712\"][b]marked[/b][/color], and they [color=\"#f3a712\"][b]always[/b][/color] score" },
    ["j_aij_bear"] = { name = "Bear", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]$5[/b][/color] you are [color=\"#f3a712\"][b]below[/b][/color] [color=\"#f3a712\"][b]$#2#[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#3#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_bearded_joker"] = { name = "Bearded Joker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]Enhanced[/b][/color] card in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
