AIJ.onNewRun(function(run) run.barathrum_banned = {} end)

H.soulSpawns = { game = {}, fruit = {} }
local HEX_RATE = 0.003 / 5
for _, k in ipairs({ 'error', 'janitor', 'faceless', 'oracle' }) do
  table.insert(H.soulSpawns.game, { id = k, rate = HEX_RATE })
end

local function rollSoul(state, card, list)
  for _, s in ipairs(list) do
    if AIJ.has(s.id, 'consumable') and (not s.gate or s.gate(state)) and state:randomFloat() > 1 - s.rate then
      card:setConsumableDef(AIJ.id(s.id))
      return true
    end
  end
  return false
end

cardlike.on('onCardCreated', function(state, step)
  local card = step and step.card
  if not state or not card or AIJ.safe(card.getKind, card) ~= 'consumable' then return end
  if AIJ.safe(card.getArea, card) ~= 'pack' then return end
  local t = AIJ.safe(card.getConsumableType, card)
  local list = H.soulSpawns[t]
  if list then rollSoul(state, card, list) end
end)

local function hasRockCard(state)
  for _, c in ipairs(state.allCards or {}) do
    if AIJ.enhancement(c) == 'Rock' then return true end
  end
  return false
end

cardlike.filter('consumablePool', function(ids, t)
  if t ~= 'game' then return nil end
  local state = cardlike.state
  if not state or state.money == nil then return nil end
  local banned = AIJ.run.barathrum_banned or {}
  local keep, changed = {}, false
  for _, id in ipairs(ids) do
    local ok = not banned[id]
    if ok and AIJ.isId(id, 'broken_fate') then ok = #(state.consumables or {}) > 0 end
    if ok and AIJ.isId(id, 'golem') then ok = hasRockCard(state) end
    if ok then keep[#keep + 1] = id else changed = true end
  end
  if changed then return keep end
end)

return H


