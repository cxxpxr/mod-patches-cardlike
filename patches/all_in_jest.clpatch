local function halterX(card, used)
  return math.max(1, AIJ.num(card, 'base_xmult') - (used or 0) * AIJ.num(card, 'loss'))
end

AIJ.addJoker {
  key = 'halter_sack',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 28 },
  config = { base_xmult = 3, loss = 0.5 },
  vars = function(card)
    local base, loss = AIJ.val(card, 'halter_sack', 'base_xmult'), AIJ.val(card, 'halter_sack', 'loss')
    local used = cardlike.state and cardlike.state.discardsUsed or 0
    return { base, loss, math.max(1, base - used * loss) }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if #(step.hand.playedCards or {}) < 4 then return end
      local x = halterX(joker, state.discardsUsed)
      if x > 1 then result:add(xMult(x)) end
    end,
    onDiscard = function(joker, state, step, result)
      result:say('X' .. AIJ.fmt(halterX(joker, state.discardsUsed)) .. ' Mult', colors.MULT)
    end,
  },
}

AIJ.addJoker {
  key = 'hand_drawn',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 2 },
  blueprint_compat = false,
  config = {},
  triggers = {
    drawInitialCards = function(joker, state, step, result)
      if step.copiedBy then return end
      local h = state.mostPlayedHand
      local info = h and state:getHand(h)
      if not info or (info.played or 0) <= 0 then return end
      local cur = {}
      for _, c in ipairs(ofList(state, 'cardsInHand')) do cur[#cur + 1] = c end
      local best = cardlike.evaluateHand(cur)
      if best and best.contains and best.contains[h] then return end
      local deck = ofList(state, 'unDrawnCards')
      local n = 0
      for i = #deck, 1, -1 do
        cur[#cur + 1] = deck[i]
        n = n + 1
        local r = cardlike.evaluateHand(cur)
        if r and r.contains and r.contains[h] then break end
      end
      if n > 0 then
        cardlike.drawCards(math.min(52, n))
        result:say('+' .. n .. ' Cards', colors.ORANGE)
      end
    end,
  },
}

local HANDSOME_SKIP = { Default = true, Rock = true, Prismatic = true }

local function handsomePick(state)
  local ranks = {}
  for _, c in ipairs(ofList(state, 'allCards')) do
    local i = c.lastInfo or {}
    if i.rank and not AIJ.noRank(c) and not AIJ.hasEnhancement(c, 'canvas') then ranks[#ranks + 1] = i.rank end
  end
  local enh = {}
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if not HANDSOME_SKIP[e.id] and not AIJ.isId(e.id, 'canvas') then enh[#enh + 1] = e.id end
  end
  AIJ.run.handsome_joker_card = { rank = AIJ.pick(ranks, state) or 14, enhancement = AIJ.pick(enh, state) or AIJ.vanilla('m_bonus') }
end

local function handsomeCard(state)
  if not AIJ.run.handsome_joker_card and state and state.money ~= nil then pcall(handsomePick, state) end
  return AIJ.run.handsome_joker_card
end

local function handsomeX(card, state)
  local hc = handsomeCard(state)
  local mod = AIJ.val(card, 'handsome_joker', 'xmult_mod')
  if not hc or not state then return 1 end
  local n = 0
  for _, c in ipairs(ofList(state, 'allCards')) do
    local i = c.lastInfo or {}
    if i.rank == hc.rank and not AIJ.noRank(c) and AIJ.enhancement(c) == hc.enhancement then n = n + 1 end
  end
  if n < 1 then return 1 end
  return 1 + n * mod
end

local HANDSOME = AIJ.addJoker {
  key = 'handsome_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 5, y = 0 },
  config = { xmult_mod = 0.5 },
  description = D('handsome_joker', function(card)
    local state = cardlike.state
    local hc = state and handsomeCard(state)
    local text = '[enhancement] [rank]'
    if hc then
      local info = cardlike.contentInfo('enhancement', hc.enhancement)
      local name = (info and info.name or tostring(hc.enhancement)):gsub(' [Cc]ard$', '')
      text = name .. ' ' .. AIJ.rankName(hc.rank)
    end
    return { AIJ.val(card, 'handsome_joker', 'xmult_mod'), text, handsomeX(card, state) }
  end, function(t) return (t:gsub(' Card does', '\nCard does')) end),
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = handsomeX(joker, state)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}
if HANDSOME then
  cardlike.on('onRunStart', function(state) pcall(handsomePick, state) end)
end


== file jokers/batch05.lua (1766 lines)
local AIJ = cardlike.require('lib.aij')

local ABILITY = '#8389dd'
local GREY = colors.GREY

local function hint(text) return '\n' .. colorize('(' .. text .. ')', GREY) end

local function shortRank(n)
  return ({ [11] = 'J', [12] = 'Q', [13] = 'K', [14] = 'A' })[n] or tostring(n)
end

local function suitColor(suit) return AIJ.SUIT_COLORS[suit] or colors.ORANGE end
local function suitSingular(suit) return (tostring(suit):gsub('s$', '')) end

local function info(c) return type(c) == 'table' and c.lastInfo or {} end

local function owned(state, id)
  local out = {}
  for _, j in ipairs(state and state.jokers or {}) do
    if AIJ.is(j, id) then out[#out + 1] = j end
  end
  return out
end

local function deckHas(state, fn)
  for _, c in ipairs(state and state.allCards or {}) do
    if fn(c) then return true end
  end
  return false
end

local function activeText(on)
  return on and ('(' .. AIJ.msg('k_active', 'Active') .. ')') or ('(' .. AIJ.msg('k_inactive', 'Inactive') .. ')')
end

AIJ.onNewRun(function(run)
  run.hangman_card = nil
  run.lavatch_suit = 'Spades'
  run.historian_sell = 0
  run.kilroy_value = 25
  run.jester_zombie_active = false
  run.kasperle_ticket = false
end)

local function rollRoundCards(state)
  local list = {}
  for _, c in ipairs(state.allCards or {}) do
    if not AIJ.noRank(c) and info(c).suit then list[#list + 1] = c end
  end
  local c = AIJ.pick(list, state)
  AIJ.run.hangman_card = c and { rank = info(c).rank, suit = info(c).suit } or { rank = 14, suit = 'Spades' }
  local suits = {}
  for _, s in ipairs(AIJ.SUITS) do
    if s ~= AIJ.run.lavatch_suit then suits[#suits + 1] = s end
  end
  AIJ.run.lavatch_suit = AIJ.pick(suits, state) or 'Spades'
end

cardlike.on('onRunStart', function(state) rollRoundCards(state) end)
cardlike.on('onBlindDefeated', function(state) rollRoundCards(state) end)
cardlike.on('onRoundStart', function(state)
  if not AIJ.run.hangman_card then rollRoundCards(state) end
  AIJ.run.jester_zombie_active = false
end)

local function hangmanCard()
  return AIJ.run.hangman_card or { rank = 14, suit = 'Spades' }
end

local picker = { pending = 0, title = '', panel = nil, groups = nil }

local function buildPickerGroups(state)
  local bySuit, order = {}, {}
  for _, c in ipairs(state.unDrawnCards or {}) do
    local i = info(c)
    local key = AIJ.noRank(c) and 'Other' or (i.suit or 'Other')
    if not bySuit[key] then bySuit[key] = {} order[#order + 1] = key end
    table.insert(bySuit[key], c)
  end
  local rank = { Spades = 1, Hearts = 2, Clubs = 3, Diamonds = 4, Other = 99 }
  table.sort(order, function(a, b) return (rank[a] or 50) < (rank[b] or 50) end)
  local groups = {}
  for _, key in ipairs(order) do
    local cards = bySuit[key]
    table.sort(cards, function(a, b) return (info(a).rank or 0) > (info(b).rank or 0) end)
    groups[#groups + 1] = { suit = key, cards = cards }
  end
  return groups
end

local function closePicker()
  picker.pending = 0
  if picker.panel then
    local p = picker.panel
    picker.panel = nil
    AIJ.safe(p.close)
  end
end

local function pickerNode()
  local ui = cardlike.ui
  local state = cardlike.state
  if not state or picker.pending <= 0 or not picker.groups then return nil end
  local col = { style = 'window', gap = 6, align = 'center',
    ui.text { text = picker.title .. ' (' .. picker.pending .. ')', size = 24, color = colors.ORANGE } }
  for _, g in ipairs(picker.groups) do
    local row = { gap = 4, align = 'center', ui.text { text = g.suit, size = 16, color = suitColor(g.suit), maxWidth = 90 } }
    local n = 0
    for _, c in ipairs(g.cards) do
      if n >= 16 then
        col[#col + 1] = ui.row(row)
        row = { gap = 4, align = 'center' }
        n = 0
      end
      local label = AIJ.noRank(c) and 'Rock' or shortRank(info(c).rank)
      row[#row + 1] = ui.button { label = label, padding = 6, onPress = function()
        local s = cardlike.state
        if not s or picker.pending <= 0 then closePicker() return end
        AIJ.safe(c.moveTo, c, 'hand')
        picker.pending = picker.pending - 1
        if picker.pending <= 0 or #(s.unDrawnCards or {}) == 0 then closePicker() return end
        picker.groups = buildPickerGroups(s)
      end }
      n = n + 1
    end
    col[#col + 1] = ui.row(row)
  end
  return ui.column(col)
end

local function openDeckPicker(state, title, count)
  count = math.min(count, #(state.unDrawnCards or {}))
  if count <= 0 then return end
  picker.pending = picker.pending + count
  picker.title = title
  picker.groups = buildPickerGroups(state)
  if picker.panel and AIJ.safe(picker.panel.isOpen) then return end
  picker.panel = cardlike.ui.open { modal = true, closeOnEscape = false, content = pickerNode,
    onClose = function() picker.panel = nil picker.pending = 0 end }
end

cardlike.on('onRunStart', function() closePicker() end)

local function rerollRule(id, sign)
  AIJ.rerollMod(function(state)
    local d = 0
    for _, j in ipairs(owned(state, id)) do
      if not AIJ.isDebuffed(j) then d = d + sign * AIJ.num(j, 'reroll_sale') end
    end
    return d
  end)
end

local TAG_PRICES = {
  tag_uncommon = { 'fixed', 5 }, tag_rare = { 'fixed', 6 }, tag_negative = { 'fixed', 8 }, tag_foil = { 'fixed', 5 },
  tag_holo = { 'fixed', 5 }, tag_polychrome = { 'fixed', 6 }, tag_investment = { 'fixed', 12 }, tag_voucher = { 'fixed', 5 },
  tag_boss = { 'fixed', 4 }, tag_standard = { 'fixed', 4 }, tag_charm = { 'fixed', 6 }, tag_meteor = { 'fixed', 4 },
  tag_buffoon = { 'fixed', 4 }, tag_handy = { 'fixed', 10 }, tag_garbage = { 'fixed', 10 }, tag_coupon = { 'fixed', 10 },
  tag_double = { 'fixed', 8 }, tag_juggle = { 'fixed', 4 }, tag_d_six = { 'fixed', 10 }, tag_top_up = { 'fixed', 5 },
  tag_skip = { 'fixed', 5 }, tag_orbital = { 'fixed', 6 }, tag_economy = { 'fixed', 10 }, tag_ethereal = { 'fixed', 4 },
  tag_aij_soulbound = { 'fixed', 7 }, tag_aij_chaos = { 'random', 3, 10 }, tag_aij_glimmer = { 'fixed', 5 },
  tag_aij_stellar = { 'fixed', 5 }, tag_aij_silver = { 'fixed', 8 }, tag_aij_aureate = { 'fixed', 8 },
  tag_aij_overstuffed = { 'fixed', 6 }, tag_aij_fortunate = { 'fixed', 8 },
  tag_aij_unusual = { 'fraction', 0.1, 10 }, tag_aij_recherche = { 'fraction', 0.15, 20 },
  tag_aij_dark_matter = { 'fraction', 0.75, 40 }, tag_aij_crystal = { 'fraction', 0.15, 15 },
  tag_aij_iridescent = { 'fraction', 0.15, 15 }, tag_aij_omnichrome = { 'fraction', 0.25, 30 },
  tag_aij_capital = { 'fraction', 0.5, 50 }, tag_aij_ticket = { 'fraction', 0.2, 20 },
  tag_aij_dominus = { 'fraction', 0.2, 20 }, tag_aij_nonstandard = { 'fraction', 0.4, 50 },
  tag_aij_occult = { 'fraction', 0.15, 30 }, tag_aij_asteroid = { 'fraction', 0.1, 15 },
  tag_aij_ignoramus = { 'fraction', 0.9, 75 }, tag_aij_polydactyly = { 'fraction', 0.2, 20 },
  tag_aij_landfill = { 'fraction', 0.5, 50 }, tag_aij_hermetic = { 'fraction', 0.5, 40 },
  tag_aij_frugal = { 'fraction', 0.2, 20 }, tag_aij_stereoscopic = { 'fraction', 0.5, 50 },
  tag_aij_gioco = { 'fraction', 0.2, 15 }, tag_aij_galloping_domino = { 'fraction', 0.4, 55 },
  tag_aij_bierstiefel = { 'fraction', 0.05, 15 }, tag_aij_velocity = { 'fraction', 0.2, 50 },
  tag_aij_circumplanetary = { 'fraction', 0.1, 25 }, tag_aij_windfall = { 'fraction', 0.5, 30 },
  tag_aij_timelost = { 'fraction', 0.2, 20 }, tag_aij_anarchy = { 'fraction', 0.2, 20 },
  tag_aij_glamour = { 'fraction', 0.25, 30 }, tag_aij_superlunary = { 'fraction', 0.15, 15 },
  tag_aij_cinema = { 'fraction', 0.75, 40 }, tag_aij_gold_dust = { 'fraction', 0.35, 50 },
  tag_aij_ventripotent = { 'fraction', 0.15, 20 }, tag_aij_auspicious = { 'fraction', 0.2, 40 },
}
local PIN_PRICES = {}
for key, rule in pairs(TAG_PRICES) do
  local id = key:match('^tag_aij_(.+)$')
  if id then PIN_PRICES[AIJ.id(id)] = rule else
    local v = AIJ.vanilla(key)
    if v then PIN_PRICES[v] = rule end
  end
end

local function isGoldPin(id) return AIJ.contains(AIJ.lists.gold_pins, AIJ.short(id)) end

local function pinPrice(id, state)
  local rule = PIN_PRICES[id] or PIN_PRICES[AIJ.id(id)]
  if not rule then
    if isGoldPin(id) then return state:random(15, 30) end
    return state:random(5, 10)
  end
  if rule[1] == 'fixed' then return rule[2] end
  if rule[1] == 'random' then return state:random(rule[2], rule[3]) end
  return math.max(rule[3], math.floor(math.max(0, state.money or 0) * rule[2]))
end

local function goldPinRate(state)
  return (1 + 4 * AIJ.count('illuminated_joker', state)) / 30
end

local function randomOfferPin(state)
  if state:randomFloat() < goldPinRate(state) then
    local g = AIJ.randomGoldPin(state)
    if g then return g end
  end
  return cardlike.randomPin()
end

local function pinName(id)
  local i = cardlike.contentInfo('pin', id)
  return i and i.name or AIJ.short(tostring(id))
end

local function isAdminPack(card)
  local i = info(card)
  local id = tostring(i.consumable or '')
  return id:find('^pack_admin') ~= nil or tostring(i.name or ''):find('Admin') ~= nil
end

local function bigPack(id, state)
  id = tostring(id or '')
  local mega = state:randomFloat() < 0.2
  local kind = id:match('^pack_(%a+)_0$')
  if kind then return 'pack_' .. kind .. '_' .. (mega and 2 or 1) end
  local short = AIJ.short(id)
  if short:find('_normal') then
    for _, size in ipairs(mega and { 'mega', 'jumbo' } or { 'jumbo', 'mega' }) do
      for _, cand in ipairs({ short:gsub('_normal', '_' .. size), (short:gsub('_normal_%d+$', '_' .. size)) }) do
        if type(cand) == 'string' and cardlike.contentInfo('pack', AIJ.id(cand)) then return AIJ.id(cand) end
      end
    end
  end
  return nil
end

AIJ.addJoker {
  key = 'hangman',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 0, y = 29 },
  config = { inactive_rounds = 0, max_inactive = 3, triggered_this_round = false },
  blueprint_compat = false,
  vars = function(card)
    local t = hangmanCard()
    local left = AIJ.val(card, 'hangman', 'max_inactive', 3) - AIJ.val(card, 'hangman', 'inactive_rounds', 0)
    return { AIJ.rankName(t.rank), t.suit, left, colours = { suitColor(t.suit) } }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      local t = hangmanCard()
      local hit = false
      for _, c in ipairs(step.hand.allCards or {}) do
        if not AIJ.noRank(c) and c:getRank() == t.rank and c:isSuit(t.suit) then hit = true break end
      end
      if not hit then return end
      if not step.copiedBy then
        AIJ.set(joker, 'triggered_this_round', true)
        AIJ.set(joker, 'inactive_rounds', 0)
      end
      if (state.freeConsumableSlots or 0) > 0 then
        cardlike.createConsumable(AIJ.vanilla('c_hanged_man'))
        result:say('+1 Game Card', AIJ.colors.TAROT)
      end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.get(joker, 'triggered_this_round') then
        AIJ.set(joker, 'triggered_this_round', false)
        AIJ.set(joker, 'inactive_rounds', 0)
        return
      end
      local n = AIJ.add(joker, 'inactive_rounds', 1)
      local max = AIJ.num(joker, 'max_inactive')
      if n >= max then
        if (state.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(AIJ.vanilla('c_death')) end
        result:say('+1 Game Card', AIJ.colors.TAROT)
        result:destroySelf()
      else
        result:say(n .. '/' .. max)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'happy_as_larry',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 25 },
  config = { xmult = 0.25, odds = 5, new_odds = 5, decrease_odds = 1 },
  vars = function(card)
    return { 1 + AIJ.val(card, 'happy_as_larry', 'xmult', 0.25), AIJ.val(card, 'happy_as_larry', 'new_odds', 5) * AIJ.prob(),
      AIJ.val(card, 'happy_as_larry', 'odds', 5), AIJ.val(card, 'happy_as_larry', 'decrease_odds', 1) }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x <= 1 then return end
      local odds = math.max(1, AIJ.num(joker, 'odds'))
      local n, dec, reps = AIJ.num(joker, 'new_odds'), math.max(1, AIJ.num(joker, 'decrease_odds')), 0
      while n > 0 and reps < 50 and state:chance(math.min(1, n / odds)) do
        n = n - dec
        reps = reps + 1
      end
      result:add(xMult(x ^ (reps + 1)))
      if reps > 0 then result:say('Again! x' .. reps, colors.ORANGE) end
    end,
  },
}

AIJ.addJoker {
  key = 'hardy',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 4, y = 12 }, soul_pos = { x = 4, y = 13 },
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
