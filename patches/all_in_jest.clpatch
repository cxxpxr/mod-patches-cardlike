local totoQueue, totoPending = {}, {}
cardlike.filter('pinAdded', function(ok, pin)
  local id = AIJ.defId(pin)
  if not id then return nil end
  if (totoPending[id] or 0) > 0 then
    totoPending[id] = totoPending[id] - 1
    return nil
  end
  if id == AIJ.vanilla('tag_double') then return nil end
  local n = 0
  for _, j in ipairs(owned('toto')) do n = n + AIJ.num(j, 'tags') end
  for _ = 1, n do totoQueue[#totoQueue + 1] = id end
  return nil
end)
cardlike.onFrame(function(frame)
  if #totoQueue == 0 then return end
  if not frame.inRun then totoQueue = {} totoPending = {} return end
  local q = totoQueue
  totoQueue = {}
  for _, id in ipairs(q) do totoPending[id] = (totoPending[id] or 0) + 1 end
  for _, id in ipairs(q) do pcall(cardlike.addPin, id) end
  local t = owned('toto')[1]
  if t then t:popup(AIJ.msg('k_aij_triple_ex', 'Tripled!'), colors.ORANGE) end
end)

AIJ.addJoker {
  key = 'toto',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 0, y = 2 }, soul_pos = { x = 0, y = 3 },
  config = { tags = 2 },
  vars = function(card) return { AIJ.val(card, 'toto', 'tags') } end,
}

AIJ.addJoker {
  key = 'touchstone',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 4, y = 0 }, soul_pos = { x = 4, y = 1 },
  config = { hand_size = 4, future_sense = 12 },
  blueprint_compat = false,
  description = function(r)
    local card = r and r.card
    return C('+' .. AIJ.fmt(AIJ.val(card, 'touchstone', 'hand_size')), colors.ORANGE) .. ' hand size\nReveals the next '
      .. C(AIJ.fmt(AIJ.val(card, 'touchstone', 'future_sense')), colors.ORANGE) .. ' cards in your deck\n'
      .. grey('(Shown on the left of the screen)')
  end,
  onAdded = function(joker, state) state.handSize = state.handSize + AIJ.num(joker, 'hand_size') end,
  onRemoved = function(joker, state) state.handSize = state.handSize - AIJ.num(joker, 'hand_size') end,
}

local SUIT_LETTER = { Spades = 'S', Hearts = 'H', Clubs = 'C', Diamonds = 'D' }
local touchCache, touchAge = nil, 1
cardlike.onFrame(function(frame)
  if not frame.inRun then touchCache = nil return end
  local state = cardlike.state
  if not state or not (state.phase == 'play' or state.phase == 'scoring') then return end
  touchAge = touchAge + (frame.dt or 0)
  if touchAge >= 0.25 then
    touchAge = 0
    touchCache = nil
    local stones = owned('touchstone', state)
    if #stones > 0 then
      local n = 0
      for _, j in ipairs(stones) do n = math.max(n, AIJ.num(j, 'future_sense')) end
      local deck = state.unDrawnCards or {}
      touchCache = {}

      for i = #deck, math.max(1, #deck - n + 1), -1 do
        local info = deck[i].lastInfo or {}
        local text
        if info.noRank or info.enhancement == 'Rock' then text = 'Rock'
        else text = (RANK_SHORT[info.rank] or tostring(info.rank or '?')) .. (SUIT_LETTER[info.suit] or '') end
        touchCache[#touchCache + 1] = { text = text, color = AIJ.SUIT_COLORS[info.suit] or colors.WHITE }
      end
    end
  end
  if not touchCache or #touchCache == 0 then return end
  local draw = cardlike.draw
  local x, y = 16, math.floor(frame.height * 0.3)
  local rows = math.ceil(#touchCache / 6)
  draw.rect { x = x, y = y, width = 250, height = 34 + rows * 24, color = '#262625dd', radius = 8 }
  draw.text { text = 'Next cards', x = x + 10, y = y + 6, size = 16, color = colors.ORANGE }
  for i, e in ipairs(touchCache) do
    local col, row = (i - 1) % 6, math.floor((i - 1) / 6)
    draw.text { text = e.text, x = x + 10 + col * 39, y = y + 30 + row * 24, size = 16, color = e.color }
  end
end)

AIJ.addJoker {
  key = 'toynbee_joker',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 6, y = 8 },
  description = fixedDesc('toynbee_joker', function(card)
    local s = cardlike.state
    local h = s and s.firstHandThisRound
    if not h and card and s and AIJ.get(card, 'first_round') == s.round then h = AIJ.get(card, 'first_hand') end
    return { h and AIJ.handName(h) or 'None' }
  end),
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.get(joker, 'first_round') ~= state.round then
        AIJ.set(joker, 'first_round', state.round)
        AIJ.set(joker, 'first_hand', step.hand.handType)
      end
    end,
    afterRound = function(joker, state, step, result)
      local h = state.firstHandThisRound
      if not h and AIJ.get(joker, 'first_round') == state.round then h = AIJ.get(joker, 'first_hand') end
      local fruit = h and FRUIT_OF[h]
      if fruit and (state.freeConsumableSlots or 0) > 0 then
        cardlike.createConsumable(fruit)
        result:say('+1 Fruit', AIJ.colors.PLANET)
      end
    end,
  },
}

local function ticketCount(state) return #(state and state.tickets or {}) end

AIJ.addJoker {
  key = 'tract',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 24, y = 9 },
  config = { chip_mod = 50 },
  vars = function(card)
    local m = AIJ.val(card, 'tract', 'chip_mod')
    return { m, m * ticketCount(cardlike.state) }
  end,
  triggers = {
    onCardBought = function(joker, state, step, result)
      if not step.card or kindOf(step.card) ~= 'ticket' then return end
      local n = ticketCount(state)
      if not AIJ.contains(state.tickets or {}, AIJ.defId(step.card)) then n = n + 1 end
      result:say('+' .. AIJ.fmt(n * AIJ.num(joker, 'chip_mod')) .. ' Points', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = ticketCount(state) * AIJ.num(joker, 'chip_mod')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

local tcBuf, tcSkip = {}, 0
cardlike.filter('bonus', function(b)
  if tcSkip > 0 then tcSkip = tcSkip - 1 return nil end
  if type(b) == 'table' and b.bonusType == 'Mult' then tcBuf[#tcBuf + 1] = { op = b.operator, amount = b.amount } end
  return nil
end)
for _, ev in ipairs({ 'beforeAllCardsScored', 'onScore', 'onScoreInHand', 'afterHand' }) do
  cardlike.on(ev, function() tcBuf = {} tcSkip = 0 end)
end

AIJ.addJoker {
  key = 'train_conductor',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 0, y = 41 },
  config = { xmult_to_mult = 500, mult_to_xmult = 15 },
  blueprint_compat = false,
  vars = function(card)
    return { AIJ.val(card, 'train_conductor', 'mult_to_xmult'), AIJ.val(card, 'train_conductor', 'xmult_to_mult') }
  end,
  triggers = {
    onOtherJoker = function(joker, state, step, result)
      local buf = tcBuf
      tcBuf = {}
      if step.copiedBy or #buf == 0 then return end
      local toX, toPlus = AIJ.num(joker, 'mult_to_xmult') / 100, AIJ.num(joker, 'xmult_to_mult') / 100
      local any = false
      for _, b in ipairs(buf) do
        if b.op == 'X' and (b.amount or 0) <= 0 then return end
        if (b.op == '+' and b.amount > 0) or (b.op == 'X' and b.amount > 1 and math.floor(b.amount * toPlus) >= 1) then any = true end
      end
      if not any then return end
      local out = {}
      for i = #buf, 1, -1 do
        local b = buf[i]
        if b.op == 'X' then out[#out + 1] = xMult(1 / b.amount) else out[#out + 1] = plusMult(-b.amount) end
      end
      for _, b in ipairs(buf) do
        if b.op == '+' and b.amount > 0 then
          out[#out + 1] = xMult(math.max(1.2, b.amount * toX))
        elseif b.op == 'X' and b.amount > 1 and math.floor(b.amount * toPlus) >= 1 then
          out[#out + 1] = plusMult(math.floor(b.amount * toPlus))
        elseif b.op == 'X' then
          out[#out + 1] = xMult(b.amount)
        else
          out[#out + 1] = plusMult(b.amount)
        end
      end
      for _, b in ipairs(out) do result:add(b) end
      tcSkip = #out
    end,
  },
}

AIJ.addJoker {
  key = 'treasure_map',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 21 },
  config = { min_blinds = 3, max_blinds = 6, remain_blinds = 0 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'treasure_map', 'min_blinds'), AIJ.val(card, 'treasure_map', 'max_blinds') } end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      if step.copiedBy then return end
      local amt = state:random(AIJ.num(joker, 'min_blinds'), AIJ.num(joker, 'max_blinds'))
      local remain = AIJ.num(joker, 'remain_blinds') - 1
      if remain < 0 then remain = amt - 1 end
      if remain == 0 then
        remain = amt
        if AIJ.has('stereoscopic', 'pin') then cardlike.addPin(AIJ.id('stereoscopic')) end
        result:say('Treasure!', colors.ORANGE)
      end
      AIJ.set(joker, 'remain_blinds', remain)
    end,
  },
}

cardlike.filter('chance', function(p)
  if type(p) ~= 'number' or p <= 0 or p >= 1 then return nil end
  local add = 0
  for _, j in ipairs(owned('triple_gooberberry_sunrise')) do add = add + AIJ.num(j, 'odds_mod') end
  if add <= 0 then return nil end

  return math.min(1, p * (1 + add))
end)

AIJ.addJoker {
  key = 'triple_gooberberry_sunrise',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 10, y = 40 },
  config = { odds_mod = 2, antes_remaining = 3 },
  description = function(r)
    local card = r and r.card
    return C('+' .. AIJ.fmt(AIJ.val(card, 'triple_gooberberry_sunrise', 'odds_mod')), colors.GREEN) .. ' to all listed '
      .. C('probabilities', colors.GREEN) .. ', ' .. C('consumed', colors.ORANGE) .. ' after '
      .. C(AIJ.fmt(AIJ.val(card, 'triple_gooberberry_sunrise', 'antes_remaining')), colors.ORANGE) .. ' Antes\n'
      .. grey('(1 in 4 becomes 3 in 4)')
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local left = AIJ.num(joker, 'antes_remaining') - 1
      if left <= 0 then
        result:say('Eaten!', colors.ORANGE)
        result:destroySelf()
      else
        AIJ.set(joker, 'antes_remaining', left)
        result:say(tostring(left), colors.ORANGE)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'triple_sundae',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 20, y = 21 },
  config = { chips = 150, mult = 30, dollars = 10, rounds = 3, total_rounds = 3 },
  pools = { Food = true },
  vars = function(card)
    return { AIJ.val(card, 'triple_sundae', 'chips'), AIJ.val(card, 'triple_sundae', 'mult'),
      AIJ.val(card, 'triple_sundae', 'dollars'), AIJ.val(card, 'triple_sundae', 'rounds') }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      result:add(plusChips(AIJ.num(joker, 'chips')))
      result:add(plusMult(AIJ.num(joker, 'mult')))
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      result:add(plusMoney(AIJ.num(joker, 'dollars')))
      local left = AIJ.num(joker, 'rounds') - 1
      if left > 0 then
        AIJ.set(joker, 'rounds', left)
        result:say(left .. '/' .. AIJ.fmt(AIJ.num(joker, 'total_rounds')), colors.ORANGE)
        return
      end
      result:say('Melted!', colors.ORANGE)
      local next = 'double_sundae_' .. state:random(1, 3)
      if AIJ.has(next, 'joker') then
        local ds = joker:getDataStore()
        for _, k in ipairs({ 'chips', 'mult', 'dollars', 'rounds', 'total_rounds' }) do ds:delete(k) end
        joker:setJokerDef(AIJ.id(next))
      else
        result:destroySelf()
      end
    end,
  },
}

AIJ.addJoker {
  key = 'trophy_kill',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 31 },
  layerSprite = AIJ.sprite('trophy_kill', 0, 0),
  config = { xmult = 3, triggered = false },
  vars = function(card)
    local rank = card and AIJ.get(card, 'rank')
    local suit = card and AIJ.get(card, 'suit')
    local on = card and AIJ.get(card, 'triggered') == true
    return { AIJ.val(card, 'trophy_kill', 'xmult'), rank and AIJ.rankName(rank) or '[rank]', suit or '[suit]',
      on and '(Active)' or '(Inactive)' }
  end,
  onAdded = function(joker, state)
    AIJ.set(joker, 'triggered', false)
    local pool = {}
    for _, c in ipairs(state.allCards or {}) do if rankOf(c) then pool[#pool + 1] = c end end
    local c = AIJ.pick(pool, state)
    if c then
      AIJ.set(joker, 'rank', rankOf(c))
      AIJ.set(joker, 'suit', AIJ.safe(c.getSuit, c) or (c.lastInfo or {}).suit)
    end
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if AIJ.get(joker, 'triggered') == true then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

AIJ.onNewRun(function(run) run.visage_last = nil end)

cardlike.on('onCardsRemoved', function(state, step)
  local cards = {}
  for _, c in ipairs(step.cards or {}) do if not wasReturned(c) then cards[#cards + 1] = c end end
  if #cards == 0 then return end

  for _, j in ipairs(owned('trophy_kill', state)) do
    if AIJ.get(j, 'triggered') ~= true then
      local rank, suit = AIJ.get(j, 'rank'), AIJ.get(j, 'suit')
      for _, c in ipairs(cards) do
        local info = c.lastInfo or {}
        local suits = info.suits or {}
        if rank and rankOf(c) == rank and (AIJ.isSuit(c, suit, state) or suits[suit] or info.suit == suit) then
          AIJ.set(j, 'triggered', true)
          j:popup(AIJ.msg('k_aij_hunted_ex', 'Hunted!'), colors.MULT)
          break
        end
      end
    end
  end

  local total = 0
  for _, c in ipairs(cards) do
    local r = rankOf(c)
    if r and r >= 2 and r <= 10 then total = total + r end
  end
  if total > 0 then
    for _, j in ipairs(owned('veggie_joker', state)) do
      AIJ.add(j, 'chips', total * 3)
      j:popup('+' .. AIJ.fmt(total * 3) .. ' Points', colors.CHIPS)
    end
  end

  for _, c in ipairs(cards) do
    local info = c.lastInfo or {}
    if info.kind == 'playing' and info.face and not info.noRank then
      AIJ.run.visage_last = { uid = c.uid, rank = info.rank, suit = info.suit, points = info.points }
    end
  end
end)

local HELD_FOR = 'aij_b10_held_for'
cardlike.on('onRoundStart', function(state)
  for _, j in ipairs(state.jokers or {}) do
    local ds = j:getDataStore()
    ds:set(HELD_FOR, (tonumber(ds:get(HELD_FOR)) or 0) + 1)
  end
end)
AIJ.onJokerGone(function(state, info, sold)
  local held = tonumber(info.store and info.store[HELD_FOR]) or 0
  if held <= 0 then return end
  for _, j in ipairs(owned('truhan', state)) do
    local x = AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod') * held)
    j:popup('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
  end
end)

AIJ.addJoker {
  key = 'truhan',
  lite = true,
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 8 },
  config = { xmult = 1, xmult_mod = 0.1 },
  vars = function(card) return { AIJ.val(card, 'truhan', 'xmult'), AIJ.val(card, 'truhan', 'xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'trypophobia',
  rarity = 1, cost = 4, atlas = 'joker_atlas',
  pos = AIJ.setting('alter_trypophobia') and { x = 3, y = 14 } or { x = 15, y = 0 },
  config = { mult = 20 },
  vars = function(card) return { AIJ.val(card, 'trypophobia', 'mult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if #cards == 0 then return end
      for _, c in ipairs(cards) do if rankOf(c) ~= 8 then return end end
      result:add(plusMult(AIJ.num(joker, 'mult')))
