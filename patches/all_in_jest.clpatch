add {
  key = 'dapper_dan',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 5 },
  blueprint_compat = false,
  description = withNote('dapper_dan', nil, '(Luna, Holo and Chroma)'),
  in_pool = function(state)
    for _, j in ipairs(state and state.jokers or {}) do
      if AIJ.edition(j) then return true end
    end
    return false
  end,
  triggers = {
    finalScoring = function(joker, state, step, result)
      if step.copiedBy then return end
      local dans = owned('dapper_dan')
      if dans[1] ~= joker then return end
      local n = #dans
      for _, j in ipairs(state.jokers or {}) do
        if not AIJ.isDebuffed(j) then
          local e = AIJ.edition(j)
          if e == 'Luna' then
            result:add(plusChips(50 * n)); result:say('+' .. (50 * n) .. ' Points', colors.CHIPS, j)
          elseif e == 'Holo' then
            result:add(plusMult(10 * n)); result:say('+' .. (10 * n) .. ' Mult', colors.MULT, j)
          elseif e == 'Chroma' then
            result:add(xMult(1 + n)); result:say('X' .. (1 + n) .. ' Mult', colors.MULT, j)
          end
        end
      end
    end,
  },
}

local DM_TYPES = { 'game', 'fruit', 'admin' }
cardlike.on('onCardCreated', function(state, step)
  local c = step and step.card
  if type(c) ~= 'table' or not state or #owned('dark_magician') == 0 then return end
  local info = c.lastInfo or {}
  if info.kind ~= 'consumable' or (info.area ~= 'shop' and info.area ~= 'pack') then return end
  if not AIJ.contains(DM_TYPES, info.type) then return end
  local counts, total = {}, 0
  for _, e in ipairs(cardlike.listContent('consumable') or {}) do
    if AIJ.contains(DM_TYPES, e.type) then
      counts[e.type] = (counts[e.type] or 0) + 1
      total = total + 1
    end
  end
  if total == 0 then return end
  local r = state:random(1, total)
  local pick
  for _, t in ipairs(DM_TYPES) do
    r = r - (counts[t] or 0)
    if r <= 0 then pick = t break end
  end
  if not pick or pick == info.type then return end
  local id = cardlike.randomConsumable(pick)
  if id then c:setConsumableDef(id) end
end)

