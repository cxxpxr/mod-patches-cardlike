    ["j_aij_yin"] = { name = "Yin", text = "Scoring [color=\"#e5e5e5\"][b]Dark Suits[/b][/color] give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]unique[/b][/color] [color=\"#e5e5e5\"][b]Dark Suit[/b][/color] in [color=\"#f3a712\"][b]scored hand[/b][/color]" },
