    ["j_aij_whiteface_grotesque"] = { name = "Whiteface Grotesque", text = "This Joker gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points for each [color=\"#f3a712\"][b]face[/b][/color] card [color=\"#f3a712\"][b]held in[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] when hand is played\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_wild_man"] = { name = "Wild Man", text = "" },
    ["j_aij_windswept_joker"] = { name = "Windswept Joker", text = "If played hand contains a [color=\"#f3a712\"][b]Straight Flush[/b][/color], level up [color=\"#f3a712\"][b]Straight Flush[/b][/color] by [color=\"#f3a712\"][b]#1#[/b][/color] levels" },
    ["j_aij_wire_joker"] = { name = "Wire Joker", text = "[color=\"#f3a712\"][b]Queens[/b][/color] give [color=\"#ff007f\"][b]X#2#[/b][/color] Mult and [color=\"#f3a712\"][b]$#1#[/b][/color] when scored" },
    ["j_aij_wireframe"] = { name = "Wireframe", text = "[color=\"#f3a712\"][b]First[/b][/color] played hand each round [color=\"#f3a712\"][b]returns[/b][/color] to your [color=\"#f3a712\"][b]hand[/b][/color]" },
    ["j_aij_witchfinder"] = { name = "Witchfinder", text = "[color=\"#f3a712\"][b]#1#[/b][/color] additional [color=\"#d138bf\"][b]Arcana[/b][/color] [color=\"#d138bf\"][b]Pack[/b][/color] available in [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_wizard"] = { name = "Wizard", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance for each scoring [color=\"#f3a712\"][b]non-enhanced[/b][/color] card to become a [color=\"#f3a712\"][b]Multicard[/b][/color] [color=\"#f3a712\"][b]Chipped card[/b][/color], or [color=\"#f3a712\"][b]Paperback card[/b][/color]" },
    ["j_aij_word_art"] = { name = "Word Art", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]Ace[/b][/color], [color=\"#f3a712\"][b]King[/b][/color], [color=\"#f3a712\"][b]Queen[/b][/color], or [color=\"#f3a712\"][b]Jack[/b][/color] in played hand" },
    ["j_aij_xinmo"] = { name = "Xinmo", text = "[color=\"#5d5dff\"][b]+#1#[/b][/color] Joker Slots,\n[color=\"#ff007f\"][b]-#2#[/b][/color] Hand Size" },
