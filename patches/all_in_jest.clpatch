local function czarPool(state, current)
  local list = {}
  for _, id in ipairs(AIJ.jokers) do
    local def = defOf(id)
    local rarity = AIJ.jokerRarity[id]
    local ok = def and def.copyable ~= false and not def.buttons and (def.triggers or def.dollarsAtRoundEnd)
      and not isCopier(id) and rarity ~= 'Legendary' and rarity ~= 'familiar_face' and not AIJ.noShop[id]
      and id ~= current
    if ok and AIJ.gates[id] then
      local good, res = pcall(AIJ.gates[id], state)
      ok = (not good) or res ~= false
    end
    if ok then list[#list + 1] = id end
  end
  return list
end

local function czarSet(joker, state)
  local ds = joker:getDataStore()
  local old = ds:get('aij_czar_keys')
  if type(old) == 'table' then for _, k in ipairs(old) do AIJ.set(joker, k, nil) end end
  AIJ.set(joker, 'aij_dongtong_n', nil)
  local id = AIJ.pick(czarPool(state, ds:get('aij_czar_copied')), state)
  ds:set('aij_czar_copied', id or '')
  local keys = {}
  if id then
    for k, v in pairs(AIJ.defaults[id] or {}) do
      ds:set(k, AIJ.copy(v))
      keys[#keys + 1] = k
    end
  end
  ds:set('aij_czar_keys', keys)
  return id
end

local function czarTargets(joker)
  local id = AIJ.get(joker, 'aij_czar_copied')
  local def = id and id ~= '' and defOf(id) or nil
  if not def then return {} end
  return { { card = joker, def = def, own = true } }
end

add {
  key = 'czar',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 14 },
  description = withNote('czar', nil, function(card)
    local id = card and AIJ.get(card, 'aij_czar_copied') or nil
    return '(Copies All in Jest Jokers. Currently: ' .. jokerName(id) .. ')'
  end),
  onAdded = function(joker, state)
    if (AIJ.get(joker, 'aij_czar_copied') or '') == '' then czarSet(joker, state) end
  end,
  dollarsAtRoundEnd = function(joker, state)
    local id = AIJ.get(joker, 'aij_czar_copied')
    local def = id and id ~= '' and defOf(id) or nil
    if def and def.dollarsAtRoundEnd then return def.dollarsAtRoundEnd(joker, state) or 0 end
    return 0
  end,
  triggers = copierTriggers(czarTargets, {
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      local id = czarSet(joker, state)
      joker:punch()
      result:say('Reroll: ' .. jokerName(id), colors.GREEN)
    end,
  }, { onShopReroll = true }),
}

