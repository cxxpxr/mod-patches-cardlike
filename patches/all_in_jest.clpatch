    ["j_aij_cesar"] = { name = "Cesar", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] each hand played. Increases by [color=\"#f3a712\"][b]$#2#[/b][/color] if [color=\"#f3a712\"][b]played hand[/b][/color] is only [color=\"#204887\"][b]Diamond [/b][/color][color=\"#f3a712\"][b]Kings[/b][/color]" },
