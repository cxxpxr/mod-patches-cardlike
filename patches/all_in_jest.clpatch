    ["j_aij_square_eyes"] = { name = "Square Eyes", text = "Scored [color=\"#f3a712\"][b]4s[/b][/color] give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]4[/b][/color] in played hand" },
    ["j_aij_squeezy_pete"] = { name = "Squeezy Pete", text = "Gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]consecutive[/b][/color] played hand containing a [color=\"#f3a712\"][b]Full House[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_stage_production"] = { name = "Stage Production", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Once per round, [color=\"#f3a712\"][b]temporarily[/b][/color] [color=\"#f3a712\"][b]reroll[/b][/color] Joker to the right until the next blind is selected [color=\"#9a9a9a\"]#1#[/color]" },
    ["j_aij_stagehand"] = { name = "Stagehand", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per held [color=\"#f3a712\"][b]Joker[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_stained_glass_joker"] = { name = "Stained Glass Joker", text = "[color=\"#f3a712\"][b]Fragile cards[/b][/color] count as any [color=\"#f3a712\"][b]suit[/b][/color]" },
    ["j_aij_stargazer"] = { name = "Stargazer", text = "" },
    ["j_aij_stargazy_pie"] = { name = "Stargazy Pie", text = "Retrigger the next [color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#13afce\"][b]Fruit[/b][/color] cards used" },
    ["j_aij_stave"] = { name = "Stave", text = "When a Joker with an [color=\"#5d5dff\"][b]Edition[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color], apply its [color=\"#5d5dff\"][b]Edition[/b][/color] to a random [color=\"#f3a712\"][b]uneditioned[/b][/color] Joker\n[color=\"#9a9a9a\"](If possible)[/color]\n[color=\"#9a9a9a\"](Excluding Inverted)[/color]" },
    ["j_aij_stereoscopic_joker"] = { name = "Stereoscopic Joker", text = "" },
    ["j_aij_steven"] = { name = "Steven", text = "" },
    ["j_aij_stick_figure"] = { name = "Stick Figure", text = "" },
    ["j_aij_sticker"] = { name = "Sticker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]sticker[/b][/color] on your [color=\"#f3a712\"][b]Jokers[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_sticker_sheet_needs_renamed"] = { name = "Sticker Sheet (Needs Renamed)", text = "" },
    ["j_aij_stock_broker"] = { name = "Stock Broker", text = "Multiplies [color=\"#f3a712\"][b]interest[/b][/color] by a random amount between [color=\"#f3a712\"][b]X#1#[/b][/color] and [color=\"#f3a712\"][b]X#2#[/b][/color]" },
    ["j_aij_stock_photo"] = { name = "Stock Photo", text = "Opens a [color=\"#f3a712\"][b]Mega Deck Pack[/b][/color] when entering the [color=\"#f3a712\"][b]Shop[/b][/color]\n[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#ff007f\"][b]self-destruct[/b][/color] if it is [color=\"#f3a712\"][b]skipped[/b][/color]" },
    ["j_aij_stone"] = { name = "Stone", text = "" },
    ["j_aij_stracciatella"] = { name = "Stracciatella", text = "After each hand, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance for each [color=\"#f3a712\"][b]scoring[/b][/color] card to [color=\"#f3a712\"][b]permanently[/b][/color] earn [color=\"#f3a712\"][b]$#3#[/b][/color] when scored\n[color=\"#ff007f\"][b]Self-destructs[/b][/color] after triggering" },
    ["j_aij_straight_to_hell"] = { name = "Straight to Hell", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when discard contains a [color=\"#f3a712\"][b]Straight[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_string_theory"] = { name = "String Theory", text = "[color=\"#3772ff\"][b]Hand[/b][/color] always counts as containing a [color=\"#f3a712\"][b]Straight[/b][/color]" },
    ["j_aij_stultor"] = { name = "Stultor", text = "Reroll [color=\"#f3a712\"][b]Boss Blind [/b][/color][color=\"#f3a712\"][b]#1#[/b][/color] time per Ante, at no cost" },
    ["j_aij_stupid_sauce"] = { name = "Stupid Sauce", text = "" },
    ["j_aij_sudoku"] = { name = "Sudoku", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per consecutive played hand containing a [color=\"#f3a712\"][b]Straight[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_suibhne"] = { name = "Suibhne", text = "This Joker gains [color=\"#3772ff\"][b]X#1#[/b][/color] Points per card in the [color=\"#f3a712\"][b]played hand[/b][/color] if hand contains only [color=\"#f3a712\"][b]Star[/b][/color] [color=\"#f3a712\"][b]Kings[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#3772ff\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_summer_tan"] = { name = "Summer Tan", text = "" },
    ["j_aij_sundae_1"] = { name = "Sundae", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points\n[color=\"#f3a712\"][b]Consumed[/b][/color] after [color=\"#f3a712\"][b]#2#[/b][/color] Rounds" },
    ["j_aij_sundae_2"] = { name = "Sundae", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult\n[color=\"#f3a712\"][b]Consumed[/b][/color] after [color=\"#f3a712\"][b]#2#[/b][/color] Rounds" },
    ["j_aij_sundae_3"] = { name = "Sundae", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#f3a712\"][b]Consumed[/b][/color] after [color=\"#f3a712\"][b]#2#[/b][/color] Rounds" },
    ["j_aij_sunny_joker"] = { name = "Sunny Joker", text = "If played hand [color=\"#f3a712\"][b]contains[/b][/color] a [color=\"#f3a712\"][b]Royal Flush[/b][/color], all scoring cards gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_sunny_side"] = { name = "Sunny Side", text = "When any [color=\"#f3a712\"][b]money[/b][/color] is earned, this [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#f3a712\"][b]double[/b][/color] that [color=\"#f3a712\"][b]money[/b][/color] as sell value, and [color=\"#ff007f\"][b]subtracts[/b][/color] [color=\"#f3a712\"][b]money[/b][/color] earned" },
    ["j_aij_super_meat_joker"] = { name = "Super Meat Joker", text = "" },
    ["j_aij_surgeon"] = { name = "Surgeon", text = "" },
    ["j_aij_survivalaren_credits_joker"] = { name = "Survivalaren", text = "[color=\"#9a9a9a\"]\"Take it sleazy\"[/color]" },
    ["j_aij_suspend"] = { name = "Suspend", text = "" },
    ["j_aij_tabula_rasa"] = { name = "Tabula Rasa", text = "When [color=\"#f3a712\"][b]Blind[/b][/color] is selected, this Joker's [color=\"#5d5dff\"][b]Edition[/b][/color] is removed and its effects become [color=\"#f3a712\"][b]inherent[/b][/color]" },
    ["j_aij_taggart"] = { name = "Taggart", text = "Create [color=\"#f3a712\"][b]#1# copy[/b][/color] of each [color=\"#f3a712\"][b]Pin[/b][/color] acquired\n[color=\"#9a9a9a\"](Except Donut Pin)[/color]" },
    ["j_aij_taikomochi"] = { name = "Taikomochi", text = "[color=\"#f3a712\"][b]Jacks[/b][/color] held in hand give [color=\"#3772ff\"][b]+#1#[/b][/color] Points" },
    ["j_aij_taillefer"] = { name = "Taillefer", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult per hand played, [color=\"#ff007f\"][b]self-destructs[/b][/color] after defeating [color=\"#f3a712\"][b]#3#[/b][/color] [color=\"#f3a712\"][b]Boss Blinds[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult, [/color][color=\"#f3a712\"][b]#4#[/b][/color][color=\"#9a9a9a\"]/[/color][color=\"#f3a712\"][b]#3#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_talhak"] = { name = "Talhak", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated, choose [color=\"#f3a712\"][b]any[/b][/color] non-secret [color=\"#4584fa\"][b]Admin[/b][/color] card to create\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_tangled_joker"] = { name = "Tangled Joker", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points for each [color=\"#f3a712\"][b]Joker[/b][/color] held [color=\"#ff007f\"][b]+#2#[/b][/color] Mult per empty [color=\"#f3a712\"][b]Joker slot[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#3#[/b][/color][color=\"#9a9a9a\"] Points, [/color][color=\"#ff007f\"][b]+#4#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_tar_joker"] = { name = "Tar Joker", text = "" },
    ["j_aij_tarlton"] = { name = "Tarlton", text = "Gives [color=\"#3772ff\"][b]+Points[/b][/color] equal to [color=\"#f3a712\"][b]total[/b][/color] [color=\"#3772ff\"][b]Points[/b][/color] of [color=\"#f3a712\"][b]previous[/b][/color] played [color=\"#f3a712\"][b]hand[/b][/color] this round\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_tax_collector"] = { name = "Tax Collector", text = "" },
    ["j_aij_tax_return"] = { name = "Tax Return", text = "" },
    ["j_aij_taylor_credits_joker"] = { name = "Taylor", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_te_aroha"] = { name = "Te Aroha", text = "" },
    ["j_aij_teeny_joker"] = { name = "Teeny Joker", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points if played hand contains only [color=\"#f3a712\"][b]2s[/b][/color]" },
    ["j_aij_tellurian_joker"] = { name = "Tellurian Joker", text = "" },
    ["j_aij_ten_sharp"] = { name = "Ten Sharp", text = "[color=\"#f3a712\"][b]Retriggers[/b][/color] all scored cards [color=\"#f3a712\"][b]adjacent[/b][/color] to [color=\"#f3a712\"][b]10s[/b][/color]" },
    ["j_aij_test_card"] = { name = "Test Card", text = "[color=\"#f3a712\"][b]Editions[/b][/color] held in hand trigger their effects" },
    ["j_aij_tetraphobia"] = { name = "Tetraphobia", text = "This Joker gains [color=\"#ff007f\"][b]+#2#[/b][/color] Mult per [color=\"#f3a712\"][b]4[/b][/color] discarded, resets when a [color=\"#f3a712\"][b]4[/b][/color] is scored\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_tetrominoker"] = { name = "Tetrominoker", text = "Scoring [color=\"#f3a712\"][b]4s[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a [color=\"#f3a712\"][b]copy[/b][/color] of themselves" },
    ["j_aij_thalia"] = { name = "Thalia", text = "If [color=\"#f3a712\"][b]first discard[/b][/color] of round contains exactly [color=\"#f3a712\"][b]1[/b][/color] card, it permanently gains [color=\"#f3a712\"][b]+#1#[/b][/color] retrigger" },
    ["j_aij_the_artist"] = { name = "The Artist", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Selection limit for [color=\"#d138bf\"][b]Game[/b][/color] Cards" },
    ["j_aij_the_bell"] = { name = "The Bell", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to reroll the [color=\"#f3a712\"][b]Ticket[/b][/color]" },
    ["j_aij_the_black_spot"] = { name = "The Black Spot", text = "" },
    ["j_aij_the_clown_show"] = { name = "The Clown Show", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points per [color=\"#f3a712\"][b]Joker[/b][/color] purchased this run\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_the_dud"] = { name = "The Dud", text = "" },
    ["j_aij_the_far_lands"] = { name = "A Far Land", text = "[color=\"#f3a712\"][b]#1#s[/b][/color] count as [color=\"#f3a712\"][b]the same rank[/b][/color]" },
    ["j_aij_the_freezer"] = { name = "The Freezer", text = "" },
    ["j_aij_the_green_room"] = { name = "The Green Room", text = "" },
    ["j_aij_the_grim_joker"] = { name = "The Grim Joker", text = "[color=\"#f3a712\"][b]Consumables[/b][/color] created by [color=\"#13afce\"][b]Blue[/b][/color] or [color=\"#d138bf\"][b]Purple[/b][/color] Stamps have a [color=\"#1bb18c\"][b]#1# in #2# chance[/b][/color] to be [color=\"#5d5dff\"][b]Inverted[/b][/color]" },
    ["j_aij_the_hare"] = { name = "The Hare", text = "Adds [color=\"#d78fd0\"][b]#1#[/b][/color] to your total score every hand" },
    ["j_aij_the_herald"] = { name = "The Herald", text = "[color=\"#3772ff\"][b]Hand[/b][/color] always counts as containing the [color=\"#f3a712\"][b]most[/b][/color] [color=\"#f3a712\"][b]played hand[/b][/color]\n[color=\"#9a9a9a\"](Currently: [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_the_house_that_jack_built"] = { name = "The House that Jack Built", text = "Scored [color=\"#f3a712\"][b]Jacks[/b][/color] give [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] equal to the [color=\"#f3a712\"][b]level[/b][/color] of [color=\"#f3a712\"][b]Full House[/b][/color]" },
    ["j_aij_the_jester"] = { name = "The Jester", text = "The first [color=\"#f3a712\"][b]Joker[/b][/color] sold each round creates [color=\"#d138bf\"][b]Prism[/b][/color] [color=\"#9a9a9a\"]#1#[/color]" },
    ["j_aij_the_jolly"] = { name = "The Jolly", text = "If played hand [color=\"#f3a712\"][b]contains[/b][/color] a [color=\"#f3a712\"][b]Straight Flush[/b][/color], it is scored with additional levels equal to the [color=\"#f3a712\"][b]combined[/b][/color] levels of [color=\"#f3a712\"][b]Flush[/b][/color] and [color=\"#f3a712\"][b]Straight[/b][/color]" },
    ["j_aij_the_judge"] = { name = "The Judge", text = "" },
    ["j_aij_the_last_man"] = { name = "The Last Man", text = "" },
    ["j_aij_the_living_god"] = { name = "The Living God", text = "" },
    ["j_aij_the_ludovico_technique"] = { name = "The Ludovico Technique", text = "Level up the [color=\"#f3a712\"][b]first hand[/b][/color] of each round when playing the [color=\"#f3a712\"][b]final hand[/b][/color] of the round\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_the_mark"] = { name = "The Mark", text = "" },
    ["j_aij_the_mermaid"] = { name = "The Mermaid", text = "You may [color=\"#ff007f\"][b]discard[/b][/color] at least [color=\"#f3a712\"][b]once[/b][/color] during [color=\"#f3a712\"][b]Packs[/b][/color]" },
    ["j_aij_the_mycologists"] = { name = "The Mycologists", text = "If played hand is exactly a [color=\"#f3a712\"][b]#1#[/b][/color], [color=\"#ff007f\"][b]destroy[/b][/color] the right card and give its [color=\"#3772ff\"][b]Points[/b][/color], [color=\"#5d5dff\"][b]Enhancement[/b][/color], and [color=\"#5d5dff\"][b]Edition[/b][/color] to the left card" },
    ["j_aij_the_slab"] = { name = "The Slab", text = "" },
    ["j_aij_the_tape"] = { name = "The Tape", text = "" },
    ["j_aij_the_treachery_of_jokers"] = { name = "The Treachery of Jokers", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult, goes in your [color=\"#f3a712\"][b]consumable[/b][/color] slot" },
    ["j_aij_theyre_laughing_at_you"] = { name = "They're Laughing at You...", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated, apply [color=\"#5d5dff\"][b]Inverted[/b][/color] to a random [color=\"#009dff\"][b]Common[/b][/color] Joker" },
    ["j_aij_third_degree"] = { name = "Third Degree", text = "" },
    ["j_aij_thomazina"] = { name = "Thomazina", text = "Scored [color=\"#f3a712\"][b]numbered[/b][/color] cards give [color=\"#3772ff\"][b]+#1#[/b][/color] Points. Increases by [color=\"#3772ff\"][b]+#2#[/b][/color] Points when a [color=\"#f3a712\"][b]numbered[/b][/color] card is scored" },
    ["j_aij_tilty_joker"] = { name = "Tilty Joker", text = "[color=\"#f3a712\"][b]Scoring[/b][/color] cards give [color=\"#f3a712\"][b]X#1#[/b][/color] their base [color=\"#3772ff\"][b]Points[/b][/color]" },
    ["j_aij_tin"] = { name = "Tin", text = "If played hand is [color=\"#f3a712\"][b]Flush[/b][/color], retrigger all scoring cards" },
    ["j_aij_tin_man"] = { name = "Tin Man", text = "Apply [color=\"#f3a712\"][b]Steel[/b][/color] to all unenhanced [color=\"#c23447\"][b]Heart[/b][/color] suit cards [color=\"#f3a712\"][b]held in[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] at end of round" },
    ["j_aij_tipples_the_clown"] = { name = "Tipples The Clown", text = "" },
    ["j_aij_tipteerer"] = { name = "Tipteerer", text = "Earn [color=\"#f3a712\"][b]#2#%[/b][/color] of the [color=\"#f3a712\"][b]sell value[/b][/color] of other [color=\"#f3a712\"][b]Jokers[/b][/color], rounded up, at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_toe_tag"] = { name = "Toe Pin", text = "" },
    ["j_aij_tom_thumb"] = { name = "Tom Thumb", text = "" },
    ["j_aij_tomato_sauce"] = { name = "Tomato Sauce", text = "" },
    ["j_aij_tonpraten"] = { name = "Tonpraten", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult, [color=\"#f3a712\"][b]always[/b][/color] [color=\"#f3a712\"][b]triggers last[/b][/color]" },
    ["j_aij_tool"] = { name = "Tool", text = "Cards that change [color=\"#f3a712\"][b]suit[/b][/color] permanently gain [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_toothy_joker"] = { name = "Toothy Joker", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points for each [color=\"#d138bf\"][b]Game[/b][/color] card used this [color=\"#f3a712\"][b]Ante[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_topsy_the_clown"] = { name = "Topsy the Clown", text = "Rounds [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] upwards to the next closest [color=\"#f3a712\"][b]palindrome[/b][/color]" },
    ["j_aij_tornado"] = { name = "Tornado", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult after all [color=\"#f3a712\"][b]ranks[/b][/color] have been scored at least once\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\n[color=\"#9a9a9a\"](Remaining: #3#[/color] [color=\"#9a9a9a\"]#4#[/color]" },
    ["j_aij_tortilla_chips"] = { name = "Tortilla Points", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Bonus[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when hands [color=\"#3772ff\"][b]Points[/b][/color] exceeds [color=\"#ff007f\"][b]Mult[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Blind[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_totally_nuts"] = { name = "Totally Nuts", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Consumable Slots, [color=\"#f3a712\"][b]consumed[/b][/color] when a [color=\"#f3a712\"][b]consumable[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color]" },
    ["j_aij_totem_pole"] = { name = "Totem Pole", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult, [color=\"#f3a712\"][b]shuffle[/b][/color] Jokers before scoring" },
    ["j_aij_toto"] = { name = "Toto", text = "Create [color=\"#f3a712\"][b]#1#[/b][/color] copies of each [color=\"#f3a712\"][b]Pin[/b][/color] acquired\n[color=\"#9a9a9a\"](Except Donut Pin)[/color]" },
    ["j_aij_touchstone"] = { name = "Touchstone", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] hand size Reveals the next [color=\"#f3a712\"][b]#2#[/b][/color] cards in your deck" },
    ["j_aij_toynbee_joker"] = { name = "Toynbee Joker", text = "Create the [color=\"#13afce\"][b]Fruit[/b][/color] card for the first played [color=\"#f3a712\"][b]poker hand[/b][/color] of the round when Blind is [color=\"#f3a712\"][b]defeated[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_toyrapple"] = { name = "Toyrapple", text = "" },
    ["j_aij_toyrapple_credits_joker"] = { name = "Toyrapple", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_tract"] = { name = "Tract", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points per [color=\"#f3a712\"][b]Ticket[/b][/color] owned\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_train_conductor"] = { name = "Train Conductor", text = "[color=\"#ff007f\"][b]+Mult[/b][/color] Jokers instead give [color=\"#ff007f\"][b]XMult[/b][/color] equal to [color=\"#f3a712\"][b]#1#%[/b][/color] of their original values\n[color=\"#9a9a9a\"](Minimum [/color][color=\"#ff007f\"][b]X1.2[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\n[color=\"#ff007f\"][b]XMult[/b][/color] Jokers instead give [color=\"#ff007f\"][b]+Mult[/b][/color] equal to [color=\"#f3a712\"][b]#2#%[/b][/color] of their original values" },
    ["j_aij_treasure_map"] = { name = "Treasure Map", text = "After skipping [color=\"#f3a712\"][b]#1#-#2#[/b][/color] Blinds, create a [color=\"#f3a712\"][b]Stereoscopic Pin[/b][/color]" },
    ["j_aij_triple_gooberberry_sunrise"] = { name = "Triple Gooberberry Sunrise", text = "[color=\"#1bb18c\"][b]+#1#[/b][/color] to all [color=\"#f3a712\"][b]listed[/b][/color] [color=\"#1bb18c\"][b]probabilities[/b][/color], [color=\"#f3a712\"][b]consumed[/b][/color] after [color=\"#f3a712\"][b]#2#[/b][/color] Antes" },
    ["j_aij_triple_sundae"] = { name = "Triple Sundae", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points, [color=\"#ff007f\"][b]+#2#[/b][/color] Mult, Earn [color=\"#f3a712\"][b]$#3#[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#f3a712\"][b]Partly[/b][/color] consumed after [color=\"#f3a712\"][b]#4#[/b][/color] Rounds" },
    ["j_aij_trophy_kill"] = { name = "Trophy Kill", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult after a [color=\"#f3a712\"][b]#2# of[/b][/color] [color=\"#f3a712\"][b]#3#[/b][/color] has been [color=\"#ff007f\"][b]destroyed[/b][/color] [color=\"#9a9a9a\"]#4#[/color]" },
    ["j_aij_truhan"] = { name = "Truhan", text = "When any Joker is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color], this Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult per [color=\"#f3a712\"][b]round[/b][/color] that Joker has been held\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_trypophobia"] = { name = "Trypophobia", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if scored hand contains only [color=\"#f3a712\"][b]8s[/b][/color]" },
    ["j_aij_tumbler"] = { name = "Tumbler", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult, loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a card is [color=\"#f3a712\"][b]selected[/b][/color]" },
    ["j_aij_turrn"] = { name = "Turrón", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Shop Slots\n[color=\"#ff007f\"][b]-#2#[/b][/color] Shop Slot at end of round" },
    ["j_aij_tussaud"] = { name = "Tussaud", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per unique [color=\"#f3a712\"][b]Stamp[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_twisted_pair"] = { name = "Twisted Pair", text = "If hand is a [color=\"#f3a712\"][b]Pair[/b][/color], each card gains a suit [color=\"#f3a712\"][b]patch[/b][/color] corresponding to the suit of the [color=\"#f3a712\"][b]other card[/b][/color]" },
    ["j_aij_two_fifty_six"] = { name = "256", text = "" },
