AIJ.addJoker {
  key = 'tumbler',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 8, y = 4 },
  config = { Xmult = 3, Xmult_loss = 0.02 },
  vars = function(card) return { AIJ.val(card, 'tumbler', 'Xmult'), AIJ.val(card, 'tumbler', 'Xmult_loss') } end,
  triggers = {
    onCardSelected = function(joker, state, step, result)
      if step.copiedBy or not step.selected or state.phase ~= 'play' then return end
      local loss = AIJ.num(joker, 'Xmult_loss')
      if AIJ.num(joker, 'Xmult') - loss <= 1 then
        result:say(AIJ.msg('k_aij_empty_ex', 'Empty!'), colors.ORANGE)
        result:destroySelf()
      else
        AIJ.add(joker, 'Xmult', -loss)
        result:say('-X' .. AIJ.fmt(loss) .. ' Mult', colors.MULT)
        result.shouldWaitAfterActivation = false
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      result:add(xMult(AIJ.num(joker, 'Xmult')))
    end,
  },
}

AIJ.addJoker {
  key = 'turrn',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 23, y = 43 },
  config = { slots = 5, slots_mod = 1 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'turrn', 'slots'), AIJ.val(card, 'turrn', 'slots_mod') } end,
  onAdded = function(joker, state)
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + AIJ.num(joker, 'slots')
  end,
  onRemoved = function(joker, state)
    state.cardsAvailableInShopCount = math.max(0, state.cardsAvailableInShopCount - AIJ.num(joker, 'slots'))
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local slots, mod = AIJ.num(joker, 'slots'), AIJ.num(joker, 'slots_mod')
      if slots - mod <= 0 then
        result:say('Eaten!', colors.ORANGE)
        result:destroySelf()
      else
        AIJ.set(joker, 'slots', slots - mod)
        state.cardsAvailableInShopCount = math.max(0, state.cardsAvailableInShopCount - mod)
        result:say('-' .. AIJ.fmt(mod) .. ' Slot', colors.ORANGE)
      end
    end,
  },
}

local function uniqueStamps(state)
  local seen, n = {}, 0
  for _, c in ipairs(state and state.allCards or {}) do
    local s = AIJ.stamp(c)
    if s and not seen[s] then seen[s] = true n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'tussaud',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 6, y = 28 },
  config = { xmult_gain = 0.5 },
  vars = function(card)
    local g = AIJ.val(card, 'tussaud', 'xmult_gain')
    return { g, 1 + g * uniqueStamps(cardlike.state) }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = uniqueStamps(state)
      if n > 0 then result:add(xMult(1 + n * AIJ.num(joker, 'xmult_gain'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'twisted_pair',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 16, y = 12 },
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy or step.hand.handType ~= 'PAIR' then return end
      local cards = step.hand.playedCards or {}
      local suits = {}
      for _, c in ipairs(cards) do
        local s = AIJ.safe(c.getSuit, c)
        if s and not AIJ.noRank(c) then suits[s] = true end
      end
      local any = false
      for _, c in ipairs(cards) do
        local own = AIJ.safe(c.getSuit, c)
        if own and not AIJ.noRank(c) then
          for s in pairs(suits) do
            if s ~= own and AIJ.addPatch(c, s) then
              c:popup(s, AIJ.SUIT_COLORS[s] or colors.ORANGE)
              any = true
            end
          end
        end
      end
      if any then joker:punch() end
    end,
  },
}

AIJ.addJoker {
  key = 'unobtanium',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 23, y = 32 },
  in_pool = function(state)
    local h = state and state.getHand and state:getHand('FIVE_OF_A_KIND')
    return h ~= nil and (h.played or 0) > 0
  end,
  triggers = {
    repeatCard = function(joker, state, step, result)
      if step.hand.handType == 'FIVE_OF_A_KIND' then return 1 end
    end,
  },
}

