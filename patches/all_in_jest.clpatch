    state.handSize = state.handSize - AIJ.num(joker, 'h_size')
  end,
  onRemoved = function(joker, state)
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) - AIJ.num(joker, 'slots')
    state.handSize = state.handSize + AIJ.num(joker, 'h_size')
  end,
}

local function suitBonus(key, suitsA, suitsB)
  return function(joker, state, step, result)
    local c = step.card
    if not (AIJ.isSuit(c, suitsA, state) or AIJ.isSuit(c, suitsB, state)) then return end
    local a, b = 0, 0
    for _, p in ipairs(step.hand.playedCards or {}) do
      if AIJ.isSuit(p, suitsA, state) then a = 1 end
      if AIJ.isSuit(p, suitsB, state) then b = 1 end
    end
    if a + b > 0 then result:add(plusMult((a + b) * AIJ.num(joker, 'mult'))) end
  end
end

