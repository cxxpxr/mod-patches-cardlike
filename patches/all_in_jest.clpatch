    ["j_aij_gonnella"] = { name = "Gonella", text = "[color=\"#f3a712\"][b]Create[/b][/color] a random [color=\"#5d5dff\"][b]Editioned[/b][/color] Joker of the same rarity when a non-[color=\"#5d5dff\"][b]editioned[/b][/color] Joker is [color=\"#f3a712\"][b]sold[/b][/color]" },
    ["j_aij_goo_joker"] = { name = "Goo Joker", text = "Scored [color=\"#f3a712\"][b]enhanced[/b][/color] cards give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_goofball"] = { name = "Goofball", text = "Scored [color=\"#f3a712\"][b]face[/b][/color] cards [color=\"#d78fd0\"][b]balance[/b][/color] [color=\"#f3a712\"][b]#1#%[/b][/color] of [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color]" },
    ["j_aij_goon_joker"] = { name = "Goon Joker", text = "[color=\"#ff007f\"][b]#2#[/b][/color] Mult on the [color=\"#f3a712\"][b]Boss Blind[/b][/color], [color=\"#ff007f\"][b]+#1#[/b][/color] Mult otherwise" },
    ["j_aij_gopnik"] = { name = "Gopnik", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to grant this Joker [color=\"#ff007f\"][b]+#3#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_graffiti"] = { name = "Graffiti", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to recieve a random [color=\"#f3a712\"][b]Pin[/b][/color]\n[color=\"#f3a712\"][b]Cost[/b][/color] increases by [color=\"#ff007f\"][b]X#2#[/b][/color] after use. Resets after [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated" },
    ["j_aij_grandma"] = { name = "Grandma", text = "" },
    ["j_aij_grass"] = { name = "Grass", text = "\"the game\"" },
    ["j_aij_grass_credits_joker"] = { name = "Grass", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_greasepaint"] = { name = "Greasepaint", text = "Debuffs adjacent [color=\"#f3a712\"][b]Jokers[/b][/color]\nDebuffed [color=\"#f3a712\"][b]Jokers[/b][/color] and [color=\"#f3a712\"][b]cards[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_great_kraken"] = { name = "Great Kraken", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult for each [color=\"#3772ff\"][b]hand[/b][/color] remaining\n[color=\"#9a9a9a\"](Will give [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\n[color=\"#9a9a9a\"](Minimum [/color][color=\"#ff007f\"][b]X1[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_great_white_north"] = { name = "Great White North", text = "Played cards give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult when [color=\"#f3a712\"][b]scored[/b][/color]" },
    ["j_aij_grey_goo"] = { name = "Grey Goo", text = "" },
    ["j_aij_grock"] = { name = "Grock", text = "" },
    ["j_aij_grue"] = { name = "Grue", text = "" },
    ["j_aij_grumpy_gus"] = { name = "Grumpy Gus", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per unused [color=\"#ff007f\"][b]discard[/b][/color] this run\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_guillaume"] = { name = "Guillaume", text = "If [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated with less than [color=\"#f3a712\"][b]5[/b][/color] Jokers, this Joker gains [color=\"#5d5dff\"][b]+#2#[/b][/color] Joker Slot\n[color=\"#9a9a9a\"](Currently [/color][color=\"#5d5dff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Joker Slots)[/color]" },
    ["j_aij_guiser"] = { name = "Guiser", text = "Gains [color=\"#f3a712\"][b]$#1#[/b][/color] of [color=\"#f3a712\"][b]sell value[/b][/color] when a [color=\"#d138bf\"][b]Game[/b][/color] card is used" },
    ["j_aij_gumdrops"] = { name = "Gumdrops", text = "" },
    ["j_aij_gummy"] = { name = "Gummy", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points [color=\"#ff007f\"][b]+#2#[/b][/color] Mult" },
    ["j_aij_hacking_minigame"] = { name = "Hacking Minigame", text = "" },
    ["j_aij_haggler"] = { name = "Haggler", text = "[color=\"#f3a712\"][b]Gilded cards[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to earn [color=\"#f3a712\"][b]$#3#[/b][/color] when [color=\"#f3a712\"][b]discarded[/b][/color]" },
    ["j_aij_hairy_joker"] = { name = "Hairy Joker", text = "" },
    ["j_aij_hall_monitor"] = { name = "Hall Monitor", text = "" },
    ["j_aij_hallucinaut"] = { name = "Hallucinaut", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a [color=\"#f3a712\"][b]Pack[/b][/color] is purchased, [color=\"#f3a712\"][b]resets[/b][/color] when [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_halter_sack"] = { name = "Halter-sack", text = "[color=\"#ff007f\"][b]X#3#[/b][/color] Mult if hand contains at least [color=\"#f3a712\"][b]4[/b][/color] scoring cards, [color=\"#f3a712\"][b]decreases[/b][/color] by [color=\"#ff007f\"][b]X#2#[/b][/color] Mult per [color=\"#ff007f\"][b]discard[/b][/color] used this round" },
    ["j_aij_hand_drawn"] = { name = "Hand Drawn", text = "At [color=\"#f3a712\"][b]start[/b][/color] of round, keep drawing cards until your hand [color=\"#f3a712\"][b]contains[/b][/color] your most played [color=\"#f3a712\"][b]poker hand[/b][/color]" },
    ["j_aij_handsome_joker"] = { name = "Handsome Joker", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]#2#[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color] Card does [color=\"#f3a712\"][b]not[/b][/color] change\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_handyman"] = { name = "Handyman", text = "" },
    ["j_aij_hangman"] = { name = "Hangman", text = "If played hand contains a [color=\"#f3a712\"][b]#1#[/b][/color] of [color=\"#V1#\"][b]#2#[/b][/color], create [color=\"#d138bf\"][b]Blade[/b][/color].\n[color=\"#9a9a9a\"](Card changes every round)[/color]\nIf not triggered for [color=\"#f3a712\"][b]#3# rounds,[/b][/color] [color=\"#ff007f\"][b]self-destructs[/b][/color] and creates a [color=\"#d138bf\"][b]Mage[/b][/color]" },
    ["j_aij_happy_as_larry"] = { name = "Happy as Larry", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult\n[color=\"#1bb18c\"][b]#2# in #3#[/b][/color] chance to [color=\"#f3a712\"][b]retrigger[/b][/color], [color=\"#f3a712\"][b]Chance[/b][/color] decreases by [color=\"#1bb18c\"][b]#4#[/b][/color] on each subsequent [color=\"#f3a712\"][b]retrigger[/b][/color]" },
    ["j_aij_happygolucky"] = { name = "Happy-Go-Lucky", text = "" },
    ["j_aij_hardy"] = { name = "Hardy", text = "Apply [color=\"#a9b6c6\"][b]Silver[/b][/color] to all scored [color=\"#f3a712\"][b]enhanced[/b][/color] cards" },
    ["j_aij_haruspex"] = { name = "Haruspex", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Spend [color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#ff007f\"][b]Discard[/b][/color] to choose [color=\"#f3a712\"][b]#2#[/b][/color] card from your [color=\"#f3a712\"][b]deck[/b][/color] to [color=\"#f3a712\"][b]draw[/b][/color] to hand" },
    ["j_aij_harvest_spirit"] = { name = "Harvest Spirit", text = "" },
    ["j_aij_hat_trick"] = { name = "Hat Trick", text = "If played hand is a [color=\"#f3a712\"][b]Three of a Kind[/b][/color], scored cards give [color=\"#ff007f\"][b]Mult[/b][/color] equal to its [color=\"#f3a712\"][b]level[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_haughty_joker"] = { name = "Haughty Joker", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points if played hand contains a [color=\"#f3a712\"][b]Royal Flush[/b][/color]" },
    ["j_aij_haunted_maze"] = { name = "Haunted Maze", text = "If played hand contains a [color=\"#f3a712\"][b]Straight[/b][/color], scoring cards give [color=\"#ff007f\"][b]Mult[/b][/color] equal to the number of times hand has been played" },
    ["j_aij_headache"] = { name = "Headache", text = "[color=\"#ff007f\"][b]+#2#[/b][/color] Mult [color=\"#f3a712\"][b]+$#1#[/b][/color] [color=\"#1bb18c\"][b]reroll[/b][/color] cost" },
    ["j_aij_headfooter"] = { name = "Headfooter", text = "" },
    ["j_aij_headstone"] = { name = "Headstone", text = "All [color=\"#f3a712\"][b]Face Cards[/b][/color] are shuffled to the [color=\"#ff007f\"][b]bottom[/b][/color] of your deck" },
    ["j_aij_heavenbrand_credits_joker"] = { name = "HEAVENBRAND", text = "[color=\"#9a9a9a\"]\"As they say in France,[/color] [color=\"#9a9a9a\"]'I'll take two.'\"[/color]" },
    ["j_aij_heavy_sixer"] = { name = "Heavy Sixer", text = "Apply [color=\"#5d5dff\"][b]Holo[/b][/color] to all scored [color=\"#f3a712\"][b]6s[/b][/color]" },
    ["j_aij_heel_turn"] = { name = "Heel Turn", text = "" },
    ["j_aij_hei_tiki"] = { name = "Hei-tiki", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult if played hand's final [color=\"#3772ff\"][b]Points[/b][/color] exceeds [color=\"#ff007f\"][b]Mult[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_heidelberg_tun"] = { name = "Heidelberg Tun", text = "Applies [color=\"#5d5dff\"][b]Inverted[/b][/color] to the first purchased [color=\"#f3a712\"][b]consumable[/b][/color] each shop [color=\"#9a9a9a\"]#1#[/color]" },
