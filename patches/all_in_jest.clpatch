local function isChefTarget(card)
  local info = card and card.lastInfo or {}
  if info.kind ~= 'joker' then return false end
  local sticker = info.sticker or AIJ.safe(card.getSticker, card)
  return sticker == 'timed' and rarityOf(card) == 'Common'
end
local function chefConvert(state, cards)
  if #active(state, 'chef') == 0 then return end
  for _, c in ipairs(cards or {}) do
    if isChefTarget(c) and AIJ.edition(c) ~= 'Inverted' then c:setEdition('Inverted') end
  end
end
add {
  key = 'chef',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 2, y = 13 },
  blueprint_compat = false,
  in_pool = function(state) return (state and state.stake or 0) >= 7 end,
}
cardlike.on('onShopEnter', function(state) chefConvert(state, state.shopCards) end)
cardlike.on('onShopReroll', function(state) chefConvert(state, state.shopCards) end)
cardlike.on('onPackOpened', function(state) chefConvert(state, state.packCards) end)
cardlike.filter('price', function(price, card)
  if isChefTarget(card) and card.lastInfo.area ~= 'jokers' and #active(cardlike.state, 'chef') > 0 then return 0 end
end)

add {
  key = 'chipped_joker',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 19, y = 23 },
  blueprint_compat = false,
  config = { chips_mod = 10, chips = 0, old_chips = 0 },
  vars = function(card) return { AIJ.val(card, 'chipped_joker', 'chips_mod'), AIJ.val(card, 'chipped_joker', 'chips') } end,
  in_pool = function(state) return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'm_stone') end) end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'old_chips', AIJ.num(joker, 'chips'))
    end,
    onScore = function(joker, state, step, result)
      local c = step.card
      if step.copiedBy or not AIJ.hasEnhancement(c, 'm_stone') then return end
      local left = ROCK_POINTS - storeNum(c, KEY_ROCK_TAKEN)
      local take = math.min(AIJ.num(joker, 'chips_mod'), left)
      if take <= 0 then return end
      AIJ.add(c, KEY_ROCK_TAKEN, take)
      AIJ.add(joker, 'chips', take)
      result:say('+' .. AIJ.fmt(take) .. ' Points', CHIPS)
    end,
    destroyCard = function(joker, state, step, result)
      local c = step.card
      return AIJ.hasEnhancement(c, 'm_stone') and storeNum(c, KEY_ROCK_TAKEN) >= ROCK_POINTS
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'old_chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

