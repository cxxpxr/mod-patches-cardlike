      local suits = {}
      for _, c in ipairs(step.hand.allCards or {}) do
        local s = info(c).suit or AIJ.safe(c.getSuit, c)
        if s then
          if suits[s] then return end
          suits[s] = true
        end
      end
      local hit = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if not AIJ.enhancement(c) then
          c:setEnhancement('Plaid')
          c:punch()
          hit = true
        end
      end
      if hit then result:say('Plaid!', colors.ORANGE) end
