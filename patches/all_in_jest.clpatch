  credits = 'Community member',
}

local function psychoTarget(card, state)
  local i = AIJ.safe(card.getIndex, card)
  local left = i and state and state.jokers and state.jokers[i - 1]
  if left and not left:isLocked() then return left end
  return nil
end

AIJ.addJoker {
  key = 'psycho',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 10, y = 25 }, lite = true,
  config = { xmult_gain = 0.1, xmult = 1 },
  blueprint_compat = true,
  description = function(r)
    local card = r and r.card
    return AIJ.fill(AIJ.loc('Joker', 'j_aij_psycho').text, {
      AIJ.val(card, 'psycho', 'xmult_gain'), AIJ.val(card, 'psycho', 'xmult'), colours = { ENHANCED },
    }):gsub(ABILITY_FIX[1], ABILITY_FIX[2]) .. '\n' .. grey('(Drag this Joker and press SLICE)')
  end,
  buttons = {
    AIJ.ability('psycho', {
      label = 'SLICE',
      canPress = function(card, state)
        return state and state.phase == 'play' and psychoTarget(card, state) ~= nil
      end,
      press = function(card, state)
        local left = psychoTarget(card, state)
        if not left then return false end
        local gain = AIJ.num(card, 'xmult_gain') * (left:getSellValue() or 0)
        local x = AIJ.add(card, 'xmult', gain)
        left:destroy()
        card:punch()
        card:popup('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
      end,
    }),
  },
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}


== file jokers/batch08.lua (1584 lines)
local AIJ = cardlike.require('lib.aij')
local P = cardlike.require('items.planets')


local function st() return cardlike.state end

local function rankOf(c)
  if AIJ.noRank(c) then return nil end
  return AIJ.safe(c.getRank, c)
end

local function firstOrLastHand(state)
  return (state.handsPlayed or 0) <= 1 or (state.handsLeft or 1) == 0
end

local function activeJokers(state, id)
  local out = {}
  for _, j in ipairs((state and state.jokers) or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end
local function active(state, id) return state ~= nil and AIJ.owns(id, state) end

local BASE_HANDS = { HIGH_CARD = true, PAIR = true, TWO_PAIR = true, THREE_OF_A_KIND = true, STRAIGHT = true,
  FLUSH = true, FULL_HOUSE = true, FOUR_OF_A_KIND = true, STRAIGHT_FLUSH = true }
local function visibleHands(state)
  local out = {}
  local hands = state and state.hands or {}
  for _, t in ipairs(AIJ.HANDS) do
    local h = hands[t]
    if h and (BASE_HANDS[t] or (h.played or 0) > 0) then out[#out + 1] = t end
  end
  for t, h in pairs(hands) do
    if not AIJ.contains(AIJ.HANDS, t) and (h.played or 0) > 0 then out[#out + 1] = t end
  end
  return out
end

local function baseHand(t) if t == 'ROYAL_FLUSH' then return 'STRAIGHT_FLUSH' end return t end

local function handStat(t, field, fallback)
  local s = st()
  local h = s and s.hands and s.hands[t]
  if h and h[field] ~= nil then return h[field] end
  return fallback
end

local function countCards(list, pred)
  local n = 0
  for _, c in ipairs(list or {}) do if pred(c) then n = n + 1 end end
  return n
end
local function deckCount(pred)
  local s = st()
  return countCards(s and s.allCards, pred)
end

local function upgradeText() return AIJ.msg('k_upgrade_ex', 'Upgrade!') end

local function moonOf(hand, kind)
  for _, m in ipairs(P.moons or {}) do
    if m.hand == hand and m.kind == kind then return m.key end
  end
  return nil
end

local function fruitInfo(c)
  local id = AIJ.defId(c)
  if not id then return nil end
  local short = AIJ.short(id)
  local m = short ~= id and P.moonByKey[short] or nil
  if m then return m.hand, m.kind end
  return P.handOf(id), nil
end

local function consumableType(c)
  return AIJ.safe(c.getConsumableType, c) or (c.lastInfo or {}).type
end

AIJ.addJoker {
  key = 'public_bathroom', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 3, y = 1 },
  config = { mult = 0, mult_mod = 2 },
  vars = function(card) return { AIJ.val(card, 'public_bathroom', 'mult_mod'), AIJ.val(card, 'public_bathroom', 'mult') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or not step.hand.contains.FLUSH or rankOf(step.card) ~= 2 then return end
      AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
      result:say(upgradeText(), colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
  key = 'punch_and_judy',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 16, y = 2 },
  triggers = {
    repeatCard = function(joker, state, step, result)
      local kings, queens = 0, 0
      for _, c in ipairs(step.hand.allCards or {}) do
        local r = rankOf(c)
        if r == 13 then kings = kings + 1 elseif r == 12 then queens = queens + 1 end
      end
      if kings == 1 and queens == 1 then return 1 end
    end,
  },
}

cardlike.filter('scoringCards', function(uids, played)
  local state = st()
  if not active(state, 'punch_and_judy') or type(played) ~= 'table' then return nil end
  local have, added = {}, false
  for _, u in ipairs(uids or {}) do have[u] = true end
  local out = {}
  for _, c in ipairs(played) do
    local uid = type(c) == 'table' and (c.uid or AIJ.safe(c.getId, c)) or c
    local r = type(c) == 'table' and rankOf(c) or nil
    if have[uid] then
      out[#out + 1] = uid
    elseif r == 12 or r == 13 then
      out[#out + 1] = uid
      added = true
    end
  end
  if added then return out end
end)

AIJ.addJoker {
  key = 'punk_joker',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 21, y = 1 },
  in_pool = function(state)
    return countCards(state and state.allCards, function(c) return AIJ.hasEnhancement(c, 'm_wild') end) > 0
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if countCards(cards, function(c) return AIJ.hasEnhancement(c, 'm_wild') end) == 0 then return end
      local targets = {}
      for _, c in ipairs(cards) do if AIJ.enhancement(c) == nil then targets[#targets + 1] = c end end
      local target = AIJ.pick(targets, state)
      if not target then return end
      target:setEnhancement(AIJ.vanilla('m_wild'))
      target:punch()
      result:say('Plaid!', colors.ORANGE)
    end,
  },
}

