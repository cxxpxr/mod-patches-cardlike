local function isMulticard(c) return AIJ.hasEnhancement(c, 'm_mult') end

AIJ.addJoker {
  key = 'firework',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 0, y = 20 },
  config = { xmult = 3 },
  vars = function(card) return { AIJ.val(card, 'firework', 'xmult') } end,
  in_pool = function(state) return deckHas(state, isMulticard) end,
  triggers = {
    onScore = function(joker, state, step, result)
      if not isMulticard(step.card) then return end
      for _, c in ipairs(step.hand.playedCards or {}) do
        if isMulticard(c) then
          if c.uid == step.card.uid then result:add(xMult(AIJ.num(joker, 'xmult'))) end
          return
        end
      end
    end,
  },
}

local FIRST_DRAFT_TRIGGERS = { 'beforeRound', 'drawInitialCards', 'beforeAllCardsScored', 'beforeScore', 'onScore',
  'enhancementScore', 'onScoreInHand', 'afterAllCardsScored', 'onOtherJoker', 'finalScoring', 'afterHand', 'onDiscard',
  'afterRound', 'repeatCard', 'repeatHeldCard', 'destroyCard', 'onDiscardCard', 'onRoundStart', 'onHandDrawn',
  'onCardSelected', 'onConsumableUsed', 'onCardBought', 'onCardSold', 'onCardObtained', 'onCardPlaced', 'onShopEnter',
  'onShopExit', 'onShopReroll', 'onPackOpened', 'onPackSkipped', 'onBlindSkipped', 'onBossRerolled', 'onBlindDefeated',
  'onCashOut', 'onAnteChanged', 'onMoneyChanged', 'onCardsAdded', 'onCardsRemoved', 'onCardsDestroyed', 'onGameWon' }
local firstDraftDepth = 0

local function firstDraftTarget(state, joker)
  local jokers = ofList(state, 'jokers')
  local i = indexOf(jokers, joker)
  local left = i and jokers[i - 1]
  if not left or AIJ.isDebuffed(left) then return nil end
  local def = AIJ.jokerDefs[AIJ.defId(left) or '']
  if not def or def.copyable == false or type(def.triggers) ~= 'table' then return nil end
  return left, def
end

local firstDraftTriggers = {}
for _, name in ipairs(FIRST_DRAFT_TRIGGERS) do
  firstDraftTriggers[name] = function(joker, state, step, result)
    if firstDraftDepth > 20 then return nil end
    step = step or {}
    local left, def = firstDraftTarget(state, step.copiedBy or joker)
    local fn = def and def.triggers[name]
    if not fn then return nil end
    local s = {}
    for k, v in pairs(step) do s[k] = v end
    s.copiedBy = step.copiedBy or joker
    firstDraftDepth = firstDraftDepth + 1
    local ok, res = pcall(fn, left, state, s, result)
    firstDraftDepth = firstDraftDepth - 1
    if ok then return res end
    return nil
  end
end

AIJ.addJoker {
  key = 'first_draft',
  rarity = 3, cost = 10, atlas = 'joker_atlas', pos = { x = 9, y = 35 },
  config = {},
  description = function()
    return 'Copies ability of ' .. colorize(bold('Joker'), colors.ORANGE) .. ' to the left\n'
      .. colorize('(All in Jest Jokers only)', colors.GREY)
  end,
  triggers = firstDraftTriggers,
}

AIJ.addJoker {
  key = 'fish_fingers',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 23, y = 11 },
  pools = { Food = true },
  config = { hands = 5, hand_mod = 1 },
  vars = function(card) return { AIJ.val(card, 'fish_fingers', 'hands'), AIJ.val(card, 'fish_fingers', 'hand_mod') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      local n = AIJ.num(joker, 'hands')
      state.handsLeft = state.handsLeft + n
      result:say('+' .. AIJ.fmt(n) .. ' Hands', colors.CHIPS)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local left = AIJ.num(joker, 'hands') - AIJ.num(joker, 'hand_mod')
      if left <= 0 then
        result:say('Eaten!', colors.RED)
        result:destroySelf()
      else
        AIJ.set(joker, 'hands', left)
        result:say('-' .. AIJ.fmt(AIJ.num(joker, 'hand_mod')) .. ' Hands', colors.RED)
      end
    end,
  },
}

local function randomPatch(card, state)
  local own = card.lastInfo and card.lastInfo.suit
  local inDeck, keys = {}, {}
  for _, c in ipairs(ofList(state, 'allCards')) do
    local s = c.lastInfo and c.lastInfo.suit
    if s and not AIJ.noRank(c) then inDeck[s] = true end
  end
  for _, s in ipairs(AIJ.SUITS) do
    if s ~= own and inDeck[s] then keys[#keys + 1] = s end
  end
  local suit = AIJ.pick(keys, state)
  return suit and AIJ.addPatch(card, suit)
end

AIJ.addJoker {
  key = 'fleshgait',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 13, y = 14 },
  blueprint_compat = false,
  config = {},
  in_pool = function(state) return not AIJ.isId(state and state.deck, 'patchwork') end,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      local first = owned(state, 'fleshgait')[1]
      if not first or first.uid ~= joker.uid then return end
      local n = 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        if not AIJ.noRank(c) and next(AIJ.patches(c)) == nil and randomPatch(c, state) then
          n = n + 1
          c:punch()
        end
      end
      if n > 0 then result:say('Patched!', colors.ORANGE) end
    end,
  },
}

AIJ.addJoker {
