local function sundaeCountdown(joker, step, result, colour)
  if step.copiedBy then return end
  local left = AIJ.add(joker, 'rounds', -1)
  if left <= 0 then
    result:say('Eaten!', colour)
    result:destroySelf()
  else
    result:say(AIJ.fmt(left) .. '/' .. AIJ.fmt(AIJ.num(joker, 'total_rounds')), colors.ORANGE)
  end
end

