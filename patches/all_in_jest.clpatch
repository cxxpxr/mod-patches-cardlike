AIJ.addJoker {
  key = 'quantum_foam',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 24, y = 27 },
  config = { odds = 2 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'quantum_foam', 'odds') } end,
  triggers = {
    repeatCard = function(joker, state, step, result)
      if AIJ.enhancement(step.card) ~= nil then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then return 1 end
    end,
