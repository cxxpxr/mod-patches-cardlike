AIJ.onNewRun(function(run)
  run.spiders_georg_eights = 0
  run.spiders_georg_hands = 0
end)

local function countEights(cards)
  local n = 0
  for _, c in ipairs(cards or {}) do if rankOf(c) == 8 then n = n + 1 end end
  return n
end

cardlike.on('afterHand', function(state, step)
  AIJ.run.spiders_georg_eights = (AIJ.run.spiders_georg_eights or 0) + countEights(step and step.hand and step.hand.playedCards)
  AIJ.run.spiders_georg_hands = (AIJ.run.spiders_georg_hands or 0) + 1
end)

AIJ.addJoker {
  key = 'spiders_georg',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 7 },
  config = { base_xmult = 1 },
  vars = function(card)
    local b = AIJ.val(card, 'spiders_georg', 'base_xmult')
    local e, h = AIJ.run.spiders_georg_eights or 0, AIJ.run.spiders_georg_hands or 0
    if h == 0 or e == 0 then return { b, b } end
    return { b + e / h, b }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local e = (AIJ.run.spiders_georg_eights or 0) + countEights(step.hand.playedCards)
      local h = (AIJ.run.spiders_georg_hands or 0) + 1
      local x = AIJ.num(joker, 'base_xmult') + e / h
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

