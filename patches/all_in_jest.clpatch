  ["Tarot"] = {
    ["c_aij_balance_and_blade"] = { name = "The Balance and The Blade", text = "[color=\"#f3a712\"][b]Patch[/b][/color] a random suit onto [color=\"#f3a712\"][b]#1#[/b][/color] selected cards" },
    ["c_aij_beheaded"] = { name = "The Beheaded", text = "Apply a [color=\"#f3a712\"][b]Bomb Sticker[/b][/color] to [color=\"#f3a712\"][b]#1#[/b][/color] selected card" },
    ["c_aij_broken_fate"] = { name = "Broken Fate", text = "Randomises the values of the [color=\"#f3a712\"][b]leftmost consumable[/b][/color] to between [color=\"#f3a712\"][b]X0.75[/b][/color] and [color=\"#f3a712\"][b]X2.5[/b][/color] of their [color=\"#f3a712\"][b]default[/b][/color] values" },
    ["c_aij_cubic_stone"] = { name = "The Cubic Stone", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected card into a [color=\"#f3a712\"][b]#2#[/b][/color]" },
    ["c_aij_golem"] = { name = "Golem", text = "Applies an [color=\"#f3a712\"][b]additional[/b][/color] random enhancement to up to [color=\"#f3a712\"][b]#1#[/b][/color] selected [color=\"#f3a712\"][b]Rock cards[/b][/color]" },
    ["c_aij_isis_urania"] = { name = "Isis-Urania", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected card into a [color=\"#f3a712\"][b]#2#[/b][/color]" },
    ["c_aij_magus"] = { name = "The Magus", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected card into a [color=\"#f3a712\"][b]#2#[/b][/color]" },
    ["c_aij_master_arcanes"] = { name = "Master of the Arcanes", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#4584fa\"][b]Admin[/b][/color] card\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["c_aij_osiris"] = { name = "Osiris", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] [color=\"#f3a712\"][b]1[/b][/color] selected Joker and earn triple its [color=\"#f3a712\"][b]sell value[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]$#2#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["c_aij_osiris_controller"] = { name = "Osiris", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] the [color=\"#f3a712\"][b]rightmost[/b][/color] Joker and earn triple its [color=\"#f3a712\"][b]sell value[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["c_aij_reaper"] = { name = "The Reaper", text = "Select [color=\"#f3a712\"][b]#1#[/b][/color] cards. All [color=\"#f3a712\"][b]#1#[/b][/color] cards will be [color=\"#f3a712\"][b]converted[/b][/color] into [color=\"#f3a712\"][b]copies[/b][/color] of one of them, chosen at [color=\"#f3a712\"][b]random[/b][/color]" },
    ["c_aij_rising_dead"] = { name = "The Rising of the Dead", text = "Select [color=\"#f3a712\"][b]#1#[/b][/color] cards, give the [color=\"#f3a712\"][b]left[/b][/color] card the [color=\"#f3a712\"][b]Enhancement[/b][/color] and [color=\"#f3a712\"][b]Stamp[/b][/color] of the [color=\"#f3a712\"][b]right[/b][/color]" },
    ["c_aij_sacrifice"] = { name = "The Sacrifice", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] [color=\"#f3a712\"][b]#1#[/b][/color] selected card to create a card with a random [color=\"#f3a712\"][b]suit[/b][/color], [color=\"#f3a712\"][b]rank[/b][/color], and [color=\"#f3a712\"][b]enhancement[/b][/color]" },
    ["c_aij_sanctuary_gate"] = { name = "The Sanctuary Gate", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected cards to [color=\"#f3a712\"][b]#2#s[/b][/color]" },
    ["c_aij_sphinx"] = { name = "Sphinx", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected cards into [color=\"#f3a712\"][b]#2#s[/b][/color]" },
    ["c_aij_star_magi"] = { name = "Star of the Magi", text = "[color=\"#f3a712\"][b]Create[/b][/color] a random Passigrade [color=\"#87a5c9\"][b]Astral[/b][/color] card" },
    ["c_aij_tamed_lion"] = { name = "The Tamed Lion", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected card into a [color=\"#f3a712\"][b]#2#[/b][/color]" },
    ["c_aij_twilight"] = { name = "Twilight", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] for each level of your most played poker hand\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]$#2#[/b][/color][color=\"#9a9a9a\"])[/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]$#3#[/b][/color][color=\"#9a9a9a\"] - #4#)[/color]" },
    ["c_aij_two_ways"] = { name = "The Two Ways", text = "Splits [color=\"#f3a712\"][b]#1#[/b][/color] selected card into [color=\"#f3a712\"][b]2[/b][/color] copies with [color=\"#f3a712\"][b]half[/b][/color] the original [color=\"#f3a712\"][b]rank[/b][/color]\n[color=\"#9a9a9a\"](Odd cards split as evenly as possible)[/color]\n[color=\"#9a9a9a\"](A=14, K=13, Q=12, J=11)[/color]" },
    ["c_aij_typhon"] = { name = "Typhon", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected cards into [color=\"#f3a712\"][b]#2#s[/b][/color]" },
    ["c_aij_urns"] = { name = "The Urns", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] [color=\"#f3a712\"][b]#1#[/b][/color] selected [color=\"#f3a712\"][b]enhanced[/b][/color] card and apply its [color=\"#f3a712\"][b]enhancement[/b][/color] to [color=\"#f3a712\"][b]#2#[/b][/color] [color=\"#f3a712\"][b]random[/b][/color] cards in hand" },
    ["c_aij_veiled_lamp"] = { name = "The Veiled Lamp", text = "Enhances [color=\"#f3a712\"][b]#1#[/b][/color] selected card into a [color=\"#f3a712\"][b]#2#[/b][/color]" },
  },
  ["Voucher"] = {
    ["v_aij_common_caste"] = { name = "Common Caste", text = "[color=\"#f3a712\"][b]Adds[/b][/color] an additional random [color=\"#009dff\"][b]Common Pack[/b][/color] to every [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["v_aij_embraced_arcane"] = { name = "Embraced Arcane", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] pick in [color=\"#d138bf\"][b]Game Packs[/b][/color]" },
    ["v_aij_fairy_dust"] = { name = "Fairy Dust", text = "[color=\"#5d5dff\"][b]Glimmer[/b][/color], [color=\"#5d5dff\"][b]Aureate[/b][/color], and [color=\"#5d5dff\"][b]Stellar[/b][/color] cards appear [color=\"#f3a712\"][b]#1#X[/b][/color] more often" },
    ["v_aij_gold_medal"] = { name = "Gold Medal", text = "[color=\"#f3a712\"][b]Gold[/b][/color] Pins appear [color=\"#f3a712\"][b]#1#X[/b][/color] more often" },
    ["v_aij_live_pixie"] = { name = "Live Pixie", text = "[color=\"#5d5dff\"][b]Glimmer[/b][/color], [color=\"#5d5dff\"][b]Aureate[/b][/color], and [color=\"#5d5dff\"][b]Stellar[/b][/color] cards appear [color=\"#f3a712\"][b]#1#X[/b][/color] more often" },
    ["v_aij_polkadot"] = { name = "Polkadot", text = "[color=\"#f3a712\"][b]Lessens[/b][/color] the effect of [color=\"#ff007f\"][b]detrimental[/b][/color] [color=\"#f3a712\"][b]stickers[/b][/color]" },
    ["v_aij_raw_mult"] = { name = "Raw Mult", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
