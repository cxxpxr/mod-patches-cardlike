local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')

local GOLD_MIN_ANTE = 3

local UPGRADE = {
  anarchy = 'aij_chaos', asteroid = 'tag_meteor', auspicious = 'aij_fortunate', bierstiefel = 'tag_top_up',
  capital = 'tag_investment', cinema = 'aij_silver', circumplanetary = 'tag_orbital', crystal = 'tag_foil',
  dark_matter = 'tag_negative', dominus = 'tag_boss', err_tag_undefined = 'aij_misprinted', frugal = 'tag_coupon',
  galloping_domino = 'tag_d_six', gioco = 'tag_juggle', glamour = 'aij_glimmer', gold_dust = 'aij_aureate',
  grand_astrologer = 'aij_astrology', hermetic = 'tag_ethereal', ignoramus = 'tag_buffoon', iridescent = 'tag_holo',
  landfill = 'tag_garbage', nonstandard = 'tag_standard', occult = 'tag_charm', omnichrome = 'tag_polychrome',
  polydactyly = 'tag_handy', recherche = 'tag_rare', stereoscopic = 'tag_double', superlunary = 'aij_stellar',
  ticket = 'tag_voucher', timelost = 'aij_soulbound', unusual = 'tag_uncommon', velocity = 'tag_skip',
  ventripotent = 'aij_overstuffed', windfall = 'tag_economy',
}

local GOLD_OF = {}
local IS_GOLD = {}
for gold, up in pairs(UPGRADE) do
  local base = up:sub(1, 4) == 'aij_' and AIJ.id(up:sub(5)) or AIJ.vanilla(up)
  if base then GOLD_OF[base] = AIJ.id(gold) end
  IS_GOLD[AIJ.id(gold)] = true
end
H.GOLD_OF, H.IS_GOLD = GOLD_OF, IS_GOLD

AIJ.onNewRun(function(run)
  run.gold_tag_rate = 1
  run.cards_discarded = 0
  run.unused_hands = 0
end)

cardlike.on('onDiscard', function(state, step)
  AIJ.run.cards_discarded = (AIJ.run.cards_discarded or 0) + #(step.discardedCards or {})
end)
cardlike.on('onBlindDefeated', function(state)
  AIJ.run.unused_hands = (AIJ.run.unused_hands or 0) + math.max(0, state.handsLeft or 0)
end)
cardlike.on('onAnteChanged', function() AIJ.run.aij_force_gold_pins = nil end)

local function goldPool(state)
  local out = {}
  if not state or (state.ante or 1) < GOLD_MIN_ANTE then return out end
  for _, k in ipairs(AIJ.lists.gold_pins) do
    local ok = AIJ.has(k, 'pin') and k ~= 'grand_astrologer'
    if k == 'velocity' and (state.round or 0) > 19 then ok = false end
    if ok then out[#out + 1] = AIJ.id(k) end
  end
  return out
end
H.goldPool = goldPool

local function goldRate(state)
  return (AIJ.run.gold_tag_rate or 1) + 4 * AIJ.count('illuminated_joker', state)
end

function H.maybeGold(state, pinId, slot)
  local pool = goldPool(state)
  if #pool == 0 then return pinId end
  local sure = AIJ.owns('pablillos', state) or AIJ.run.aij_force_gold_pins
  if not sure and slot == 1 and state:hasTicket(AIJ.id('trophy')) then sure = state:chance(1 / 3) end
  if sure or state:randomFloat() < goldRate(state) / 30 then return AIJ.pick(pool, state) or pinId end
  return pinId
end

cardlike.filter('skipPin', function(pinId, slot)
  local state = cardlike.state
  if not state or not state.ante then return nil end
  local out = pinId
  if IS_GOLD[out] then out = cardlike.randomPin() or out end
  out = H.maybeGold(state, out, slot)
  if out ~= pinId then return out end
  return nil
end)

local function gold(def)
  def.minAnte = 999
  return H.addPin(def)
end

local function jokerOk(state) return #H.noEdition(state.jokers) > 0 end
local function deckOk(state) return #H.noEdition(H.deckCards(state)) > 0 end

local ANARCHY = {
  { 'money', run = function(s) H.effects.money(s, 150) end },
  { 'open_booster', run = H.effects.open_booster },
  { 'create_jokers', ok = function(s) return (s.freeJokerSlots or 0) > 0 end,
    run = function(s) H.effects.create_jokers(s, s:random(1, 4)) end },
  { 'create_neg_joker', run = function(s) H.effects.create_jokers(s, 1, nil, 'Inverted') end },
  { 'create_consumables', run = function(s) H.effects.create_consumables(s, s:random(3, 4), 'Inverted') end },
  { 'dupe_joker', ok = function(s) return #(s.jokers or {}) > 0 end, run = function(s) H.effects.dupe_joker(s, 'Inverted') end },
  { 'voucher', run = H.effects.voucher },
  { 'plus_hand', run = H.effects.plus_hand },
  { 'plus_discard', run = H.effects.plus_discard },
  { 'plus_ran_enhance', run = H.effects.plus_ran_enhance },
  { 'give_ran_enhance', run = H.effects.give_ran_enhance },
  { 'ran_tag', run = H.effects.ran_tag },
}
