    ["j_aij_dead_hand"] = { name = "Dead Hand", text = "" },
    ["j_aij_dead_joker"] = { name = "Dead Joker", text = "" },
    ["j_aij_dead_president"] = { name = "Dead President", text = "Sell this [color=\"#f3a712\"][b]Joker[/b][/color] to [color=\"#f3a712\"][b]double[/b][/color] the [color=\"#f3a712\"][b]sell value[/b][/color] of adjacent [color=\"#f3a712\"][b]Jokers[/b][/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_death_of_a_salesman"] = { name = "Death of a Salesman", text = "[color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#ff007f\"][b]Chaos[/b][/color] or [color=\"#ff007f\"][b]Anarchy [/b][/color][color=\"#f3a712\"][b]Pin[/b][/color] available for purchase in every [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_debbie_downer"] = { name = "Debbie Downer", text = "" },
    ["j_aij_deburau"] = { name = "Deburau", text = "" },
    ["j_aij_default_credits_joker"] = { name = "Default", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_dendrochronology"] = { name = "Dendrochronology", text = "" },
    ["j_aij_dendroglyph"] = { name = "Dendroglyph", text = "Scored [color=\"#f3a712\"][b]Wood Cards[/b][/color] give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]Wood Card[/b][/color] held in hand" },
