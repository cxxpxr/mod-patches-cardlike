  ["Spectral"] = {
    ["c_aij_barathrum"] = { name = "Barathrum", text = "Permanently [color=\"#ff007f\"][b]removes [/b][/color][color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#d138bf\"][b]Game[/b][/color] Cards of your choice from the [color=\"#f3a712\"][b]pool[/b][/color]" },
    ["c_aij_gegenschein"] = { name = "Gegenschein", text = "Sets the level of all [color=\"#f3a712\"][b]played[/b][/color] [color=\"#5d5dff\"][b]secret hands[/b][/color] to the [color=\"#f3a712\"][b]number[/b][/color] of times they have been [color=\"#f3a712\"][b]played[/b][/color]" },
    ["c_aij_gravastar"] = { name = "Gravastar", text = "[color=\"#f3a712\"][b]Levels up[/b][/color] the [color=\"#3772ff\"][b]Points[/b][/color] of all [color=\"#d138bf\"][b]poker hands[/b][/color]" },
