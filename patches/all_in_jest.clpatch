local function fragileWithSuit(c)
  if type(c) ~= 'table' then return false end
  local info = c.lastInfo or {}
  return info.enhancement == AIJ.vanilla('m_glass') and not AIJ.noRank(c)
end

local function stainedOn(state)
  return state ~= nil and state.hasJoker ~= nil and state:hasJoker(AIJ.id('stained_glass_joker'))
end

