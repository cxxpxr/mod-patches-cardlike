    ["j_aij_gnasher"] = { name = "Gnasher", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Once per Ante, [color=\"#f3a712\"][b]copy[/b][/color] and [color=\"#f3a712\"][b]immediately[/b][/color] use a random held [color=\"#f3a712\"][b]consumable[/b][/color] [color=\"#9a9a9a\"]#1#[/color]" },
    ["j_aij_goblet"] = { name = "Goblet", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Consumable Slots" },
    ["j_aij_goblin_joker"] = { name = "Goblin Joker", text = "After [color=\"#ff007f\"][b]discard[/b][/color], draw [color=\"#f3a712\"][b]#1#[/b][/color] additional cards" },
    ["j_aij_golden_effigy"] = { name = "Golden Effigy", text = "" },
