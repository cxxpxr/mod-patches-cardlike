local AIJ = cardlike.require('lib.aij')

local SOUNDS = {
  aureate = 'sounds/aureate.ogg',
  glimmer = 'sounds/glimmer.mp3',
  misprint = 'sounds/misprinted.mp3',
  silver = 'sounds/silver.mp3',
  stellar = 'sounds/stellar.mp3',
}
local SOUND_VOLUME = { misprint = 0.7 }
for id, file in pairs(SOUNDS) do
  AIJ.register('addSound', { id = 'edition_' .. id, file = file, volume = SOUND_VOLUME[id] or 1 }, 'sound')
end

local PERLIN = [[
vec3 aijMod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 aijMod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 aijPermute(vec4 x) { return aijMod289(((x * 34.0) + 1.0) * x); }
vec4 aijTaylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
vec3 aijFade(vec3 t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

float aijPerlin(vec3 P) {
  vec3 Pi0 = aijMod289(floor(P));
  vec3 Pi1 = aijMod289(floor(P) + vec3(1.0));
  vec3 Pf0 = fract(P);
  vec3 Pf1 = Pf0 - vec3(1.0);
  vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
  vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
  vec4 iz0 = vec4(Pi0.z);
  vec4 iz1 = vec4(Pi1.z);
  vec4 ixy = aijPermute(aijPermute(ix) + iy);
  vec4 ixy0 = aijPermute(ixy + iz0);
  vec4 ixy1 = aijPermute(ixy + iz1);
  vec4 gx0 = ixy0 * (1.0 / 7.0);
  vec4 gy0 = fract(floor(gx0) * (1.0 / 7.0)) - 0.5;
  gx0 = fract(gx0);
  vec4 gz0 = vec4(0.5) - abs(gx0) - abs(gy0);
  vec4 sz0 = step(gz0, vec4(0.0));
  gx0 -= sz0 * (step(0.0, gx0) - 0.5);
  gy0 -= sz0 * (step(0.0, gy0) - 0.5);
  vec4 gx1 = ixy1 * (1.0 / 7.0);
  vec4 gy1 = fract(floor(gx1) * (1.0 / 7.0)) - 0.5;
  gx1 = fract(gx1);
  vec4 gz1 = vec4(0.5) - abs(gx1) - abs(gy1);
  vec4 sz1 = step(gz1, vec4(0.0));
  gx1 -= sz1 * (step(0.0, gx1) - 0.5);
  gy1 -= sz1 * (step(0.0, gy1) - 0.5);
  vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
  vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
  vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
  vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
  vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
  vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
  vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
  vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
  vec4 norm0 = aijTaylorInvSqrt(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
  g000 *= norm0.x; g010 *= norm0.y; g100 *= norm0.z; g110 *= norm0.w;
  vec4 norm1 = aijTaylorInvSqrt(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
  g001 *= norm1.x; g011 *= norm1.y; g101 *= norm1.z; g111 *= norm1.w;
  float n000 = dot(g000, Pf0);
  float n100 = dot(g100, vec3(Pf1.x, Pf0.yz));
  float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
  float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
  float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
  float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
  float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
  float n111 = dot(g111, Pf1);
  vec3 fxyz = aijFade(Pf0);
  vec4 nz = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
  vec2 nyz = mix(nz.xy, nz.zw, fxyz.y);
  return 2.2 * mix(nyz.x, nyz.y, fxyz.x);
}
]]

local GLIMMER_SHADER = PERLIN .. [[
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 pixel = sampleCard(uv);
  float e = 1.0 + 0.8 * sin(uTime / 9.0) + 0.5 * uNormal.x;
  float m = uTime / 14.0 + uNormal.x - uNormal.y;
  vec3 light = vec3(255.0, 151.0, 255.0) / 255.0;
  vec3 dark = vec3(190.0, 99.0, 255.0) / 255.0;
  vec3 white = vec3(1.0);
  float gradient = clamp(distance(uv, vec2(0.3 * e, 1.2)), 0.0, 1.0);
  vec3 blended = mix(dark, light, gradient);
  vec3 lighter = mix(mix(max(pixel.rgb, blended), blended, 0.8), white, 0.2);
  float avg = (pixel.r + pixel.g + pixel.b) / 3.0;
  float lum = dot(lighter, vec3(0.299, 0.587, 0.114));
  vec3 rgb = mix(vec3(lum), lighter, 2.7) * avg;
  float sparkle = aijPerlin(vec3(uv * 50.0, 3.0 * m));
  float mask = aijPerlin(vec3(uv * 30.0, 2.0 * m));
  float spark = max(0.0, sparkle - mask - 0.05);
  vec3 tint = mix(light, white, gradient);
  vec3 colour = max(mix(vec3(0.6) + tint * spark, tint, 0.03), white);
  gl_FragColor = applyOverlays(vec4(clamp(rgb * colour, 0.0, 1.0), pixel.a * uOpacity), vUv0);
}
]]

local AUREATE_SHADER = PERLIN .. [[
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 pixel = sampleCard(uv);
  float e = 1.0 + 0.8 * sin(uTime / 9.0) + 0.5 * uNormal.x;
  float m = uTime / 14.0 + uNormal.x - uNormal.y;
  vec3 light = vec3(254.0, 245.0, 125.0) / 255.0;
  vec3 dark = vec3(206.0, 148.0, 43.0) / 255.0;
  vec3 gold = vec3(247.0, 202.0, 103.0) / 255.0;
  float gradient = clamp(distance(uv, vec2(0.3 * e, 1.2)), 0.0, 1.0);
  vec3 blended = mix(dark, light, gradient);
  vec3 lighter = mix(mix(max(pixel.rgb, blended), blended, 0.8), gold, 0.2);
  float avg = (pixel.r + pixel.g + pixel.b) / 3.0;
  vec2 adj = uv - vec2(0.5);
  adj.x *= 71.0 / 95.0;
  float wave = sin(dot(adj, normalize(vec2(1.0, 0.3))) * 18.0 + m * 12.0);
  float shine = 0.1 * (1.0 + max(wave, 0.0) * 0.8);
  float lum = dot(lighter, vec3(0.299, 0.587, 0.114));
  vec3 rgb = mix(vec3(lum), lighter, 2.7) * avg + vec3(shine);
  float sparkle = aijPerlin(vec3(uv * 50.0, 3.0 * m));
  float mask = aijPerlin(vec3(uv * 30.0, 2.0 * m));
  float spark = max(0.0, sparkle - mask - 0.1);
  vec3 tint = mix(dark, gold, gradient);
  vec3 colour = max(mix(vec3(0.6) + tint * spark, tint, 0.09), gold);
  gl_FragColor = applyOverlays(vec4(clamp(rgb * colour, 0.0, 1.0), pixel.a * uOpacity), vUv0);
}
]]

local SILVER_SHADER = [[
vec2 aijHash22(vec2 p) {
  p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
  return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float aijGradNoise(vec2 uv) {
  vec2 i = floor(uv);
  vec2 f = fract(uv);
  vec2 u = f * f * (3.0 - 2.0 * f);
  float a = dot(aijHash22(i), f);
  float b = dot(aijHash22(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));
  float c = dot(aijHash22(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));
  float d = dot(aijHash22(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
vec3 aijMod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec2 aijMod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 aijPermute(vec3 x) { return aijMod289(((x * 34.0) + 1.0) * x); }
float aijSimplex(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = aijMod289(i);
  vec3 p = aijPermute(aijPermute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m;
  m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}
vec3 aijOverlay(vec3 src, vec3 dst) {
  return vec3(
    dst.x <= 0.5 ? 2.0 * src.x * dst.x : 1.0 - 2.0 * (1.0 - dst.x) * (1.0 - src.x),
    dst.y <= 0.5 ? 2.0 * src.y * dst.y : 1.0 - 2.0 * (1.0 - dst.y) * (1.0 - src.y),
    dst.z <= 0.5 ? 2.0 * src.z * dst.z : 1.0 - 2.0 * (1.0 - dst.z) * (1.0 - src.z));
}
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 pixel = sampleCard(uv);
  if (pixel.a <= 0.001) {
    gl_FragColor = applyOverlays(vec4(0.0), vUv0);
    return;
  }
  vec2 adj = uv - vec2(0.5);
  adj.x *= 71.0 / 95.0;
  float wave = sin(adj.x * 30.0 + uTime * 1.5 + uNormal.x * 4.0);
  float fac = pow(max(wave, 0.0), 80.0);
  float shine = 0.1 * (1.0 + fac * 0.5);
  float avg = (pixel.r + pixel.g + pixel.b) / 3.0;
  vec3 rgb = vec3(190.0 / 255.0) * avg + vec3(shine);
  float grain = aijGradNoise(uv * vec2(640.0, 360.0) + uTime * 60.0);
  float luma = dot(rgb, vec3(0.299, 0.587, 0.114));
  rgb += (grain - 0.5) * (0.15 * mix(0.6, 1.2, 1.0 - luma) * 0.1);
  float brightness = dot(rgb, vec3(0.299, 0.587, 0.114));
  float nz = aijSimplex(uv * vec2(52224.0)) * 0.5;
  float k = 0.06 * min(brightness + 0.7, 1.0);
  rgb += nz * k;
  rgb = mix(rgb, aijOverlay(rgb, vec3(nz)), k);
  float d = distance(vec2(0.5), uv) * 1.414213;
  rgb *= clamp((2.0 - d) / (2.0 - 0.2), 0.0, 1.0);
  gl_FragColor = applyOverlays(vec4(clamp(rgb, 0.0, 1.0), pixel.a * uOpacity), vUv0);
}
]]

local STELLAR_SHADER = [[
float aijHash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float aijValueNoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  float a = aijHash(i);
  float b = aijHash(i + vec2(1.0, 0.0));
  float c = aijHash(i + vec2(0.0, 1.0));
  float d = aijHash(i + vec2(1.0, 1.0));
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
float aijFbm(vec2 p) {
  float f = 0.0;
  float amp = 0.5;
  for (int i = 0; i < 5; i++) {
    f += amp * aijValueNoise(p);
    p *= 2.0;
    amp *= 0.5;
  }
  return f;
}
vec3 aijNebula(vec2 uv, float t) {
  uv = uv * 2.0;
  vec2 dir = vec2(0.6, 0.4);
  float layer1 = aijFbm(uv * 1.2 - dir * t * 0.02);
  float layer2 = aijFbm(uv * 2.4 + dir * t * 0.015);
  float dust = pow(layer1 * 0.6 + layer2 * 0.4, 1.6);
  return vec3(0.3, 0.2, 0.6) * dust + vec3(0.8, 0.4, 1.0) * dust;
}
float aijDiamond(vec2 uv) {
  uv = abs(uv - 0.5);
  return clamp(0.8 - (uv.x + uv.y) * 2.0, 0.0, 0.8);
}
float aijBorder(vec2 uv, float m, float w) {
  return smoothstep(m, m + w, uv.x) * smoothstep(m, m + w, 1.0 - uv.x);
}
float aijStars(vec2 uv, float t) {
  vec2 grid = uv * 15.0;
  vec2 id = floor(grid);
  vec2 gv = fract(grid);
  float seed = aijHash(id);
  if (seed <= 0.932) return 0.0;
  float phase = fract(seed * 43758.5453);
  float life = fract(phase + t / 60.0);
  float fade = smoothstep(0.2, 0.4, life) * (1.0 - smoothstep(0.6, 0.8, life));
  return fade * aijDiamond(gv) * aijBorder(uv, 0.05, 0.03);
}
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 tex = sampleCard(uv);
  float e = uTime / 28.0 + 0.5 * (uNormal.x - uNormal.y);
  float low = min(tex.r, min(tex.g, tex.b));
  float high = max(tex.r, max(tex.g, tex.b));
  float delta = high - low - 0.1;
  float fac = 0.8 + 0.9 * sin(11.0 * uv.x + 4.32 * uv.y + e * 12.0 + cos(e * 5.3 + uv.y * 4.2 - uv.x * 4.0));
  float fac2 = 0.5 + 0.5 * sin(8.0 * uv.x + 2.32 * uv.y + e * 5.0 - cos(e * 2.3 + uv.x * 8.2));
  float fac3 = 0.5 + 0.5 * sin(10.0 * uv.x + 5.32 * uv.y + e * 6.111 + sin(e * 5.3 + uv.y * 3.2));
  float fac4 = 0.5 + 0.5 * sin(3.0 * uv.x + 2.32 * uv.y + e * 8.111 + sin(e * 1.3 + uv.y * 11.2));
  float fac5 = sin(0.9 * 16.0 * uv.x + 5.32 * uv.y + e * 12.0 + cos(e * 5.3 + uv.y * 4.2 - uv.x * 4.0));
  float maxfac = 0.7 * max(max(fac, max(fac2, max(fac3, 0.0))) + (fac + fac2 + fac3 * fac4), 0.0);
  float shift = delta * maxfac * (0.7 - fac5 * 0.27) - 0.1;
  tex.g = tex.g - delta + shift;
  float t = uTime * 2.0;
  tex.rgb = pow(max(tex.rgb, vec3(0.0)), vec3(1.05));
  vec3 neb = aijNebula(uv, t);
  tex.rgb = tex.rgb + 0.2 * (neb - tex.rgb);
  tex.rgb += neb * 0.6;
  tex.rgb = mix(tex.rgb, vec3(neb.r, neb.g, neb.b + 0.3), 0.4);
  float stars = aijStars(uv, t);
  tex.rgb += stars * vec3(0.6);
  tex.rgb += pow(stars, 0.5) * 0.3;
  tex.b = tex.b - delta + shift;
  tex.r = tex.r - delta + shift;
  gl_FragColor = applyOverlays(vec4(clamp(tex.rgb, 0.0, 1.0), tex.a * uOpacity), vUv0);
}
]]

local MISPRINT_SHADER = [[
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 pixel = sampleCard(uv);
  vec4 outp = pixel;
  if (pixel.a > 0.0) {
    if (uv.x <= 0.3) outp = sampleCard(snapUv(vec2(uv.x + 48.0 / 71.0, uv.y)));
    else if (uv.x <= 0.87) outp = sampleCard(snapUv(vec2(uv.x - 20.0 / 71.0, uv.y)));
    else outp = sampleCard(snapUv(vec2(42.5 / 71.0, uv.y)));
  }
  gl_FragColor = applyOverlays(vec4(outp.rgb, outp.a * uOpacity), vUv0);
}
]]

local currentHand = nil

local function isJoker(card)
  local k = (card and card.lastInfo and card.lastInfo.kind) or (card and AIJ.safe(card.getKind, card))
  return k == 'joker'
end

local function handLevel(state)
  if not currentHand or not state then return 1 end
  local h = AIJ.safe(state.getHand, state, currentHand)
  return (h and h.level) or 1
end

local function balance(state, p)
  local chips, mult = tonumber(state.currentChips) or 0, tonumber(state.currentMult) or 0
  if chips <= 0 or mult <= 0 or p <= 0 then return {} end
  p = math.min(p, 1)
  local newChips = chips + p * (mult - chips) / 2
  local newMult = mult + p * (chips - mult) / 2
  if math.abs(newChips - chips) < 1e-9 then return {} end
  return { xChips(newChips / chips), xMult(newMult / mult) }
end

local AUREATE_MONEY, AUREATE_MAX = 0.1, 10
local GLIMMER_PERCENT = 10
local STELLAR_CHIPS, STELLAR_MULT = 5, 1
local SILVER_EXTRA = 0.5
local MISPRINT_MIN, MISPRINT_MAX = 50, 300

local function aureateCardMoney(state, scale)
  local rate = AUREATE_MONEY * scale / 1.5
  local money = math.floor(math.min((tonumber(state.money) or 0) * rate, AUREATE_MAX * scale))
  if money > 0 then return { plusMoney(money) } end
  return {}
end

local ED_FX = {
  Luna = function(state, card, s) return { plusChips(50 * s) } end,
  Holo = function(state, card, s) return { plusMult(10 * s) } end,
  Chroma = function(state, card, s) return { xMult(1 + 0.5 * s) } end,
  Gold = function(state, card, s) return { plusMoney(4 * s) } end,
  glimmer = function(state, card, s) return balance(state, GLIMMER_PERCENT * s * 0.01) end,
  stellar = function(state, card, s)
    local lvl = handLevel(state)
    if s < 1 then lvl = math.floor(lvl / 2) end
    if lvl <= 0 then return {} end
    return { plusChips(lvl * STELLAR_CHIPS), plusMult(lvl * STELLAR_MULT) }
  end,
  aureate = function(state, card, s) return aureateCardMoney(state, s) end,
}

local function edKey(id)
  if id == nil then return nil end
  local v = AIJ.vanilla(id)
  if v then return v end
  local s = AIJ.short(id):gsub('^e_aij_', '')
  if ED_FX[s] then return s end
  return id
end

local function loc(key) return AIJ.loc('Edition', 'e_aij_' .. key) or {} end

local function register(def)
  def.readableName = def.readableName or loc(def.id).name or def.id
  return AIJ.register('addEdition', def, 'edition')
end

register {
  id = 'aureate',
  cost = 4,
  rollChance = 0.003,
  like = 'Gold',
  shader = AUREATE_SHADER,
  description = function(r)
    local card = r and r.card
    local rate = AUREATE_MONEY + 1
    if card and not isJoker(card) then rate = AUREATE_MONEY / 1.5 + 1 end
    local text = AIJ.fill(loc('aureate').text or '', { AIJ.fmt(rate), AUREATE_MAX })
    if card and isJoker(card) then return text .. '\nat the end of the round' end
    if card then return text .. '\nwhen scored' end
    return text .. '\nwhen a playing card scores (X' .. AIJ.fmt(AUREATE_MONEY / 1.5 + 1) .. '), or a Joker at the end of the round'
  end,
  getBonuses = function(state, card)
    if isJoker(card) then return {} end
    return aureateCardMoney(state, 1)
  end,
}

register {
  id = 'glimmer',
  cost = 3,
  rollChance = 0.006,
  like = 'Chroma',
  shader = GLIMMER_SHADER,
  description = AIJ.desc('Edition', 'e_aij_glimmer', function() return { GLIMMER_PERCENT } end),
  getBonuses = function(state, card) return balance(state, GLIMMER_PERCENT * 0.01) end,
}

register {
  id = 'stellar',
  cost = 2,
  rollChance = 0.01,
  like = 'Holo',
  shader = STELLAR_SHADER,
  description = AIJ.desc('Edition', 'e_aij_stellar', function() return { STELLAR_CHIPS, STELLAR_MULT } end),
  getBonuses = function(state, card) return ED_FX.stellar(state, card, 1) end,
}

register {
  id = 'silver',
  cost = 4,
  rollChance = 0.003,
  like = 'Luna',
  shader = SILVER_SHADER,
  description = colorize(bold('X' .. AIJ.fmt(1 + SILVER_EXTRA)), colors.ORANGE) .. ' to the values of this '
    .. colorize(bold('Joker'), colors.ORANGE) .. ' or of this card\'s ' .. colorize(bold('Enhancement'), colors.ORANGE)
    .. '\n[color="' .. colors.GREY .. '"](All in Jest Jokers only)[/color]',
  getBonuses = function(state, card) return {} end,
}

register {
  id = 'misprint',
  readableName = loc('misprint').name,
  cost = 4,
  rollChance = 0.003,
  like = 'Blurred',
  shader = MISPRINT_SHADER,
  description = function(r)
    local text = colorize(bold('Randomises'), colors.ORANGE) .. ' the values of this ' .. colorize(bold('Joker'), colors.ORANGE)
      .. ' or of this card\'s ' .. colorize(bold('Enhancement'), colors.ORANGE) .. ' between '
      .. colorize(bold('X' .. AIJ.fmt(MISPRINT_MIN / 100)), colors.ORANGE) .. ' and '
      .. colorize(bold('X' .. AIJ.fmt(MISPRINT_MAX / 100)), colors.ORANGE) .. ' before each hand'
    local card = r and r.card
    if card then
      local m = tonumber(card:getDataStore():get('aij_misprint_mult')) or 1
      text = text .. '\n[color="' .. colors.GREY .. '"](Currently [/color]' .. colorize(bold('X' .. AIJ.fmt(m)), colors.ORANGE)
        .. '[color="' .. colors.GREY .. '"])[/color]'
    end
    return text .. '\n[color="' .. colors.GREY .. '"](All in Jest Jokers only)[/color]'
  end,
  getBonuses = function(state, card) return {} end,
}

local SKIP_KEYS = { extra_value = true, rarity = true }
local SKIP_AT_ONE = { x_mult = true, xmult = true, Xmult = true, x_chips = true, xchips = true, Xchips = true,
  h_x_chips = true, h_x_mult = true, Xmult_mod = true }

local function jokerFactor(card)
  local f = 1
  if AIJ.hasEdition(card, 'silver') then f = f * (1 + SILVER_EXTRA) end
  if AIJ.hasEdition(card, 'misprint') then
    f = f * (tonumber(card:getDataStore():get('aij_misprint_mult')) or 1)
  end
  local st = AIJ.safe(card.getSticker, card)
  if st and (AIJ.isId(st, 'unusual_doubled') or AIJ.isId(st, 'recherche_doubled')) then f = f * 2 end
  return f
end

local function roundValue(base, v)
  if base == math.floor(base) then return math.floor(v + 0.5) end
  return math.floor(v * 100 + 0.5) / 100
end

local syncing = false
local function syncJoker(card)
  if syncing or not AIJ.exists(card) or not isJoker(card) then return end
  local id = AIJ.defId(card)
  local defs = id and AIJ.defaults[id]
  if not defs then return end
  local ds = card:getDataStore()
  local want = jokerFactor(card)
  local have = tonumber(ds:get('aij_vmul')) or 1
  if math.abs(want - have) < 1e-9 then return end
  syncing = true
  local base = ds:get('aij_vbase')
  local last = ds:get('aij_vlast')
  if type(base) ~= 'table' then base = {} end
  if type(last) ~= 'table' then last = {} end
  for k, dv in pairs(defs) do
    if type(dv) == 'number' and not SKIP_KEYS[k] then
      local cur = tonumber(AIJ.get(card, k))
      if cur and not (SKIP_AT_ONE[k] and cur == 1) then
        local b
        if last[k] ~= nil and base[k] ~= nil and cur == last[k] then b = base[k] else b = cur / have end
        local v = roundValue(b, b * want)
        ds:set(k, v)
        base[k], last[k] = b, v
      end
    end
  end
  ds:set('aij_vbase', base)
  ds:set('aij_vlast', last)
  ds:set('aij_vmul', want)
  syncing = false
end

local function syncAllJokers(state)
  for _, j in ipairs((state and state.jokers) or {}) do AIJ.safe(syncJoker, j) end
end

local function rollMisprint(state)
  local v = state:random(MISPRINT_MIN, MISPRINT_MAX) / 100
  v = math.floor(v * 4 + 0.5) / 4
  return math.max(MISPRINT_MIN / 100, math.min(MISPRINT_MAX / 100, v))
end

local misprinted = {}

cardlike.on('beforeAllCardsScored', function(state, step)
  currentHand = step.hand and step.hand.handType
  misprinted = {}
  local lists = { state.jokers or {}, (step.hand and step.hand.allCards) or {}, step.held or state.cardsInHand or {} }
  for _, list in ipairs(lists) do
    for _, c in ipairs(list) do
      if AIJ.hasEdition(c, 'misprint') then
        c:getDataStore():set('aij_misprint_mult', rollMisprint(state))
        misprinted[#misprinted + 1] = c
      end
    end
  end
  syncAllJokers(state)
end)

cardlike.on('afterHand', function(state, step)
  for _, c in ipairs(misprinted) do
    if AIJ.exists(c) then
      local m = tonumber(c:getDataStore():get('aij_misprint_mult')) or 1
      c:popup(AIJ.fmt(m * 100) .. '%', colors.ORANGE)
    end
  end
  misprinted = {}
end)

cardlike.on('afterRound', function(state, step, result)
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.hasEdition(j, 'aureate') and not AIJ.isDebuffed(j) then
      local money = math.floor(math.min((tonumber(state.money) or 0) * AUREATE_MONEY, AUREATE_MAX))
      if money > 0 then
        state:mutateMoney(money)
        j:popup('+$' .. money, colors.MONEY)
      end
    end
  end
end)

cardlike.filter('cardBonuses', function(list, card, held)
  if not card or AIJ.isDebuffed(card) then return nil end
  local state = cardlike.state
  if not state then return nil end
  local ok, ds = pcall(card.getDataStore, card)
  if not ok or not ds then return nil end
  local out = {}
  local sealEd = ds:get('aij_seal_edition')
  if sealEd and AIJ.stamp(card) then
    local fx = ED_FX[edKey(sealEd)]
    if fx then for _, b in ipairs(fx(state, card, 0.5)) do out[#out + 1] = b end end
  end
  local extra = ds:get('aij_extra_ed')
  if type(extra) == 'table' then
    for _, id in ipairs(extra) do
      local fx = ED_FX[edKey(id)]
      if fx then for _, b in ipairs(fx(state, card, 1)) do out[#out + 1] = b end end
    end
  end
  if #out == 0 then return nil end
  for i = #(list or {}), 1, -1 do table.insert(out, 1, list[i]) end
  return out
end)

AIJ.onNewRun(function(run)
  if run.jest_fairy_edition_rate == nil then run.jest_fairy_edition_rate = 1 end
end)

local FAIRY = { { 'stellar', 0.01 }, { 'glimmer', 0.006 }, { 'aureate', 0.003 } }
cardlike.filter('edition', function(ed)
  local rate = tonumber(AIJ.run.jest_fairy_edition_rate) or 1
  if rate <= 1 or (ed ~= nil and ed ~= false and ed ~= 'none' and ed ~= 'default') then return nil end
  for _, e in ipairs(FAIRY) do
    if AIJ.has(e[1], 'edition') and cardlike.random() < (rate - 1) * e[2] then return AIJ.id(e[1]) end
  end
  return nil
end)

local lastEdition = {}
local MY_EDITIONS = {}
for id in pairs(SOUNDS) do MY_EDITIONS[AIJ.id(id)] = id end

cardlike.on('onCardCreated', function(state, step)
  local c = step.card
  if c then lastEdition[c.uid] = AIJ.edition(c) or 'none' end
end)

cardlike.on('onCardChanged', function(state, step)
  local c = step.card
  if not c or syncing then return end
  local ed = AIJ.edition(c) or 'none'
  local before = lastEdition[c.uid]
  lastEdition[c.uid] = ed
  if before ~= nil and before ~= ed and MY_EDITIONS[ed] then
    cardlike.playSound(AIJ.id('edition_' .. MY_EDITIONS[ed]))
  end
  if isJoker(c) then AIJ.safe(syncJoker, c) end
end)

cardlike.on('onCardObtained', function(state, step) if step.card then AIJ.safe(syncJoker, step.card) end end)
cardlike.on('onShopEnter', function(state) syncAllJokers(state) end)
cardlike.on('onRoundStart', function(state) syncAllJokers(state) end)

cardlike.on('onCardCopied', function(state, step)
  local copy, source = step.card, step.source
  if not copy or AIJ.setting('no_copy_neg') then return end
  if (copy.lastInfo or {}).kind ~= 'playing' then return end
  if source and AIJ.safe(function() return source:getDataStore():get('aij_copy_edition') end) then return end
  if AIJ.edition(copy) == 'Inverted' then copy:setEdition('default') end
end)


== file items/enhancements.lua (458 lines)
local AIJ = cardlike.require('lib.aij')

local E = {}

local function short(id)
  return AIJ.short(id)
end

local MINE = { canvas = true, charged = true, fervent = true, ice = true, scorched = true, simulated = true, wood = true }
local function canon(id)
  if id == nil then return nil end
  local v = AIJ.vanilla(id)
  if v then return v end
  local s = short(id):gsub('^m_aij_', '')
  if MINE[s] then return s end
  return id
end

local function enhKeys(card)
  local out = {}
  local main = AIJ.enhancement(card)
  if main then out[#out + 1] = canon(main) end
  local ok, extra = pcall(function() return card:getDataStore():get('aij_extra_enh') end)
  if ok and type(extra) == 'table' then
    for _, id in ipairs(extra) do out[#out + 1] = canon(id) end
  end
  return out
end

local function has(card, key)
  for _, k in ipairs(enhKeys(card)) do if k == key then return true end end
  return false
end

local function extraKeys(card)
  local out = {}
  local ok, extra = pcall(function() return card:getDataStore():get('aij_extra_enh') end)
  if ok and type(extra) == 'table' then
    for _, id in ipairs(extra) do out[#out + 1] = canon(id) end
  end
  return out
end

local function mainKey(card)
  local m = AIJ.enhancement(card)
  return m and canon(m) or nil
end

local function uidOf(card)
  return card and (card.uid or (card.lastInfo or {}).uid)
end

local function inList(list, card)
  local u = uidOf(card)
  for _, c in ipairs(list or {}) do if uidOf(c) == u then return true end end
  return false
end

local function ownsPort(id)
  return AIJ.has(id, 'joker') and AIJ.owns(id)
end

local function countCharged(list)
  local n = 0
  for _, c in ipairs(list or {}) do
    if not AIJ.isDebuffed(c) then
      for _, k in ipairs(enhKeys(c)) do if k == 'charged' then n = n + 1 end end
    end
  end
  return n
end

local function playedList(state)
  local l = cardlike.cards('played')
  if l and #l > 0 then return l end
  return state and state.playedCards or {}
end

function E.chargedFactor(card, held, state)
  state = state or cardlike.state
  if not state then return 1 end
  local played = playedList(state)
  local hand = state.cardsInHand or {}
  local count
  if held == nil then held = not inList(played, card) end
  if ownsPort('sparky') then
    count = countCharged(played) + countCharged(hand)
  elseif held then
    count = countCharged(hand)
  else
    count = countCharged(played)
  end
  if count == 0 then return 1 end
  local b = 0.5
  if AIJ.has('founding_father', 'joker') then b = 2 ^ (AIJ.count('founding_father', state) - 1) end
  return 1 + b * count
end

function E.editionFactor(card)
  local f = 1
  if AIJ.hasEdition(card, 'silver') then f = f * 1.5 end
  if AIJ.hasEdition(card, 'misprint') then
    local ok, m = pcall(function() return card:getDataStore():get('aij_misprint_mult') end)
    f = f * ((ok and tonumber(m)) or 1)
  end
  return f
end

function E.factor(card, held, state)
  return E.chargedFactor(card, held, state) * E.editionFactor(card)
end

local FX = {}

FX.Chipped = { scored = function(state, card, f) return { plusChips(30 * f) } end }
FX.Multicard = { scored = function(state, card, f) return { plusMult(4 * f) } end }
FX.Fragile = { scored = function(state, card, f) return { xMult(2 * f) } end }
FX.Rock = { scored = function(state, card, f) return { plusChips(100 * f) } end }
FX.Paperback = { scored = function(state, card, f)
  local out = {}
  if state:chance(1 / 5) then out[#out + 1] = plusMult(20 * f) end
  if state:chance(1 / 15) then out[#out + 1] = plusMoney(20 * f) end
  return out
end }
FX.Wooden = { held = function(state, card, f) return { xMult(1.5 * f) } end }
FX.Gilded = { roundEnd = function(state, card, f) return { plusMoney(3 * f) } end }

local BUILTIN_EXTRA = {
  Chipped = { scored = function(f) return { plusChips(30 * (f - 1)) } end },
  Multicard = { scored = function(f) return { plusMult(4 * (f - 1)) } end },
  Fragile = { scored = function(f) return { xMult(f) } end },
  Rock = { scored = function(f) return { plusChips(100 * (f - 1)) } end },
  Wooden = { held = function(f) return { xMult(f) } end },
  Gilded = { roundEnd = function(f) return { plusMoney(3 * (f - 1)) } end },
}

local FERVENT_GAIN = 10
FX.fervent = { scored = function(state, card, f)
  local ds = card:getDataStore()
  local bonus = tonumber(ds:get('aij_fervent_bonus')) or 0
  local out = {}
  if bonus ~= 0 then out[1] = plusChips(bonus * f) end
  ds:set('aij_fervent_bonus', bonus + FERVENT_GAIN * f)
  card:popup(AIJ.msg('k_upgrade_ex', 'Upgrade!'), colors.CHIPS)
  return out
end }

local WOOD_BASE, WOOD_MOD = 20, 5
local function woodInHand(state)
  local n = 0
  for _, c in ipairs((state and state.cardsInHand) or {}) do
    if has(c, 'wood') then n = n + 1 end
  end
  return n
end
local function woodPoints(state, f)
  local n = woodInHand(state)
  local pts = WOOD_BASE
  if n > 1 then pts = pts + WOOD_MOD * (n - 1) end
  return pts * f
end
FX.wood = { held = function(state, card, f) return { plusChips(woodPoints(state, f)) } end }

FX.ice = { always = true }
FX.canvas = { always = true }
FX.charged = {}
FX.scorched = {}
FX.simulated = {}

E.FX = FX
E.has = has
E.enhKeys = enhKeys

local function sprite(atlas, x, y) return AIJ.sprite(atlas, x, y) end

local function loc(key) return AIJ.loc('Enhanced', 'm_aij_' .. key) or {} end

local function register(def)
  def.readableName = def.readableName or loc(def.id).name or def.id
  return AIJ.register('addEnhancement', def, 'enhancement')
end

register {
  id = 'fervent',
  lite = true,
  sprite = sprite('enhancements_atlas', 0, 0),
  triggerTime = 'scored',
  description = function(r)
    local f = 1
    if r and r.card then f = AIJ.safe(E.editionFactor, r.card) or 1 end
    local text = AIJ.fill(loc('fervent').text or '', { 0, FERVENT_GAIN * f })
    if r and r.card then
      local b = tonumber(r.card:getDataStore():get('aij_fervent_bonus')) or 0
      if b > 0 then text = text .. '\n[color="' .. colors.GREY .. '"](Currently [/color]' .. colorize(bold('+' .. AIJ.fmt(b)), colors.CHIPS) .. '[color="' .. colors.GREY .. '"] points)[/color]' end
    end
    return text
  end,
  getBonus = function(state, card)
    return FX.fervent.scored(state, card, E.factor(card, false, state))
  end,
}

register {
  id = 'charged',
  sprite = sprite('enhancements_atlas', 2, 0),
  triggerTime = 'never',
  description = AIJ.desc('Enhanced', 'm_aij_charged', function()
    local ff = AIJ.has('founding_father', 'joker') and AIJ.count('founding_father') or 0
    return { 50 * (2 ^ ff) }
  end),
}

register {
  id = 'ice',
  lite = true,
  sprite = sprite('enhancements_atlas', 3, 0),
  triggerTime = 'never',
  description = colorize(bold('Always'), colors.ORANGE) .. ' scores',
}

register {
  id = 'wood',
  sprite = sprite('enhancements_atlas', 4, 0),
  triggerTime = 'held',
  description = AIJ.desc('Enhanced', 'm_aij_wood', function(card)
    local state = cardlike.state
    local f = card and (AIJ.safe(E.editionFactor, card) or 1) or 1
    local cur = WOOD_BASE * f
    if card and state and state.cardsInHand then cur = woodPoints(state, f) end
    return { cur, WOOD_MOD * f, WOOD_BASE * f }
  end),
  getBonus = function(state, card)
    return FX.wood.held(state, card, E.factor(card, true, state))
  end,
}

register {
  id = 'canvas',
  sprite = sprite('enhancements_atlas', 5, 0),
  triggerTime = 'never',
  description = AIJ.loc('Enhanced', 'm_aij_canvas').text .. '. ' .. colorize(bold('Always'), colors.ORANGE) .. ' scores',
}

register {
  id = 'scorched',
  sprite = sprite('enhancements_atlas', 7, 0),
  triggerTime = 'never',
  description = AIJ.desc('Enhanced', 'm_aij_scorched', function() return { AIJ.prob(), 3, 1 } end),
}

register {
  id = 'simulated',
  sprite = sprite('multi_simulated_atlas', 0, 0),
  triggerTime = 'never',
  description = 'When played for the ' .. colorize(bold('first'), colors.ORANGE) .. ' time each round, draw '
    .. colorize(bold('1'), colors.ORANGE) .. ' extra card after the hand\nDiscarding ' .. colorize(bold('only'), colors.ORANGE)
    .. ' ' .. colorize(bold('Simulated'), colors.ORANGE) .. ' cards does ' .. colorize(bold('not'), colors.ORANGE)
    .. ' use a ' .. colorize(bold('discard'), colors.MULT),
}

cardlike.filter('cardBonuses', function(list, card, held)
  if not card or AIJ.isDebuffed(card) then return nil end
  local state = cardlike.state
  if not state then return nil end
  local out = {}
  local f = nil
  local function factor()
    if not f then f = E.factor(card, false, state) end
    return f
  end
  local main = mainKey(card)
  if main and BUILTIN_EXTRA[main] and BUILTIN_EXTRA[main].scored then
    local fac = factor()
    if math.abs(fac - 1) > 1e-9 then
      for _, b in ipairs(BUILTIN_EXTRA[main].scored(fac)) do out[#out + 1] = b end
    end
  end
  for _, k in ipairs(extraKeys(card)) do
    local fx = FX[k]
    if fx and fx.scored then
      for _, b in ipairs(fx.scored(state, card, factor())) do out[#out + 1] = b end
    end
  end
  if #out == 0 then return nil end
  for i = #(list or {}), 1, -1 do table.insert(out, 1, list[i]) end
  return out
end)

cardlike.on('onScoreInHand', function(state, step, result)
  local card = step.card
  if not card or AIJ.isDebuffed(card) then return end
  local f = nil
  local function factor()
    if not f then f = E.factor(card, true, state) end
    return f
  end
  local main = mainKey(card)
  if main and BUILTIN_EXTRA[main] and BUILTIN_EXTRA[main].held then
    local fac = factor()
    if math.abs(fac - 1) > 1e-9 then
      for _, b in ipairs(BUILTIN_EXTRA[main].held(fac)) do result:add(b) end
    end
  end
  for _, k in ipairs(extraKeys(card)) do
    local fx = FX[k]
    if fx and fx.held then
      for _, b in ipairs(fx.held(state, card, factor())) do result:add(b) end
    end
  end
end)

cardlike.on('afterRound', function(state, step, result)
  for _, card in ipairs(state.cardsInHand or {}) do
    if not AIJ.isDebuffed(card) then
      local main = mainKey(card)
      if main and BUILTIN_EXTRA[main] and BUILTIN_EXTRA[main].roundEnd then
        local fac = E.factor(card, true, state)
        if math.abs(fac - 1) > 1e-9 then
          for _, b in ipairs(BUILTIN_EXTRA[main].roundEnd(fac)) do result:add(b) end
        end
      end
      for _, k in ipairs(extraKeys(card)) do
        local fx = FX[k]
        if fx and fx.roundEnd then
          for _, b in ipairs(fx.roundEnd(state, card, E.factor(card, true, state))) do result:add(b) end
        end
      end
    end
  end
end)

cardlike.filter('scoringCards', function(uids, played)
  if not played then return nil end
  local set, changed = {}, false
  for _, u in ipairs(uids or {}) do set[u] = true end
  for _, c in ipairs(played) do
    local u = uidOf(c)
    if u and not set[u] then
      for _, k in ipairs(enhKeys(c)) do
        if FX[k] and FX[k].always then set[u] = true changed = true break end
      end
    end
  end
  if not changed then return nil end
  local out = {}
  for _, c in ipairs(played) do
    local u = uidOf(c)
    if set[u] then out[#out + 1] = u end
  end
  return out
end)

local CANVAS = AIJ.id('canvas')

local function canvasUpdate()
  local state = cardlike.state
  if not state or not state.isPhase or not state:isPhase('play') then return end
  local infos = cardlike.cardInfos('hand')
  if not infos or #infos == 0 then return end
  for i = #infos, 1, -1 do
    local info = infos[i]
    local store = info.store or {}
    local isCanvas = info.enhancement == CANVAS
    if not isCanvas and type(store.aij_extra_enh) == 'table' then
      for _, id in ipairs(store.aij_extra_enh) do if canon(id) == 'canvas' then isCanvas = true end end
    end
    local card = cardlike.card(info.uid)
    if isCanvas and not info.debuffed then
      local target
      for j = i + 1, #infos do
        if (not not infos[j].selected) == (not not info.selected) then target = infos[j] break end
      end
      if target and target.rank and target.suit and (target.rank ~= info.rank or target.suit ~= info.suit) then
        if store.aij_canvas_orig == nil then
          card:getDataStore():set('aij_canvas_orig', { rank = info.rank, suit = info.suit })
        end
        card:setRank(target.rank)
        card:setSuit(target.suit)
        info.rank, info.suit = target.rank, target.suit
      end
    elseif not isCanvas and type(store.aij_canvas_orig) == 'table' then
      local o = store.aij_canvas_orig
      card:getDataStore():delete('aij_canvas_orig')
      if o.rank then card:setRank(o.rank) end
      if o.suit then card:setSuit(o.suit) end
    end
  end
end

local sinceCanvas = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  sinceCanvas = sinceCanvas + (frame.dt or 0)
  if sinceCanvas < 0.1 then return end
  sinceCanvas = 0
  AIJ.safe(canvasUpdate)
end)
E.canvasUpdate = canvasUpdate
cardlike.on('onCardSelected', function() AIJ.safe(canvasUpdate) end)
cardlike.on('onHandDrawn', function() AIJ.safe(canvasUpdate) end)

cardlike.on('onDiscard', function(state, step, result)
  local cards = step.discardedCards or {}
  local handType
  for _, c in ipairs(cards) do
    if not AIJ.isDebuffed(c) then
      for _, k in ipairs(enhKeys(c)) do
        if k == 'scorched' and state:chance(1 / 3) then
          if handType == nil then
            local ev = cardlike.evaluateHand(cards)
            handType = ev and ev.handType or false
          end
          if handType then
            state:upgradeHand(handType, 1)
            c:popup(AIJ.msg('k_upgrade_ex', 'Upgrade!'), colors.ORANGE)
          end
        end
      end
    end
  end
end)

local simulatedDraws = 0

cardlike.on('onDiscard', function(state, step, result)
  local cards = step.discardedCards or {}
  if #cards == 0 then return end
  for _, c in ipairs(cards) do
    if AIJ.isDebuffed(c) or not has(c, 'simulated') then return end
  end
  state.discardsLeft = state.discardsLeft + 1
  cards[1]:popup('Free discard', colors.ORANGE)
end)

cardlike.on('afterHand', function(state, step, result)
  local hand = step.hand or {}
  for _, c in ipairs(hand.allCards or hand.playedCards or {}) do
    if has(c, 'simulated') and not AIJ.isDebuffed(c) then
      local ds = c:getDataStore()
      if ds:get('aij_sim_round') ~= state.round then
        ds:set('aij_sim_round', state.round)
        simulatedDraws = simulatedDraws + 1
      end
    end
  end
end)

cardlike.on('onHandDrawn', function(state, step)
  if step.first or simulatedDraws <= 0 then return end
  local n = simulatedDraws
  simulatedDraws = 0
  cardlike.drawCards(n)
end)

cardlike.on('onRoundStart', function() simulatedDraws = 0 end)

return E


