AIJ.addJoker {
  key = 'silver_screen',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 18, y = 3 },
  triggers = {
    onCardsRemoved = function(joker, state, step, result)
      if not AIJ.has('silver', 'edition') then return end
      local removed = {}
      for _, c in ipairs(step.cards or {}) do if type(c) == 'table' then removed[c.uid] = true end end
      local targets = {}
      for _, c in ipairs(state.cardsInHand or {}) do
        if AIJ.edition(c) == nil and not removed[c.uid] and AIJ.exists(c) then targets[#targets + 1] = c end
      end
      local n = 0
      for _, c in ipairs(step.cards or {}) do
        if type(c) == 'table' and (c.lastInfo or {}).face and #targets > 0 then
          local i = state:random(1, #targets)
          targets[i]:setEdition(AIJ.id('silver'))
          table.remove(targets, i)
          n = n + 1
        end
      end
      if n > 0 then result:say('Silver!', AIJ.colors.SILVER) end
    end,
  },
}

