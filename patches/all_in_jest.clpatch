AIJ.addJoker {
  key = 'slippery_when_wet',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 22, y = 0 },
  triggers = {
    onScore = function(joker, state, step, result)
      local cards = step.hand.allCards or {}
      local pos
      for i, c in ipairs(cards) do if c == step.card then pos = i break end end
      if not pos then return end
      local left, right = cards[pos - 1], cards[pos + 1]
      local n = (left and rankOf(left) or 0) + (right and rankOf(right) or 0)
      if n > 0 then result:add(plusChips(n)) end
    end,
  },
}

AIJ.addJoker {
