add {
  key = 'dor',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 9, y = 2 }, soul_pos = { x = 9, y = 3 },
  config = { powmult = 0.3 },
  vars = function(card) return { '^' .. AIJ.fmt(AIJ.val(card, 'dor', 'powmult') + 1) } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if (tonumber(state.handsLeft) or 1) ~= 0 then return end
      local p = AIJ.num(joker, 'powmult')
      local m = tonumber(state.currentMult) or 0
      if m <= 0 then return end
      result:add(xMult(math.min(m ^ p, 1e300)))
      result:say(msg('a_aij_exp_mult', '^#1# Mult', AIJ.fmt(p + 1)), AIJ.colors.MOD)
      cardlike.playSound(AIJ.id('expmult'))
    end,
  },
}

local function uniqueDeckRanks(state)
  local seen, n = {}, 0
  for _, c in ipairs(state and state.unDrawnCards or {}) do
    local r = rankOf(c)
    if r and not seen[r] then seen[r] = true; n = n + 1 end
  end
  return n
end

add {
  key = 'dot_matrix',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 20, y = 30 },
  lite = true,
  config = { mult = 1 },
  vars = function(card)
    local m = AIJ.val(card, 'dot_matrix', 'mult')
    return { m, card and uniqueDeckRanks(cardlike.state) * m or 0 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = uniqueDeckRanks(state)
      if n > 0 then result:add(plusMult(n * AIJ.num(joker, 'mult'))) end
    end,
  },
}

local function sundaeMelt(joker, state, result, options)
  local n = AIJ.add(joker, 'rounds', -1)
  if n > 0 then
    result:say(AIJ.fmt(n) .. '/' .. AIJ.fmt(AIJ.num(joker, 'total_rounds')), colors.ORANGE)
    return
  end
  result:say(AIJ.msg('k_melted_ex', 'Melted!'), colors.ORANGE)
  local key = 'sundae_' .. AIJ.pick(options, state)
  if not AIJ.has(key, 'joker') then
    result:destroySelf()
    return
  end
  local ds = joker:getDataStore()
  for _, k in ipairs(ds:keys() or {}) do
    if k ~= 'aij_held_order' then AIJ.set(joker, k, nil) end
  end
  joker:setJokerDef(AIJ.id(key))
end

local function doubleSundae(key, pos, config, gives, options)
  add {
    key = key,
    rarity = 2, cost = 6, atlas = 'joker_atlas', pos = pos,
    config = config,
    vars = function(card)
      local out = {}
      for _, k in ipairs(gives) do out[#out + 1] = AIJ.val(card, key, k) end
      out[#out + 1] = AIJ.val(card, key, 'rounds')
      return out
    end,
    in_pool = function() return false end,
    triggers = {
      afterAllCardsScored = function(joker, state, step, result)
        local c, m = AIJ.num(joker, 'chips'), AIJ.num(joker, 'mult')
        if c > 0 then result:add(plusChips(c)) end
        if m > 0 then result:add(plusMult(m)) end
      end,
      afterRound = function(joker, state, step, result)
        if step.copiedBy then return end
        local d = AIJ.num(joker, 'dollars')
        if d > 0 then result:add(plusMoney(d)) end
        sundaeMelt(joker, state, result, options)
      end,
    },
  }
end

