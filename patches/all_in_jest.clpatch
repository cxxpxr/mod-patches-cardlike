}

AIJ.addJoker {
  key = 'taillefer',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 9, y = 4 }, soul_pos = { x = 9, y = 5 },
  config = { xmult = 1, xmult_mod = 0.5, boss_blinds = 4, current_boss_blinds = 0 },
  vars = function(card)
    return {
      AIJ.val(card, 'taillefer', 'xmult'), AIJ.val(card, 'taillefer', 'xmult_mod'),
      AIJ.val(card, 'taillefer', 'boss_blinds'), AIJ.val(card, 'taillefer', 'current_boss_blinds'),
    }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local x = AIJ.add(joker, 'xmult', AIJ.num(joker, 'xmult_mod'))
      result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local n = AIJ.add(joker, 'current_boss_blinds', 1)
      local total = AIJ.num(joker, 'boss_blinds')
      if n >= total then
        result:say('Killed', colors.RED)
        result:destroySelf()
      else
        result:say(AIJ.fmt(n) .. '/' .. AIJ.fmt(total), colors.ORANGE)
      end
    end,
  },
}

local talhak = { choices = 0, panel = nil }

local function adminChoices()
  local out = {}
  for _, c in ipairs(cardlike.listContent('consumable') or {}) do
    if c.type == 'admin' and not SECRET_ADMIN[c.id] then out[#out + 1] = c end
  end
  return out
end

local function openTalhak()
  if talhak.panel and talhak.panel.isOpen() then return end
  local ui = cardlike.ui
  local list = adminChoices()
  local function done()
    talhak.choices = talhak.choices - 1
    if talhak.choices <= 0 then
      talhak.choices = 0
      if talhak.panel then talhak.panel.close() end
    end
  end
  talhak.panel = ui.open {
    modal = true,
    closeOnEscape = false,
    content = function()
      local rows = {}
      local row
      for i, c in ipairs(list) do
        if (i - 1) % 4 == 0 then row = { gap = 8 } rows[#rows + 1] = row end
        row[#row + 1] = ui.button {
          label = c.name or c.id,
          color = AIJ.colors.SPECTRAL,
          onPress = function()
            local st = cardlike.state
            if st and (st.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(c.id) end
            done()
          end,
        }
      end
      local col = { style = 'window', gap = 8, align = 'center',
        ui.text { text = 'Talhak: choose an Admin card', size = 28, color = AIJ.colors.SPECTRAL } }
      for _, r in ipairs(rows) do col[#col + 1] = ui.row(r) end
      col[#col + 1] = ui.button { label = 'Skip', color = colors.RED, onPress = done }
      return ui.column(col)
    end,
  }
end

AIJ.addJoker {
  key = 'talhak',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 8, y = 10 }, soul_pos = { x = 8, y = 11 },
  config = { trigger = false },
  description = 'When a ' .. colorize(bold('Boss Blind'), colors.ORANGE) .. ' is defeated, choose '
    .. colorize(bold('any'), colors.ORANGE) .. ' non-secret ' .. colorize(bold('Admin card'), AIJ.colors.SPECTRAL)
    .. ' to create at cash out\n' .. colorize('(Must have room)', colors.GREY),
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      AIJ.set(joker, 'trigger', true)
    end,
    onCashOut = function(joker, state, step, result)
      if not AIJ.get(joker, 'trigger', false) then return end
      if (state.freeConsumableSlots or 0) - talhak.choices <= 0 then return end
      talhak.choices = talhak.choices + 1
      result:say('+Admin', AIJ.colors.SPECTRAL)
      openTalhak()
    end,
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'trigger', false)
    end,
  },
}

local function freeSlots(state)
  return math.max(0, (state and state.freeJokerSlots) or 0)
end

AIJ.addJoker {
  key = 'tangled_joker',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 23, y = 45 },
  config = { chips = 20, mult = 4 },
  vars = function(card)
    local c, m = AIJ.val(card, 'tangled_joker', 'chips'), AIJ.val(card, 'tangled_joker', 'mult')
    local s = cardlike.state
    return { c, m, c * jokerCount(s), m * freeSlots(s) }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips') * jokerCount(state)
      local m = AIJ.num(joker, 'mult') * freeSlots(state)
      if c > 0 then result:add(plusChips(c)) end
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

