AIJ.onNewRun(function(run) run.clay_destroyed = {}; run.clay_n = 0 end)

local function proxyStore(real, prefix)
  local ds = real:getDataStore()
  local p = {}
  function p:get(k) return ds:get(prefix .. k) end
  function p:getOrDefault(k, d)
    local v = ds:get(prefix .. k)
    if v == nil then return d end
    return v
  end
  function p:set(k, v)
    if v == nil then return ds:delete(prefix .. k) end
    return ds:set(prefix .. k, v)
  end
  function p:has(k) return ds:has(prefix .. k) end
  function p:delete(k) return ds:delete(prefix .. k) end
  function p:keys()
    local out = {}
    for _, k in ipairs(ds:keys() or {}) do
      if type(k) == 'string' and k:sub(1, #prefix) == prefix then out[#out + 1] = k:sub(#prefix + 1) end
    end
    return out
  end
  return p
end

local function proxyCard(real, entry)
  local prefix = 'aij_clay' .. entry.n .. ':'
  local ds = real:getDataStore()
  if not ds:get(prefix .. '__init') then
    for k, v in pairs(entry.store or {}) do
      if type(k) == 'string' and not k:find('^aij_clay') then ds:set(prefix .. k, v) end
    end
    ds:set(prefix .. '__init', true)
  end
  local store = proxyStore(real, prefix)
  local info = setmetatable({ joker = entry.id }, { __index = real.lastInfo or {} })
  local px = setmetatable({ lastInfo = info }, { __index = real })
  px.getDataStore = function() return store end
  px.getJokerDef = function() return entry.id end
  return px
end

local function clayCopies(joker)
  local list = AIJ.run.clay_destroyed or {}
  local lim = AIJ.num(joker, 'copy_limit')
  local out = {}
  for i = math.max(1, #list - lim + 1), #list do
    local e = list[i]
    local d = jokerDef(e.id)
    if d then out[#out + 1] = { entry = e, def = d } end
  end
  return out
end

local CLAY_TRIGGERS = { 'beforeRound', 'drawInitialCards', 'beforeAllCardsScored', 'beforeScore', 'onScore', 'onScoreInHand',
  'afterAllCardsScored', 'onOtherJoker', 'finalScoring', 'afterHand', 'onDiscard', 'afterRound', 'onShopEnter', 'onShopExit',
  'onShopReroll', 'onPackOpened', 'onPackSkipped', 'onBlindSkipped', 'onConsumableUsed', 'onCardSold', 'onCardBought',
  'onCardsAdded', 'onCardsRemoved', 'onCardsDestroyed', 'onMoneyChanged', 'onAnteChanged', 'onBlindDefeated', 'onHandDrawn',
  'onCardObtained', 'onBossRerolled' }
local CLAY_RETURNS = { repeatCard = 'sum', repeatHeldCard = 'sum', destroyCard = 'any', onDiscardCard = 'any' }

local clayTriggers = {}
for _, name in ipairs(CLAY_TRIGGERS) do
  clayTriggers[name] = function(joker, state, step, result)
    for _, cp in ipairs(clayCopies(joker)) do
      local fn = cp.def.triggers and cp.def.triggers[name]
      if fn then pcall(fn, proxyCard(joker, cp.entry), state, step, result) end
    end
  end
end
for name, mode in pairs(CLAY_RETURNS) do
  clayTriggers[name] = function(joker, state, step, result)
    local sum, any = 0, false
    for _, cp in ipairs(clayCopies(joker)) do
      local fn = cp.def.triggers and cp.def.triggers[name]
      if fn then
        local ok, v = pcall(fn, proxyCard(joker, cp.entry), state, step, result)
        if ok and mode == 'sum' then sum = sum + (tonumber(v) or 0) end
        if ok and v == true then any = true end
      end
    end
    if mode == 'sum' then return sum > 0 and sum or nil end
    return any or nil
  end
end

add {
  key = 'clay_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 22, y = 3 },
  config = { copy_limit = 2 },
  description = function(r)
    local c = r and r.card
    local names = {}
    if c then
      for _, cp in ipairs(clayCopies(c)) do
        local info = cardlike.contentInfo('joker', cp.entry.id)
        names[#names + 1] = (info and info.name) or AIJ.short(cp.entry.id)
      end
    end
    return 'Copies the abilities of the last ' .. hi(AIJ.fmt(AIJ.val(c, 'clay_joker', 'copy_limit'))) .. ' '
      .. hi('destroyed', MULT) .. ' All in Jest ' .. hi('Jokers') .. '\n' .. grey('(Excluding Clay Joker)') .. '\n'
      .. grey('(Currently: ' .. (#names > 0 and table.concat(names, ', ') or 'none') .. ')')
  end,
  dollarsAtRoundEnd = function(joker, state)
    local total = 0
    for _, cp in ipairs(clayCopies(joker)) do
      if cp.def.dollarsAtRoundEnd then
        local ok, v = pcall(cp.def.dollarsAtRoundEnd, proxyCard(joker, cp.entry), state)
        if ok then total = total + (tonumber(v) or 0) end
      end
    end
    return total
  end,
  triggers = clayTriggers,
}

AIJ.onJokerGone(function(state, info, sold)
  if sold or not info then return end
  for _, j in ipairs(active(state, 'borra')) do
    borraUp(j, nil, nil, true)
    j:popup('Upgrade!', MULT)
  end
  local id = info.joker
  if not id or AIJ.isId(id, 'clay_joker') then return end
  local run = AIJ.run
  run.clay_destroyed = run.clay_destroyed or {}
  run.clay_n = (run.clay_n or 0) + 1
  table.insert(run.clay_destroyed, { id = id, n = run.clay_n, store = AIJ.copy(info.store or {}) })
  while #run.clay_destroyed > 10 do table.remove(run.clay_destroyed, 1) end
end)

