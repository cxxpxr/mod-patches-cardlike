ABILITIES.gnasher = {
  cost = function() return 0 end,
  can = function(card, state)
    return AIJ.get(card, 'active', true) == true and #ofList(state, 'consumables') > 0 and (state.freeConsumableSlots or 0) > 0
  end,
  use = function(card, state, args)
    local list = ofList(state, 'consumables')
    local src = AIJ.pick(list, state)
    local id = src and AIJ.defId(src)
    if not id or (state.freeConsumableSlots or 0) <= 0 or not cardlike.createConsumable(id) then return false end
    card:popup('Copied!', colors.ORANGE)
    AIJ.set(card, 'active', false)
  end,
  label = 'COPY',
}
AIJ.addJoker {
  key = 'gnasher',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 10, y = 6 },
  blueprint_compat = false,
  config = { active = true },
  description = function(r)
    local active = AIJ.val(r and r.card, 'gnasher', 'active', true)
    return colorize(bold('Activated Ability'), ENHANCED) .. ' Once per Ante, create a ' .. colorize(bold('copy'), colors.ORANGE)
      .. ' of a random held ' .. colorize(bold('consumable'), colors.ORANGE) .. '\n'
      .. colorize('(Must have room) (' .. (active and 'Active' or 'Inactive') .. ')', colors.GREY)
  end,
  buttons = { abilityButton('gnasher') },
  triggers = {
    onAnteChanged = function(joker, state, step, result)
      if step.copiedBy or (step.delta or 0) == 0 then return end
      if AIJ.get(joker, 'active', true) ~= true then
        AIJ.set(joker, 'active', true)
        result:say('Active!', colors.ORANGE)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'goblet',
  rarity = 1, cost = 4, lite = true, atlas = 'joker_atlas', pos = { x = 10, y = 24 },
  blueprint_compat = false,
  config = { slots = 2 },
  vars = function(card) return { AIJ.val(card, 'goblet', 'slots') } end,
  onAdded = function(joker, state)
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) + AIJ.num(joker, 'slots')
  end,
  onRemoved = function(joker, state)
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) - AIJ.num(joker, 'slots')
  end,
}

AIJ.onNewRun(function(run) run.goblin_joker_pending = 0 end)

local GOBLIN = AIJ.addJoker {
  key = 'goblin_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 13, y = 3 },
  config = { draw_extra = 2 },
  vars = function(card) return { AIJ.val(card, 'goblin_joker', 'draw_extra') } end,
  triggers = {
    onDiscard = function(joker, state, step, result)
      AIJ.run.goblin_joker_pending = (AIJ.run.goblin_joker_pending or 0) + AIJ.num(joker, 'draw_extra')
      result:say('+' .. AIJ.fmt(AIJ.num(joker, 'draw_extra')), colors.ORANGE)
    end,
  },
}
if GOBLIN then
  cardlike.on('onHandDrawn', function(state, step)
    local n = AIJ.run.goblin_joker_pending or 0
    if n <= 0 then return end
    AIJ.run.goblin_joker_pending = 0
    if step and step.first then return end
    if (state.cardsLeftInDeck or 0) > 0 then cardlike.drawCards(math.min(52, n)) end
  end)
  cardlike.on('onRoundStart', function() AIJ.run.goblin_joker_pending = 0 end)
end

