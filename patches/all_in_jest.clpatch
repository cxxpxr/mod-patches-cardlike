  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local last = AIJ.get(joker, 'last_hand')
      if last and step.hand.contains and step.hand.contains[last] and step.hand.handType ~= last then
        AIJ.add(joker, 'xmult', AIJ.num(joker, 'gain'))
        result:say('Upgrade!', colors.MULT)
      end
    end,
    afterHand = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'last_hand', step.hand.handType) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
