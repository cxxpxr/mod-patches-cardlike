AIJ.addJoker {
  key = 'goofball',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 22, y = 8 },
  config = { percent = 8 },
  vars = function(card) return { AIJ.val(card, 'goofball', 'percent') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if not step.card:isFace() then return end
      local p = math.min(1, AIJ.num(joker, 'percent') / 100)
      local chips, mult = tonumber(state.currentChips) or 0, tonumber(state.currentMult) or 0
      local cm, mm = p * chips, p * mult
      local avg = (cm + mm) / 2
      if avg - cm ~= 0 then result:add(plusChips(avg - cm)) end
      if avg - mm ~= 0 then result:add(plusMult(avg - mm)) end
      result:say(AIJ.fmt(p * 100) .. '%', AIJ.colors.PLASMA)
    end,
  },
}

