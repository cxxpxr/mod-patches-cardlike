    ["j_aij_brass_joker"] = { name = "Brass Joker", text = "When a [color=\"#f3a712\"][b]Joker[/b][/color] with an [color=\"#V1#\"][b]Activated Ability[/b][/color] is used, this [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]+Mult[/b][/color] equal to the [color=\"#f3a712\"][b]money[/b][/color] cost of using the ability\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
