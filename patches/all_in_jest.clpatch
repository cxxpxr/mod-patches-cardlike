}

local REROLLED = 'aij_rerolled_from'

local function rightJoker(card, state)
  local jokers = state and state.jokers or {}
  for i, j in ipairs(jokers) do
    if j == card then return jokers[i + 1] end
  end
  return nil
end

local function storeSnapshot(card)
  local ds = card:getDataStore()
  local out = {}
  for _, k in ipairs(ds:keys() or {}) do out[k] = ds:get(k) end
  return out, ds
end

local function stageCanReroll(card, state)
  if AIJ.get(card, 'trigger', true) == false then return false end
  local right = rightJoker(card, state)
  return right ~= nil and right:getDataStore():get(REROLLED) == nil
end

AIJ.addJoker {
  key = 'stage_production',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 14 },
  config = { trigger = true },
  blueprint_compat = false,
  vars = function(card)
    return { activeText(AIJ.val(card, 'stage_production', 'trigger') ~= false), colours = { ENHANCED_COLOUR } }
  end,
  buttons = {
    AIJ.ability('stage_production', {
      label = 'REROLL',
      canPress = function(card, state) return stageCanReroll(card, state) end,
      press = function(card, state)
        if not stageCanReroll(card, state) then return false end
        local right = rightJoker(card, state)
        local old = AIJ.defId(right)
        local rarity = AIJ.safe(right.getRarity, right) or 'Common'
        local pick
        for _ = 1, 12 do
          local id = cardlike.randomJoker(rarity)
          if id and not AIJ.isId(id, old) then pick = id break end
        end
        if not pick then
          card:popup('No replacement found!', colors.RED)
          return false
        end
        local snap, ds = storeSnapshot(right)
        for k in pairs(snap) do ds:delete(k) end
        right:setJokerDef(pick)
        right:getDataStore():set(REROLLED, { id = old, store = snap })
        right:punch()
        AIJ.set(card, 'trigger', false)
        card:punch()
      end,
    }),
  },
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'trigger', true)
    end,
  },
}

cardlike.on('onRoundStart', function(state)
  for _, j in ipairs(state.jokers or {}) do
    local ds = j:getDataStore()
    local from = ds:get(REROLLED)
    if type(from) == 'table' and from.id then
      for _, k in ipairs(ds:keys() or {}) do ds:delete(k) end
      j:setJokerDef(from.id)
      local ds2 = j:getDataStore()
      for k, v in pairs(from.store or {}) do ds2:set(k, v) end
      j:popup('Reset', colors.ORANGE)
    end
  end
end)

