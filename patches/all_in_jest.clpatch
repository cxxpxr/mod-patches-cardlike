    ["j_aij_abandoned_joker"] = { name = "Abandoned Joker", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] all played [color=\"#f3a712\"][b]face[/b][/color] cards on [color=\"#f3a712\"][b]first hand[/b][/color] of round" },
