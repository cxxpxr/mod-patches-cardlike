add {
  key = 'chitty',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 11, y = 10 },
  blueprint_compat = false,
  config = { slot_count = 1 },
  description = function(r)
    local c = r and r.card
    return hi('+' .. AIJ.fmt(AIJ.val(c, 'chitty', 'slot_count'))) .. ' ' .. hi('Ticket') .. ' available for purchase in the '
      .. hi('Shop') .. ' each Ante'
  end,
}
AIJ.onNewRun(function(run) run.chitty_ante = nil; run.chitty_ids = {} end)
local function chittyPick(state, taken)
  local owned = {}
  for _, t in ipairs(state.tickets or {}) do owned[t] = true end
  for _, c in ipairs(state.shopCards or {}) do
    local d = AIJ.defId(c)
    if d then owned[d] = true end
  end
  local cands = {}
  for i = 0, 31 do
    local id = 'ticket_' .. i
    if not owned[id] and not taken[id] and (i % 2 == 0 or owned['ticket_' .. (i - 1)]) then cands[#cands + 1] = id end
  end
  return AIJ.pick(cands, state)
end
local function chittyStock(state, fresh)
  local want = 0
  for _, j in ipairs(active(state, 'chitty')) do want = want + AIJ.num(j, 'slot_count') end
  if want <= 0 then return end
  local run = AIJ.run
  if run.chitty_ante ~= state.ante or type(run.chitty_ids) ~= 'table' then
    run.chitty_ante = state.ante
    run.chitty_ids = {}
  end
  local taken = {}
  for _, id in ipairs(run.chitty_ids) do taken[id] = true end
  while #run.chitty_ids < want do
    local id = chittyPick(state, taken)
    if not id then break end
    taken[id] = true
    run.chitty_ids[#run.chitty_ids + 1] = id
  end
  for i = 1, math.min(want, #run.chitty_ids) do
    local id = run.chitty_ids[i]
    if not state:hasTicket(id) then cardlike.addShopItem(id) end
  end
end
cardlike.on('onShopEnter', function(state) chittyStock(state) end)
cardlike.on('onShopReroll', function(state) chittyStock(state) end)

add {
  key = 'chocolate_coins',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 22, y = 34 },
  config = { xmult_minus_mod = 0.1, xmult_mod = 0.5, xmult = 0 },
  vars = function(card)
    return { AIJ.val(card, 'chocolate_coins', 'xmult_mod'), AIJ.val(card, 'chocolate_coins', 'xmult_minus_mod'),
      1 + AIJ.val(card, 'chocolate_coins', 'xmult') }
  end,
  onAdded = function(joker, state)
    if (state.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(AIJ.vanilla('c_devil')) end
  end,
  triggers = {
    onMoneyChanged = function(joker, state, step, result)
      if step.copiedBy or (tonumber(step.amount) or 0) < 1 then return end
      if not (state:isPhase('play') or state:isPhase('scoring')) then return end
      local x = 1 + AIJ.num(joker, 'xmult')
      if x - AIJ.num(joker, 'xmult_minus_mod') <= 1 then return eaten(result) end
      AIJ.add(joker, 'xmult', -AIJ.num(joker, 'xmult_minus_mod'))
      result:say('-X' .. AIJ.fmt(AIJ.num(joker, 'xmult_minus_mod')) .. ' Mult', MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}
onEnhanced(function(state, card, old, new)
  if not enhIs(new, 'm_gold') then return end
  for _, j in ipairs(active(state, 'chocolate_coins')) do
    AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
    j:popup('Upgrade!', MULT)
  end
end)

