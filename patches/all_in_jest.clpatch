AIJ.addJoker {
  key = 'vexed',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 30 },
  config = { chance = 50 },
  vars = function(card) return { AIJ.val(card, 'vexed', 'chance') } end,
  triggers = {
    onCardSold = function(joker, state, step, result)
      local c = step.card
      local info = c and c.lastInfo or {}
      if info.kind ~= 'joker' or not info.joker then return end
      if state:random(1, 100) > AIJ.num(joker, 'chance') then return end
      local opts = {}
      if info.edition and info.edition ~= 'default' then opts.edition = info.edition end
      if info.locked then opts.locked = true end
      if info.sticker and info.sticker ~= 'none' and info.sticker ~= 'locked' then opts.sticker = info.sticker end
      local copy = cardlike.createJoker(info.joker, opts)
      if not copy then return end
      local ds = copy:getDataStore()
      for k, v in pairs(info.store or {}) do ds:set(k, v) end
      copy:punch()
      result:say('Again!', colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
  key = 'visage',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 8 },
  description = function(r)
    local last = AIJ.run.visage_last
    local now = last and (AIJ.rankName(last.rank) .. ' of ' .. tostring(last.suit)) or 'None'
    return 'When a hand is played, the last ' .. C('destroyed', colors.MULT) .. ' ' .. C('face', colors.ORANGE)
      .. ' card also scores its ' .. C('Points', colors.CHIPS) .. ' and bonuses\n'
      .. grey('(Other Jokers do not see it)') .. '\n' .. grey('(Currently: ' .. now .. ')')
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local last = AIJ.run.visage_last
      if not last then return end
      local ev = AIJ.safe(function() return cardlike.card(last.uid):getEvaluation(false) end)
      if type(ev) == 'table' then
        if (tonumber(ev.points) or 0) > 0 then result:add(plusChips(tonumber(ev.points))) end
        for _, b in ipairs(ev.bonuses or {}) do result:add(b) end
        local e = ev.edition
        if type(e) == 'table' then
          if e.bonusType then result:add(e) else for _, b in ipairs(e) do result:add(b) end end
        end
      elseif (last.points or 0) > 0 then
        result:add(plusChips(last.points))
      end
      result:say(AIJ.rankName(last.rank) .. '!', colors.ORANGE)
    end,
  },
}

