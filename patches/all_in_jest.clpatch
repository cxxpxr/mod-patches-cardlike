AIJ.addJoker {
  key = 'party_streamers',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 0, y = 5 }, lite = true,
  config = {},
  blueprint_compat = false,
  description = 'If ' .. hl('first hand') .. ' of round is exactly ' .. hl('1') .. ' card with no ' .. hl('Stamp')
    .. ', it gets a ' .. hl('Replay', colors.MULT) .. ', ' .. hl('Fruit', colors.CHIPS) .. ' or ' .. hl('Cash', colors.MONEY) .. ' Stamp',
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy or (state.handsPlayed or 0) ~= 1 or #(step.hand.allCards or {}) ~= 1 then return end
      local c = step.hand.playedCards[1]
      if not c or AIJ.stamp(c) or AIJ.isDebuffed(c) then return end
      local roll = state:randomFloat()
      local stamp = roll > 0.66 and 'Fruit Stamp' or (roll > 0.33 and 'Cash Stamp' or 'Replay Stamp')
      c:setStamp(stamp)
      c:punch()
      result:say(stamp, colors.ORANGE)
    end,
  },
}

