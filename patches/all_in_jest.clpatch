        end
      end,
    }),
  },
}

local SECRET_HANDS = { FIVE_OF_A_KIND = true, FLUSH_HOUSE = true, FLUSH_FIVE = true, ROYAL_FLUSH = true }

local function newMuteHand(joker, state)
  local current = AIJ.get(joker, 'poker_hand')
  local pool = {}
  for _, h in ipairs(AIJ.HANDS) do
    local visible = not SECRET_HANDS[h]
    if not visible then
      local e = state:getHand(h)
      visible = e ~= nil and (e.played or 0) > 0
    end
    if visible and h ~= current then pool[#pool + 1] = h end
  end
  AIJ.set(joker, 'poker_hand', AIJ.pick(pool, state) or 'HIGH_CARD')
  AIJ.set(joker, 'trigger', false)
end

AIJ.addJoker {
  key = 'mute_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 0, y = 4 },
  config = { poker_hand = '(hand)', trigger = false },
  blueprint_compat = false,
  vars = function(card)
    local h = AIJ.val(card, 'mute_joker', 'poker_hand')
    return { h == '(hand)' and h or AIJ.handName(h) }
  end,
  onAdded = function(joker, state)
    if AIJ.get(joker, 'poker_hand') == '(hand)' then newMuteHand(joker, state) end
  end,
  triggers = {
    destroyCard = function(joker, state, step, result)
      if step.copiedBy or AIJ.get(joker, 'trigger') or not step.hand then return end
      if step.hand.handType == AIJ.get(joker, 'poker_hand') then return true end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy or not step.hand then return end
      if not AIJ.get(joker, 'trigger') and step.hand.handType == AIJ.get(joker, 'poker_hand') then
        AIJ.set(joker, 'trigger', true)
      end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      newMuteHand(joker, state)
      result:say('Reset')
    end,
  },
}

AIJ.addJoker {
  key = 'naiteh',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 7, y = 10 }, soul_pos = { x = 7, y = 11 }, lite = true,
  config = { h_size = 1, h_size_mod = 1 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'naiteh', 'h_size'), AIJ.val(card, 'naiteh', 'h_size_mod') } end,
  onAdded = function(joker, state)
    local n = AIJ.num(joker, 'h_size')
    if n > 0 then state.handSize = state.handSize + n end
  end,
  onRemoved = function(joker, state)
    local n = AIJ.num(joker, 'h_size')
    if n > 0 and state and state.handSize then state.handSize = state.handSize - n end
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local d = AIJ.num(joker, 'h_size_mod')
      AIJ.add(joker, 'h_size', d)
      state.handSize = state.handSize + d
      result:say('+' .. AIJ.fmt(d) .. ' Hand Size')
    end,
  },
}

AIJ.addJoker {
  key = 'napkin',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 7 },
  config = { xmult_mod = 1, xmult = 1, state = false },
  vars = function(card) return { AIJ.val(card, 'napkin', 'xmult_mod'), AIJ.val(card, 'napkin', 'xmult') } end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.get(joker, 'state') then
        local x = AIJ.add(joker, 'xmult', AIJ.num(joker, 'xmult_mod'))
        result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
      end
      AIJ.set(joker, 'state', true)
    end,
    beforeRound = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'state', false) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

local MULT_MOONS = { 'dysnomia', 'europa', 'luna', 'nix', 'pallas', 'phobos', 'planet_nine', 'titan', 'triton',
  'umbriel', 'vulcanoid', 'zoozve' }

AIJ.addJoker {
