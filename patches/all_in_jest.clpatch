  ["Edition"] = {
    ["e_aij_aureate"] = { name = "Aureate", text = "[color=\"#f3a712\"][b]X#1#[/b][/color] [color=\"#f3a712\"][b]$[/b][/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]$#2#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["e_aij_glimmer"] = { name = "Glimmer", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#f3a712\"][b]#1#%[/b][/color] of [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color]" },
    ["e_aij_misprint"] = { name = "Misprinted", text = "[color=\"#f3a712\"][b]Randomises[/b][/color] the [color=\"#f3a712\"][b]values[/b][/color] of this [color=\"#f3a712\"][b]Joker[/b][/color] between [color=\"#f3a712\"][b]X#1#[/b][/color] and [color=\"#f3a712\"][b]X#2#[/b][/color] after hand [color=\"#f3a712\"][b]played[/b][/color]" },
