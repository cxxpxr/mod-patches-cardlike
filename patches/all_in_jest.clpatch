AIJ.onNewRun(function(run) run.arngren_ante = nil run.arngren_tickets = {} end)

local function ticketAllowed(state, entry)
  if state:hasTicket(entry.id) then return false end
  local pre = entry.precursor
  if not pre then
    local n = tonumber(tostring(entry.id):match('^ticket_(%d+)$'))
    if n and n % 2 == 1 then pre = 'ticket_' .. (n - 1) end
  end
  return pre == nil or state:hasTicket(pre)
end

local function arngrenTickets(state, count)
  if AIJ.run.arngren_ante ~= state.ante or #(AIJ.run.arngren_tickets or {}) < count then
    local inShop = {}
    for _, c in ipairs(cardlike.cards('shop') or {}) do inShop[(c.lastInfo or {}).consumable or ''] = true end
    local pool = {}
    for _, e in ipairs(cardlike.listContent('ticket') or {}) do
      if e.id and not inShop[e.id] and ticketAllowed(state, e) then pool[#pool + 1] = e.id end
    end
    local list = (AIJ.run.arngren_ante == state.ante) and AIJ.copy(AIJ.run.arngren_tickets or {}) or {}
    pool = AIJ.shuffled(pool, state)
    for _, id in ipairs(pool) do
      if #list >= count then break end
      if not AIJ.contains(list, id) then list[#list + 1] = id end
    end
    AIJ.run.arngren_ante = state.ante
    AIJ.run.arngren_tickets = list
  end
  for i, id in ipairs(AIJ.run.arngren_tickets) do
    if i > count then break end
    if not state:hasTicket(id) then cardlike.addShopItem(id) end
  end
end

local function arngrenCount(state)
  local n = 0
  for _, j in ipairs(owned('arngren')) do n = n + AIJ.num(j, 'bonus_slots') end
  return n
end

AIJ.addJoker {
  key = 'arngren',
  rarity = 3, cost = 10, atlas = 'joker_atlas', pos = { x = 21, y = 12 },
  config = { bonus_slots = 1 },
  description = function(r)
    local n = AIJ.val(r and r.card, 'arngren', 'bonus_slots')
    local b = colorize(bold('+' .. AIJ.fmt(n)), colors.ORANGE)
    return b .. ' card slot, ' .. b .. ' Pack slot and ' .. b .. ' Ticket slot in the ' .. colorize(bold('shop'), colors.ORANGE)
  end,
  blueprint_compat = false,
  onAdded = function(joker, state)
    local n = AIJ.num(joker, 'bonus_slots')
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + n
    state.packsAvailableInShopCount = state.packsAvailableInShopCount + n
  end,
  onRemoved = function(joker, state)
    local n = AIJ.num(joker, 'bonus_slots')
    state.cardsAvailableInShopCount = state.cardsAvailableInShopCount - n
    state.packsAvailableInShopCount = state.packsAvailableInShopCount - n
  end,
}

cardlike.on('onShopEnter', function(state) local n = arngrenCount(state) if n > 0 then arngrenTickets(state, n) end end)
cardlike.on('onShopReroll', function(state) local n = arngrenCount(state) if n > 0 then arngrenTickets(state, n) end end)

local function dealReset(joker, state, result)
  if (state.money or 0) <= AIJ.num(joker, 'money_reset') and AIJ.num(joker, 'mult') ~= 0 then
    AIJ.set(joker, 'mult', 0)
    result:say('Reset', colors.RED)
  end
end

AIJ.addJoker {
  key = 'art_of_the_deal',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 12, y = 1 },
  config = { mult = 0, mult_mod = 1, money_reset = 25 },
  vars = function(card)
    local id = 'art_of_the_deal'
    return { AIJ.val(card, id, 'mult'), AIJ.val(card, id, 'mult_mod'), AIJ.val(card, id, 'money_reset') }
  end,
  triggers = {
    onMoneyChanged = function(joker, state, step, result)
      if step.copiedBy then return end
      if (step.amount or 0) >= 1 and (state.money or 0) > AIJ.num(joker, 'money_reset') then
        AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
        result:say('Upgrade!', colors.MULT)
      end
      dealReset(joker, state, result)
    end,
    beforeAllCardsScored = function(joker, state, step, result)
      if not step.copiedBy then dealReset(joker, state, result) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local function astrologerMoons(kind)
  local out = {}
  if okP and P and P.moons then
    for _, m in ipairs(P.moons) do if m.kind == kind then out[#out + 1] = m.key end end
    return out
  end
  if kind == 'mult' then
    return { 'dysnomia', 'europa', 'luna', 'nix', 'pallas', 'phobos', 'planet_nine', 'titan', 'triton', 'umbriel', 'vulcanoid', 'zoozve' }
  end
  return { '2000_eu16', '2013_nd15', 'callisto', 'charon', 'deimos', 'iapetus', 'kamooalewa', 'kuiper', 'nibiru', 'oberon', 'phaethon' }
end
local MULT_MOONS = astrologerMoons('mult')
local CHIP_MOONS = astrologerMoons('chips')

local astrologerId = AIJ.addJoker {
  key = 'astrologer', ignore = not AIJ.setting('moons_enabled'),
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 10, y = 12 },
  config = { picks = 1 },
  description = colorize(bold('Fruit cards'), AIJ.colors.PLANET) .. ' are replaced by their '
    .. colorize(bold('Mult'), colors.MULT) .. ' Moon in ' .. colorize(bold('odd'), colors.ORANGE) .. ' Antes and their '
    .. colorize(bold('Points'), colors.CHIPS) .. ' Moon in ' .. colorize(bold('even'), colors.ORANGE) .. ' Antes',
  blueprint_compat = false,
}

if astrologerId then
  cardlike.filter('consumablePool', function(ids, ctype)
    local state = cardlike.state
    if ctype ~= 'fruit' or not state or not state.ante or #owned('astrologer') == 0 then return nil end
    local moons = (state.ante % 2 == 0) and CHIP_MOONS or MULT_MOONS
    local keep = {}
    for _, id in ipairs(ids) do
      for _, m in ipairs(moons) do
        if id == AIJ.id(m) then keep[#keep + 1] = id break end
      end
    end
    if #keep > 0 then return keep end
  end)
end

AIJ.addJoker {
  key = 'atemporal_taco',
