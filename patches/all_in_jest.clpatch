AIJ.addJoker {
  key = 'guillaume',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 5, y = 4 }, soul_pos = { x = 5, y = 5 },
  blueprint_compat = false,
  config = { joker_slots = 0, joker_slots_mod = 1 },
  vars = function(card) return { AIJ.val(card, 'guillaume', 'joker_slots'), AIJ.val(card, 'guillaume', 'joker_slots_mod') } end,
  onAdded = function(joker, state)
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) + AIJ.num(joker, 'joker_slots')
  end,
  onRemoved = function(joker, state)
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) - AIJ.num(joker, 'joker_slots')
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not isBoss(state) or #ofList(state, 'jokers') >= 5 then return end
      local n = AIJ.num(joker, 'joker_slots_mod')
      AIJ.add(joker, 'joker_slots', n)
      state.additionalJokerSlots = (state.additionalJokerSlots or 0) + n
      result:say('+' .. AIJ.fmt(n) .. ' Joker Slot', colors.ORANGE)
    end,
