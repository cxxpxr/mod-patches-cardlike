local function ybiReset(state)
  local ranked = {}
  for _, c in ipairs(state.allCards or {}) do if rankOf(c) then ranked[#ranked + 1] = c end end
  local pick = AIJ.pick(ranked, state)
  local enh = {}
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id ~= 'Default' and e.id ~= 'Prismatic' then enh[#enh + 1] = e.id end
  end
  AIJ.run.you_broke_it = {
    rank = pick and rankOf(pick) or 14,
    enhancement = AIJ.pick(enh, state) or 'Chipped',
  }
end
cardlike.on('onRunStart', ybiReset)
cardlike.on('onBlindDefeated', ybiReset)

local function enhName(id)
  local info = cardlike.contentInfo('enhancement', id)
  return info and info.name or tostring(id)
end

