local function heldOrder(j) return tonumber(AIJ.get(j, 'aij_held_order')) end
local function fillHeldOrder(newCard)
  local jokers = cardlike.cards('jokers') or {}
  local max = -1
  for _, j in ipairs(jokers) do
    local o = heldOrder(j)
    if o and o > max and j ~= newCard then max = o end
  end
  for _, j in ipairs(jokers) do
    if j == newCard or not heldOrder(j) then
      max = max + 1
      AIJ.set(j, 'aij_held_order', max)
    end
  end
end
cardlike.on('onCardObtained', function(state, step)
  local c = step and step.card
  if type(c) == 'table' and (c.lastInfo or {}).kind == 'joker' then fillHeldOrder(c) end
end)

local function elderTarget(joker, retried)
  local best, bestOrder
  local missing = false
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if not AIJ.is(j, 'elder') then
      local o = heldOrder(j)
      if not o then missing = true
      elseif not bestOrder or o < bestOrder then best, bestOrder = j, o end
    end
  end
  if missing and not retried then
    fillHeldOrder(nil)
    return elderTarget(joker, true)
  end
  return best
end

