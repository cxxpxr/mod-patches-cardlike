local otc = { pending = 0, wait = 0, panel = nil }

local function otcClose()
  if otc.panel and otc.panel.isOpen() then otc.panel.close() end
  otc.panel = nil
end

local function otcOpen()
  local ui = cardlike.ui
  otc.panel = ui.open {
    modal = true,
    closeOnEscape = false,
    content = function()
      local state = cardlike.state
      if not state then return nil end
      local deck = state.unDrawnCards or {}
      local bySuit, order = {}, {}
      for _, c in ipairs(deck) do
        local key = AIJ.noRank(c) and 'Other' or tostring(c:getSuit())
        if not bySuit[key] then bySuit[key] = {} order[#order + 1] = key end
        table.insert(bySuit[key], c)
      end
      table.sort(order)
      local rows = {
        ui.text { text = 'Over the Counter: choose ' .. otc.pending .. ' card' .. (otc.pending == 1 and '' or 's') .. ' to draw', size = 24, color = colors.ORANGE },
      }
      for _, key in ipairs(order) do
        local list = bySuit[key]
        table.sort(list, function(a, b) return (a:getRank() or 0) > (b:getRank() or 0) end)
        local row = { gap = 4, align = 'center', ui.text { text = key, size = 18, color = AIJ.SUIT_COLORS[key] or colors.WHITE, maxWidth = 90 } }
        for _, c in ipairs(list) do
          local label = AIJ.noRank(c) and 'R' or AIJ.rankName(c:getRank()):sub(1, (c:getRank() == 10) and 2 or 1)
          if AIJ.enhancement(c) then label = label .. '*' end
          row[#row + 1] = ui.button {
            label = label, padding = 4,
            textColor = AIJ.SUIT_COLORS[key] or colors.WHITE, color = colors.DARK,
            onPress = function()
              c:moveTo('hand')
              otc.pending = otc.pending - 1
              if otc.pending <= 0 or #(cardlike.state.unDrawnCards or {}) == 0 then otc.pending = 0 otcClose() end
            end,
          }
        end
        rows[#rows + 1] = ui.row(row)
      end
      rows[#rows + 1] = ui.text { text = '* has an Enhancement', size = 14, color = colors.GREY }
      rows.style = 'window'
      rows.gap = 8
      rows.align = 'center'
      return ui.column(rows)
    end,
  }
end

cardlike.onFrame(function(frame)
  if otc.pending <= 0 then return end
  local state = cardlike.state
  if not frame.inRun or not state or state.phase ~= 'pack' then otc.pending = 0 otcClose() return end
  if otc.panel and otc.panel.isOpen() then return end
  if #(state.unDrawnCards or {}) == 0 then otc.pending = 0 return end
  if #(state.cardsInHand or {}) == 0 then
    otc.wait = otc.wait - (frame.dt or 0)
    if otc.wait <= 0 then otc.pending = 0 end
    return
  end
  otcOpen()
end)

AIJ.addJoker {
