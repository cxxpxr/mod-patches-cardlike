    ["j_aij_aluzinnu"] = { name = "Aluzinnu", text = "The [color=\"#f3a712\"][b]Scrap Metal[/b][/color] and [color=\"#f3a712\"][b]The Prototype[/b][/color] tickets have [color=\"#f3a712\"][b]no[/b][/color] [color=\"#ff007f\"][b]downsides[/b][/color] and can appear [color=\"#f3a712\"][b]multiple[/b][/color] times" },
    ["j_aij_ambrosius"] = { name = "Ambrosius", text = "[color=\"#d138bf\"][b]Arcana[/b][/color] Packs have [color=\"#f3a712\"][b]#3#[/b][/color] more options, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#f3a712\"][b]increase[/b][/color] by [color=\"#f3a712\"][b]#4#[/b][/color] if [color=\"#f3a712\"][b]played hand[/b][/color] contains only [color=\"#f3a712\"][b]Crown[/b][/color] [color=\"#f3a712\"][b]Kings[/b][/color]" },
    ["j_aij_american_comic"] = { name = "American Comic", text = "Adds [color=\"#f3a712\"][b]#1#[/b][/color] extra slot to the [color=\"#f3a712\"][b]shop[/b][/color], which [color=\"#f3a712\"][b]always[/b][/color] contains a random [color=\"#009dff\"][b]Common[/b][/color] Joker" },
    ["j_aij_anagraph"] = { name = "Anagraph", text = "When any [color=\"#f3a712\"][b]Joker[/b][/color] or [color=\"#f3a712\"][b]Playing[/b][/color] [color=\"#f3a712\"][b]card[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color] create an exact [color=\"#f3a712\"][b]copy[/b][/color] and immediately [color=\"#ff007f\"][b]destroy[/b][/color] it again" },
    ["j_aij_anatomy"] = { name = "Anatomy", text = "" },
    ["j_aij_anchor"] = { name = "Anchor", text = "This Joker and adjacent Jokers [color=\"#f3a712\"][b]cannot[/b][/color] [color=\"#f3a712\"][b]be [/b][/color][color=\"#ff007f\"][b]destroyed[/b][/color]" },
    ["j_aij_angel_number"] = { name = "Angel Number", text = "[color=\"#1bb18c\"][b]+#1#[/b][/color] Odds this hand for each [color=\"#f3a712\"][b]7[/b][/color] in scoring hand" },
    ["j_aij_angoulevent"] = { name = "Angoulevent", text = "Retrigger all played cards [color=\"#f3a712\"][b]#1#[/b][/color] additional times" },
    ["j_aij_animatronic"] = { name = "Animatronic", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] hand size per consecutive hand containing a [color=\"#f3a712\"][b]Straight[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] hand size)[/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]+#3#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_antihero"] = { name = "Anti-Hero", text = "" },
