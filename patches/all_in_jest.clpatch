local function straightFlushType(cards)
  local ranks = {}
  for _, c in ipairs(cards) do local r = rankOf(c) if r then ranks[r] = true end end
  if ranks[10] and ranks[11] and ranks[12] and ranks[13] and ranks[14] then return 'ROYAL_FLUSH' end
  return 'STRAIGHT_FLUSH'
end

local function flushSize(state)
  if state and AIJ.owns('j_four_fingers', state) then return 4 end
  return 5
end

AIJ.addJoker {
  key = 'read_em_and_weep',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 12, y = 3 },
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local t = step.hand.handType
      if not (step.hand.contains.STRAIGHT or t == 'STRAIGHT' or t == 'STRAIGHT_FLUSH' or t == 'ROYAL_FLUSH') then return end
      local suit = AIJ.pick(AIJ.SUITS, state)
      for _, c in ipairs(step.hand.allCards or {}) do
        if not AIJ.noRank(c) and c:getSuit() ~= suit then c:setSuit(suit) end
      end
      result:say(AIJ.msg('k_aij_change_ex', 'Change!'), colors.ORANGE)
    end,
  },
}

cardlike.filter('handType', function(v, played)
  local state = st()
  if type(v) ~= 'table' or v.handType ~= 'STRAIGHT' or type(played) ~= 'table' then return nil end
  if not active(state, 'read_em_and_weep') then return nil end
  local cards = {}
  for _, c in ipairs(played) do if type(c) == 'table' then cards[#cards + 1] = c end end
  if #cards < flushSize(state) then return nil end
  local uids = {}
  for _, c in ipairs(cards) do uids[#uids + 1] = c.uid or AIJ.safe(c.getId, c) end
  return { handType = straightFlushType(cards), scoring = uids }
end)

AIJ.addJoker {
  key = 'realty_sign', lite = true,
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 3, y = 3 },
  config = { sell_increase = 3 },
  vars = function(card) return { AIJ.val(card, 'realty_sign', 'sell_increase') } end,
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy or step.hand.handType ~= 'FULL_HOUSE' then return end
      joker:addSellValue(AIJ.num(joker, 'sell_increase'))
      result:say(AIJ.msg('k_val_up', 'Value Up!'), colors.MONEY)
    end,
  },
}

local function redTag(joker, state)
  local tag = joker:getDataStore():get('red_tag')
  if not tag then
    tag = tostring(state:random(1, 999999999))
    AIJ.set(joker, 'red_tag', tag)
  end
  return 'aij_red_joker_' .. tag
end

AIJ.addJoker {
  key = 'red_joker',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 8, y = 22 },
  config = { mult = 0, mult_mod = 1, gen = 1 },
  vars = function(card) return { AIJ.val(card, 'red_joker', 'mult'), AIJ.val(card, 'red_joker', 'mult_mod') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy then return end
      local key = redTag(joker, state)
      local gen = AIJ.num(joker, 'gen')
      local ds = step.card:getDataStore()
      if ds:get(key) ~= gen then
        ds:set(key, gen)
        AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
      else
        ds:delete(key)
        AIJ.set(joker, 'gen', gen + 1)
        AIJ.set(joker, 'mult', 0)
        result:say(AIJ.msg('k_reset', 'Reset'), colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
