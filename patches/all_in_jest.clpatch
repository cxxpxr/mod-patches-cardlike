add {
  key = 'desiderium',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 27 },
  config = { xmult_mod = 0.5, xmult = 1, trigger = false },
  vars = function(card) return { AIJ.val(card, 'desiderium', 'xmult_mod'), AIJ.val(card, 'desiderium', 'xmult') } end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'trigger', true)
    end,
    onMoneyChanged = function(joker, state, step, result)
      if step.copiedBy then return end
      if (tonumber(step.amount) or 0) < 0 then AIJ.set(joker, 'trigger', false) end
    end,
    onShopExit = function(joker, state, step, result)
      if step.copiedBy or AIJ.get(joker, 'trigger') ~= true then return end
      AIJ.set(joker, 'trigger', false)
      local x = AIJ.add(joker, 'xmult', AIJ.num(joker, 'xmult_mod'))
      result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

cardlike.filter('chance', function(p)
  local state = cardlike.state
  if not state or (type(p) ~= 'number' and type(p) ~= 'boolean') then return nil end
  local docs = owned('design_document')
  if #docs == 0 then return nil end
  local win = p
  if type(p) == 'number' then win = state:randomFloat() <= p end
  if not win then
    for _, d in ipairs(docs) do
      local n = AIJ.num(d, 'money')
      state:mutateMoney(n)
      d:popup('+$' .. AIJ.fmt(n), colors.MONEY)
    end
  end
  return win
end)

