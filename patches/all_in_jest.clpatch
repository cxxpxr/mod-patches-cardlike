local function errorValid(joker)
  local out = {}
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if not AIJ.is(j, 'error_404') and copyableDef(j, joker) then out[#out + 1] = j end
  end
  return out
end

local function errorPick(joker, state)
  local j = AIJ.pick(errorValid(joker), state)
  if j then AIJ.set(joker, 'currently_copied', tostring(j.uid)) end
  return j
end

add {
  key = 'error_404',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 18, y = 14 },
  config = { currently_copied = '0' },
  description = withNote('error_404', function(card)
    local t = card and jokerByUid(AIJ.get(card, 'currently_copied'))
    return { t and jokerName(AIJ.defId(t)) or 'None' }
  end, '(All in Jest Jokers only)'),
  onAdded = function(joker, state)
    if errorPick(joker, state) then joker:popup(AIJ.msg('k_aij_change_ex', 'Change!'), colors.ORANGE) end
  end,
  triggers = copierTriggers(function(joker)
    local t = jokerByUid(AIJ.get(joker, 'currently_copied'))
    local def = copyableDef(t, joker)
    if not def or AIJ.is(t, 'error_404') then return {} end
    return { { card = t, def = def } }
  end, {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      if errorPick(joker, state) then result:say(AIJ.msg('k_aij_change_ex', 'Change!'), colors.ORANGE) end
    end,
  }),
}

AIJ.onNewRun(function(run) run.eulenspiegel_ante = 0 end)
cardlike.filter('anteChange', function(step)
  local n = tonumber(AIJ.run.eulenspiegel_ante) or 0
  if n <= 0 or type(step) ~= 'number' then return nil end
  AIJ.run.eulenspiegel_ante = 0
  return step - n
end)

local function eulenDebuff()
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if AIJ.is(j, 'eulenspiegel') and AIJ.get(j, 'aij_disabled') == true and not AIJ.isDebuffed(j) then
      j:setDebuffState(true)
    end
  end
end
cardlike.on('onRoundStart', eulenDebuff)
cardlike.on('onShopEnter', eulenDebuff)
cardlike.on('onHandDrawn', eulenDebuff)

add {
  key = 'eulenspiegel',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 2, y = 2 }, soul_pos = { x = 2, y = 3 },
  config = { Xmult = 1, Xmult_mod = 0.25, ante_mod = 1 },
  vars = function(card)
    return { AIJ.val(card, 'eulenspiegel', 'ante_mod'), AIJ.val(card, 'eulenspiegel', 'Xmult_mod'),
      AIJ.val(card, 'eulenspiegel', 'Xmult') }
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local ante = AIJ.num(joker, 'ante_mod')
      AIJ.run.eulenspiegel_ante = (tonumber(AIJ.run.eulenspiegel_ante) or 0) + ante
      result:say(msg('a_aij_ante_minus', '-#1# Ante', AIJ.fmt(ante)), colors.ORANGE)
      local x, mod = AIJ.num(joker, 'Xmult'), AIJ.num(joker, 'Xmult_mod')
      if x - mod <= 0 then
        AIJ.set(joker, 'aij_disabled', true)
        joker:setDebuffState(true)
        result:say('Disabled!', colors.RED)
      else
        AIJ.set(joker, 'Xmult', x - mod)
        result:say('-X' .. AIJ.fmt(mod) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      result:add(xMult(AIJ.num(joker, 'Xmult')))
    end,
  },
}


