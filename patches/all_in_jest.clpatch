local FAMILY_PINS = {
  Common = function() return AIJ.vanilla('tag_top_up') end,
  Uncommon = function() return AIJ.vanilla('tag_uncommon') end,
  Rare = function() return AIJ.vanilla('tag_rare') end,
  Legendary = function() return AIJ.has('soulbound', 'pin') and AIJ.id('soulbound') or nil end,
}

local function familyRight(state, card)
  local jokers = ofList(state, 'jokers')
  local i = indexOf(jokers, card)
  return i and jokers[i + 1] or nil
end

AIJ.addJoker {
  key = 'family_tree',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 26 },
  config = {},
  vars = function(card)
    local state = cardlike.state
    local right = card and state and familyRight(state, card)
    local rarity = right and rarityOf(right)
    local pin = rarity and FAMILY_PINS[rarity] and FAMILY_PINS[rarity]()
    if pin then
      local info = cardlike.contentInfo('pin', pin)
      return { info and info.name or pin, colours = { RARITY_COLORS[rarity] } }
    end
    return { 'None', colours = { colors.GREY } }
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if not isBoss(state) then return end
      local right = familyRight(state, step.copiedBy or joker)
      local rarity = right and rarityOf(right)
      local pin = rarity and FAMILY_PINS[rarity] and FAMILY_PINS[rarity]()
      if pin then
        cardlike.addPin(pin)
        result:say(AIJ.msg('aij_plus_tag', '+1 Pin'), colors.ORANGE)
      end
    end,
  },
}

