  return type(R) == 'table' and R.key == 'the_real' and not R.fresh and not R.over and not R.disabledDone
end)
cardlike.filter('isFace', function(v, card)
  local state = cardlike.state
  if not state or type(state.blind) ~= 'table' then return nil end
  local spec = B.live(state)
  if not spec or spec.key ~= 'the_real' or type(card) ~= 'table' then return nil end
  local r = B.rank(card)
  return r ~= nil and r >= 11 and r <= 13
end)

