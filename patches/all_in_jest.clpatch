AIJ.addJoker {
  key = 'prisoners_cinema',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 20 },
  config = { boosters = 1 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.val(card, 'prisoners_cinema', 'boosters') } end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      AIJ.run.cinema_free = AIJ.run.cinema_free or {}
      local free = AIJ.run.cinema_free
      for _ = 1, AIJ.num(joker, 'boosters') do
        local packs = {}
        for _, c in ipairs(state.shopCards or {}) do
          if c.lastInfo and c.lastInfo.kind == 'pack' and not free[tostring(c.uid)] and (c:getBuyValue() or 0) > 0 then
            packs[#packs + 1] = c
          end
        end
        local pick = AIJ.pick(packs, state)
        if pick then
          free[tostring(pick.uid)] = true
          pick:punch()
          result:say('Free Pack!', colors.ORANGE)
        end
      end
    end,
    onShopExit = function(joker, state, step, result)
      AIJ.run.cinema_free = {}
    end,
  },
}

AIJ.addJoker {
  key = 'profile',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 2, y = 38 },
  config = { mult = 5 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.val(card, 'profile', 'mult') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      local list = step.hand.playedCards or {}
      local i = indexOf(list, step.card)
      if not i then return end
      local l, r = list[i - 1], list[i + 1]
      if (l and l:isFace()) or (r and r:isFace()) then result:add(plusMult(AIJ.num(joker, 'mult'))) end
    end,
  },
}

local function mostCommonSuit(state)
  local counts, best, bestN = {}, nil, 0
  for _, c in ipairs((state and state.allCards) or {}) do
    if not AIJ.noRank(c) then
      local s = c:getSuit()
      if s then counts[s] = (counts[s] or 0) + 1 end
    end
  end
  for _, s in ipairs(AIJ.SUITS) do
    if (counts[s] or 0) > bestN then best, bestN = s, counts[s] end
  end
  for s, n in pairs(counts) do
    if n > bestN then best, bestN = s, n end
  end
  return best
end

AIJ.addJoker {
  key = 'propaganda',
  rarity = 2, cost = 5, atlas = 'joker_atlas', pos = { x = 15, y = 14 },
  config = { mult = 5 },
  blueprint_compat = true,
  vars = function(card)
    return { (card and mostCommonSuit(cardlike.state)) or 'None', AIJ.val(card, 'propaganda', 'mult') }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local suit = mostCommonSuit(state)
      if suit and step.card:isSuit(suit) then result:add(plusMult(AIJ.num(joker, 'mult'))) end
    end,
  },
}

local function lastDeckCard(state)
  local deck = state and state.unDrawnCards
  return deck and deck[1] or nil
end

AIJ.addJoker {
  key = 'protophanes',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 24, y = 46 }, soul_pos = { x = 3, y = 47 },
  config = { xmult = 1.5 },
  blueprint_compat = true,
  description = function(r)
    local card = r and r.card
    local text = AIJ.fill(AIJ.loc('Joker', 'j_aij_protophanes').text, { AIJ.val(card, 'protophanes', 'xmult') })
    text = text:gsub('(deck%[/b%]%[/color%]) ', '%1\n', 1)
    local c = inJokers(card) and lastDeckCard(cardlike.state)
    if c then text = text .. '\n' .. grey('(Last card: ') .. hl(cardName(c)) .. grey(')') end
    return text
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local last = lastDeckCard(state)
      if not last or AIJ.noRank(last) or AIJ.noRank(step.card) then return end
      if step.card:getRank() == last:getRank() then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

AIJ.addJoker {
