if FANTASIO then
  AIJ.allSuitsIf(function(state) return AIJ.owns(FANTASIO, state) end)
  local SUIT_BOSSES = { ['The Clover'] = true, ['The Greed'] = true, ['The Malice'] = true, ['The Soul'] = true }
  cardlike.filter('bossBlind', function(id)
    local state = cardlike.state
    if not state or not SUIT_BOSSES[id] or not state:hasJoker(FANTASIO) then return nil end
    local pool = {}
    for _, b in ipairs(cardlike.listContent('blind') or {}) do
      if b.boss and not b.finisher and not SUIT_BOSSES[b.id] and (b.minAnte or 1) <= (state.ante or 1) then
        pool[#pool + 1] = b.id
      end
    end
    return AIJ.pick(pool, state)
  end)
end

