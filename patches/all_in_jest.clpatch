AIJ.addJoker {
  key = 'joculator',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 17, y = 6 },
  config = { hand_amount = 1 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'joculator', 'hand_amount', 1) } end,
  triggers = {
    onHandDrawn = function(joker, state, step, result)
      if step.copiedBy then return end
      if (state.discardsLeft or 0) ~= 0 or state.handsLeft ~= AIJ.num(joker, 'hand_amount') then return end
      if AIJ.get(joker, 'drawn_round') == state.round then return end
      local n = math.min(state.handSize or 0, #(state.unDrawnCards or {}))
      if n <= 0 then return end
      AIJ.set(joker, 'drawn_round', state.round)
      cardlike.drawCards(math.min(52, n))
      result:say('Draw!', colors.ORANGE)
    end,
  },
}

