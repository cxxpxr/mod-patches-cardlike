AIJ.addJoker {
  key = 'lemarchand_cube',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 16, y = 13 }, lite = true,
  config = { tarots_used = 0, tarots_total = 5 },
  vars = function(card)
    return { AIJ.val(card, 'lemarchand_cube', 'tarots_used'), AIJ.val(card, 'lemarchand_cube', 'tarots_total') }
  end,
  triggers = {
    onConsumableUsed = function(joker, state, step, result)
      local used = step.card
      if consType(used) ~= 'game' then return end
      if not step.copiedBy then AIJ.add(joker, 'tarots_used', 1) end
      local count, total = AIJ.num(joker, 'tarots_used'), AIJ.num(joker, 'tarots_total')
      if count >= total then
        AIJ.set(joker, 'tarots_used', 0)
        if consumableRoom(state, used) > 0 and cardlike.createConsumable('admin', { force = true }) then
          result:say('+Admin', AIJ.colors.SPECTRAL)
        end
      elseif not step.copiedBy then
        result:say(AIJ.fmt(count) .. '/' .. AIJ.fmt(total))
      end
    end,
  },
}

local function plainText(text)
  text = tostring(text or '')
  text = text:gsub('%[color="[^"]*"%]', ''):gsub('%[/color%]', ''):gsub('%[/?b%]', '')
  return text
end

local function jokerText(card)
  local id = AIJ.defId(card)
  local def = id and AIJ.jokerDefs and AIJ.jokerDefs[id]
  if not def then return '' end
  local d = def.description
  if type(d) == 'function' then return AIJ.safe(d, { card = card }) or '' end
  return tostring(d or '')
end

local function lexiconMult(self, state)
  state = state or cardlike.state
  if not state or not state.jokers then return 0 end
  local mult = 0
  for _, j in ipairs(state.jokers) do
    if j ~= self and not AIJ.is(j, 'lexicon') and not AIJ.is(j, 'crayon_rubbing') then
      for d in plainText(jokerText(j)):gmatch('%d') do mult = mult + tonumber(d) end
    end
  end
  return mult
end

