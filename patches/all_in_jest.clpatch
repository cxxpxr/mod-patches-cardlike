  config = { mult = 4 },
  vars = function(card) return { AIJ.val(card, 'dendroglyph', 'mult') } end,
  in_pool = function(state)
    for _, c in ipairs(state and state.allCards or {}) do
      if AIJ.hasEnhancement(c, 'wood') then return true end
    end
    return false
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if not AIJ.hasEnhancement(step.card, 'wood') then return end
      local woods = 0
