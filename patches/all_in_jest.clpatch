AIJ.addJoker {
  key = 'skinsuit',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 24, y = 13 },
  blueprint_compat = false,
  triggers = {
    destroyCard = function(joker, state, step, result)
      if step.copiedBy or #(step.hand.allCards or {}) ~= 1 or (state.handsPlayed or 0) > 1 then return end
      local c = step.card
      if not AIJ.noRank(c) then
        local suit = c:getSuit()
        local targets = {}
        for _, h in ipairs(state.cardsInHand or {}) do
          if h:getSuit() ~= suit and not AIJ.hasPatch(h, suit) then targets[#targets + 1] = h end
        end
        local t = AIJ.pick(targets, state)
        if t and AIJ.addPatch(t, suit) then
          t:popup(suit, AIJ.SUIT_COLORS[suit] or colors.ORANGE)
          joker:punch()
        end
      end
      return true
    end,
  },
}

local function deckEditions() return deckCount(function(c) return AIJ.edition(c) ~= nil end) end

