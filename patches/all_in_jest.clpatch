    local t = card and elderTarget(card)
    return { t and jokerName(AIJ.defId(t)) or 'None' }
  end, '(All in Jest Jokers only)'),
  triggers = copierTriggers(function(joker)
    local t = elderTarget(joker)
    local def = copyableDef(t, joker)
    if not def then return {} end
    return { { card = t, def = def } }
  end),
}

