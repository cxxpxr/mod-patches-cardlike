    ["j_aij_bottle_opener"] = { name = "Bottle Opener", text = "" },
    ["j_aij_bouffon"] = { name = "Bouffon", text = "Trigger the [color=\"#f3a712\"][b]held in hand[/b][/color] effects of the top [color=\"#f3a712\"][b]#1#[/b][/color] cards [color=\"#f3a712\"][b]remaining[/b][/color] in your deck" },
    ["j_aij_bowls_of_joy"] = { name = "Bowls of Joy", text = "When [color=\"#1bb18c\"][b]rerolling[/b][/color] in the [color=\"#f3a712\"][b]Shop[/b][/color], [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to gain [color=\"#f3a712\"][b]sell value[/b][/color] equal to the cost of [color=\"#1bb18c\"][b]rerolling[/b][/color]" },
    ["j_aij_boy_scout"] = { name = "Boy Scout", text = "" },
