  for _, c in ipairs(step.cards or {}) do
    if (c.lastInfo and c.lastInfo.enhancement == 'Fragile') or AIJ.hasEnhancement(c, 'm_glass') then
      for _, j in ipairs(owned(state, 'peanut_brittle')) do
        if AIJ.exists(j) then loseXmult(j, false) end
      end
    end
  end
end)

