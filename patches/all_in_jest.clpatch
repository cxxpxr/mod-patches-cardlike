cardlike.filter('price', function(price, card)
  local state = cardlike.state
  if type(card) ~= 'table' or not state or not state.isPhase or not state:isPhase('shop') then return nil end
  local info = card.lastInfo or {}
  if info.kind == 'ticket' or info.area ~= 'shop' then return nil end
  if #owned('archy') == 0 then return nil end
  local free = AIJ.run.archy_free or {}
  if free[tostring(card.uid)] or (state.rerollsThisShop or 0) == 0 then return 0 end
