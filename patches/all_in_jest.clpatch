    ["tag_aij_circumplanetary"] = { name = "Circumplanetary Pin", text = "Upgrade [color=\"#f3a712\"][b]most played[/b][/color] [color=\"#f3a712\"][b]poker hand[/b][/color] by [color=\"#f3a712\"][b]#1# levels[/b][/color]\n[color=\"#9a9a9a\"](Currently #2#)[/color]" },
