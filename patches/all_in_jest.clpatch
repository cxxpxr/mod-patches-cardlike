local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')

local function pickText(key, pick, shown)
  local e = AIJ.loc('Other', key) or {}
  return e.name, AIJ.fill(e.text or '', { pick, shown })
end

local function addPack(def)
  local name, text = pickText(def.textKey, 1, def.shown)
  return AIJ.register('addPack', {
    id = def.key,
    readableName = def.name or name or def.key,
    description = def.description or text,
    sprite = def.pos and AIJ.sprite('booster_atlas', def.pos) or nil,
    price = def.price,
    cardsShown = def.shown,
    shopWeight = def.weight or 0,
    kind = def.kind,
    opensDeck = def.opensDeck,
    getCards = def.getCards,
    lite = def.lite,
  }, 'pack')
end

local ROWS = { common = 2, uncommon = 1, rare = 5 }
local RARITY = { common = 'Common', uncommon = 'Uncommon', rare = 'Rare' }
for kind, row in pairs(ROWS) do
  local variants = {
    { 'normal_1', 0, 4, 2 }, { 'normal_2', 1, 4, 2 }, { 'normal_3', 2, 4, 2 },
    { 'jumbo_1', 3, 6, 4 }, { 'jumbo_2', 4, 6, 4 }, { 'mega_1', 5, 8, 4 },
  }
  for _, v in ipairs(variants) do
    local key = kind .. '_' .. v[1]
    addPack {
      key = key, textKey = 'p_aij_' .. key, pos = { x = v[2], y = row }, price = v[3], shown = v[4], kind = 'fool',
      getCards = function(state, count)
        local out = {}
        for i = 1, count do out[i] = { jokerRarity = RARITY[kind] } end
        return out
      end,
    }
  end
end

local function astralCards(state, count)
  local out = {}
  local t = AIJ.has('astral', 'consumableType') and AIJ.id('astral') or 'fruit'
  for i = 1, count do out[i] = { consumableType = t } end
  return out
end
for i = 1, 4 do
  addPack { key = 'sidereal_normal_' .. i, textKey = 'p_aij_sidereal', pos = { x = i - 1, y = 3 }, price = 4, shown = 2,
    weight = 5 / 4, kind = 'fruit', opensDeck = true, getCards = astralCards }
end
for i = 1, 2 do
  addPack { key = 'sidereal_jumbo_' .. i, textKey = 'p_aij_sidereal', pos = { x = i - 1, y = 4 }, price = 6, shown = 4,
    weight = 3 / 2, kind = 'fruit', opensDeck = true, getCards = astralCards }
  addPack { key = 'sidereal_mega_' .. i, textKey = 'p_aij_sidereal', pos = { x = i + 1, y = 4 }, price = 8, shown = 4,
    weight = 1 / 2, kind = 'fruit', opensDeck = true, getCards = astralCards }
end

local function legendaries(state, count)
  local out = {}
  for i = 1, count do out[i] = { jokerRarity = 'Legendary' } end
  return out
end
addPack { key = 'guess_the_jest', textKey = 'p_aij_guess_the_jest', pos = { x = 0, y = 0 }, price = 20, shown = 4,
  weight = 0.5, kind = 'fool', getCards = legendaries,
  description = 'Choose [color="#f3a712"][b]1[/b][/color] of [color="#f3a712"][b]4[/b][/color] [color="#d138bf"][b]Legendary[/b][/color] Jokers' }

addPack { key = 'timelost_guess_the_jest', pos = { x = 0, y = 0 }, price = 0, shown = 4, kind = 'fool',
  name = 'Guess the Jest Pack', getCards = legendaries,
  description = 'Choose [color="#f3a712"][b]1[/b][/color] of [color="#f3a712"][b]4[/b][/color] [color="#f3a712"][b]Timed[/b][/color] [color="#d138bf"][b]Legendary[/b][/color] Jokers' }

local timelostOpen = false
cardlike.on('onPackOpened', function(state, step)
  timelostOpen = AIJ.is(step.card, 'timelost_guess_the_jest')
end)
cardlike.on('onCardObtained', function(state, step)
  local c = step.card
  if timelostOpen and c and (c.lastInfo or {}).kind == 'joker' and state:isPhase('pack') then c:setSticker('timed') end
end)
cardlike.on('onShopExit', function() timelostOpen = false end)
cardlike.on('onRoundStart', function() timelostOpen = false end)

addPack { key = 'asteroid_tag_celestial', price = 0, shown = 4, kind = 'fruit',
  name = 'Fruit Pack',
  description = 'Choose [color="#f3a712"][b]1[/b][/color] of [color="#4584fa"][b]UPDATE[/b][/color], [color="#4584fa"][b]Gravastar[/b][/color] and [color="#4584fa"][b]Pulsar[/b][/color]',
  getCards = function(state, count)
    local ids = { 'admin_card_16', 'gravastar', 'pulsar', 'admin_card_16' }
    local out = {}
    for i = 1, count do
      local id = ids[(i - 1) % #ids + 1]
      if id:sub(1, 6) ~= 'admin_' then id = AIJ.has(id, 'consumable') and AIJ.id(id) or 'admin_card_16' end
      out[i] = { consumable = id }
    end
    return out
  end }


