    ["j_aij_constable"] = { name = "Constable", text = "" },
    ["j_aij_cool_joker"] = { name = "Cool Joker", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] [color=\"#V1#\"][b]Activate[/b][/color] this [color=\"#f3a712\"][b]Joker[/b][/color] when it would [color=\"#f3a712\"][b]normally[/b][/color] score for [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_copper"] = { name = "Copper", text = "If played hand is [color=\"#f3a712\"][b]Three of a Kind[/b][/color], retrigger all scoring cards" },
    ["j_aij_copycat"] = { name = "Copycat", text = "After [color=\"#f3a712\"][b]#2#[/b][/color] rounds, [color=\"#f3a712\"][b]sell[/b][/color] this card to create a random [color=\"#f3a712\"][b]copy Joker[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"]/#2#)[/color]" },
    ["j_aij_cordyceps"] = { name = "Cordyceps", text = "" },
    ["j_aij_corndog"] = { name = "Corndog", text = "The next [color=\"#f3a712\"][b]#1#[/b][/color] hands are [color=\"#f3a712\"][b]scored[/b][/color] as and [color=\"#f3a712\"][b]considered[/b][/color] to be [color=\"#f3a712\"][b]Straight Flush[/b][/color] regardless of what cards are [color=\"#f3a712\"][b]played[/b][/color]" },
    ["j_aij_corny_joker"] = { name = "Corny Joker", text = "" },
    ["j_aij_corporate_memphis"] = { name = "Corporate Memphis", text = "When Blind is [color=\"#f3a712\"][b]skipped[/b][/color], the next [color=\"#f3a712\"][b]Shop[/b][/color] gains [color=\"#f3a712\"][b]+#1# Shop Slots[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Shop Slots)[/color]" },
    ["j_aij_corpse_paint"] = { name = "Corpse Paint", text = "Removes [color=\"#5d5dff\"][b]Inverted[/b][/color] from scored cards. For each, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance this Joker gains [color=\"#f3a712\"][b]+#3# hand size[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#4#[/b][/color][color=\"#9a9a9a\"] hand size)[/color]" },
    ["j_aij_coryat"] = { name = "Coryat", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Shop Slots [color=\"#f3a712\"][b]+#2#[/b][/color] Booster Slots [color=\"#f3a712\"][b]+#3#[/b][/color] Ticket Slot" },
    ["j_aij_cosmological_constant"] = { name = "Cosmological Constant", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#f3a712\"][b]base[/b][/color] [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] of played [color=\"#f3a712\"][b]poker hand[/b][/color]" },
    ["j_aij_cosmonaut"] = { name = "Cosmonaut", text = "" },
    ["j_aij_coulrorachne"] = { name = "Coulrorachne", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult every [color=\"#f3a712\"][b]#4# [/b][/color][color=\"#9a9a9a\"][#3#][/color] scored [color=\"#f3a712\"][b]8s[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_courier"] = { name = "Courier", text = "" },
    ["j_aij_crab_in_a_bucket"] = { name = "Crab in a Bucket", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points per card above [color=\"#f3a712\"][b]#2#[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#3#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_cracked_up"] = { name = "Cracked Up", text = "" },
    ["j_aij_crapple_apple"] = { name = "Crapple Apple", text = "" },
    ["j_aij_crayon_rubbing"] = { name = "Crayon Rubbing", text = "Adds [color=\"#3772ff\"][b]Points[/b][/color] equal to the combined [color=\"#f3a712\"][b]numerical[/b][/color] [color=\"#f3a712\"][b]values[/b][/color] of the [color=\"#f3a712\"][b]Joker[/b][/color] to the [color=\"#f3a712\"][b]right[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_creative_commons"] = { name = "Creative Commons", text = "" },
    ["j_aij_crop_circle"] = { name = "Crop Circle", text = "Add a [color=\"#f3a712\"][b]random enhancement[/b][/color] to [color=\"#f3a712\"][b]#1# random[/b][/color] card held in hand when a [color=\"#13afce\"][b]Fruit[/b][/color] card is used" },
    ["j_aij_croupier"] = { name = "Croupier", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] if final score is over [color=\"#f3a712\"][b]twice[/b][/color] the blind requirement" },
    ["j_aij_crypto_trader"] = { name = "Crypto Trader", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to multiply [color=\"#f3a712\"][b]Interest[/b][/color] by [color=\"#f3a712\"][b]#3#[/b][/color]; Else, earn no [color=\"#f3a712\"][b]Interest[/b][/color]" },
    ["j_aij_cubewano"] = { name = "Cubewano", text = "" },
    ["j_aij_cubic_joker"] = { name = "Cubic Joker", text = "" },
    ["j_aij_curse_of_scotland"] = { name = "Curse of Scotland", text = "If [color=\"#f3a712\"][b]first hand[/b][/color] of round is exactly [color=\"#f3a712\"][b]one[/b][/color] card, turn it into a [color=\"#f3a712\"][b]9 of[/b][/color] [color=\"#204887\"][b]Diamonds[/b][/color]" },
    ["j_aij_cut_here"] = { name = "Cut Here", text = "When this Joker is [color=\"#ff007f\"][b]destroyed[/b][/color], create a random [color=\"#ff007f\"][b]Rare[/b][/color] Joker" },
    ["j_aij_cutesy_joker"] = { name = "Cutesy Joker", text = "[color=\"#1bb18c\"][b]Probabilities[/b][/color] on [color=\"#f3a712\"][b]consumables[/b][/color] are [color=\"#f3a712\"][b]guaranteed[/b][/color]" },
    ["j_aij_cutting_board"] = { name = "Cutting Board", text = "" },
    ["j_aij_cyclops"] = { name = "Cyclops", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]first hand[/b][/color] of round is exactly [color=\"#f3a712\"][b]one[/b][/color] card\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_cytherean_joker"] = { name = "Cytherean Joker", text = "" },
    ["j_aij_czar"] = { name = "Czar", text = "This Joker copies the ability of a random discovered [color=\"#f3a712\"][b]Joker[/b][/color] from your [color=\"#f3a712\"][b]collection[/b][/color], copied Joker [color=\"#f3a712\"][b]changes[/b][/color] when the shop is [color=\"#1bb18c\"][b]rerolled[/b][/color]" },
    ["j_aij_dacosta"] = { name = "D'acosta", text = "Copies the abilities of [color=\"#f3a712\"][b]both[/b][/color] adjacent Jokers" },
    ["j_aij_dandiprat"] = { name = "Dandiprat", text = "Scoring [color=\"#f3a712\"][b]2s[/b][/color], [color=\"#f3a712\"][b]3s[/b][/color], [color=\"#f3a712\"][b]4s[/b][/color], and [color=\"#f3a712\"][b]5s[/b][/color] earn [color=\"#f3a712\"][b]$#1#[/b][/color] when scored" },
    ["j_aij_dapper_dan"] = { name = "Dapper Dan", text = "Increases Joker [color=\"#f3a712\"][b]edition[/b][/color] effects by [color=\"#f3a712\"][b]100%[/b][/color]\n[color=\"#9a9a9a\"](Except Inverted)[/color]" },
    ["j_aij_dark_angel"] = { name = "Dark Angel", text = "" },
    ["j_aij_dark_magician"] = { name = "Dark Magician", text = "[color=\"#d138bf\"][b]Game[/b][/color] Cards, [color=\"#13afce\"][b]Fruit[/b][/color] Cards, and [color=\"#4584fa\"][b]Admin[/b][/color] Cards are [color=\"#f3a712\"][b]considered[/b][/color] the same" },
    ["j_aij_dark_presence"] = { name = "Dark Presence", text = "Retrigger the [color=\"#f3a712\"][b]held in[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] effects of [color=\"#f3a712\"][b]face[/b][/color] [color=\"#f3a712\"][b]cards #1#[/b][/color] additional times\n[color=\"#f3a712\"][b]Face cards[/b][/color] cannot be played" },
    ["j_aij_david"] = { name = "David", text = "This Joker gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points if [color=\"#f3a712\"][b]played hand[/b][/color] is only [color=\"#e5e5e5\"][b]Spade[/b][/color] [color=\"#f3a712\"][b]Kings[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_de_acedo"] = { name = "de Acedo", text = "" },
