local SUIT_ORDER = { 'Spades', 'Hearts', 'Clubs', 'Diamonds' }
B.add {
  key = 'the_auroch', min = 3, colour = '7a7f89', y = 35,
  description = 'All cards of the most common suit and the most common rank in your deck are drawn face down',
  start = function(state, R)
    local suits, ranks = {}, {}
    for _, c in ipairs(state.allCards or {}) do
      local i = info(c)
      if i.suit then suits[i.suit] = (suits[i.suit] or 0) + 1 end
      local r = B.rank(c)
      if r then ranks[r] = (ranks[r] or 0) + 1 end
    end
    local bs, bn = 'Spades', -1
    for _, s in ipairs(SUIT_ORDER) do if (suits[s] or 0) > bn then bs, bn = s, suits[s] or 0 end end
    local br, brn = 14, -1
    for r = 14, 2, -1 do if (ranks[r] or 0) > brn then br, brn = r, ranks[r] or 0 end end
    R.suit, R.rank = bs, br
    B.say('The Auroch: ' .. bs .. ' and ' .. AIJ.rankName(br) .. 's')
  end,
  faceDown = function(c, state, R)
    local i = info(c)
    return (R.suit ~= nil and i.suit == R.suit) or (R.rank ~= nil and B.rank(c) == R.rank)
  end,
}

