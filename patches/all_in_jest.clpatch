}

local function mostPlayedHand(state)
  if not state then return nil end
  local id = state.mostPlayedHand
  local h = id and state:getHand(id)
  if h and (h.played or 0) >= 1 then return id end
  return nil
end

AIJ.addJoker {
  key = 'paracosm',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 11 },
  config = { levels = 2 },
  blueprint_compat = true,
  vars = function(card)
    local mp = card and mostPlayedHand(cardlike.state)
    return { AIJ.val(card, 'paracosm', 'levels'), mp and AIJ.handName(mp) or 'None' }
  end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      local mp = mostPlayedHand(state)
      if not mp then return end
      state:upgradeHand(mp, AIJ.num(joker, 'levels'))
      result:say('Upgrade!', colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
  key = 'parfait',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 3, y = 40 },
  config = { xmult_gain = 0.5, odds = 10 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'parfait', 'odds'), AIJ.val(card, 'parfait', 'xmult_gain') } end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then
        local i = joker:getIndex()
        local right = i and state.jokers[i + 1]
        if right then
          AIJ.permaAdd(right, 'x_mult', AIJ.num(joker, 'xmult_gain'))
          right:popup('Upgrade!', colors.MULT)
        end
        result:say('Melted!', colors.ORANGE)
        result:destroySelf()
      else
        result:say('Safe!', colors.ORANGE)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'parking_space',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 0, y = 16 },
  config = { xmult = 2, target_slot = 1 },
