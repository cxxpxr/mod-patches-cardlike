== file main.lua (22 lines)
local AIJ = cardlike.require('lib.aij')

local function load(dir, names)
  for _, name in ipairs(names) do
    if cardlike.fileInfo(cardlike.modPath() .. dir .. '/' .. name .. '.lua') then
      cardlike.require(dir .. '.' .. name)
    end
  end
end

load('items', { 'types', 'enhancements', 'editions', 'stamps', 'stickers', 'tarots', 'spectrals', 'planets',
  'astrals', 'pins', 'gold_pins', 'tickets', 'packs', 'blinds_boss', 'blinds_pit', 'blinds_finisher',
  'decks', 'stakes', 'challenges', 'patches', 'settings' })

local batches = {}
for i = 1, 20 do batches[i] = string.format('batch%02d', i) end
load('jokers', batches)

cardlike.onLoaded(function()
  cardlike.log('All in Jest: ' .. #AIJ.jokers .. ' jokers')
end)


