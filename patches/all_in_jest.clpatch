AIJ.addJoker {
  key = 'pog',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 4, y = 17 },
  config = {},
  blueprint_compat = false,
  description = function(r)
    local text = AIJ.loc('Joker', 'j_aij_pog').text:gsub('booster pack', 'Pack')
    local pin = AIJ.run.pog_pin
    if r and r.card and pin and cardlike.state and cardlike.state.phase == 'pack' then
      local info = cardlike.contentInfo('pin', pin)
      text = text .. '\n' .. grey('(This pack: ') .. hl(info and info.name or pin) .. grey(')')
    end
    return text
  end,
  triggers = {
    onPackOpened = function(joker, state, step, result)
      if step.copiedBy or not step.card then return end
      if AIJ.run.pog_pack == step.card.uid then return end
      local pin = cardlike.randomPin()
      if not pin then return end
      AIJ.run.pog_pack = step.card.uid
      AIJ.run.pog_pin = pin
      local info = cardlike.contentInfo('pin', pin)
      result:say('Skip: ' .. (info and info.name or 'Pin'), colors.ORANGE)
    end,
    onPackSkipped = function(joker, state, step, result)
      if step.copiedBy or not step.card or AIJ.run.pog_pack ~= step.card.uid or not AIJ.run.pog_pin then return end
      cardlike.addPin(AIJ.run.pog_pin)
      AIJ.run.pog_pin = nil
      AIJ.run.pog_pack = nil
      result:say('+1 Pin', colors.ORANGE)
    end,
  },
}

