    ["j_aij_silent_sam"] = { name = "Silent Sam", text = "Each [color=\"#f3a712\"][b]card[/b][/color] held in hand gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_silly_billy"] = { name = "Silly Billy", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]enhancement[/b][/color], [color=\"#f3a712\"][b]stamp[/b][/color], and [color=\"#f3a712\"][b]edition[/b][/color] in played hand" },
    ["j_aij_silly_sausage"] = { name = "Silly Sausage", text = "[color=\"#1bb18c\"][b]Rerolls[/b][/color] cost [color=\"#f3a712\"][b]$#1#[/b][/color] less [color=\"#f3a712\"][b]Decreases[/b][/color] by [color=\"#f3a712\"][b]$#2#[/b][/color] after leaving shop" },
    ["j_aij_silver"] = { name = "Silver", text = "If played hand is [color=\"#f3a712\"][b]Full House[/b][/color], retrigger all scoring cards" },
    ["j_aij_silver_screen"] = { name = "Silver Screen", text = "When a [color=\"#f3a712\"][b]face[/b][/color] card is [color=\"#ff007f\"][b]destroyed[/b][/color], add [color=\"#a9b6c6\"][b]Silver[/b][/color] to a random card in [color=\"#f3a712\"][b]hand[/b][/color]" },
    ["j_aij_silvio"] = { name = "Silvio", text = "Retrigger all [color=\"#f3a712\"][b]Kings[/b][/color] once for each [color=\"#f3a712\"][b]Queen[/b][/color] held in hand" },
