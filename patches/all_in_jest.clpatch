    ["j_aij_antonio"] = { name = "Antonio", text = "When a card is [color=\"#f3a712\"][b]scored[/b][/color], all cards in full deck with matching [color=\"#f3a712\"][b]rank[/b][/color] permanently gain [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_aphantasia"] = { name = "Aphantasia", text = "All played [color=\"#f3a712\"][b]enhanced[/b][/color] cards become [color=\"#ff007f\"][b]Chaotic[/b][/color]" },
    ["j_aij_aphi_credits_joker"] = { name = "Aphi", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
