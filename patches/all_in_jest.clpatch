local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')

local function addTicket(def)
  local e = AIJ.loc('Voucher', 'v_aij_' .. def.key) or {}
  local full = AIJ.register('addTicket', {
    id = def.key,
    readableName = e.name or def.key,
    description = def.description or AIJ.desc('Voucher', 'v_aij_' .. def.key, def.vars),
    sprite = AIJ.sprite('vouchers_atlas', def.pos),
    price = def.price or 10,
    precursor = def.precursor and AIJ.id(def.precursor) or nil,
    action = def.action,
    lite = def.lite,
  }, 'ticket')
  if full and def.precursor then H.ticketPrecursor[full] = AIJ.id(def.precursor) end
  return full
end

local function owns(state, key) return state and state.hasTicket and state:hasTicket(AIJ.id(key)) end

local RARITY_PACKS = {
  common = { 'common_normal_1', 'common_normal_2', 'common_normal_3', 'common_jumbo_1', 'common_jumbo_2', 'common_mega_1' },
  uncommon = { 'uncommon_normal_1', 'uncommon_normal_2', 'uncommon_normal_3', 'uncommon_jumbo_1', 'uncommon_jumbo_2', 'uncommon_mega_1' },
}
local RARITY_WEIGHTS = { 1.2, 1.2, 1.2, 0.6, 0.6, 0.15 }

local function weightedPack(state, ids, weights)
  local total = 0
  for i in ipairs(ids) do total = total + weights[i] end
  local r = state:randomFloat() * total
  for i, id in ipairs(ids) do
    r = r - weights[i]
    if r <= 0 then return id end
  end
  return ids[1]
end

local function rarityPack(state, rarity)
  return AIJ.id(weightedPack(state, RARITY_PACKS[rarity], RARITY_WEIGHTS))
end

local function gamePack(state)
  return weightedPack(state, { H.builtinPack('game', 0), H.builtinPack('game', 1), H.builtinPack('game', 2) }, { 4, 2, 0.5 })
end

local function inShop(state) return state and state.isPhase and state:isPhase('shop') end

addTicket { key = 'common_caste', pos = { x = 4, y = 1 },
  action = function(ctx) if inShop(ctx.state) then cardlike.addShopItem(rarityPack(ctx.state, 'common')) end end }
addTicket { key = 'upper_class', pos = { x = 5, y = 1 }, precursor = 'common_caste',
  action = function(ctx) if inShop(ctx.state) then cardlike.addShopItem(rarityPack(ctx.state, 'uncommon')) end end }
addTicket { key = 'thaumaturgy', pos = { x = 3, y = 1 }, precursor = 'embraced_arcane',
  description = '[color="#f3a712"][b]Adds[/b][/color] an additional random [color="#d138bf"][b]Game Pack[/b][/color] to every [color="#f3a712"][b]shop[/b][/color]' }

cardlike.on('onShopEnter', function(state)
  if owns(state, 'common_caste') then cardlike.addShopItem(rarityPack(state, 'common')) end
  if owns(state, 'upper_class') then cardlike.addShopItem(rarityPack(state, 'uncommon')) end
  if owns(state, 'thaumaturgy') then cardlike.addShopItem(gamePack(state)) end
end)

addTicket { key = 'embraced_arcane', pos = { x = 2, y = 1 },
  description = 'When you open a [color="#d138bf"][b]Game Pack[/b][/color], create [color="#f3a712"][b]1[/b][/color] random [color="#d138bf"][b]Game card[/b][/color]\n[color="#9a9a9a"](Must have room)[/color]' }

cardlike.on('onPackOpened', function(state, step)
  if not owns(state, 'embraced_arcane') then return end
  local id = AIJ.defId(step.card) or ''
  if id:sub(1, 10) == 'pack_game_' and (state.freeConsumableSlots or 0) > 0 then
    cardlike.createConsumable('game')
  end
end)

local function fairyRate(rate)
  return function()
    AIJ.run.jest_fairy_edition_rate = math.max(tonumber(AIJ.run.jest_fairy_edition_rate) or 1, rate)
  end
end
addTicket { key = 'fairy_dust', pos = { x = 0, y = 0 }, vars = function() return { 2 } end, action = fairyRate(2) }
addTicket { key = 'live_pixie', pos = { x = 1, y = 0 }, precursor = 'fairy_dust', vars = function() return { 4 } end,
  action = fairyRate(4) }

addTicket { key = 'gold_medal', pos = { x = 2, y = 0 }, vars = function() return { 5 } end,
  description = '[color="#f3a712"][b]Gold[/b][/color] Pins appear [color="#f3a712"][b]5X[/b][/color] more often',
  action = function()
    if not AIJ.run.gold_medal_used then
      AIJ.run.gold_tag_rate = (AIJ.run.gold_tag_rate or 1) + 4
      AIJ.run.gold_medal_used = true
    end
  end }
addTicket { key = 'trophy', pos = { x = 3, y = 0 }, precursor = 'gold_medal',
  description = function()
    local s = cardlike.state
    local chance = (s and s.getChanceString) and s:getChanceString(1 / 3) or '1 in 3'
    return 'The [color="#f3a712"][b]Alpha Blind[/b][/color] skip Pin has a [color="#1bb18c"][b]' .. chance
      .. '[/b][/color] chance to be [color="#f3a712"][b]Gold[/b][/color]'
  end }

local STICKER_DESC = 'Lessens the effect of [color="#ff007f"][b]detrimental[/b][/color] [color="#f3a712"][b]stickers[/b][/color]\n'
  .. '[color="#9a9a9a"](Subscription costs [/color][color="#f3a712"][b]$1[/b][/color][color="#9a9a9a"] less per round, Timed Jokers last [/color][color="#f3a712"][b]2[/b][/color][color="#9a9a9a"] more rounds)[/color]'

local function stickerTickets(state)
  return (owns(state, 'sticker_sheet') and 1 or 0) + (owns(state, 'polkadot') and 1 or 0)
end

local function extendTimed(state)
  local n = stickerTickets(state)
  if n == 0 then return end
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.safe(j.getSticker, j) == 'timed' then
      local ds = j:getDataStore()
      local done = ds:getOrDefault('aij_timed_ext', 0)
      if done < n then
        ds:set('sticker_rounds', ds:getOrDefault('sticker_rounds', 3) + 2 * (n - done))
        ds:set('aij_timed_ext', n)
      end
    end
  end
end

local function stickerAction(ctx)
  local e = AIJ.run.sticker_effects or { pc_rental = { num = 0, odds = 3, active = false } }
  e.pc_rental = e.pc_rental or { num = 0, odds = 3, active = false }
  e.pc_rental.active = true
  e.pc_rental.num = (e.pc_rental.num or 0) + 1
  AIJ.run.sticker_effects = e
  extendTimed(ctx.state)
end
addTicket { key = 'sticker_sheet', pos = { x = 4, y = 0 }, description = STICKER_DESC, action = stickerAction }
addTicket { key = 'polkadot', pos = { x = 5, y = 0 }, precursor = 'sticker_sheet', description = STICKER_DESC, action = stickerAction }

cardlike.on('onCardObtained', function(state) extendTimed(state) end)
cardlike.on('onRoundStart', function(state, step, result)
  extendTimed(state)
  local n = stickerTickets(state)
  if n == 0 then return end
  local refund = 0
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.safe(j.getSticker, j) == 'subscription' then refund = refund + n end
  end
  if refund > 0 then result:add(plusMoney(refund)) end
end)

addTicket { key = 'recursion', pos = { x = 6, y = 0 }, vars = function() return { 1 } end,
  description = '[color="#f3a712"][b]+1[/b][/color] Ticket for sale each [color="#f3a712"][b]ante[/b][/color]' }
addTicket { key = 'recursion_2', pos = { x = 7, y = 0 }, precursor = 'recursion',
  description = '[color="#f3a712"][b]+1[/b][/color] more Ticket for sale each [color="#f3a712"][b]ante[/b][/color], Tickets cost [color="#f3a712"][b]$2[/b][/color] less' }

local function extraTicket(state, key)
  if not owns(state, key) or AIJ.run['aij_' .. key .. '_ante'] == state.ante then return end
  local id = AIJ.pick(H.availableTickets(state), state)
  if id and cardlike.addShopItem(id) then AIJ.run['aij_' .. key .. '_ante'] = state.ante end
end
cardlike.on('onShopEnter', function(state)
  extraTicket(state, 'recursion')
  extraTicket(state, 'recursion_2')
end)
cardlike.filter('price', function(price, card)
  local info = card and card.lastInfo
  if info and info.kind == 'ticket' and owns(cardlike.state, 'recursion_2') then return math.max(0, price - 2) end
  return nil
end)

local STAMPS = { 'Replay Stamp', 'Cash Stamp', 'Fruit Stamp', 'Game Stamp' }
addTicket { key = 'wax_stamp', pos = { x = 0, y = 1 },
  description = 'Playing cards in [color="#f3a712"][b]Deck Packs[/b][/color] are [color="#f3a712"][b]twice[/b][/color] as likely to have a [color="#f3a712"][b]Stamp[/b][/color]' }

cardlike.on('onPackOpened', function(state, step)
  if not owns(state, 'wax_stamp') then return end
  local id = AIJ.defId(step.card) or ''
  if id:sub(1, 10) ~= 'pack_deck_' then return end
  H.later(function()
    local s = cardlike.state
    if not s then return end
    for _, c in ipairs(cardlike.cards('pack') or {}) do
      if (c.lastInfo or {}).kind == 'playing' and not AIJ.stamp(c) and s:randomFloat() < 0.2 then
        c:setStamp(AIJ.pick(STAMPS, s))
      end
    end
  end)
end)

local SEAL_EDITIONS = { { 'Luna', 20 }, { 'Holo', 14 }, { 'Chroma', 3 } }
addTicket { key = 'seal_of_the_realm', pos = { x = 1, y = 1 }, precursor = 'wax_stamp' }

cardlike.on('onPackOpened', function(state, step)
  if not owns(state, 'seal_of_the_realm') then return end
  local id = AIJ.defId(step.card) or ''
  if id:sub(1, 10) ~= 'pack_deck_' then return end
  H.later(function()
    local s = cardlike.state
    if not s then return end
    for _, c in ipairs(cardlike.cards('pack') or {}) do
      if (c.lastInfo or {}).kind == 'playing' and AIJ.stamp(c) and s:randomFloat() < 0.148 then
        local r = s:randomFloat() * 37
