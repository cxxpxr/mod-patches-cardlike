add {
  key = 'chromatic_aberrant',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 17, y = 32 },
  blueprint_compat = false,
  config = { perm_odds = 0, perm_odds_max = 5, perm_odds_mod = 1, temp_odds = 0, temp_odds_mod = 1 },
  vars = function(card)
    local k = 'chromatic_aberrant'
    return { AIJ.val(card, k, 'perm_odds'), AIJ.val(card, k, 'perm_odds_max'), AIJ.val(card, k, 'perm_odds_mod'),
      AIJ.val(card, k, 'temp_odds'), AIJ.val(card, k, 'temp_odds_mod') }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'temp_odds', 0)
      local has = step.hand.contains or {}
      if has.STRAIGHT_FLUSH or has.ROYAL_FLUSH then
        if AIJ.num(joker, 'perm_odds') < AIJ.num(joker, 'perm_odds_max') then
          AIJ.add(joker, 'perm_odds', AIJ.num(joker, 'perm_odds_mod'))
          result:say('Upgrade!', GREEN)
        end
      elseif has.STRAIGHT or has.FLUSH then
        AIJ.add(joker, 'temp_odds', AIJ.num(joker, 'temp_odds_mod'))
        result:say('+' .. AIJ.fmt(AIJ.num(joker, 'temp_odds_mod')) .. ' Odds', GREEN)
      end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'temp_odds', 0)
    end,
  },
}
cardlike.filter('chance', function(p)
  if type(p) ~= 'number' or p <= 0 or p >= 1 then return nil end
  local state = cardlike.state
  if not state or not AIJ.owns('chromatic_aberrant', state) then return nil end
  local boost = 0
  for _, j in ipairs(active(state, 'chromatic_aberrant')) do
    boost = boost + AIJ.num(j, 'perm_odds') + AIJ.num(j, 'temp_odds')
  end
  if boost <= 0 then return nil end
  return math.min(1, p * (1 + boost))
end)

local function isChroma(card) return AIJ.hasEdition(card, 'e_polychrome') end
add {
  key = 'chromatist',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 7, y = 15 },
  config = { xmult = 2 },
  vars = function(card) return { AIJ.val(card, 'chromatist', 'xmult') } end,
  in_pool = function(state)
    for _, j in ipairs((state and state.jokers) or {}) do if isChroma(j) then return true end end
    return deckHas(state, isChroma)
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if isChroma(step.card) and not AIJ.isDebuffed(step.card) then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
    onOtherJoker = function(joker, state, step, result)
      if isChroma(step.other) then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      if isChroma(joker) then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

add {
  key = 'circle_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 3, y = 17 },
  config = { xmult = 3.14 },
  vars = function(card) return { AIJ.val(card, 'circle_joker', 'xmult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if #cards < 2 then return end
      for i = 1, #cards - 1 do
        if AIJ.noRank(cards[i]) or AIJ.noRank(cards[i + 1]) or cards[i]:getRank() <= cards[i + 1]:getRank() then return end
      end
      result:add(xMult(AIJ.num(joker, 'xmult')))
    end,
  },
}

local circuitMoving = false
add {
  key = 'circuit_diagram',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 10, y = 11 },
  blueprint_compat = false,
  description = hi('Charged') .. ' cards are always shuffled to the top of the deck',
  in_pool = function(state) return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'charged') end) end,
  triggers = {
    onHandDrawn = function(joker, state, step, result)
      if circuitMoving or not step.first then return end
      local charged, others = {}, {}
      for _, c in ipairs(state.unDrawnCards or {}) do
        if AIJ.hasEnhancement(c, 'charged') then charged[#charged + 1] = c end
      end
      if #charged == 0 then return end
      for _, c in ipairs(state.cardsInHand or {}) do
        if not AIJ.hasEnhancement(c, 'charged') then others[#others + 1] = c end
      end
      others = AIJ.shuffled(others, state)
      circuitMoving = true
      local moved = 0
      for i = 1, math.min(#charged, #others) do
        others[i]:moveTo('deck')
        charged[i]:moveTo('hand')
        moved = moved + 1
      end
      circuitMoving = false
      if moved > 0 then result:say('Charged!') end
    end,
  },
}

