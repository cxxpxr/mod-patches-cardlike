add {
  key = 'cctv',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 9, y = 1 },
  config = { money = 7 },
  description = function(r)
    local c = r and r.card
    return 'When a ' .. hi('Fragile card') .. ' breaks, earn ' .. hi('$' .. AIJ.fmt(AIJ.val(c, 'cctv', 'money')), MONEY)
      .. ' and make a random card held in hand ' .. hi('Fragile')
  end,
  in_pool = function(state)
    local n = 0
    for _, c in ipairs((state and state.allCards) or {}) do
      if AIJ.hasEnhancement(c, 'm_glass') then n = n + 1 end
    end
    return n >= 3
  end,
  triggers = {
    onCardsDestroyed = function(joker, state, step, result)
      local broken = 0
      for _, c in ipairs(step.cards or {}) do
        local e = (c.lastInfo and c.lastInfo.enhancement) or AIJ.enhancement(c)
        if enhIs(e, 'm_glass') then broken = broken + 1 end
      end
      if broken == 0 then return end
      for _ = 1, broken do
        local pool = {}
        for _, h in ipairs(state.cardsInHand or {}) do
          if AIJ.exists(h) and not AIJ.hasEnhancement(h, 'm_glass') then pool[#pool + 1] = h end
        end
        local pick = AIJ.pick(pool, state)
        if pick then pick:setEnhancement(AIJ.vanilla('m_glass')); pick:punch() end
      end
      result:add(plusMoney(AIJ.num(joker, 'money') * broken))
    end,
  },
}

add {
  key = 'cerium',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 20, y = 32 },
  config = { retriggers = 2 },
  vars = function(card) return { AIJ.val(card, 'cerium', 'retriggers') } end,
  in_pool = function(state)
    local h = state and state:getHand('FLUSH_HOUSE')
    return h ~= nil and (h.played or 0) > 0
  end,
  triggers = {
    repeatCard = function(joker, state, step, result)
      if step.hand and step.hand.handType == 'FLUSH_HOUSE' then return AIJ.num(joker, 'retriggers') end
    end,
  },
}

local function onlyKingsOf(hand, suit)
  local all = (hand and hand.allCards) or {}
  if #all == 0 then return false end
  for _, c in ipairs(all) do
    if AIJ.noRank(c) or c:getRank() ~= 13 or not c:isSuit(suit) then return false end
  end
  return true
end

