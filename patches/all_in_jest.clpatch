      otc.pending = otc.pending + AIJ.num(joker, 'cards_to_draw')
      otc.wait = 3
    end,
  },
}

local OVER_NEXT = { Hearts = 'Clubs', Clubs = 'Diamonds', Diamonds = 'Spades', Spades = 'Hearts' }
local OVER_BASE = { Hearts = 1.5, Clubs = 14, Diamonds = 2, Spades = 100 }
local function round2(x) return math.floor(x * 100 + 0.5) / 100 end
local function overAmount(card, suit)
  local buff = AIJ.val(card, 'overdesigned_joker', 'silver_multiplier_buff', 100)
  return round2((OVER_BASE[suit] or 0) * buff / 100)
end
local function overEffect(suit, n)
  if suit == 'Hearts' then return 'give ' .. hl('X' .. AIJ.fmt(n), colors.MULT) .. ' Mult' end
  if suit == 'Clubs' then return 'give ' .. hl('+' .. AIJ.fmt(n), colors.MULT) .. ' Mult' end
  if suit == 'Diamonds' then return 'earn ' .. hl('$' .. AIJ.fmt(n), colors.MONEY) end
  return 'give ' .. hl('+' .. AIJ.fmt(n), colors.CHIPS) .. ' Points'
end

AIJ.addJoker {
  key = 'overdesigned_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 8 },
  config = { suit = 'Hearts', silver_multiplier_buff = 100 },
  blueprint_compat = true,
  description = function(r)
    local card = r and r.card
    local suit = AIJ.val(card, 'overdesigned_joker', 'suit', 'Hearts')
    local cycle = {}
    for _, s in ipairs({ 'Hearts', 'Clubs', 'Diamonds', 'Spades' }) do
      cycle[#cycle + 1] = (s == suit) and hl(s, AIJ.SUIT_COLORS[s]) or grey(s)
    end
    return 'Scored ' .. hl(suit, AIJ.SUIT_COLORS[suit]) .. ' cards ' .. overEffect(suit, overAmount(card, suit))
      .. '\nSuit and effect ' .. hl('rotate') .. ' when a card is ' .. hl('scored')
      .. '\n' .. grey('(') .. table.concat(cycle, grey(' -> ')) .. grey(')')
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local suit = AIJ.get(joker, 'suit', 'Hearts')
      local n = overAmount(joker, suit)
      local nextSuit = OVER_NEXT[suit] or 'Clubs'
      if not step.copiedBy then AIJ.set(joker, 'suit', nextSuit) end
      if step.card:isSuit(suit) then
        if suit == 'Hearts' then result:add(xMult(n))
        elseif suit == 'Clubs' then result:add(plusMult(n))
        elseif suit == 'Diamonds' then result:add(plusMoney(n))
        else result:add(plusChips(n)) end
      end
      result:say(AIJ.get(joker, 'suit', nextSuit), colors.ORANGE)
    end,
  },
}

local function isGoldPin(id)
  for _, k in ipairs(AIJ.lists.gold_pins) do if AIJ.isId(id, k) then return true end end
  return false
end
cardlike.filter('skipPin', function(pin, slot)
  local state = cardlike.state
  if not state or not AIJ.owns('pablillos', state) or isGoldPin(pin) then return nil end
  return AIJ.randomGoldPin(state)
end)

AIJ.addJoker {
  key = 'pablillos',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 2, y = 12 }, soul_pos = { x = 2, y = 13 },
  config = {},
  blueprint_compat = false,
  description = 'All skip ' .. hl('Pins') .. ' are replaced with a random ' .. hl('Gold Pin'),
  in_pool = function(state) return (state.ante or 0) >= 3 end,
}

cardlike.filter('price', function(price, card)
  local state = cardlike.state
  if not state or type(card) ~= 'table' or not card.lastInfo or card.lastInfo.kind ~= 'joker' then return nil end
  local paces = owned(state, 'pace')
  if #paces == 0 then return nil end
  return math.max(1, AIJ.num(paces[1], 'price'))
end)

AIJ.addJoker {
  key = 'pace',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 2, y = 4 }, soul_pos = { x = 2, y = 5 },
  config = { price = 4 },
  blueprint_compat = false,
  description = function(r)
    return 'All Jokers cost ' .. hl('$' .. AIJ.fmt(AIJ.val(r and r.card, 'pace', 'price')), colors.MONEY)
  end,
}

local function uniqueHeldRanks(state)
  local seen, n = {}, 0
  for _, c in ipairs((state and state.cardsInHand) or {}) do
    if not AIJ.noRank(c) and not AIJ.isDebuffed(c) then
      local r = c:getRank()
      if not seen[r] then seen[r] = true n = n + 1 end
    end
  end
  return n
end

AIJ.addJoker {
  key = 'pangram',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 6, y = 45 },
  config = { xmult_gain = 0.2, xmult_base = 1 },
  blueprint_compat = true,
  vars = function(card)
    local gain = AIJ.val(card, 'pangram', 'xmult_gain')
    local n = card and uniqueHeldRanks(cardlike.state) or 0
    return { gain, AIJ.val(card, 'pangram', 'xmult_base') + gain * n }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult_base') + AIJ.num(joker, 'xmult_gain') * uniqueHeldRanks(state)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'pantomimus',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 21, y = 5 }, lite = true,
  config = { chips = 0, chip_mod = 2 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.val(card, 'pantomimus', 'chips'), AIJ.val(card, 'pantomimus', 'chip_mod') } end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = #(state.cardsInHand or {})
      if n <= 0 then return end
      AIJ.add(joker, 'chips', n * AIJ.num(joker, 'chip_mod'))
      result:say('+' .. AIJ.fmt(AIJ.num(joker, 'chips')) .. ' Points', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.addJoker {
  key = 'paper_bag',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 16, y = 1 },
  config = { chip_mod = 1, cur_chips = 0 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.val(card, 'paper_bag', 'chip_mod'), AIJ.val(card, 'paper_bag', 'cur_chips') } end,
  triggers = {
    onDiscard = function(joker, state, step, result)
      if step.copiedBy then return end
      local ev = cardlike.evaluateHand(step.discardedCards or {})
      local h = ev and state:getHand(ev.handType)
      if not h then return end
      local gain = (h.level or 1) * AIJ.num(joker, 'chip_mod')
      AIJ.add(joker, 'cur_chips', gain)
      result:say('+' .. AIJ.fmt(gain) .. ' Points', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'cur_chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.addJoker {
  key = 'papermoon_credits_joker',
  rarity = 1, cost = 4, atlas = 'familiar_atlas', pos = { x = 1, y = 3 }, lite = true,
