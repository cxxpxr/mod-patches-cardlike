AIJ.addJoker {
  key = 'beanstalk',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 8, y = 7 },
  config = {},
  blueprint_compat = false,
}

local function beanstalkFix(cards)
  for _, c in ipairs(cards or {}) do
    if not AIJ.noRank(c) and AIJ.safe(c.getRank, c) == 11 then
      if AIJ.isDebuffed(c) then c:setDebuffState(false) end
      if AIJ.safe(c.isFlipped, c) then c:flip(false) end
      unmark(c)
    end
  end
end

cardlike.filter('scoringCards', function(uids, played)
  if #owned('beanstalk') == 0 or type(played) ~= 'table' then return nil end
  local have, changed = {}, false
  for _, u in ipairs(uids or {}) do have[u] = true end
  local out = {}
  for _, c in ipairs(played) do
    if have[c.uid] or (not AIJ.noRank(c) and c:getRank() == 11) then
      out[#out + 1] = c.uid
      if not have[c.uid] then changed = true end
    end
  end
  if changed then return out end
end)

cardlike.on('beforeAllCardsScored', function(state, step)
  if #owned('beanstalk') > 0 then beanstalkFix(step.hand and step.hand.allCards) end
end)

local beanTime = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  beanTime = beanTime + (frame.dt or 0)
  if beanTime < 0.25 then return end
  beanTime = 0
  local state = cardlike.state
  if not state or state.money == nil or not AIJ.owns('beanstalk', state) then return end
  beanstalkFix(cardlike.cards('hand'))
  beanstalkFix(cardlike.cards('played'))
end)

local function bearMult(card, state)
  local money = state and state.money or 0
  local diff = math.max(0, AIJ.val(card, 'bear', 'dollars') - money)
  return math.floor(diff / 5) * AIJ.val(card, 'bear', 'mult')
end

AIJ.addJoker {
  key = 'bear', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 11, y = 25 },
  config = { mult = 1, dollars = 100 },
  vars = function(card)
    local s = cardlike.state
    return { AIJ.val(card, 'bear', 'mult'), AIJ.val(card, 'bear', 'dollars'), (s and s.money) and bearMult(card, s) or 0 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = bearMult(joker, state)
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local function enhancedCount(state)
  local n = 0
  for _, c in ipairs((state and state.allCards) or {}) do
    if AIJ.enhancement(c) then n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'bearded_joker', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 22, y = 7 },
  config = { mult_mod = 2 },
  vars = function(card)
    local s = cardlike.state
    local n = (s and s.money ~= nil) and enhancedCount(s) or 0
    return { AIJ.val(card, 'bearded_joker', 'mult_mod'), AIJ.val(card, 'bearded_joker', 'mult_mod') * n }
  end,
  in_pool = function(state) return enhancedCount(state) > 2 end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult_mod') * enhancedCount(state)
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

