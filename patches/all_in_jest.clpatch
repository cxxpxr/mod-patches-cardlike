    ["j_aij_beekeeper"] = { name = "Beekeeper", text = "[color=\"#f3a712\"][b]6s[/b][/color] held in hand give [color=\"#3772ff\"][b]+#1#[/b][/color] Points and [color=\"#ff007f\"][b]+#2#[/b][/color] Mult" },
    ["j_aij_beelzebub"] = { name = "Beelzebub", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult when any [color=\"#f3a712\"][b]playing card[/b][/color] is added to [color=\"#f3a712\"][b]deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_bell"] = { name = "Bell", text = "" },
    ["j_aij_bellhop"] = { name = "Bellhop", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Shop Slot" },
    ["j_aij_bermuda"] = { name = "Bermuda", text = "" },
    ["j_aij_biancolelli"] = { name = "Biancolelli", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] after Jokers trigger" },
    ["j_aij_big_ears"] = { name = "Big-Ears", text = "This Joker gains [color=\"#3772ff\"][b]+#2#[/b][/color] Points when an [color=\"#f3a712\"][b]even[/b][/color] card is scored,\n[color=\"#ff007f\"][b]-#3#[/b][/color] Points when an [color=\"#f3a712\"][b]odd[/b][/color] card is scored\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_big_fish"] = { name = "Big Fish", text = "" },
    ["j_aij_big_red"] = { name = "Big Red", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult Only [color=\"#ff007f\"][b]Mult[/b][/color] Jokers appear" },
    ["j_aij_bingo_card"] = { name = "Bingo Card", text = "Scored [color=\"#f3a712\"][b]Paperback cards[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance for [color=\"#ff007f\"][b]X#5#[/b][/color] Mult and a [color=\"#1bb18c\"][b]#3# in #4#[/b][/color] chance to [color=\"#f3a712\"][b]retrigger[/b][/color]" },
    ["j_aij_bingsu"] = { name = "Bingsu", text = "All scoring cards give [color=\"#3772ff\"][b]+#1#[/b][/color] Points [color=\"#1bb18c\"][b]#3# in #4#[/b][/color] chance to reduce by [color=\"#3772ff\"][b]-#2#[/b][/color] Points when a card is scored" },
    ["j_aij_birthday_clown"] = { name = "Birthday Clown", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult for [color=\"#f3a712\"][b]1[/b][/color] round each [color=\"#f3a712\"][b]Ante[/b][/color] [color=\"#9a9a9a\"]#2#[/color]" },
    ["j_aij_bit_flip"] = { name = "Bit Flip", text = "After hand is played, each [color=\"#f3a712\"][b]digit[/b][/color] in your [color=\"#d78fd0\"][b]total score[/b][/color] has a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to be increased by [color=\"#f3a712\"][b]#3#[/b][/color]" },
    ["j_aij_bits_n_bob"] = { name = "Bits n' Bob", text = "" },
    ["j_aij_bizco"] = { name = "Bizco", text = "Leftmost [color=\"#f3a712\"][b]#1#[/b][/color] cards [color=\"#f3a712\"][b]held in hand[/b][/color] are counted in scoring" },
    ["j_aij_black_belt"] = { name = "Black Belt", text = "" },
    ["j_aij_black_cat"] = { name = "Black Cat", text = "" },
    ["j_aij_blacklight"] = { name = "Blacklight", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Hand size on [color=\"#f3a712\"][b]even[/b][/color] Antes\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Hand Size)[/color]" },
    ["j_aij_blacklist"] = { name = "Blacklist", text = "[color=\"#f3a712\"][b]Sold[/b][/color] jokers can no longer reappear Currently Blacklisted Jokers:" },
    ["j_aij_blanca"] = { name = "Blanca", text = "" },
    ["j_aij_blanche"] = { name = "Blanche", text = "" },
    ["j_aij_blank_card"] = { name = "Blank Card", text = "Every time a [color=\"#f3a712\"][b]playing card[/b][/color] is chosen from a [color=\"#f3a712\"][b]Deck Pack[/b][/color], create an exact [color=\"#f3a712\"][b]copy[/b][/color]" },
    ["j_aij_blarney_stone"] = { name = "Blarney Stone", text = "Adds [color=\"#ff007f\"][b]Mult[/b][/color] equal to [color=\"#f3a712\"][b]triple[/b][/color] the [color=\"#f3a712\"][b]first digit[/b][/color] of current [color=\"#f3a712\"][b]score[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_blemmya"] = { name = "Blemmya", text = "If [color=\"#f3a712\"][b]played hand[/b][/color] contains an [color=\"#f3a712\"][b]odd[/b][/color] number of cards, the [color=\"#f3a712\"][b]middle[/b][/color] card is converted into a random [color=\"#f3a712\"][b]face[/b][/color] card" },
    ["j_aij_blind_drawn"] = { name = "Blind-Drawn", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult Cannot see [color=\"#f3a712\"][b]Boss Blind[/b][/color] or its effects until selected" },
    ["j_aij_blizzard"] = { name = "Blizzard", text = "" },
    ["j_aij_blood_artist"] = { name = "Blood Artist", text = "When any Joker or card is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#f3a712\"][b]destroyed[/b][/color], decrease current [color=\"#f3a712\"][b]Blind's[/b][/color] score requirement by [color=\"#f3a712\"][b]#1#%[/b][/color]" },
    ["j_aij_bloody_mary"] = { name = "Bloody Mary", text = "" },
    ["j_aij_blue_eyes_white_joker"] = { name = "Blue-Eyes White Joker", text = "If [color=\"#f3a712\"][b]final hand[/b][/color] of round is exactly [color=\"#f3a712\"][b]1[/b][/color] card, it permanently gains [color=\"#f3a712\"][b]+#1# retrigger[/b][/color]" },
    ["j_aij_blue_star"] = { name = "Blue Star", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#f3a712\"][b]level up[/b][/color] played poker hand if it contains a [color=\"#f3a712\"][b]Bonus[/b][/color] or [color=\"#f3a712\"][b]Fervent Card[/b][/color]" },
    ["j_aij_blue_tongue"] = { name = "Blue Tongue", text = "" },
    ["j_aij_blueberries"] = { name = "Blueberries", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Fervent[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a card is [color=\"#f3a712\"][b]retriggered[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]The Magus[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_bluet"] = { name = "Bluet", text = "When [color=\"#f3a712\"][b]Blind[/b][/color] is selected, create an [color=\"#5d5dff\"][b]Inverted[/b][/color] [color=\"#4584fa\"][b]Admin[/b][/color] card" },
    ["j_aij_bobblehead"] = { name = "Bobblehead", text = "[color=\"#f3a712\"][b]Jokers[/b][/color] belonging to your [color=\"#f3a712\"][b]most held rarity[/b][/color] [color=\"#9a9a9a\"](excluding[/color] [color=\"#9a9a9a\"]Bobblehead)[/color] appear more often\n[color=\"#9a9a9a\"](Currently: [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_bobby"] = { name = "Bobby", text = "" },
    ["j_aij_body_pillow"] = { name = "Body Pillow", text = "Played [color=\"#f3a712\"][b]non-scoring[/b][/color] cards earn [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_bogdonoff"] = { name = "Bogdonoff", text = "Go up to [color=\"#ff007f\"][b]-$#1#[/b][/color] in debt\nSet money to [color=\"#f3a712\"][b]$0[/b][/color] when leaving [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_bon_vivant"] = { name = "Bon Vivant", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] after [color=\"#f3a712\"][b]#3#[/b][/color] cards have been scored [color=\"#f3a712\"][b]this round[/b][/color]\n[color=\"#9a9a9a\"](#2# Remaining)[/color]" },
    ["j_aij_bonus_bob"] = { name = "Bonus Bob", text = "[color=\"#f3a712\"][b]Chipped cards[/b][/color] give [color=\"#3772ff\"][b]X#1#[/b][/color] Points when scored" },
    ["j_aij_bonus_pay"] = { name = "Bonus Pay", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when a [color=\"#f3a712\"][b]Chipped card[/b][/color] is scored" },
    ["j_aij_bonus_round"] = { name = "Bonus Round", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all scored [color=\"#f3a712\"][b]Chipped cards[/b][/color]" },
