local ANAGRAPH = 'aij_anagraph_copy'
local anagraphPending = {}

local function anagraphOn(state) return AIJ.owns('anagraph', state) end

AIJ.addJoker {
  key = 'anagraph',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 7, y = 7 },
  config = {},
  blueprint_compat = false,
}

AIJ.onJokerGone(function(state, info, sold)
  if AIJ.isId(info.joker, 'anagraph') or not anagraphOn(state) then return end
  if info.store and info.store[ANAGRAPH] then return end
  local copy = cardlike.createJoker(info.joker, { edition = info.edition, force = true })
  if not copy then return end
  local h = copy.uid and cardlike.card(copy.uid) or copy
  local ds = h:getDataStore()
  for k, v in pairs(info.store or {}) do ds:set(k, v) end
  ds:set(ANAGRAPH, true)
  for _, j in ipairs(owned('anagraph')) do j:popup('Again!', colors.ORANGE) break end
  anagraphPending[#anagraphPending + 1] = { card = h, at = cardlike.time() + 0.5 }
end)

cardlike.onFrame(function(frame)
  if #anagraphPending == 0 then return end
  if not frame.inRun then anagraphPending = {} return end
  local now = cardlike.time()
  local keep = {}
  for _, p in ipairs(anagraphPending) do
    if now >= p.at then
      if AIJ.exists(p.card) then p.card:destroy() end
    else
      keep[#keep + 1] = p
    end
  end
  anagraphPending = keep
end)

cardlike.on('onCardsRemoved', function(state, step)
  if not anagraphOn(state) then return end
  for _, c in ipairs(step.cards or {}) do
    local info = c.lastInfo or {}
    if info.kind == 'playing' and not (info.store and info.store[ANAGRAPH]) then
      local copy = cardlike.addPlayingCard({
        rank = info.rank, suit = info.suit, enhancement = info.enhancement, edition = info.edition,
        stamp = info.stamp, bonusPoints = info.bonusPoints,
      }, { area = 'deck', animate = false })
      if copy then
        local h = copy.uid and cardlike.card(copy.uid) or copy
        local ds = h:getDataStore()
        for k, v in pairs(info.store or {}) do ds:set(k, v) end
        ds:set(ANAGRAPH, true)
        h:destroy()
      end
    end
  end
end)

AIJ.addJoker {
  key = 'angel_number',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 6, y = 11 },
  config = { numeratormod = 1, sevens = 0 },
  vars = function(card) return { AIJ.val(card, 'angel_number', 'numeratormod') } end,
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        if not AIJ.noRank(c) and c:getRank() == 7 then n = n + 1 end
      end
      AIJ.set(joker, 'sevens', n)
      if n > 0 then
        result:say(AIJ.fill(AIJ.msg('a_aij_odds', '+#1# Odds'), { n * AIJ.num(joker, 'numeratormod') }), colors.GREEN)
      end
    end,
    afterRound = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'sevens', 0) end
    end,
  },
}

cardlike.filter('chance', function(p)
  if type(p) ~= 'number' or not cardlike.state or cardlike.state.money == nil then return nil end
  local add = 0
  for _, j in ipairs(owned('angel_number')) do add = add + AIJ.num(j, 'sevens') * AIJ.num(j, 'numeratormod') end
  if add <= 0 then return nil end
  return math.min(1, p * (1 + add))
end)

