    ["j_aij_voynich_joker"] = { name = "Voynich Joker", text = "" },
    ["j_aij_wamba"] = { name = "Wamba", text = "Adds an extra slot to the [color=\"#f3a712\"][b]shop[/b][/color], which [color=\"#f3a712\"][b]always[/b][/color] contains a [color=\"#f3a712\"][b]#1#[/b][/color] Joker\n[color=\"#9a9a9a\"](Rarity of the Joker is ignored,[/color] [color=\"#9a9a9a\"]excluding Legendaries)[/color]\n[color=\"#V1#\"][b]Activated Ability[/b][/color] Cycle what [color=\"#f3a712\"][b]type[/b][/color] of Joker is provided" },
    ["j_aij_war_mask"] = { name = "War Mask", text = "" },
    ["j_aij_warhol"] = { name = "Warhol", text = "[color=\"#f3a712\"][b]Stamps[/b][/color] have the effect of [color=\"#3772ff\"][b]Blue[/b][/color], [color=\"#f3a712\"][b]Gold[/b][/color], and [color=\"#d138bf\"][b]Purple[/b][/color] stamps [color=\"#f3a712\"][b]simultaneously[/b][/color]" },
