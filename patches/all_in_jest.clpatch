  end,
  canUse = function(ctx) return mostPlayed(ctx.state) and '' or 'Play a hand first' end,
  action = function(ctx) ctx.state:upgradeHand(mostPlayed(ctx.state), 3) end }

local function editionSpread(key, pos, ed, count)
  gold { key = key, pos = pos, popWhen = H.ANY_TIME,
    vars = function() return { count } end,
    canUse = function(ctx) return (jokerOk(ctx.state) or deckOk(ctx.state)) and '' or 'Needs a card without an edition' end,
    action = function(ctx)
      local s = ctx.state
      local e = type(ed) == 'function' and ed() or ed
      H.editionToRandom(s, s.jokers, e)
      for _ = 1, count do
        if not H.editionToRandom(s, H.deckCards(s), e) then break end
      end
    end }
end
editionSpread('crystal', { x = 8, y = 3 }, 'Luna', 5)
editionSpread('iridescent', { x = 9, y = 2 }, 'Holo', 5)
editionSpread('superlunary', { x = 7, y = 4 }, function() return H.modEdition('stellar') end, 5)

gold { key = 'gold_dust', pos = { x = 9, y = 4 }, popWhen = H.ANY_TIME,
