local function borraUp(joker, step, result, quiet)
  if step and step.copiedBy then return end
  AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
  if not quiet and result then
    result:say('Upgrade!', MULT)
    result.shouldWaitAfterActivation = false
  end
end
local function borraEvent(joker, state, step, result) borraUp(joker, step, result) end

