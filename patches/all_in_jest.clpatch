    ["j_aij_caveat_emptor"] = { name = "Caveat Emptor", text = "" },
    ["j_aij_cctv"] = { name = "CCTV", text = "When a [color=\"#f3a712\"][b]Fragile card[/b][/color] [color=\"#f3a712\"][b]breaks[/b][/color], earn [color=\"#f3a712\"][b]$#1#[/b][/color] and enhance a random card held in hand into [color=\"#f3a712\"][b]Glass[/b][/color]" },
