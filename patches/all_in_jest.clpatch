AIJ.addJoker {
  key = 'thalia',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 9, y = 10 }, soul_pos = { x = 9, y = 11 },
  config = { retriggers = 1 },
  vars = function(card) return { AIJ.val(card, 'thalia', 'retriggers') } end,
  triggers = {
    onDiscard = function(joker, state, step, result)
      local cards = step.discardedCards or {}
      if #cards ~= 1 or (state.discardsUsed or 0) > 1 then return end
      AIJ.permaAdd(cards[1], 'reps', AIJ.num(joker, 'retriggers'))
      result:say('Upgrade!', colors.ORANGE, cards[1])
    end,
  },
}

local function shopTicket(state)
  for _, c in ipairs(state and state.shopCards or {}) do
    if (c.lastInfo or {}).kind == 'ticket' then return c end
  end
  return nil
end

local function ticketChoices(state, current)
  local out = {}
  for _, t in ipairs(cardlike.listContent('ticket') or {}) do
    local id = t.id
    if id ~= current and not state:hasTicket(id) then
      local n = tonumber(tostring(id):match('^ticket_(%d+)$'))
      if not n or n % 2 == 0 or state:hasTicket('ticket_' .. (n - 1)) then out[#out + 1] = id end
    end
  end
  return out
end

local function bellCanPress(card, state)
  if not state or not state:isPhase('shop') then return false end
  if (state.money or 0) < AIJ.num(card, 'cost') then return false end
  return shopTicket(state) ~= nil
end

AIJ.addJoker {
  key = 'the_bell',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 5, y = 22 },
  config = { cost = 5 },
  vars = function(card) return { AIJ.val(card, 'the_bell', 'cost'), colours = { ENHANCED_COLOUR } } end,
  buttons = {
    AIJ.ability('the_bell', {
      label = function(card) return 'REROLL $' .. AIJ.fmt(AIJ.num(card, 'cost')) end,
      canPress = bellCanPress,
      press = function(card, state, opts)
        local free = opts and opts.free
        if not free and not bellCanPress(card, state) then return false end
        if free and not shopTicket(state) then return false end
        local t = shopTicket(state)
        local pick = AIJ.pick(ticketChoices(state, AIJ.defId(t)), state)
        if not pick then
          card:popup('No Ticket found!', colors.RED)
          return false
        end
        if not free then state:mutateMoney(-AIJ.num(card, 'cost')) end
        t:setConsumableDef(pick)
        t:punch()
        card:punch()
      end,
    }),
  },
}

AIJ.onNewRun(function(run) run.the_clown_show_bought = 0 end)

cardlike.on('onCardBought', function(state, step)
  local info = step and step.card and step.card.lastInfo or {}
  if info.kind == 'joker' then AIJ.run.the_clown_show_bought = (AIJ.run.the_clown_show_bought or 0) + 1 end
end)

AIJ.addJoker {
  key = 'the_clown_show',
  rarity = 1, cost = 6, atlas = 'joker_atlas', pos = { x = 8, y = 0 },
  config = { chips = 8 },
  vars = function(card)
    local c = AIJ.val(card, 'the_clown_show', 'chips')
    return { c, c * (AIJ.run.the_clown_show_bought or 0) }
  end,
  triggers = {
    onCardBought = function(joker, state, step, result)
      local info = step.card and step.card.lastInfo or {}
      if step.copiedBy or info.kind ~= 'joker' then return end
      result:say('Upgrade!', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips') * (AIJ.run.the_clown_show_bought or 0)
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

local HAND_ORDER = {
  HIGH_CARD = 1, PAIR = 2, TWO_PAIR = 3, THREE_OF_A_KIND = 4, STRAIGHT = 5, FLUSH = 6, FULL_HOUSE = 7,
  FOUR_OF_A_KIND = 8, STRAIGHT_FLUSH = 9, ROYAL_FLUSH = 10, FIVE_OF_A_KIND = 11, FLUSH_HOUSE = 12, FLUSH_FIVE = 13,
}

local function isRock(c)
  return (c.lastInfo or {}).enhancement == AIJ.vanilla('m_stone')
end

cardlike.filter('handType', function(value, played)
  if type(value) ~= 'table' or not HAND_ORDER[value.handType] then return nil end
  local state = cardlike.state
  if not state or not state.hasJoker or not state:hasJoker(AIJ.id('the_far_lands')) then return nil end
  local groups, rocks = {}, {}
  for _, c in ipairs(played or {}) do
    if isRock(c) then
      rocks[#rocks + 1] = c
    else
      local r = rankOf(c)
      if r then groups[r] = groups[r] or {} table.insert(groups[r], c) end
    end
  end
  if #rocks < 2 then return nil end
  local list = { rocks }
  for _, g in pairs(groups) do list[#list + 1] = g end
  table.sort(list, function(a, b) return #a > #b end)
  local a, b = #list[1], list[2] and #list[2] or 0
  local ht, use
  if a >= 5 then ht, use = 'FIVE_OF_A_KIND', { list[1] }
  elseif a == 4 then ht, use = 'FOUR_OF_A_KIND', { list[1] }
  elseif a == 3 and b >= 2 then ht, use = 'FULL_HOUSE', { list[1], list[2] }
  elseif a == 3 then ht, use = 'THREE_OF_A_KIND', { list[1] }
  elseif a == 2 and b == 2 then ht, use = 'TWO_PAIR', { list[1], list[2] }
  else ht, use = 'PAIR', { list[1] } end
  if HAND_ORDER[ht] <= HAND_ORDER[value.handType] then return nil end
  local scoring, seen = {}, {}
  local function addUid(uid) if uid and not seen[uid] then seen[uid] = true scoring[#scoring + 1] = uid end end
  for _, g in ipairs(use) do for _, c in ipairs(g) do addUid(c.uid) end end
  for _, c in ipairs(rocks) do addUid(c.uid) end
  return { handType = ht, scoring = scoring }
end)

AIJ.addJoker {
  key = 'the_far_lands',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 11, y = 29 },
  blueprint_compat = false,
  vars = function() return { 'Rock Card' } end,
  in_pool = function(state)
    return deckHas(state, isRock)
  end,
}

local grim = { pending = 0, untilT = 0 }

local function grimOpen(n)
  if n <= 0 then return end
  grim.pending = grim.pending + n
  grim.untilT = cardlike.time() + 3
end

cardlike.on('onDiscard', function(state, step)
  if not AIJ.owns('the_grim_joker') then return end
  local n = 0
  for _, c in ipairs(step and step.discardedCards or {}) do
    if AIJ.hasStamp(c, 'Purple') and not AIJ.isDebuffed(c) then n = n + 1 end
  end
  grimOpen(n)
end)

cardlike.on('afterHand', function(state, step)
  if not AIJ.owns('the_grim_joker') or (state.handsLeft or 1) > 0 then return end
  local n = 0
  for _, c in ipairs(step and step.held or state.cardsInHand or {}) do
    if AIJ.hasStamp(c, 'Blue') and not AIJ.isDebuffed(c) then n = n + 1 end
  end
  grimOpen(n)
end)

AIJ.addJoker {
  key = 'the_grim_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 17, y = 12 },
  config = { odds = 3 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'the_grim_joker', 'odds') } end,
  in_pool = function(state)
    return deckHas(state, function(c) return AIJ.hasStamp(c, 'Purple') or AIJ.hasStamp(c, 'Blue') end)
  end,
  triggers = {
    onCardObtained = function(joker, state, step, result)
      local c = step.card
      if not c or (c.lastInfo or {}).kind ~= 'consumable' then return end
      local ds = c:getDataStore()
      local mark = ds:get('aij_grim_checked')
      if mark == nil then
        mark = grim.pending > 0 and cardlike.time() <= grim.untilT
        if mark then grim.pending = grim.pending - 1 end
        ds:set('aij_grim_checked', mark)
      end
      if mark ~= true or AIJ.edition(c) then return end
      if state:chance(1 / AIJ.num(joker, 'odds')) then
        c:setEdition(AIJ.vanilla('e_negative'))
        c:punch()
        result:say(AIJ.msg('k_aij_editioned_ex', 'Editioned!'), colors.PURPLE)
      end
    end,
  },
}

