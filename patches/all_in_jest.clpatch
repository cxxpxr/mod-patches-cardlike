    ["tag_aij_overstuffed"] = { name = "Overstuffed Pin", text = "Next [color=\"#f3a712\"][b]Pack[/b][/color] opened contains [color=\"#f3a712\"][b]twice[/b][/color] the number of options and available picks" },
    ["tag_aij_polydactyly"] = { name = "Polydactyly Pin", text = "Gives [color=\"#3772ff\"][b]+1 hand[/b][/color] next round per unused [color=\"#3772ff\"][b]hand[/b][/color] this run\n[color=\"#9a9a9a\"](Will give [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] hands)[/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#3772ff\"][b]+40[/b][/color][color=\"#9a9a9a\"] hands)[/color]" },
    ["tag_aij_recherche"] = { name = "Recherché Pin", text = "Shop has a free [color=\"#fe5f55\"][b]Rare Joker[/b][/color] with [color=\"#f3a712\"][b]doubled[/b][/color] values" },
