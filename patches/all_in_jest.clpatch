    ["j_aij_urchin"] = { name = "Urchin", text = "Earn [color=\"#f3a712\"][b]$#2#[/b][/color] at end of round for each [color=\"#f3a712\"][b]Blind[/b][/color] skipped this run\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_valentine"] = { name = "Valentine", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]unique pair[/b][/color] in [color=\"#f3a712\"][b]scored hand[/b][/color]" },
    ["j_aij_value_drift"] = { name = "Value Drift", text = "" },
    ["j_aij_vanha_erkki"] = { name = "Vanha Erkki", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult, triggers at a [color=\"#f3a712\"][b]random point[/b][/color] during scoring" },
    ["j_aij_vecchio_dolore"] = { name = "Vecchio Dolore", text = "On next [color=\"#1bb18c\"][b]reroll[/b][/color], create [color=\"#5d5dff\"][b]Inverted[/b][/color] copies of all items offered in the [color=\"#f3a712\"][b]Shop[/b][/color] before you [color=\"#1bb18c\"][b]rerolled[/b][/color]\nSelf [color=\"#ff007f\"][b]debuffs[/b][/color] on [color=\"#1bb18c\"][b]reroll[/b][/color]" },
    ["j_aij_veggie_joker"] = { name = "Veggie Joker", text = "When any [color=\"#f3a712\"][b]numbered card[/b][/color] is [color=\"#ff007f\"][b]destroyed[/b][/color], this Joker gains [color=\"#f3a712\"][b]triple[/b][/color] its rank as [color=\"#3772ff\"][b]Points[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_vesti_la_guibba"] = { name = "Vesti la Giubba", text = "If [color=\"#f3a712\"][b]played hand[/b][/color] contains a [color=\"#f3a712\"][b]Straight[/b][/color], create a random [color=\"#009dff\"][b]Common[/b][/color] or [color=\"#1bb18c\"][b]Uncommon[/b][/color] Joker\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_vexed"] = { name = "Vexed", text = "[color=\"#f3a712\"][b]Sold[/b][/color] Jokers have a fixed [color=\"#f3a712\"][b]#1#%[/b][/color] chance to reappear [color=\"#f3a712\"][b]immediately[/b][/color]" },
    ["j_aij_vintage_joker"] = { name = "Vintage Joker", text = "" },
    ["j_aij_visage"] = { name = "Visage", text = "When a hand is played, add a [color=\"#f3a712\"][b]temporary copy[/b][/color] of the last [color=\"#ff007f\"][b]destroyed[/b][/color] [color=\"#f3a712\"][b]face[/b][/color] card to scored hand\n[color=\"#9a9a9a\"](Does not change hand type)[/color]" },
    ["j_aij_vitellary_credits_joker"] = { name = "Vitellary", text = "[color=\"#9a9a9a\"]\"Learning everything all the time\"[/color]" },
    ["j_aij_vitruvian_joker"] = { name = "Vitruvian Clown", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if exactly [color=\"#f3a712\"][b]5[/b][/color] Jokers are owned" },
    ["j_aij_void"] = { name = "Void", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if no [color=\"#13afce\"][b]Fruit[/b][/color] cards have been used this [color=\"#f3a712\"][b]Ante[/b][/color] [color=\"#9a9a9a\"]#2#[/color]" },
