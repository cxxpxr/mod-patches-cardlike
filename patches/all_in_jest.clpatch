B.add { key = 'the_day', min = 1, colour = 'fda9c0', y = 46, canPlayHand = function(state, hand) return handHasSuit(hand, 'Hearts', 'Diamonds') end }

local function enhancementPool()
  local out = {}
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id ~= 'Default' and e.id ~= 'Prismatic' then out[#out + 1] = e.id end
  end
  return out
end

B.add {
  key = 'the_elbow', min = 3, colour = 'd3c1c1', y = 28, gate = B.hasEnhanced(4),
  on = {
    beforeAllCardsScored = function(state, step)
      local pool = enhancementPool()
      for _, c in ipairs(step.hand.allCards or {}) do
        if B.enhanced(c) then
          local e = AIJ.pick(pool, state)
          if e then
            c:setEnhancement(e)
            c:punch()
          end
        end
      end
    end,
  },
}

B.add {
