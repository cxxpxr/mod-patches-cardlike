  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 19, y = 4 },
  blueprint_compat = false,
}

cardlike.filter('cardBonuses', function(list, card, held)
  local state = st()
  if held or type(card) ~= 'table' or not state or not active(state, 'red_sky') or not firstOrLastHand(state) then return nil end
  local points = AIJ.safe(card.getPointValue, card) or 0
  if AIJ.hasEnhancement(card, 'm_bonus') then points = points + 30 end
  if points <= 0 then return nil end
  local out = {}
  for _, b in ipairs(list or {}) do out[#out + 1] = b end
  out[#out + 1] = plusChips(-points)
  out[#out + 1] = plusMult(points)
  return out
end)

AIJ.addJoker {
  key = 'red_wine',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 24, y = 3 },
  blueprint_compat = false,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      local first = (step.hand.playedCards or {})[1]
      if not first or AIJ.noRank(first) or not AIJ.exists(first) or AIJ.isSuit(first, 'Hearts', state) then return end
      first:setSuit('Hearts')
      first:popup('Hearts', AIJ.SUIT_COLORS.Hearts)
    end,
  },
}

AIJ.addJoker {
  key = 'remina',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 6, y = 13 },
  config = { mult = 0, chips = 0 },
  vars = function(card) return { AIJ.val(card, 'remina', 'mult'), AIJ.val(card, 'remina', 'chips') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy or (state.blind and state.blind.boss) then return end
      local gained = false
      for _, c in ipairs(state.consumables or {}) do
        if consumableType(c) == 'fruit' then
          local hand, kind = fruitInfo(c)
          local h = hand and state:getHand(hand)
          c:destroy()
          if h then
            if kind == 'mult' then
              AIJ.add(joker, 'mult', 2 * (h.multPerLevel or 0))
            elseif kind == 'chips' then
              AIJ.add(joker, 'chips', 2 * (h.chipsPerLevel or 0))
            else
              AIJ.add(joker, 'mult', h.multPerLevel or 0)
              AIJ.add(joker, 'chips', h.chipsPerLevel or 0)
            end
            gained = true
          end
        end
      end
      if gained then result:say(upgradeText(), colors.MULT) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m, c = AIJ.num(joker, 'mult'), AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
