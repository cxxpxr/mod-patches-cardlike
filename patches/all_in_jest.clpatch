AIJ.addJoker {
  key = 'hallucinaut',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 28 },
  config = { xmult = 1, xmult_gain = 0.5 },
  vars = function(card) return { AIJ.val(card, 'hallucinaut', 'xmult_gain'), AIJ.val(card, 'hallucinaut', 'xmult') } end,
  triggers = {
    onPackOpened = function(joker, state, step, result)
