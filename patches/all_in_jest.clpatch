    ["j_aij_a_v_g_m"] = { name = "A. V. G. M", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Spend [color=\"#f3a712\"][b]$#2#[/b][/color] for a [color=\"#f3a712\"][b]#1#%[/b][/color] chance to create a [color=\"#f3a712\"][b]completely random[/b][/color] Joker, consumable, playing card, or pin" },
    ["j_aij_a_young_hamlet"] = { name = "A Young Hamlet", text = "This Joker gains [color=\"#ff007f\"][b]+#2#[/b][/color] Mult every [color=\"#f3a712\"][b]#3#[/b][/color][color=\"#9a9a9a\"] [#4#][/color] cards [color=\"#ff007f\"][b]discarded[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
