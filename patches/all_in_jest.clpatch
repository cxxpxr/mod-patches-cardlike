local auto = { queue = 0, panel = nil, lastMove = -10 }

local function autoOpen()
  local state = cardlike.state
  if not state or state.money == nil then auto.queue = 0 return end
  if auto.panel and auto.panel.isOpen() then return end
  if auto.queue <= 0 then return end
  local deck = state.unDrawnCards or {}
  if #deck == 0 then auto.queue = 0 return end
  auto.queue = auto.queue - 1
  local choices = AIJ.shuffled(deck, state)
  local ui = cardlike.ui
  local buttons = {}
  for i = 1, math.min(3, #choices) do
    local c = choices[i]
    buttons[#buttons + 1] = ui.button {
      label = cardName(c),
      onPress = function()
        auto.lastMove = cardlike.time()
        AIJ.safe(c.moveTo, c, 'hand')
        if auto.panel then auto.panel.close() end
        auto.panel = nil
        autoOpen()
      end,
    }
  end
  auto.panel = ui.open {
    modal = true,
    closeOnEscape = false,
    content = ui.column { style = 'window', gap = 12, align = 'center',
      ui.text { text = 'Autogenes: choose a card to draw', color = colors.ORANGE },
      ui.column { gap = 8, align = 'center', table.unpack(buttons) },
    },
  }
end

AIJ.addJoker {
  key = 'autogenes',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 20, y = 46 }, soul_pos = { x = 21, y = 46 },
  config = { draw_amt = 1, choose_amt = 3 },
  vars = function(card) return { AIJ.val(card, 'autogenes', 'choose_amt'), AIJ.val(card, 'autogenes', 'draw_amt') } end,
  triggers = {
    onHandDrawn = function(joker, state, step, result)
      if cardlike.time() - auto.lastMove < 0.5 then return end
      if #(state.unDrawnCards or {}) == 0 then return end
      auto.queue = auto.queue + AIJ.num(joker, 'draw_amt')
      autoOpen()
    end,
  },
}

cardlike.on('onRunStart', function() auto.queue = 0 end)

AIJ.addJoker {
  key = 'average_joe',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 5 },
  config = { percent = 20 },
  vars = function(card) return { AIJ.val(card, 'average_joe', 'percent') } end,
