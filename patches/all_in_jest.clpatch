local AIJ = cardlike.require('lib.aij')

local ENHANCED = '#8389DD'
local RARITY_COLORS = { Common = '#009dff', Uncommon = '#4BC292', Rare = '#fe5f55', Legendary = '#b26cbb' }

local function fixText(t)
  t = t:gsub('Game [Cc]ard card', 'Game card')
  t = t:gsub('Booster Pack', 'Pack')
  t = t:gsub('Bonus Card', 'Chipped card')
  return t
end

local function D(key, varsFn, edit)
  local e = AIJ.loc('Joker', 'j_aij_' .. key)
  local text = fixText(e and e.text or '')
  if edit then text = edit(text) end
  return function(r)
    local vars = {}
    if varsFn then
      local ok, v = pcall(varsFn, r and r.card, r)
      if ok and type(v) == 'table' then vars = v end
    end
    return AIJ.fill(text, vars)
  end
end

local function ofList(state, key)
  local ok, v = pcall(function() return state[key] end)
  if ok and type(v) == 'table' then return v end
  return {}
end

local function owned(state, id)
  local out = {}
  for _, j in ipairs(ofList(state, 'jokers')) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function indexOf(list, card)
  if not card then return nil end
  for i, c in ipairs(list) do
    if c.uid == card.uid then return i end
  end
  return nil
end

local function rarityOf(card)
  local info = card and card.lastInfo or {}
  return info.rarity or AIJ.safe(card.getRarity, card)
end

local function isBoss(state, blindId)
  local b = state.blind
  if b and b.boss ~= nil then return b.boss == true end
  local info = blindId and cardlike.contentInfo('blind', blindId)
  return info and info.boss == true or false
end

local function deckHas(state, fn)
  if not state then return false end
  for _, c in ipairs(ofList(state, 'allCards')) do
    if fn(c) then return true end
  end
  return false
end

local function rollEdition(state, allowInverted)
  local r = state:randomFloat()
  if allowInverted and r > 0.925 then return 'Inverted' end
  if r > 0.85 then return 'Chroma' end
  if r > 0.5 then return 'Holo' end
  return 'Luna'
end

local function odds(n) return AIJ.prob() * (n or 1) end

local ABILITIES = {}

local function abilityButton(id)
  local a = ABILITIES[id]
  return AIJ.ability(id, {
    label = function(card, state)
      local cost = a.cost and a.cost(card) or 0
      if cost > 0 then return (a.label or 'USE') .. ' $' .. AIJ.fmt(cost) end
      return a.label or 'USE'
    end,
    canPress = function(card, state, opts)
      if AIJ.isDebuffed(card) then return false end
      return a.can(card, state, opts) == true
    end,
    press = function(card, state, opts)
      return a.use(card, state, { free = opts and opts.free == true })
    end,
  })
end

local function paid(card, state, args, cost)
  if not args.free then state:mutateMoney(-cost) end
end

local function canPay(state, cost, opts) return (opts and opts.free == true) or (state.money or 0) >= cost end

AIJ.addJoker {
  key = 'event_horizon',
  rarity = 3, cost = 8, lite = true, atlas = 'joker_atlas', pos = { x = 13, y = 6 },
  config = { xmult_mod = 0.2, xmult = 1, last_hand = '' },
  description = D('event_horizon', function(card)
    local last = AIJ.val(card, 'event_horizon', 'last_hand', '')
    return { AIJ.val(card, 'event_horizon', 'xmult_mod'), AIJ.val(card, 'event_horizon', 'xmult'),
      (last ~= '' and AIJ.handName(last)) or 'None' }
  end, function(t) return (t:gsub('#3##', '#3#')) end),
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

cardlike.filter('handLevel', function(levels, handType)
  local state = cardlike.state
  if not state or type(levels) ~= 'number' or levels <= 0 then return nil end
  for _, j in ipairs(owned(state, 'event_horizon')) do
    if levels > 1 or AIJ.get(j, 'last_hand') == handType then
      AIJ.set(j, 'xmult', 1)
      j:popup('Reset', colors.RED)
    else
      AIJ.set(j, 'last_hand', handType)
      local x = AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
      j:popup('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
    end
  end
  return nil
end)

AIJ.addJoker {
  key = 'evil_joker',
  rarity = 3, cost = 8, lite = true, atlas = 'joker_atlas', pos = { x = 18, y = 13 },
  config = { x_mult = 3 },
  vars = function(card) return { AIJ.val(card, 'evil_joker', 'x_mult') } end,
  onAdded = function(joker, state)
    local pool = {}
    for _, j in ipairs(ofList(state, 'jokers')) do
      if j.uid ~= joker.uid and not AIJ.safe(j.isLocked, j) then pool[#pool + 1] = j end
    end
    local victim = AIJ.pick(pool, state)
    if victim then victim:destroy() end
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      result:add(xMult(AIJ.num(joker, 'x_mult')))
    end,
  },
}

AIJ.addJoker {
  key = 'executioner',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 6 },
  config = { chips = 0, chip_gain = 50 },
  vars = function(card) return { AIJ.val(card, 'executioner', 'chip_gain'), AIJ.val(card, 'executioner', 'chips') } end,
  triggers = {
    onCardsRemoved = function(joker, state, step, result)
      if step.copiedBy then return end
      local faces = 0
      for _, c in ipairs(step.cards or {}) do
        if c.lastInfo and c.lastInfo.face then faces = faces + 1 end
      end
      if faces > 0 then
        AIJ.add(joker, 'chips', faces * AIJ.num(joker, 'chip_gain'))
        result:say('+' .. AIJ.fmt(AIJ.num(joker, 'chips')) .. ' Points', colors.CHIPS)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.onNewRun(function(run) run.eye_test_last_size = nil end)

AIJ.addJoker {
  key = 'eye_test',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 4, y = 25 },
  config = { mult = 5, count = 0 },
  vars = function(card)
    return { AIJ.val(card, 'eye_test', 'mult'), AIJ.val(card, 'eye_test', 'count') * AIJ.val(card, 'eye_test', 'mult') }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local size = #(step.hand.allCards or {})
      local last = AIJ.run.eye_test_last_size
      if last and size > last then
        AIJ.add(joker, 'count', 1)
        result:say('Upgrade!', colors.MULT)
      else
        AIJ.set(joker, 'count', 0)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local n = AIJ.num(joker, 'count')
      if n > 0 then result:add(plusMult(n * AIJ.num(joker, 'mult'))) end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.run.eye_test_last_size = #(step.hand.allCards or {})
    end,
  },
}

