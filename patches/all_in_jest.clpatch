AIJ.addJoker {
  key = 'adoring_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 13, y = 2 },
  config = { highest_mult = 0 },
  vars = function(card) return { AIJ.val(card, 'adoring_joker', 'highest_mult') } end,
  blueprint_compat = false,
  triggers = {
    finalScoring = function(joker, state, step, result)
      if step.copiedBy then return end
      local m = state.currentMult or 0
      local h = math.max(AIJ.num(joker, 'highest_mult'), m)
      AIJ.set(joker, 'highest_mult', h)
      if h > m then
        result:add(plusMult(h - m))
        result:say(AIJ.fill(AIJ.msg('a_aij_mult_equal', '=#1# Mult'), { h }), colors.MULT)
      end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if state.blind and state.blind.boss then AIJ.set(joker, 'highest_mult', 0) end
    end,
  },
}

