== file items/astrals.lua (443 lines)
local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.tarots')

local A = {}

AIJ.onNewRun(function(run)
  run.astral_pins = {}
  run.astral_pin_per_hand = 3
  run.astral_played_round = {}
end)

local GRADES = { 'Retrograde', 'Passigrade', 'Prograde' }
local NO_ALIGN = { ROYAL_FLUSH = true }

local ASTRALS = {
  { key = 'algol', pos = { x = 10, y = 3 }, config = { dollars = 2 }, grades = { Retrograde = 0.3, Passigrade = 0.6 },
    vars = function(v) return { v.dollars } end },
  { key = 'alcyone', pos = { x = 11, y = 3 }, config = { draw_amt = 1 }, grades = { Retrograde = 0.3, Passigrade = 0.5 },
    vars = function(v) return { v.draw_amt } end },
  { key = 'aldebaran', pos = { x = 12, y = 3 }, config = { percent = 20 }, grades = { Retrograde = 0.4, Passigrade = 0.4 },
    vars = function(v) return { v.percent } end },
  { key = 'capella', pos = { x = 9, y = 3 }, config = { odds = 2 }, grades = { Retrograde = 0.3, Passigrade = 0.6 },
    vars = function(v) return { AIJ.prob(), v.odds } end },
  { key = 'sirius', pos = { x = 8, y = 3 }, config = { cards = 1 }, grades = { Retrograde = 0.15, Passigrade = 0.55 },
    vars = function(v) return { v.cards } end },
  { key = 'procyon', pos = { x = 8, y = 5 }, config = { sell_val = 2 }, grades = { Retrograde = 0.5, Passigrade = 0.4 },
    vars = function(v) return { v.sell_val } end },
  { key = 'regulus', pos = { x = 9, y = 5 }, config = { odds = 6 }, grades = { Retrograde = 0.4, Passigrade = 0.4 },
    vars = function(v) return { AIJ.prob(), v.odds } end },
  { key = 'alkaid', pos = { x = 10, y = 5 }, config = { cards = 1 }, grades = { Retrograde = 0.25, Passigrade = 0.65 },
    vars = function(v) return { v.cards } end },
  { key = 'algorab', pos = { x = 11, y = 5 }, config = { odds = 4 }, grades = { Retrograde = 0.3, Passigrade = 0.6 },
    vars = function(v) return { AIJ.prob(), v.odds } end },
  { key = 'spica', pos = { x = 12, y = 5 }, config = {}, grades = { Retrograde = 0.01, Passigrade = 0.5 },
    vars = function(v) return {} end },
  { key = 'arcturus', pos = { x = 13, y = 5 }, config = { discards = 1 }, grades = { Retrograde = 0.4, Passigrade = 0.4 },
    vars = function(v) return { v.discards } end },
  { key = 'antares', pos = { x = 15, y = 5 }, config = {}, grades = { Retrograde = 0.1, Passigrade = 0.45 },
    vars = function(v) return {} end },
  { key = 'vega', pos = { x = 16, y = 5 }, config = {}, grades = { Retrograde = 0.2, Passigrade = 0.6 },
    vars = function(v) return {} end },
  { key = 'deneb_algedi', pos = { x = 17, y = 5 }, config = { hands = 1 }, grades = { Retrograde = 0.3, Passigrade = 0.6 },
    vars = function(v) return { v.hands } end },
}
local BY_KEY = {}
for _, a in ipairs(ASTRALS) do BY_KEY[a.key] = a end
A.ASTRALS = ASTRALS

function A.rollGrade(state, grades)
  grades = grades or { Retrograde = 0.1, Passigrade = 0.45 }
  local r = state:randomFloat()
  local retro, passi = grades.Retrograde or 0, grades.Passigrade or 0
  if r <= retro then return 'Retrograde' end
  if r <= retro + passi then return 'Passigrade' end
  return 'Prograde'
end

local function played(state, h)
  local info = H.handInfo(state, h)
  return info and info.played or 0
end

function A.handFromGrade(state, grade, cur)
  local vis = H.visibleHands(state, NO_ALIGN)
  if #vis == 0 then return 'HIGH_CARD' end
  if grade == 'Retrograde' then
    local best, tally = vis[1], played(state, vis[1])
    for i = 2, #vis do
      if played(state, vis[i]) > tally then best, tally = vis[i], played(state, vis[i]) end
    end
    return best
  end
  if cur then return cur end
  if grade == 'Prograde' then
    local max = 0
    for _, h in ipairs(vis) do max = math.max(max, played(state, h)) end
    local valid = {}
    for _, h in ipairs(vis) do if played(state, h) < max then valid[#valid + 1] = h end end
    if #valid == 0 then valid = vis end
    return AIJ.pick(valid, state)
  end
  return AIJ.pick(vis, state)
end

local function isAstral(card)
  local t = AIJ.safe(card.getConsumableType, card)
  return t ~= nil and AIJ.isId(t, 'astral')
end

function A.ensure(card, state, grade)
  if not card or not state or not state.hands then return end
  local ds = card:getDataStore()
  if grade then
    ds:set('aij_grade', grade)
    ds:delete('aij_hand')
  end
  if not ds:get('aij_grade') then
    local def = BY_KEY[AIJ.short(AIJ.defId(card) or '')]
    ds:set('aij_grade', A.rollGrade(state, def and def.grades))
  end
  if not ds:get('aij_hand') then
    ds:set('aij_hand', A.handFromGrade(state, ds:get('aij_grade')))
  end
end

function A.handOf(card, state)
  local ds = card:getDataStore()
  local grade = ds:get('aij_grade')
  if grade == 'Retrograde' and state and state.hands then return A.handFromGrade(state, grade) end
  return ds:get('aij_hand')
end

function A.create(ctx, grade)
  local card = H.create(ctx, AIJ.id('astral'))
  if card then A.ensure(card, ctx.state, grade) end
  return card
end

cardlike.on('onCardCreated', function(state, step)
  local card = step and step.card
  if not state or not card or AIJ.safe(card.getKind, card) ~= 'consumable' then return end
  if isAstral(card) then A.ensure(card, state) end
end)

local function pins(h)
  AIJ.run.astral_pins = AIJ.run.astral_pins or {}
  return AIJ.run.astral_pins[h] or {}
end
A.pins = pins

local function pinName(key)
  local e = AIJ.loc('aij_astral', 'c_aij_' .. key .. '_pin') or AIJ.loc('aij_astral', 'c_aij_' .. key)
  return e and e.name or key
end
A.pinName = pinName

local function perHand() return AIJ.run.astral_pin_per_hand or 3 end

local function valuesOf(card, def)
  local v = {}
  for k in pairs(def.config) do v[k] = tonumber(AIJ.get(card, k, def.config[k])) or def.config[k] end
  return v
end

local function pinText(pin, h, state)
  local def = BY_KEY[pin.pin]
  if not def then return '' end
  local e = AIJ.loc('aij_astral', 'c_aij_' .. pin.pin .. '_pin')
  if not e then return '' end
  local vars = { AIJ.handName(h) }
  for _, x in ipairs(def.vars(pin.v or def.config)) do vars[#vars + 1] = x end
  if pin.pin == 'spica' then
    local active = state and state.blind and state.blind.boss and not state.bossDisabled
    vars = { active and '(Active)' or '(Inactive)' }
  elseif pin.pin == 'deneb_algedi' then
    vars[3] = (AIJ.run.astral_played_round or {})[h] and '(Inactive)' or '(Active)'
  end
  return AIJ.fill(e.text, vars)
end
A.pinText = pinText

local function addPin(h, pin, index)
  AIJ.run.astral_pins = AIJ.run.astral_pins or {}
  local list = AIJ.run.astral_pins[h] or {}
  if index then list[index] = pin else list[#list + 1] = pin end
  AIJ.run.astral_pins[h] = list
end

local function useAstral(ctx, def)
  local state = ctx.state
  A.ensure(ctx.self, state)
  local h = A.handOf(ctx.self, state) or 'HIGH_CARD'
  local pin = { pin = def.key, v = valuesOf(ctx.self, def) }
  local list = pins(h)
  if #list < perHand() then
    addPin(h, pin)
    cardlike.centerText(AIJ.handName(h) .. ' aligned to ' .. pinName(def.key), 1.5)
    return
  end
  local handle
  handle = H.pickPanel {
    title = 'Align ' .. AIJ.handName(h) .. ' to ' .. pinName(def.key),
    text = 'Choose an alignment to replace',
    columns = 1,
    items = function()
      local items = {}
      for i, p in ipairs(pins(h)) do
        items[#items + 1] = {
          label = 'Replace ' .. pinName(p.pin),
          color = AIJ.colors.ASTRAL,
          onPress = function()
            addPin(h, pin, i)
            if handle then handle.close() end
          end,
        }
      end
      return items
    end,
  }
end

local function astralDescription(def)
  return function(r)
    local card = r and r.card
    local state = cardlike.state
    local e = AIJ.loc('aij_astral', 'c_aij_' .. def.key) or { text = '' }
    local h = card and state and state.hands and A.handOf(card, state)
    local v = card and valuesOf(card, def) or def.config
    local vars = { h and AIJ.handName(h) or '(hand)' }
    for _, x in ipairs(def.vars(v)) do vars[#vars + 1] = x end
    local text = AIJ.fill(e.text, vars)
    local grade = card and card:getDataStore():get('aij_grade')
    if grade then
      local g = AIJ.loc('Other', 'aij_astral_' .. grade:lower())
      if g then text = text .. '\n' .. colorize(bold(g.name .. ':'), AIJ.colors.ASTRAL) .. ' ' .. g.text end
    end
    if h then
      local left = math.max(perHand() - #pins(h), 0)
      text = text .. '\n' .. colorize('(' .. left .. ' slots left)', colors.GREY)
    end
    return text
  end
end

for _, def in ipairs(ASTRALS) do
  H.add {
    key = def.key, type = 'astral', set = 'aij_astral', pos = def.pos,
    soul_pos = { x = def.pos.x, y = def.pos.y + 1 }, cost = 4,
    config = def.config,
    description = astralDescription(def),
    action = function(ctx) useAstral(ctx, def) end,
  }
end

local function each(h, key, fn)
  for _, p in ipairs(pins(h)) do
    if p.pin == key then fn(p.v or BY_KEY[key].config, p) end
  end
end

local sirius = {}
local alcyoneDraw = 0
local playingHand = nil

cardlike.on('onRoundStart', function()
  AIJ.run.astral_played_round = {}
  alcyoneDraw = 0
end)

local function enhanceable(state)
  return H.enhancementPool({ Rock = true, canvas = true })
end

cardlike.on('beforeAllCardsScored', function(state, step, result)
  local h = step and step.hand and step.hand.handType
  playingHand = h
  sirius = {}
  if not h or NO_ALIGN[h] then return end
  AIJ.run.astral_played_round = AIJ.run.astral_played_round or {}
  local scoring = step.hand.playedCards or {}

  each(h, 'deneb_algedi', function(v)
    if not AIJ.run.astral_played_round[h] then
      state.handsLeft = state.handsLeft + (v.hands or 1)
      result:say('+' .. AIJ.fmt(v.hands or 1) .. ' Hand', colors.CHIPS)
    end
  end)
  each(h, 'regulus', function(v)
    if state:chance(1 / math.max(1, v.odds or 6)) then
      state:upgradeHand(h, 1)
      result:say('Level up!', colors.ORANGE)
    end
  end)
  each(h, 'alkaid', function(v)
    for _ = 1, math.max(1, math.floor(v.cards or 1)) do
      local valid = {}
      for _, c in ipairs(scoring) do if not AIJ.enhancement(c) then valid[#valid + 1] = c end end
      if #valid == 0 then break end
      local c = AIJ.pick(valid, state)
      c:setEnhancement(AIJ.pick(enhanceable(state), state))
      c:punch()
      result:say('Change!', colors.PURPLE, c)
    end
  end)
  each(h, 'procyon', function(v)
    local j = AIJ.pick(state.jokers or {}, state)
    if j then
      j:addSellValue(v.sell_val or 2)
      result:say('Value Up!', colors.MONEY, j)
    else
      result:say('Nope!', AIJ.colors.TAROT)
    end
  end)
  local spicaDone = false
  each(h, 'spica', function(v, p)
    if spicaDone then return end
    if state.blind and state.blind.boss and not (state.bossDisabled or state.blind.disabled) then
      spicaDone = true
      state:disableBoss()
      local list = pins(h)
      for i, q in ipairs(list) do
        if q == p then table.remove(list, i) break end
      end
      result:say('Boss Blind disabled', colors.ORANGE)
    end
  end)
  each(h, 'sirius', function(v)
    for _ = 1, math.max(1, math.floor(v.cards or 1)) do
      local c = AIJ.pick(scoring, state)
      if c then sirius[c.uid] = (sirius[c.uid] or 0) + 1 end
    end
  end)
  each(h, 'alcyone', function(v) alcyoneDraw = alcyoneDraw + (v.draw_amt or 1) end)
  AIJ.run.astral_played_round[h] = true
end)

local function balance(state, pct)
  pct = math.min(pct, 1)
  local chips, mult = state.currentChips or 0, state.currentMult or 0
  local cm, mm = pct * chips, pct * mult
  local avg = (cm + mm) / 2
  state.currentChips = math.floor((chips + (avg - cm)) * 100 + 0.5) / 100
  state.currentMult = math.floor((mult + (avg - mm)) * 100 + 0.5) / 100
end
A.balance = balance

local okP, P = pcall(cardlike.require, 'items.planets')
local function onBase(state, h, result)
  each(h, 'aldebaran', function(v)
    local pct = (v.percent or 20) / 100
    balance(state, pct)
    if result then result:say(AIJ.fmt(pct * 100) .. '% Balance', AIJ.colors.PLASMA) end
  end)
end
if okP and type(P) == 'table' and P.onHandBase then
  P.onHandBase(onBase)
else
  local pending = false
  cardlike.on('beforeAllCardsScored', function() pending = true end)
  cardlike.on('beforeScore', function(state, step, result)
    if pending then
      pending = false
      if playingHand then onBase(state, playingHand, result) end
    end
  end)
end

cardlike.on('repeatCard', function(state, step)
  local c = step and step.card
  if c and sirius[c.uid] then return sirius[c.uid] end
end)

cardlike.on('repeatHeldCard', function(state, step)
  local h = playingHand
  if not h or not step or not step.card then return end
  local n = 0
  each(h, 'vega', function() n = n + 1 end)
  if n == 0 then return end
  local first = H.byIndex(state.cardsInHand)[1]
  if first and first == step.card then return n end
end)

cardlike.on('afterHand', function(state, step, result)
  local h = playingHand
  sirius = {}
  if not h then return end
  each(h, 'algol', function(v) result:add(plusMoney(v.dollars or 2)) end)
  each(h, 'algorab', function(v)
    if (state.freeConsumableSlots or 0) > 0 and state:chance(1 / math.max(1, v.odds or 4)) then
      cardlike.createConsumable('game')
      result:say('+1 Game Card', AIJ.colors.TAROT)
    else
      result:say('Nope!', AIJ.colors.TAROT)
    end
  end)
  each(h, 'capella', function(v)
    if (state.freeConsumableSlots or 0) > 0 and state:chance(1 / math.max(1, v.odds or 2)) then
      cardlike.createConsumable('fruit')
      result:say('+1 Fruit Card', AIJ.colors.PLANET)
    else
      result:say('Nope!', AIJ.colors.TAROT)
    end
  end)
  each(h, 'antares', function()
    local c = AIJ.pick(state.cardsInHand or {}, state)
    if c then
      c:destroy()
      result:say('Destroyed!', colors.RED)
    end
  end)
  each(h, 'arcturus', function(v)
    local n = v.discards or 1
    state.discardsLeft = state.discardsLeft + n
    result:say('+' .. AIJ.fmt(n) .. ' Discard' .. (n == 1 and '' or 's'), colors.RED)
  end)
end)

cardlike.on('onDiscard', function() alcyoneDraw = 0 end)
cardlike.on('onHandDrawn', function(state, step)
  if step and step.first then alcyoneDraw = 0 return end
  if alcyoneDraw > 0 then
    local n = alcyoneDraw
    alcyoneDraw = 0
    cardlike.drawCards(n)
  end
end)

local shownHand = nil
local panel = nil

local function openPanel()
  local ui = cardlike.ui
  if not ui or not ui.open or (panel and panel.isOpen()) then return end
  panel = ui.open {
    at = 'topRight',
    offset = { x = -20, y = 180 },
    content = function()
      local state = cardlike.state
      if not state or state.money == nil or not shownHand then return nil end
      local list = pins(shownHand)
      if #list == 0 then return nil end
      local col = { style = 'window', gap = 4, align = 'start',
        ui.text { text = AIJ.handName(shownHand) .. ' alignments', size = 18, color = AIJ.colors.ASTRAL } }
      for _, p in ipairs(list) do
        col[#col + 1] = ui.text { text = pinName(p.pin), size = 16, color = colors.ORANGE }
      end
      return ui.column(col)
    end,
  }
end

cardlike.on('onCardSelected', function(state)
  local sel = state.selectedCards or {}
  if #sel == 0 then shownHand = nil return end
  local r = cardlike.evaluateHand(sel)
  shownHand = r and r.handType or nil
  if shownHand and #pins(shownHand) > 0 then openPanel() end
end)
cardlike.on('onRunStart', function() shownHand = nil end)
cardlike.on('afterHand', function() shownHand = nil end)

return A


== file items/blinds_boss.lua (1120 lines)
local AIJ = cardlike.require('lib.aij')

local B = {}
B.specs = {}
B.list = {}

local function initRun(run)
  if run.blinds_serial ~= nil then return run end
  run.blinds_serial = 0
  run.blinds_ante_serial = 1
  run.blinds_ante = { defeated = 0, skipped = 0, unused = 0, excess = 0, spent = 0, hands = {} }
  run.blinds_used = {}
  run.blinds_connection = 0
  run.blinds_journey = false
  run.blinds_won = false
  return run
end
AIJ.onNewRun(initRun)
local function RUN() return initRun(AIJ.run) end
function B.run() return RUN() end

local V = {}
local function resetV()
  V = { debuffed = {}, jdebuffed = {}, flipped = {}, face = {}, seen = {}, mark = {}, keep = nil, known = nil }
end
resetV()
function B.V() return V end

local function hash(s)
  local h = 5381
  for i = 1, #s do h = (h * 33 + s:byte(i)) % 2147483647 end
  return h
end
B.hash = hash

local function info(c) return (type(c) == 'table' and c.lastInfo) or {} end

function B.suit(c, s)
  return AIJ.isSuit(c, s) == true
end

function B.face(c)
  local i = info(c)
  if i.face ~= nil then return i.face == true end
  return AIJ.safe(c.isFace, c) == true
end

function B.rank(c)
  local i = info(c)
  if i.noRank or i.enhancement == 'Rock' then return nil end
  return i.rank or AIJ.safe(c.getRank, c)
end

function B.enhanced(c)
  local e = info(c).enhancement
  if e == nil then e = AIJ.enhancement(c) end
  return e ~= nil and e ~= '' and e ~= 'Default'
end

function B.store(c, key)
  local i = info(c)
  if i.store ~= nil then return i.store[key] end
  if i.uid ~= nil then return nil end
  local ds = AIJ.safe(c.getDataStore, c)
  return ds and ds:get(key)
end

function B.setStore(c, key, v)
  local ds = AIJ.safe(c.getDataStore, c)
  if ds then ds:set(key, v) end
end

local function uid(c) return type(c) == 'table' and (c.uid or info(c).uid) or nil end
B.uid = uid

function B.enhancedCount(state)
  local n = 0
  for _, c in ipairs(state.allCards or {}) do if B.enhanced(c) then n = n + 1 end end
  return n
end

function B.hasEnhanced(n) return function(state) return B.enhancedCount(state) >= n end end

function B.playedThisAnte(c) return B.store(c, 'aij_played_ante') == RUN().blinds_ante_serial end
function B.discardedThisAnte(c) return B.store(c, 'aij_discarded_ante') == RUN().blinds_ante_serial end

B.PC = { perishable = 'aij_pc_perishable', rental = 'aij_pc_rental', eternal = 'aij_pc_eternal', marked = 'aij_marked', perma = 'aij_perma_debuff' }
function B.setPcSticker(c, which)
  if which == 'perishable' then
    if B.store(c, B.PC.eternal) then return end
    B.setStore(c, B.PC.perishable, true)
    B.setStore(c, 'aij_perish_tally', 5)
  elseif which == 'eternal' then
    if B.store(c, B.PC.perishable) then return end
    B.setStore(c, B.PC.eternal, true)
  else
    B.setStore(c, B.PC[which], true)
  end
  AIJ.safe(c.punch, c)
end

function B.permaDebuffed(c) return B.store(c, B.PC.perma) == true end
function B.stayDebuffed(c)
  if B.permaDebuffed(c) then return true end
  return B.store(c, B.PC.perishable) == true and (tonumber(B.store(c, 'aij_perish_tally')) or 5) <= 0
end

function B.jokerSticker(j)
  local s = info(j).sticker
  if s == nil then s = AIJ.safe(j.getSticker, j) end
  return s or 'none'
end
function B.jokerLocked(j) return info(j).locked == true or B.jokerSticker(j) == 'locked' end

function B.handScore(state) return (state.currentChips or 0) * (state.currentMult or 0) end
function B.wins(state) return (state.score or 0) + B.handScore(state) >= ((state.blind and state.blind.target) or math.huge) end

function B.say(text, colour) if cardlike.centerText then cardlike.centerText(text, 2) end end

function B.specOf(id)
  if id == nil then return nil end
  return B.specs[id] or B.specs[AIJ.id(id)]
end

function B.current(state)
  state = state or cardlike.state
  local b = state and state.blind
  return b and B.specOf(b.id) or nil
end

function B.R() return RUN().blinds_round end

function B.live(state, any)
  local spec = B.current(state)
  local R = B.R()
  if not spec or not R or R.key ~= spec.key then return nil end
  if not any and state.bossDisabled then return nil end
  return spec, R
end

local function releaseCards(state)
  for _, c in ipairs(state.cardsInHand or {}) do
    local u = uid(c)
    if u and V.debuffed[u] and not B.stayDebuffed(c) then AIJ.safe(c.setDebuffState, c, false) end
    if u and V.flipped[u] and info(c).flipped then AIJ.safe(c.flip, c, false) end
  end
  for _, j in ipairs(state.jokers or {}) do
    local u = uid(j)
    if u and V.jdebuffed[u] then AIJ.safe(j.setDebuffState, j, false) end
  end
  V.debuffed, V.flipped, V.jdebuffed = {}, {}, {}
end

function B.checkDisabled(state)
  local spec, R = B.live(state, true)
  if not spec or R.disabledDone or not state.bossDisabled then return end
  R.disabledDone = true
  releaseCards(state)
  if spec.disable then AIJ.safe(spec.disable, state, R) end
end

local function blindMult(state, spec)
  if spec then return spec.mult or 2 end
  local b = state.blind
  if not b.boss then
    if b.name == 'Alpha Blind' then return 1.5 end
    return 1
  end
  return b.mult or 2
end

cardlike.filter('blindTarget', function(value)
  local state = cardlike.state
  if not state or type(state.blind) ~= 'table' or type(value) ~= 'number' then return nil end
  local run = RUN()
  local spec = B.specOf(state.blind.id)
  local R = { key = spec and spec.key or nil, fresh = true, startMult = 0, startAdd = 0, dMult = 0, dAdd = 0 }
  R.base = value / blindMult(state, spec)
  run.blinds_round = R
  if AIJ.owns('fall_of_count_chaligny', state) then return nil end
  local out = value
  if not state.blind.boss and state.blind.name == 'Alpha Blind' and run.blinds_seed_ante == state.ante then
    out = R.base * 2
    run.blinds_seed_ante = nil
  end
  if spec and spec.target then
    local ok, m, a = pcall(spec.target, state, R)
    if ok then R.startMult, R.startAdd = m or 0, a or 0 end
  end
  R.flat = run.blinds_connection or 0
  out = out + R.base * R.startMult + R.startAdd + R.flat
  R.dynamic = spec and (spec.live ~= nil or spec.dynamic) or false
  if out ~= value then
    R.overridden = true
    return math.max(1, math.floor(out))
  end
end)

cardlike.hook('PlayState.effectiveBlindTarget', {
  after = function(self, result)
    local R = AIJ.run.blinds_round
    if type(result) ~= 'number' or type(R) ~= 'table' or not R.key or R.fresh then return nil end
    if not (R.dynamic or R.overridden) then return nil end
    local state = cardlike.state
    if not state then return nil end
    local spec = B.current(state)
    if not spec or spec.key ~= R.key then return nil end
    if state.bossDisabled then
      if R.overridden then return math.max(1, math.floor(R.base * 2 + (R.flat or 0))) end
      return nil
    end
    local dm = R.dMult or 0
    if spec.live then
      local ok, m = pcall(spec.live, state, R)
      if ok and type(m) == 'number' then dm = dm + m - (R.startMult or 0) end
    end
    local da = R.dAdd or 0
    if dm == 0 and da == 0 then return nil end
    if (R.base or 0) * dm + da > 0 and AIJ.owns('fall_of_count_chaligny', state) then return nil end
    return math.max(1, math.floor(result + (R.base or 0) * dm + da))
  end,
})

local function eligible(spec, state)
  if not spec.gate then return true end
  local ok, res = pcall(spec.gate, state)
  return (not ok) or res ~= false
end

local function isPitChallenge(state)
  return state.challenge ~= nil and AIJ.isId(state.challenge, 'the_pit')
end

local function pitAnte(state)
  local run = RUN()
  if type(run.pit_blind_ante) == 'number' then return run.pit_blind_ante end
  if not run.blinds_pit_ante then run.blinds_pit_ante = 4 + hash(tostring(state.seed) .. 'pit_blinds') % 2 end
  return run.blinds_pit_ante
end

function B.pitsOn(state)
  local blue = (state.stake or 1) >= 5 and AIJ.setting('blue_stake_rework') and state.ante == pitAnte(state)
  return blue or (isPitChallenge(state) and state.ante >= 2) or RUN().blinds_won == true
end

function B.pitsForced(state)
  if state.ante % 8 == 0 then return false end
  local blue = (state.stake or 1) >= 5 and AIJ.setting('blue_stake_rework') and state.ante == pitAnte(state)
  return blue or (isPitChallenge(state) and state.ante >= 2)
end

local function pickFrom(list, state, salt)
  if #list == 0 then return nil end
  table.sort(list)
  return list[hash(tostring(state.seed) .. ':' .. tostring(state.ante) .. ':' .. tostring(salt)) % #list + 1]
end

function B.chooseBoss(state, id)
  local finisherAnte = state.ante % 8 == 0
  local spec = B.specOf(id)
  local run = RUN()
  if B.pitsForced(state) then
    if spec and spec.kind == 'pit' and eligible(spec, state) then return nil end
    local pits = {}
    for _, s in ipairs(B.list) do
      if s.kind == 'pit' and eligible(s, state) then pits[#pits + 1] = s.full end
    end
    local fresh = {}
    for _, p in ipairs(pits) do if not run.blinds_used[p] then fresh[#fresh + 1] = p end end
    return pickFrom(#fresh > 0 and fresh or pits, state, id)
  end
  if not spec then return nil end
  local ok = eligible(spec, state) and (spec.kind ~= 'pit' or B.pitsOn(state))
  if ok then return nil end
  local all, fresh = {}, {}
  for _, b in ipairs(cardlike.listContent('blind') or {}) do
    if b.boss and (b.finisher == true) == finisherAnte and b.id ~= id and (b.minAnte or 1) <= state.ante then
      local s = B.specOf(b.id)
      local good = true
      if s then good = eligible(s, state) and (s.kind ~= 'pit' or B.pitsOn(state)) end
      if good then
        all[#all + 1] = b.id
        if not run.blinds_used[b.id] then fresh[#fresh + 1] = b.id end
      end
    end
  end
  return pickFrom(#fresh > 0 and fresh or all, state, id)
end

cardlike.filter('bossBlind', function(id)
  local state = cardlike.state
  if not state or type(state.ante) ~= 'number' or type(id) ~= 'string' then return nil end
  local ok, res = pcall(B.chooseBoss, state, id)
  local out = (ok and res) or id
  local run = RUN()
  run.blinds_next_boss, run.blinds_next_boss_ante = out, state.ante
  if ok and res then return res end
end)

function B.add(s)
  local e = AIJ.loc('Blind', 'bl_aij_' .. s.key) or {}
  s.full = AIJ.id(s.key)
  s.kind = s.kind or 'boss'
  s.mult = s.mult or 2
  local key = s.key
  local function mine(state)
    local spec, R = B.live(state)
    if spec and spec.key == key then return R end
  end
  local def = {
    id = key,
    name = s.name or e.name or key,
    description = s.description or AIJ.fill(e.text or '', s.vars or {}),
    color = '#' .. s.colour,
    minAnte = s.min or 1,
    mult = s.mult,
    reward = s.dollars or 5,
    finisher = s.kind == 'finisher' or nil,
    sprite = AIJ.sprite(s.atlas or 'blinds', 0, s.y),
    lite = s.lite,
    shouldDebuff = function(state, card)
      if B.permaDebuffed(card) then return true end
      local R = mine(state)
      return R ~= nil and s.debuff ~= nil and s.debuff(card, state, R) == true
    end,
    canPlayHand = function(state, hand)
      local R = mine(state)
      if not R or not s.canPlayHand then return true end
      return s.canPlayHand(state, hand, R) ~= false
    end,
    onRoundStart = function(state)
      local R = mine(state)
      if R and s.start then s.start(state, R) end
    end,
    onHandPlayed = function(state, hand)
      local R = mine(state)
      if R and s.played then s.played(state, hand, R) end
    end,
    onDefeated = function(state)
      local spec, R = B.live(state, true)
      if not spec or spec.key ~= key then return end
      if s.finish and not state.bossDisabled then s.finish(state, R) end
      if s.cleanup then s.cleanup(state, R) end
    end,
  }
  local full = AIJ.register('addBlind', def, 'blind')
  if full then
    s.full = full
    B.specs[full] = s
    B.list[#B.list + 1] = s
  end
  return full
end

local function dispatch(name, state, step, result)
  B.checkDisabled(state)
  local spec, R = B.live(state)
  if spec and spec.on and spec.on[name] then return spec.on[name](state, step, R, result) end
end

function B.sendBack(state, isBad, replace)
  local hand = state.cardsInHand or {}
  local pool = {}
  if replace then
    local deck = state.unDrawnCards or {}
    for i = #deck, 1, -1 do
      if not isBad(deck[i]) then pool[#pool + 1] = deck[i] end
    end
  end
  local left = #hand
  for _, c in ipairs(hand) do
    if isBad(c) then
      if replace then
        local rep = table.remove(pool, 1)
        if rep then
          rep:moveTo('hand')
          c:moveTo('deck')
        end
      elseif left > 1 then
        c:moveTo('deck')
        left = left - 1
      end
    end
  end
end

function B.enforce(state)
  B.checkDisabled(state)
  local spec, R = B.live(state)
  for _, c in ipairs(state.cardsInHand or {}) do
    local u = uid(c)
    local i = info(c)
    local want = B.stayDebuffed(c)
    if not want and spec and spec.debuff then want = spec.debuff(c, state, R) == true end
    if want then
      if not i.debuffed then c:setDebuffState(true) end
      V.debuffed[u] = true
    elseif i.debuffed and V.debuffed[u] then
      c:setDebuffState(false)
      V.debuffed[u] = nil
    end
    if spec and not i.flipped then
      local down = V.face[u] == true
      if not down and spec.faceDown then down = spec.faceDown(c, state, R) == true end
      if down then
        c:flip(true)
        V.flipped[u] = true
      end
    end
  end
  local jokers = state.jokers or {}
  for idx, j in ipairs(jokers) do
    local u = uid(j)
    local want = spec ~= nil and spec.debuffJoker ~= nil and spec.debuffJoker(j, idx, #jokers, state, R) == true
    local d = info(j).debuffed
    if want then
      if not d then j:setDebuffState(true) end
      V.jdebuffed[u] = true
    elseif d and V.jdebuffed[u] then
      j:setDebuffState(false)
      V.jdebuffed[u] = nil
    end
  end
end

local sinceEnforce = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  sinceEnforce = sinceEnforce + (frame.dt or 0)
  if sinceEnforce < 0.15 then return end
  sinceEnforce = 0
  local state = cardlike.state
  if not state or type(state.blind) ~= 'table' or state.phase ~= 'play' then return end
  AIJ.safe(B.enforce, state)
end)

cardlike.on('onRunStart', function(state)
  local run = RUN()
  run.blinds_start_deck = state.deckSize
  resetV()
end)

cardlike.on('onGameWon', function() RUN().blinds_won = true end)

cardlike.on('onRoundStart', function(state)
  local run = RUN()
  run.blinds_serial = (run.blinds_serial or 0) + 1
  resetV()
  local spec = B.specOf(state.blind and state.blind.id)
  local R = run.blinds_round
  if not R or not R.fresh then
    R = { key = spec and spec.key or nil, startMult = 0, startAdd = 0, dMult = 0, dAdd = 0, base = (state.blind and state.blind.target or 0) / 2 }
    run.blinds_round = R
  end
  R.fresh = nil
  R.serial = run.blinds_serial
  if state.blind and state.blind.boss and state.blind.id then run.blinds_used[state.blind.id] = true end
end)

cardlike.on('onBlindSkipped', function()
  local a = RUN().blinds_ante
  a.skipped = a.skipped + 1
end)

cardlike.on('onMoneyChanged', function(state, step)
  local amount = tonumber(step and step.amount) or 0
  if amount < 0 then
    local a = RUN().blinds_ante
    a.spent = a.spent + (-amount)
  end
end)

cardlike.on('onBlindDefeated', function(state)
  local run = RUN()
  if type(run.blinds_round) == 'table' then run.blinds_round.over = true end
  local a = run.blinds_ante
  a.defeated = a.defeated + 1
  a.unused = a.unused + (state.handsLeft or 0) + (state.discardsLeft or 0)
  local target = state.blind and state.blind.target or 0
  local excess = (state.score or 0) - target
  if excess > 0 then a.excess = a.excess + excess end
  local spec, R = B.live(state, true)
  if spec then releaseCards(state) end
  if spec and spec.key == 'the_connection' and not state.bossDisabled and excess > 0 then
    run.blinds_connection = (run.blinds_connection or 0) + math.floor(excess)
  end
  if state.blind and state.blind.boss then
    run.blinds_ante = { defeated = 0, skipped = 0, unused = 0, excess = 0, spent = 0, hands = {} }
    run.blinds_ante_serial = (run.blinds_ante_serial or 1) + 1
  end
end)

cardlike.filter('anteChange', function(step)
  local run = RUN()
  if run.blinds_journey then
    run.blinds_journey = false
    return 0
  end
end)

cardlike.filter('skipPin', function(id, slot)
  local state = cardlike.state
  local run = RUN()
  if not state or run.blinds_next_boss_ante ~= state.ante or not AIJ.isId(run.blinds_next_boss, 'the_kind') then return nil end
  AIJ.run.aij_force_gold_pins = true
  return nil
end)

cardlike.on('onHandDrawn', function(state, step)
  B.checkDisabled(state)
  local spec, R = B.live(state)
  if not spec then return end
  for _, c in ipairs(state.cardsInHand or {}) do
    local u = uid(c)
    if u and not V.seen[u] then
      V.seen[u] = true
      if spec.onNewCard then spec.onNewCard(c, state, R) end
    end
  end
  if spec.on and spec.on.onHandDrawn then spec.on.onHandDrawn(state, step, R) end
  if spec.drawLast then B.sendBack(state, function(c) return spec.drawLast(c, state, R) == true end, true) end
  if spec.banish then B.sendBack(state, function(c) return spec.banish(c, state, R) == true end, spec.banishReplace == true) end
  B.enforce(state)
end)

cardlike.on('beforeAllCardsScored', function(state, step, result)
  local hand = step and step.hand
  if hand then
    local run = RUN()
    for _, c in ipairs(hand.allCards or {}) do B.setStore(c, 'aij_played_ante', run.blinds_ante_serial) end
    local list = run.blinds_ante.hands
    list[#list + 1] = { hand = hand.handType, blind = state.blind and state.blind.id }
  end
  return dispatch('beforeAllCardsScored', state, step, result)
end)

cardlike.on('onDiscard', function(state, step, result)
  local run = RUN()
  for _, c in ipairs((step and step.discardedCards) or {}) do B.setStore(c, 'aij_discarded_ante', run.blinds_ante_serial) end
  return dispatch('onDiscard', state, step, result)
end)

for _, name in ipairs({ 'afterHand', 'onScore' }) do
  cardlike.on(name, function(state, step, result) return dispatch(name, state, step, result) end)
end

cardlike.filter('canDiscard', function(v, cards)
  local state = cardlike.state
  if v == false or not state or type(state.blind) ~= 'table' then return nil end
  local sel = type(cards) == 'table' and cards or state.selectedCards or {}
  local spec, R = B.live(state)
  if spec and spec.canDiscard and #sel > 0 and spec.canDiscard(state, sel, R) == false then return false end
end)

local function suitLast(suit) return function(c) return B.suit(c, suit) end end

for _, t in ipairs({
  { 'the_beith', 'Diamonds', 'ddebe5', 0 }, { 'the_elm', 'Clubs', '5a835e', 1 },
  { 'the_alder', 'Hearts', 'af6457', 2 }, { 'the_willow', 'Spades', '6f9282', 3 },
}) do
  B.add { key = t[1], min = 2, colour = t[3], y = t[4], drawLast = suitLast(t[2]) }
end

B.add { key = 'the_branch', min = 2, colour = '88715a', y = 4, drawLast = function(c) return B.face(c) end }

B.add {
  key = 'the_enigma', min = 4, mult = 1.5, colour = '6b4d74', y = 26, gate = B.hasEnhanced(4),
  drawLast = function(c) return B.enhanced(c) end,
}

B.add {
  key = 'the_lake', min = 1, colour = '449d95', y = 15,
  drawLast = function(c) return B.playedThisAnte(c) end,
}

B.add {
  key = 'the_ancestor', min = 3, colour = 'f03464', y = 45, lite = true,
  start = function(state, R) R.banned = {} end,
  on = {
    onDiscard = function(state, step, R)
      local h = cardlike.evaluateHand(step.discardedCards or {})
      if h and h.handType then
        R.banned = R.banned or {}
        R.banned[h.handType] = true
      end
    end,
  },
  canPlayHand = function(state, hand, R) return not (R.banned and R.banned[hand.handType]) end,
}

local function firstUnlocked(state)
  for _, j in ipairs(state.jokers or {}) do
    if not B.jokerLocked(j) then return j end
  end
end

B.add {
  key = 'the_apple', min = 3, colour = 'ac3232', y = 20,
  finish = function(state, R)
    if (state.handsPlayed or 0) <= 1 then
      local j = firstUnlocked(state)
      if j then j:destroy() end
    end
  end,
}

local function startDeck(state) return RUN().blinds_start_deck or 52 end

B.add {
