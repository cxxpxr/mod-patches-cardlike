local stereoBusy = false
cardlike.filter('pinAdded', function(ok, pin)
  if stereoBusy or ok == false then return nil end
  local id = AIJ.defId(pin)
  if not id or id == 'pin_5' or AIJ.isId(id, 'stereoscopic') then return nil end
  local give = IS_GOLD[id] and id or GOLD_OF[id]
  if not give or not AIJ.has(give, 'pin') then return nil end
  local held = H.held('stereoscopic')
  if #held == 0 then return nil end
  local p = held[#held]
  H.later(function()
    H.spend(p)
    stereoBusy = true
    cardlike.addPin(give)
    stereoBusy = false
  end)
  return nil
end)

