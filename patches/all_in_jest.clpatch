AIJ.onJokerGone(function(state)
  for _, j in ipairs(owned(state, 'plain_packaging')) do
    local m, d = AIJ.num(j, 'mult'), AIJ.num(j, 'mult_decrease')
    if m - d <= 0 then
      j:popup(AIJ.msg('k_aij_empty_ex', 'Empty!'), colors.ORANGE)
      j:destroy()
    else
      AIJ.set(j, 'mult', m - d)
      j:popup('-' .. AIJ.fmt(d) .. ' Mult', colors.MULT)
    end
  end
end)

