  'ygm_youve_got_mail', 'yu_sze' }) do MULT[AIJ.id(k)] = true end
for _, k in ipairs({ 'j_joker', 'j_greedy_joker', 'j_lusty_joker', 'j_wrathful_joker', 'j_gluttenous_joker', 'j_jolly',
  'j_zany', 'j_mad', 'j_crazy', 'j_droll', 'j_half', 'j_stencil', 'j_ceremonial', 'j_mystic_summit', 'j_misprint',
  'j_raised_fist', 'j_fibonacci', 'j_steel_joker', 'j_abstract', 'j_gros_michel', 'j_even_steven', 'j_scholar',
  'j_supernova', 'j_ride_the_bus', 'j_blackboard', 'j_constellation', 'j_green_joker', 'j_cavendish', 'j_card_sharp',
