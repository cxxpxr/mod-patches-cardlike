  config = { future_sense = 5 },
  blueprint_compat = false,
  description = function(r)
    local card = r and r.card
    local n = AIJ.val(card, 'kalyptos', 'future_sense', 5)
    local text = 'Reveals the next ' .. colorize(bold(tostring(n)), colors.ORANGE) .. ' cards in your deck'
    local s = cardlike.state
    if card and s and s.unDrawnCards and AIJ.safe(card.getArea, card) == 'jokers' then
      local deck, names = s.unDrawnCards, {}
      for i = #deck, math.max(1, #deck - n + 1), -1 do
        local c = deck[i]
        local ci = info(c)
        local name = AIJ.noRank(c) and 'Rock' or (AIJ.rankName(ci.rank) .. ' of ' .. tostring(ci.suit))
        names[#names + 1] = colorize(name, suitColor(ci.suit))
      end
      if #names > 0 then text = text .. '\n' .. table.concat(names, ', ') end
    end
    return text
  end,
}

