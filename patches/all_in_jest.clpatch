    ["j_aij_bullet_king"] = { name = "Bullet King", text = "[color=\"#f3a712\"][b]Kings[/b][/color] also trigger their [color=\"#f3a712\"][b]held in hand[/b][/color] effects when scored" },
    ["j_aij_bullseye"] = { name = "Bullseye", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if current [color=\"#3772ff\"][b]Points[/b][/color] are a multiple of [color=\"#f3a712\"][b]10[/b][/color]" },
