    ["c_aij_maw"] = { name = "Maw", text = "[color=\"#ff007f\"][b]Destroys[/b][/color] a random [color=\"#f3a712\"][b]Joker[/b][/color] and [color=\"#f3a712\"][b]all cards[/b][/color] held in hand" },
    ["c_aij_mirth"] = { name = "Mirth", text = "Add a [color=\"#V1#\"][b]#2#[/b][/color] to [color=\"#f3a712\"][b]#1#[/b][/color] selected card in your hand" },
    ["c_aij_palmistry"] = { name = "Palmistry", text = "Apply a random [color=\"#f3a712\"][b]enhancement[/b][/color] to all cards [color=\"#f3a712\"][b]held in hand[/b][/color]" },
    ["c_aij_possession"] = { name = "Possession", text = "Remove [color=\"#5d5dff\"][b]Edition[/b][/color] and [color=\"#f3a712\"][b]Enhancement[/b][/color] from [color=\"#f3a712\"][b]#1#[/b][/color] selected card and make their [color=\"#f3a712\"][b]effects [/b][/color][color=\"#f3a712\"][b]Inherent[/b][/color]" },
    ["c_aij_providence"] = { name = "Providence", text = "Gives an [color=\"#f3a712\"][b]Astrology Pin[/b][/color]" },
    ["c_aij_pulsar"] = { name = "Pulsar", text = "[color=\"#f3a712\"][b]Levels up[/b][/color] the [color=\"#ff007f\"][b]Mult[/b][/color] of all [color=\"#d138bf\"][b]poker hands[/b][/color]" },
    ["c_aij_rahu"] = { name = "Rahu", text = "Retrigger all cards [color=\"#f3a712\"][b]played[/b][/color] when [color=\"#f3a712\"][b]#1#[/b][/color] is played" },
    ["c_aij_reshape"] = { name = "Reshape", text = "Turn the rightmost [color=\"#f3a712\"][b]50%[/b][/color] of Jokers [color=\"#9a9a9a\"](rounding up)[/color] into [color=\"#f3a712\"][b]copies[/b][/color] of one of them\n[color=\"#9a9a9a\"](Jokers keep their original[/color] [color=\"#9a9a9a\"]stickers and editions)[/color]" },
    ["c_aij_scopophobia"] = { name = "Scopophobia", text = "Add an [color=\"#V1#\"][b]#2#[/b][/color] to [color=\"#f3a712\"][b]#1#[/b][/color] selected card in your hand" },
    ["c_aij_shade"] = { name = "Shade", text = "Add [color=\"#5d5dff\"][b]Inverted[/b][/color] edition to [color=\"#f3a712\"][b]#1#[/b][/color] random card in hand" },
    ["c_aij_tallow"] = { name = "Tallow", text = "Add a [color=\"#V1#\"][b]#2#[/b][/color] to [color=\"#f3a712\"][b]#1#[/b][/color] selected cards in your hand" },
    ["c_aij_tetragrammaton"] = { name = "Tetragrammaton", text = "Create a playing card with a chosen [color=\"#f3a712\"][b]rank[/b][/color], [color=\"#f3a712\"][b]suit[/b][/color], and [color=\"#f3a712\"][b]enhancement[/b][/color]\nCreate 4 [color=\"#f3a712\"][b]random[/b][/color] playing cards and add them to the deck" },
