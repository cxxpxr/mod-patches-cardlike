AIJ.addJoker {
  key = 'quark', lite = true,
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 16, y = 3 },
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      local cards = step.hand.playedCards or {}
      if not step.hand.contains.THREE_OF_A_KIND or #cards ~= 3 then return end
      local suits = {}
      for _, c in ipairs(cards) do
        local s = not AIJ.noRank(c) and c:getSuit() or nil
        if not s or suits[s] then return end
        suits[s] = true
      end
      state:upgradeHand('THREE_OF_A_KIND', 1)
      result:say(upgradeText(), colors.ORANGE)
    end,
  },
}

local function heldSixes(state)
  return countCards(state and state.cardsInHand, function(c) return rankOf(c) == 6 and not AIJ.isDebuffed(c) end)
end

AIJ.addJoker {
  key = 'queen_bee',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 8, y = 42 },
  config = { xmult_mod = 0.1 },
  vars = function(card)
    local mod = AIJ.val(card, 'queen_bee', 'xmult_mod')
    return { mod, 1 + heldSixes(st()) * mod }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if rankOf(step.card) ~= 12 then return end
      local total = 1 + heldSixes(state) * AIJ.num(joker, 'xmult_mod')
      if total > 1 then result:add(xMult(total)) end
    end,
  },
}

