local imageCounts = {}
local function imageKey(joker, step)
  return tostring(joker.uid) .. ':' .. tostring(step.copiedBy and step.copiedBy.uid or '')
end
AIJ.addJoker {
  key = 'imageboard', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 20, y = 0 },
  config = { mod_mult = 1 },
  vars = function(card)
    local m = AIJ.val(card, 'imageboard', 'mod_mult', 1)
    return { m, m * 2, m * 3 }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      imageCounts[imageKey(joker, step)] = {}
    end,
    onScore = function(joker, state, step, result)
      local k = imageKey(joker, step)
      local t = imageCounts[k] or {}
      imageCounts[k] = t
      local mod = AIJ.num(joker, 'mod_mult')
      local m = mod
      if not AIJ.noRank(step.card) then
        local r = step.card:getRank()
        t[r] = (t[r] or 0) + mod
        m = t[r]
      end
      if m ~= 0 then result:add(plusMult(m)) end
    end,
  },
}

