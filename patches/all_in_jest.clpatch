local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')

local function addDeck(def)
  local e = AIJ.loc('Back', 'b_aij_' .. def.key) or {}
  return AIJ.register('addDeck', {
    id = def.key,
    name = e.name or def.key,
    description = def.description or e.text or '',
    sprite = AIJ.sprite('deck_atlas', def.pos),
    onRunStart = def.onRunStart,
    onRoundCompleted = def.onRoundCompleted,
    lite = def.lite,
  }, 'deck')
end

local function playing(state, id) return state and AIJ.isId(state.deck, id) end

addDeck { key = 'branching', pos = { x = 1, y = 0 }, lite = true }

local branchBusy = false
cardlike.filter('pinAdded', function(ok, pin)
  local state = cardlike.state
  if branchBusy or ok == false or not playing(state, 'branching') or not state:isPhase('blindSelect') then return nil end
  local first = AIJ.defId(pin)
  if not first then return nil end
  local ids, seen = { first }, { [first] = true }
  for _ = 1, 8 do
    if #ids >= 3 then break end
    local id = cardlike.randomPin()
    if id and H.maybeGold then id = H.maybeGold(state, id, 2) end
    if id and not seen[id] then ids[#ids + 1] = id seen[id] = true end
  end
  local options = {}
  for _, id in ipairs(ids) do
    local info = cardlike.contentInfo('pin', id)
    options[#options + 1] = { label = info and info.name or id, value = id,
      color = H.IS_GOLD and H.IS_GOLD[id] and colors.MONEY or nil }
  end
  H.later(function()
    H.choose { title = 'Branching Deck', subtitle = 'Choose the Pin for this skip', options = options, columns = 3,
      onPick = function(id)
        branchBusy = true
        cardlike.addPin(id)
        branchBusy = false
      end }
  end)
  return false
end)

addDeck { key = 'fabled', pos = { x = 0, y = 0 }, lite = true,
  onRunStart = function(ctx)
    ctx.state.additionalJokerSlots = ctx.state.additionalJokerSlots - 1
    AIJ.run.fabled_rate = 1
  end }

local function fabledShop(state)
  if not playing(state, 'fabled') then return end
  local rate = AIJ.run.fabled_rate or 1
  if rate >= 1 then return end
  for _, c in ipairs(state.shopCards or {}) do
    if (c.lastInfo or {}).kind == 'joker' and not AIJ.get(c, 'aij_fabled_rolled') then
      AIJ.set(c, 'aij_fabled_rolled', true)
      if state:randomFloat() > rate then
        local id = cardlike.randomJoker('Legendary')
        if id then c:setJokerDef(id) end
      end
    end
  end
end
cardlike.on('onShopEnter', function(state) H.later(function() fabledShop(cardlike.state) end) end)
cardlike.on('onShopReroll', function(state) fabledShop(state) end)
cardlike.on('onShopExit', function(state)
  if playing(state, 'fabled') then AIJ.run.fabled_rate = (AIJ.run.fabled_rate or 1) - 0.004 end
end)
cardlike.on('onCardBought', function(state, step)
  local c = step.card
  if playing(state, 'fabled') and c and (c.lastInfo or {}).kind == 'joker' and tostring(AIJ.safe(c.getRarity, c)) == 'Legendary' then
    AIJ.run.fabled_rate = 1
  end
end)

addDeck { key = 'melded', pos = { x = 4, y = 0 } }

local function extras(card)
  local ds = AIJ.safe(card.getDataStore, card)
  local l = ds and ds:get('aij_extra_enh')
  return type(l) == 'table' and l or {}
end

local function setSecond(card, id)
  card:getDataStore():set('aij_extra_enh', { id })
end

local function randomSecond(state, first)
  local list = {}
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id ~= 'Default' and e.id ~= 'Prismatic' and e.id ~= first then list[#list + 1] = e.id end
  end
  return AIJ.pick(list, state)
end

local function remember(card)
  AIJ.set(card, 'aij_melded_last', AIJ.enhancement(card) or 'Default')
end

cardlike.on('onCardsAdded', function(state, step)
  if not playing(state, 'melded') then return end
  for _, c in ipairs(step.cards or {}) do
    local first = AIJ.enhancement(c)
    if first and #extras(c) == 0 and state:randomFloat() < 0.4 then
      local e = randomSecond(state, first)
      if e then
        setSecond(c, e)
        AIJ.safe(c.popup, c, '+' .. ((cardlike.contentInfo('enhancement', e) or {}).name or e), colors.PURPLE)
      end
    end
    remember(c)
  end
end)

cardlike.on('onCardChanged', function(state, step)
  local c = step.card
  if not c or (c.lastInfo or {}).kind ~= 'playing' or not playing(state, 'melded') then return end
  local last = AIJ.get(c, 'aij_melded_last')
  local now = AIJ.enhancement(c) or 'Default'
  if last == nil then remember(c) return end
  if last == now then return end
  AIJ.set(c, 'aij_melded_last', now)
  if last ~= 'Default' and now ~= 'Default' then
    local ex = extras(c)
    if ex[1] ~= last then setSecond(c, last) end
  elseif now == 'Default' and #extras(c) > 0 then
    AIJ.set(c, 'aij_extra_enh', nil)
  end
end)

AIJ.cardSuitIf(function(state, card, suit)
  for _, id in ipairs(extras(card)) do
    if id == 'Plaid' or id == 'm_wild' then return true end
  end
  return false
end)

addDeck { key = 'patchwork', pos = { x = 3, y = 0 },
  onRunStart = function(ctx)
    for _, c in ipairs(ctx.state.allCards or {}) do
      local own = AIJ.safe(c.getSuit, c)
      local list = {}
      for _, s in ipairs(AIJ.SUITS) do if s ~= own then list[#list + 1] = s end end
      AIJ.addPatch(c, AIJ.pick(list, ctx.state))
    end
  end }

cardlike.on('onCardsAdded', function(state, step)
  if not playing(state, 'patchwork') then return end
  for _, c in ipairs(step.cards or {}) do
    if next(AIJ.patches(c)) == nil then
      local own = AIJ.safe(c.getSuit, c)
      local list = {}
      for _, s in ipairs(AIJ.SUITS) do if s ~= own then list[#list + 1] = s end end
      AIJ.addPatch(c, AIJ.pick(list, state))
    end
  end
end)


