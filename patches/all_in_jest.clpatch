local MOONS = {
  ['2000_eu16'] = { 'Flush House', 'chips' }, ['2013_nd15'] = { 'Three of a Kind', 'chips' }, callisto = { 'Flush', 'chips' },
  charon = { 'High Card', 'chips' }, deimos = { 'Four of a Kind', 'chips' }, dysnomia = { 'Flush Five', 'mult' },
  europa = { 'Flush', 'mult' }, iapetus = { 'Straight', 'chips' }, kamooalewa = { 'Full House', 'chips' },
  kuiper = { 'Flush Five', 'chips' }, luna = { 'Full House', 'mult' }, nibiru = { 'Five of a Kind', 'chips' },
  nix = { 'High Card', 'mult' }, oberon = { 'Two Pair', 'chips' }, pallas = { 'Flush House', 'mult' },
  phaethon = { 'Pair', 'chips' }, phobos = { 'Four of a Kind', 'mult' }, planet_nine = { 'Five of a Kind', 'mult' },
  proteus = { 'Straight Flush', 'chips' }, titan = { 'Straight', 'mult' }, triton = { 'Straight Flush', 'mult' },
  umbriel = { 'Two Pair', 'mult' }, vulcanoid = { 'Pair', 'mult' }, zoozve = { 'Three of a Kind', 'mult' },
}

local function moonOf(card)
  local id = AIJ.defId(card)
  if not id then return nil end
  local short = AIJ.short(id)
  if short == id then return nil end
  return MOONS[short]
end

local function sameHand(balatroName, handType)
  local h = AIJ.hand(balatroName)
  return h == handType or (h == 'STRAIGHT_FLUSH' and handType == 'ROYAL_FLUSH')
end

AIJ.addJoker {
  key = 'planetarium',
  ignore = not AIJ.setting('moons_enabled'),
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 12 },
  config = { chips = 100, mult = 15 },
  blueprint_compat = true,
  description = function(r)
    local card = r and r.card
    return hl('Points', colors.CHIPS) .. '-type ' .. hl('Moon', AIJ.colors.PLANET) .. ' cards in your ' .. hl('consumable')
      .. ' area give ' .. hl('+' .. AIJ.fmt(AIJ.val(card, 'planetarium', 'chips')), colors.CHIPS) .. ' Points for their '
      .. hl('poker hand') .. '\n' .. hl('Mult', colors.MULT) .. '-type ' .. hl('Moon', AIJ.colors.PLANET) .. ' cards in your '
      .. hl('consumable') .. ' area give ' .. hl('+' .. AIJ.fmt(AIJ.val(card, 'planetarium', 'mult')), colors.MULT)
      .. ' Mult for their ' .. hl('poker hand')
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      for _, c in ipairs(state.consumables or {}) do
        local moon = moonOf(c)
        if moon and sameHand(moon[1], step.hand.handType) then
          if moon[2] == 'chips' then
            local n = AIJ.num(joker, 'chips')
            result:add(plusChips(n))
            result:say('+' .. AIJ.fmt(n) .. ' Points', colors.CHIPS, c)
          else
            local n = AIJ.num(joker, 'mult')
            result:add(plusMult(n))
            result:say('+' .. AIJ.fmt(n) .. ' Mult', colors.MULT, c)
          end
        end
      end
    end,
  },
}

