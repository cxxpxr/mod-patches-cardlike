}

local function appleRoll(joker, state)
  local light = state:random(0, 5)
  AIJ.set(joker, 'light_suits', light)
  AIJ.set(joker, 'dark_suits', 5 - light)
  AIJ.set(joker, 'rolled', true)
end

AIJ.addJoker {
  key = 'bad_apple', lite = true,
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 4, y = 3 },
  config = { xmult = 1, xmult_mod = 0.2, light_suits = 3, dark_suits = 2 },
  vars = function(card)
    local id = 'bad_apple'
    return { AIJ.val(card, id, 'xmult'), AIJ.val(card, id, 'xmult_mod'), AIJ.val(card, id, 'light_suits'), AIJ.val(card, id, 'dark_suits') }
  end,
  onAdded = function(joker, state) if not AIJ.get(joker, 'rolled') then appleRoll(joker, state) end end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      appleRoll(joker, state)
      result:say('Reset', colors.ORANGE)
    end,
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local dark, light = 0, 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        if c:isSuit('Spades') or c:isSuit('Clubs') then dark = dark + 1
        elseif c:isSuit('Hearts') or c:isSuit('Diamonds') then light = light + 1 end
      end
      if dark == AIJ.num(joker, 'dark_suits') and light == AIJ.num(joker, 'light_suits') then
        AIJ.add(joker, 'xmult', AIJ.num(joker, 'xmult_mod'))
        result:say('Upgrade!', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

cardlike.on('onCardCreated', function(state, step)
  local c = step.card
  if c and AIJ.is(c, 'bad_apple') and state and state.random and not AIJ.get(c, 'rolled') then appleRoll(c, state) end
end)

AIJ.addJoker {
