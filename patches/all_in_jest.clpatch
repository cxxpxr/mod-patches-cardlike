AIJ.addJoker {
  key = 'pedestrian',
  rarity = 2, cost = 5, atlas = 'joker_atlas', pos = { x = 24, y = 16 }, lite = true,
  config = {},
  blueprint_compat = true,
  triggers = {
    repeatCard = function(joker, state, step)
      local list = step.hand.playedCards or {}
      local i = indexOf(list, step.card)
      if not i or i <= 1 then return end
      local prev = list[i - 1]
      if AIJ.noRank(step.card) or AIJ.noRank(prev) then return end
      if step.card:getRank() < prev:getRank() then return 1 end
    end,
  },
}

local function inJokers(card)
  return card and AIJ.safe(card.getArea, card) == 'jokers'
end

AIJ.addJoker {
  key = 'peeping_tom',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 23, y = 5 },
  config = { future_sense = 3 },
  blueprint_compat = false,
  description = function(r)
    local card = r and r.card
    local n = AIJ.val(card, 'peeping_tom', 'future_sense')
    local text = AIJ.fill(AIJ.loc('Joker', 'j_aij_peeping_tom').text, { n })
    local state = cardlike.state
    if inJokers(card) and state and state.unDrawnCards then
      local deck, names = state.unDrawnCards, {}
      for i = #deck, math.max(1, #deck - n + 1), -1 do names[#names + 1] = cardName(deck[i]) end
      if #names > 0 then text = text .. '\n' .. grey('Next: ') .. hl(table.concat(names, ', ')) end
    end
    return text
  end,
}

AIJ.addJoker {
  key = 'pell_mel',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 10, y = 1 },
  config = { xmult_mod = 0.4 },
  blueprint_compat = true,
  vars = function(card) return { AIJ.val(card, 'pell_mel', 'xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + uniqueSuits(step.hand.allCards) * AIJ.num(joker, 'xmult_mod')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.onJokerGone(function(state, info, sold)
  if sold or not info or not info.joker then return end
  for _ in ipairs(owned(state, 'pellesini')) do
    local opts = { force = false }
    if info.edition and info.edition ~= 'default' and info.edition ~= '' then opts.edition = info.edition end
    if info.locked then opts.locked = true end
    if info.sticker and info.sticker ~= 'none' and info.sticker ~= 'locked' then opts.sticker = info.sticker end
    local j = cardlike.createJoker(info.joker, opts)
    if j then
      local ds = j:getDataStore()
      for k, v in pairs(info.store or {}) do ds:set(k, AIJ.copy(v)) end
      j:popup('Copied!', colors.ORANGE)
    end
  end
end)

AIJ.addJoker {
  key = 'pellesini',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 6, y = 0 }, soul_pos = { x = 6, y = 1 },
  config = {},
  blueprint_compat = false,
  triggers = {
    beforeRound = function(joker, state, step, result)
      local list = state.jokers or {}
      local right = list[#list]
      if not right or right:isLocked() then return end
      local value = right:getSellValue() or 0
      if value > 0 then result:add(plusMoney(value)) end
      right:destroy()
    end,
  },
}

AIJ.onJokerGone(function(state, info)
  local e = info and info.edition
  if not e or e == 'default' or e == '' then return end
  for _, j in ipairs(owned(state, 'pellucid_joker')) do
    local c = cardlike.addPlayingCard({ edition = e }, { area = 'deck' })
    if c then j:popup('+1 Card', colors.ORANGE) end
  end
end)

AIJ.addJoker {
  key = 'pellucid_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 5 },
  config = {},
  blueprint_compat = true,
}

local function pencilReroll(card, state)
  AIJ.set(card, 'rank', state:random(2, 14))
  AIJ.set(card, 'suit', AIJ.pick(AIJ.SUITS, state))
end

AIJ.addJoker {
  key = 'pencil_drawing',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 2 },
  config = { cost = 2, amount = 1, rank = 14, suit = 'Spades' },
  blueprint_compat = false,
  description = function(r)
    local card = r and r.card
    local suit = AIJ.val(card, 'pencil_drawing', 'suit')
    local text = AIJ.fill(AIJ.loc('Joker', 'j_aij_pencil_drawing').text, {
      AIJ.val(card, 'pencil_drawing', 'cost'), AIJ.val(card, 'pencil_drawing', 'amount'),
      AIJ.rankName(AIJ.val(card, 'pencil_drawing', 'rank')), suit,
      colours = { ENHANCED, AIJ.SUIT_COLORS[suit] or colors.ORANGE },
    }):gsub(ABILITY_FIX[1], ABILITY_FIX[2])
    return text .. '\n' .. grey('(Drag this Joker and press DRAW during a round)')
  end,
  onAdded = function(joker, state) pencilReroll(joker, state) end,
  buttons = {
    AIJ.ability('pencil_drawing', {
      label = function(card) return 'DRAW $' .. AIJ.fmt(AIJ.num(card, 'cost')) end,
      canPress = function(card, state)
        return state and state.phase == 'play' and (state.money or 0) >= AIJ.num(card, 'cost')
      end,
      press = function(card, state, opts)
        if not (opts and opts.free) then state:mutateMoney(-AIJ.num(card, 'cost')) end
        for _ = 1, AIJ.num(card, 'amount') do
          cardlike.addPlayingCard({ rank = AIJ.num(card, 'rank'), suit = AIJ.get(card, 'suit') }, { area = 'hand' })
        end
        pencilReroll(card, state)
        card:punch()
      end,
    }),
  },
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      pencilReroll(joker, state)
    end,
  },
}

local function totalJokerSell(state)
  local total = 0
  for _, j in ipairs((state and state.jokers) or {}) do total = total + (AIJ.safe(j.getSellValue, j) or 0) end
  return total
end
local function pengeldingX(card, state)
  local th = math.max(1, AIJ.val(card, 'pengelding', 'threshold'))
  return 1 + math.floor(totalJokerSell(state) / th) * AIJ.val(card, 'pengelding', 'xmult_gain')
end

AIJ.addJoker {
  key = 'pengelding',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 4, y = 16 }, soul_pos = { x = 4, y = 17 },
  config = { threshold = 10, xmult_gain = 0.25 },
  blueprint_compat = true,
  vars = function(card)
    return { AIJ.val(card, 'pengelding', 'xmult_gain'), AIJ.val(card, 'pengelding', 'threshold'),
      card and pengeldingX(card, cardlike.state) or 1 }
  end,
  triggers = {
    onScoreInHand = function(joker, state, step, result)
      if AIJ.isDebuffed(step.card) then return end
      local x = pengeldingX(joker, state)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

local function pennyRepeat(joker, state, step)
  if AIJ.hasStamp(step.card, 'Gold') and state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then return 1 end
end

AIJ.addJoker {
  key = 'penny',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 1, y = 2 },
  config = { odds = 2 },
