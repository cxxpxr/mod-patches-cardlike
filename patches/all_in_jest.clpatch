local LOWER = { Legendary = 'Rare', Rare = 'Uncommon', Uncommon = 'Common' }
H.add {
  key = 'faceless', type = 'hex_tarot', set = 'aij_hex_tarot', pos = { x = 3, y = 8 }, cost = 6, hidden = true,
  config = {},
  canUse = function(ctx)
    local j = H.byIndex(ctx.state.jokers)[1]
    if not j then return 'No Joker' end
    if j:isLocked() then return 'Joker is Locked' end
    return ''
  end,
  action = function(ctx)
    local j = H.byIndex(ctx.state.jokers)[1]
    if not j or j:isLocked() then return end
    local def = AIJ.defId(j)
    local rarity = AIJ.jokerRarity[def] or j:getRarity()
    j:destroy()
    local lower = LOWER[rarity]
    if lower then
      cardlike.createJoker(lower, { edition = 'Inverted' })
    else
      ctx.self:popup('Nope!', HEX_COLOR)
    end
  end,
}

