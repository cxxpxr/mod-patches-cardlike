local function duendeMoney(card)
  local state = cardlike.state
  if not state or state.freeJokerSlots == nil then return 0 end
  local empty = state.freeJokerSlots + AIJ.count('duende', state)
  return math.max(0, empty) * AIJ.num(card, 'dollars')
end

