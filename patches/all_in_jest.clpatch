    local m = AIJ.val(card, 'sticker', 'mult')
    return { m, m * stickerCount(cardlike.state) }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult') * stickerCount(state)
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local function interestEstimate(state)
  if state.deck == 'Grass Deck' then return 0 end
  local cap = 25
  if state:hasTicket('ticket_21') then cap = 100 elseif state:hasTicket('ticket_20') then cap = 50 end
  local per = math.floor(math.min(cap, state.money or 0) / 5 + 0.5)
  if per <= 0 then return 0 end
  return per * (1 + (state:countJoker('joker_scrooge') or 0))
end

AIJ.addJoker {
  key = 'stock_broker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 0, y = 10 },
  config = { minvalue = 0.75, maxvalue = 3 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'stock_broker', 'minvalue'), AIJ.val(card, 'stock_broker', 'maxvalue') } end,
  dollarsAtRoundEnd = function(joker, state)
    local interest = interestEstimate(state)
    if interest <= 0 then return 0 end
    local lo, hi = AIJ.num(joker, 'minvalue'), AIJ.num(joker, 'maxvalue')
    local m = math.floor((state:randomFloat() * (hi - lo) + lo) / 0.05 + 0.5) * 0.05
    joker:popup('X' .. AIJ.fmt(m) .. ' Interest', colors.ORANGE)
    return math.floor(interest * m + 0.5) - interest
  end,
}

local function megaDeckPack()
  if cardlike.contentInfo('pack', 'pack_deck_2') then return 'pack_deck_2' end
  for _, p in ipairs(cardlike.listContent('pack') or {}) do
    local n = tostring(p.name or ''):lower()
    if n:find('deck', 1, true) and (n:find('mega', 1, true) or n:find('xxl', 1, true)) then return p.id end
  end
  return nil
end

local stockPhotoWaiting = {}

local function stockPhotoOpen(joker)
  local id = megaDeckPack()
  if not id then return true end
  if cardlike.openPack(id) then
    AIJ.set(joker, 'trigger', true)
    return true
  end
  return false
end

AIJ.addJoker {
  key = 'stock_photo',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 7 },
  config = { trigger = false, odds = 2 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'stock_photo', 'odds') } end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if not stockPhotoOpen(joker) then stockPhotoWaiting[#stockPhotoWaiting + 1] = joker.uid end
    end,
    onPackSkipped = function(joker, state, step, result)
      if step.copiedBy or not AIJ.get(joker, 'trigger', false) then return end
      AIJ.set(joker, 'trigger', false)
      if state:chance(1 / AIJ.num(joker, 'odds')) then
        result:destroySelf()
      else
        result:say('Safe!', colors.ORANGE)
      end
    end,
  },
}

cardlike.on('onShopExit', function() stockPhotoWaiting = {} end)
cardlike.onFrame(function(frame)
  if #stockPhotoWaiting == 0 then return end
  local state = cardlike.state
  if not frame.inRun or not state or not state:isPhase('shop') then return end
  local uid = stockPhotoWaiting[1]
  local joker = cardlike.card(uid)
  if not AIJ.exists(joker) or stockPhotoOpen(joker) then table.remove(stockPhotoWaiting, 1) end
end)

