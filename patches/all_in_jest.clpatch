    end,
  },
}

local WL_SLOTS, WL_NEXT = 'aij_wl_slots', 'aij_wl_next'
local WL_TRIGGERS = {
  'beforeRound', 'drawInitialCards', 'beforeAllCardsScored', 'beforeScore', 'onScore', 'enhancementScore',
  'onScoreInHand', 'afterAllCardsScored', 'onOtherJoker', 'finalScoring', 'afterHand', 'onDiscard', 'afterRound',
  'repeatCard', 'repeatHeldCard', 'destroyCard', 'onDiscardCard',
  'onRoundStart', 'onHandDrawn', 'onCardSelected', 'onConsumableUsed', 'onCardBought', 'onCardSold', 'onShopEnter',
  'onShopExit', 'onShopReroll', 'onPackOpened', 'onPackSkipped', 'onBlindSkipped', 'onBossRerolled', 'onBlindDefeated',
  'onCashOut', 'onAnteChanged', 'onMoneyChanged', 'onCardsAdded', 'onCardsRemoved', 'onCardsDestroyed',
}
local WL_COUNT = { repeatCard = true, repeatHeldCard = true }
local WL_BOOL = { destroyCard = true, onDiscardCard = true }

AIJ.onNewRun(function(run) run.whats_left_sold = {} end)

local function wlDef(id)
  local d = id and AIJ.jokerDefs[id]
  if not d or d.copyable == false or AIJ.isId(id, 'whats_left') then return nil end
  return d
end

local function wlProxy(real, slot)
  local prefix = 'aij_wl_' .. slot.n .. '_'
  local ds = real:getDataStore()
  local pds = {
    get = function(_, k) return ds:get(prefix .. k) end,
    set = function(_, k, v)
      if v == nil then ds:delete(prefix .. k) else ds:set(prefix .. k, v) end
    end,
    getOrDefault = function(_, k, d)
      local v = ds:get(prefix .. k)
      if v == nil then return d end
      return v
    end,
    has = function(_, k) return ds:has(prefix .. k) end,
    delete = function(_, k) return ds:delete(prefix .. k) end,
    keys = function()
      local out = {}
      for _, k in ipairs(ds:keys() or {}) do
        if type(k) == 'string' and k:sub(1, #prefix) == prefix then out[#out + 1] = k:sub(#prefix + 1) end
      end
      return out
    end,
  }
  local info = AIJ.copy(real.lastInfo or {})
  info.kind, info.joker, info.store = 'joker', slot.id, nil
  return setmetatable({ uid = real.uid, lastInfo = info }, {
    __index = function(_, k)
      if k == 'getDataStore' then return function() return pds end end
      if k == 'getJokerDef' then return function() return slot.id end end
      return real[k]
    end,
    __eq = function(a, b) return a.uid == b.uid end,
  })
end

local function wlSlots(joker)
  local s = AIJ.get(joker, WL_SLOTS)
  return type(s) == 'table' and s or {}
end

local function wlDrop(joker, state, slot)
  local def = wlDef(slot.id)
  if def and def.onRemoved and state then pcall(def.onRemoved, wlProxy(joker, slot), state) end
  local ds = joker:getDataStore()
  local prefix = 'aij_wl_' .. slot.n .. '_'
  for _, k in ipairs(ds:keys() or {}) do
    if type(k) == 'string' and k:sub(1, #prefix) == prefix then ds:delete(k) end
  end
end

local function wlAdd(joker, state, entry)
  if not wlDef(entry.id) then return end
  local slots = AIJ.copy(wlSlots(joker))
  local n = AIJ.num(joker, WL_NEXT) + 1
  AIJ.set(joker, WL_NEXT, n)
  local slot = { id = entry.id, n = n }
  local ds = joker:getDataStore()
  for k, v in pairs(entry.store or {}) do
    if type(k) == 'string' and k:sub(1, 7) ~= 'aij_wl_' and v ~= nil then ds:set('aij_wl_' .. n .. '_' .. k, v) end
  end
  slots[#slots + 1] = slot
  local limit = math.max(1, AIJ.num(joker, 'copy_limit'))
  while #slots > limit do
    wlDrop(joker, state, table.remove(slots, 1))
  end
  AIJ.set(joker, WL_SLOTS, slots)
  local def = wlDef(slot.id)
  if def.onAdded and state then pcall(def.onAdded, wlProxy(joker, slot), state) end
end

AIJ.onJokerGone(function(state, info, sold)
  if not sold or not info or not info.joker or not wlDef(info.joker) then return end
  local entry = { id = info.joker, store = AIJ.copy(info.store or {}) }
  local list = AIJ.run.whats_left_sold or {}
  list[#list + 1] = entry
  while #list > 5 do table.remove(list, 1) end
  AIJ.run.whats_left_sold = list
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.is(j, 'whats_left') then
      wlAdd(j, state, entry)
      j:popup('Copied!', colors.ORANGE)
    end
  end
end)

local wlBusy = {}
local function wlRun(name, joker, state, step, result)
  if wlBusy[joker.uid] then return nil end
  local slots = wlSlots(joker)
  if #slots == 0 then return nil end
  wlBusy[joker.uid] = true
  local total, any = 0, false
  local ok, err = pcall(function()
    for _, slot in ipairs(slots) do
      local def = wlDef(slot.id)
      local fn = def and def.triggers and def.triggers[name]
      if fn then
        local r = fn(wlProxy(joker, slot), state, step, result)
        if type(r) == 'number' then total = total + r elseif r == true then any = true end
      end
    end
  end)
  wlBusy[joker.uid] = nil
  if not ok then error(err, 0) end
  if WL_COUNT[name] then return total > 0 and total or nil end
  if WL_BOOL[name] then return any or nil end
  return nil
end

local wlTriggers = {}
for _, name in ipairs(WL_TRIGGERS) do
  wlTriggers[name] = function(joker, state, step, result) return wlRun(name, joker, state, step, result) end
end

local function wlName(id)
  local d = AIJ.jokerDefs[id]
  return d and d.readableName or tostring(id)
end

AIJ.addJoker {
  key = 'whats_left',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 23 },
  config = { copy_limit = 2 },
  description = function(r)
    local card = r and r.card
    local names = {}
    if card then for _, slot in ipairs(wlSlots(card)) do names[#names + 1] = wlName(slot.id) end end
    return 'Copies the abilities of the last ' .. C(AIJ.fmt(AIJ.val(card, 'whats_left', 'copy_limit')), colors.ORANGE)
      .. ' ' .. C('sold', colors.ORANGE) .. ' All in Jest ' .. C('Jokers', colors.ORANGE) .. '\n'
      .. grey("(Excluding What's Left)") .. '\n'
      .. grey('(Currently: ' .. (#names > 0 and table.concat(names, ', ') or 'None') .. ')')
  end,
  onAdded = function(joker, state)
    if #wlSlots(joker) > 0 then return end
    for _, entry in ipairs(AIJ.run.whats_left_sold or {}) do wlAdd(joker, state, entry) end
  end,
  onRemoved = function(joker, state)
    for _, slot in ipairs(wlSlots(joker)) do
      local def = wlDef(slot.id)
      if def and def.onRemoved then pcall(def.onRemoved, wlProxy(joker, slot), state) end
    end
  end,
  dollarsAtRoundEnd = function(joker, state)
    local total = 0
    for _, slot in ipairs(wlSlots(joker)) do
      local def = wlDef(slot.id)
      if def and def.dollarsAtRoundEnd then
        local ok, v = pcall(def.dollarsAtRoundEnd, wlProxy(joker, slot), state)
        if ok then total = total + (tonumber(v) or 0) end
      end
    end
    return total
  end,
  triggers = wlTriggers,
}

