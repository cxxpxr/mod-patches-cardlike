        return state ~= nil and #(state.jokers or {}) > 0 and not state:isPhase('scoring')
      end,
      press = function(card, state, opts)
        state:mutateMoney(AIJ.num(card, 'dollars'))
        card:popup('+$' .. AIJ.fmt(AIJ.num(card, 'dollars')), colors.MONEY)
        if opts and opts.repeated then return end
