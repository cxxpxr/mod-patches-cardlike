AIJ.addJoker {
  key = 'wizard',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 13, y = 26 },
  config = { odds = 4 },
  description = function(r)
    return C(AIJ.fmt(AIJ.prob()) .. ' in ' .. AIJ.fmt(AIJ.val(r and r.card, 'wizard', 'odds')), colors.GREEN)
      .. ' chance for each scoring ' .. C('non-enhanced', colors.ORANGE) .. ' card to become a '
      .. C('Multicard', colors.ORANGE) .. ', ' .. C('Chipped', colors.ORANGE) .. ' or ' .. C('Paperback', colors.ORANGE) .. ' card'
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local odds = AIJ.num(joker, 'odds')
      local any = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if not AIJ.enhancement(c) and state:chance(1 / odds) then
