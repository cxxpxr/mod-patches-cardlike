    ["tag_aij_ignoramus"] = { name = "Ignoramus Pin", text = "Choose [color=\"#f3a712\"][b]any[/b][/color] [color=\"#009dff\"][b]Common[/b][/color] or [color=\"#1bb18c\"][b]Uncommon[/b][/color] Joker to create\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["tag_aij_iridescent"] = { name = "Iridescent Pin", text = "Apply [color=\"#5d5dff\"][b]Holo[/b][/color] to a [color=\"#f3a712\"][b]random[/b][/color] Joker and [color=\"#f3a712\"][b]#1#[/b][/color] cards in the deck that have no edition" },
    ["tag_aij_landfill"] = { name = "Landfill Pin", text = "Gives [color=\"#f3a712\"][b]$1[/b][/color] per card [color=\"#ff007f\"][b]discarded[/b][/color] this run\n[color=\"#9a9a9a\"](Will give [/color][color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
