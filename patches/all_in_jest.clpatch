  blueprint_compat = false,
  description = (function()
    local base = AIJ.desc('Joker', 'j_aij_lawfirm', function(card)
      return { AIJ.prob(), AIJ.val(card, 'lawfirm', 'odds', 2), AIJ.val(card, 'lawfirm', 'cost', 5), colours = { ABILITY } }
    end)
    return function(r) return base(r) .. hint('Drag this Joker and press SUE') end
  end)(),
  buttons = {
