  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or AIJ.isDebuffed(step.card) or AIJ.noRank(step.card) then return end
      if step.card:getRank() ~= 14 then return end
      local suit = step.card.lastInfo and step.card.lastInfo.suit
      local aces = AIJ.get(joker, 'aces', {})
      if type(aces) ~= 'table' then aces = {} end
      if suit and not aces[suit] then
        aces[suit] = true
        AIJ.set(joker, 'aces', aces)
        AIJ.add(joker, 'dollars', AIJ.num(joker, 'dollar_gain'))
        result:say('$' .. AIJ.fmt(AIJ.num(joker, 'dollars')), colors.MONEY)
      end
    end,
    onCashOut = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'aces', {})
      AIJ.set(joker, 'dollars', 0)
    end,
  },
}

AIJ.addJoker {
  key = 'fortunato',
  rarity = 4, cost = 20, lite = true, atlas = 'legendary_atlas', pos = { x = 5, y = 0 }, soul_pos = { x = 5, y = 1 },
  config = { x_mult = 1, xmult_mod = 0.1 },
  vars = function(card) return { AIJ.val(card, 'fortunato', 'x_mult'), AIJ.val(card, 'fortunato', 'xmult_mod') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or not AIJ.hasEnhancement(step.card, 'm_stone') then return end
      local x = AIJ.add(joker, 'x_mult', AIJ.num(joker, 'xmult_mod'))
      result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'x_mult')
      if x > 1 then result:add(xMult(x)) end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      local scoring = {}
      for _, c in ipairs(step.hand.playedCards or {}) do scoring[c.uid] = true end
      local n = 0
      for _, c in ipairs(step.hand.allCards or {}) do
        if not scoring[c.uid] and not AIJ.hasEnhancement(c, 'm_stone') and AIJ.exists(c) then
          c:setEnhancement(AIJ.vanilla('m_stone'))
          c:punch()
          n = n + 1
        end
      end
      if n > 0 then result:say('Rock!', colors.GREY) end
    end,
  },
}

AIJ.addJoker {
  key = 'fortune_cookie',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 20, y = 10 },
  pools = { Food = true },
  config = { packs_remaining = 5, packs = 5 },
  vars = function(card) return { AIJ.val(card, 'fortune_cookie', 'packs_remaining'), AIJ.val(card, 'fortune_cookie', 'packs') } end,
  triggers = {
    onPackOpened = function(joker, state, step, result)
      if (state.freeConsumableSlots or 0) > 0 and cardlike.createConsumable('game') then
        result:say('+1 Game card', AIJ.colors.TAROT)
      end
      if step.copiedBy then return end
      local left = AIJ.num(joker, 'packs_remaining') - 1
      if left <= 0 then
        result:say('Eaten!', colors.RED)
        result:destroySelf()
      else
        AIJ.set(joker, 'packs_remaining', left)
        result:say(AIJ.fmt(left) .. ' remaining', colors.ORANGE)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'fou_du_roi',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 2, y = 7 },
  config = { odds = 2 },
  vars = function(card) return { odds(1), AIJ.val(card, 'fou_du_roi', 'odds') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local kq = false
      for _, c in ipairs(step.hand.allCards or {}) do
        local r = c:getRank()
        if not AIJ.noRank(c) and (r == 12 or r == 13) then kq = true break end
      end
      if not kq or (state.freeConsumableSlots or 0) <= 0 then return end
      if state:chance(1 / AIJ.num(joker, 'odds')) and cardlike.createConsumable('game') then
        result:say('+1 Game card', AIJ.colors.TAROT)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'founding_father',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 23, y = 0 },
  blueprint_compat = false,
  config = {},
  in_pool = function(state) return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'charged') end) end,
}

local NEXT_RARITY = { Common = 'Uncommon', Uncommon = 'Rare' }

local function countFours(state)
  local n = 0
  for _, c in ipairs(ofList(state, 'allCards')) do
    local i = c.lastInfo or {}
    if i.rank == 4 and not AIJ.noRank(c) then n = n + 1 end
  end
  return n
end

local function cloverShop(joker, state, result)
  local fours = countFours(state)
  if fours <= 0 then return end
  for _, c in ipairs(ofList(state, 'shopCards')) do
    local info = c.lastInfo or {}
    local nextRarity = info.kind == 'joker' and NEXT_RARITY[info.rarity]
    if nextRarity and state:randomFloat() < fours / 100 then
      local id = cardlike.randomJoker(nextRarity)
      if id then
        c:setJokerDef(id)
        c:popup('Upgrade!', colors.ORANGE)
      end
    end
  end
end

AIJ.addJoker {
  key = 'four_leaf_clover',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 14, y = 10 },
  config = {},
  description = D('four_leaf_clover', function() return { cardlike.state and countFours(cardlike.state) or 0 } end,
    function(t) return (t:gsub(' Percentage', '\nPercentage')) end),
  triggers = {
    onShopEnter = function(joker, state, step, result) cloverShop(joker, state, result) end,
    onShopReroll = function(joker, state, step, result) cloverShop(joker, state, result) end,
  },
}

local function isChroma(c) return AIJ.hasEdition(c, 'e_polychrome') end

AIJ.addJoker {
  key = 'fruity_joker',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 17, y = 1 },
  config = { mult = 15 },
  vars = function(card) return { AIJ.val(card, 'fruity_joker', 'mult') } end,
  in_pool = function(state)
    for _, j in ipairs(ofList(state, 'jokers')) do if isChroma(j) then return true end end
    return deckHas(state, isChroma)
  end,
  triggers = {
    onOtherJoker = function(joker, state, step, result)
      if step.other and isChroma(step.other) then result:add(plusMult(AIJ.num(joker, 'mult'))) end
    end,
    onScore = function(joker, state, step, result)
      if isChroma(step.card) then result:add(plusMult(AIJ.num(joker, 'mult'))) end
    end,
  },
}

local skipPinSeen = {}
local FULEHUNG = AIJ.addJoker {
  key = 'fulehung',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 7 },
  config = { odds = 3 },
  vars = function(card) return { odds(1), AIJ.val(card, 'fulehung', 'odds') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      local slot = (step.blind == 'Beta Blind' and 0) or (step.blind == 'Alpha Blind' and 1) or nil
      local pin = slot and skipPinSeen[tostring(state.ante) .. ':' .. slot]
      if pin and state:chance(1 / AIJ.num(joker, 'odds')) then
        cardlike.addPin(pin)
        result:say(AIJ.msg('aij_plus_tag', '+1 Pin'), colors.ORANGE)
      end
    end,
  },
}
if FULEHUNG then
  cardlike.filter('skipPin', function(id, slot)
    local state = cardlike.state
    if state and state.ante and id then skipPinSeen[tostring(state.ante) .. ':' .. tostring(slot)] = id end
    return nil
  end)
end

local FUNNY_BONE = AIJ.addJoker {
  key = 'funny_bone',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 12, y = 24 },
