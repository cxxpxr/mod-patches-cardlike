}

add {
  key = 'doctors_orders',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 7, y = 11 },
  config = { xmult = 1, nine_tally = 0 },
  vars = function(card) return { AIJ.val(card, 'doctors_orders', 'xmult') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local tally = 0
      for _, c in ipairs(step.hand and step.hand.allCards or {}) do
        if rankOf(c) == 9 then tally = tally + AIJ.num(joker, 'xmult') end
      end
      AIJ.set(joker, 'nine_tally', tally)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local t = AIJ.num(joker, 'nine_tally')
      if t > 0 then result:add(xMult(t)) end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.num(joker, 'nine_tally') == 0 then
        result:destroySelf()
        result:say(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.RED)
      else
        AIJ.set(joker, 'nine_tally', 0)
      end
    end,
  },
}

