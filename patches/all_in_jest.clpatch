AIJ.onNewRun(function(run) run.crab_in_a_bucket_start = nil end)
local function recordDeckSize(state)
  if AIJ.run.crab_in_a_bucket_start == nil and state and state.deckSize then
    AIJ.run.crab_in_a_bucket_start = state.deckSize
  end
end
cardlike.on('onRunStart', function(state) AIJ.run.crab_in_a_bucket_start = state and state.deckSize or nil end)
cardlike.on('onRoundStart', function(state) recordDeckSize(state) end)

local function crabDiff(state)
  local start = tonumber(AIJ.run.crab_in_a_bucket_start) or 52
  local size = state and tonumber(state.deckSize) or start
  return math.max(0, size - start), start
end

add {
  key = 'crab_in_a_bucket',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 10, y = 20 },
  lite = true,
  config = { chips = 8 },
  vars = function(card)
    local chips = AIJ.val(card, 'crab_in_a_bucket', 'chips')
    local diff, start = 0, 52
    if card then diff, start = crabDiff(cardlike.state) end
    return { chips, start, diff * chips }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local diff = crabDiff(state)
      if diff > 0 then result:add(plusChips(diff * AIJ.num(joker, 'chips'))) end
    end,
  },
}

local function crayonChips(joker)
  local jokers = cardlike.cards('jokers') or {}
  local right
  for i, j in ipairs(jokers) do if j == joker then right = jokers[i + 1] break end end
  if not right or AIJ.is(right, 'crayon_rubbing') then return 0 end
  local def = defOf(AIJ.defId(right))
  if not def or not def.description then return 0 end
  local text = def.description
  if type(text) == 'function' then
    local ok, t = pcall(text, { card = right })
    text = ok and t or ''
  end
  if type(text) ~= 'string' then return 0 end
  text = text:gsub('%[/?color[^%]]*%]', ''):gsub('%[/?b%]', '')
  local sum = 0
  for n in text:gmatch('%d+') do sum = sum + (tonumber(n) or 0) end
  return math.floor(sum)
end

add {
  key = 'crayon_rubbing',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 14, y = 25 },
  description = withNote('crayon_rubbing', function(card) return { card and crayonChips(card) or 0 } end,
    '(Reads All in Jest Jokers only)'),
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local c = crayonChips(joker)
      if c ~= 0 then result:add(plusChips(c)) end
    end,
  },
}

