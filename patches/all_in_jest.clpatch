end

AIJ.addJoker {
  key = 'sneaky_pete',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 22, y = 5 },
  config = { money_per_seal = 2 },
  vars = function(card)
    local per = AIJ.val(card, 'sneaky_pete', 'money_per_seal')
    return { deckCashStamps(st()) * per, per }
