AIJ.cardSuitIf(function(state, card, suit)
  return fragileWithSuit(card) and stainedOn(state)
end)

local stargazy = { pending = 0, untilT = 0 }

AIJ.addJoker {
  key = 'stargazy_pie',
  lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 2, y = 12 },
  config = { triggers = 5 },
  pools = { Food = true },
  vars = function(card) return { AIJ.val(card, 'stargazy_pie', 'triggers') } end,
  triggers = {
    onConsumableUsed = function(joker, state, step, result)
      local info = step.card and step.card.lastInfo or {}
      if info.type ~= 'fruit' or AIJ.num(joker, 'triggers') < 1 then return end
      stargazy.pending = stargazy.pending + 1
      stargazy.untilT = cardlike.time() + 5
      result:say('Again!', colors.ORANGE)
      if step.copiedBy then return end
      local left = AIJ.add(joker, 'triggers', -1)
      if left <= 0 then
        result:say('Eaten!', colors.RED)
        result:destroySelf()
      end
    end,
  },
}

cardlike.on('onConsumableUsed', function(state, step)
  local info = step and step.card and step.card.lastInfo or {}
  if info.type ~= 'fruit' then stargazy.pending = 0 end
end)
cardlike.on('beforeAllCardsScored', function() stargazy.pending = 0 end)
cardlike.filter('handLevel', function(levels)
  if stargazy.pending <= 0 or type(levels) ~= 'number' or levels <= 0 then return nil end
  local n = stargazy.pending
  stargazy.pending = 0
  if cardlike.time() > stargazy.untilT then return nil end
  return levels * (1 + n)
end)

AIJ.addJoker {
  key = 'stave',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 1, y = 10 },
  blueprint_compat = false,
  triggers = {
    onCardSold = function(joker, state, step, result)
      if step.copiedBy then return end
      local sold = step.card
      local info = sold and sold.lastInfo or {}
      if info.kind ~= 'joker' then return end
      local ed = info.edition
      if ed == nil or ed == '' or ed == 'default' or ed == AIJ.vanilla('e_negative') then return end
      local targets = {}
      for _, j in ipairs(state.jokers or {}) do
        if j ~= sold and not AIJ.edition(j) then targets[#targets + 1] = j end
      end
      local t = AIJ.pick(targets, state)
      if t then
        t:setEdition(ed)
        t:punch()
        result:say(AIJ.msg('k_aij_editioned_ex', 'Editioned!'), colors.PURPLE)
      end
    end,
  },
}

local function stickerCount(state)
  local n = 0
  for _, j in ipairs(state and state.jokers or {}) do
    local info = j.lastInfo or {}
    local s = info.sticker
    if info.locked then n = n + 1 end
    if s ~= nil and s ~= '' and s ~= 'none' and s ~= 'locked' then n = n + 1 end
  end
  return n
end

