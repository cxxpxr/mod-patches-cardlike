      label = 'CYCLE',
      press = function(card, state, opts)
        if opts and opts.repeated then return false end
        local cur = AIJ.get(card, 'current_mult') or 'mult'
        local nextAttr = WAMBA_LIST[1]
        for i, v in ipairs(WAMBA_LIST) do
          if v == cur then nextAttr = WAMBA_LIST[i + 1] or WAMBA_LIST[1] break end
        end
        AIJ.set(card, 'current_mult', nextAttr)
        card:popup(WAMBA_NAMES[nextAttr], colors.ORANGE)
      end,
    }),
  },
}

AIJ.addJoker {
  key = 'warhol',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 8, y = 9 },
  blueprint_compat = false,
  description = C('Stamps', colors.ORANGE) .. ' have the effect of ' .. C('Cash', colors.MONEY) .. ', '
    .. C('Game', AIJ.colors.TAROT) .. ' and ' .. C('Fruit', AIJ.colors.PLANET) .. ' Stamps '
    .. C('simultaneously', colors.ORANGE) .. '\n'
    .. grey('($3 when scored, a Game card when discarded, a Fruit card for the last hand when held at end of round)'),
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'last_hand', step.hand.handType) end
    end,
    onScore = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.stamp(step.card) and not AIJ.hasStamp(step.card, 'Gold') then result:add(plusMoney(3)) end
    end,
    onDiscardCard = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.stamp(step.card) and not AIJ.hasStamp(step.card, 'Purple') and (state.freeConsumableSlots or 0) > 0 then
        cardlike.createConsumable('game')
        result:say('+1 Game', AIJ.colors.TAROT, step.card)
      end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local fruit = FRUIT_OF[AIJ.get(joker, 'last_hand') or '']
      if not fruit then return end
      for _, c in ipairs(state.cardsInHand or {}) do
        if AIJ.stamp(c) and not AIJ.hasStamp(c, 'Blue') and not AIJ.isDebuffed(c) and (state.freeConsumableSlots or 0) > 0 then
          cardlike.createConsumable(fruit)
          result:say('+1 Fruit', AIJ.colors.PLANET, c)
        end
      end
    end,
  },
}

