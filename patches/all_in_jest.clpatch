AIJ.onJokerGone(function(state, info)
  local value = tonumber(info and info.sellValue) or 0
  if value <= 0 then return end
  for _, j in ipairs(owned('dont_be_a_joker')) do
    j:addSellValue(value)
    j:popup(AIJ.msg('k_val_up', 'Value Up!'), colors.MONEY)
  end
end)

add {
  key = 'doodle',
  rarity = 3, cost = 10, atlas = 'joker_atlas', pos = { x = 24, y = 0 },
  config = { odds = 2, should_activate = false },
  description = withNote('doodle', function(card)
    local on = AIJ.val(card, 'doodle', 'should_activate') == true
    return { AIJ.prob(), AIJ.val(card, 'doodle', 'odds'), on and '(Active)' or '(Inactive)' }
  end, '(All in Jest Jokers only)'),
  triggers = copierTriggers(function(joker)
    if AIJ.get(joker, 'should_activate') ~= true then return {} end
    return neighbourTargets(joker)
  end, {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then
        AIJ.set(joker, 'should_activate', true)
        result:say(AIJ.msg('k_active_ex', 'Active!'), colors.GREEN)
      else
        AIJ.set(joker, 'should_activate', false)
        result:say('Inactive', colors.RED)
      end
    end,
  }, { beforeRound = true }),
}

