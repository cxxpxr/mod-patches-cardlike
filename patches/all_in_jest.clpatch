  ["aij_hex_tarot"] = {
    ["c_aij_error"] = { name = "The Error", text = "Apply [color=\"#ff007f\"][b]Chaotic[/b][/color] to up to [color=\"#f3a712\"][b]#1#[/b][/color] selected cards" },
    ["c_aij_faceless"] = { name = "The Faceless", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] leftmost [color=\"#f3a712\"][b]Joker[/b][/color] and create an [color=\"#5d5dff\"][b]Inverted[/b][/color] [color=\"#f3a712\"][b]Joker[/b][/color] of lower rarity" },
    ["c_aij_inn"] = { name = "The Inn", text = "Creates a random [color=\"#4584fa\"][b]Familiar Face[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["c_aij_janitor"] = { name = "The Janitor", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] all cards held in [color=\"#f3a712\"][b]hand[/b][/color]" },
    ["c_aij_oracle"] = { name = "The Oracle", text = "[color=\"#f3a712\"][b]All[/b][/color] cards in your hand are given a [color=\"#f3a712\"][b]single[/b][/color] [color=\"#f3a712\"][b]random[/b][/color] enhancement" },
  },
  dict = {
    ["aij_alter_trypophobia"] = "Alter Trypophobia",
    ["aij_alter_trypophobia_tooltip"] = "[color=\"#f3a712\"][b]Changes[/b][/color] the sprite of [color=\"#f3a712\"][b]Trypophobia[/b][/color] to be [color=\"#f3a712\"][b]less disturbing[/b][/color]\n[color=\"#ff007f\"][b](Requires restart)[/b][/color]",
    ["aij_blue_stake_rework"] = "Blue Stake Rework",
    ["aij_blue_stake_rework_tooltip"] = "[color=\"#f3a712\"][b]Changes[/b][/color] Blue Stake to use the new [color=\"#f3a712\"][b]Pit Blinds[/b][/color] instead of [color=\"#ff007f\"][b]-1[/b][/color] Discard\n[color=\"#ff007f\"][b](Requires restart)[/b][/color]",
    ["aij_borra_triggers"] = "card is scored card is discarded a consumable is used anything is purchased anything is sold blind is selected blind is skipped blind is defeated booster pack is skipped hand is played boss blind effect is triggered card is destroyed Joker is destroyed discard is used rerolling in the shop a playing card is added to deck interest is earned lucky card triggers steel card triggers pin is gained pin activates poker hand levels up consumable is acquired",
    ["aij_button_consistency"] = "Consistency",
    ["aij_button_content"] = "Content",
    ["aij_button_moons"] = "Moons",
    ["aij_button_visuals"] = "Visuals / Accessibility",
    ["aij_doesnt_requires_restart"] = "Doesn't Require Restart",
    ["aij_enable_moons"] = "Enable Moons",
    ["aij_enable_moons_tooltip"] = "Enables [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color]-type [color=\"#13afce\"][b]Fruit cards[/b][/color] to show up\n[color=\"#ff007f\"][b](Requires restart)[/b][/color]",
    ["aij_guess_names"] = "Guess the Jest Names",
    ["aij_guess_names_tooltip"] = "Accessibility option for [color=\"#d138bf\"][b]Guess[/b][/color] [color=\"#d138bf\"][b]the Jest Packs[/b][/color], showing the names of the Jokers\n[color=\"#9a9a9a\"](but not their descriptions)[/color]\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
    ["aij_lite"] = "All in Jest Lite",
    ["aij_lite_tooltip"] = "Enables only a hand-picked selection of the most [color=\"#f3a712\"][b]vanilla-adjacent[/b][/color] content\n[color=\"#9a9a9a\"](Currently 76 things)[/color]\n[color=\"#ff007f\"][b](Requires restart)[/b][/color]",
    ["aij_moons_blocking"] = "Moon Blocking",
    ["aij_moons_blocking_tooltip"] = "If [color=\"#13afce\"][b]Moons[/b][/color] are enabled, prevents multiple [color=\"#13afce\"][b]Fruit cards[/b][/color] of the same hand type from appearing at once\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
    ["aij_mult_appearance"] = "More common Mult",
    ["aij_mult_appearance_opt"] = "Off Standard Strong",
    ["aij_mult_appearance_tooltip"] = "Makes [color=\"#ff007f\"][b]Mult[/b][/color] Jokers appear more consistently at the [color=\"#f3a712\"][b]start[/b][/color] of a run\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
    ["aij_no_copy_neg"] = "Copy Inverted Playing Cards",
    ["aij_no_copy_neg_tooltip"] = "Allows the [color=\"#5d5dff\"][b]Inverted[/b][/color] edition on [color=\"#f3a712\"][b]playing cards[/b][/color] to be copied. While [color=\"#f3a712\"][b]off[/b][/color] (default), copied [color=\"#5d5dff\"][b]Inverted[/b][/color] cards [color=\"#ff007f\"][b]lose[/b][/color] their edition\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
    ["aij_paid_off"] = "Paid Off",
    ["aij_pc_stickers"] = "Playing Card Stickers",
    ["aij_plus_tag"] = "+1 Pin",
    ["aij_random_deck_skins"] = "Randomized Deck Skins",
    ["aij_random_deck_skins_tooltip"] = "[color=\"#f3a712\"][b]Playing cards[/b][/color] added to the deck have random [color=\"#f3a712\"][b]deck skins[/b][/color]\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
    ["aij_red_destroy_text"] = "Modify Joker Descriptions",
    ["aij_red_destroy_text_tooltip"] = "Changes all [color=\"#f3a712\"][b]Vanilla[/b][/color] and [color=\"#f3a712\"][b]Modded[/b][/color] card descriptions to make \"destroy\" [color=\"#ff007f\"][b]red[/b][/color].\n[color=\"#9a9a9a\"](This may negatively impact[/color] [color=\"#9a9a9a\"]tooltips from other mods)[/color]\n[color=\"#ff007f\"][b](Requires restart)[/b][/color]",
    ["aij_refreshed"] = "Refreshed",
    ["aij_requires_restart"] = "Requires Restart",
    ["aij_suit_boss_blocking"] = "Suit-Boss Blocking",
    ["aij_suit_boss_blocking_tooltip"] = "Makes [color=\"#f3a712\"][b]Boss Blinds[/b][/color] that affect a [color=\"#f3a712\"][b]suit[/b][/color] prevent other bosses with that [color=\"#f3a712\"][b]same suit[/b][/color] from appearing in later [color=\"#f3a712\"][b]Antes[/b][/color]\n[color=\"#9a9a9a\"](Doesn't require restart)[/color]",
