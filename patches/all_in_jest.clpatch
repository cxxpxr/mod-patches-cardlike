AIJ.addJoker {
  key = 'bellhop',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 4, y = 35 },
  config = { slots = 1 },
  vars = function(card) return { AIJ.val(card, 'bellhop', 'slots') } end,
  blueprint_compat = false,
  onAdded = function(joker, state) state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + AIJ.num(joker, 'slots') end,
  onRemoved = function(joker, state) state.cardsAvailableInShopCount = state.cardsAvailableInShopCount - AIJ.num(joker, 'slots') end,
}

