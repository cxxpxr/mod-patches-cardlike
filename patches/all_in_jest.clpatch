== file items/blinds_finisher.lua (145 lines)
local AIJ = cardlike.require('lib.aij')
local B = cardlike.require('items.blinds_boss')

local function finisher(s)
  s.kind = 'finisher'
  s.min = 1
  s.atlas = 'blinds_final'
  s.dollars = s.dollars or 8
  return B.add(s)
end

finisher {
  key = 'angling_hook', colour = '9b4e64', y = 24,
  description = 'Cards played or discarded this Ante are not drawn this round',
  banish = function(c) return B.playedThisAnte(c) or B.discardedThisAnte(c) end,
  banishReplace = true,
}

finisher {
  key = 'aureate_coin', mult = 1, colour = 'eba03a', y = 0,
  description = '+0.1X Base per $1 spent this Ante',
  target = function(state) return B.run().blinds_ante.spent * 0.1, 0 end,
}

finisher {
  key = 'golden_string', colour = 'efb855', y = 11,
  description = 'Lose $2 per card played. All cards are debuffed while you have $0 or less',
  debuff = function(c, state) return (state.money or 0) <= 0 end,
  played = function(state, hand)
    local cards = hand.allCards or {}
    if #cards > 0 then state:mutateMoney(-2 * #cards) end
    if (state.money or 0) <= 0 then
      for _, c in ipairs(cards) do c:setDebuffState(true) end
    end
  end,
}

finisher {
  key = 'mysterious_myriad', colour = '9e74a4', y = 15,
  description = 'Hands that score fewer than 5 cards lose 20% of their score per card under 5',
  on = {
    afterHand = function(state, step)
      local n = #(step.hand.playedCards or {})
      if n >= 5 then return end
      local keep = math.max(0, 1 - 0.2 * (5 - n))
      state.currentChips = math.floor((state.currentChips or 0) * keep)
      B.say('-' .. math.floor((1 - keep) * 100 + 0.5) .. '%')
    end,
  },
}

finisher {
  key = 'obsidian_blade', mult = 3, colour = '635d91', y = 1, lite = true,
  description = '-1 Hand, -1 Discard, -1 Hand size. Large blind',
  start = function(state)
    state.handsLeft = math.max(1, (state.handsLeft or 1) - 1)
    state.discardsLeft = math.max(0, (state.discardsLeft or 0) - 1)
    state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) - 1
  end,
  disable = function(state)
    state.handsLeft = (state.handsLeft or 0) + 1
    state.discardsLeft = (state.discardsLeft or 0) + 1
    state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + 1
  end,
}

local function duckRestore(state, R)
  if not R.duck then return end
  for ht, n in pairs(R.duck) do
    if n > 0 then state:upgradeHand(ht, n) end
  end
  R.duck = nil
end

finisher {
  key = 'rubber_duck', colour = 'e6c56f', y = 6,
  start = function(state, R)
    R.duck = {}
    for _, ht in ipairs(AIJ.HANDS) do
      if ht ~= 'ROYAL_FLUSH' then
        local h = state:getHand(ht)
        local lv = h and h.level or 1
        if lv > 1 then
          R.duck[ht] = lv - 1
          state:upgradeHand(ht, -(lv - 1))
        end
      end
    end
  end,
  disable = duckRestore,
  cleanup = duckRestore,
}

finisher {
  key = 'silver_stag', colour = '9cacbe', y = 4,
  debuff = function(c) return not B.discardedThisAnte(c) end,
}

finisher {
  key = 'tarnished_tile', colour = 'f28a3c', y = 14,
  description = 'Double your hand size. After your first draw, no more cards are drawn this round',
  start = function(state, R)
    R.tile = state.handSize or 8
    state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + R.tile
  end,
  disable = function(state, R)
    state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) - (R.tile or 0)
  end,
  on = {
    onHandDrawn = function(state, step)
      local V = B.V()
      if V.keep == nil then
        V.keep = {}
        for _, c in ipairs(state.cardsInHand or {}) do V.keep[B.uid(c)] = true end
      end
    end,
  },
  banish = function(c)
    local keep = B.V().keep
    return keep ~= nil and not keep[B.uid(c)]
  end,
}

finisher {
  key = 'wooden_wheel', colour = '9f7b60', y = 22,
  gate = function(state) return #(state.jokers or {}) >= 1 end,
  start = function(state)
    local jokers = state.jokers or {}
    local picks = { jokers[1] }
    if #jokers >= 2 then picks[2] = jokers[#jokers] end
    for _, j in ipairs(picks) do
      local old = AIJ.defId(j)
      local rarity = (j.lastInfo and j.lastInfo.rarity) or AIJ.safe(j.getRarity, j) or 'Common'
      for _ = 1, 5 do
        local id = cardlike.randomJoker(rarity)
        if id and id ~= old then
          j:setJokerDef(id)
          j:punch()
          break
        end
      end
    end
  end,
}


== file items/blinds_pit.lua (344 lines)
local AIJ = cardlike.require('lib.aij')
local B = cardlike.require('items.blinds_boss')

local function pit(s)
  s.kind = 'pit'
  s.min = s.min or 4
  s.atlas = 'blinds_pit'
  s.dollars = s.dollars or 6
  return B.add(s)
end

local function info(c) return (type(c) == 'table' and c.lastInfo) or {} end

pit {
  key = 'the_arrow', colour = '967465', y = 12,
  start = function(state, R) R.best = nil end,
  on = {
    afterHand = function(state, step, R)
      local s = B.handScore(state)
      if R.best ~= nil and s <= R.best then
        state.currentChips = 0
        state.currentMult = 0
        B.say('Not allowed!')
        s = 0
      end
      if R.best == nil or s > R.best then R.best = s end
    end,
  },
}

pit {
  key = 'the_bird', colour = 'c7b28c', y = 11, lite = true,
  description = 'Before scoring, 1 random Joker changes places with another Joker',
  on = {
    beforeAllCardsScored = function(state)
      local jokers = state.jokers or {}
      if #jokers < 2 then return end
      local a = state:random(1, #jokers)
      local b = state:random(1, #jokers - 1)
      if b >= a then b = b + 1 end
      local ja, jb = jokers[a], jokers[b]
      local ida, idb = AIJ.defId(ja), AIJ.defId(jb)
      if not ida or not idb or ida == idb then return end
      local ea, eb = AIJ.edition(ja) or 'default', AIJ.edition(jb) or 'default'
      local sa, sb = B.jokerSticker(ja), B.jokerSticker(jb)
      local dsa, dsb = ja:getDataStore(), jb:getDataStore()
      local va, vb = {}, {}
      for _, k in ipairs(dsa:keys() or {}) do va[k] = dsa:get(k) end
      for _, k in ipairs(dsb:keys() or {}) do vb[k] = dsb:get(k) end
      ja:setJokerDef(idb)
      jb:setJokerDef(ida)
      ja:setEdition(eb)
      jb:setEdition(ea)
      ja:setSticker(sb)
      jb:setSticker(sa)
      for k in pairs(va) do dsa:delete(k) end
      for k in pairs(vb) do dsb:delete(k) end
      for k, v in pairs(vb) do dsa:set(k, v) end
      for k, v in pairs(va) do dsb:set(k, v) end
      ja:punch()
      jb:punch()
    end,
  },
}

pit {
  key = 'the_brilliance', colour = 'e8dd9d', y = 13, lite = true, dynamic = true,
  description = 'Must meet the score goal twice. +2 Hands',
  start = function(state) state.handsLeft = (state.handsLeft or 0) + 2 end,
  disable = function(state) state.handsLeft = math.max(1, (state.handsLeft or 0) - 2) end,
  on = {
    afterHand = function(state, step, R)
      if R.met or not B.wins(state) then return end
      R.met = true
      R.dAdd = (R.dAdd or 0) + (state.score or 0) + B.handScore(state)
      B.say('Again!')
    end,
  },
}

pit {
  key = 'the_business', colour = '3e4b4d', y = 21,
  description = 'When defeated, destroy the leftmost or rightmost Joker and create a Locked Common Joker',
  finish = function(state)
    local list = {}
    for _, j in ipairs(state.jokers or {}) do if not B.jokerLocked(j) then list[#list + 1] = j end end
    if #list == 0 then return end
    local j = state:random(1, 2) == 2 and list[#list] or list[1]
    j:destroy()
    cardlike.createJoker('Common', { locked = true, force = true })
  end,
}

pit {
  key = 'the_child', colour = 'c1b297', y = 2,
  on = {
    afterHand = function(state, step)
      for _, c in ipairs(step.hand.playedCards or {}) do
        local r = B.rank(c)
        if r and r > 2 then
          c:setRank(r - 1)
          c:punch()
        end
      end
    end,
  },
}

pit {
  key = 'the_conflagration', colour = 'bc8866', y = 8,
  description = 'When a hand wins, destroy all cards played and held in hand',
  on = {
    afterHand = function(state, step)
      if not B.wins(state) then return end
      for _, c in ipairs(step.hand.allCards or {}) do c:destroy() end
      for _, c in ipairs(step.held or {}) do c:destroy() end
    end,
  },
}

pit {
  key = 'the_connection', mult = 0.5, colour = 'b8c8cd', y = 24,
}

pit {
  key = 'the_divine', colour = 'd9d9d9', y = 10, gate = B.hasEnhanced(4),
  canPlayHand = function(state, hand)
    for _, c in ipairs(hand.allCards or {}) do if B.enhanced(c) then return true end end
    return false
  end,
}

pit {
  key = 'the_dragon', mult = 1, colour = '95a996', y = 6, lite = true,
  on = {
    onHandDrawn = function(state, step, R)
      local V = B.V()
      local hand = state.cardsInHand or {}
      if step and step.first or V.known == nil then
        V.known = {}
        for _, c in ipairs(hand) do V.known[B.uid(c)] = true end
        return
      end
      local kept, new = 0, {}
      for _, c in ipairs(hand) do
        if V.known[B.uid(c)] then kept = kept + 1 else new[#new + 1] = c end
      end
      if kept > 0 then
        for _, c in ipairs(new) do c:moveTo('deck') end
      end
      V.known = {}
      for _, c in ipairs(state.cardsInHand or {}) do V.known[B.uid(c)] = true end
    end,
  },
}

pit {
  key = 'the_earth', colour = '7b6a62', y = 5,
  on = {
    afterHand = function(state, step)
      for _, c in ipairs(step.held or {}) do
        if not AIJ.hasEnhancement(c, 'm_stone') then
          c:setEnhancement('Rock')
          c:punch()
        end
      end
    end,
  },
}

local HEART_HANDS = { 'TWO_PAIR', 'FLUSH', 'STRAIGHT', 'THREE_OF_A_KIND' }
pit {
  key = 'the_heart', colour = 'b18c8c', y = 0,
  description = 'Hands do not score until you play a hand that contains the chosen poker hand (Two Pair, Flush, Straight or Three of a Kind, shown when the blind starts)',
  start = function(state, R)
    R.hand = HEART_HANDS[state:random(1, #HEART_HANDS)]
    R.met = false
    B.say('The Heart: play a ' .. AIJ.handName(R.hand))
  end,
  canPlayHand = function(state, hand, R)
    if R.met then return true end
    if hand.contains and hand.contains[R.hand] then
      R.met = true
      return true
    end
    return false
  end,
}

pit {
  key = 'the_moon', colour = '95a8a9', y = 3,
  description = 'While you have an odd number of hands left, all cards are debuffed',
  debuff = function(c, state) return (state.handsLeft or 0) % 2 == 1 end,
}

pit {
  key = 'the_mountain', mult = 6, colour = 'a7a5a3', y = 7,
  description = 'Very large blind. +1 Hand size',
  start = function(state) state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + 1 end,
  disable = function(state) state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) - 1 end,
}

pit {
  key = 'the_multitude', colour = '8d759f', y = 22,
  description = '1 in 3 cards are debuffed. Debuffed cards that are still in the deck at the end of the round are destroyed',
  start = function(state, R)
    local V = B.V()
    for _, c in ipairs(state.allCards or {}) do
      if state:chance(1 / 3) then V.mark[B.uid(c)] = 'multitude' end
    end
  end,
  debuff = function(c) return B.V().mark[B.uid(c)] == 'multitude' end,
  finish = function(state)
    local V = B.V()
    for _, c in ipairs(state.unDrawnCards or {}) do
      if V.mark[B.uid(c)] == 'multitude' then c:destroy() end
    end
  end,
}

pit {
  key = 'the_pair', colour = '82bee4', y = 16,
  canPlayHand = function(state, hand)
    local played = {}
    for _, c in ipairs(hand.allCards or {}) do played[B.uid(c)] = true end
    local held = {}
    for _, c in ipairs(state.cardsInHand or {}) do
      if not played[B.uid(c)] then held[#held + 1] = c end
    end
    if #held < 2 then return false end
    local h = cardlike.evaluateHand(held)
    return h ~= nil and h.contains ~= nil and h.contains.PAIR == true
  end,
}

pit {
  key = 'the_rains', colour = '869ca7', y = 1,
  description = 'Cards played in a winning hand lose their enhancements, editions and stamps',
  on = {
    afterHand = function(state, step)
      if not B.wins(state) then return end
      for _, c in ipairs(step.hand.allCards or {}) do
        c:setEnhancement('Default')
        c:setEdition('default')
        c:setStamp(nil)
        c:punch()
      end
    end,
  },
}

pit {
  key = 'the_shell', colour = 'cca7b2', y = 4, lite = true,
  description = '1 in 4 cards are debuffed. 1 in 3 cards are drawn face down',
  start = function(state)
    local V = B.V()
    for _, c in ipairs(state.allCards or {}) do
      if state:chance(1 / 4) then V.mark[B.uid(c)] = 'shell' end
    end
  end,
  debuff = function(c) return B.V().mark[B.uid(c)] == 'shell' end,
  onNewCard = function(c, state)
    if state:chance(1 / 3) then B.V().face[B.uid(c)] = true end
  end,
}

local function trio(state, counted, exclude)
  local V = B.V()
  local ranks = {}
  for _, c in ipairs(counted) do
    local r = B.rank(c)
    if r then ranks[r] = (ranks[r] or 0) + 1 end
  end
  local three = false
  for _, n in pairs(ranks) do if n == 3 then three = true end end
  if not three then return end
  local pool = {}
  for _, c in ipairs(state.cardsInHand or {}) do
    if not exclude[B.uid(c)] and not info(c).debuffed then pool[#pool + 1] = c end
  end
  pool = AIJ.shuffled(pool, state)
  for i = 1, math.min(3, #pool) do
    local c = pool[i]
    V.mark[B.uid(c)] = 'trio'
    V.debuffed[B.uid(c)] = true
    c:setDebuffState(true)
  end
end

pit {
  key = 'the_trio', colour = 'd3b994', y = 23,
  description = 'If the cards in hand hold 3 cards of the same rank after a Play or a Discard, debuff 3 random cards in hand',
  debuff = function(c) return B.V().mark[B.uid(c)] == 'trio' end,
  on = {
    beforeAllCardsScored = function(state, step)
      trio(state, step.held or {}, {})
    end,
    onDiscard = function(state, step)
      local seen, counted, exclude = {}, {}, {}
      for _, c in ipairs(step.discardedCards or {}) do
        exclude[B.uid(c)] = true
      end
      for _, list in ipairs({ state.cardsInHand or {}, step.discardedCards or {} }) do
        for _, c in ipairs(list) do
          local u = B.uid(c)
          if not seen[u] then
            seen[u] = true
            counted[#counted + 1] = c
          end
        end
      end
      trio(state, counted, exclude)
    end,
  },
}

pit {
  key = 'the_umbilical', colour = 'ae7a8a', y = 9,
  on = {
    afterHand = function(state, step)
      local beanstalk = AIJ.owns('beanstalk', state)
      local pool = {}
      for _, c in ipairs(step.held or {}) do
        if not B.store(c, B.PC.marked) and not (beanstalk and B.rank(c) == 11) then pool[#pool + 1] = c end
      end
      local c = AIJ.pick(pool, state)
      if c then
        B.setStore(c, B.PC.marked, true)
        c:punch()
      end
    end,
  },
  cleanup = function(state)
    for _, c in ipairs(state.allCards or {}) do
      if B.store(c, B.PC.marked) then B.setStore(c, B.PC.marked, false) end
    end
  end,
  disable = function(state)
    for _, c in ipairs(state.allCards or {}) do
      if B.store(c, B.PC.marked) then B.setStore(c, B.PC.marked, false) end
    end
  end,
}


== file items/challenges.lua (213 lines)
local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')
local STAKES = cardlike.require('items.stakes')

local function plain(text) return (tostring(text or ''):gsub('%[/?b%]', ''):gsub('%[color="[^"]*"%]', ''):gsub('%[/color%]', '')) end
local function rule(key) return plain(AIJ.msg('ch_c_aij_' .. key, key)) end
local function J(key) return AIJ.id(key) end
local function V(key) return AIJ.vanilla(key) end

local function active(state, key) return state and state.challenge ~= nil and AIJ.isId(state.challenge, key) end

local function addChallenge(def)
  def.name = AIJ.msg('c_aij_' .. def.id, def.id)
  return AIJ.register('addChallenge', def, 'challenge')
end

