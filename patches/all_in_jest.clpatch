local function pngTargetDef(card)
  local t = AIJ.get(card, 'png_target')
  return t and AIJ.jokerDefs[t] or nil, t
end

local function pngPool()
  local out = {}
  for _, id in ipairs(AIJ.jokers) do
    local def = AIJ.jokerDefs[id]
    local short = AIJ.short(id)
    if def and not AIJ.contains(COPIERS, short) and not AIJ.abilities[id]
      and ((type(def.triggers) == 'table' and next(def.triggers) ~= nil) or def.dollarsAtRoundEnd) then
      out[#out + 1] = id
    end
  end
  return out
end

local PNG_OWN = { base_cost = true, cost = true, cost_increase = true, png_target = true, png_keys = true }

local function pngSetTarget(card, state, id)
  local old = pngTargetDef(card)
  local inRow = AIJ.safe(card.getArea, card) == 'jokers'
  if old and old.onRemoved and inRow then AIJ.safe(old.onRemoved, card, state) end
  for _, k in ipairs(AIJ.get(card, 'png_keys') or {}) do AIJ.set(card, k, nil) end
  AIJ.set(card, 'png_target', id)
  local keys = {}
  for k, v in pairs(AIJ.defaults[id or ''] or {}) do
    if not PNG_OWN[k] then
      keys[#keys + 1] = k
      AIJ.set(card, k, AIJ.copy(v))
    end
  end
  AIJ.set(card, 'png_keys', keys)
  local def = AIJ.jokerDefs[id or '']
  if def and def.onAdded and inRow then AIJ.safe(def.onAdded, card, state) end
end

local function pngReroll(card, state)
  local id = AIJ.pick(pngPool(), state)
  if id then pngSetTarget(card, state, id) end
  return id
end

local pngTriggers = {}
for _, name in ipairs(COPY_TRIGGERS) do
  pngTriggers[name] = function(joker, state, step, result)
    if name == 'onAnteChanged' and not step.copiedBy and (step.delta or 0) ~= 0 then
      AIJ.set(joker, 'cost', AIJ.num(joker, 'base_cost'))
    end
    local def = pngTargetDef(joker)
    local fn = def and type(def.triggers) == 'table' and def.triggers[name]
    if not fn then return nil end
    return runTrigger(fn, joker, state, step, result)
  end
end

AIJ.addJoker {
  key = 'joker_png',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 24, y = 11 },
  config = { base_cost = 1, cost = 1, cost_increase = 1 },
  description = function(r)
    local card = r and r.card
    local e = AIJ.loc('Joker', 'j_aij_joker_png') or { text = '' }
    local text = AIJ.fill(e.text, { AIJ.val(card, 'joker_png', 'cost', 1), AIJ.val(card, 'joker_png', 'cost_increase', 1),
      colours = { ABILITY } }) .. '\n' .. colorize('(All in Jest Jokers only. Drag this Joker and press REROLL)', GREY)
    local def, id = nil, nil
    if card then def, id = pngTargetDef(card) end
    if def then
      text = text .. '\n' .. colorize('Copying: ', GREY) .. colorize(bold(def.readableName or AIJ.short(id)), colors.ORANGE)
      local d = def.description
      local ok, dtext = true, d
      if type(d) == 'function' then ok, dtext = pcall(d, { card = card }) end
      if ok and type(dtext) == 'string' and dtext ~= '' then text = text .. '\n' .. dtext end
    end
    return text
  end,
  onAdded = function(joker, state)
    local def = pngTargetDef(joker)
    if not def then
      pngReroll(joker, state)
    elseif def.onAdded then
      AIJ.safe(def.onAdded, joker, state)
    end
  end,
  onRemoved = function(joker, state)
    local def = pngTargetDef(joker)
    if def and def.onRemoved then AIJ.safe(def.onRemoved, joker, state) end
  end,
  dollarsAtRoundEnd = function(joker, state)
    local def = pngTargetDef(joker)
    if def and def.dollarsAtRoundEnd then
      local ok, v = pcall(def.dollarsAtRoundEnd, joker, state)
      if ok and type(v) == 'number' then return v end
    end
    return 0
  end,
  triggers = pngTriggers,
  buttons = {
    AIJ.ability('joker_png', {
      label = 'REROLL',
      canPress = function(card, state) return (state.money or 0) >= AIJ.num(card, 'cost') end,
      press = function(card, state, opts)
        local free = opts and opts.free
        if not free then
          if (state.money or 0) < AIJ.num(card, 'cost') then return false end
          state:mutateMoney(-AIJ.num(card, 'cost'))
        end
        if not pngReroll(card, state) then return false end
        if not free then AIJ.add(card, 'cost', AIJ.num(card, 'cost_increase')) end
        card:punch()
        card:popup('Reroll!', colors.ORANGE)
      end,
    }),
  },
}

AIJ.addJoker {
  key = 'jokey_bear',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 20, y = 24 },
  config = { dollars = 3, xmult = 0.75 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'jokey_bear', 'xmult', 0.75), AIJ.val(card, 'jokey_bear', 'dollars', 3) } end,
  triggers = {
    finalScoring = function(joker, state, step, result)
      local target = state.blind and state.blind.target
      if not target or target <= 0 then return end
      local x = AIJ.num(joker, 'xmult')
      if x <= 0 or x >= 1 then return end
      local s = (state.currentChips or 0) * (state.currentMult or 0)
      local k = 0
      while s >= target and k < 1000 do
        k = k + 1
        s = s * x
      end
      if k == 0 then return end
      result:add(xMult(x ^ k))
      result:add(plusMoney(AIJ.num(joker, 'dollars') * k))
      if k > 1 then result:say('Again! x' .. (k - 1), colors.ORANGE) end
    end,
  },
}

