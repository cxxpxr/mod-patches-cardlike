local WAMBA_LIST = { 'mult', 'chips', 'xmult', 'retrigger', 'scaling', 'hand_type', 'suit', 'rank', 'face', 'economy',
  'generation', 'destroy_card', 'hand_size', 'chance', 'tarot', 'planet', 'food' }
local WAMBA_NAMES = {
  mult = '+Mult', chips = '+Points', xmult = 'XMult', retrigger = 'Retrigger', scaling = 'Scaling',
  hand_type = 'Poker Hand', suit = 'Suit-related', rank = 'Rank-related', face = 'Face card related',
  economy = 'Economy', generation = 'Generating', destroy_card = 'Card-destroying', hand_size = 'Hand Size',
  chance = 'Probability based', tarot = 'Game card related', planet = 'Fruit card related', food = 'Food',
}
local wambaPools = {}
local function wambaPool(attr)
  if wambaPools[attr] then return wambaPools[attr] end
  local out = {}
  for k in (WAMBA_ATTRS[attr] or ''):gmatch('%S+') do out[#out + 1] = k end
  wambaPools[attr] = out
  return out
end

local function wambaPick(attr, state)
  local ok = {}
  for _, k in ipairs(wambaPool(attr)) do
    local full = AIJ.id(k)
    local rarity = AIJ.jokerRarity[full]
    if AIJ.has(k, 'joker') and rarity ~= 'Legendary' and rarity ~= 'familiar_face' and not AIJ.noShop[full]
      and not state:hasJoker(full) then
      local gate = AIJ.gates[full]
      local pass = true
      if gate then
        local good, res = pcall(gate, state)
        pass = (not good) or res ~= false
      end
      if pass then ok[#ok + 1] = full end
    end
  end
  return AIJ.pick(ok, state)
end

local function wambaFill(state)
  for _, j in ipairs(owned('wamba', state)) do
    local id = wambaPick(AIJ.get(j, 'current_mult') or 'mult', state)
    if id then cardlike.addShopItem(id) end
  end
end
