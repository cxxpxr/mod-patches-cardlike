AIJ.addJoker {
  key = 'headstone',
  rarity = 2, cost = 5, atlas = 'joker_atlas', pos = { x = 0, y = 13 },
  blueprint_compat = false,
  in_pool = function(state) return deckHas(state, function(c) return info(c).face == true end) end,
  triggers = {
    onHandDrawn = function(joker, state, step, result)
      if step.copiedBy then return end
      local others = {}
      local deck = state.unDrawnCards or {}
      for i = #deck, 1, -1 do
        if not info(deck[i]).face then others[#others + 1] = deck[i] end
      end
      if #others == 0 then return end
      local k = 1
      for _, c in ipairs(state.cardsInHand or {}) do
        if k > #others then break end
        local i = info(c)
        if i.face and not i.selected then
          if AIJ.safe(others[k].moveTo, others[k], 'hand') then
            AIJ.safe(c.moveTo, c, 'deck')
          end
          k = k + 1
        end
      end
    end,
  },
}

local function creditsJoker(key, pos, infoKey)
  local e = AIJ.loc('Joker', 'j_aij_' .. key) or {}
  local more = AIJ.loc('Other', infoKey)
  local text = (e.text or '')
  if more and more.text and more.text ~= '' then text = text .. '\n' .. colorize(more.text, GREY) end
  AIJ.addJoker {
    key = key, lite = true,
    rarity = 1, cost = 4, atlas = 'familiar_atlas', pos = pos,
    blueprint_compat = false,
    description = text,
    in_pool = function() return false end,
  }
end
creditsJoker('heavenbrand_credits_joker', { x = 2, y = 1 }, 'heavenbrand_credits_info')

