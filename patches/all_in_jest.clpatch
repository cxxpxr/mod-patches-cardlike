local taggart = { queue = {}, adding = false }
local DONUT_PIN = AIJ.vanilla('tag_double')

AIJ.addJoker {
  key = 'taggart',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 10, y = 10 },
  config = { tags = 1 },
  vars = function(card) return { AIJ.val(card, 'taggart', 'tags') } end,
}

cardlike.filter('pinAdded', function(ok, pin)
  if taggart.adding or ok == false then return nil end
  local state = cardlike.state
  local owners = ownedActive(state, 'taggart')
  if #owners == 0 then return nil end
  local id = AIJ.defId(pin)
  if not id or id == DONUT_PIN then return nil end
  for _, j in ipairs(owners) do
    for _ = 1, AIJ.num(j, 'tags') do taggart.queue[#taggart.queue + 1] = { id = id, uid = j.uid } end
  end
end)

cardlike.onFrame(function(frame)
  if #taggart.queue == 0 then return end
  if not frame.inRun then taggart.queue = {} return end
  local item = table.remove(taggart.queue, 1)
  taggart.adding = true
  AIJ.safe(cardlike.addPin, item.id)
  taggart.adding = false
  local j = cardlike.card(item.uid)
  if AIJ.exists(j) then j:popup(AIJ.msg('k_aij_double_ex', 'Doubled!'), colors.ORANGE) end
end)

