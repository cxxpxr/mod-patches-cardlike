AIJ.addJoker {
  key = 'liquorice',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 34 },
  config = { xmult_minus_mod = 0.1, xmult_mod = 0.25, xmult = 0 },
  description = function(r)
    local card = r and r.card
    return 'This Joker gains ' .. B('X' .. AIJ.fmt(AIJ.val(card, 'liquorice', 'xmult_mod')), colors.MULT)
      .. ' Mult when a card becomes a ' .. B('Multicard') .. ', loses '
      .. B('X' .. AIJ.fmt(AIJ.val(card, 'liquorice', 'xmult_minus_mod')), colors.MULT)
      .. ' Mult when the hand\'s ' .. B('Mult', colors.MULT) .. ' exceeds its ' .. B('Points', colors.CHIPS)
      .. '\n' .. grey('(Currently ') .. B('X' .. AIJ.fmt(1 + AIJ.val(card, 'liquorice', 'xmult', 0)), colors.MULT)
      .. grey(' Mult)') .. '\nCreates ' .. B('Grace', AIJ.colors.TAROT) .. ' when ' .. B('obtained')
      .. '\n' .. grey('(Must have room)')
  end,
  onAdded = function(joker, state)
    local grace = AIJ.vanilla('c_empress')
    if grace then cardlike.createConsumable(grace) end
  end,
  triggers = {
    finalScoring = function(joker, state, step, result)
      if step.copiedBy then return end
      if (state.currentMult or 0) <= (state.currentChips or 0) then return end
      local minus = AIJ.num(joker, 'xmult_minus_mod')
      if (1 + AIJ.num(joker, 'xmult')) - minus <= 1 then
        result:say('Eaten!')
        result:destroySelf()
      else
        AIJ.add(joker, 'xmult', -minus)
        result:say('-X' .. AIJ.fmt(minus) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

local enhSnap = nil
local MULTICARD = AIJ.vanilla('m_mult') or 'Multicard'
local FUSE_VANILLA = { 'm_bonus', 'm_mult', 'm_wild', 'm_glass', 'm_steel', 'm_stone', 'm_gold', 'm_lucky' }

local function fuseEnhancement(card, newEnh, state)
  if AIJ.get(card, 'aij_mad_fused') then return false end
  local have = {}
  for _, k in ipairs(enhList(card)) do have[k] = true end
  have[newEnh] = true
  local pool = {}
  for _, k in ipairs(FUSE_VANILLA) do
    local id = AIJ.vanilla(k)
    if id and not have[id] then pool[#pool + 1] = id end
  end
  for _, k in ipairs(AIJ.lists.enhancements) do
    if AIJ.has(k, 'enhancement') and not have[k] and not have[AIJ.id(k)] then pool[#pool + 1] = k end
  end
  local pick = AIJ.pick(pool, state)
  if not pick then return false end
  local extra = AIJ.get(card, 'aij_extra_enh')
  local list = {}
  if type(extra) == 'table' then for _, v in ipairs(extra) do list[#list + 1] = v end end
  list[#list + 1] = pick
  AIJ.set(card, 'aij_extra_enh', list)
  AIJ.set(card, 'aij_mad_fused', true)
  card:punch()
  return true
end

local function watchEnhancements(state)
  local sweet = activeJokers('liquorice', state)
  local mad = activeJokers('mad_scientist', state)
  if #sweet == 0 and #mad == 0 then enhSnap = nil return end
  local now = {}
  for _, info in ipairs(cardlike.cardInfos('allCards') or {}) do
    now[info.uid] = info.enhancement or 'Default'
  end
  if enhSnap then
    local gained = 0
    for uid, e in pairs(now) do
      local old = enhSnap[uid]
      if old ~= nil and old ~= e then
        if e == MULTICARD then gained = gained + 1 end
        if #mad > 0 and e ~= 'Default' and fuseEnhancement(cardlike.card(uid), e, state) then
          mad[1]:punch()
        end
      end
    end
    if gained > 0 then
      for _, j in ipairs(sweet) do
        AIJ.add(j, 'xmult', gained * AIJ.num(j, 'xmult_mod'))
        j:popup('Upgrade!', colors.MULT)
      end
    end
  end
  enhSnap = now
end

