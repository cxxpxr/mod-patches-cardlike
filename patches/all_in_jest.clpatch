  vars = function(card) return { AIJ.val(card, 'haughty_joker', 'chips', 1000) } end,
  in_pool = royalFlushPlayed,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if hasRoyal(step.hand) then result:add(plusChips(AIJ.num(joker, 'chips'))) end
    end,
  },
}

AIJ.addJoker {
