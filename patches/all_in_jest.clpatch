    ["c_aij_regulus"] = { name = "Regulus", text = "Align [color=\"#f3a712\"][b]#1#[/b][/color] to [color=\"#f3a712\"][b]Regulus[/b][/color]\n[color=\"#f3a712\"][b]Regulus: [/b][/color][color=\"#1bb18c\"][b]#2# in #3#[/b][/color] chance to [color=\"#f3a712\"][b]level up[/b][/color] [color=\"#f3a712\"][b]played[/b][/color] hand" },
    ["c_aij_regulus_pin"] = { name = "Regulus", text = "[color=\"#1bb18c\"][b]#2# in #3#[/b][/color] chance to [color=\"#f3a712\"][b]level up[/b][/color] [color=\"#f3a712\"][b]played[/b][/color] hand" },
