AIJ.addJoker {
  key = 'the_jester',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 17, y = 9 },
  config = { active = true },
  vars = function(card) return { activeText(AIJ.val(card, 'the_jester', 'active') ~= false) } end,
  triggers = {
    onCardSold = function(joker, state, step, result)
      local sold = step.card
      if not sold or (sold.lastInfo or {}).kind ~= 'joker' then return end
      local active = AIJ.get(joker, 'active', true) ~= false
      if not active and AIJ.get(joker, 'last_sale') ~= sold.uid then return end
      if not step.copiedBy then
        AIJ.set(joker, 'active', false)
        AIJ.set(joker, 'last_sale', sold.uid)
      end
      local prism = AIJ.vanilla('c_fool')
      if prism and (state.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(prism) end
      result:say('Prism', colors.PURPLE)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'active', true)
      joker:getDataStore():delete('last_sale')
    end,
  },
}

local jolly = {}

AIJ.addJoker {
  key = 'the_jolly',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 3, y = 16 },
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if not contains(state, step, 'STRAIGHT_FLUSH') then return end
      local s, f = state:getHand('STRAIGHT'), state:getHand('FLUSH')
      local levels = (s and s.level or 1) + (f and f.level or 1)
      local ht = step.hand.handType
      state:upgradeHand(ht, levels)
      jolly[#jolly + 1] = { handType = ht, levels = levels }
      result:say('+' .. AIJ.fmt(levels) .. ' Levels', colors.ORANGE)
    end,
  },
}

local function jollyUndo(state)
  if #jolly == 0 or not state then return end
  local list = jolly
  jolly = {}
  for _, j in ipairs(list) do state:upgradeHand(j.handType, -j.levels) end
end
cardlike.on('afterHand', function(state) jollyUndo(state) end)
cardlike.on('onHandDrawn', function(state) jollyUndo(state) end)

