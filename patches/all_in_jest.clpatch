    ["j_aij_design_document"] = { name = "Design Document", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when any [color=\"#1bb18c\"][b]probability[/b][/color] fails" },
    ["j_aij_devil_deal"] = { name = "Devil Deal", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a [color=\"#c23447\"][b]Heart[/b][/color] is [color=\"#f3a712\"][b]destroyed[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_diamantaire"] = { name = "Diamantaire", text = "If hand is a single [color=\"#204887\"][b]Diamond[/b][/color], make it a [color=\"#f3a712\"][b]Gilded card[/b][/color] and earn [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_diced_joker"] = { name = "Diced Joker", text = "" },
    ["j_aij_dicky"] = { name = "Dicky", text = "At end of round, all cards that were [color=\"#f3a712\"][b]not[/b][/color] drawn that round [color=\"#f3a712\"][b]permanently[/b][/color] gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_dim_bulb"] = { name = "Dim Bulb", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if you have no [color=\"#1bb18c\"][b]Uncommon[/b][/color] or [color=\"#ff007f\"][b]Rare[/b][/color] [color=\"#f3a712\"][b]Jokers[/b][/color]" },
    ["j_aij_dim_bulb_alt"] = { name = "Dim Bulb", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if you have no other [color=\"#1bb18c\"][b]Uncommon[/b][/color] or [color=\"#ff007f\"][b]Rare[/b][/color] [color=\"#f3a712\"][b]Jokers[/b][/color]" },
    ["j_aij_diogenes"] = { name = "Diogenes", text = "" },
    ["j_aij_dire_warning"] = { name = "Dire Warning", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if [color=\"#f3a712\"][b]previous round[/b][/color] was won with [color=\"#f3a712\"][b]0[/b][/color] hands remaining\n[color=\"#9a9a9a\"](#2#)[/color]" },
    ["j_aij_dirty_deed"] = { name = "Dirty Deed", text = "" },
    ["j_aij_disco_joker"] = { name = "Disco Joker", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all cards with [color=\"#f3a712\"][b]Editions[/b][/color]" },
    ["j_aij_diver"] = { name = "Diver", text = "[color=\"#f3a712\"][b]Packs[/b][/color] contain [color=\"#f3a712\"][b]#1#[/b][/color] additional options to choose from" },
    ["j_aij_divine_comedy"] = { name = "Divine Comedy", text = "" },
    ["j_aij_dizzard"] = { name = "Dizzard", text = "After [color=\"#f3a712\"][b]Blind[/b][/color] is skipped, visit the [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_dizzy_lizzy"] = { name = "Dizzy Lizzy", text = "" },
    ["j_aij_doctors_note"] = { name = "Doctor's Note", text = "All [color=\"#f3a712\"][b]numbered[/b][/color] [color=\"#c23447\"][b]Hearts[/b][/color] are considered the [color=\"#f3a712\"][b]same rank[/b][/color]\n[color=\"#9a9a9a\"](Except for making poker hands)[/color]" },
    ["j_aij_doctors_orders"] = { name = "Doctor's Orders", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]9[/b][/color] in the played hand, [color=\"#ff007f\"][b]self-destructs[/b][/color] if no [color=\"#f3a712\"][b]9s[/b][/color] were played" },
    ["j_aij_dog_treat"] = { name = "Dog Treat", text = "If Blind is won in [color=\"#f3a712\"][b]one[/b][/color] hand, earn [color=\"#f3a712\"][b]$#1#[/b][/color] and [color=\"#ff007f\"][b]self destruct[/b][/color]" },
    ["j_aij_doink"] = { name = "Doink", text = "" },
    ["j_aij_dolly"] = { name = "Dolly", text = "" },
    ["j_aij_dongfang"] = { name = "Dongfang", text = "Retrigger all [color=\"#13afce\"][b]Fruit[/b][/color] cards [color=\"#f3a712\"][b]#1#[/b][/color] times" },
    ["j_aij_dongtong"] = { name = "Dongtong", text = "Increases most [color=\"#f3a712\"][b]Joker[/b][/color] values by [color=\"#1bb18c\"][b]100%[/b][/color]\nDoubles [color=\"#f3a712\"][b]Blind[/b][/color] [color=\"#f3a712\"][b]Requirements[/b][/color]" },
    ["j_aij_dont_be_a_joker"] = { name = "Don't be a Joker!", text = "When a [color=\"#f3a712\"][b]Joker[/b][/color] is [color=\"#ff007f\"][b]destroyed[/b][/color] or [color=\"#f3a712\"][b]sold[/b][/color], this gains its [color=\"#f3a712\"][b]sell[/b][/color] [color=\"#f3a712\"][b]value[/b][/color]" },
    ["j_aij_doodle"] = { name = "Doodle", text = "At start of each [color=\"#f3a712\"][b]round[/b][/color], [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to copy [color=\"#f3a712\"][b]both adjacent[/b][/color] Jokers for the rest of the [color=\"#f3a712\"][b]round[/b][/color] [color=\"#9a9a9a\"]#3#[/color]" },
    ["j_aij_doormat"] = { name = "Doormat", text = "Gives a [color=\"#f3a712\"][b]random[/b][/color] [color=\"#f3a712\"][b]enhancement[/b][/color] to the first drawn card each [color=\"#f3a712\"][b]round[/b][/color]" },
    ["j_aij_dor"] = { name = "D'or", text = "[color=\"#5d5dff\"][b]#1#[/b][/color] Mult on [color=\"#f3a712\"][b]final[/b][/color] hand of [color=\"#f3a712\"][b]round[/b][/color]" },
    ["j_aij_dot_matrix"] = { name = "Dot Matrix", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]unique[/b][/color] rank [color=\"#f3a712\"][b]remaining[/b][/color] in deck\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_double_sundae_1"] = { name = "Double Sundae", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points, [color=\"#ff007f\"][b]+#2#[/b][/color] Mult\n[color=\"#f3a712\"][b]Partly[/b][/color] consumed after [color=\"#f3a712\"][b]#3#[/b][/color] Rounds" },
    ["j_aij_double_sundae_2"] = { name = "Double Sundae", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points, Earn [color=\"#f3a712\"][b]$#2#[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#f3a712\"][b]Partly[/b][/color] consumed after [color=\"#f3a712\"][b]#3#[/b][/color] Rounds" },
    ["j_aij_double_sundae_3"] = { name = "Double Sundae", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult, Earn [color=\"#f3a712\"][b]$#2#[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#f3a712\"][b]Partly[/b][/color] consumed after [color=\"#f3a712\"][b]#3#[/b][/color] Rounds" },
    ["j_aij_downing_street"] = { name = "Downing Street", text = "Scoring [color=\"#f3a712\"][b]10s[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#f3a712\"][b]Pin[/b][/color]" },
    ["j_aij_dragon"] = { name = "Dragon", text = "" },
    ["j_aij_draupnir"] = { name = "Draupnir", text = "" },
    ["j_aij_drying_paint"] = { name = "Drying Paint", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] During a [color=\"#f3a712\"][b]Blind[/b][/color], spend [color=\"#f3a712\"][b]#3#[/b][/color] [color=\"#3772ff\"][b]Hand[/b][/color] to give this Joker [color=\"#ff007f\"][b]X#1#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_duende"] = { name = "Duende", text = "Earn [color=\"#f3a712\"][b]$#2#[/b][/color] at end of round for each [color=\"#f3a712\"][b]empty[/b][/color] Joker slot Duende included\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_durak"] = { name = "Durak", text = "" },
    ["j_aij_durie"] = { name = "Durie", text = "" },
    ["j_aij_dwarf"] = { name = "Dwarf", text = "[color=\"#f3a712\"][b]2s[/b][/color], [color=\"#f3a712\"][b]3s[/b][/color], [color=\"#f3a712\"][b]4s[/b][/color], and [color=\"#f3a712\"][b]5s[/b][/color] give [color=\"#ff007f\"][b]Mult[/b][/color] equal to [color=\"#f3a712\"][b]#1#[/b][/color] minus their [color=\"#f3a712\"][b]rank[/b][/color] when scored" },
    ["j_aij_dynamic_duo"] = { name = "Dynamic Duo", text = "" },
    ["j_aij_earl"] = { name = "Earl", text = "[color=\"#f3a712\"][b]Kings[/b][/color] held in hand earn [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_egg_cc"] = { name = "\"egg\"", text = "This Joker gains [color=\"#3772ff\"][b]+#2#[/b][/color] Points and [color=\"#f3a712\"][b]$#3#[/b][/color] of [color=\"#f3a712\"][b]sell value[/b][/color] at end of round\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points)[/color] [color=\"#9a9a9a\"]hey it's \"egg\"[/color]" },
    ["j_aij_elder"] = { name = "Elder", text = "Copies the effect of the other [color=\"#f3a712\"][b]Joker[/b][/color] you have owned the [color=\"#f3a712\"][b]longest[/b][/color]\n[color=\"#9a9a9a\"](Currently #1#)[/color]" },
    ["j_aij_electric_snow"] = { name = "Electric Snow", text = "Round only ends [color=\"#f3a712\"][b]after[/b][/color] the [color=\"#f3a712\"][b]final hand[/b][/color] of round" },
    ["j_aij_elf"] = { name = "Elf", text = "After skipping [color=\"#f3a712\"][b]#2#[/b][/color] Blinds, [color=\"#f3a712\"][b]sell[/b][/color] this Joker to create [color=\"#f3a712\"][b]#3# Investment Pins[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"]/#2#)[/color]" },
    ["j_aij_embroidery"] = { name = "Embroidery", text = "[color=\"#f3a712\"][b]Canvas Cards[/b][/color] give [color=\"#ff007f\"][b]+#2#[/b][/color] Mult if they are [color=\"#f3a712\"][b]ranked[/b][/color]\n[color=\"#f3a712\"][b]Canvas Cards[/b][/color] give [color=\"#3772ff\"][b]+#1#[/b][/color] Points if they do [color=\"#ff007f\"][b]not[/b][/color] have a [color=\"#f3a712\"][b]rank[/b][/color]" },
    ["j_aij_emergent_pattern"] = { name = "Emergent Pattern", text = "Retrigger scored cards if [color=\"#f3a712\"][b]played[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] contains exactly [color=\"#f3a712\"][b]#1#[/b][/color] cards" },
    ["j_aij_emo_joker"] = { name = "Emo Joker", text = "" },
    ["j_aij_emoticon"] = { name = "Emoticon", text = "" },
    ["j_aij_emptyhead"] = { name = "Empty-head", text = "" },
    ["j_aij_enraging_photo"] = { name = "Enraging Photo", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if any [color=\"#f3a712\"][b]Joker[/b][/color], [color=\"#f3a712\"][b]consumable[/b][/color], or [color=\"#f3a712\"][b]playing card[/b][/color] has been [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color] this round [color=\"#9a9a9a\"]#2#[/color]" },
    ["j_aij_entropy"] = { name = "Entropy", text = "Create [color=\"#f3a712\"][b]#1# [/b][/color][color=\"#ff007f\"][b]Chaos [/b][/color][color=\"#f3a712\"][b]Pins[/b][/color] when Blind is [color=\"#f3a712\"][b]skipped[/b][/color]" },
    ["j_aij_error_404"] = { name = "Error 404", text = "[color=\"#f3a712\"][b]Copies[/b][/color] the ability of a random held [color=\"#f3a712\"][b]Joker,[/b][/color] [color=\"#f3a712\"][b]Changes[/b][/color] every hand\n[color=\"#9a9a9a\"](Currently: [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_esther"] = { name = "Esther", text = "" },
    ["j_aij_eulenspiegel"] = { name = "Eulenspiegel", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated,\n[color=\"#f3a712\"][b]-#1#[/b][/color] Ante and this Joker loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\n[color=\"#ff007f\"][b]Debuffs self[/b][/color] at [color=\"#ff007f\"][b]X0[/b][/color] Mult" },
    ["j_aij_event_horizon"] = { name = "Event Horizon", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a hand is [color=\"#f3a712\"][b]leveled up[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\n[color=\"#f3a712\"][b]Resets[/b][/color] when the same hand is [color=\"#f3a712\"][b]leveled up[/b][/color] twice in a row\n[color=\"#9a9a9a\"](Last leveled hand: [/color][color=\"#f3a712\"][b]#3##[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_evergreen"] = { name = "Evergreen", text = "" },
    ["j_aij_evil_eye"] = { name = "Evil Eye", text = "" },
    ["j_aij_evil_joker"] = { name = "Evil Joker", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult, destroys a [color=\"#f3a712\"][b]random[/b][/color] Joker when [color=\"#f3a712\"][b]obtained[/b][/color]" },
    ["j_aij_evil_twin"] = { name = "Evil Twin", text = "" },
    ["j_aij_executioner"] = { name = "Executioner", text = "This Joker gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points when a [color=\"#f3a712\"][b]face[/b][/color] card is [color=\"#f3a712\"][b]destroyed[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_expressive_joker"] = { name = "Expressive Joker", text = "" },
    ["j_aij_eye_test"] = { name = "Eye Test", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]consecutive[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] containing [color=\"#f3a712\"][b]more[/b][/color] cards than the [color=\"#f3a712\"][b]previous[/b][/color] hand\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_fabulist"] = { name = "Fabulist", text = "" },
    ["j_aij_fall_of_count_chaligny"] = { name = "Fall of Count Chaligny", text = "Set the [color=\"#f3a712\"][b]required[/b][/color] score of all [color=\"#f3a712\"][b]Blinds[/b][/color] to [color=\"#f3a712\"][b]1X[/b][/color] Base" },
    ["j_aij_family_tree"] = { name = "Family Tree", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is [color=\"#ff007f\"][b]defeated[/b][/color], create the [color=\"#f3a712\"][b]Pin[/b][/color] associated with the [color=\"#f3a712\"][b]rarity[/b][/color] of [color=\"#f3a712\"][b]Joker[/b][/color] to the [color=\"#f3a712\"][b]right[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#V1#\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_famulus"] = { name = "Famulus", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when a [color=\"#d138bf\"][b]Game Card[/b][/color] is used" },
    ["j_aij_fantasio"] = { name = "Fantasio", text = "All cards count as [color=\"#f3a712\"][b]every suit[/b][/color]" },
    ["j_aij_farceur"] = { name = "Farceur", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to grant this Joker [color=\"#ff007f\"][b]X#3#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_fat_ed"] = { name = "Fat 'Ed", text = "" },
    ["j_aij_father_and_son"] = { name = "Father and Son", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult if [color=\"#f3a712\"][b]scored hand[/b][/color] contains exactly [color=\"#f3a712\"][b]one King[/b][/color] and [color=\"#f3a712\"][b]one Jack[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_father_christmas"] = { name = "Father Christmas", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when any card is [color=\"#f3a712\"][b]scored[/b][/color]" },
    ["j_aij_fatuus"] = { name = "Fatuus", text = "If first hand of round contains only [color=\"#f3a712\"][b]Kings[/b][/color] and [color=\"#f3a712\"][b]Queens[/b][/color], apply a [color=\"#3772ff\"][b]Fruit Stamp[/b][/color] to a random played card" },
    ["j_aij_feather_in_your_cap"] = { name = "Feather in Your Cap", text = "" },
    ["j_aij_feedback_form"] = { name = "Feedback Form", text = "All [color=\"#f3a712\"][b]unique[/b][/color] enhancements in the [color=\"#f3a712\"][b]played hand[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when scored" },
    ["j_aij_firework"] = { name = "Firework", text = "First played [color=\"#f3a712\"][b]Multicard[/b][/color] gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when scored" },
    ["j_aij_first_draft"] = { name = "First Draft", text = "Copies ability of [color=\"#f3a712\"][b]Joker[/b][/color] to the [color=\"#f3a712\"][b]left[/b][/color]" },
    ["j_aij_fish_fingers"] = { name = "Fish Fingers", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Hands per round, loses [color=\"#3772ff\"][b]-#2#[/b][/color] Hand when Blind is [color=\"#f3a712\"][b]defeated[/b][/color]" },
    ["j_aij_flatwoods"] = { name = "Flatwoods", text = "" },
    ["j_aij_fleeman"] = { name = "Fleeman", text = "" },
    ["j_aij_fleshgait"] = { name = "Fleshgait", text = "[color=\"#f3a712\"][b]Scoring[/b][/color] cards with [color=\"#ff007f\"][b]no[/b][/color] [color=\"#f3a712\"][b]suit patch[/b][/color] get a random [color=\"#f3a712\"][b]suit patch[/b][/color]" },
    ["j_aij_flibbertigibbit"] = { name = "Flibbertigibbit", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] per [color=\"#f3a712\"][b]unique suit[/b][/color] in [color=\"#f3a712\"][b]discarded[/b][/color] poker hand" },
    ["j_aij_flushed_face"] = { name = "Flushed Face", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per scored [color=\"#f3a712\"][b]face card[/b][/color] in a [color=\"#f3a712\"][b]Flush[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_fly_agaric"] = { name = "Fly Agaric", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all [color=\"#V1#\"][b]Activated[/b][/color] [color=\"#V1#\"][b]Abilities[/b][/color]" },
    ["j_aij_flying_ace"] = { name = "Flying Ace", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] at end of round per [color=\"#f3a712\"][b]Ace[/b][/color] of unique [color=\"#f3a712\"][b]suit[/b][/color] scored this round\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#f3a712\"][b]$#2#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_foliate_head"] = { name = "Foliate Head", text = "" },
    ["j_aij_force_the_hand_of_fate"] = { name = "Force the Hand of Fate", text = "" },
    ["j_aij_fortunato"] = { name = "Fortunato", text = "Turn all [color=\"#f3a712\"][b]played[/b][/color] but [color=\"#f3a712\"][b]unscored[/b][/color] cards into [color=\"#f3a712\"][b]Rock cards[/b][/color]\nThis [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a [color=\"#f3a712\"][b]Rock card[/b][/color] is scored\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_fortune_cookie"] = { name = "Fortune Cookie", text = "Create a random [color=\"#d138bf\"][b]Game[/b][/color] card when any [color=\"#f3a712\"][b]Booster[/b][/color] [color=\"#f3a712\"][b]Pack[/b][/color] is opened, consumed after [color=\"#f3a712\"][b]#1#[/b][/color] packs\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_fou_du_roi"] = { name = "Fou du Roi", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a [color=\"#d138bf\"][b]Game[/b][/color] card if played hand contains a [color=\"#f3a712\"][b]King[/b][/color] or [color=\"#f3a712\"][b]Queen[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_founding_father"] = { name = "Founding Father", text = "[color=\"#f3a712\"][b]Charged Cards[/b][/color] are [color=\"#f3a712\"][b]twice[/b][/color] as effective" },
    ["j_aij_four_leaf_clover"] = { name = "Four-leaf Clover", text = "[color=\"#f3a712\"][b]#1#%[/b][/color] chance to increase the [color=\"#f3a712\"][b]rarity[/b][/color] of Jokers in the [color=\"#f3a712\"][b]Shop[/b][/color] Percentage is equal to the number of [color=\"#f3a712\"][b]4s[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]" },
    ["j_aij_foureyes"] = { name = "Four-Eyes", text = "" },
    ["j_aij_friendly_face"] = { name = "Friendly Face", text = "" },
    ["j_aij_from_the_top_rope"] = { name = "From the Top Rope", text = "" },
    ["j_aij_fruity_joker"] = { name = "Fruity Joker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult when a [color=\"#f3a712\"][b]Chroma[/b][/color] edition triggers" },
    ["j_aij_ftus"] = { name = "Fœtus", text = "" },
    ["j_aij_fulehung"] = { name = "Fulehung", text = "When [color=\"#f3a712\"][b]Blind[/b][/color] is selected, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to gain its [color=\"#f3a712\"][b]Skip Pin[/b][/color]" },
    ["j_aij_full_monty"] = { name = "Full Monty", text = "" },
    ["j_aij_fun_guy"] = { name = "Fun Guy", text = "" },
    ["j_aij_fun_is_infinite"] = { name = "Fun is Infinite", text = "" },
    ["j_aij_funny_bone"] = { name = "Funny Bone", text = "When any Joker is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color], create a random [color=\"#d138bf\"][b]Game Card[/b][/color]" },
    ["j_aij_funny_bunch"] = { name = "Funny Bunch", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#009dff\"][b]Common[/b][/color] Joker\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_funny_money"] = { name = "Funny Money", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when [color=\"#f3a712\"][b]skipping[/b][/color] a Blind" },
    ["j_aij_funny_phone"] = { name = "Funny Phone", text = "This Joker gains [color=\"#3772ff\"][b]+#3#-#2#[/b][/color] Points when [color=\"#1bb18c\"][b]rerolling[/b][/color] in the [color=\"#f3a712\"][b]Shop[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_furbo_e_stupido"] = { name = "Furbo e Stupido", text = "[color=\"#f3a712\"][b]Dyscalcular[/b][/color] cards also count as [color=\"#f3a712\"][b]Aces and [/b][/color][color=\"#f3a712\"][b]Jacks[/b][/color]" },
    ["j_aij_fuzzy_joker"] = { name = "Fuzzy Joker", text = "Rounds [color=\"#ff007f\"][b]Mult[/b][/color] up to the next power of [color=\"#f3a712\"][b]#1#[/b][/color]" },
    ["j_aij_galet"] = { name = "Galet", text = "" },
    ["j_aij_game_bro"] = { name = "Game Bro", text = "Gives [color=\"#ff007f\"][b]Mult[/b][/color] equal to [color=\"#f3a712\"][b]double[/b][/color] the current [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_game_cartridge"] = { name = "Game Cartridge", text = "" },
    ["j_aij_gameshow"] = { name = "Gameshow", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to add [color=\"#5d5dff\"][b]Luna[/b][/color], [color=\"#5d5dff\"][b]Holo[/b][/color], or [color=\"#5d5dff\"][b]Chroma[/b][/color] edition to a random [color=\"#f3a712\"][b]Joker[/b][/color] when [color=\"#f3a712\"][b]blind[/b][/color] is selected\n[color=\"#f3a712\"][b]-$#3#[/b][/color] when triggered regardless of outcome" },
    ["j_aij_gargoyle"] = { name = "Gargoyle", text = "" },
    ["j_aij_gelato"] = { name = "Gelato", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color], [color=\"#ff007f\"][b]self-destructs[/b][/color] if Blind is not beaten in a [color=\"#f3a712\"][b]single hand[/b][/color]" },
    ["j_aij_gematria"] = { name = "Gematria", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]played hand[/b][/color] is mentioned by any of your [color=\"#f3a712\"][b]Jokers[/b][/color]" },
    ["j_aij_generic"] = { name = "Gen-Eric", text = "[color=\"#9a9a9a\"]\"The rest was blanked out[/color] [color=\"#9a9a9a\"]for the sake of game balance\"[/color]" },
    ["j_aij_generic_credits_joker"] = { name = "Gen-Eric", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_geoglyph"] = { name = "Geoglyph", text = "Scoring cards give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each card of the same suit [color=\"#f3a712\"][b]held in hand[/b][/color]" },
    ["j_aij_gfsgfsgdsgf_credits_joker"] = { name = "gfsgfsgdsgf", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_ghosthunter"] = { name = "Ghosthunter", text = "[color=\"#4584fa\"][b]Admin card[/b][/color] #1# #2# [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_ghoti_credits_joker"] = { name = "Ghoti", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_gille"] = { name = "Gille", text = "May [color=\"#f3a712\"][b]reroll[/b][/color] available [color=\"#f3a712\"][b]Pins[/b][/color]" },
    ["j_aij_giocoliere"] = { name = "Giocoliere", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] hand size during each [color=\"#f3a712\"][b]Boss Blind[/b][/color]" },
    ["j_aij_glacier"] = { name = "Glacier", text = "" },
    ["j_aij_glam_joker"] = { name = "Glam Joker", text = "" },
    ["j_aij_glasgow_smile"] = { name = "Glasgow Smile", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points when a [color=\"#f3a712\"][b]Bonus[/b][/color] [color=\"#f3a712\"][b]Card[/b][/color] is scored\nIf the [color=\"#f3a712\"][b]first[/b][/color] hand of round is a single [color=\"#f3a712\"][b]Chipped card[/b][/color], [color=\"#ff007f\"][b]destroy[/b][/color] it and increase this amount by [color=\"#3772ff\"][b]+#2#[/b][/color] Points" },
    ["j_aij_glass_delusion"] = { name = "Glass Delusion", text = "When a [color=\"#f3a712\"][b]Fragile card[/b][/color] breaks, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to instead add [color=\"#f3a712\"][b]two copies[/b][/color] of it to your deck" },
    ["j_aij_glassblower"] = { name = "Glassblower", text = "" },
    ["j_aij_glizzy"] = { name = "Glizzy", text = "" },
    ["j_aij_gloaming"] = { name = "Gloaming", text = "Scoring cards give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult on [color=\"#f3a712\"][b]final[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] of round" },
    ["j_aij_glovely_joker"] = { name = "Glovely Joker", text = "" },
