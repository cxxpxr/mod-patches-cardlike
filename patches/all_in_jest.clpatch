    ["j_aij_sleepy_joker"] = { name = "Sleepy Joker", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if played hand contains only [color=\"#e5e5e5\"][b]Spades[/b][/color] and [color=\"#388f58\"][b]Clubs[/b][/color]" },
    ["j_aij_slim_joker"] = { name = "Slim Joker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult\n[color=\"#ff007f\"][b]-#2#[/b][/color] Mult per card in played hand" },
    ["j_aij_slippery_when_wet"] = { name = "Slippery When Wet", text = "Scoring cards give [color=\"#3772ff\"][b]Points[/b][/color] equal to the combined [color=\"#f3a712\"][b]rank[/b][/color] of [color=\"#f3a712\"][b]adjacent[/b][/color] cards" },
    ["j_aij_slubberdegullion"] = { name = "Slubberdegullion", text = "[color=\"#ff007f\"][b]+#1# Discard[/b][/color] this round if [color=\"#f3a712\"][b]played hand[/b][/color] contains at least [color=\"#f3a712\"][b]3[/b][/color] unscoring cards" },
    ["j_aij_smide"] = { name = "Smide", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points per [color=\"#f3a712\"][b]face[/b][/color] card in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_sneaky_pete"] = { name = "Sneaky Pete", text = "Earn [color=\"#f3a712\"][b]$#2#[/b][/color] at end of round for every [color=\"#f3a712\"][b]Cash Stamp[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]$#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_snow_cone"] = { name = "Snow Cone", text = "" },
    ["j_aij_so_retro"] = { name = "So Retro", text = "" },
    ["j_aij_soft_serve"] = { name = "Soft Serve", text = "Modded [color=\"#f3a712\"][b]Jokers[/b][/color], [color=\"#d138bf\"][b]Game cards[/b][/color], and [color=\"#13afce\"][b]Fruit cards[/b][/color] will not appear in the [color=\"#f3a712\"][b]Shop[/b][/color], consumed after [color=\"#f3a712\"][b]#1#[/b][/color] purchases" },
    ["j_aij_sommers"] = { name = "Sommers", text = "[color=\"#f3a712\"][b]Levels up[/b][/color] all played hands" },
    ["j_aij_soothsayer"] = { name = "Soothsayer", text = "" },
    ["j_aij_sophe_credits_joker"] = { name = "Sophe", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_sorbet"] = { name = "Sorbet", text = "" },
    ["j_aij_sot"] = { name = "Sot", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]Pin[/b][/color] held\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nPins will [color=\"#f3a712\"][b]not[/b][/color] trigger while this Joker is held" },
    ["j_aij_soviet"] = { name = "Soviet", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]played hand[/b][/color] contains no [color=\"#f3a712\"][b]Kings[/b][/color] or [color=\"#f3a712\"][b]Queens[/b][/color]" },
    ["j_aij_sparky"] = { name = "Sparky", text = "[color=\"#f3a712\"][b]Charged Cards[/b][/color] held in hand also affect cards in [color=\"#f3a712\"][b]played hand[/b][/color]\n[color=\"#f3a712\"][b]Charged Cards[/b][/color] in played hand also affect cards [color=\"#f3a712\"][b]held in hand[/b][/color]" },
    ["j_aij_spectre"] = { name = "Spectre", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated, replace all held [color=\"#f3a712\"][b]consumables[/b][/color] with random [color=\"#4584fa\"][b]Admin[/b][/color] cards" },
    ["j_aij_spider"] = { name = "Spider", text = "" },
    ["j_aij_spiders_georg"] = { name = "Spiders Georg", text = "Multiply [color=\"#ff007f\"][b]Mult[/b][/color] by [color=\"#ff007f\"][b]X#2#[/b][/color] plus the [color=\"#f3a712\"][b]average[/b][/color] number of [color=\"#f3a712\"][b]8s[/b][/color] [color=\"#f3a712\"][b]scored[/b][/color] per hand this run\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_spiral_gestalt"] = { name = "Spiral Gestalt", text = "On Death, or when this joker is [color=\"#f3a712\"][b]sold[/b][/color], [color=\"#ff007f\"][b]reset[/b][/color] to the beginning of the ante [color=\"#ff007f\"][b]self destructs[/b][/color]" },
    ["j_aij_spirit_mask"] = { name = "Spirit Mask", text = "" },
    ["j_aij_splat"] = { name = "Splat!", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance for each [color=\"#f3a712\"][b]scoring[/b][/color] card to gain a [color=\"#f3a712\"][b]Melted[/b][/color] [color=\"#f3a712\"][b]Stamp[/b][/color]" },
    ["j_aij_spoofy"] = { name = "Spoofy", text = "[color=\"#9a9a9a\"]\"You should play Braptro\"[/color]" },
    ["j_aij_spoofy_credits_joker"] = { name = "Spoofy", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
