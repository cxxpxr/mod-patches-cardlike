AIJ.addJoker {
  key = 'funny_phone',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 8, y = 10 },
  config = { chips = 0, chip_gain = 0, max = 10, min = 1 },
  vars = function(card)
    return { AIJ.val(card, 'funny_phone', 'chips'), AIJ.val(card, 'funny_phone', 'max'), AIJ.val(card, 'funny_phone', 'min') }
  end,
  triggers = {
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      local gain = state:random(AIJ.num(joker, 'min'), AIJ.num(joker, 'max'))
      AIJ.set(joker, 'chip_gain', gain)
      AIJ.add(joker, 'chips', gain)
      result:say('+' .. AIJ.fmt(gain) .. ' Points', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.addJoker {
  key = 'fuzzy_joker',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 6, y = 10 },
  config = { power = 2 },
  vars = function(card) return { AIJ.val(card, 'fuzzy_joker', 'power') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local mult = tonumber(state.currentMult) or 0
      local base = AIJ.num(joker, 'power')
      if mult <= 0 or base <= 1 or mult >= 1e300 then return end
      local target = 1
      if mult < 1 then
        while target / base > mult do target = target / base end
      end
      while target <= mult do target = target * base end
      if target > mult then
        result:add(plusMult(target - mult))
        result:say('=' .. AIJ.fmt(target) .. ' Mult', colors.MULT)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'game_bro',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 7, y = 22 },
  config = {},
  vars = function() return { ((cardlike.state and cardlike.state.round) or 0) * 2 } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = (state.round or 0) * 2
      if m ~= 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
  key = 'gameshow',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 3, y = 12 },
  config = { odds = 4, money = 3 },
  vars = function(card) return { odds(1), AIJ.val(card, 'gameshow', 'odds'), AIJ.val(card, 'gameshow', 'money') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      local plain = {}
      for _, j in ipairs(ofList(state, 'jokers')) do
        if not AIJ.edition(j) then plain[#plain + 1] = j end
      end
      if #plain == 0 then return end
      state:mutateMoney(-AIJ.num(joker, 'money'))
      if state:chance(1 / AIJ.num(joker, 'odds')) then
        local target = AIJ.pick(plain, state)
        target:setEdition(rollEdition(state, false))
        target:punch()
        result:say('-$' .. AIJ.fmt(AIJ.num(joker, 'money')), colors.MONEY)
      else
        result:say('Nope!', AIJ.colors.TAROT)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'gelato',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 0, y = 40 },
  pools = { Food = true },
  config = { dollars = 10 },
  vars = function(card) return { AIJ.val(card, 'gelato', 'dollars') } end,
  dollarsAtRoundEnd = function(joker, state) return AIJ.num(joker, 'dollars') end,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      if (state.handsPlayed or 0) > 1 then
        result:say('Melted!', colors.RED)
        result:destroySelf()
      end
    end,
  },
}

local function jokerText(j)
  local id = AIJ.defId(j)
  local short = AIJ.short(id)
  local t = ''
  if type(short) == 'string' and AIJ.has(short, 'joker') then
    local e = AIJ.loc('Joker', 'j_aij_' .. short)
    t = e and e.text or ''
  end
  t = t .. ' ' .. tostring((j.lastInfo and j.lastInfo.name) or '')
  return (t:gsub('%[[^%]]*%]', ''))
end

AIJ.addJoker {
  key = 'gematria',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 21, y = 11 },
  config = { mult_mod = 10 },
  description = function(r)
    local m = AIJ.val(r and r.card, 'gematria', 'mult_mod')
    return colorize(bold('+' .. AIJ.fmt(m)), colors.MULT) .. ' Mult if the played hand is named by any other '
      .. colorize(bold('Joker'), colors.ORANGE) .. ' (in its name, or in the text of an All in Jest Joker)'
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local name = AIJ.handName(step.hand.handType)
      local id = tostring(step.hand.handType)
      local self = step.copiedBy or joker
      for _, j in ipairs(ofList(state, 'jokers')) do
        if j.uid ~= self.uid then
          local t = jokerText(j)
          if t:find(name, 1, true) or t:find(id, 1, true) then
            result:add(plusMult(AIJ.num(joker, 'mult_mod')))
            return
          end
        end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'geoglyph',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 7, y = 20 },
  config = { mult = 1 },
  vars = function(card) return { AIJ.val(card, 'geoglyph', 'mult') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      local suit = step.card.lastInfo and step.card.lastInfo.suit
      if not suit or AIJ.noRank(step.card) then return end
      local n = 0
      for _, c in ipairs(ofList(state, 'cardsInHand')) do
        if c:isSuit(suit) then n = n + 1 end
      end
      if n > 0 then result:add(plusMult(n * AIJ.num(joker, 'mult'))) end
    end,
  },
}

local GHOSTHUNTER = AIJ.addJoker {
  key = 'ghosthunter',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 17, y = 25 },
  blueprint_compat = false,
  config = {},
  vars = function(card)
    local state = cardlike.state
    local others = 0
    for _, j in ipairs(state and ofList(state, 'jokers') or {}) do
      if AIJ.is(j, 'ghosthunter') and (not card or j.uid ~= card.uid) then others = others + 1 end
    end
    if others > 0 then
      return { AIJ.msg('k_aij_ghosthunter_ghost_1', 'cards appear'),
        AIJ.msg('k_aij_ghosthunter_ghost_2', 'more often') .. ' ' .. AIJ.msg('k_aij_ghosthunter_ghostless_2', 'in the') }
    end
    return { AIJ.msg('k_aij_ghosthunter_ghostless_1', 'cards can appear'), AIJ.msg('k_aij_ghosthunter_ghostless_2', 'in the') }
  end,
}
if GHOSTHUNTER then
  local function ghostShop(state)
    local n = #owned(state, GHOSTHUNTER)
    if n == 0 then return end
    local p = (2 * n) / (26 + 2 * n)
    for _ = 1, (state.cardsAvailableInShopCount or 2) do
      if state:randomFloat() < p then
        local id = cardlike.randomConsumable('admin')
        if id then cardlike.addShopItem(id) end
      end
    end
  end
  cardlike.on('onShopEnter', function(state) ghostShop(state) end)
  cardlike.on('onShopReroll', function(state) ghostShop(state) end)
end

AIJ.addJoker {
  key = 'giocoliere',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 16, y = 5 },
  blueprint_compat = false,
  config = { hand_size = 3 },
  vars = function(card) return { AIJ.val(card, 'giocoliere', 'hand_size') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy or not isBoss(state, step.blind) then return end
      local n = AIJ.num(joker, 'hand_size')
      state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + n
      result:say('+' .. AIJ.fmt(n) .. ' Hand Size', colors.ORANGE)
    end,
  },
}

local function isChipped(c) return AIJ.hasEnhancement(c, 'm_bonus') end

AIJ.addJoker {
  key = 'glasgow_smile',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 20, y = 23 },
  config = { chips = 0, gain = 30 },
  vars = function(card) return { AIJ.val(card, 'glasgow_smile', 'chips'), AIJ.val(card, 'glasgow_smile', 'gain') } end,
  in_pool = function(state) return deckHas(state, isChipped) end,
  triggers = {
    onScore = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 and isChipped(step.card) then result:add(plusChips(c)) end
    end,
    destroyCard = function(joker, state, step, result)
      if step.copiedBy or state.handsPlayed ~= 1 then return end
      if #(step.hand.allCards or {}) ~= 1 or not isChipped(step.card) then return end
      AIJ.add(joker, 'chips', AIJ.num(joker, 'gain'))
      result:say('Upgrade!', colors.CHIPS)
      return true
    end,
  },
}

local function isFragile(c) return AIJ.hasEnhancement(c, 'm_glass') end

AIJ.addJoker {
  key = 'glass_delusion',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 8, y = 26 },
  config = { odds = 2 },
  vars = function(card) return { odds(1), AIJ.val(card, 'glass_delusion', 'odds') } end,
  in_pool = function(state) return deckHas(state, isFragile) end,
  triggers = {
    onCardsDestroyed = function(joker, state, step, result)
      for _, c in ipairs(step.cards or {}) do
        local i = c.lastInfo or {}
        if i.enhancement == AIJ.vanilla('m_glass') and state:chance(1 / AIJ.num(joker, 'odds')) then
          for _ = 1, 2 do
            cardlike.addPlayingCard({ rank = i.rank, suit = i.suit, enhancement = i.enhancement, edition = AIJ.edition(c),
              stamp = AIJ.stamp(c), bonusPoints = i.bonusPoints }, { area = 'deck' })
          end
          result:say('+2 Cards', colors.ORANGE)
        end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'gloaming',
  rarity = 3, cost = 8, lite = true, atlas = 'joker_atlas', pos = { x = 18, y = 27 },
  config = { xmult = 1.5 },
  vars = function(card) return { AIJ.val(card, 'gloaming', 'xmult') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if state.handsLeft == 0 then result:add(xMult(AIJ.num(joker, 'xmult'))) end
