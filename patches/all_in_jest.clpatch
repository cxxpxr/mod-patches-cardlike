local CONSUMABLE_TYPES = { { 'game', 22 }, { 'fruit', 12 }, { 'admin', 16 } }
local function randomConsumableType(state)
  local total = 0
  for _, t in ipairs(CONSUMABLE_TYPES) do total = total + t[2] end
  local roll = state:random(1, total)
  for _, t in ipairs(CONSUMABLE_TYPES) do
    roll = roll - t[2]
    if roll <= 0 then return t[1] end
  end
  return 'game'
end

AIJ.addJoker {
  key = 'pour_one_out',
