local since = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  since = since + (frame.dt or 0)
  if since < 0.2 then return end
  since = 0
  local state = cardlike.state
  if not state or state.money == nil then return end
  if state:isPhase('shop') then
    AIJ.safe(growPacks, state)
  end
  if state:isPhase('shop') or state:isPhase('pack') then AIJ.safe(invertNotes, state) end
end)


== file jokers/batch06.lua (1837 lines)
local AIJ = cardlike.require('lib.aij')

local function B(text, colour) return colorize(bold(text), colour or colors.ORANGE) end
local function grey(text) return colorize(text, colors.GREY) end

local function activeJokers(id, state)
  state = state or cardlike.state
  local out = {}
  if not state or not state.jokers then return out end
  for _, j in ipairs(state.jokers) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function kindOf(card)
  if type(card) ~= 'table' then return nil end
  return (card.lastInfo and card.lastInfo.kind) or AIJ.safe(card.getKind, card)
end

local function consType(card)
  if type(card) ~= 'table' then return nil end
  return AIJ.safe(card.getConsumableType, card) or (card.lastInfo or {}).type
end

local function consumableRoom(state, used)
  local free = state.freeConsumableSlots or 0
  if used and AIJ.safe(used.getArea, used) == 'consumables' then free = free + 1 end
  return free
end

local function rankOf(card)
  if AIJ.noRank(card) then return 0 end
  return AIJ.safe(card.getRank, card) or 0
end

local function isFace(card)
  return not AIJ.isDebuffed(card) and AIJ.safe(card.isFace, card) == true
end

local E = nil
local function enhModule()
  if E == nil then
    local ok, mod = pcall(cardlike.require, 'items.enhancements')
    E = (ok and type(mod) == 'table') and mod or false
  end
  return E or nil
end

local function enhList(card)
  local m = enhModule()
  if m and m.enhKeys then
    local ok, list = pcall(m.enhKeys, card)
    if ok and type(list) == 'table' then return list end
  end
  local main = AIJ.enhancement(card)
  return main and { main } or {}
end

local function hasEnh(card, key)
  local want = AIJ.vanilla(key) or AIJ.short(key)
  for _, k in ipairs(enhList(card)) do
    if k == want or AIJ.isId(k, want) then return true end
  end
  return false
end

local EDITION_WEIGHTS = { { 'Luna', 20 }, { 'Holo', 14 }, { 'Chroma', 3 }, { 'Inverted', 3 } }
local AIJ_EDITION_WEIGHTS = { aureate = 3, glimmer = 6, misprint = 3, silver = 3, stellar = 3 }
local function randomEdition(state, noNeg)
  local pool, total = {}, 0
  for _, e in ipairs(EDITION_WEIGHTS) do
    if not (noNeg and e[1] == 'Inverted') then pool[#pool + 1] = e total = total + e[2] end
  end
  for _, k in ipairs(AIJ.lists.editions) do
    if AIJ.has(k, 'edition') then
      local w = AIJ_EDITION_WEIGHTS[k] or 3
      pool[#pool + 1] = { AIJ.id(k), w }
      total = total + w
    end
  end
  local r = state:randomFloat() * total
  for _, e in ipairs(pool) do
    r = r - e[2]
    if r <= 0 then return e[1] end
  end
  return pool[#pool][1]
end

local function descPlus(key, varsFn, extra)
  local base = AIJ.desc('Joker', 'j_aij_' .. key, varsFn)
  return function(r)
    local text = type(base) == 'function' and base(r) or base
    return text .. extra
  end
end

local ui = cardlike.ui
local pickQueue = {}
local picking = false
local showNextPicker
local function openPicker(title, entries, onPick)
  table.sort(entries, function(a, b) return tostring(a.name) < tostring(b.name) end)
  pickQueue[#pickQueue + 1] = { title = title, entries = entries, onPick = onPick }
  if not picking then showNextPicker() end
end
showNextPicker = function()
  local job = table.remove(pickQueue, 1)
  if not job then picking = false return end
  picking = true
  local query, page, per = '', 1, 12
  local handle
  local function filtered()
    if query == '' then return job.entries end
    local q, out = query:lower(), {}
    for _, e in ipairs(job.entries) do
      if tostring(e.name):lower():find(q, 1, true) then out[#out + 1] = e end
    end
    return out
  end
  local function pick(e)
    if handle then handle.close() end
    AIJ.safe(job.onPick, e)
    showNextPicker()
  end
  handle = ui.open {
    modal = true,
    closeOnEscape = false,
    content = function()
      local list = filtered()
      local pages = math.max(1, math.ceil(#list / per))
      if page > pages then page = pages end
      local col = { style = 'window', gap = 10, align = 'center',
        ui.text { text = job.title, size = 28, color = colors.ORANGE },
        ui.input { label = 'Search', value = query, width = 360, onChange = function(t) query = t or '' page = 1 end },
      }
      local last = math.min(#list, page * per)
      for i = (page - 1) * per + 1, last, 2 do
        local row = { gap = 8 }
        for k = i, math.min(i + 1, last) do
          local e = list[k]
          row[#row + 1] = ui.column { minWidth = 280, align = 'center',
            ui.button { label = tostring(e.name), onPress = function() pick(e) end } }
        end
        col[#col + 1] = ui.row(row)
      end
      if #list == 0 then col[#col + 1] = ui.text { text = 'Nothing matches', color = colors.GREY } end
      col[#col + 1] = ui.row { gap = 16, align = 'center',
        ui.button { label = '<', enabled = page > 1, onPress = function() page = math.max(1, page - 1) end },
        ui.text { text = page .. ' / ' .. pages },
        ui.button { label = '>', enabled = page < pages, onPress = function() page = math.min(pages, page + 1) end },
      }
      return ui.column(col)
    end,
  }
end

local handSizeTrackers = {}
local function applyHandSizeTrackers(state)
  for _, j in ipairs(state.jokers or {}) do
    local fn = handSizeTrackers[AIJ.short(AIJ.defId(j) or '')]
    if fn then
      local want = 0
      if not AIJ.isDebuffed(j) then want = fn(j, state) or 0 end
      local have = AIJ.num(j, 'aij_hs_applied')
      if want ~= have then
        state.handSize = state.handSize + (want - have)
        AIJ.set(j, 'aij_hs_applied', want)
      end
    end
  end
end
local function removeTrackedHandSize(joker, state)
  local have = AIJ.num(joker, 'aij_hs_applied')
  if have ~= 0 and state and state.handSize then
    state.handSize = state.handSize - have
    AIJ.set(joker, 'aij_hs_applied', 0)
  end
end

