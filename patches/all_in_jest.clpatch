    ["j_aij_skinsuit"] = { name = "Skinsuit", text = "If [color=\"#f3a712\"][b]first hand[/b][/color] of round is exactly [color=\"#f3a712\"][b]one[/b][/color] card, [color=\"#ff007f\"][b]destroy[/b][/color] it and patch its [color=\"#f3a712\"][b]suit[/b][/color] to a random card held in hand" },
    ["j_aij_skomorokh"] = { name = "Skomorokh", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]Editioned[/b][/color] card in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_sky_trees"] = { name = "Sky Trees", text = "[color=\"#f3a712\"][b]Fruit Stamps[/b][/color] give both [color=\"#ff007f\"][b]Mult[/b][/color] and [color=\"#3772ff\"][b]Points[/b][/color]-type [color=\"#13afce\"][b]Fruit[/b][/color] cards instead of [color=\"#f3a712\"][b]base[/b][/color]-type [color=\"#13afce\"][b]Fruit[/b][/color] cards" },
    ["j_aij_skytower"] = { name = "Skytower", text = "Hands other than your [color=\"#f3a712\"][b]most-played[/b][/color] hand are scored with [color=\"#f3a712\"][b]#1#[/b][/color] additional levels" },
    ["j_aij_skywriting"] = { name = "Skywriting", text = "" },
