    local line
    if effect == 'mult' then line = C('+' .. AIJ.fmt(AIJ.val(card, 'youve_got_mail', 'mult')) .. ' Mult', colors.MULT)
    elseif effect == 'chips' then line = C('+' .. AIJ.fmt(AIJ.val(card, 'youve_got_mail', 'chips')) .. ' Points', colors.CHIPS)
    elseif effect == 'dollars' then line = C('+$' .. AIJ.fmt(AIJ.val(card, 'youve_got_mail', 'dollars')), colors.MONEY) .. ' each hand played'
    elseif effect == 'xmult' then line = C('X' .. AIJ.fmt(1 + AIJ.val(card, 'youve_got_mail', 'xmult')) .. ' Mult', colors.MULT)
    else line = grey('Does nothing...') end
    return 'If ' .. C('not', colors.MULT) .. ' ' .. C('Inverted', '#5d5dff') .. ', when a ' .. C('Blind', colors.ORANGE)
      .. ' is selected, create an ' .. C('Inverted', '#5d5dff') .. ' ' .. C('copy', colors.ORANGE)
      .. ' of this Joker with ' .. C('$0', colors.MONEY) .. ' sell value and a random effect\n' .. line
  end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy or AIJ.edition(joker) == 'Inverted' then return end
      local copy = cardlike.createJoker(AIJ.id('youve_got_mail'), { edition = 'Inverted' })
      if not copy then return end
      AIJ.set(copy, 'effect', YGM_EFFECTS[state:random(1, #YGM_EFFECTS)])
      local sell = tonumber(AIJ.safe(copy.getSellValue, copy)) or 0
      if sell ~= 0 then copy:addSellValue(-sell) end
      copy:popup(AIJ.msg('k_aij_youve_got_mail', "You've Got Mail!"), colors.ORANGE)
      cardlike.playSound('ygm_youve_got_mail')
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local effect = AIJ.get(joker, 'effect')
      if effect == 'mult' then result:add(plusMult(AIJ.num(joker, 'mult')))
      elseif effect == 'chips' then result:add(plusChips(AIJ.num(joker, 'chips')))
      elseif effect == 'dollars' then result:add(plusMoney(AIJ.num(joker, 'dollars')))
      elseif effect == 'xmult' then result:add(xMult(1 + AIJ.num(joker, 'xmult'))) end
    end,
    onSold = function(joker, state, step, result)
      result:say(AIJ.msg('k_aij_youve_got_mail_goodbye', 'Goodbye'), colors.ORANGE)
      cardlike.playSound('ygm_goodbye')
    end,
  },
}

AIJ.addJoker {
  key = 'yu_sze',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 3, y = 6 }, soul_pos = { x = 3, y = 7 },
  config = { xmult = 2 },
  vars = function(card) return { AIJ.val(card, 'yu_sze', 'xmult') } end,
  triggers = {
    onOtherJoker = function(joker, state, step, result)
      if not step.other or AIJ.edition(step.other) then return end
      step.other:punch()
      result:add(xMult(AIJ.num(joker, 'xmult')))
    end,
  },
}

AIJ.addJoker {
  key = 'zanni',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 10, y = 3 },
  config = { odds = 10 },
  description = fixedDesc('zanni', function(card) return { AIJ.prob(), AIJ.val(card, 'zanni', 'odds') } end),
  triggers = {
    onScore = function(joker, state, step, result)
      local c = step.card
      if c:isFace() or not rankOf(c) or (state.freeConsumableSlots or 0) <= 0 then return end
      if state:chance(1 / AIJ.num(joker, 'odds')) then
        if cardlike.createConsumable('game') then result:say('+1 Game', AIJ.colors.TAROT) end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'zenzizenzizenzic',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 14, y = 27 },
  config = { chips = 0, mod = 0, mod_mod = 2 },
  vars = function(card)
    return { AIJ.val(card, 'zenzizenzizenzic', 'chips'), AIJ.val(card, 'zenzizenzizenzic', 'mod'),
      AIJ.val(card, 'zenzizenzizenzic', 'mod_mod') }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy or #(step.hand.playedCards or {}) ~= 4 then return end
      local mod = AIJ.add(joker, 'mod', AIJ.num(joker, 'mod_mod'))
      AIJ.add(joker, 'chips', mod)
      result:say('Upgrade!', colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if #(step.hand.playedCards or {}) == 4 and c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.addJoker {
  key = 'zerco',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 2, y = 6 }, soul_pos = { x = 2, y = 7 },
  blueprint_compat = false,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy or state.handsPlayed ~= 1 then return end
      local c = (step.hand.playedCards or {})[1]
      if c and not AIJ.edition(c) then
        c:setEdition('Inverted')
        result:say('Inverted!', '#5d5dff')
      end
    end,
  },
}


== file lib/aij.lua (802 lines)
local AIJ = {}
AIJ.MOD = 'all_in_jest'
AIJ.T = cardlike.require('lib.text')
AIJ.V = cardlike.require('lib.vanilla')

AIJ.colors = {
  ATTENTION = colors.ORANGE,
  INACTIVE = colors.GREY,
  TAROT = '#d138bf',
  PLANET = '#13afce',
  SPECTRAL = '#4584fa',
  ASTRAL = '#87a5c9',
  HEX = '#6a3b8f',
  PLASMA = '#d78fd0',
  SILVER = '#a9b6c6',
  STELLAR = '#7070a8',
  FAMILIAR = '#12077d',
  LEGENDARY = '#b26cbb',
  CHAOTIC = '#8f00ff',
  MOD = '#8b61ad',
}

function AIJ.id(id)
  if type(id) ~= 'string' or id:find(':', 1, true) then return id end
  return AIJ.MOD .. ':' .. id
end

function AIJ.short(id)
  if type(id) ~= 'string' then return id end
  local prefix = AIJ.MOD .. ':'
  if id:sub(1, #prefix) == prefix then return id:sub(#prefix + 1) end
  return id
end

function AIJ.isId(id, short)
  return id ~= nil and short ~= nil and (id == short or AIJ.short(id) == AIJ.short(short))
end

function AIJ.vanilla(key)
  for _, kind in ipairs({ 'joker', 'consumable', 'ticket', 'pin', 'enhancement', 'edition', 'stamp', 'hand' }) do
    local v = AIJ.V[kind][key]
    if v then return v, kind end
  end
  return nil
end

function AIJ.hand(name)
  return AIJ.V.hand[name] or name
end

local HAND_NAMES = {
  HIGH_CARD = 'High Card', PAIR = 'Pair', TWO_PAIR = 'Two Pair', THREE_OF_A_KIND = 'Three of a Kind',
  STRAIGHT = 'Straight', FLUSH = 'Flush', FULL_HOUSE = 'Full House', FOUR_OF_A_KIND = 'Four of a Kind',
  STRAIGHT_FLUSH = 'Straight Flush', ROYAL_FLUSH = 'Royal Flush', FLUSH_HOUSE = 'Flush House',
  FIVE_OF_A_KIND = 'Five of a Kind', FLUSH_FIVE = 'Flush Five',
}
AIJ.HANDS = { 'HIGH_CARD', 'PAIR', 'TWO_PAIR', 'THREE_OF_A_KIND', 'STRAIGHT', 'FLUSH', 'FULL_HOUSE',
  'FOUR_OF_A_KIND', 'STRAIGHT_FLUSH', 'ROYAL_FLUSH', 'FLUSH_HOUSE', 'FIVE_OF_A_KIND', 'FLUSH_FIVE' }

function AIJ.handName(id)
  if HAND_NAMES[id] then return HAND_NAMES[id] end
  local info = cardlike.contentInfo('handType', id)
  return info and info.name or tostring(id)
end

function AIJ.safe(fn, ...)
  local ok, v = pcall(fn, ...)
  if ok then return v end
  return nil
end

function AIJ.exists(card)
  return type(card) == 'table' and AIJ.safe(card.exists, card) == true
end

function AIJ.defId(card)
  if type(card) == 'string' then return card end
  if type(card) ~= 'table' then return nil end
  local info = card.lastInfo or {}
  local kind = info.kind or AIJ.safe(card.getKind, card)
  if kind == 'joker' then return AIJ.safe(card.getJokerDef, card) or info.joker end
  if kind == 'playing' then return nil end
  return AIJ.safe(card.getConsumableDef, card) or info.consumable
end

function AIJ.is(card, short)
  return AIJ.isId(AIJ.defId(card), short)
end

function AIJ.edition(card)
  local e = type(card) == 'table' and (AIJ.safe(card.getEdition, card) or (card.lastInfo or {}).edition)
  if e == nil or e == '' or e == 'default' then return nil end
  return e
end

function AIJ.enhancement(card)
  local e = type(card) == 'table' and (AIJ.safe(card.getEnhancement, card) or (card.lastInfo or {}).enhancement)
  if e == nil or e == '' or e == 'Default' then return nil end
  return e
end

function AIJ.stamp(card)
  local s = type(card) == 'table' and (AIJ.safe(card.getStamp, card) or (card.lastInfo or {}).stamp)
  if s == nil or s == '' or s == 'none' or s == 'None' then return nil end
  return s
end

local function matchContent(have, id)
  if have == nil or id == nil then return false end
  local v = AIJ.vanilla(id)
  if v then return have == v end
  return AIJ.isId(have, id)
end
function AIJ.hasEnhancement(card, id) return matchContent(AIJ.enhancement(card), id) end
function AIJ.hasEdition(card, id) return matchContent(AIJ.edition(card), id) end
function AIJ.hasStamp(card, id)
  local s = AIJ.stamp(card)
  if s == nil or id == nil then return false end
  local v = AIJ.vanilla(id)
  if v then return s == v or s .. ' Stamp' == v end
  return AIJ.isId(s, id)
end

function AIJ.isDebuffed(card)
  local d = type(card) == 'table' and AIJ.safe(card.getDebuffState, card)
  if d == nil and type(card) == 'table' and card.lastInfo then d = card.lastInfo.debuffed end
  return d == true
end

function AIJ.noRank(card)
  local info = card.lastInfo or {}
  return info.noRank == true or AIJ.enhancement(card) == 'Rock'
end

local RANK_NAMES = { [11] = 'Jack', [12] = 'Queen', [13] = 'King', [14] = 'Ace' }
function AIJ.rankName(n) return RANK_NAMES[n] or tostring(n) end
local RANK_NUM = { Ace = 14, King = 13, Queen = 12, Jack = 11, A = 14, K = 13, Q = 12, J = 11, T = 10 }
function AIJ.rankNum(text) return RANK_NUM[text] or tonumber(text) end

AIJ.SUITS = { 'Spades', 'Hearts', 'Clubs', 'Diamonds' }
AIJ.SUIT_COLORS = { Spades = colors.SPADES_COLOR, Hearts = colors.HEARTS_COLOR, Clubs = colors.CLUBS_COLOR, Diamonds = colors.DIAMONDS_COLOR }

function AIJ.copy(t)
  if type(t) ~= 'table' then return t end
  local o = {}
  for k, v in pairs(t) do o[k] = AIJ.copy(v) end
  return o
end

function AIJ.contains(list, x)
  for _, v in ipairs(list or {}) do if v == x then return true end end
  return false
end

function AIJ.pick(list, state)
  if not list or #list == 0 then return nil end
  state = state or cardlike.state
  if state and state.random then return list[state:random(1, #list)] end
  return list[math.floor(cardlike.random() * #list) + 1]
end

function AIJ.shuffled(list, state)
  state = state or cardlike.state
  local out = {}
  for i, v in ipairs(list or {}) do out[i] = v end
  for i = #out, 2, -1 do
    local j = state:random(1, i)
    out[i], out[j] = out[j], out[i]
  end
  return out
end

function AIJ.fmt(n)
  if type(n) ~= 'number' then return tostring(n) end
  if n ~= n then return 'nan' end
  if math.abs(n) >= 1e15 then return string.format('%.3g', n) end
  if n == math.floor(n) then return string.format('%d', n) end
  return (string.format('%.2f', n):gsub('0+$', ''):gsub('%.$', ''))
end

function AIJ.loc(set, key)
  local s = AIJ.T[set]
  return s and s[key] or nil
end

function AIJ.msg(key, fallback)
  return AIJ.T.dict[key] or fallback or key
end

function AIJ.fill(text, vars)
  vars = vars or {}
  text = text:gsub('#V(%d+)#', function(i)
    local c = vars.colours and vars.colours[tonumber(i)]
    return c or colors.ORANGE
  end)
  return (text:gsub('#(%d+)#', function(i)
    local v = vars[tonumber(i)]
    if v == nil then return '?' end
    return type(v) == 'number' and AIJ.fmt(v) or tostring(v)
  end))
end

function AIJ.desc(set, key, varsFn)
  local e = AIJ.loc(set, key)
  local text = e and e.text or ''
  if not varsFn then return (text:find('#%d+#') or text:find('#V%d+#')) and function() return AIJ.fill(text, {}) end or text end
  return function(r)
    local ok, vars = pcall(varsFn, r and r.card, r)
    if not ok then vars = {} end
    return AIJ.fill(text, vars)
  end
end

function AIJ.prob()
  local s = cardlike.state
  return (s and s.chanceMultiplier) or 1
end

AIJ.defaults = {}

function AIJ.setDefaults(fullId, config)
  AIJ.defaults[fullId] = config or {}
end

function AIJ.default(id, key, fallback)
  local d = AIJ.defaults[AIJ.id(id)] or AIJ.defaults[id]
  if d and d[key] ~= nil then return AIJ.copy(d[key]) end
  return fallback
end

function AIJ.get(card, key, fallback)
  if not card then return fallback end
  local v = card:getDataStore():get(key)
  if v ~= nil then return v end
  local id = AIJ.defId(card)
  if id then
    local d = AIJ.defaults[id]
    if d and d[key] ~= nil then return AIJ.copy(d[key]) end
  end
  return fallback
end

function AIJ.set(card, key, value)
  if value == nil then
    card:getDataStore():delete(key)
    return nil
  end
  card:getDataStore():set(key, value)
  return value
end

function AIJ.add(card, key, delta)
  return AIJ.set(card, key, (tonumber(AIJ.get(card, key, 0)) or 0) + delta)
end

function AIJ.num(card, key) return tonumber(AIJ.get(card, key, 0)) or 0 end

function AIJ.val(card, id, key, fallback)
  if card then return AIJ.get(card, key, AIJ.default(id, key, fallback)) end
  return AIJ.default(id, key, fallback)
end

local settings = cardlike.settings()
AIJ.settings = settings
local SETTING_DEFAULTS = {
  moons_enabled = true,
  moons_blocking = false,
  blue_stake_rework = true,
  aij_lite = false,
  no_copy_neg = false,
  red_destroy_text = true,
  suit_boss_blocking = false,
}
for k, v in pairs(SETTING_DEFAULTS) do
  if settings[k] == nil then settings[k] = v end
end
function AIJ.setting(key) return settings[key] end

function AIJ.enabled(def)
  if def.ignore then return false end
  if settings.aij_lite and not def.lite then return false end
  return true
end

AIJ.run = {}
local runInits = {}

function AIJ.onNewRun(fn) runInits[#runInits + 1] = fn end

local function initRun(run)
  for _, fn in ipairs(runInits) do pcall(fn, run) end
end

cardlike.onSave(function() return AIJ.run end)
cardlike.onLoad(function(data)
  local run = {}
  initRun(run)
  if type(data) == 'table' then
    for k, v in pairs(data) do run[k] = v end
  end
  AIJ.run = run
end)

AIJ.SHEETS = {
  joker_atlas = { file = 'images/jokers.png', w = 142, h = 190 },
  legendary_atlas = { file = 'images/legendaries.png', w = 142, h = 190 },
  familiar_atlas = { file = 'images/familiar.png', w = 142, h = 190 },
  misc_atlas = { file = 'images/misc.png', w = 142, h = 190 },
  jumbo_joker = { file = 'images/jumbo_joker.png', w = 162, h = 222 },
  trophy_kill = { file = 'images/trophy_kill.png', w = 182, h = 190 },
  hires_joker = { file = 'images/HiRes_Joker.png', w = 2100, h = 2818 },
  consumable_atlas = { file = 'images/consumables.png', w = 142, h = 190 },
  enhancements_atlas = { file = 'images/enhancements.png', w = 142, h = 190 },
  multi_enhancements_atlas = { file = 'images/multi_enhancements.png', w = 142, h = 190 },
  multi_simulated_atlas = { file = 'images/multi_simulated.png', w = 142, h = 190 },
  multi_enhancements_foregrounds_atlas = { file = 'images/foregrounds.png', w = 142, h = 190 },
  vouchers_atlas = { file = 'images/vouchers.png', w = 142, h = 190 },
  booster_atlas = { file = 'images/boosters.png', w = 142, h = 190 },
  deck_atlas = { file = 'images/decks.png', w = 142, h = 190 },
  stickers_atlas = { file = 'images/stickers.png', w = 142, h = 190 },
  mystery_atlas = { file = 'images/mystery.png', w = 142, h = 190 },
  tag_atlas = { file = 'images/tag.png', w = 68, h = 68 },
  blinds = { file = 'images/blinds.png', w = 68, h = 68 },
  blinds_pit = { file = 'images/blinds_pit.png', w = 68, h = 68 },
  blinds_final = { file = 'images/blinds_final.png', w = 68, h = 68 },
  blind_drawn_replacement = { file = 'images/unknown_blind.png', w = 68, h = 68 },
}
for key, s in pairs(AIJ.SHEETS) do
  cardlike.addSpriteSheet { id = key, file = s.file, frameWidth = s.w, frameHeight = s.h }
end

function AIJ.sprite(atlas, x, y)
  if type(atlas) ~= 'string' then return nil end
  atlas = atlas:gsub('^aij_', '')
  if not AIJ.SHEETS[atlas] then return nil end
  if type(x) == 'table' then x, y = x.x, x.y end
  if atlas == 'blinds' or atlas == 'blinds_pit' or atlas == 'blinds_final' or atlas == 'blind_drawn_replacement' then x = 0 end
  return { sheet = atlas, x = x or 0, y = y or 0 }
end

AIJ.registered = {}
AIJ.jokers = {}
AIJ.jokerRarity = {}
AIJ.jokerDefs = {}
AIJ.pools = { Food = {} }
for _, k in ipairs({ 'j_gros_michel', 'j_egg', 'j_ice_cream', 'j_cavendish', 'j_turtle_bean', 'j_diet_cola', 'j_popcorn', 'j_ramen', 'j_selzer' }) do
  table.insert(AIJ.pools.Food, AIJ.V.joker[k])
end

function AIJ.has(id, kind)
  local full = AIJ.id(id)
  if kind then return AIJ.registered[kind] ~= nil and AIJ.registered[kind][full] == true end
  for _, set in pairs(AIJ.registered) do if set[full] then return true end end
  return false
end

local function mark(kind, full)
  AIJ.registered[kind] = AIJ.registered[kind] or {}
  AIJ.registered[kind][full] = true
end

function AIJ.owns(id, state)
  state = state or cardlike.state
  if not state or not state.hasJoker then return false end
  local v = AIJ.V.joker[id]
  if v then return state:hasJoker(v) end
  if AIJ.has(id, 'joker') then return state:hasJoker(AIJ.id(id)) end
  return state:hasJoker(id)
end

function AIJ.count(id, state)
  state = state or cardlike.state
  if not state or not state.countJoker then return 0 end
  local v = AIJ.V.joker[id]
  if v then return state:countJoker(v) end
  if AIJ.has(id, 'joker') then return state:countJoker(AIJ.id(id)) end
  return state:countJoker(id)
end

function AIJ.inPool(pool, jokerId)
  for _, id in ipairs(AIJ.pools[pool] or {}) do
    if id == jokerId or AIJ.isId(jokerId, id) then return true end
  end
  return false
end

AIJ.gates = {}
function AIJ.gate(id, fn)
  if id then AIJ.gates[AIJ.id(id)] = fn end
  return id
end

AIJ.noShop = {}

cardlike.filter('jokerPool', function(ids, rarity)
  if rarity == 'familiar_face' or rarity == AIJ.id('familiar_face') then return nil end
  local state = cardlike.state
  local keep, changed = {}, false
  for _, id in ipairs(ids) do
    local ok = not AIJ.noShop[id]
    local gate = AIJ.gates[id]
    if ok and gate then
      local good, res = pcall(gate, state)
      ok = (not good) or res ~= false
    end
    if ok then keep[#keep + 1] = id else changed = true end
  end
  if changed then return keep end
end)

cardlike.addRarity { id = 'familiar_face', like = 'Rare' }

local RARITY = { [1] = 'Common', [2] = 'Uncommon', [3] = 'Rare', [4] = 'Legendary',
  aij_familiar_face = 'familiar_face', familiar_face = 'familiar_face' }

function AIJ.addJoker(def)
  if not AIJ.enabled(def) then return nil end
  local key = def.key or def.id
  local full = AIJ.id(key)
  local e = AIJ.loc('Joker', 'j_aij_' .. key) or {}
  local rarity = RARITY[def.rarity] or def.rarity or 'Common'
  local out = {
    id = key,
    readableName = def.readableName or def.name or e.name or key,
    rarity = rarity,
    price = def.price or def.cost,
    copyable = def.copyable,
    description = def.description or AIJ.desc('Joker', 'j_aij_' .. key, def.vars),
    triggers = def.triggers,
    onAdded = def.onAdded,
    onRemoved = def.onRemoved,
    dollarsAtRoundEnd = def.dollarsAtRoundEnd,
    buttons = def.buttons,
    credits = def.credits,
    sprite = def.sprite or AIJ.sprite(def.atlas or 'joker_atlas', def.pos),
    layerSprite = def.layerSprite or (def.soul_pos and AIJ.sprite(def.atlas or 'joker_atlas', def.soul_pos)) or nil,
    image = def.image,
  }
  if out.copyable == nil and def.blueprint_compat == false then out.copyable = false end
  AIJ.setDefaults(full, def.config or {})
  local ok, err = pcall(cardlike.addJoker, out)
  if not ok then
    cardlike.warn('All in Jest: joker ' .. tostring(key) .. ' failed: ' .. tostring(err))
    return nil
  end
  mark('joker', full)
  AIJ.jokerDefs[full] = out
  AIJ.jokers[#AIJ.jokers + 1] = full
  AIJ.jokerRarity[full] = rarity
  for pool in pairs(def.pools or {}) do
    AIJ.pools[pool] = AIJ.pools[pool] or {}
    table.insert(AIJ.pools[pool], full)
  end
  if rarity == 'familiar_face' then AIJ.noShop[full] = true end
  if def.in_pool then AIJ.gate(full, def.in_pool) end
  return full
end

function AIJ.register(fnName, def, kind)
  if not AIJ.enabled(def) then return nil end
  local ok, res = pcall(cardlike[fnName], def)
  if not ok then
    cardlike.warn('All in Jest: ' .. fnName .. ' ' .. tostring(def.id) .. ' failed: ' .. tostring(res))
    return nil
  end
  local full = AIJ.id(def.id)
  mark(kind or fnName, full)
  if def.config then AIJ.setDefaults(full, def.config) end
  return full
end

local goneListeners = {}
local lastJokers = nil
local soldUids = {}

function AIJ.onJokerGone(fn) goneListeners[#goneListeners + 1] = fn end

local function snapshotJokers()
  local out = {}
  for _, info in ipairs(cardlike.cardInfos('jokers') or {}) do out[info.uid] = info end
  return out
end

function AIJ.checkJokers()
  local state = cardlike.state
  if not state or state.money == nil then lastJokers = nil return end
  local now = snapshotJokers()
  if lastJokers and #goneListeners > 0 then
    for uid, info in pairs(lastJokers) do
      if not now[uid] then
        local sold = soldUids[uid] == true
        for _, fn in ipairs(goneListeners) do pcall(fn, state, info, sold) end
      end
    end
  end
  soldUids = {}
  lastJokers = now
end

cardlike.on('onCardSold', function(state, step)
  local c = step.card
  if c and c.lastInfo and c.lastInfo.kind == 'joker' then soldUids[c.uid] = true end
  AIJ.checkJokers()
end)
cardlike.on('onRunStart', function() lastJokers = nil soldUids = {} end)
local sinceCheck = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then lastJokers = nil return end
  sinceCheck = sinceCheck + (frame.dt or 0)
  if sinceCheck < 0.2 then return end
  sinceCheck = 0
  if #goneListeners > 0 then AIJ.checkJokers() end
end)

AIJ.onNewRun(function(run) run.aij_any_patch = false end)

function AIJ.patches(card)
  if type(card) ~= 'table' then return {} end
  local ds = AIJ.safe(card.getDataStore, card)
  local p = ds and ds:get('aij_patches')
  return type(p) == 'table' and p or {}
end

function AIJ.hasPatch(card, suit)
  return AIJ.patches(card)[suit] == true
end

function AIJ.addPatch(card, suit)
  local p = AIJ.copy(AIJ.patches(card))
  if p[suit] then return false end
  p[suit] = true
  card:getDataStore():set('aij_patches', p)
  AIJ.run.aij_any_patch = true
  return true
end

function AIJ.removePatches(card)
  card:getDataStore():delete('aij_patches')
end

function AIJ.suitsOf(card)
  local out = AIJ.copy(AIJ.patches(card))
  local s = AIJ.safe(card.getSuit, card)
  if s and s ~= 'None' then out[s] = true end
  return out
end

local allSuitRules = {}
function AIJ.allSuitsIf(fn) allSuitRules[#allSuitRules + 1] = fn end

local function allSuits(state)
  for _, fn in ipairs(allSuitRules) do
    local ok, res = pcall(fn, state)
    if ok and res then return true end
  end
  return false
end

cardlike.hook('SaveState.compareSuitRaw', {
  after = function(state, result, a, b)
    if result or #allSuitRules == 0 then return nil end
    if a ~= 'None' and b ~= 'None' and allSuits(state) then return true end
  end,
})
local cardSuitRules = {}
function AIJ.cardSuitIf(fn) cardSuitRules[#cardSuitRules + 1] = fn end

local function ruleSuit(state, card, suit)
  for _, fn in ipairs(cardSuitRules) do
    local ok, res = pcall(fn, state, card, suit)
    if ok and res then return true end
  end
  return false
end

local baseOnlyRules = {}
function AIJ.baseSuitsOnlyIf(fn) baseOnlyRules[#baseOnlyRules + 1] = fn end

local function baseOnly(state)
  for _, fn in ipairs(baseOnlyRules) do
    local ok, res = pcall(fn, state)
    if ok and res then return true end
  end
  return false
end

cardlike.hook('SaveState.suitMatches', {
  after = function(state, result, card, suit)
    if not card then return nil end
    if #baseOnlyRules > 0 and baseOnly(state) then
      local s = AIJ.safe(card.getSuit, card)
      return s ~= nil and s ~= 'None' and s == suit
    end
    if result then return nil end
    if AIJ.run.aij_any_patch and AIJ.hasPatch(card, suit) then return true end
    if #cardSuitRules > 0 and suit ~= 'None' and ruleSuit(state, card, suit) then return true end
  end,
})
cardlike.hook('SaveState.compareSuit', {
  after = function(state, result, a, b)
    if not a or not b then return nil end
    if #baseOnlyRules > 0 and baseOnly(state) then
      local sa, sb = AIJ.safe(a.getSuit, a), AIJ.safe(b.getSuit, b)
      return sa ~= nil and sa ~= 'None' and sa == sb
    end
    if result then return nil end
    local sb = AIJ.safe(b.getSuit, b)
    if not sb or sb == 'None' then return nil end
    if AIJ.run.aij_any_patch and AIJ.hasPatch(a, sb) then return true end
    if #cardSuitRules > 0 and ruleSuit(state, a, sb) then return true end
  end,
})

function AIJ.isSuit(card, suit, state)
  if type(card) ~= 'table' or not suit or suit == 'None' then return false end
  state = state or cardlike.state
  local own = AIJ.safe(card.getSuit, card)
  if #baseOnlyRules > 0 and baseOnly(state) then return own == suit end
  if AIJ.safe(card.isSuit, card, suit) then return true end
  if AIJ.hasPatch(card, suit) then return true end
  if #cardSuitRules > 0 and ruleSuit(state, card, suit) then return true end
  if own and own ~= 'None' and #allSuitRules > 0 and allSuits(state) then return true end
  return false
end

for method, suit in pairs({ isHeartSuit = 'Hearts', isSpadeSuit = 'Spades', isClubSuit = 'Clubs', isDiamondSuit = 'Diamonds' }) do
  cardlike.hook('SaveState.' .. method, {
    after = function(state, result, card)
      if not card then return nil end
      if #baseOnlyRules > 0 and baseOnly(state) then
        return AIJ.safe(card.getSuit, card) == suit
      end
      if result then return nil end
      if AIJ.run.aij_any_patch and AIJ.hasPatch(card, suit) then return true end
      if #cardSuitRules > 0 and ruleSuit(state, card, suit) then return true end
    end,
  })
end

local rerollMods = {}
local rerollApplied = 0
function AIJ.rerollMod(fn) rerollMods[#rerollMods + 1] = fn end

function AIJ.syncReroll(state)
  state = state or cardlike.state
  if not state or #rerollMods == 0 or not state.isPhase or not state:isPhase('shop') then return end
  local want = 0
  for _, fn in ipairs(rerollMods) do
    local ok, d = pcall(fn, state)
    if ok and type(d) == 'number' then want = want + d end
  end
  local cost = state.rerollCost or 0
  local base = cost - rerollApplied
  local target = math.max(0, base + want)
  if target ~= cost then state.rerollCost = target end
  rerollApplied = target - base
end

cardlike.on('onShopEnter', function(state)
  rerollApplied = 0
  AIJ.syncReroll(state)
end)
cardlike.filter('shopReroll', function(allowed)
  local state = cardlike.state
  if allowed ~= false and state and (state.rerollsThisShop or 0) == 0 and rerollApplied ~= 0 then
    state.money = state.money - rerollApplied
    rerollApplied = 0
  end
  return nil
end)
cardlike.on('onShopReroll', function(state) AIJ.syncReroll(state) end)
cardlike.on('onCardBought', function(state) AIJ.syncReroll(state) end)
cardlike.on('onCardSold', function(state) AIJ.syncReroll(state) end)
local sinceReroll = 0
cardlike.onFrame(function(frame)
  if not frame.inRun or #rerollMods == 0 then return end
  sinceReroll = sinceReroll + (frame.dt or 0)
  if sinceReroll < 0.25 then return end
  sinceReroll = 0
  AIJ.syncReroll()
end)

function AIJ.perma(card, key)
  local ds = type(card) == 'table' and AIJ.safe(card.getDataStore, card)
  return (ds and tonumber(ds:get('aij_perma_' .. key))) or 0
end

function AIJ.permaAdd(card, key, n)
  local kind = (card.lastInfo or {}).kind or AIJ.safe(card.getKind, card)
  if key == 'chips' and kind == 'playing' then
    card:addAdditionalPointValue(n)
    return AIJ.safe(card.getAdditionalPointValue, card) or n
  end
  local v = AIJ.perma(card, key) + n
  card:getDataStore():set('aij_perma_' .. key, v)
  return v
end

local function permaList(card, held)
  local out = {}
  if held then
    local m, x = AIJ.perma(card, 'h_mult'), AIJ.perma(card, 'h_x_mult')
    if m ~= 0 then out[#out + 1] = plusMult(m) end
    if x ~= 0 then out[#out + 1] = xMult(1 + x) end
  else
    local m, x, d = AIJ.perma(card, 'mult'), AIJ.perma(card, 'x_mult'), AIJ.perma(card, 'p_dollars')
    if m ~= 0 then out[#out + 1] = plusMult(m) end
    if x ~= 0 then out[#out + 1] = xMult(1 + x) end
    if d ~= 0 then out[#out + 1] = plusMoney(d) end
  end
  return out
end

cardlike.filter('cardBonuses', function(list, card, held)
  if not card then return nil end
  local add = permaList(card, held == true)
  if #add == 0 then return nil end
  local out = {}
  for _, b in ipairs(list or {}) do out[#out + 1] = b end
  for _, b in ipairs(add) do out[#out + 1] = b end
  return out
end)

cardlike.on('repeatCard', function(state, step)
  local n = step.card and AIJ.perma(step.card, 'reps') or 0
  if n > 0 then return math.floor(n) end
end)

cardlike.on('onScoreInHand', function(state, step, result)
  local c = step.card
  if not c or AIJ.isDebuffed(c) then return end
  for _, b in ipairs(permaList(c, true)) do result:add(b) end
end)

cardlike.on('afterAllCardsScored', function(state, step, result)
  for _, j in ipairs(state.jokers or {}) do
    if not AIJ.isDebuffed(j) then
      local c, m, x = AIJ.perma(j, 'chips'), AIJ.perma(j, 'mult'), AIJ.perma(j, 'x_mult')
      if c ~= 0 then result:add(plusChips(c)) end
      if m ~= 0 then result:add(plusMult(m)) end
      if x ~= 0 then result:add(xMult(1 + x)) end
    end
  end
end)

AIJ.abilities = {}
local abilityListeners = {}

function AIJ.onAbilityUsed(fn) abilityListeners[#abilityListeners + 1] = fn end

function AIJ.ability(jokerId, spec)
  local full = AIJ.id(jokerId)
  AIJ.abilities[full] = spec
  return {
    label = spec.label or 'USE',
    canPress = spec.canPress,
    press = function(card, state)
      local res = spec.press(card, state, {})
      if res == false then return end
      for _, fn in ipairs(abilityListeners) do pcall(fn, state, card, full) end
    end,
  }
end

function AIJ.useAbility(card, state)
  local spec = AIJ.abilities[AIJ.defId(card) or '']
  if not spec then return false end
  if spec.canPress and spec.canPress(card, state) == false then return false end
  return spec.press(card, state, { free = true, repeated = true }) ~= false
end

AIJ.lists = {
  gold_pins = { 'anarchy', 'asteroid', 'auspicious', 'bierstiefel', 'capital', 'cinema', 'circumplanetary', 'crystal',
    'dark_matter', 'dominus', 'err_tag_undefined', 'frugal', 'galloping_domino', 'gioco', 'glamour', 'gold_dust',
    'grand_astrologer', 'hermetic', 'ignoramus', 'iridescent', 'landfill', 'nonstandard', 'occult', 'omnichrome',
    'polydactyly', 'recherche', 'stereoscopic', 'superlunary', 'ticket', 'timelost', 'unusual', 'velocity',
    'ventripotent', 'windfall' },
  pins = { 'astrology', 'aureate', 'chaos', 'fortunate', 'glimmer', 'misprinted', 'overstuffed', 'silver', 'soulbound', 'stellar' },
  astral = { 'alcyone', 'aldebaran', 'algol', 'algorab', 'alkaid', 'antares', 'arcturus', 'capella', 'deneb_algedi',
    'procyon', 'regulus', 'sirius', 'spica', 'vega' },
  moons = { '2000_eu16', '2013_nd15', 'callisto', 'charon', 'deimos', 'dysnomia', 'europa', 'iapetus', 'kamooalewa',
    'kuiper', 'luna', 'nibiru', 'nix', 'oberon', 'pallas', 'phaethon', 'phobos', 'planet_nine', 'proteus', 'titan',
    'triton', 'umbriel', 'vulcanoid', 'zoozve' },
  hex = { 'error', 'faceless', 'janitor', 'oracle' },
  editions = { 'aureate', 'glimmer', 'misprint', 'silver', 'stellar' },
  enhancements = { 'canvas', 'charged', 'fervent', 'ice', 'scorched', 'simulated', 'wood' },
  stamps = { 'eye', 'melted', 'smiley' },
}

function AIJ.randomGoldPin(state)
  local have = {}
  state = state or cardlike.state
  local round = state and state.round or 0
  for _, k in ipairs(AIJ.lists.gold_pins) do
    local ok = AIJ.has(k, 'pin') and k ~= 'grand_astrologer' and not (k == 'velocity' and round > 19)
    if ok then have[#have + 1] = AIJ.id(k) end
  end
  return AIJ.pick(have, state)
end

return AIJ


