AIJ.addJoker {
  key = 'honker',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 3, y = 5 },
  config = { mult_mod = 1, cur_mult = 0 },
  vars = function(card) return { AIJ.val(card, 'honker', 'mult_mod', 1), AIJ.val(card, 'honker', 'cur_mult', 0) } end,
  in_pool = function(state) return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'm_mult') end) end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or not AIJ.hasEnhancement(step.card, 'm_mult') then return end
      AIJ.add(joker, 'cur_mult', AIJ.num(joker, 'mult_mod'))
      result:say('Upgrade!', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'cur_mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local function ijokerOffer(card, i)
  local offers = AIJ.get(card, 'offers')
  return type(offers) == 'table' and offers[i] or nil, offers
end
local function ijokerButton(i)
  return {
    label = function(card, state)
      local o = ijokerOffer(card, i)
      if not o then return 'NO PIN' end
      if o.bought then return 'SOLD' end
      return pinName(o.id) .. ' $' .. o.price
    end,
    canPress = function(card, state)
      local o = ijokerOffer(card, i)
      return o ~= nil and not o.bought and state:isPhase('shop') and (state.money or 0) >= o.price
    end,
    press = function(card, state)
      local o, offers = ijokerOffer(card, i)
      if not o or o.bought then return end
      state:mutateMoney(-o.price)
      cardlike.addPin(o.id)
      o.bought = true
      AIJ.set(card, 'offers', offers)
      card:punch()
    end,
  }
end
AIJ.addJoker {
  key = 'ijoker_co',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 0, y = 8 },
  config = { tags = 2 },
  description = function(r)
    local n = AIJ.val(r and r.card, 'ijoker_co', 'tags', 2)
    return colorize(bold(tostring(n)), colors.ORANGE) .. ' random ' .. colorize(bold('Pins'), colors.ORANGE)
      .. ' available for purchase each ' .. colorize(bold('shop'), colors.ORANGE)
      .. hint('Drag this Joker and press a Pin to buy it')
  end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      local offers = {}
      for i = 1, math.min(4, AIJ.num(joker, 'tags')) do
        local id = randomOfferPin(state)
        if id then offers[#offers + 1] = { id = id, price = pinPrice(id, state), bought = false } end
      end
      AIJ.set(joker, 'offers', offers)
    end,
    onShopExit = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'offers', {}) end
    end,
  },
  buttons = { ijokerButton(1), ijokerButton(2) },
}

cardlike.filter('skipPin', function(id, slot)
  local state = cardlike.state
  if not state then return nil end
  local n = AIJ.count('illuminated_joker', state)
  if n > 0 and state:randomFloat() < (4 * n) / 30 then
    return AIJ.randomGoldPin(state)
  end
  return nil
end)
