  action = function(ctx) H.setEdition(ctx.state.jokers[1], H.modEdition('silver')) end }

local function mostPlayed(state)
  local ht = state and state.mostPlayedHand
  local h = ht and state:getHand(ht)
  if h and (h.played or 0) > 0 then return ht end
  return nil
end
gold { key = 'circumplanetary', pos = { x = 5, y = 1 }, popWhen = H.ANY_TIME,
