AIJ.addJoker {
  key = 'phlegmatic_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 13 },
  config = { odds = 6 },
  blueprint_compat = true,
  description = function(r)
    return AIJ.fill(fixedText('j_aij_phlegmatic_joker'), { AIJ.prob(), AIJ.val(r and r.card, 'phlegmatic_joker', 'odds') })
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if not step.card:isSuit('Clubs') or (state.freeConsumableSlots or 0) <= 0 then return end
      local fruit = FRUIT[step.hand.handType]
      if not fruit then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then
        local c = cardlike.createConsumable(fruit)
        if c then result:say('+1 Fruit', AIJ.colors.PLANET) end
      end
    end,
  },
}

local phoneyToken = nil

local function phoneyActive(state)
  for _, j in ipairs(owned(state, 'phoney_baloney')) do
    if AIJ.num(j, 'rerolls_remaining') > 0 then return true end
  end
  return false
end

AIJ.rerollMod(function(state)
  if phoneyActive(state) then return -math.huge end
  return 0
end)

AIJ.addJoker {
  key = 'phoney_baloney',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 9, y = 7 },
  config = { rerolls = 5, rerolls_remaining = 5 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'phoney_baloney', 'rerolls_remaining'), AIJ.val(card, 'phoney_baloney', 'rerolls') } end,
  triggers = {
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy or AIJ.num(joker, 'rerolls_remaining') <= 0 then return end
      local token = tostring(state.ante) .. ':' .. tostring(state.round) .. ':' .. tostring(state.rerollsThisShop)
      if phoneyToken == token then return end
      phoneyToken = token
      local left = AIJ.add(joker, 'rerolls_remaining', -1)
      if left <= 0 then
        result:say(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.ORANGE)
        result:destroySelf()
      else
        result:say(AIJ.fmt(left) .. ' Remaining', colors.ORANGE)
      end
      AIJ.syncReroll(state)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local n = AIJ.num(joker, 'rerolls')
      AIJ.add(joker, 'rerolls_remaining', n)
      result:say('+' .. AIJ.fmt(n) .. ' Rerolls', colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
