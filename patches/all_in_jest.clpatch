    ["j_aij_arecibo_message"] = { name = "Arecibo", text = "Retrigger [color=\"#f3a712\"][b]all[/b][/color] cards if you hold the [color=\"#13afce\"][b]Fruit Card[/b][/color] for the played [color=\"#f3a712\"][b]poker hand[/b][/color]" },
    ["j_aij_arlecchina"] = { name = "Arlecchina", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a [color=\"#f3a712\"][b]Fool Pack[/b][/color] or [color=\"#f3a712\"][b]Deck Pack[/b][/color] is [color=\"#f3a712\"][b]skipped[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_arlecchino"] = { name = "Arlecchino", text = "Can take unlimited options in [color=\"#f3a712\"][b]Fool Packs[/b][/color] and [color=\"#f3a712\"][b]Deck Packs[/b][/color]" },
    ["j_aij_arngren"] = { name = "Arngren", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Card Slot, [color=\"#f3a712\"][b]+#1#[/b][/color] Booster Slot, and [color=\"#f3a712\"][b]+#1#[/b][/color] Ticket Slot in the [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["j_aij_art_of_the_deal"] = { name = "Art of the Deal", text = "Gains [color=\"#ff007f\"][b]+#2#[/b][/color] Mult when [color=\"#f3a712\"][b]money[/b][/color] is earned Resets if you have [color=\"#f3a712\"][b]$#3#[/b][/color] or less\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_ascii"] = { name = "", text = "" },
    ["j_aij_asphyxiation"] = { name = "Asphyxiation", text = "" },
    ["j_aij_astrologer"] = { name = "Astrologer", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] pick in [color=\"#13afce\"][b]Fruit Packs[/b][/color]\n[color=\"#13afce\"][b]Fruit[/b][/color] cards are replaced by their [color=\"#ff007f\"][b]Mult[/b][/color] variant in [color=\"#f3a712\"][b]odd[/b][/color] antes and their [color=\"#3772ff\"][b]Points[/b][/color] variant in [color=\"#f3a712\"][b]even[/b][/color] antes" },
    ["j_aij_atemporal_taco"] = { name = "Atemporal Taco", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#ff007f\"][b]self-destruct[/b][/color] at end of round,\n[color=\"#f3a712\"][b]-#3# Ante[/b][/color] when [color=\"#ff007f\"][b]destroyed[/b][/color]" },
    ["j_aij_atom"] = { name = "Atom", text = "Levels up [color=\"#f3a712\"][b]High Card[/b][/color] if played hand is a single [color=\"#f3a712\"][b]Ace[/b][/color]" },
    ["j_aij_audiophile"] = { name = "Audiophile", text = "" },
    ["j_aij_autogenes"] = { name = "Autogenes", text = "After [color=\"#f3a712\"][b]drawing[/b][/color] a new hand, you will be presented with [color=\"#f3a712\"][b]#1#[/b][/color] random cards from your [color=\"#f3a712\"][b]remaining[/b][/color] deck\nChoose [color=\"#f3a712\"][b]#2#[/b][/color] to draw to your hand" },
    ["j_aij_autograph"] = { name = "Autograph", text = "" },
    ["j_aij_average_joe"] = { name = "Average Joe", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#f3a712\"][b]#1#%[/b][/color] of [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color]" },
    ["j_aij_bad_apple"] = { name = "Bad Apple", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult if [color=\"#f3a712\"][b]scored hand[/b][/color] contains [color=\"#f3a712\"][b]#4#[/b][/color] [color=\"#e5e5e5\"][b]Dark[/b][/color] suits and [color=\"#f3a712\"][b]#3#[/b][/color] [color=\"#c23447\"][b]Light[/b][/color] suits\n[color=\"#9a9a9a\"](Proportion changes at end of round)[/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_bad_guy"] = { name = "Bad Guy", text = "Apply [color=\"#f3a712\"][b]Luna[/b][/color] to a random card [color=\"#f3a712\"][b]held in hand[/b][/color] when [color=\"#f3a712\"][b]Blind[/b][/color] is defeated" },
    ["j_aij_bad_sun"] = { name = "Bad Sun", text = "If [color=\"#f3a712\"][b]played[/b][/color] hand contains [color=\"#f3a712\"][b]#1#[/b][/color] or more [color=\"#c23447\"][b]Hearts[/b][/color], destroy a [color=\"#f3a712\"][b]random[/b][/color] played card" },
    ["j_aij_baddata"] = { name = "BAD_DATA", text = "" },
    ["j_aij_balance"] = { name = "Balance", text = "" },
    ["j_aij_banana_man"] = { name = "Banana Man", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all other Jokers\nEach Joker has a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to be [color=\"#ff007f\"][b]destroyed[/b][/color] after each hand" },
    ["j_aij_barcode"] = { name = "Barcode", text = "[color=\"#f3a712\"][b]Packs[/b][/color] are [color=\"#f3a712\"][b]#1#%[/b][/color] less expensive" },
    ["j_aij_baroque_joker"] = { name = "Baroque Joker", text = "This Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult if played hand [color=\"#f3a712\"][b]contains[/b][/color] but is [color=\"#f3a712\"][b]not[/b][/color] [color=\"#f3a712\"][b]scored as[/b][/color] the last played hand\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_bartender"] = { name = "Bartender", text = "Apply [color=\"#5d5dff\"][b]Luna[/b][/color], [color=\"#5d5dff\"][b]Holo[/b][/color], or [color=\"#5d5dff\"][b]Chroma[/b][/color] to a random held [color=\"#f3a712\"][b]consumable[/b][/color] when leaving the [color=\"#f3a712\"][b]Shop[/b][/color]" },
