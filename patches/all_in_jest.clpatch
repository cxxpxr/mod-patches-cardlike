          c:punch()
        end
      end
      joker:punch()
    end,
  },
}

add {
  key = 'croupier',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 23, y = 12 },
  blueprint_compat = false,
  config = { mod_money = 10 },
  vars = function(card) return { AIJ.val(card, 'croupier', 'mod_money') } end,
  dollarsAtRoundEnd = function(joker, state)
    local target = state.blind and tonumber(state.blind.target) or nil
    if target and (tonumber(state.score) or 0) > target * 2 then return AIJ.num(joker, 'mod_money') end
    return 0
  end,
}

AIJ.onNewRun(function(run) run.crypto_trader_mults = {} end)
cardlike.on('onRoundStart', function() AIJ.run.crypto_trader_mults = {} end)

cardlike.filter('cashOut', function(total)
  local mults = AIJ.run.crypto_trader_mults
  if type(mults) ~= 'table' or #mults == 0 or type(total) ~= 'number' then return nil end
  AIJ.run.crypto_trader_mults = {}
  local state = cardlike.state
  if not state or state.deck == 'Grass Deck' then return nil end
  local cap = 25
  if state:hasTicket('ticket_21') then cap = 100 elseif state:hasTicket('ticket_20') then cap = 50 end
  local base = math.floor(math.min(cap, math.max(0, tonumber(state.money) or 0)) / 5 + 0.5)
  local interest = math.min(total, base * (1 + (state:countJoker(AIJ.vanilla('j_to_the_moon')) or 0)))
  if interest <= 0 then return nil end
  local prod = 1
  for _, m in ipairs(mults) do prod = prod * (tonumber(m) or 1) end
  return total - interest + interest * prod
end)

