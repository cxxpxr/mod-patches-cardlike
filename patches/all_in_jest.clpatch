    return 'When any ' .. colorize(bold('Joker'), colors.ORANGE) .. ' is sold or destroyed, create a random '
      .. colorize(bold('Game card'), AIJ.colors.TAROT) .. '\n' .. colorize('(Must have room)', colors.GREY)
  end,
}
if FUNNY_BONE then
  AIJ.onJokerGone(function(state, info, sold)
    for _, j in ipairs(owned(state, FUNNY_BONE)) do
      if (state.freeConsumableSlots or 0) > 0 and cardlike.createConsumable('game') then
        j:popup('+1 Game card', AIJ.colors.TAROT)
      end
    end
  end)
end

local function countCommons(state)
  local n = 0
  for _, j in ipairs(ofList(state, 'jokers')) do
    if rarityOf(j) == 'Common' then n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'funny_bunch',
  rarity = 2, cost = 6, lite = true, atlas = 'joker_atlas', pos = { x = 19, y = 22 },
  config = { xmult_mod = 0.5 },
  vars = function(card)
    local m = AIJ.val(card, 'funny_bunch', 'xmult_mod')
    local n = cardlike.state and countCommons(cardlike.state) or 0
    return { m, 1 + n * m }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = countCommons(state)
      if n > 0 then result:add(xMult(1 + n * AIJ.num(joker, 'xmult_mod'))) end
    end,
  },
}

AIJ.addJoker {
