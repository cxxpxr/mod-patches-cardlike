    ["j_aij_candy_floss"] = { name = "Candy Floss", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#f3a712\"][b]#1#%[/b][/color] of [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color], decreases by [color=\"#f3a712\"][b]#2#%[/b][/color] at end of round" },
    ["j_aij_candy_wrapper"] = { name = "Candy Wrapper", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]$1[/b][/color] of [color=\"#f3a712\"][b]sell value[/b][/color] of all held [color=\"#f3a712\"][b]consumables[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
