local function pompeyX(card, state)
  local x = AIJ.val(card, 'pompey', 'xmult')
  local i = card and AIJ.safe(card.getIndex, card)
  if not i or not state or not inJokers(card) then return x end
  return math.max(x, (#(state.jokers or {}) - i + 1) * x)
end

