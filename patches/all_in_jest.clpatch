local function countRank(state, rank)
  local n = 0
  for _, c in ipairs((state and state.allCards) or {}) do
    if not AIJ.noRank(c) and c:getRank() == rank then n = n + 1 end
  end
  return n
end

add {
  key = 'buzzy_bee',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 45 },
  config = { chips = 10 },
  vars = function(card)
    local per = AIJ.val(card, 'buzzy_bee', 'chips')
    return { per, card and per * countRank(cardlike.state, 6) or 0 }
  end,
  triggers = {
    onScoreInHand = function(joker, state, step, result)
      local c = step.card
      if not c or AIJ.noRank(c) or c:getRank() ~= 6 then return end
      if AIJ.isDebuffed(c) then return result:say('Debuffed', colors.RED, c) end
      local n = AIJ.num(joker, 'chips') * countRank(state, 6)
      if n > 0 then result:add(plusChips(n)) end
    end,
  },
}

