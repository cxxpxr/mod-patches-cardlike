local function idSet(portList, vanillaList)
  local set = {}
  for k in portList:gmatch('%S+') do set[AIJ.id(k)] = true end
  for k in vanillaList:gmatch('%S+') do
    local v = AIJ.V.joker[k]
    if v then set[v] = true end
  end
  return set
end
local MULT_SET = idSet(MULT_JOKERS, VANILLA_MULT)
local CHIP_SET = idSet(CHIP_JOKERS, VANILLA_CHIPS)

AIJ.addJoker {
  key = 'big_red',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 24, y = 4 },
  config = { mult = 40 },
  vars = function(card) return { AIJ.val(card, 'big_red', 'mult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result) result:add(plusMult(AIJ.num(joker, 'mult'))) end,
  },
}

cardlike.filter('jokerPool', function(ids)
  local state = cardlike.state
  if not state or state.money == nil then return nil end
  local red, blue = AIJ.owns('big_red', state), AIJ.owns('little_boy_blue', state)
  if not red and not blue then return nil end
  local keep = {}
  for _, id in ipairs(ids) do
    local ok
    if red and blue then ok = MULT_SET[id] or CHIP_SET[id]
    elseif red then ok = MULT_SET[id]
    else ok = CHIP_SET[id] end
    if ok then keep[#keep + 1] = id end
  end
  if #keep > 0 and #keep < #ids then return keep end
end)

local function hasPaperback(state)
  for _, c in ipairs((state and state.allCards) or {}) do
    if AIJ.hasEnhancement(c, 'm_lucky') then return true end
  end
  return false
end

AIJ.addJoker {
  key = 'bingo_card',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 22, y = 11 },
  config = { odds = 6, odds2 = 4, xmult = 2 },
  vars = function(card)
    local id = 'bingo_card'
    return { AIJ.prob(), AIJ.val(card, id, 'odds'), AIJ.prob(), AIJ.val(card, id, 'odds2'), AIJ.val(card, id, 'xmult') }
  end,
  in_pool = hasPaperback,
  triggers = {
    repeatCard = function(joker, state, step, result)
      if AIJ.hasEnhancement(step.card, 'm_lucky') and state:chance(1 / AIJ.num(joker, 'odds2')) then
        result:say('Again!', colors.ORANGE)
        return 1
      end
    end,
    onScore = function(joker, state, step, result)
      if AIJ.hasEnhancement(step.card, 'm_lucky') and state:chance(1 / AIJ.num(joker, 'odds')) then
        result:add(xMult(AIJ.num(joker, 'xmult')))
      end
    end,
  },
}

AIJ.addJoker {
  key = 'bingsu',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 10, y = 45 },
  config = { chips = 50, chip_loss = 1, odds = 3 },
  vars = function(card)
    local id = 'bingsu'
    return { AIJ.val(card, id, 'chips'), AIJ.val(card, id, 'chip_loss'), AIJ.prob(), AIJ.val(card, id, 'odds') }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local yield = AIJ.num(joker, 'chips')
      if yield > 0 then result:add(plusChips(yield)) end
      if step.copiedBy or AIJ.get(joker, 'eaten') then return end
      if state:chance(1 / AIJ.num(joker, 'odds')) then
        local loss = AIJ.num(joker, 'chip_loss')
        local left = AIJ.add(joker, 'chips', -loss)
        if left <= 0 then
          AIJ.set(joker, 'eaten', true)
          result:say('Eaten!', colors.CHIPS)
          result:destroySelf()
        else
          result:say('-' .. AIJ.fmt(loss) .. ' Points', colors.CHIPS)
        end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'birthday_clown',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 2, y = 0 },
  config = { xmult = 3, active = true },
  vars = function(card)
    local active = AIJ.val(card, 'birthday_clown', 'active')
    return { AIJ.val(card, 'birthday_clown', 'xmult'), '(' .. (active and AIJ.msg('k_active', 'Active') or AIJ.msg('k_inactive', 'Inactive')) .. ')' }
  end,
  triggers = {
    onAnteChanged = function(joker, state, step, result)
      if not step.copiedBy and (step.delta or 1) ~= 0 then AIJ.set(joker, 'active', true) end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      if AIJ.get(joker, 'active') then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
    afterRound = function(joker, state, step, result)
      if not step.copiedBy and AIJ.get(joker, 'active') then
        AIJ.set(joker, 'active', false)
        result:say(AIJ.msg('k_inactive', 'Inactive'), colors.GREY)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'bit_flip',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 14, y = 44 },
  config = { odds = 2, score_mod = 1 },
  vars = function(card)
    return { AIJ.prob(), AIJ.val(card, 'bit_flip', 'odds'), AIJ.val(card, 'bit_flip', 'score_mod') }
  end,
  triggers = {
    finalScoring = function(joker, state, step, result)
      local mult = state.currentMult or 0
      if mult <= 0 then return end
      local total = math.floor((state.score or 0) + (state.currentChips or 0) * mult)
      if total <= 0 or total >= 1e15 then return end
      local digits = {}
      for d in string.format('%.0f', total):gmatch('%d') do digits[#digits + 1] = tonumber(d) end
      local odds, add = AIJ.num(joker, 'odds'), AIJ.num(joker, 'score_mod')
      for k = 1, #digits do
        if state:chance(1 / odds) then digits[k] = digits[k] + add end
        if k ~= 1 then
          while digits[k] >= 10 do
            digits[k - 1] = digits[k - 1] + 1
            digits[k] = digits[k] - 10
          end
        end
      end
      local s = ''
      for _, d in ipairs(digits) do s = s .. tostring(d) end
      local diff = (tonumber(s) or total) - total
      if diff > 0 then
        result:add(plusChips(diff / mult))
        result:say('+' .. AIJ.fmt(diff) .. ' Score', PLASMA)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'bizco',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 1, y = 12 }, soul_pos = { x = 1, y = 13 },
  config = { extra_scoring_cards = 5 },
  vars = function(card) return { AIJ.val(card, 'bizco', 'extra_scoring_cards') } end,
  blueprint_compat = false,
  triggers = {
    onScoreInHand = function(joker, state, step, result)
      if step.copiedBy then return end
      local c = step.card
      local idx = AIJ.safe(c.getIndex, c)
      if not idx or idx > AIJ.num(joker, 'extra_scoring_cards') or AIJ.isDebuffed(c) then return end
      local ev = c:getEvaluation(false) or {}
      if (ev.points or 0) ~= 0 then result:add(plusChips(ev.points)) end
      for _, b in ipairs(ev.bonuses or {}) do result:add(b) end
      for _, b in ipairs(type(ev.edition) == 'table' and ev.edition or {}) do result:add(b) end
      local pm, px = AIJ.perma(c, 'mult'), AIJ.perma(c, 'x_mult')
      if pm ~= 0 then result:add(plusMult(pm)) end
      if px ~= 0 then result:add(xMult(1 + px)) end
      c:punch()
    end,
  },
}

local function blacklightSync(joker, state)
  if not state or not state.ante then return end
  local want = (state.ante % 2 == 0) and AIJ.num(joker, 'hand_size') or 0
  local have = AIJ.num(joker, 'applied')
  if want ~= have then
    state.handSize = state.handSize + (want - have)
    AIJ.set(joker, 'applied', want)
  end
end

AIJ.addJoker {
  key = 'blacklight',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 18, y = 21 },
  config = { hand_size = 3, applied = 0 },
  vars = function(card)
    local s = cardlike.state
    local now = (s and s.ante and s.ante % 2 == 0) and AIJ.val(card, 'blacklight', 'hand_size') or 0
    return { AIJ.val(card, 'blacklight', 'hand_size'), now }
  end,
  blueprint_compat = false,
  onAdded = function(joker, state) AIJ.set(joker, 'applied', 0) blacklightSync(joker, state) end,
  onRemoved = function(joker, state)
    state.handSize = state.handSize - AIJ.num(joker, 'applied')
    AIJ.set(joker, 'applied', 0)
  end,
  triggers = {
    onAnteChanged = function(joker, state, step, result) if not step.copiedBy then blacklightSync(joker, state) end end,
    onRoundStart = function(joker, state, step, result) if not step.copiedBy then blacklightSync(joker, state) end end,
    onShopEnter = function(joker, state, step, result) if not step.copiedBy then blacklightSync(joker, state) end end,
  },
}

AIJ.addJoker {
  key = 'blacklist',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 22, y = 12 },
  config = { banned_cards = {} },
  description = function(r)
    local e = AIJ.loc('Joker', 'j_aij_blacklist') or {}
    local text = e.text or ''
    local list = (r and r.card) and AIJ.get(r.card, 'banned_cards', {}) or {}
    if type(list) ~= 'table' or #list == 0 then
      return text .. '\n' .. colorize(bold(AIJ.msg('k_aij_blacklist_empty', 'None')), colors.RED)
    end
    local names = {}
    for i = #list, 1, -1 do
      if #names >= 10 then
        names[#names + 1] = AIJ.msg('k_aij_blacklist_and', 'And') .. ' ' .. colorize(bold(tostring(#list - 10)), colors.ORANGE)
          .. ' ' .. AIJ.msg('k_aij_blacklist_more', 'more') .. '...'
        break
      end
      local info = cardlike.contentInfo('joker', list[i])
      names[#names + 1] = colorize(bold(info and info.name or tostring(list[i])), colors.ORANGE)
    end
    return text .. '\n' .. table.concat(names, '\n')
  end,
  blueprint_compat = false,
  triggers = {
    onCardSold = function(joker, state, step, result)
      if step.copiedBy or not step.card then return end
      local info = step.card.lastInfo or {}
      if info.kind ~= 'joker' or not info.joker then return end
      local list = AIJ.copy(AIJ.get(joker, 'banned_cards', {}))
      if type(list) ~= 'table' then list = {} end
      list[#list + 1] = info.joker
      AIJ.set(joker, 'banned_cards', list)
    end,
  },
}

cardlike.filter('jokerPool', function(ids)
  local lists = owned('blacklist')
  if #lists == 0 then return nil end
  local banned = {}
  for _, j in ipairs(lists) do
    for _, id in ipairs(AIJ.get(j, 'banned_cards', {}) or {}) do banned[id] = true end
  end
  local keep = {}
  for _, id in ipairs(ids) do if not banned[id] then keep[#keep + 1] = id end end
  if #keep < #ids then return keep end
end)

local blank = { kind = nil, copying = false, made = {} }
cardlike.on('onPackOpened', function(state, step) blank.kind = packKind(step.card) end)

AIJ.addJoker {
  key = 'blank_card', lite = true,
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 5, y = 1 },
  config = {},
  triggers = {
    onCardsAdded = function(joker, state, step, result)
      if blank.copying or blank.kind ~= 'deck' or not state:isPhase('pack') then return end
      local c = (step.cards or {})[1]
      if not c or blank.made[c.uid] or (c.lastInfo or {}).kind ~= 'playing' then return end
      blank.copying = true
      local copy = AIJ.safe(c.copy, c, 'deck')
      blank.copying = false
      if copy and copy.uid then blank.made[copy.uid] = true end
      if copy then result:say('Copied!', colors.CHIPS) end
    end,
  },
}

AIJ.addJoker {
  key = 'blarney_stone',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 21, y = 6 },
  config = {},
  vars = function(card)
    local s = cardlike.state
    return { firstDigit(s and s.score or 0) * 3 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = firstDigit(state.score or 0) * 3
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
  key = 'blemmya',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 8, y = 23 },
  config = {},
  blueprint_compat = false,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      local cards = step.hand.allCards or {}
      if #cards % 2 ~= 1 then return end
      local mid = cards[math.ceil(#cards / 2)]
      if not AIJ.exists(mid) then return end
      mid:setRank(AIJ.pick({ 11, 12, 13 }, state))
      result:say(AIJ.msg('k_aij_change_ex', 'Change!'), colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
  key = 'blind_drawn', lite = true,
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 20, y = 4 },
  config = { Xmult = 3 },
  description = function(r)
    return colorize(bold('X' .. AIJ.fmt(AIJ.val(r and r.card, 'blind_drawn', 'Xmult'))), colors.MULT) .. ' Mult'
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result) result:add(xMult(AIJ.num(joker, 'Xmult'))) end,
  },
}


== file jokers/batch02.lua (1665 lines)
local AIJ = cardlike.require('lib.aij')

local ORANGE, MULT, CHIPS, MONEY, GREEN, GREY = colors.ORANGE, colors.MULT, colors.CHIPS, colors.MONEY, colors.GREEN, colors.GREY
local function hi(t, col) return colorize(bold(tostring(t)), col or ORANGE) end
local function grey(t) return colorize(t, GREY) end

local add = AIJ.addJoker
local function jokerDef(id)
  if not id then return nil end
  return AIJ.jokerDefs[AIJ.id(id)]
end

local function active(state, id)
  local out = {}
  for _, j in ipairs((state and state.jokers) or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function uidSet(list)
  local s = {}
  for _, c in ipairs(list or {}) do s[c.uid] = true end
  return s
end

local function rarityOf(card)
  return (card and card.lastInfo and card.lastInfo.rarity) or (card and AIJ.safe(card.getRarity, card))
end

local function enhIs(e, id)
  if not e then return false end
  local v = AIJ.vanilla(id)
  if v then return e == v end
  return AIJ.isId(e, id)
end

local function deckHas(state, pred)
  for _, c in ipairs((state and state.allCards) or {}) do
    if pred(c) then return true end
  end
  return false
end

local function chippedInDeck(state)
  return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'm_bonus') end)
end

local okA, A = pcall(cardlike.require, 'items.astrals')
local function balance(state, result, pct)
  if not (okA and type(A) == 'table' and A.balance) then return end
  pct = math.min(pct, 1)
  if pct <= 0 then return end
  A.balance(state, pct)
  result:say(AIJ.fmt(pct * 100) .. '% Balanced', AIJ.colors.PLASMA)
end

local RARITY_WEIGHT = { Common = 0.70, Uncommon = 0.25, Rare = 0.05 }
local function rollRarity(state)
  local x = state:randomFloat()
  if x < 0.70 then return 'Common' elseif x < 0.95 then return 'Uncommon' end
  return 'Rare'
end

local reroll = { n = -1, price = nil, paid = 0 }
cardlike.on('onShopEnter', function(state)
  reroll = { n = state.rerollsThisShop or 0, price = state.rerollCost, paid = 0 }
end)
local function rerollPaid(state, step)
  local n = state.rerollsThisShop
  if n ~= nil and n == reroll.n then return reroll.paid end
  local paid = reroll.price
  if paid == nil then paid = math.max(0, (tonumber(step and step.cost) or 1) - 1) end
  reroll = { n = n, price = (step and step.cost) or state.rerollCost, paid = paid }
  return paid
end
cardlike.on('onShopReroll', function(state, step) rerollPaid(state, step) end)

local KEY_ROCK_TAKEN = 'aij_chipped_taken'
local ROCK_POINTS = 100

local function storeNum(card, key)
  return tonumber(AIJ.safe(function() return card:getDataStore():get(key) end)) or 0
end

cardlike.filter('cardBonuses', function(list, card, held)
  if held or not card then return nil end
  local taken = storeNum(card, KEY_ROCK_TAKEN)
  if taken <= 0 or not AIJ.hasEnhancement(card, 'm_stone') then return nil end
  local out = AIJ.copy(list or {})
  out[#out + 1] = plusChips(-math.min(taken, ROCK_POINTS))
  return out
end)

local enhCache = {}
local enhListeners = {}
local function onEnhanced(fn) enhListeners[#enhListeners + 1] = fn end
local function primeEnh(card)
  if type(card) ~= 'table' or not card.uid then return end
  local info = card.lastInfo or {}
  if info.kind ~= nil and info.kind ~= 'playing' then return end
  enhCache[card.uid] = AIJ.enhancement(card) or false
end
cardlike.on('onRunStart', function() enhCache = {} end)
cardlike.on('beforeRound', function(state)
  enhCache = {}
  for _, c in ipairs((state and state.allCards) or {}) do primeEnh(c) end
end)
cardlike.on('onCardSelected', function(state, step) primeEnh(step and step.card) end)
cardlike.on('onHandDrawn', function(state)
  for _, c in ipairs((state and state.cardsInHand) or {}) do primeEnh(c) end
end)
cardlike.on('onCardsAdded', function(state, step)
  for _, c in ipairs((step and step.cards) or {}) do primeEnh(c) end
end)
cardlike.on('onCardChanged', function(state, step, result)
  local c = step and step.card
  if type(c) ~= 'table' or not c.uid then return end
  local info = c.lastInfo or {}
  if info.kind ~= 'playing' then return end
  if not (AIJ.owns('blueberries', state) or AIJ.owns('chocolate_coins', state) or AIJ.owns('borra', state)) then
    enhCache[c.uid] = nil
    return
  end
  local now = AIJ.enhancement(c) or false
  local old = enhCache[c.uid]
  enhCache[c.uid] = now
  if old == nil or old == now then return end
  for _, fn in ipairs(enhListeners) do pcall(fn, state, c, old, now, result) end
end)

local function eaten(result, colour)
  result:say('Eaten!', colour or ORANGE)
  result:destroySelf()
end

local ABILITY_JOKERS = { 'a_v_g_m', 'farceur', 'gopnik', 'graffiti', 'joker_png', 'lawfirm', 'office_assistant',
  'pencil_drawing', 'the_bell' }

add {
  key = 'blue_eyes_white_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 8, y = 11 },
  config = { retriggers = 1 },
  vars = function(card) return { AIJ.val(card, 'blue_eyes_white_joker', 'retriggers') } end,
  triggers = {
    afterHand = function(joker, state, step, result)
      local all = step.hand and step.hand.allCards or {}
      if state.handsLeft ~= 0 or #all ~= 1 then return end
      local c = all[1]
      if not AIJ.exists(c) then return end
      AIJ.permaAdd(c, 'reps', AIJ.num(joker, 'retriggers'))
      result:say('Upgrade!', ORANGE, c)
    end,
  },
}

add {
  key = 'blue_star',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 4, y = 22 },
  config = { odds = 2 },
  description = function(r)
    local c = r and r.card
    return hi(AIJ.fmt(AIJ.prob()) .. ' in ' .. AIJ.fmt(AIJ.val(c, 'blue_star', 'odds')), GREEN) .. ' chance to '
      .. hi('level up') .. ' played poker hand if it contains a ' .. hi('Chipped') .. ' or ' .. hi('Fervent') .. ' card'
  end,
  in_pool = function(state)
    return deckHas(state, function(c) return AIJ.hasEnhancement(c, 'm_bonus') or AIJ.hasEnhancement(c, 'fervent') end)
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local hit = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if AIJ.hasEnhancement(c, 'm_bonus') or AIJ.hasEnhancement(c, 'fervent') then hit = true break end
      end
      if hit and state:chance(1 / AIJ.num(joker, 'odds')) then
        state:upgradeHand(step.hand.handType, 1)
        result:say('Level Up!', ORANGE)
      end
    end,
  },
}

add {
  key = 'blueberries',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 30 },
  config = { xmult_minus_mod = 0.1, xmult_mod = 0.5, xmult = 0 },
  vars = function(card)
    return { AIJ.val(card, 'blueberries', 'xmult_mod'), AIJ.val(card, 'blueberries', 'xmult_minus_mod'),
      1 + AIJ.val(card, 'blueberries', 'xmult') }
  end,
  onAdded = function(joker, state)
    if AIJ.has('magus', 'consumable') and (state.freeConsumableSlots or 0) > 0 then
      cardlike.createConsumable(AIJ.id('magus'))
    end
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or step.firstTime ~= false then return end
      local x = 1 + AIJ.num(joker, 'xmult')
      if x - AIJ.num(joker, 'xmult_minus_mod') <= 1 then return eaten(result) end
      AIJ.add(joker, 'xmult', -AIJ.num(joker, 'xmult_minus_mod'))
      result:say('-X' .. AIJ.fmt(AIJ.num(joker, 'xmult_minus_mod')) .. ' Mult', MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}
onEnhanced(function(state, card, old, new)
  if not enhIs(new, 'fervent') then return end
  for _, j in ipairs(active(state, 'blueberries')) do
    AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
    j:popup('Upgrade!', MULT)
  end
end)

