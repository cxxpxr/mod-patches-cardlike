  'j_popcorn', 'j_trousers', 'j_ancient', 'j_ramen', 'j_walkie_talkie', 'j_flash', 'j_smiley', 'j_swashbuckler',
  'j_acrobat', 'j_throwback', 'j_bloodstone', 'j_onyx_agate', 'j_glass', 'j_flower_pot', 'j_seeing_double', 'j_duo',
  'j_trio', 'j_family', 'j_order', 'j_tribe', 'j_shoot_the_moon', 'j_drivers_license', 'j_bootstraps', 'j_caino',
  'j_triboulet', 'j_yorick', 'j_idol', 'j_hit_the_road', 'j_space', 'j_burnt' }) do
  local v = AIJ.vanilla(k)
  if v then MULT[v] = true end
end

local FOOD_KEYS = { 'atemporal_taco', 'banana_man', 'bingsu', 'blueberries', 'candy_floss', 'cheerio', 'cheese_squigglies',
  'chips_n_dip', 'chocolate_coins', 'coffee_thermos', 'corndog', 'dog_treat', 'double_sundae_1', 'double_sundae_2',
  'double_sundae_3', 'egg_cc', 'fish_fingers', 'fortune_cookie', 'gelato', 'jawbreaker', 'liquorice', 'omlette', 'parfait',
  'peanut_brittle', 'phoney_baloney', 'pretzel_sticks', 'saveloy', 'scroggin', 'silly_sausage', 'soft_serve',
  'stargazy_pie', 'stracciatella', 'sundae_1', 'sundae_2', 'sundae_3', 'sunny_side', 'tortilla_chips', 'totally_nuts',
  'triple_gooberberry_sunrise', 'triple_sundae', 'turrn' }
local function isFood(id)
  if AIJ.inPool('Food', id) then return true end
  for _, k in ipairs(FOOD_KEYS) do if AIJ.isId(id, k) then return true end end
  return false
end

local CHIP_MOONS = {}
for _, k in ipairs({ '2000_eu16', '2013_nd15', 'callisto', 'charon', 'deimos', 'iapetus', 'kamooalewa', 'kuiper', 'nibiru',
  'oberon', 'phaethon', 'proteus' }) do CHIP_MOONS[AIJ.id(k)] = true end

local function sweep(cards, state, bad, replace)
  for _, c in ipairs(cards or {}) do
    if (c.lastInfo or {}).kind == 'joker' then
      local id = AIJ.defId(c)
      if id and bad(id, c) then
        local new = replace(state)
        if new and new ~= id then AIJ.safe(c.setJokerDef, c, new) end
      end
    end
  end
end

local sweeps = {}
local function runSweeps(state, cards)
  for key, s in pairs(sweeps) do
    if active(state, key) then sweep(cards, state, s.bad, s.replace) end
  end
end
cardlike.on('onShopEnter', function() H.later(function() local s = cardlike.state if s then runSweeps(s, s.shopCards) end end) end)
cardlike.on('onShopReroll', function(state) runSweeps(state, state.shopCards) end)
cardlike.on('onPackOpened', function() H.later(function() local s = cardlike.state if s then runSweeps(s, cardlike.cards('pack')) end end) end)

cardlike.filter('jokerPool', function(ids)
  local state = cardlike.state
  if not state or not state.challenge then return nil end
  local keep
  if active(state, 'full_plate') then keep = function(id) return isFood(id) end
  elseif active(state, 'mircotransactions') then keep = function(id) return not MULT[id] end
  else return nil end
  local out = {}
  for _, id in ipairs(ids) do if keep(id) then out[#out + 1] = id end end
  return out
end)

local BUILTIN_PACKS = {}
for _, kind in ipairs({ 'game', 'fruit', 'fool', 'admin' }) do
  for level = 0, 2 do BUILTIN_PACKS[#BUILTIN_PACKS + 1] = H.builtinPack(kind, level) end
end

do
  local banned = { J('null_joker'), J('mistake'), J('anchor'), J('guess_the_jest') }
  for _, p in ipairs(BUILTIN_PACKS) do banned[#banned + 1] = p end
  addChallenge {
    id = 'bananarama', color = '#f3d112',
    rules = { 'Game, Fruit, Fool, Admin and Guess the Jest packs never appear' },
    jokers = { { id = J('banana_man'), locked = true, edition = 'Inverted' }, { id = V('j_oops'), locked = true, edition = 'Inverted' } },
    tickets = { V('v_magic_trick'), V('v_illusion') },
    banned = banned,
  }
end

addChallenge { id = 'flip_flop', color = '#ff007f', rules = { rule('money_times_negative') } }
cardlike.on('onBlindDefeated', function(state)
  if active(state, 'flip_flop') then state:setMoneyDirect(-(state.money or 0)) end
end)

addChallenge { id = 'full_plate', color = '#1bb18c', rules = { rule('all_jokers_is_food') } }
sweeps.full_plate = {
  bad = function(id) return not isFood(id) end,
  replace = function() return V('j_egg') end,
}

addChallenge {
  id = 'micromanagement', color = '#9a9a9a',
  rules = { rule('all_jokers_perishable_1'), rule('all_jokers_perishable_2') },
  jokers = { { id = J('office_assistant'), locked = true, edition = 'Inverted' } },
}
cardlike.on('onCardCreated', function(state, step)
  local c = step.card
  if not active(state, 'micromanagement') or not c or (c.lastInfo or {}).kind ~= 'joker' then return end
  if AIJ.safe(c.getSticker, c) ~= 'none' then return end
  c:setSticker('timed')
  c:getDataStore():set('sticker_rounds', 2)
end)

do
  local banned = { J('glass_delusion'), J('gameshow'), J('cctv'), J('stained_glass_joker'), J('mummer'), J('tin_man'),
    J('lucky_seven'), J('wizard'), J('bartender'), J('colour_test'),
    V('c_empress'), V('c_chariot'), V('c_justice'), V('c_wheel_of_fortune'), J('typhon'), V('c_aura'), V('c_hex'),
    V('c_black_hole'), J('pulsar'), J('gegenschein') }
  if AIJ.setting('moons_enabled') then
    banned[#banned + 1] = J('astrologer')
    banned[#banned + 1] = J('sky_trees')
  else
    for _, k in ipairs({ 'c_high_priestess', 'v_planet_merchant', 'v_planet_tycoon' }) do banned[#banned + 1] = V(k) end
    banned[#banned + 1] = J('gravastar')
    for i = 0, 2 do banned[#banned + 1] = H.builtinPack('fruit', i) end
    for i = 0, 11 do banned[#banned + 1] = 'fruit_card_' .. i end
  end
  addChallenge {
    id = 'mircotransactions', color = '#f3a712',
    rules = { rule('no_mult_in_pool') },
    jokers = { J('gopnik'), J('farceur') },
    money = 15,
    banned = banned,
  }
end
sweeps.mircotransactions = {
  bad = function(id) return MULT[id] == true end,
  replace = function(state)
    if AIJ.has('simple_simon', 'joker') then return J('simple_simon') end
    return nil
  end,
}
cardlike.filter('consumablePool', function(ids, ctype)
  local state = cardlike.state
  if ctype ~= 'fruit' or not active(state, 'mircotransactions') or not AIJ.setting('moons_enabled') then return nil end
  local out = {}
  for _, id in ipairs(ids) do if CHIP_MOONS[id] then out[#out + 1] = id end end
  return out
end)
cardlike.filter('edition', function(picked)
  if not active(cardlike.state, 'mircotransactions') then return nil end
  if picked == 'Holo' or picked == 'Chroma' or AIJ.isId(picked, 'stellar') then return 'none' end
  return nil
end)

addChallenge { id = 'pandemonium', color = '#8f00ff', rules = { rule('pandemonium_1') } }
cardlike.filter('skipPin', function()
  if active(cardlike.state, 'pandemonium') and AIJ.has('chaos', 'pin') then return J('chaos') end
  return nil
end)

addChallenge {
  id = 'sharpest_tool', color = '#009dff',
  rules = { rule('sharpest_tool_1') .. ' ' .. rule('sharpest_tool_2'):gsub('Buffoon packs', 'Fool Packs') },
  jokers = { J('dim_bulb') },
  banned = { J('pace'), J('jesters_privelege'), V('tag_uncommon'), V('tag_rare'), J('unusual'), J('recherche') },
}
sweeps.sharpest_tool = {
  bad = function(id, c) return tostring(AIJ.safe(c.getRarity, c)) ~= 'Common' end,
  replace = function() return cardlike.randomJoker('Common') end,
}

addChallenge { id = 'the_pit', color = '#6a3b8f', rules = { rule('all_pit_blinds') } }
return { MULT = MULT, isFood = isFood }


