    local e = AIJ.loc('Joker', 'j_aij_requiem')
    return ((e and e.text) or ''):gsub('Buffoon', 'Fool')
  end)(),
}

cardlike.filter('price', function(price, card)
  if type(card) ~= 'table' or not active(st(), 'requiem') then return nil end
  local info = card.lastInfo or {}
  if info.kind == 'joker' then return 0 end
  if info.kind == 'pack' and tostring(info.consumable or ''):find('^pack_fool') then return 0 end
end)

AIJ.addJoker {
  key = 'richie_rich',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 5, y = 9 },
  config = { dollars = 0, xdollars = 0.1 },
  vars = function(card) return { AIJ.val(card, 'richie_rich', 'xdollars') + 1 } end,
  dollarsAtRoundEnd = function(joker, state)
    return math.floor(math.max(0, state.money or 0) * AIJ.num(joker, 'xdollars'))
  end,
}

local function heldCardAsPlayed(result, c)
  local ev = AIJ.safe(c.getEvaluation, c, false)
  if type(ev) ~= 'table' then return end
  if (ev.points or 0) ~= 0 then result:add(plusChips(ev.points)) end
  if not (AIJ.hasEnhancement(c, 'm_steel') or AIJ.hasEnhancement(c, 'm_gold')) then
    for _, b in ipairs(ev.bonuses or {}) do result:add(b) end
  end
  for _, b in ipairs(ev.edition or {}) do result:add(b) end
  result:say('10!', colors.ORANGE, c)
end

AIJ.addJoker {
  key = 'right_angle',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 12, y = 2 },
  description = 'When a ' .. colorize(bold('9'), colors.ORANGE) .. ' is scored, each '
    .. colorize(bold('10'), colors.ORANGE) .. ' held in hand also scores its '
    .. colorize(bold('Points'), colors.CHIPS) .. ', enhancement and edition',
  triggers = {
    onScore = function(joker, state, step, result)
      if rankOf(step.card) ~= 9 then return end
      for _, c in ipairs(state.cardsInHand or {}) do
        if rankOf(c) == 10 and not AIJ.isDebuffed(c) then heldCardAsPlayed(result, c) end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'rising_sun', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 18, y = 4 },
  config = { retriggers = 1 },
  triggers = {
    repeatCard = function(joker, state, step, result)
      if not firstOrLastHand(state) then return end
      local cards = step.hand.playedCards or {}
      if step.card == cards[1] or step.card == cards[#cards] then return AIJ.num(joker, 'retriggers') end
    end,
  },
}

local function totalLevels(state)
  local n = 0
  for _, t in ipairs(visibleHands(state)) do n = n + ((state.hands[t] or {}).level or 0) end
  return n
end

AIJ.addJoker {
  key = 'rock_n_roll_clown',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 23, y = 19 },
  config = { chips_per_level = 1 },
  vars = function(card)
    local per = AIJ.val(card, 'rock_n_roll_clown', 'chips_per_level')
    local s = st()
    return { per, (s and s.hands) and totalLevels(s) * per or 0 }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local n = totalLevels(state) * AIJ.num(joker, 'chips_per_level')
      if n > 0 then result:add(plusChips(n)) end
    end,
  },
}

AIJ.addJoker {
  key = 'rodeo_clown',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 16, y = 6 },
  config = { mult = 0, mult_mod = 5 },
  vars = function(card) return { AIJ.val(card, 'rodeo_clown', 'mult_mod'), AIJ.val(card, 'rodeo_clown', 'mult') } end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy or (state.handsLeft or 1) ~= 0 then return end
      AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
      result:say(upgradeText(), colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
  key = 'rubberhose', lite = true,
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 19, y = 20 },
  config = { mult = 10 },
  vars = function(card) return { AIJ.val(card, 'rubberhose', 'mult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local dark, light = 0, 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        if AIJ.isSuit(c, 'Spades', state) or AIJ.isSuit(c, 'Clubs', state) then dark = dark + 1 end
        if AIJ.isSuit(c, 'Hearts', state) or AIJ.isSuit(c, 'Diamonds', state) then light = light + 1 end
      end
      if (dark > 0 and light == 0) or (light > 0 and dark == 0) then
        result:add(plusMult(AIJ.num(joker, 'mult')))
      end
    end,
  },
}

local function deckHasStamp(state, key)
  return countCards(state and state.allCards, function(c) return AIJ.hasStamp(c, key) end) > 0
end

AIJ.addJoker {
  key = 'rudolph',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 19 },
  in_pool = function(state) return deckHasStamp(state, 'Red') end,
  triggers = {
    repeatCard = function(joker, state, step, result)
      local first = (step.hand.playedCards or {})[1]
      if first and step.card ~= first and AIJ.hasStamp(first, 'Red') then return 1 end
    end,
  },
}

local rummi = { pending = 0, panel = nil, suit = 4, rank = 14, enh = 1 }

local function rummiSuits()
  local out = {}
  for _, s in ipairs(AIJ.SUITS) do out[#out + 1] = { id = s, name = s } end
  for _, m in ipairs(cardlike.listContent('suit') or {}) do
    local dup = false
    for _, o in ipairs(out) do if o.id == m.id then dup = true end end
    if not dup and m.id then out[#out + 1] = { id = m.id, name = m.name or m.id } end
  end
  return out
end

local function rummiEnhancements()
  local out = { { id = nil, name = 'None' } }
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id and e.id ~= 'Default' then out[#out + 1] = { id = e.id, name = e.name or e.id } end
  end
  return out
end

local function names(list)
  local out = {}
  for i, v in ipairs(list) do out[i] = v.name end
  return out
end

local function openRummikub()
  if rummi.panel and rummi.panel.isOpen() then return end
  local ui = cardlike.ui
  local suits, enhs = rummiSuits(), rummiEnhancements()
  local ranks = {}
  for r = 2, 14 do ranks[#ranks + 1] = AIJ.rankName(r) end
  rummi.suit = math.min(rummi.suit, #suits)
  rummi.enh = math.min(rummi.enh, #enhs)
  local function done(create)
    if create and st() then
      cardlike.addPlayingCard({ rank = rummi.rank, suit = suits[rummi.suit].id, enhancement = enhs[rummi.enh].id }, { area = 'deck' })
    end
    rummi.pending = math.max(0, rummi.pending - 1)
    if rummi.panel then rummi.panel.close() end
    rummi.panel = nil
    if rummi.pending > 0 then openRummikub() end
  end
  rummi.panel = ui.open {
    modal = true,
    closeOnEscape = false,
    content = function()
      return ui.column { style = 'window', gap = 12, align = 'center',
        ui.text { text = 'Rummikub', size = 30, color = colors.ORANGE },
        ui.text { text = 'Create a playing card and add it to your deck', size = 18 },
        ui.text { text = ranks[rummi.rank - 1] .. ' of ' .. suits[rummi.suit].name
          .. (enhs[rummi.enh].id and (' (' .. enhs[rummi.enh].name .. ')') or ''), size = 22, color = colors.MONEY },
        ui.choice { label = 'Rank', options = ranks, value = rummi.rank - 1, width = 260, onChange = function(i) rummi.rank = i + 1 end },
        ui.choice { label = 'Suit', options = names(suits), value = rummi.suit, width = 260, onChange = function(i) rummi.suit = i end },
        ui.choice { label = 'Enhancement', options = names(enhs), value = rummi.enh, width = 260, onChange = function(i) rummi.enh = i end },
        ui.row { gap = 12,
          ui.button { label = 'Create', color = colors.GREEN, onPress = function() done(true) end },
          ui.button { label = 'Skip', color = colors.RED, onPress = function() done(false) end },
        },
      }
    end,
  }
end
cardlike.on('onRunStart', function() rummi.pending = 0 end)

AIJ.addJoker {
  key = 'rummikub',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 16, y = 0 },
  triggers = {
    onBlindDefeated = function(joker, state, step, result)
      if not (state.blind and state.blind.boss) then return end
      rummi.pending = rummi.pending + 1
      openRummikub()
    end,
  },
}


local salt = { active = false, rolls = {}, seen = {} }

cardlike.hook('SaveState.chance', {
  after = function(state, res, p)
    if not salt.active or res ~= true or type(p) ~= 'number' then return nil end
    local mult = (state and state.chanceMultiplier) or 1
    local chance = math.min(1, p * mult)
    if chance > 0 and chance < 1 then salt.rolls[#salt.rolls + 1] = 2 - chance end
    return nil
  end,
})
cardlike.on('beforeAllCardsScored', function() salt.active = true salt.rolls = {} salt.seen = {} end)
cardlike.on('afterHand', function() salt.active = false salt.rolls = {} salt.seen = {} end)
cardlike.on('onRoundStart', function() salt.active = false salt.rolls = {} salt.seen = {} end)

local function saltGive(joker, step, result)
  local key = tostring(joker.uid) .. ':' .. tostring(step.copiedBy and step.copiedBy.uid or '')
  local from = (salt.seen[key] or 0) + 1
  for i = from, #salt.rolls do result:add(xMult(salt.rolls[i])) end
  salt.seen[key] = #salt.rolls
end

AIJ.addJoker {
  key = 'saltimbanco',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 3, y = 4 },
  triggers = {
    onScore = function(joker, state, step, result) saltGive(joker, step, result) end,
    onScoreInHand = function(joker, state, step, result) saltGive(joker, step, result) end,
    afterAllCardsScored = function(joker, state, step, result) saltGive(joker, step, result) end,
    finalScoring = function(joker, state, step, result) saltGive(joker, step, result) end,
  },
}

local RARE_PACKS = {
  { id = 'rare_normal_1', w = 1.2 }, { id = 'rare_normal_2', w = 1.2 }, { id = 'rare_normal_3', w = 1.2 },
  { id = 'rare_jumbo_1', w = 0.6 }, { id = 'rare_jumbo_2', w = 0.6 }, { id = 'rare_mega_1', w = 0.15 },
}
local function randomRarePack(state)
  local have, total = {}, 0
  for _, p in ipairs(RARE_PACKS) do
    if AIJ.has(p.id, 'pack') then have[#have + 1] = p total = total + p.w end
  end
  if total <= 0 then return nil end
  local x = state:randomFloat() * total
  for _, p in ipairs(have) do
    x = x - p.w
    if x <= 0 then return AIJ.id(p.id) end
  end
  return AIJ.id(have[#have].id)
end
local function salutoPack(joker, state)
  local id = randomRarePack(state)
  if id and cardlike.addShopItem(id, { free = true }) then joker:punch() end
end

AIJ.addJoker {
  key = 'saluto',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 3, y = 14 }, soul_pos = { x = 3, y = 15 },
  blueprint_compat = false,
  onAdded = function(joker, state)
    if state and state:isPhase('shop') then salutoPack(joker, state) end
  end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if not step.copiedBy then salutoPack(joker, state) end
    end,
  },
}

AIJ.addJoker {
  key = 'sam_mcgee',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 11, y = 23 },
  config = { threshold = 5, gain = 1 },
  vars = function(card) return { AIJ.val(card, 'sam_mcgee', 'threshold'), AIJ.val(card, 'sam_mcgee', 'gain') } end,
  in_pool = function(state)
    return countCards(state and state.allCards, function(c) return AIJ.hasEnhancement(c, 'ice') end) > 0
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local extra = #(step.hand.allCards or {}) - AIJ.num(joker, 'threshold')
      if extra > 0 then result:add(xMult(1 + extra * AIJ.num(joker, 'gain'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'sanguine_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 19, y = 13 },
  config = { odds = 13 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'sanguine_joker', 'odds') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      if not AIJ.isSuit(step.card, 'Hearts', state) then return end
      if not state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) then return end
      local pin = cardlike.randomPin()
      if pin then
        cardlike.addPin(pin)
        result:say(AIJ.msg('aij_plus_tag', '+1 Pin'), colors.ORANGE)
      end
    end,
  },
}

local function deckQueens()
  return deckCount(function(c) return rankOf(c) == 12 end)
end

AIJ.addJoker {
  key = 'sapphic_joker',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 14, y = 41 },
  config = { chips = 3, mult = 1 },
  vars = function(card)
    local m, c, q = AIJ.val(card, 'sapphic_joker', 'mult'), AIJ.val(card, 'sapphic_joker', 'chips'), deckQueens()
    return { m, c, m * q, c * q }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if rankOf(step.card) ~= 12 then return end
      local q = countCards(state.allCards, function(c) return rankOf(c) == 12 end)
      if q <= 0 then return end
      result:add(plusChips(AIJ.num(joker, 'chips') * q))
      result:add(plusMult(AIJ.num(joker, 'mult') * q))
    end,
  },
}

AIJ.addJoker {
  key = 'saucy_jacky',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 7, y = 10 },
  config = { curr_mult = 0, mult_per_queen = 5 },
  vars = function(card) return { AIJ.val(card, 'saucy_jacky', 'curr_mult'), AIJ.val(card, 'saucy_jacky', 'mult_per_queen') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      local m = AIJ.num(joker, 'curr_mult')
      if rankOf(step.card) == 11 and m > 0 then result:add(plusMult(m)) end
    end,
    destroyCard = function(joker, state, step, result)
      if step.copiedBy or rankOf(step.card) ~= 12 then return end
      AIJ.add(joker, 'curr_mult', AIJ.num(joker, 'mult_per_queen'))
      result:say(upgradeText(), colors.MULT)
      return true
    end,
  },
}

AIJ.addJoker {
  key = 'saveloy',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 16, y = 43 },
  config = { mult = 20, mult_loss = 1 },
  vars = function(card) return { AIJ.val(card, 'saveloy', 'mult'), AIJ.val(card, 'saveloy', 'mult_loss') } end,
  triggers = {
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      local loss = AIJ.num(joker, 'mult_loss')
      local m = AIJ.add(joker, 'mult', -loss)
      if m <= 0 then
        result:say(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.MULT)
        result:destroySelf()
      else
        result:say('-' .. AIJ.fmt(loss) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.rerollMod(function(state)
  local off = 0
  if not (AIJ.owns('scapino', state) or AIJ.owns('silly_sausage', state)) then return 0 end
  for _, j in ipairs(state.jokers or {}) do
    if not AIJ.isDebuffed(j) then
      if AIJ.is(j, 'scapino') then off = off + AIJ.num(j, 'reroll_sale')
      elseif AIJ.is(j, 'silly_sausage') then off = off - AIJ.num(j, 'current_discount') end
    end
  end
  return off
end)

local NO_RESTOCK = { guess_the_jest = true, timelost_guess_the_jest = true, asteroid_tag_celestial = true, testing_booster = true }
local function restockPool()
  local out = {}
  for _, p in ipairs(cardlike.listContent('pack') or {}) do
    local short = AIJ.short(p.id)
    local mine = AIJ.isId(p.id, short) and p.id ~= short
    if p.id and not (mine and (NO_RESTOCK[short] or short:find('^rare_') or short:find('^common_'))) then
      out[#out + 1] = p.id
    end
  end
  return out
end

AIJ.addJoker {
  key = 'scapino',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 1, y = 4 },
  config = { reroll_sale = 5 },
  vars = function(card) return { AIJ.val(card, 'scapino', 'reroll_sale') } end,
  blueprint_compat = false,
  triggers = {
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      local packs = countCards(state.shopCards, function(c) return (c.lastInfo or {}).kind == 'pack' end)
      local want = (state.packsAvailableInShopCount or 2) - packs
      local pool = restockPool()
      for _ = 1, want do
        local id = AIJ.pick(pool, state)
        if id then cardlike.addShopItem(id) end
      end
    end,
  },
}

local WIN_ANTE = 8
local function scarabLock(joker, state)
  local lockedByMe = joker:getDataStore():get('lock') == true
  if state.ante == WIN_ANTE then
    if not joker:isLocked() then
      joker:setLocked(true)
      AIJ.set(joker, 'lock', true)
    end
  elseif lockedByMe then
    joker:setLocked(false)
    AIJ.set(joker, 'lock', false)
  end
end

AIJ.addJoker {
  key = 'scarab',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 21, y = 44 },
  config = { ante_mod = 1 },
  vars = function(card) return { AIJ.val(card, 'scarab', 'ante_mod') } end,
  blueprint_compat = false,
  in_pool = function(state) return not state or state.ante ~= WIN_ANTE + 1 end,
  onAdded = function(joker, state)
    if not state or not state.ante then return end
    local before = state.ante
    state.ante = math.max(1, before - AIJ.num(joker, 'ante_mod'))
    AIJ.set(joker, 'applied', before - (state.ante or before))
    scarabLock(joker, state)
  end,
  onRemoved = function(joker, state)
    if not state or not state.ante then return end
    state.ante = state.ante + AIJ.num(joker, 'applied')
  end,
  triggers = {
    onRoundStart = function(joker, state, step, result) if not step.copiedBy then scarabLock(joker, state) end end,
    onAnteChanged = function(joker, state, step, result) if not step.copiedBy then scarabLock(joker, state) end end,
    onShopEnter = function(joker, state, step, result) if not step.copiedBy then scarabLock(joker, state) end end,
  },
}

local function pickHand(state, except)
  local pool = {}
  for _, t in ipairs(visibleHands(state)) do
    if t ~= 'ROYAL_FLUSH' and t ~= except then pool[#pool + 1] = t end
  end
  return AIJ.pick(pool, state)
end

AIJ.addJoker {
  key = 'scaramouche',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 3 },
  config = { repetitions = 1 },
  vars = function(card)
    local h = card and card:getDataStore():get('hand')
    return { h and AIJ.handName(h) or 'random hand' }
  end,
  onAdded = function(joker, state)
    if state and state.hands and not joker:getDataStore():get('hand') then AIJ.set(joker, 'hand', pickHand(state)) end
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'hand', pickHand(state, joker:getDataStore():get('hand')))
      result:say(AIJ.msg('k_reset', 'Reset'), colors.ORANGE)
    end,
    repeatCard = function(joker, state, step, result)
      local h = joker:getDataStore():get('hand')
      if h and baseHand(step.hand.handType) == h then return AIJ.num(joker, 'repetitions') end
    end,
  },
}

local scary = { pending = 0, wait = 0 }

local function scaryRoll(state)
  local cards = state.packCards or {}
  local playing = {}
  for _, c in ipairs(cards) do if (c.lastInfo or {}).kind == 'playing' then playing[#playing + 1] = c end end
  if #cards == 0 then return false end
  for _, j in ipairs(activeJokers(state, 'scary_story')) do
    local odds = math.max(1, AIJ.num(j, 'chance'))
    for _, c in ipairs(playing) do
      if AIJ.edition(c) == nil and state:chance(1 / odds) then
        c:setEdition(AIJ.vanilla('e_negative'))
        c:punch()
        j:punch()
      end
    end
  end
  return true
end

AIJ.addJoker {
  key = 'scary_story',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 0, y = 1 },
  config = { chance = 3 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'scary_story', 'chance') } end,
  blueprint_compat = false,
}

cardlike.on('onPackOpened', function(state, step)
  if not active(state, 'scary_story') then return end
  if not scaryRoll(state) then scary.pending = 1 scary.wait = 0 end
end)
cardlike.onFrame(function(frame)
  if scary.pending == 0 then return end
  local state = st()
  scary.wait = scary.wait + (frame.dt or 0)
  if not frame.inRun or not state or scary.wait > 3 then scary.pending = 0 return end
  if state:isPhase('pack') and scaryRoll(state) then scary.pending = 0 end
end)

local function nextDeckCard(state)
  local deck = state and state.unDrawnCards
  if not deck or #deck == 0 then return nil end
  return deck[#deck]
end

AIJ.addJoker {
  key = 'scopaesthesia',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 5, y = 23 },
  config = { xmult = 1.5 },
  description = function(r)
    local e = AIJ.loc('Joker', 'j_aij_scopaesthesia')
    local text = AIJ.fill((e and e.text) or '', { AIJ.val(r and r.card, 'scopaesthesia', 'xmult') })
    local ok, c = pcall(nextDeckCard, st())
    if ok and c and r and r.card then
      local info = c.lastInfo or {}
      local what = info.noRank and 'a card with no rank' or (AIJ.rankName(info.rank) .. ' of ' .. tostring(info.suit))
      text = text .. '\n' .. colorize('(Next card: ', colors.GREY) .. colorize(bold(what), colors.ORANGE) .. colorize(')', colors.GREY)
    end
    return text
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      local nxt = nextDeckCard(state)
      local r = rankOf(step.card)
      if nxt and r and r == rankOf(nxt) then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'scorecard', lite = true,
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 15, y = 2 },
  config = { levels = 2 },
  vars = function(card) return { AIJ.val(card, 'scorecard', 'levels') } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      local hand = pickHand(state)
      if not hand then return end
      state:upgradeHand(hand, AIJ.num(joker, 'levels'))
      result:say(AIJ.msg('k_level_up_ex', 'Level Up!') .. ' ' .. AIJ.handName(hand), colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
  key = 'scott_free',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 12, y = 45 },
  config = { dollars = 2 },
  vars = function(card) return { AIJ.val(card, 'scott_free', 'dollars') } end,
  in_pool = function(state)
    return countCards(state and state.allCards, function(c) return AIJ.enhancement(c) ~= nil end) > 4
  end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if not step.copiedBy then AIJ.set(joker, 'held', 0) end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = 0
      for _, c in ipairs(state.cardsInHand or {}) do
        if AIJ.enhancement(c) == nil then
          if AIJ.isDebuffed(c) then
            result:say(AIJ.msg('k_debuffed', 'Debuffed'), colors.MULT, c)
          else
            n = n + 1
          end
        end
      end
      AIJ.set(joker, 'held', n)
    end,
  },
  dollarsAtRoundEnd = function(joker, state)
    return AIJ.num(joker, 'held') * AIJ.num(joker, 'dollars')
  end,
}

local enhCache = {}
local function remember(c) if type(c) == 'table' and c.uid then enhCache[c.uid] = AIJ.enhancement(c) or false end end
cardlike.on('onRunStart', function() enhCache = {} end)
cardlike.on('onCardSelected', function(state, step) remember(step.card) end)
cardlike.on('onHandDrawn', function(state)
  if not active(state, 'scroggin') then return end
  for _, c in ipairs(state.cardsInHand or {}) do remember(c) end
end)
cardlike.on('onCardsAdded', function(state, step) for _, c in ipairs(step.cards or {}) do remember(c) end end)
cardlike.on('onCardChanged', function(state, step)
  local c = step.card
  if type(c) ~= 'table' or (c.lastInfo or {}).kind ~= 'playing' then return end
  local old = enhCache[c.uid]
  remember(c)
  if old == nil or old == AIJ.vanilla('m_wild') or not AIJ.hasEnhancement(c, 'm_wild') then return end
  for _, j in ipairs(activeJokers(state, 'scroggin')) do
    AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
    j:popup('X' .. AIJ.fmt(1 + AIJ.num(j, 'xmult')) .. ' Mult', colors.MULT)
  end
end)

AIJ.addJoker {
  key = 'scroggin',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 16, y = 28 },
  config = { xmult_minus_mod = 0.25, xmult_mod = 0.5, xmult = 0, tarot = 'c_lovers' },
  description = function(r)
    local e = AIJ.loc('Joker', 'j_aij_scroggin')
    local c = r and r.card
    local text = AIJ.fill((e and e.text) or '', { AIJ.val(c, 'scroggin', 'xmult_mod'), AIJ.val(c, 'scroggin', 'xmult_minus_mod'),
      1 + AIJ.val(c, 'scroggin', 'xmult') })
    return (text:gsub('Wild', 'Plaid'))
  end,
  onAdded = function(joker, state)
    for _, c in ipairs((state and state.allCards) or {}) do remember(c) end
    if state and (state.freeConsumableSlots or 0) > 0 then
      local id = AIJ.vanilla(AIJ.get(joker, 'tarot', 'c_lovers'))
      if id then cardlike.createConsumable(id) end
    end
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy or not step.hand.contains.FLUSH then return end
      local minus = AIJ.num(joker, 'xmult_minus_mod')
      if (1 + AIJ.num(joker, 'xmult')) - minus <= 1 then
        result:say(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.MULT)
        result:destroySelf()
      else
        AIJ.add(joker, 'xmult', -minus)
        result:say('-X' .. AIJ.fmt(minus) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'scrunched_joker', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 11, y = 24 },
  config = { chips_big = 60, mult_big = 8, chips_small = 15, mult_small = 2 },
