  vars = function(card)
    local y = AIJ.run.you_broke_it or { rank = 14, enhancement = 'Chipped' }
    return { AIJ.rankName(y.rank), enhName(y.enhancement) }
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local y = AIJ.run.you_broke_it
      if not y then return end
      local any = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if rankOf(c) == y.rank and not AIJ.isDebuffed(c) and not AIJ.enhancement(c) then
          c:setEnhancement(y.enhancement)
          c:punch()
          any = true
        end
      end
      if any then result:say(enhName(y.enhancement), colors.ORANGE) end
    end,
  },
}

