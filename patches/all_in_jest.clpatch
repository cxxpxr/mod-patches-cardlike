      if AIJ.hasStamp(step.card, 'Red') and not AIJ.isDebuffed(step.card) then return AIJ.num(joker, 'retriggers') end
    end,
  },
}

local function playRanking(state, extraType, extra)
  local function plays(t) return ((state.hands[t] or {}).played or 0) + ((t == extraType) and (extra or 0) or 0) end
  local hands = visibleHands(state)
  local first, val = nil, 1
  for _, t in ipairs(hands) do
    if t ~= 'ROYAL_FLUSH' and plays(t) >= val then val = plays(t) first = t end
  end
  local second
  val = 1
  for _, t in ipairs(hands) do
    if t ~= 'ROYAL_FLUSH' and t ~= first and plays(t) >= val then val = plays(t) second = t end
  end
  return first, second
end

AIJ.addJoker {
  key = 'second_tier_meme',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 16, y = 4 },
  vars = function(card)
    local s = st()
    local second = s and s.hands and select(2, playRanking(s))
    return { second and AIJ.handName(second) or 'None' }
  end,
  triggers = {
    repeatCard = function(joker, state, step, result)
      local _, second = playRanking(state)
      if second and baseHand(step.hand.handType) == second then return 1 end
    end,
  },
}

