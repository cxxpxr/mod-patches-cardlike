  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 7, y = 13 },
  blueprint_compat = false,
  description = 'If ' .. colorize(bold('first hand'), colors.ORANGE) .. ' of round contains ' .. colorize(bold('no'), colors.ORANGE)
    .. ' repeating ' .. colorize(bold('suits'), colors.ORANGE) .. ', all scoring ' .. colorize(bold('unenhanced'), colors.ORANGE)
    .. ' cards become ' .. colorize(bold('Plaid cards'), colors.ORANGE),
  triggers = {
