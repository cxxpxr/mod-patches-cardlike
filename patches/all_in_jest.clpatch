}
onEnhanced(function(state, card, old, new)
  for _, j in ipairs(active(state, 'borra')) do
    borraUp(j, nil, nil, true)
    j:popup('Upgrade!', MULT)
  end
end)

local function topOfDeck(state, n)
  local deck = (state and state.unDrawnCards) or {}
  local out = {}
  for i = #deck, math.max(1, #deck - n + 1), -1 do out[#out + 1] = deck[i] end
  return out
end

local function heldBonuses(card)
  local ev = AIJ.safe(card.getEvaluation, card, true)
  local out = {}
  if type(ev) ~= 'table' then return out end
  for _, b in ipairs(ev.bonuses or {}) do out[#out + 1] = b end
  for _, b in ipairs(ev.edition or {}) do out[#out + 1] = b end
  return out
end

add {
  key = 'bouffon',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 13, y = 24 },
  blueprint_compat = false,
  config = { cards = 5 },
  description = function(r)
    local c = r and r.card
    return 'The top ' .. hi(AIJ.fmt(AIJ.val(c, 'bouffon', 'cards'))) .. ' cards ' .. hi('remaining') .. ' in your deck also give '
      .. 'their ' .. hi('held in hand') .. ' card effects when a hand scores and at the end of the round'
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      for _, c in ipairs(topOfDeck(state, AIJ.num(joker, 'cards'))) do
        if not AIJ.isDebuffed(c) then
          for _, b in ipairs(heldBonuses(c)) do result:add(b) end
        end
      end
    end,
    afterRound = function(joker, state, step, result)
      local n = 0
      for _, c in ipairs(topOfDeck(state, AIJ.num(joker, 'cards'))) do
        if not AIJ.isDebuffed(c) and AIJ.hasEnhancement(c, 'm_gold') then n = n + 1 end
      end
      if n > 0 then result:add(plusMoney(3 * n)) end
    end,
  },
}

