      local hit = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if AIJ.enhancement(c) and not AIJ.edition(c) and not AIJ.isDebuffed(c) then
          c:setEdition(AIJ.id('silver'))
          c:punch()
          hit = true
        end
      end
      if hit then result:say(AIJ.msg('aij_silver', 'Silver') .. '!', AIJ.colors.SILVER) end
    end,
  },
}

AIJ.addJoker {
  key = 'haruspex',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 22, y = 2 },
  config = { discards_to_spend = 1, cards_to_draw = 1 },
  blueprint_compat = false,
  description = (function()
    local base = AIJ.desc('Joker', 'j_aij_haruspex', function(card)
      local s = cardlike.state
      local n = AIJ.val(card, 'haruspex', 'cards_to_draw', 1)
      if s and s.unDrawnCards and #s.unDrawnCards > 0 then n = math.min(n, #s.unDrawnCards) end
      return { AIJ.val(card, 'haruspex', 'discards_to_spend', 1), n, colours = { ABILITY } }
    end)
    return function(r) return base(r) .. hint('Drag this Joker and press DRAW') end
  end)(),
  buttons = {
    AIJ.ability('haruspex', {
      label = 'DRAW',
      canPress = function(card, state)
        return state:isPhase('play') and (state.discardsLeft or 0) >= AIJ.num(card, 'discards_to_spend')
          and #(state.unDrawnCards or {}) > 0
      end,
      press = function(card, state, opts)
        if #(state.unDrawnCards or {}) == 0 then return false end
        if not (opts and opts.free) then
          state.discardsLeft = state.discardsLeft - AIJ.num(card, 'discards_to_spend')
        end
        openDeckPicker(state, 'Haruspex: draw a card', AIJ.num(card, 'cards_to_draw'))
      end,
    }),
  },
}

AIJ.addJoker {
  key = 'hat_trick',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 11, y = 0 },
  config = { mod = 1 },
  vars = function(card)
    local s = cardlike.state
    local h = s and s.getHand and AIJ.safe(s.getHand, s, 'THREE_OF_A_KIND')
    return { AIJ.val(card, 'hat_trick', 'mod', 1) * ((h and h.level) or 1) }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.hand.handType ~= 'THREE_OF_A_KIND' then return end
      local h = state:getHand('THREE_OF_A_KIND')
      local m = ((h and h.level) or 1) * AIJ.num(joker, 'mod')
      if m ~= 0 then result:add(plusMult(m)) end
    end,
  },
}

local function royalFlushPlayed(state)
  local h = state:getHand('ROYAL_FLUSH')
  return h ~= nil and (h.played or 0) > 0
end

local function hasRoyal(hand)
  local has = hand.contains or {}
  if has.ROYAL_FLUSH then return true end
  if not ((has.STRAIGHT and has.FLUSH) or has.STRAIGHT_FLUSH) then return false end
  for _, c in ipairs(hand.playedCards or {}) do
    if AIJ.noRank(c) or (info(c).rank or 0) < 10 then return false end
  end
  return true
end

