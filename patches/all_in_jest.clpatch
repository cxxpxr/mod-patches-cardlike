onSuitChanged = function(state, card)
  if AIJ.hasEnhancement(card, 'canvas') then return end
  for _, j in ipairs(owned('tool', state)) do
    AIJ.permaAdd(card, 'mult', AIJ.num(j, 'mult_mod'))
    card:popup('Upgrade!', colors.MULT)
    j:punch()
  end
end

