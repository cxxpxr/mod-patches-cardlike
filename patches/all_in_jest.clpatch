AIJ.addJoker {
  key = 'numbertaker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 2, y = 25 },
  config = { cur_mult = 0 },
  description = function(r)
    return 'Scored ' .. B('numbered') .. ' cards lose their ' .. B('Points', colors.CHIPS) .. ' (down to '
      .. B('1', colors.CHIPS) .. ') and this ' .. B('Joker') .. ' gains ' .. B('Mult', colors.MULT)
      .. ' equal to their rank\n' .. grey('(Once per card)') .. '\n' .. grey('(Currently ')
      .. B('+' .. AIJ.fmt(AIJ.val(r and r.card, 'numbertaker', 'cur_mult')), colors.MULT) .. grey(' Mult)')
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy then return end
      local c = step.card
      if AIJ.isDebuffed(c) or AIJ.get(c, 'aij_numbertaken') then return end
      local rank = rankOf(c)
      if rank < 2 or rank > 10 then return end
      AIJ.set(c, 'aij_numbertaken', true)
      AIJ.add(joker, 'cur_mult', rank)
      local base = AIJ.safe(c.getBasePointValue, c) or 0
      if base > 1 then AIJ.permaAdd(c, 'chips', 1 - base) end
      result:say('Upgrade!', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'cur_mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

AIJ.addJoker {
  key = 'octopus',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 13, y = 16 },
  blueprint_compat = false,
  triggers = {
    afterHand = function(joker, state, step, result)
      if step.copiedBy or not step.hand then return end
      local changed = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        local r = rankOf(c)
        if r == 7 or r == 9 then c:setRank(8) changed = true end
      end
      if changed then result:say(AIJ.msg('k_aij_change_ex', 'Change!')) end
    end,
  },
}

AIJ.addJoker {
  key = 'odd_rod',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 10, y = 34 },
  triggers = {
    repeatCard = function(joker, state, step, result)
      local r = rankOf(step.card)
      if (r >= 2 and r <= 10 and r % 2 == 1) or r == 14 then return 1 end
    end,
  },
}

local function jokerRightOf(joker, state)
  local list = (state and state.jokers) or {}
  for i, j in ipairs(list) do
    if j == joker then return list[i + 1] end
  end
end

local function baseBuyValue(card)
  local cached = card:getDataStore():get('aij_base_cost')
  if cached then return cached end
  local sticker = AIJ.safe(card.getSticker, card) or 'none'
  if sticker ~= 'none' then card:setSticker('none') end
  local v = AIJ.safe(card.getBuyValue, card) or 0
  if sticker ~= 'none' then card:setSticker(sticker) end
  card:getDataStore():set('aij_base_cost', v)
  return v
end

local function repairJob(joker, state)
  local r = jokerRightOf(joker, state)
  if not r then return nil end
  local sticker = AIJ.safe(r.getSticker, r)
  if sticker == 'subscription' then return baseBuyValue(r), r, sticker end
  if sticker == 'timed' then return 3, r, sticker end
  return nil
end

AIJ.addJoker {
  key = 'office_assistant',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 2, y = 20 }, soul_pos = { x = 3, y = 20 },
  blueprint_compat = false,
  description = function(r)
    return B('Activated Ability', ABILITY_COLOUR) .. ' Repairs the ' .. B('Timed') .. ' or ' .. B('Subscription')
      .. ' Joker to the ' .. B('right') .. '\n' .. grey('Subscription: pay its price to remove the sticker')
      .. '\n' .. grey('Timed: pay ') .. B('$3', colors.MONEY) .. grey(' to remove the sticker')
      .. '\n' .. grey('(Drag it and press REPAIR)')
  end,
  in_pool = function(state)
    for _, j in ipairs((state and state.jokers) or {}) do
      local s = AIJ.safe(j.getSticker, j)
      if s == 'timed' or s == 'subscription' then return true end
    end
    return false
  end,
  buttons = {
    AIJ.ability('office_assistant', {
      label = function(card, state)
        local cost = state and AIJ.safe(repairJob, card, state)
        return cost and ('REPAIR $' .. AIJ.fmt(cost)) or 'REPAIR'
      end,
      canPress = function(card, state)
        local cost = state and AIJ.safe(repairJob, card, state)
        return cost ~= nil and state.money >= cost and not state:isPhase('scoring')
      end,
      press = function(card, state, opts)
        local cost, right, sticker = repairJob(card, state)
        local free = opts and opts.free
        if not cost or (not free and state.money < cost) then return false end
        if not free then state:mutateMoney(-cost) end
        right:setSticker('none')
        right:punch()
        right:popup(sticker == 'subscription' and 'Paid off!' or 'Refreshed!', colors.MONEY)
      end,
    }),
  },
}

local since = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then enhSnap = nil return end
  since = since + (frame.dt or 0)
  if since < 0.2 then return end
  since = 0
  local state = cardlike.state
  if not state or state.money == nil then return end
  AIJ.safe(applyHandSizeTrackers, state)
  AIJ.safe(cleanupMagicHats, state)
  AIJ.safe(watchEnhancements, state)
end)


