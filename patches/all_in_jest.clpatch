local VANILLA_ENHANCEMENTS = { 'Chipped', 'Multicard', 'Plaid', 'Fragile', 'Wooden', 'Rock', 'Gilded', 'Paperback' }
local function enhancementPool()
  local list = AIJ.copy(VANILLA_ENHANCEMENTS)
  for _, k in ipairs(AIJ.lists.enhancements) do
    if AIJ.has(k, 'enhancement') then list[#list + 1] = AIJ.id(k) end
  end
  return list
end

