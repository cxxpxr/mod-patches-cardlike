AIJ.addJoker {
  key = 'in_vino_veritas',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 6, y = 5 },
  config = { max_h_size = 5, current_h_size = 0, h_size_mod = 1 },
  blueprint_compat = false,
  vars = function(card)
    return { AIJ.val(card, 'in_vino_veritas', 'h_size_mod', 1), AIJ.val(card, 'in_vino_veritas', 'current_h_size', 0),
      AIJ.val(card, 'in_vino_veritas', 'max_h_size', 5) }
  end,
  triggers = {
    onConsumableUsed = function(joker, state, step, result)
      if step.copiedBy then return end
      local cur, max, mod = AIJ.num(joker, 'current_h_size'), AIJ.num(joker, 'max_h_size'), AIJ.num(joker, 'h_size_mod')
      if cur >= max then return end
      local d = math.min(mod, max - cur)
      AIJ.set(joker, 'current_h_size', cur + d)
      state.handSize = state.handSize + d
      result:say('+' .. AIJ.fmt(d) .. ' Hand Size', colors.ORANGE)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local cur = AIJ.num(joker, 'current_h_size')
      if cur > 0 then
        state.handSize = state.handSize - cur
        AIJ.set(joker, 'current_h_size', 0)
      end
      result:say('Reset', colors.ORANGE)
    end,
  },
  onAdded = function(joker, state)
    local cur = AIJ.num(joker, 'current_h_size')
    if cur > 0 then state.handSize = state.handSize + cur end
  end,
  onRemoved = function(joker, state)
    local cur = AIJ.num(joker, 'current_h_size')
    if cur > 0 then state.handSize = state.handSize - cur end
  end,
}

AIJ.addJoker {
  key = 'infamous_machine',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 16, y = 19 },
  config = { mult_mod = 5, mult = 0 },
  vars = function(card) return { AIJ.val(card, 'infamous_machine', 'mult_mod', 5), AIJ.val(card, 'infamous_machine', 'mult', 0) } end,
  triggers = {
    drawInitialCards = function(joker, state, step, result)
      if step.copiedBy then return end
      local left, best = nil, math.huge
      for _, c in ipairs(state.cardsInHand or {}) do
        local i = AIJ.safe(c.getIndex, c) or math.huge
        if i < best then left, best = c, i end
      end
      if left then left:destroy() end
      AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
      result:say('+' .. AIJ.fmt(AIJ.num(joker, 'mult_mod')) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

