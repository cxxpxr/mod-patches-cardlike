cardlike.onFrame(function(frame)
  local st = cardlike.state
  moneyBefore = (frame.inRun and st) and st.money or nil
end)
AIJ.onAbilityUsed(function(state, user, jokerId)
  local cost = (moneyBefore or state.money or 0) - (state.money or 0)
  moneyBefore = state.money
  if cost <= 0 then return end
  for _, j in ipairs(active(state, 'brass_joker')) do
    AIJ.add(j, 'mult', cost)
    j:popup('+' .. AIJ.fmt(cost) .. ' Mult', MULT)
  end
end)

