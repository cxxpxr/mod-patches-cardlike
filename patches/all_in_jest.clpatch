local function heldRarities(state)
  local counts, max = {}, 0
  for _, j in ipairs((state and state.jokers) or {}) do
    if not AIJ.is(j, 'bobblehead') then
      local r = rarityOf(j)
      if r then
        counts[r] = (counts[r] or 0) + 1
        if counts[r] > max then max = counts[r] end
      end
    end
  end
  local top = {}
  for r, n in pairs(counts) do if n >= max then top[#top + 1] = r end end
  table.sort(top)
  return top
end

local function rarityLabel(r)
  local s = AIJ.short(tostring(r)):gsub('_', ' ')
  return (s:gsub('(%a)(%w*)', function(a, b) return a:upper() .. b end))
end

local function bobbleReroll(state, cards)
  local n = #active(state, 'bobblehead')
  if n <= 0 then return end
  local top = heldRarities(state)
  local set, W = {}, 0
  for _, r in ipairs(top) do
    if RARITY_WEIGHT[r] then set[r] = true; W = W + RARITY_WEIGHT[r] end
  end
  if W <= 0 then return end
  local S = 1 + 2 * n * W
  local q = 1 - 1 / S
  for _, c in ipairs(cards or {}) do
    local info = c.lastInfo or {}
    local r = rarityOf(c)
    if info.kind == 'joker' and RARITY_WEIGHT[r] and not set[r] and state:randomFloat() < q then
      local x, pick = state:randomFloat() * W, nil
      for _, t in ipairs(top) do
        if RARITY_WEIGHT[t] then
          pick = t
          x = x - RARITY_WEIGHT[t]
          if x <= 0 then break end
        end
      end
      local id = pick and cardlike.randomJoker(pick)
      if id then c:setJokerDef(id) end
    end
  end
end

add {
  key = 'bobblehead',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 23, y = 2 },
  blueprint_compat = false,
  vars = function(card)
    local state = cardlike.state
    local top = (card and state) and heldRarities(state) or {}
    local names = {}
    for _, r in ipairs(top) do names[#names + 1] = rarityLabel(r) end
    return { #names > 0 and table.concat(names, ', ') or 'None' }
  end,
}
cardlike.on('onShopEnter', function(state) bobbleReroll(state, state.shopCards) end)
cardlike.on('onShopReroll', function(state) bobbleReroll(state, state.shopCards) end)
cardlike.on('onPackOpened', function(state) bobbleReroll(state, state.packCards) end)

