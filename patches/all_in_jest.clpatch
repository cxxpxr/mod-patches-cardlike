  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 14, y = 4 },
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if not step.hand.contains.STRAIGHT or (state.freeJokerSlots or 0) <= 0 then return end
      local j = cardlike.createJoker(state:randomFloat() > 0.5 and 'Common' or 'Uncommon')
      if j then result:say('+1 Joker', colors.BLUE) end
    end,
  },
