    ["j_aij_chimney_sweep"] = { name = "Chimney Sweep", text = "" },
    ["j_aij_chipped_joker"] = { name = "Chipped Joker", text = "When a [color=\"#f3a712\"][b]Rock card[/b][/color] is scored, it loses [color=\"#ff007f\"][b]-#1#[/b][/color] Points and this [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_chippy"] = { name = "Chippy", text = "This Joker gains [color=\"#3772ff\"][b]Points[/b][/color] equal to [color=\"#f3a712\"][b]money[/b][/color] spent\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_chips_n_dip"] = { name = "Points 'n Dip", text = "[color=\"#3772ff\"][b]X#1#[/b][/color] Points, loses [color=\"#3772ff\"][b]X#2#[/b][/color] Points at end of [color=\"#f3a712\"][b]round[/b][/color]" },
    ["j_aij_chitty"] = { name = "Chitty", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] [color=\"#f3a712\"][b]Ticket[/b][/color] available for purchase in [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_chocolate_coins"] = { name = "Chocolate Coins", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Gold[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when [color=\"#f3a712\"][b]money[/b][/color] is earned during a [color=\"#f3a712\"][b]blind[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Star[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_choleric_joker"] = { name = "Choleric Joker", text = "Played cards with [color=\"#204887\"][b]Diamond[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#d138bf\"][b]Game[/b][/color] card when scored\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_christmas_eve"] = { name = "Christmas Eve", text = "Create a [color=\"#f3a712\"][b]Shop Pin[/b][/color] when [color=\"#f3a712\"][b]Alpha Blind[/b][/color] is defeated" },
    ["j_aij_chromatic_aberrant"] = { name = "Chromatic Aberrant", text = "[color=\"#1bb18c\"][b]+#5#[/b][/color] to listed [color=\"#1bb18c\"][b]probabilities[/b][/color] [color=\"#f3a712\"][b]this hand[/b][/color] if hand contains a [color=\"#f3a712\"][b]Straight[/b][/color] or a [color=\"#f3a712\"][b]Flush[/b][/color]\n[color=\"#1bb18c\"][b]+#3#[/b][/color] to listed [color=\"#1bb18c\"][b]probabilities[/b][/color] [color=\"#f3a712\"][b]permanently[/b][/color] if played hand contains a [color=\"#f3a712\"][b]Straight Flush[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#1bb18c\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Odds)[/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#1bb18c\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Odds)[/color]" },
    ["j_aij_chromatist"] = { name = "Chromatist", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a [color=\"#f3a712\"][b]Chroma[/b][/color] edition triggers" },
    ["j_aij_chunyu"] = { name = "Chunyu", text = "" },
    ["j_aij_circle_joker"] = { name = "Circle Joker", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if each [color=\"#f3a712\"][b]rank[/b][/color] in scored hand is [color=\"#f3a712\"][b]lower[/b][/color] than the [color=\"#f3a712\"][b]previous[/b][/color]" },
    ["j_aij_circuit_board"] = { name = "Circuit Board", text = "" },
    ["j_aij_circuit_diagram"] = { name = "Circuit Diagram", text = "[color=\"#f3a712\"][b]Charged[/b][/color] cards are always shuffled to the top of deck" },
    ["j_aij_circus_elephant"] = { name = "Circus Elephant", text = "" },
    ["j_aij_circus_monkey"] = { name = "Circus Monkey", text = "When Blind is [color=\"#f3a712\"][b]selected[/b][/color], [color=\"#f3a712\"][b]leftmost[/b][/color] Joker permanently gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_clapperdudgeon"] = { name = "Clapperdudgeon", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if you have [color=\"#f3a712\"][b]$#2#[/b][/color] or less" },
    ["j_aij_clay"] = { name = "Clay", text = "" },
    ["j_aij_clay_credits_joker"] = { name = "Clay", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_clay_joker"] = { name = "Clay Joker", text = "Copies the abilities of the last [color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#ff007f\"][b]destroyed[/b][/color] [color=\"#f3a712\"][b]jokers[/b][/color]\n[color=\"#9a9a9a\"](Excluding Clay Joker)[/color]" },
    ["j_aij_cliff"] = { name = "Cliff", text = "" },
    ["j_aij_clipart"] = { name = "Clipart", text = "" },
    ["j_aij_cloth_joker"] = { name = "Cloth Joker", text = "[color=\"#f3a712\"][b]Queens[/b][/color] give [color=\"#ff007f\"][b]X#2#[/b][/color] Mult and [color=\"#ff007f\"][b]-$#1#[/b][/color] when scored" },
    ["j_aij_cloudwatching"] = { name = "Cloudwatching", text = "[color=\"#f3a712\"][b]+#1# Pin Choice[/b][/color] when skipping a [color=\"#f3a712\"][b]Blind[/b][/color]" },
    ["j_aij_clownbug"] = { name = "Clownbug", text = "" },
    ["j_aij_clownfish"] = { name = "Clownfish", text = "" },
    ["j_aij_clowns_on_parade"] = { name = "Clowns on Parade", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#3772ff\"][b]+#2#[/b][/color] Points if played hand contains at least three [color=\"#f3a712\"][b]2s[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#3772ff\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_club_card"] = { name = "Club Card", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if full deck has at least [color=\"#f3a712\"][b]#2# [/b][/color][color=\"#388f58\"][b]Clubs[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#3#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_coconut"] = { name = "Coconut", text = "Create a [color=\"#f3a712\"][b]Coffee Pin[/b][/color] when this Joker is [color=\"#f3a712\"][b]sold[/b][/color]" },
    ["j_aij_coffee_thermos"] = { name = "Coffee Thermos", text = "Retrigger all [color=\"#f3a712\"][b]end of round[/b][/color] effects for the next [color=\"#f3a712\"][b]#1#[/b][/color] rounds" },
    ["j_aij_colour_test"] = { name = "Colour Test", text = "Apply [color=\"#f3a712\"][b]Chroma[/b][/color] to first scoring card on [color=\"#f3a712\"][b]final[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] of round" },
    ["j_aij_colquhoun"] = { name = "Colquhoun", text = "All cards earn [color=\"#f3a712\"][b]$#1#[/b][/color] when [color=\"#f3a712\"][b]scored[/b][/color], increases by [color=\"#f3a712\"][b]$#2#[/b][/color] when [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated" },
    ["j_aij_columbina"] = { name = "Columbina", text = "[color=\"#d78fd0\"][b]Balance[/b][/color] [color=\"#f3a712\"][b]#1#%[/b][/color] of [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color], increases by [color=\"#f3a712\"][b]#2#%[/b][/color] when an [color=\"#4584fa\"][b]Admin[/b][/color] card is used" },
    ["j_aij_comedians_manifesto"] = { name = "Comedian's Manifesto", text = "[color=\"#f3a712\"][b]Kings[/b][/color] and [color=\"#f3a712\"][b]Queens[/b][/color] in [color=\"#f3a712\"][b]Deck Packs[/b][/color] become [color=\"#f3a712\"][b]Jacks[/b][/color]" },
    ["j_aij_comedy_of_errors"] = { name = "Comedy of Errors", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] whenever a [color=\"#c23447\"][b]Heart[/b][/color] is [color=\"#ff007f\"][b]discarded[/b][/color]" },
    ["j_aij_comic_panel"] = { name = "Comic Panel", text = "[color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to apply a random [color=\"#f3a712\"][b]enhancement[/b][/color] to [color=\"#f3a712\"][b]all[/b][/color] cards in played hand" },
    ["j_aij_comic_spirit"] = { name = "Comic Spirit", text = "" },
