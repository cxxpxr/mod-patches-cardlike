local hatApplied = {}

AIJ.addJoker {
  key = 'magic_hat',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 6, y = 7 },
  config = { handsize_mod = 3, to_remove = 0 },
  vars = function(card) return { AIJ.val(card, 'magic_hat', 'handsize_mod') } end,
  onRemoved = function(joker, state)
    local n = AIJ.num(joker, 'to_remove')
    if n > 0 and state then
      state.extraEphemeralHandSize = math.max(0, (state.extraEphemeralHandSize or 0) - n)
      AIJ.set(joker, 'to_remove', 0)
    end
  end,
  triggers = {
    onPackOpened = function(joker, state, step, result)
      local n = AIJ.num(joker, 'handsize_mod')
      state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + n
      AIJ.add(joker, 'to_remove', n)
      hatApplied[joker.uid] = cardlike.time()
      result:say('+' .. AIJ.fmt(n) .. ' Hand Size')
    end,
  },
}

local function cleanupMagicHats(state)
  if state:isPhase('pack') then return end
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.is(j, 'magic_hat') then
      local n = AIJ.num(j, 'to_remove')
      if n > 0 and cardlike.time() - (hatApplied[j.uid] or 0) > 0.5 then
        state.extraEphemeralHandSize = math.max(0, (state.extraEphemeralHandSize or 0) - n)
        AIJ.set(j, 'to_remove', 0)
      end
    end
  end
end

AIJ.onNewRun(function(run) run.magic_mirror_trigger = true end)

local function playingCardNegative()
  if not AIJ.setting('no_copy_neg') and AIJ.has('negative_playing_card', 'edition') then
    return AIJ.id('negative_playing_card')
  end
  return 'Inverted'
end

AIJ.addJoker {
  key = 'magic_mirror',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 15, y = 7 },
  blueprint_compat = false,
  vars = function(card)
    local on = AIJ.run.magic_mirror_trigger
    if on == nil then on = true end
    return { on and '(Active)' or '(Inactive)' }
  end,
  triggers = {
    onAnteChanged = function(joker, state, step, result)
      if (step.delta or 1) ~= 0 then AIJ.run.magic_mirror_trigger = true end
    end,
    onScore = function(joker, state, step, result)
      if step.copiedBy or AIJ.run.magic_mirror_trigger == false then return end
      if not isFace(step.card) then return end
      AIJ.run.magic_mirror_trigger = false
      step.card:setEdition(playingCardNegative())
      step.card:punch()
      result:say('Inverted!', colors.PURPLE, step.card)
    end,
  },
}

AIJ.onNewRun(function(run) run.magick_suit = 'Spades' end)

cardlike.on('afterRound', function(state)
  local pool = {}
  for _, c in ipairs(state.allCards or {}) do
    if not AIJ.noRank(c) then pool[#pool + 1] = c end
  end
  local c = AIJ.pick(pool, state)
  AIJ.run.magick_suit = (c and AIJ.safe(c.getSuit, c)) or 'Spades'
end)

AIJ.addJoker {
  key = 'magick_joker',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 8, y = 3 }, lite = true,
  blueprint_compat = false,
  vars = function(card)
    local suit = AIJ.run.magick_suit or 'Spades'
    return { suit, colours = { AIJ.SUIT_COLORS[suit] or colors.ORANGE } }
  end,
}

cardlike.filter('cardBonuses', function(list, card, held)
  if held then return nil end
  local state = cardlike.state
  if not state or #activeJokers('magick_joker', state) == 0 then return nil end
  local suit = AIJ.run.magick_suit or 'Spades'
  if not AIJ.isSuit(card, suit, state) then return nil end
  local p = AIJ.safe(card.getPointValue, card) or 0
  if p <= 0 then return nil end
  local out = {}
  for _, b in ipairs(list or {}) do out[#out + 1] = b end
  out[#out + 1] = plusChips(-p)
  out[#out + 1] = plusMult(p)
  return out
end)

AIJ.addJoker {
  key = 'maguelonne',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 7, y = 28 },
  config = { xmult = 1, xmult_gain = 0.25 },
  vars = function(card) return { AIJ.val(card, 'maguelonne', 'xmult_gain'), AIJ.val(card, 'maguelonne', 'xmult') } end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local faces = {}
      for _, c in ipairs(state.unDrawnCards or {}) do
        if isFace(c) then faces[#faces + 1] = c end
      end
      local c = AIJ.pick(faces, state)
      if not c then return end
      local x = AIJ.add(joker, 'xmult', AIJ.num(joker, 'xmult_gain'))
      c:destroy()
      result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

local function ticketPool(state)
  local pool = {}
  for _, t in ipairs(cardlike.listContent('ticket') or {}) do
    local id = t.id
    if id and not state:hasTicket(id) then
      local n = tonumber(tostring(id):match('^ticket_(%d+)$'))
      if not n or n % 2 == 0 or state:hasTicket('ticket_' .. (n - 1)) then pool[#pool + 1] = t end
    end
  end
  return pool
end

AIJ.addJoker {
  key = 'mahoney',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 24, y = 10 },
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      local pool = AIJ.shuffled(ticketPool(state), state)
      for _, t in ipairs(pool) do
        if cardlike.redeemTicket(t.id) ~= false then
          result:say(tostring(t.name or 'Ticket') .. '!')
          return
        end
      end
    end,
  },
}

AIJ.addJoker {
  key = 'majordomo',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 23, y = 13 },
  config = { more_than = 5, rental_reduce = 2 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'majordomo', 'more_than') } end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      local changed = false
      for _, c in ipairs(state.shopCards or {}) do
        if kindOf(c) == 'joker' and (AIJ.safe(c.getSticker, c) or 'none') == 'none'
          and (AIJ.safe(c.getBuyValue, c) or 0) > AIJ.num(joker, 'more_than') then
          c:setSticker('subscription')
          c:punch()
          changed = true
        end
      end
      if changed then joker:punch() end
    end,
    onShopReroll = function(joker, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(state.shopCards or {}) do
        if kindOf(c) == 'joker' and (AIJ.safe(c.getSticker, c) or 'none') == 'none'
          and (AIJ.safe(c.getBuyValue, c) or 0) > AIJ.num(joker, 'more_than') then
          c:setSticker('subscription')
          c:punch()
        end
      end
    end,
  },
}

local majordomoRound = { round = nil, n = 0 }
cardlike.filter('money', function(amount)
  local state = cardlike.state
  if amount ~= -3 or not state or not state:isPhase('play') then return nil end
  if (state.handsPlayed or 0) > 0 or (state.discardsUsed or 0) > 0 then return nil end
  local owners = activeJokers('majordomo', state)
  if #owners == 0 then return nil end
  local subs = 0
  for _, j in ipairs(state.jokers or {}) do
    if AIJ.safe(j.getSticker, j) == 'subscription' then subs = subs + 1 end
  end
  if majordomoRound.round ~= state.round then majordomoRound = { round = state.round, n = 0 } end
  if majordomoRound.n >= subs then return nil end
  majordomoRound.n = majordomoRound.n + 1
  local reduce = 0
  for _, j in ipairs(owners) do reduce = reduce + AIJ.num(j, 'rental_reduce') end
  return -math.max(0, 3 - reduce)
end)

AIJ.addJoker {
  key = 'mammon',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 7, y = 26 },
  config = { payout_increase_mod = 1, payout_increase_total = 0 },
  vars = function(card)
    return { AIJ.val(card, 'mammon', 'payout_increase_mod'), AIJ.val(card, 'mammon', 'payout_increase_total') }
  end,
  in_pool = function(state) return countEnhanced(state, 'm_gold') >= 2 end,
  triggers = {
    onScore = function(joker, state, step, result)
      if AIJ.isDebuffed(step.card) or not hasEnh(step.card, 'm_gold') then return end
      AIJ.add(joker, 'payout_increase_total', AIJ.num(joker, 'payout_increase_mod'))
      result:say('Upgrade!', colors.MONEY)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local total = AIJ.num(joker, 'payout_increase_total')
      if total <= 0 then return end
      local n = countEnhanced(state, 'm_gold', state.cardsInHand)
      if n > 0 then result:add(plusMoney(n * total)) end
    end,
    beforeRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.num(joker, 'payout_increase_total') ~= 0 then
        AIJ.set(joker, 'payout_increase_total', 0)
        result:say('Reset')
      end
    end,
  },
}

AIJ.addJoker {
  key = 'mandrake',
  rarity = 2, cost = 5, atlas = 'joker_atlas', pos = { x = 3, y = 9 },
  config = { rounds = 0, total_rounds = 2 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'mandrake', 'rounds'), AIJ.val(card, 'mandrake', 'total_rounds') } end,
  triggers = {
    onSold = function(joker, state, step, result)
      if AIJ.num(joker, 'rounds') < AIJ.num(joker, 'total_rounds') then return end
      for _, c in ipairs(state.cardsInHand or {}) do
        AIJ.safe(c.moveTo, c, 'deck')
        AIJ.safe(c.destroy, c)
      end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local rounds = AIJ.add(joker, 'rounds', 1)
      local total = AIJ.num(joker, 'total_rounds')
      if rounds < total then result:say(AIJ.fmt(rounds) .. '/' .. AIJ.fmt(total))
      elseif rounds == total then result:say('Active!') end
    end,
  },
}

AIJ.addJoker {
  key = 'marceau',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 4, y = 18 }, soul_pos = { x = 4, y = 19 },
  config = { repetitions = 2 },
  description = function(r)
    return 'Retrigger all ' .. B('held in hand') .. ' effects '
      .. B(AIJ.fmt(AIJ.val(r and r.card, 'marceau', 'repetitions'))) .. ' additional times'
  end,
  triggers = {
    repeatHeldCard = function(joker, state, step, result)
      return AIJ.num(joker, 'repetitions')
    end,
  },
}

local function never() return false end

AIJ.addJoker {
  key = 'marcy_credits_joker',
  rarity = 1, cost = 4, atlas = 'familiar_atlas', pos = { x = 1, y = 1 }, lite = true,
  blueprint_compat = false,
  in_pool = never,
}

local function uniqueEnhancements(state)
  local seen, n = {}, 0
  for _, c in ipairs((state and state.allCards) or {}) do
    for _, e in ipairs(enhList(c)) do
      if not seen[e] then seen[e] = true n = n + 1 end
    end
  end
  return n
end

AIJ.addJoker {
  key = 'mariachi',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 24, y = 29 }, lite = true,
  config = { mult = 4 },
  vars = function(card)
    local m = AIJ.val(card, 'mariachi', 'mult')
    return { m, card and uniqueEnhancements(cardlike.state) * m or 0 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = uniqueEnhancements(state)
      if n > 0 then result:add(plusMult(n * AIJ.num(joker, 'mult'))) end
    end,
  },
}

local function jokerEntries()
  local out = {}
  for _, j in ipairs(cardlike.listContent('joker') or {}) do
    if j.id and not tostring(j.id):find('_credits_joker', 1, true) then
      out[#out + 1] = { id = j.id, name = j.name or j.id }
    end
  end
  return out
end

AIJ.addJoker {
  key = 'martellino',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 9, y = 8 }, soul_pos = { x = 9, y = 9 },
  config = { marte_rounds = 0, total_rounds = 5 },
  blueprint_compat = false,
  vars = function(card)
    return { AIJ.val(card, 'martellino', 'marte_rounds'), AIJ.val(card, 'martellino', 'total_rounds') }
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local rounds = AIJ.add(joker, 'marte_rounds', 1)
      local total = AIJ.num(joker, 'total_rounds')
      if rounds < total then result:say(AIJ.fmt(rounds) .. '/' .. AIJ.fmt(total))
      elseif rounds == total then result:say('Active!') end
    end,
    onSold = function(joker, state, step, result)
      if AIJ.num(joker, 'marte_rounds') < AIJ.num(joker, 'total_rounds') then return end
      AIJ.set(joker, 'marte_rounds', 0)
      openPicker('Choose a Joker', jokerEntries(), function(e)
        local made = cardlike.createJoker(e.id)
        if not made then cardlike.centerText('No room!', 1.5) end
      end)
    end,
  },
}

local function countAnyEnhanced(list)
  local n = 0
  for _, c in ipairs(list or {}) do if #enhList(c) > 0 then n = n + 1 end end
  return n
end

AIJ.addJoker {
  key = 'master_of_pegs',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 24, y = 43 },
  config = { xmult = 1, xmult_gain = 0.25 },
  vars = function(card)
    local state = cardlike.state
    local full = card and state and countAnyEnhanced(state.allCards) or 0
    local left = card and state and countAnyEnhanced(state.unDrawnCards) or 0
    return { AIJ.val(card, 'master_of_pegs', 'xmult_gain'),
      AIJ.val(card, 'master_of_pegs', 'xmult') + AIJ.val(card, 'master_of_pegs', 'xmult_gain') * full,
      left <= 0 and '(Active)' or '(Inactive)' }
  end,
  in_pool = function(state) return state ~= nil and countAnyEnhanced(state.allCards) > 0 end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      if countAnyEnhanced(state.unDrawnCards) > 0 then return end
      local x = AIJ.num(joker, 'xmult') + AIJ.num(joker, 'xmult_gain') * countAnyEnhanced(state.allCards)
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

local function meatyX(joker, state)
  local size = (state and (state.deckSize or (state.allCards and #state.allCards))) or 0
  return math.max(1, math.floor(size / math.max(1, AIJ.num(joker, 'cards'))))
end

AIJ.addJoker {
  key = 'meaty_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 22 }, lite = true,
  config = { xmult = 1, cards = 20 },
  vars = function(card)
    return { AIJ.val(card, 'meaty_joker', 'xmult'), AIJ.val(card, 'meaty_joker', 'cards'),
      card and meatyX(card, cardlike.state) or 1 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local x = meatyX(joker, state)
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'melancholic_joker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 22, y = 13 },
  config = { odds = 8 },
  vars = function(card) return { AIJ.prob(), AIJ.val(card, 'melancholic_joker', 'odds') } end,
  triggers = {
    onScore = function(joker, state, step, result)
      local c = step.card
      if AIJ.isDebuffed(c) or not AIJ.isSuit(c, 'Spades', state) then return end
      if (state.freeConsumableSlots or 0) <= 0 then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds'))) and cardlike.createConsumable('admin') then
        result:say('+Admin', AIJ.colors.SPECTRAL)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'melpomene',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 3, y = 12 }, soul_pos = { x = 3, y = 13 }, lite = true,
  triggers = {
    onScore = function(joker, state, step, result)
      if not isFace(step.card) or not step.hand then return end
      local h = state:getHand(step.hand.handType)
      if not h then return end
      if (h.chips or 0) ~= 0 then result:add(plusChips(h.chips)) end
      if (h.mult or 0) ~= 0 then result:add(plusMult(h.mult)) end
    end,
  },
}

AIJ.addJoker {
  key = 'mike_check',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 21, y = 19 },
  config = { count = 0, target = 3 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'mike_check', 'target'), AIJ.val(card, 'mike_check', 'count') } end,
  triggers = {
    onCardSold = function(joker, state, step, result)
      if step.copiedBy or kindOf(step.card) ~= 'joker' then return end
      local count, target = AIJ.add(joker, 'count', 1), AIJ.num(joker, 'target')
      if count >= target then
        AIJ.set(joker, 'count', 0)
        if cardlike.createJoker('Uncommon') then result:say('+1 Joker') end
      else
        result:say(AIJ.fmt(count) .. '/' .. AIJ.fmt(target), colors.CHIPS)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'mistake',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 9 },
  blueprint_compat = false,
  description = B('Locked') .. ' Jokers can be ' .. B('sold') .. '\n' .. grey('(Drag a Locked Joker and press SELL)'),
  in_pool = function(state)
    if not state then return false end
    if (state.stake or 1) >= 4 then return true end
    for _, j in ipairs(state.jokers or {}) do
      if AIJ.safe(j.isLocked, j) then return true end
    end
    return false
  end,
}

AIJ.register('addCardButton', {
  id = 'mistake_sell',
  label = 'SELL',
  appliesTo = function(card, state)
    return kindOf(card) == 'joker' and AIJ.safe(card.getArea, card) == 'jokers' and AIJ.safe(card.isLocked, card) == true
      and #activeJokers('mistake', state) > 0
  end,
  canPress = function(card, state)
    return not state:isPhase('scoring')
  end,
  press = function(card, state)
    card:setLocked(false)
    card:sell()
    if AIJ.exists(card) and AIJ.safe(card.getArea, card) == 'jokers' then card:setLocked(true) end
  end,
}, 'button')

handSizeTrackers.mistigri = function(joker, state)
  local jacks = 0
  for _, c in ipairs(state.cardsInHand or {}) do
    if rankOf(c) == 11 then jacks = jacks + 1 end
  end
  return math.floor(jacks / 2)
end

AIJ.addJoker {
  key = 'mistigri',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 14, y = 5 },
  blueprint_compat = false,
  onRemoved = removeTrackedHandSize,
}

AIJ.addJoker {
  key = 'mixel_perfect',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 10, y = 4 }, lite = true,
  config = { mult = 9 },
  vars = function(card) return { AIJ.val(card, 'mixel_perfect', 'mult') } end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = step.hand and #(step.hand.playedCards or {}) or 0
      if n % 2 == 1 then result:add(plusMult(AIJ.num(joker, 'mult'))) end
    end,
  },
}

local LOWER_RARITY = { Legendary = 'Rare', Rare = 'Uncommon', Uncommon = 'Common' }

AIJ.addJoker {
  key = 'mocap',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 12, y = 11 },
  blueprint_compat = false,
  triggers = {
    onCardSold = function(joker, state, step, result)
      local c = step.card
      if step.copiedBy or kindOf(c) ~= 'joker' or c == joker then return end
      local rarity = (c.lastInfo and c.lastInfo.rarity) or AIJ.safe(c.getRarity, c)
      local lower = LOWER_RARITY[rarity]
      if lower then
        joker:punch()
        cardlike.createJoker(lower)
      else
        result:say('Nope!', AIJ.colors.TAROT)
      end
    end,
  },
}

local function countRank(state, rank)
  local n = 0
  for _, c in ipairs((state and state.allCards) or {}) do
    if rankOf(c) == rank then n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'mondrian_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 3, y = 8 }, lite = true,
  config = { mult = 0, mult_mod = 4 },
  vars = function(card)
    local m = AIJ.val(card, 'mondrian_joker', 'mult_mod')
    return { m, card and countRank(cardlike.state, 4) * m or 0 }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local m = countRank(state, 4) * AIJ.num(joker, 'mult_mod')
      if m > 0 then result:add(plusMult(m)) end
    end,
  },
}

local function gameCardEntries()
  local out = {}
  for _, c in ipairs(cardlike.listContent('consumable') or {}) do
    if c.type == 'game' and c.id then out[#out + 1] = { id = c.id, name = c.name or c.id } end
  end
  return out
end
local morioPending = 0

AIJ.addJoker {
  key = 'morio',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 20, y = 8 },
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      if state.blind and state.blind.boss then AIJ.set(joker, 'trigger_round', state.round) end
    end,
    onCashOut = function(joker, state, step, result)
      if AIJ.get(joker, 'trigger_round') ~= state.round then return end
      if (state.freeConsumableSlots or 0) - morioPending <= 0 then return end
      morioPending = morioPending + 1
      result:say('+Game card', AIJ.colors.TAROT)
      openPicker('Choose a Game card', gameCardEntries(), function(e)
        morioPending = math.max(0, morioPending - 1)
        cardlike.createConsumable(e.id)
      end)
    end,
  },
}

local function discardKey(state)
  return tostring(state.round) .. ':' .. tostring(state.discardsLeft) .. ':' .. tostring(state.discardsUsed)
end

AIJ.addJoker {
  key = 'mr_catfish',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 5, y = 11 },
  config = { dollars = 20, discards_remaining = 20, discards = 20 },
  vars = function(card)
    return { AIJ.val(card, 'mr_catfish', 'dollars'), AIJ.val(card, 'mr_catfish', 'discards'),
      AIJ.val(card, 'mr_catfish', 'discards_remaining') }
  end,
  triggers = {
    onDiscard = function(joker, state, step, result)
      local n = step.discardedCards and #step.discardedCards or 0
      if n == 0 then return end
      local key = discardKey(state)
      local pays
      if AIJ.get(joker, 'last_key') == key then
        pays = AIJ.num(joker, 'last_pays')
      else
        local left = AIJ.num(joker, 'discards_remaining') - n
        pays = 0
        while left <= 0 do
          left = left + math.max(1, AIJ.num(joker, 'discards'))
          pays = pays + 1
        end
        if not step.copiedBy then
          AIJ.set(joker, 'discards_remaining', left)
          AIJ.set(joker, 'last_key', key)
          AIJ.set(joker, 'last_pays', pays)
        end
      end
      if pays > 0 then result:add(plusMoney(pays * AIJ.num(joker, 'dollars'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'mr_lonely',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 18, y = 7 }, lite = true,
  config = { chips = 0, chip_mod = 10 },
  vars = function(card) return { AIJ.val(card, 'mr_lonely', 'chip_mod'), AIJ.val(card, 'mr_lonely', 'chips') } end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local free = state.freeJokerSlots or 0
      if free > 0 then
        AIJ.add(joker, 'chips', AIJ.num(joker, 'chip_mod') * free)
        result:say('Upgrade!', colors.CHIPS)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

AIJ.addJoker {
