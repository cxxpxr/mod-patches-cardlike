add {
  key = 'david',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 9 },
  config = { chips = 0, chip_mod = 50 },
  vars = function(card) return { AIJ.val(card, 'david', 'chip_mod'), AIJ.val(card, 'david', 'chips') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local cards = step.hand and step.hand.allCards or {}
      if #cards == 0 then return end
      for _, c in ipairs(cards) do
        if rankOf(c) ~= 13 or not isSuit(c, 'Spades') then return end
      end
      AIJ.add(joker, 'chips', AIJ.num(joker, 'chip_mod'))
      result:say(AIJ.msg('k_upgrade_ex', 'Upgrade!'), colors.CHIPS)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

add {
  key = 'dead_president',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 15, y = 4 },
  lite = true,
  config = { max = 50 },
  vars = function(card) return { AIJ.val(card, 'dead_president', 'max') } end,
  triggers = {
    onSold = function(joker, state, step, result)
      local jokers = state.jokers or {}
      local i
      for k, j in ipairs(jokers) do if j == joker then i = k break end end
      if not i then return end
      local max = AIJ.num(joker, 'max')
      for _, n in ipairs({ jokers[i - 1], jokers[i + 1] }) do
        local sv = n and n ~= joker and tonumber(AIJ.safe(n.getSellValue, n)) or 0
        if sv > 0 then
          n:addSellValue(math.min(sv, max))
          n:punch()
          n:popup(AIJ.msg('k_val_up', 'Value Up!'), colors.MONEY)
        end
      end
    end,
  },
}

local function salesmanOffer(joker)
  local pin = AIJ.get(joker, 'aij_dos_pin')
  local price = AIJ.num(joker, 'aij_dos_price')
  local left = AIJ.num(joker, 'aij_dos_left')
  return pin, price, left
end

add {
  key = 'death_of_a_salesman',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 4, y = 16 },
  config = { tags = 1 },
  description = function(r)
    local card = r and r.card
    local n = AIJ.val(card, 'death_of_a_salesman', 'tags')
    local text = colorize(bold(AIJ.fmt(n)), colors.ORANGE) .. ' ' .. colorize(bold('Chaos'), colors.MULT) .. ' or '
      .. colorize(bold('Anarchy'), colors.MULT) .. ' ' .. colorize(bold('Pin'), colors.ORANGE)
      .. ' available for purchase in every ' .. colorize(bold('Shop'), colors.ORANGE)
      .. '\n' .. grey('(Drag this Joker and press BUY)')
    if card then
      local pin, price, left = salesmanOffer(card)
      if pin and left > 0 then
        text = text .. '\n' .. grey('(This shop: ' .. (AIJ.isId(pin, 'anarchy') and 'Anarchy' or 'Chaos')
          .. ' Pin for $' .. AIJ.fmt(price) .. ')')
      end
    end
    return text
  end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      if step.copiedBy then return end
      local price = state:random(3, 7)
      local pin = 'chaos'
      if state:random(1, 4) == 4 then pin = 'anarchy'; price = price * 2 end
      AIJ.set(joker, 'aij_dos_pin', AIJ.id(pin))
      AIJ.set(joker, 'aij_dos_price', price)
      AIJ.set(joker, 'aij_dos_left', AIJ.num(joker, 'tags'))
    end,
    onShopExit = function(joker, state, step, result)
      if step.copiedBy then return end
      AIJ.set(joker, 'aij_dos_left', 0)
    end,
  },
  buttons = {
    {
      label = function(card)
        local pin, price = salesmanOffer(card)
        return 'BUY PIN $' .. AIJ.fmt(price)
      end,
      canPress = function(card, state)
        local pin, price, left = salesmanOffer(card)
        return state:isPhase('shop') and left > 0 and pin ~= nil and AIJ.has(pin, 'pin') and (state.money or 0) >= price
      end,
      press = function(card, state)
        local pin, price, left = salesmanOffer(card)
        if not pin or left <= 0 or (state.money or 0) < price then return end
        state:mutateMoney(-price)
        cardlike.addPin(pin)
        AIJ.set(card, 'aij_dos_left', left - 1)
        card:popup(AIJ.msg('aij_plus_tag', '+1 Pin'), colors.ORANGE)
      end,
    },
  },
}

