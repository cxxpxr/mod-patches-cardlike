    ["c_aij_deneb_algedi_pin"] = { name = "Deneb Algedi", text = "[color=\"#3772ff\"][b]+#2#[/b][/color] Hand the [color=\"#f3a712\"][b]first[/b][/color] time this hand is played each round [color=\"#9a9a9a\"]#3#[/color]" },
    ["c_aij_procyon"] = { name = "Procyon", text = "Align [color=\"#f3a712\"][b]#1#[/b][/color] to [color=\"#f3a712\"][b]Procyon[/b][/color]\n[color=\"#f3a712\"][b]Procyon: [/b][/color]Add [color=\"#f3a712\"][b]$#2#[/b][/color] of sell value to a random [color=\"#f3a712\"][b]Joker[/b][/color]" },
