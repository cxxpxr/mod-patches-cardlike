}

AIJ.addJoker {
  key = 'magazine_ad',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 6, y = 12 },
  triggers = {
    afterRound = function(joker, state, step, result)
      if not (state.blind and state.blind.boss) then return end
      local pool = {}
      for _, c in ipairs(state.allCards or {}) do
        if not AIJ.stamp(c) then pool[#pool + 1] = c end
      end
      local c = AIJ.pick(pool, state)
      if not c then return end
      c:setStamp(AIJ.vanilla('Red'))
      c:punch()
      result:say('Replay Stamp')
    end,
  },
