local AIJ = cardlike.require('lib.aij')

local function hl(text, col) return colorize(bold(text), col or colors.ORANGE) end
local function grey(text) return colorize(text, colors.GREY) end

local ENHANCED = '#8389dd'

local function owned(state, id)
  local out = {}
  for _, j in ipairs((state and state.jokers) or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function anyCard(state, fn)
  for _, c in ipairs((state and state.allCards) or {}) do
    if fn(c) then return true end
  end
  return false
end

local function indexOf(list, card)
  for i, c in ipairs(list or {}) do
    if c == card or c.uid == card.uid then return i end
  end
  return nil
end

local function cardName(c)
  if AIJ.noRank(c) then return (AIJ.enhancement(c) or 'Rock') .. ' card' end
  return AIJ.rankName(c:getRank()) .. ' of ' .. tostring(c:getSuit())
end

local function uniqueSuits(cards)
  local have, count = {}, 0
  local suits = {}
  for _, s in ipairs(AIJ.SUITS) do suits[#suits + 1] = s end
  for _, s in ipairs(cardlike.listContent('suit') or {}) do
    if not AIJ.contains(suits, s.id) then suits[#suits + 1] = s.id end
  end
  local wild = {}
  for _, c in ipairs(cards or {}) do
    local info = c.lastInfo or {}
    if info.anySuit then
      wild[#wild + 1] = c
    elseif not AIJ.noRank(c) then
      for _, s in ipairs(suits) do
        if not have[s] and c:isSuit(s) then have[s] = true count = count + 1 break end
      end
    end
  end
  for _ in ipairs(wild) do
    for _, s in ipairs(suits) do
      if not have[s] then have[s] = true count = count + 1 break end
    end
  end
  return count
end

local FRUIT = {
  STRAIGHT = 'fruit_card_0', FULL_HOUSE = 'fruit_card_1', TWO_PAIR = 'fruit_card_2', HIGH_CARD = 'fruit_card_3',
  PAIR = 'fruit_card_4', THREE_OF_A_KIND = 'fruit_card_5', FLUSH_HOUSE = 'fruit_card_6', FLUSH_FIVE = 'fruit_card_7',
  FIVE_OF_A_KIND = 'fruit_card_8', FOUR_OF_A_KIND = 'fruit_card_9', FLUSH = 'fruit_card_10',
  STRAIGHT_FLUSH = 'fruit_card_11', ROYAL_FLUSH = 'fruit_card_11',
}

local function fixedText(key)
  local e = AIJ.loc('Joker', key)
  local text = e and e.text or ''
  text = text:gsub('(Fruit card%[/b%]%[/color%]) cards?', '%1')
  return text
end

local function patchedDesc(key, varsFn, fixes)
  return function(r)
    local ok, vars = pcall(varsFn or function() return {} end, r and r.card, r)
    local text = AIJ.fill((AIJ.loc('Joker', key) or {}).text or '', ok and vars or {})
    for _, f in ipairs(fixes or {}) do text = text:gsub(f[1], f[2]) end
    return text
  end
end

local ABILITY_FIX = { 'Activated Ability%[/b%]%[/color%] ', 'Activated Ability[/b][/color]\n' }

local knownEnh = {}
local enhListeners = {}
local function onEnhancementChanged(fn) enhListeners[#enhListeners + 1] = fn end

local function snapshotEnh()
  for _, info in ipairs(cardlike.cardInfos('allCards') or {}) do
    knownEnh[info.uid] = info.enhancement or 'Default'
  end
end
cardlike.on('onRunStart', function() knownEnh = {} snapshotEnh() end)
cardlike.on('onRoundStart', snapshotEnh)
cardlike.on('onShopEnter', snapshotEnh)
cardlike.on('onPackOpened', snapshotEnh)
cardlike.on('onCardsAdded', function(state, step)
  for _, c in ipairs(step.cards or {}) do
    knownEnh[c.uid] = AIJ.safe(c.getEnhancement, c) or 'Default'
  end
end)
cardlike.on('onCardChanged', function(state, step)
  local c = step.card
  if type(c) ~= 'table' then return end
  local kind = (c.lastInfo and c.lastInfo.kind) or AIJ.safe(c.getKind, c)
  if kind ~= 'playing' then return end
  local new = AIJ.safe(c.getEnhancement, c) or 'Default'
  local old = knownEnh[c.uid]
  knownEnh[c.uid] = new
  if old ~= nil and old ~= new then
    for _, fn in ipairs(enhListeners) do pcall(fn, state, c, old, new) end
  end
end)

local function scaleOnEnhance(id, enh)
  onEnhancementChanged(function(state, card, old, new)
    if not AIJ.hasEnhancement(card, enh) then return end
    for _, j in ipairs(owned(state, id)) do
      local v = AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
      j:popup('X' .. AIJ.fmt(1 + v) .. ' Mult', colors.MULT)
    end
  end)
end

local function loseXmult(j, strict)
  local x = 1 + AIJ.num(j, 'xmult')
  local left = x - AIJ.num(j, 'xmult_minus_mod')
  if (strict and left <= 1) or (not strict and left < 1) then
    j:popup(AIJ.msg('k_eaten_ex', 'Eaten!'), colors.ORANGE)
    j:destroy()
    return
  end
  AIJ.add(j, 'xmult', -AIJ.num(j, 'xmult_minus_mod'))
  j:popup('-X' .. AIJ.fmt(AIJ.num(j, 'xmult_minus_mod')) .. ' Mult', colors.MULT)
end

local function obtainConsumable(state, id)
  if not id or not state or (state.freeConsumableSlots or 0) <= 0 then return end
  cardlike.createConsumable(id)
end

