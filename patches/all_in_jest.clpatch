  onAdded = function(joker, state)
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) + AIJ.num(joker, 'slots')
  end,
  onRemoved = function(joker, state)
    if state and state.additionalJokerSlots then
      state.additionalJokerSlots = state.additionalJokerSlots - AIJ.num(joker, 'slots')
    end
  end,
  triggers = {
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local cost = AIJ.num(joker, 'cost')
      state:mutateMoney(-cost)
      result:say('-$' .. AIJ.fmt(cost), colors.MULT)
