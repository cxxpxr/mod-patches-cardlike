AIJ.addJoker {
  key = 'the_mycologists',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 18, y = 1 },
  config = { poker_hand = 'PAIR' },
  blueprint_compat = false,
  vars = function(card) return { AIJ.handName(AIJ.val(card, 'the_mycologists', 'poker_hand')) } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      local cards = step.hand.allCards or {}
      if step.hand.handType ~= AIJ.get(joker, 'poker_hand', 'PAIR') or #cards ~= 2 then return end
      local left, right = cards[1], cards[2]
      left:addAdditionalPointValue(right:getPointValue())
      local enh = AIJ.enhancement(right)
      if enh then left:setEnhancement(enh) end
      local ed = AIJ.edition(right)
      if ed then left:setEdition(ed) end
      right:destroy()
      left:punch()
      result:say(AIJ.msg('k_aij_two_into_one_ex', 'Two into one!'), colors.ORANGE)
    end,
  },
}

AIJ.addJoker {
  key = 'the_treachery_of_jokers',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 7, y = 16 },
  config = { xmult = 1.5 },
  blueprint_compat = false,
  description = function(r)
    local x = AIJ.val(r and r.card, 'the_treachery_of_jokers', 'xmult')
    return colorize(bold('X' .. AIJ.fmt(x)), colors.MULT) .. ' Mult. Uses a ' .. colorize(bold('consumable'), colors.ORANGE)
      .. ' slot in place of a ' .. colorize(bold('Joker'), colors.ORANGE) .. ' slot'
  end,
  onAdded = function(joker, state)
    if AIJ.get(joker, 'aij_slot_swap') or AIJ.hasEdition(joker, 'e_negative') then return end
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) + 1
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) - 1
    AIJ.set(joker, 'aij_slot_swap', true)
  end,
  onRemoved = function(joker, state)
    if not AIJ.get(joker, 'aij_slot_swap') then return end
    state.additionalJokerSlots = (state.additionalJokerSlots or 0) - 1
    state.additionalConsumableSlots = (state.additionalConsumableSlots or 0) + 1
    AIJ.set(joker, 'aij_slot_swap', false)
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      result:add(xMult(AIJ.num(joker, 'xmult')))
    end,
  },
}

cardlike.filter('hasRoom', function(has, card)
