AIJ.addJoker {
  key = 'youve_got_mail',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 8, y = 14 },
  config = { mult = 4, chips = 20, dollars = 1, xmult = 0.25, effect = 'none' },
