local function invertNotes(state)
  if not AIJ.owns('infuriating_note', state) then return end
  for _, list in ipairs({ state.shopCards or {}, state.packCards or {} }) do
    for _, c in ipairs(list) do
      if AIJ.is(c, 'infuriating_note') and AIJ.edition(c) ~= 'Inverted' then AIJ.safe(c.setEdition, c, 'Inverted') end
    end
  end
end

