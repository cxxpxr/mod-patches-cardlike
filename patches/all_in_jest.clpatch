== file jokers/batch10.lua (1816 lines)
local AIJ = cardlike.require('lib.aij')

local function C(text, col) return colorize(bold(text), col) end
local function grey(text) return colorize(text, colors.GREY) end

local function owned(id, state)
  state = state or cardlike.state
  local out = {}
  if not state or not state.jokers then return out end
  for _, j in ipairs(state.jokers) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function kindOf(card)
  local info = type(card) == 'table' and card.lastInfo or {}
  return info.kind or AIJ.safe(card.getKind, card)
end

local function consumableType(card)
  local info = card.lastInfo or {}
  return info.type or AIJ.safe(card.getConsumableType, card)
end

local function rankOf(card)
  if AIJ.noRank(card) then return nil end
  return AIJ.safe(card.getRank, card) or (card.lastInfo or {}).rank
end

local FRUIT_OF = {
  HIGH_CARD = 'fruit_card_3', PAIR = 'fruit_card_4', TWO_PAIR = 'fruit_card_2', THREE_OF_A_KIND = 'fruit_card_5',
  STRAIGHT = 'fruit_card_0', FLUSH = 'fruit_card_10', FULL_HOUSE = 'fruit_card_1', FOUR_OF_A_KIND = 'fruit_card_9',
  STRAIGHT_FLUSH = 'fruit_card_11', ROYAL_FLUSH = 'fruit_card_11', FLUSH_HOUSE = 'fruit_card_6',
  FIVE_OF_A_KIND = 'fruit_card_8', FLUSH_FIVE = 'fruit_card_7',
}

local function fixedDesc(key, varsFn)
  local d = AIJ.desc('Joker', 'j_aij_' .. key, varsFn)
  return function(r)
    local t = type(d) == 'function' and d(r) or d
    return (t:gsub('card%[/b%]%[/color%] card', 'card[/b][/color]'))
  end
end

local RETURNED = 'aij_b10_returned'
local function wasReturned(card)
  local store = (card.lastInfo or {}).store
  if store and store[RETURNED] then return true end
  return AIJ.safe(function() return card:getDataStore():get(RETURNED) end) == true
end

local SUIT_KEY, ENH_KEY = 'aij_b10_suit', 'aij_b10_enh'
local onSuitChanged, onEnhChanged

local function watching(state)
  return #owned('tool', state) > 0 or #owned('tortilla_chips', state) > 0
end

local function scanCards(state, report)
  state = state or cardlike.state
  if not state or not state.allCards or not watching(state) then return end
  for _, c in ipairs(state.allCards) do
    local ds = c:getDataStore()
    local suit = not AIJ.noRank(c) and AIJ.safe(c.getSuit, c) or 'none'
    local enh = AIJ.enhancement(c) or 'Default'
    local oldSuit, oldEnh = ds:get(SUIT_KEY), ds:get(ENH_KEY)
    if report then
      if oldSuit and oldSuit ~= 'none' and suit ~= 'none' and oldSuit ~= suit then pcall(onSuitChanged, state, c) end
      if oldEnh and oldEnh ~= enh then pcall(onEnhChanged, state, c, enh) end
    end
    if oldSuit ~= suit then ds:set(SUIT_KEY, suit) end
    if oldEnh ~= enh then ds:set(ENH_KEY, enh) end
  end
end

for _, ev in ipairs({ 'onConsumableUsed', 'onCardChanged', 'onHandDrawn', 'onRoundStart', 'onShopEnter', 'afterHand', 'onDiscard' }) do
  cardlike.on(ev, function(state) scanCards(state, true) end)
end
cardlike.on('onCardObtained', function(state, step)
  if AIJ.is(step.card, 'tool') or AIJ.is(step.card, 'tortilla_chips') then scanCards(state, false) end
end)

local function otherSellTotal(joker, state)
  local total = 0
  for _, j in ipairs(state.jokers or {}) do
    if j ~= joker then total = total + (tonumber(AIJ.safe(j.getSellValue, j)) or 0) end
  end
  return total
end

AIJ.addJoker {
  key = 'tipteerer',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 3, y = 6 },
  config = { percent = 25 },
  blueprint_compat = false,
  vars = function(card)
    local p = AIJ.val(card, 'tipteerer', 'percent')
    local s, money = cardlike.state, 0
    if card and s and s.jokers then money = math.ceil(otherSellTotal(card, s) * p / 100) end
    return { money, p }
  end,
  dollarsAtRoundEnd = function(joker, state)
    local money = math.ceil(otherSellTotal(joker, state) * AIJ.num(joker, 'percent') / 100)
    return money > 0 and money or 0
  end,
}

