    ["j_aij_charles"] = { name = "Charles", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult if [color=\"#f3a712\"][b]played hand[/b][/color] is only [color=\"#c23447\"][b]Heart[/b][/color] [color=\"#f3a712\"][b]Kings[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
