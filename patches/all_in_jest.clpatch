local ALIEN = 'aij_alien_forced'

local function alienForce(joker, state)
  local me = joker:getId()
  local valid = {}
  for _, c in ipairs(state.cardsInHand or {}) do
    local by = c:getDataStore():get(ALIEN)
    if by == me then return end
    if by == nil then valid[#valid + 1] = c end
  end
  local pick = AIJ.pick(valid, state)
  if pick then
    pick:getDataStore():set(ALIEN, me)
    pick:setSelected(true)
    joker:punch()
  end
end

local function alienClear(state, owner)
  for _, c in ipairs(state.allCards or {}) do
    local ds = c:getDataStore()
    local by = ds:get(ALIEN)
    if by ~= nil and (owner == nil or by == owner) then ds:delete(ALIEN) end
  end
end

AIJ.addJoker {
  key = 'alien_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 13 },
  config = { xmult = 3 },
  vars = function(card) return { AIJ.val(card, 'alien_joker', 'xmult') } end,
  onAdded = function(joker, state)
    if state.isPhase and state:isPhase('play') then alienForce(joker, state) end
  end,
  onRemoved = function(joker, state) alienClear(state, joker:getId()) end,
  triggers = {
    onHandDrawn = function(joker, state, step, result)
      if step.copiedBy then return end
      alienForce(joker, state)
    end,
    onCardSelected = function(joker, state, step, result)
      if step.copiedBy or step.selected or not step.card then return end
      local c = step.card
      if c:getDataStore():get(ALIEN) == joker:getId() and c:getArea() == 'hand' and state:isPhase('play') then
        c:setSelected(true)
      end
    end,
    onScore = function(joker, state, step, result)
      if step.card:getDataStore():get(ALIEN) ~= nil then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
    afterHand = function(joker, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(step.hand.allCards or {}) do
        if c:getDataStore():get(ALIEN) == joker:getId() then c:getDataStore():delete(ALIEN) end
      end
    end,
    onDiscardCard = function(joker, state, step, result)
      if step.copiedBy then return end
      local ds = step.card:getDataStore()
      if ds:get(ALIEN) == joker:getId() then ds:delete(ALIEN) end
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy then return end
      alienClear(state, nil)
    end,
  },
}

