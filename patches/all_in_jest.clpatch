    ["tag_aij_ticket"] = { name = "Ticket Pin", text = "[color=\"#f3a712\"][b]Redeem[/b][/color] a random Ticket and its [color=\"#f3a712\"][b]upgraded[/b][/color] version" },
    ["tag_aij_timelost"] = { name = "Timelost Pin", text = "Gives a free [color=\"#d138bf\"][b]Guess[/b][/color] [color=\"#d138bf\"][b]the Jest Pack[/b][/color] with [color=\"#f3a712\"][b]5[/b][/color] perishable options" },
