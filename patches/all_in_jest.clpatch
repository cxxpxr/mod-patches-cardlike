AIJ.addJoker {
  key = 'big_ears',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 19, y = 2 },
  config = { chips = 0, chip_mod = 2, chip_dec = 1 },
  vars = function(card)
    local id = 'big_ears'
    return { AIJ.val(card, id, 'chips'), AIJ.val(card, id, 'chip_mod'), AIJ.val(card, id, 'chip_dec') }
  end,
  triggers = {
    onScore = function(joker, state, step, result)
      if step.copiedBy or AIJ.noRank(step.card) then return end
      local r = step.card:getRank()
      if r >= 2 and r <= 10 and r % 2 == 0 then
        AIJ.add(joker, 'chips', AIJ.num(joker, 'chip_mod'))
        result:say('Upgrade!', colors.CHIPS)
      elseif AIJ.num(joker, 'chips') > 0 and ((r <= 10 and r % 2 == 1) or r == 14) then
        AIJ.set(joker, 'chips', math.max(0, AIJ.num(joker, 'chips') - AIJ.num(joker, 'chip_dec')))
        result:say(AIJ.msg('k_aij_downgrade_ex', 'Downgrade!'), colors.RED)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local c = AIJ.num(joker, 'chips')
      if c > 0 then result:add(plusChips(c)) end
    end,
  },
}

