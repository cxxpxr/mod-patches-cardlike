    ["j_aij_candidate"] = { name = "Candidate", text = "[color=\"#009dff\"][b]Common[/b][/color] Jokers give [color=\"#3772ff\"][b]+#2#[/b][/color] Points\n[color=\"#1bb18c\"][b]Uncommon[/b][/color] and [color=\"#fe5f55\"][b]Rare[/b][/color] Jokers give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
