AIJ.onJokerGone(function(state, info, sold)
  if sold or not AIJ.isId(info.joker, 'atemporal_taco') then return end
  local d = tonumber(info.store and info.store.ante_mod) or AIJ.default('atemporal_taco', 'ante_mod', 1)
  state.ante = math.max(1, state.ante - d)
  cardlike.centerText('-' .. AIJ.fmt(d) .. ' Ante', 1.5)
end)

AIJ.addJoker {
