}

AIJ.addJoker {
  key = 'bad_sun',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 15, y = 13 },
  config = { suit_count = 3 },
  vars = function(card) return { AIJ.val(card, 'bad_sun', 'suit_count') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      local cards = step.hand.allCards or {}
      local hearts = 0
      for _, c in ipairs(cards) do if c:isSuit('Hearts') then hearts = hearts + 1 end end
      if hearts < AIJ.num(joker, 'suit_count') then return end
      local c = AIJ.pick(cards, state)
      if c then
        c:destroy()
        result:say(AIJ.msg('k_aij_destroyed_ex', 'Destroyed!'), colors.RED, c)
      end
    end,
  },
}

local BAD_EFFECTS = { 'mult', 'chips', 'xchips', 'Xmult', 'dollars' }
local function badEffect(card, state)
  local e = AIJ.get(card, 'effect', '')
  if e == '' and state and state.random then
    e = AIJ.pick(BAD_EFFECTS, state)
    AIJ.set(card, 'effect', e)
  end
  return e
end

AIJ.addJoker {
  key = 'baddata',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 15, y = 17 }, soul_pos = { x = 6, y = 18 },
  config = { num1 = 23, num2 = 151, num3 = 11, effect = '' },
  description = function(r)
    local card = r and r.card
    local n1, n2, n3 = AIJ.val(card, 'baddata', 'num1'), AIJ.val(card, 'baddata', 'num2'), AIJ.val(card, 'baddata', 'num3')
    local e = card and badEffect(card, cardlike.state) or ''
    local text
    if e == 'mult' then text = colorize(bold('+0 to +' .. n1), colors.MULT) .. ' Mult'
    elseif e == 'chips' then text = colorize(bold('+0 to +' .. n2), colors.CHIPS) .. ' Points'
    elseif e == 'xchips' then text = colorize(bold('X1 to X' .. AIJ.fmt(n1 / 10)), colors.CHIPS) .. ' Points'
    elseif e == 'Xmult' then text = colorize(bold('X1 to X' .. AIJ.fmt(n1 / 10)), colors.MULT) .. ' Mult'
    elseif e == 'dollars' then text = 'Earn ' .. colorize(bold('$0 to $' .. n3), colors.MONEY)
    else text = colorize(bold('rand()'), colors.GREY) end
    return text .. '\nThe effect changes after each hand'
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local e = badEffect(joker, state)
      if e == 'mult' then result:add(plusMult(state:random(0, AIJ.num(joker, 'num1'))))
      elseif e == 'chips' then result:add(plusChips(state:random(0, AIJ.num(joker, 'num2'))))
      elseif e == 'xchips' then result:add(xChips(state:random(10, AIJ.num(joker, 'num1')) * 0.1))
      elseif e == 'Xmult' then result:add(xMult(state:random(10, AIJ.num(joker, 'num1')) * 0.1))
      elseif e == 'dollars' then result:add(plusMoney(state:random(0, AIJ.num(joker, 'num3')))) end
      if not step.copiedBy then
        AIJ.set(joker, 'effect', '')
        badEffect(joker, state)
      end
    end,
  },
}

AIJ.addJoker {
  key = 'barcode',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 22, y = 30 },
  config = { sale = 50 },
  vars = function(card) return { AIJ.val(card, 'barcode', 'sale') } end,
  blueprint_compat = false,
}

cardlike.filter('price', function(price, card)
  if type(card) ~= 'table' or type(price) ~= 'number' then return nil end
  if (card.lastInfo or {}).kind ~= 'pack' then return nil end
  local list = owned('barcode')
  if #list == 0 then return nil end
  for _, j in ipairs(list) do
    price = math.max(1, math.floor(price * (100 - AIJ.num(j, 'sale')) / 100 + 0.5))
  end
  return price
end)

