  end,
}


== file jokers/batch09.lua (1506 lines)
local AIJ = cardlike.require('lib.aij')

local ENHANCED_COLOUR = '#8389dd'

local function rankOf(c)
  if type(c) ~= 'table' or AIJ.noRank(c) then return nil end
  local info = c.lastInfo or {}
  return info.rank or AIJ.safe(c.getRank, c)
end

local function isFace(c)
  local info = c.lastInfo or {}
  if info.face ~= nil then return info.face == true end
  return AIJ.safe(c.isFace, c) == true
end

local function deckHas(state, pred)
  for _, c in ipairs(state and state.allCards or {}) do
    if pred(c) then return true end
  end
  return false
end

local function jokerCount(state)
  return #(state and state.jokers or {})
end

local function pinCount(state)
  return #(state and state.pins or {})
end

local function activeText(on)
  return on and ('(' .. AIJ.msg('k_active', 'Active') .. ')') or ('(' .. AIJ.msg('k_inactive', 'Inactive') .. ')')
end

local function ownedActive(state, id)
  local out = {}
  for _, j in ipairs(state and state.jokers or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function isModId(id)
  return type(id) == 'string' and id:find(':', 1, true) ~= nil
end

local function heraldHand(state)
  local mp = state and state.mostPlayedHand
  if not mp then return nil end
  local h = state.hands and state.hands[mp]
  if h and (h.played or 0) > 0 then return mp end
  return nil
end

local function forcedHands(state)
  local out = {}
  if not state or not state.hasJoker then return out end
  if state:hasJoker(AIJ.id('string_theory')) then out.STRAIGHT = true end
  if state:hasJoker(AIJ.id('the_herald')) then
    local mp = heraldHand(state)
    if mp then
      out[mp] = true
      if mp == 'STRAIGHT_FLUSH' or mp == 'ROYAL_FLUSH' then out.STRAIGHT = true out.FLUSH = true end
      if mp == 'FLUSH_HOUSE' or mp == 'FLUSH_FIVE' then out.FLUSH = true end
    end
  end
  return out
end

local function contains(state, step, key)
  local c = step and step.hand and step.hand.contains
  if c and c[key] then return true end
  return forcedHands(state)[key] == true
end

local forced = nil
cardlike.on('beforeAllCardsScored', function(state)
  local f = forcedHands(state)
  forced = (f.STRAIGHT or f.FLUSH) and f or nil
end)
for _, ev in ipairs({ 'afterHand', 'onHandDrawn', 'onRoundStart', 'onShopEnter', 'onDiscard' }) do
  cardlike.on(ev, function() forced = nil end)
end
cardlike.hook('SaveState.isStraight', { before = function() if forced and forced.STRAIGHT then return true end end })
cardlike.hook('SaveState.isFlush', { before = function() if forced and forced.FLUSH then return true end end })

AIJ.addJoker {
  key = 'soft_serve',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 7, y = 25 },
  config = { total_purchases = 4, purchases_left = 4 },
  blueprint_compat = false,
  vars = function(card)
    return { AIJ.val(card, 'soft_serve', 'purchases_left'), AIJ.val(card, 'soft_serve', 'total_purchases') }
  end,
  triggers = {
    onCardBought = function(joker, state, step, result)
      if step.copiedBy then return end
      local info = step.card and step.card.lastInfo or {}
      local counts = info.kind == 'joker' or info.kind == 'pack'
        or (info.kind == 'consumable' and (info.type == 'game' or info.type == 'fruit'))
      if not counts then return end
      local left = AIJ.add(joker, 'purchases_left', -1)
      if left <= 0 then
        result:say('Eaten!', colors.RED)
        result:destroySelf()
      else
        result:say(AIJ.fmt(left) .. ' remaining', colors.ORANGE)
      end
    end,
  },
}

cardlike.filter('jokerPool', function(ids)
  if not AIJ.owns('soft_serve') then return nil end
  local keep = {}
  for _, id in ipairs(ids) do if not isModId(id) then keep[#keep + 1] = id end end
  if #keep < #ids then return keep end
end)
cardlike.filter('consumablePool', function(ids, ctype)
  if ctype ~= 'game' and ctype ~= 'fruit' then return nil end
  if not AIJ.owns('soft_serve') then return nil end
  local keep = {}
  for _, id in ipairs(ids) do if not isModId(id) then keep[#keep + 1] = id end end
  if #keep < #ids then return keep end
end)

