add {
  key = 'bogdonoff',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 8, y = 12 }, soul_pos = { x = 8, y = 13 },
  blueprint_compat = false,
  config = { debt_limit = 50 },
  description = function(r)
    local c = r and r.card
    return 'While the ' .. hi('Shop') .. ' is open, you can spend ' .. hi('$' .. AIJ.fmt(AIJ.val(c, 'bogdonoff', 'debt_limit')), MONEY)
      .. ' more than you have\nSet money to ' .. hi('$0', MONEY) .. ' when leaving the ' .. hi('Shop')
  end,
  onAdded = function(joker, state)
    if state:isPhase('shop') then state:setMoneyDirect(state.money + AIJ.num(joker, 'debt_limit')) end
  end,
  onRemoved = function(joker, state)
    if state.isPhase and state:isPhase('shop') then state:setMoneyDirect(state.money - AIJ.num(joker, 'debt_limit')) end
  end,
  triggers = {
    onShopEnter = function(joker, state, step, result)
      state:setMoneyDirect(state.money + AIJ.num(joker, 'debt_limit'))
      result:say('+$' .. AIJ.fmt(AIJ.num(joker, 'debt_limit')) .. ' credit', MONEY)
    end,
    onShopExit = function(joker, state, step, result)
      state:setMoneyDirect(0)
      result:say('Reset', MONEY)
    end,
  },
}

