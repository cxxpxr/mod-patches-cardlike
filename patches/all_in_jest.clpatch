== file jokers/batch01.lua (1566 lines)
local AIJ = cardlike.require('lib.aij')

local PLASMA = AIJ.colors.PLASMA

local function owned(id)
  local out = {}
  for _, j in ipairs(cardlike.cards('jokers') or {}) do
    if AIJ.is(j, id) and not AIJ.isDebuffed(j) then out[#out + 1] = j end
  end
  return out
end

local function packKind(card)
  if type(card) ~= 'table' then return nil end
  local info = card.lastInfo or {}
  local id = info.consumable or AIJ.safe(card.getConsumableDef, card)
  local ci = id and cardlike.contentInfo('pack', id)
  if ci and ci.kind then return ci.kind end
  local text = (tostring(id or '') .. ' ' .. tostring(info.name or '')):lower()
  if text:find('buffoon') or text:find('fool') then return 'fool' end
  if text:find('standard') or text:find('deck') then return 'deck' end
  if text:find('celestial') or text:find('fruit') then return 'fruit' end
  if text:find('spectral') or text:find('admin') then return 'admin' end
  if text:find('arcana') or text:find('game') then return 'game' end
  return nil
end

local okA, A = pcall(cardlike.require, 'items.astrals')
local okP, P = pcall(cardlike.require, 'items.planets')

local function addBalance(state, result, pct)
  if okA and A and A.balance then
    A.balance(state, pct)
  else
    pct = math.min(pct, 1)
    local chips, mult = state.currentChips or 0, state.currentMult or 0
    local avg = (pct * chips + pct * mult) / 2
    result:add(plusChips(avg - pct * chips))
    result:add(plusMult(avg - pct * mult))
  end
  result:say(AIJ.fmt(pct * 100) .. '%', PLASMA)
end

local function makeChaotic(card)
  card:getDataStore():set('aij_chaotic', true)
end
local function isChaotic(card)
  return card:getDataStore():get('aij_chaotic') == true
end
local function unmark(card)
  local ds = card:getDataStore()
  if ds:get('aij_marked') then ds:delete('aij_marked') end
end

local function paidAbility(id, press)
  return AIJ.ability(id, {
    label = function(card) return 'USE $' .. AIJ.fmt(AIJ.val(card, id, 'cost', 1)) end,
    canPress = function(card, state) return (state.money or 0) >= AIJ.num(card, 'cost') end,
    press = function(card, state, opts)
      if not (opts and opts.free) then
        local cost = AIJ.num(card, 'cost')
        state:mutateMoney(-cost)
        card:popup('-$' .. AIJ.fmt(cost), colors.MONEY)
      end
      press(card, state)
    end,
  })
end

local function randomRarity(state)
  local r = state:randomFloat()
  if r < 0.05 then return 'Rare' elseif r < 0.30 then return 'Uncommon' end
  return 'Common'
end

local function firstDigit(n)
  local s = string.format('%.0f', math.abs(n or 0))
  return tonumber(s:sub(1, 1)) or 0
end

local function cardName(c)
  local info = c.lastInfo or {}
  local rank = info.rank or AIJ.safe(c.getRank, c)
  local suit = info.suit or AIJ.safe(c.getSuit, c) or '?'
  local name = (info.noRank and 'Rock card') or (AIJ.rankName(rank or 0) .. ' of ' .. tostring(suit))
  local extra = {}
  local e = AIJ.enhancement(c)
  if e and not info.noRank then extra[#extra + 1] = AIJ.short(e) end
  local ed = AIJ.edition(c)
  if ed then extra[#extra + 1] = AIJ.short(ed) end
  if #extra > 0 then name = name .. ' (' .. table.concat(extra, ', ') .. ')' end
  return name
end

AIJ.addJoker {
  key = 'a_v_g_m',
  rarity = 2, cost = 1, atlas = 'joker_atlas', pos = { x = 22, y = 29 },
  config = { cost = 1, odds = 3 },
  blueprint_compat = false,
  description = (function()
    local d = AIJ.desc('Joker', 'j_aij_a_v_g_m', function(card)
      return { AIJ.val(card, 'a_v_g_m', 'odds'), AIJ.val(card, 'a_v_g_m', 'cost'), colours = { '#8389dd' } }
    end)
    return function(r) return d(r) .. '\n[color="#9a9a9a"](Drag it and press USE)[/color]' end
  end)(),
  buttons = {
    paidAbility('a_v_g_m', function(card, state)
      if state:randomFloat() >= AIJ.num(card, 'odds') / 100 then return end
      local max, joker, cons = 2, false, false
      if (state.freeJokerSlots or 0) > 0 then max = max + 1; joker = true end
      if (state.freeConsumableSlots or 0) > 0 then max = max + 1; cons = true end
      local index = state:random(1, max)
      if index >= 3 then
        if joker and cons then
          if state:random(1, 2) == 1 then cons = false else joker = false end
        end
        if joker then
          cardlike.createJoker(randomRarity(state))
        else
          local n = state:random(1, 52)
          cardlike.createConsumable(n <= 22 and 'game' or (n <= 34 and 'fruit' or 'admin'))
        end
      elseif index == 2 then
        cardlike.addPlayingCard({}, { area = 'deck' })
      else
        local pin = cardlike.randomPin()
        if pin then cardlike.addPin(pin) end
      end
      card:punch()
    end),
  },
}

AIJ.addJoker {
  key = 'a_young_hamlet', lite = true,
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 20, y = 19 },
  config = { mult = 0, mult_mod = 1, discards = 6, discards_remaining = 6 },
  vars = function(card)
    local id = 'a_young_hamlet'
    return { AIJ.val(card, id, 'mult'), AIJ.val(card, id, 'mult_mod'), AIJ.val(card, id, 'discards'), AIJ.val(card, id, 'discards_remaining') }
  end,
  triggers = {
    onDiscardCard = function(joker, state, step, result)
      if step.copiedBy then return end
      if AIJ.num(joker, 'discards_remaining') <= 1 then
        AIJ.set(joker, 'discards_remaining', AIJ.num(joker, 'discards'))
        AIJ.add(joker, 'mult', AIJ.num(joker, 'mult_mod'))
        result:say('Upgrade!', colors.MULT)
      else
        AIJ.add(joker, 'discards_remaining', -1)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local m = AIJ.num(joker, 'mult')
      if m ~= 0 then result:add(plusMult(m)) end
    end,
  },
}

