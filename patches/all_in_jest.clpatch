AIJ.addJoker {
  key = 'the_house_that_jack_built',
  rarity = 1, cost = 4, atlas = 'joker_atlas', pos = { x = 1, y = 14 },
  triggers = {
    onScore = function(joker, state, step, result)
      if rankOf(step.card) ~= 11 then return end
      local h = state:getHand('FULL_HOUSE')
      local level = h and h.level or 1
      result:add(plusChips(level))
      result:add(plusMult(level))
