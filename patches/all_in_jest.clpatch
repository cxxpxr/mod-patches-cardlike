  'great_white_north', 'grumpy_gus', 'gummy', 'hallucinaut', 'halter_sack', 'handsome_joker', 'happy_as_larry',
  'hat_trick', 'haunted_maze', 'headache', 'hei_tiki', 'historian', 'hofnarr_the_barbarian', 'homemade_comic', 'honker',
