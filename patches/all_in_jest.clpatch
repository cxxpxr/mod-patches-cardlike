cardlike.filter('canPlayHand', function(ok, cards)
  if ok == false or #owned('dark_presence') == 0 then return nil end
  local list = cards or (cardlike.state and cardlike.state.selectedCards) or {}
  for _, c in ipairs(list) do
    if isFace(c) then return false end
  end
  return nil
end)

