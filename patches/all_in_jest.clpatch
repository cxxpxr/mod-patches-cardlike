AIJ.addJoker {
  key = 'quadrangled_joker',
  rarity = 2, cost = 8, atlas = 'joker_atlas', pos = { x = 24, y = 26 },
  vars = function(card)
    return { handStat('FOUR_OF_A_KIND', 'chips', 60), handStat('FOUR_OF_A_KIND', 'mult', 7) }
  end,
  triggers = {
