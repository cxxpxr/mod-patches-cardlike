local function doubledPin(key, pos, rarity, sticker)
  gold { key = key, pos = pos, popWhen = 'shop',
    action = function(ctx)
      local id = cardlike.randomJoker(rarity)
      if not id or not cardlike.addShopItem(id, { free = true }) then return end
      local st = AIJ.has(sticker, 'sticker') and AIJ.id(sticker) or nil
      if not st then return end
      H.later(function()
        local shop = cardlike.state and cardlike.state.shopCards or {}
        for i = #shop, 1, -1 do
          local c = shop[i]
          if AIJ.defId(c) == id and AIJ.safe(c.getSticker, c) ~= st then
            c:setSticker(st)
            return
          end
        end
      end)
    end }
end
