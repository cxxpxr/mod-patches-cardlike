creditsJoker('jamie_credits_joker', { x = 1, y = 2 }, 'jamie_credits_info')

local enhCache = {}
local function primeEnh(state)
  for _, c in ipairs(state and state.allCards or {}) do
    if enhCache[c.uid] == nil then enhCache[c.uid] = info(c).enhancement or 'Default' end
  end
end
cardlike.on('onRunStart', function() enhCache = {} end)
cardlike.on('onRoundStart', function(state) primeEnh(state) end)
cardlike.on('onShopEnter', function(state) primeEnh(state) end)
cardlike.on('onPackOpened', function(state) primeEnh(state) end)
cardlike.on('onCardChanged', function(state, step)
  local c = step and step.card
  local i = info(c)
  if i.kind ~= 'playing' then return end
  local new = i.enhancement or 'Default'
  local old = enhCache[c.uid]
  enhCache[c.uid] = new
  if old == nil or old == new or new ~= 'Rock' then return end
  for _, j in ipairs(owned(state, 'jawbreaker')) do
    if not AIJ.isDebuffed(j) then
      local x = AIJ.add(j, 'xmult', AIJ.num(j, 'xmult_mod'))
      j:popup('X' .. AIJ.fmt(1 + x) .. ' Mult', colors.MULT)
    end
  end
end)
AIJ.addJoker {
  key = 'jawbreaker',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 15, y = 28 },
  config = { xmult_minus_mod = 0.1, xmult_mod = 0.5, xmult = 0 },
  description = function(r)
    local card = r and r.card
    return 'This ' .. colorize(bold('Joker'), colors.ORANGE) .. ' gains '
      .. colorize(bold('X' .. AIJ.fmt(AIJ.val(card, 'jawbreaker', 'xmult_mod', 0.5))), colors.MULT)
      .. ' Mult when a card becomes a ' .. colorize(bold('Rock card'), colors.ORANGE) .. ', loses '
      .. colorize(bold('X' .. AIJ.fmt(AIJ.val(card, 'jawbreaker', 'xmult_minus_mod', 0.1))), colors.MULT)
      .. ' Mult if played hand contains no ' .. colorize(bold('unscored cards'), colors.ORANGE) .. '\n'
      .. colorize('(Currently ', GREY) .. colorize(bold('X' .. AIJ.fmt(1 + AIJ.val(card, 'jawbreaker', 'xmult', 0))), colors.MULT)
      .. colorize(' Mult)', GREY) .. '\nCreates ' .. colorize(bold('Earth'), AIJ.colors.TAROT) .. ' when obtained\n'
      .. colorize('(Must have room)', GREY)
  end,
  onAdded = function(joker, state)
    primeEnh(state)
    if (state.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(AIJ.vanilla('c_tower')) end
  end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy then return end
      if #(step.hand.allCards or {}) ~= #(step.hand.playedCards or {}) then return end
      local x, minus = AIJ.num(joker, 'xmult'), AIJ.num(joker, 'xmult_minus_mod')
      if (1 + x) - minus <= 1 then
        result:say('Eaten!', colors.ORANGE)
        result:destroySelf()
      else
        AIJ.set(joker, 'xmult', x - minus)
        result:say('-X' .. AIJ.fmt(minus) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = 1 + AIJ.num(joker, 'xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'jeff_the_joker',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 9, y = 3 },
  config = { x_mult = 1, x_mult_per_destroy = 0.5 },
  vars = function(card) return { AIJ.val(card, 'jeff_the_joker', 'x_mult', 1), AIJ.val(card, 'jeff_the_joker', 'x_mult_per_destroy', 0.5) } end,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local b = state.blind or {}
      if b.name ~= 'Beta Blind' and b.id ~= 'Beta Blind' then return end
      local n = 0
      for _, j in ipairs(state.jokers or {}) do
        if j ~= joker and not AIJ.is(j, 'jeff_the_joker') and not AIJ.safe(j.isLocked, j) then
          j:destroy()
          n = n + 1
        end
      end
      if n > 0 then
        local x = AIJ.add(joker, 'x_mult', n * AIJ.num(joker, 'x_mult_per_destroy'))
        result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'x_mult')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

local COPY_TRIGGERS = { 'beforeRound', 'drawInitialCards', 'beforeAllCardsScored', 'beforeScore', 'onScore',
  'enhancementScore', 'onScoreInHand', 'afterAllCardsScored', 'onOtherJoker', 'finalScoring', 'afterHand', 'onDiscard',
  'afterRound', 'repeatCard', 'repeatHeldCard', 'destroyCard', 'onDiscardCard', 'onRoundStart', 'onHandDrawn',
  'onCardSelected', 'onConsumableUsed', 'onCardBought', 'onCardSold', 'onCardObtained', 'onCardPlaced', 'onShopEnter',
  'onShopExit', 'onShopReroll', 'onPackOpened', 'onPackSkipped', 'onBlindSkipped', 'onBossRerolled', 'onBlindDefeated',
  'onCashOut', 'onAnteChanged', 'onMoneyChanged', 'onCardsAdded', 'onCardsRemoved', 'onCardsDestroyed', 'onGameWon', 'onSold' }
local COPIERS = { 'borra', 'clay_joker', 'czar', 'dacosta', 'doodle', 'elder', 'error_404', 'first_draft', 'joker_png',
  'whats_left', 'jeremy_bearimy' }
local copyDepth = 0

local function runTrigger(fn, joker, state, step, result)
  if type(fn) ~= 'function' or copyDepth > 10 then return nil end
  copyDepth = copyDepth + 1
  local ok, res = pcall(fn, joker, state, step, result)
  copyDepth = copyDepth - 1
  if ok then return res end
  return nil
end

local BEARIMY_STEPS = { beforeRound = { 'beforeRound', 'onRoundStart' }, afterRound = { 'afterRound', 'onBlindDefeated' } }
local function bearimy(which)
  return function(joker, state, step, result)
    if step.copiedBy or copyDepth > 0 then return end
    local first = nil
    for _, j in ipairs(owned(state, 'jeremy_bearimy')) do
      if not AIJ.isDebuffed(j) then first = j break end
    end
    if not first or first.uid ~= joker.uid then return end
    local any = false
    for _, j in ipairs(state.jokers or {}) do
      local id = AIJ.defId(j)
      local def = AIJ.jokerDefs[id or '']
      if def and type(def.triggers) == 'table' and not AIJ.is(j, 'jeremy_bearimy') and not AIJ.isDebuffed(j) and AIJ.exists(j) then
        for _, name in ipairs(BEARIMY_STEPS[which]) do
          local fn = def.triggers[name]
          if fn then
            local s = {}
            for k, v in pairs(step) do s[k] = v end
            if name == 'onRoundStart' or name == 'onBlindDefeated' then s.blind = s.blind or (state.blind and state.blind.id) end
            runTrigger(fn, j, state, s, result)
            any = true
          end
        end
      end
    end
    if any then result:say('Again!', colors.ORANGE) end
  end
end

