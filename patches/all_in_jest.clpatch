local function enrage(joker, result)
  if AIJ.get(joker, 'active') == true then return end
  AIJ.set(joker, 'active', true)
  if result then result:say(AIJ.msg('k_active_ex', 'Active!'), colors.MULT)
  else joker:popup(AIJ.msg('k_active_ex', 'Active!'), colors.MULT) end
end

add {
  key = 'enraging_photo',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 4, y = 7 },
  config = { xmult = 2, active = false },
  vars = function(card)
    return { AIJ.val(card, 'enraging_photo', 'xmult'), AIJ.val(card, 'enraging_photo', 'active') == true and '(Active)' or '(Inactive)' }
  end,
  triggers = {
    onCardSold = function(joker, state, step, result)
      if step.copiedBy then return end
      enrage(joker, result)
    end,
    onCardsRemoved = function(joker, state, step, result)
      if step.copiedBy then return end
      enrage(joker, result)
    end,
    afterRound = function(joker, state, step, result)
      if step.copiedBy or AIJ.get(joker, 'active') ~= true then return end
      AIJ.set(joker, 'active', false)
      result:say(AIJ.msg('k_reset', 'Reset'), colors.ORANGE)
    end,
    afterAllCardsScored = function(joker, state, step, result)
      if AIJ.get(joker, 'active') == true then result:add(xMult(AIJ.num(joker, 'xmult'))) end
    end,
  },
}

AIJ.onJokerGone(function(state, info, sold)
  if sold then return end
  for _, j in ipairs(owned('enraging_photo')) do enrage(j) end
end)

