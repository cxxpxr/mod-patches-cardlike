  ["Enhanced"] = {
    ["m_aij_canvas"] = { name = "Canvas Card", text = "[color=\"#f3a712\"][b]Copies[/b][/color] the rank and suit of card to the [color=\"#f3a712\"][b]right[/b][/color]" },
    ["m_aij_charged"] = { name = "Charged Card", text = "[color=\"#f3a712\"][b]Enhancements[/b][/color] give [color=\"#f3a712\"][b]+#1#%[/b][/color] effect if [color=\"#f3a712\"][b]played with[/b][/color] or [color=\"#f3a712\"][b]held in hand with[/b][/color] this card" },
    ["m_aij_cloud"] = { name = "Cloud Card", text = "[color=\"#f3a712\"][b]Always[/b][/color] shuffled to the [color=\"#f3a712\"][b]top half[/b][/color] of the [color=\"#f3a712\"][b]deck[/b][/color]" },
    ["m_aij_dyscalcular"] = { name = "Dyscalcular Card", text = "Counts as every [color=\"#f3a712\"][b]numbered[/b][/color] rank\n[color=\"#9a9a9a\"](Except for making poker hands)[/color]" },
    ["m_aij_fervent"] = { name = "Fervent Card", text = "Gains [color=\"#3772ff\"][b]+#2#[/b][/color] points when scored" },
    ["m_aij_ice"] = { name = "Ice Card", text = "[color=\"#f3a712\"][b]Always[/b][/color] scores and [color=\"#ff007f\"][b]Ignores[/b][/color] Play selection limit [color=\"#9a9a9a\"]Excess Ice Cards do not[/color] [color=\"#9a9a9a\"]affect hand type[/color]" },
    ["m_aij_lunar"] = { name = "Lunar Card", text = "Apply [color=\"#3772ff\"][b]Points[/b][/color] to [color=\"#f3a712\"][b]Poker[/b][/color] [color=\"#f3a712\"][b]Hand permanently[/b][/color] instead of scoring" },
    ["m_aij_memphis"] = { name = "Memphis Card", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]Blind[/b][/color] skipped this run\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["m_aij_scorched"] = { name = "Scorched Card", text = "When discarded, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#f3a712\"][b]upgrade[/b][/color] discarded [color=\"#f3a712\"][b]poker hand[/b][/color] by [color=\"#f3a712\"][b]#3#[/b][/color] level" },
    ["m_aij_simulated"] = { name = "Simulated Card", text = "[color=\"#f3a712\"][b]Returns[/b][/color] to hand when played for the [color=\"#f3a712\"][b]first[/b][/color] time each round\nDiscarding [color=\"#f3a712\"][b]only[/b][/color] [color=\"#f3a712\"][b]Simulated[/b][/color] cards does [color=\"#f3a712\"][b]not[/b][/color] consume a [color=\"#ff007f\"][b]discard[/b][/color]" },
    ["m_aij_wood"] = { name = "Wood Card", text = "When held in hand, [color=\"#3772ff\"][b]+#3#[/b][/color] points, [color=\"#3772ff\"][b]+#2#[/b][/color] more for each other [color=\"#f3a712\"][b]Wood[/b][/color] card held in hand\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] points)[/color]" },
  },
  ["Joker"] = {
