    if (state.handsPlayed or 0) == 1 then return AIJ.num(joker, 'money') end
    return 0
  end,
}

local function heartsInDeck(state)
  local n = 0
  for _, c in ipairs((state and state.unDrawnCards) or {}) do
    if not AIJ.noRank(c) and c:isSuit('Hearts') then n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'pinup_poster',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 2, y = 39 },
  config = { xmult_gain = 0.2 },
  blueprint_compat = true,
  description = function(r)
    local card = r and r.card
    local gain = AIJ.val(card, 'pinup_poster', 'xmult_gain')
    local x = 1 + (card and heartsInDeck(cardlike.state) or 0) * gain
    return 'Gives ' .. hl('X' .. AIJ.fmt(gain), colors.MULT) .. ' Mult per ' .. hl('Hearts', colors.HEARTS_COLOR)
      .. ' card in your ' .. hl('remaining deck') .. '\n' .. grey('(Currently ') .. hl('X' .. AIJ.fmt(x), colors.MULT) .. grey(' Mult)')
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local n = heartsInDeck(state)
      if n > 0 then result:add(xMult(1 + n * AIJ.num(joker, 'xmult_gain'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'pipine',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 2, y = 8 }, soul_pos = { x = 2, y = 9 },
  config = { discards = 5 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'pipine', 'discards') } end,
  onAdded = function(joker, state)
    local n = AIJ.num(joker, 'discards')
    state.discardsPerRound = state.discardsPerRound + n
    state.discardsLeft = state.discardsLeft + n
  end,
  onRemoved = function(joker, state)
    local n = AIJ.num(joker, 'discards')
    state.discardsPerRound = math.max(0, state.discardsPerRound - n)
    state.discardsLeft = math.max(0, state.discardsLeft - n)
  end,
}

AIJ.addJoker {
