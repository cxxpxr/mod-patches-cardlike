local AIJ = cardlike.require('lib.aij')
local H = cardlike.require('items.pins')
local CH = cardlike.require('items.challenges')

cardlike.filter('consumablePool', function(ids, ctype)
  if ctype ~= 'fruit' or not AIJ.setting('moons_blocking') or not AIJ.setting('moons_enabled') then return nil end
  local state = cardlike.state
  if not state then return nil end
  local present = {}
  for _, area in ipairs({ 'consumables', 'shop', 'pack' }) do
    for _, c in ipairs(cardlike.cards(area) or {}) do
      local ht = H.fruitHand(AIJ.defId(c))
      if ht then present[ht] = true end
    end
  end
  if next(present) == nil then return nil end
  local out = {}
  for _, id in ipairs(ids) do
    local ht = H.fruitHand(id)
    if not ht or not present[ht] then out[#out + 1] = id end
  end
  return out
end)

local MULT_RATE = { 0, 0.3, 0.6 }
if AIJ.settings.mult_appearance == nil then AIJ.settings.mult_appearance = 1 end
AIJ.onNewRun(function(run) run.aij_found_mult = false end)

cardlike.on('onCardObtained', function(state, step)
  local id = AIJ.defId(step.card)
  if id and CH.MULT[id] then AIJ.run.aij_found_mult = true end
end)

cardlike.filter('jokerPool', function(ids)
  local rate = MULT_RATE[tonumber(AIJ.settings.mult_appearance) or 1] or 0
  local state = cardlike.state
  if rate <= 0 or not state or AIJ.run.aij_found_mult or AIJ.owns('little_boy_blue', state) then return nil end
  if not (state:isPhase('shop') or state:isPhase('pack')) then return nil end
  if state:randomFloat() > rate then return nil end
  local out = {}
  for _, id in ipairs(ids) do if CH.MULT[id] then out[#out + 1] = id end end
  if #out == 0 then return nil end
  return out
end)


== file items/pins.lua (473 lines)
local AIJ = cardlike.require('lib.aij')
local ui = cardlike.ui

local H = {}

local later = {}
function H.later(fn) later[#later + 1] = fn end

function H.held(id)
  local out = {}
  for _, p in ipairs(cardlike.cards('pins') or {}) do
    if AIJ.is(p, id) and not AIJ.get(p, 'aij_spent') then out[#out + 1] = p end
  end
  return out
end

function H.spend(pin)
  AIJ.safe(function() pin:getDataStore():set('aij_spent', true) end)
  AIJ.safe(pin.punch, pin)
  AIJ.safe(pin.destroy, pin)
end

H.ANY_TIME = { 'added', 'blindSelect', 'roundStart', 'roundEnd', 'shop' }

function H.addPin(def)
  local e = AIJ.loc('Tag', 'tag_aij_' .. def.key) or {}
  return AIJ.register('addPin', {
    id = def.key,
    readableName = def.readableName or e.name or def.key,
    description = def.description or AIJ.desc('Tag', 'tag_aij_' .. def.key, def.vars),
    sprite = AIJ.sprite('tag_atlas', def.pos),
    minAnte = def.minAnte,
    popWhen = def.popWhen,
    canUse = def.canUse,
    action = def.action,
    shopItem = def.shopItem,
    lite = def.lite,
  }, 'pin')
end

function H.addEventPin(def)
  def.popWhen = H.ANY_TIME
  def.canUse = function(ctx)
    if ctx.self and AIJ.get(ctx.self, 'aij_spent') then return '' end
    return 'Waiting'
  end
  def.action = function() end
  return H.addPin(def)
end

function H.noEdition(cards)
  local out = {}
  for _, c in ipairs(cards or {}) do if AIJ.edition(c) == nil then out[#out + 1] = c end end
  return out
end

function H.deckCards(state)
  local l = state.unDrawnCards
  if not l or #l == 0 then l = state.allCards end
  return l or {}
end

function H.modEdition(short)
  if AIJ.has(short, 'edition') then return AIJ.id(short) end
  return nil
end

function H.setEdition(card, ed)
  if not card or not ed then return false end
  AIJ.safe(card.setEdition, card, ed)
  AIJ.safe(card.punch, card)
  return true
end

function H.editionToRandom(state, cards, ed)
  local c = AIJ.pick(H.noEdition(cards), state)
  if c then H.setEdition(c, ed) end
  return c
end

function H.randomRarity(state)
  local f = state:randomFloat()
  if f < 0.7 then return 'Common' elseif f < 0.95 then return 'Uncommon' end
  return 'Rare'
end

function H.randomConsumableType(state)
  local count = { game = 0, fruit = 0, admin = 0 }
  for _, c in ipairs(cardlike.listContent('consumable') or {}) do
    if count[c.type] then count[c.type] = count[c.type] + 1 end
  end
  local total = count.game + count.fruit + count.admin
  if total <= 0 then return 'game' end
  local r = state:randomFloat() * total
  if r < count.game then return 'game' elseif r < count.game + count.fruit then return 'fruit' end
  return 'admin'
end

function H.builtinPack(kind, level) return 'pack_' .. kind .. '_' .. (level or 0) end

function H.randomPack(state)
  local list = {
    { 'game', 0, 13 }, { 'fruit', 0, 13 }, { 'deck', 0, 13 }, { 'game', 1, 7 }, { 'fruit', 1, 7 }, { 'deck', 1, 7 },
    { 'fool', 0, 12 }, { 'fool', 1, 6 }, { 'admin', 0, 5 }, { 'admin', 1, 3 },
  }
  local total = 0
  for _, e in ipairs(list) do total = total + e[3] end
  local r = state:randomFloat() * total
  for _, e in ipairs(list) do
    r = r - e[3]
    if r <= 0 then return H.builtinPack(e[1], e[2]) end
  end
  return H.builtinPack('game', 0)
end

H.ticketPrecursor = {}
for i = 1, 31, 2 do H.ticketPrecursor['ticket_' .. i] = 'ticket_' .. (i - 1) end

function H.availableTickets(state, baseOnly)
  local out = {}
  for _, t in ipairs(cardlike.listContent('ticket') or {}) do
    local pre = H.ticketPrecursor[t.id]
    if not state:hasTicket(t.id) and (pre == nil or (not baseOnly and state:hasTicket(pre))) then
      out[#out + 1] = t.id
    end
  end
  return out
end

local packQueue = {}
local ownOpens = 0
function H.openPack(id)
  if id and cardlike.contentInfo('pack', id) then packQueue[#packQueue + 1] = id end
end

local sincePack = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then packQueue = {} later = {} return end
  if #later > 0 then
    local list = later
    later = {}
    for _, fn in ipairs(list) do pcall(fn) end
  end
  if #packQueue == 0 then return end
  sincePack = sincePack + (frame.dt or 0)
  if sincePack < 0.3 then return end
  sincePack = 0
  local s = cardlike.state
  if not s or s:isPhase('pack') or s:isPhase('scoring') then return end
  ownOpens = ownOpens + 1
  if cardlike.openPack(packQueue[1]) then
    table.remove(packQueue, 1)
  else
    ownOpens = ownOpens - 1
  end
end)
cardlike.on('onRunStart', function() packQueue = {} ownOpens = 0 later = {} end)

H.packPins = {}
cardlike.on('onPackOpened', function(state, step)
  if ownOpens > 0 then ownOpens = ownOpens - 1 return end
  local packId = AIJ.defId(step.card)
  if not packId then return end
  local pins = cardlike.cards('pins') or {}
  for i = #pins, 1, -1 do
    local p = pins[i]
    local times = H.packPins[AIJ.defId(p) or '']
    if times and not AIJ.get(p, 'aij_spent') then
      H.spend(p)
      for _ = 1, times do H.openPack(packId) end
      return
    end
  end
end)

local BUILTIN_FRUIT = {
  fruit_card_0 = 'STRAIGHT', fruit_card_1 = 'FULL_HOUSE', fruit_card_2 = 'TWO_PAIR', fruit_card_3 = 'HIGH_CARD',
  fruit_card_4 = 'PAIR', fruit_card_5 = 'THREE_OF_A_KIND', fruit_card_6 = 'FLUSH_HOUSE', fruit_card_7 = 'FLUSH_FIVE',
  fruit_card_8 = 'FIVE_OF_A_KIND', fruit_card_9 = 'FOUR_OF_A_KIND', fruit_card_10 = 'FLUSH', fruit_card_11 = 'STRAIGHT_FLUSH',
}
H.MOON_HAND = {
  ['2000_eu16'] = 'Flush House', ['2013_nd15'] = 'Three of a Kind', callisto = 'Flush', charon = 'High Card',
  deimos = 'Four of a Kind', dysnomia = 'Flush Five', europa = 'Flush', iapetus = 'Straight', kamooalewa = 'Full House',
  kuiper = 'Flush Five', luna = 'Full House', nibiru = 'Five of a Kind', nix = 'High Card', oberon = 'Two Pair',
  pallas = 'Flush House', phaethon = 'Pair', phobos = 'Four of a Kind', planet_nine = 'Five of a Kind',
  proteus = 'Straight Flush', titan = 'Straight', triton = 'Straight Flush', umbriel = 'Two Pair', vulcanoid = 'Pair',
  zoozve = 'Three of a Kind', sol = 'Royal Flush',
}

function H.fruitHand(id)
  if not id then return nil end
  if BUILTIN_FRUIT[id] then return BUILTIN_FRUIT[id] end
  local name = H.MOON_HAND[AIJ.short(id)]
  if name then return AIJ.hand(name) end
  return nil
end

H.fruitPins = {}
cardlike.on('onConsumableUsed', function(state, step)
  local c = step.card
  local info = c and c.lastInfo or {}
  if info.kind ~= 'consumable' or info.type ~= 'fruit' then return end
  local pins = cardlike.cards('pins') or {}
  for i = #pins, 1, -1 do
    local p = pins[i]
    local fn = H.fruitPins[AIJ.defId(p) or '']
    if fn and not AIJ.get(p, 'aij_spent') then
      H.spend(p)
      fn(state, H.fruitHand(AIJ.defId(c)), p)
      return
    end
  end
end)

cardlike.filter('price', function(price, card)
  local info = card and card.lastInfo
  if not info then return nil end
  if info.store and info.store.aij_free then return 0 end
  if AIJ.run.frugal_shop and info.area == 'shop' and info.kind ~= 'ticket' then return 0 end
  return nil
end)
cardlike.on('onCardBought', function(state, step)
  local c = step.card
  if c and AIJ.get(c, 'aij_free') then AIJ.safe(function() c:getDataStore():delete('aij_free') end) end
end)

function H.choose(spec)
  local options = spec.options or {}
  if #options == 0 then return nil end
  local per, cols, page = spec.perPage or 16, spec.columns or 4, 1
  local panel
  panel = ui.open {
    modal = true,
    closeOnEscape = spec.skip == true,
    content = function()
      local pages = math.max(1, math.ceil(#options / per))
      if page > pages then page = pages end
      local col = { style = 'window', gap = 10, align = 'center',
        ui.text { text = spec.title or 'Choose', size = 30, color = colors.MONEY } }
      if spec.subtitle then col[#col + 1] = ui.text { text = spec.subtitle, size = 18, color = colors.GREY } end
      local first = (page - 1) * per + 1
      local row
      for i = first, math.min(#options, first + per - 1) do
        if (i - first) % cols == 0 then
          if row then col[#col + 1] = ui.row(row) end
          row = { gap = 8, justify = 'center' }
        end
        local opt = options[i]
        row[#row + 1] = ui.button { label = opt.label, color = opt.color, onPress = function()
          panel.close()
          spec.onPick(opt.value)
        end }
      end
      if row then col[#col + 1] = ui.row(row) end
      if pages > 1 then
        col[#col + 1] = ui.row { gap = 12, align = 'center',
          ui.button { label = '<', color = colors.RED, onPress = function() page = page > 1 and page - 1 or pages end },
          ui.text { text = 'Page ' .. page .. '/' .. pages, size = 20 },
          ui.button { label = '>', color = colors.GREEN, onPress = function() page = page < pages and page + 1 or 1 end },
        }
      end
      if spec.skip then
        col[#col + 1] = ui.button { label = 'Skip', color = colors.GREY, onPress = function() panel.close() end }
      end
      return ui.column(col)
    end,
  }
  return panel
end

function H.consumableOptions(ctype, keep)
  local out = {}
  for _, c in ipairs(cardlike.listContent('consumable') or {}) do
    if c.type == ctype and (not keep or keep(c)) then out[#out + 1] = { label = c.name, value = c.id } end
  end
  return out
end

H.effects = {}

function H.effects.money(state, max) state:mutateMoney(state:random(1, max)) end

function H.effects.open_booster(state) H.openPack(H.randomPack(state)) end

function H.effects.level_hands(state)
  local hands = {}
  for _, ht in ipairs(AIJ.HANDS) do
    local h = state:getHand(ht)
    local secret = ht == 'ROYAL_FLUSH' or ht == 'FLUSH_HOUSE' or ht == 'FIVE_OF_A_KIND' or ht == 'FLUSH_FIVE'
    if h and (not secret or (h.played or 0) > 0) then hands[#hands + 1] = ht end
  end
  for _ = 1, math.min(state:random(1, 2), #hands) do
    local i = state:random(1, #hands)
    state:upgradeHand(hands[i], state:random(1, 3))
    table.remove(hands, i)
  end
end

function H.effects.create_jokers(state, n, rarity, edition)
  if not edition then n = math.min(n, state.freeJokerSlots or 0) end
  for _ = 1, n do
    cardlike.createJoker(rarity or H.randomRarity(state), edition and { edition = edition } or nil)
  end
end

function H.effects.dupe_joker(state, edition)
  local j = AIJ.pick(state.jokers, state)
  if not j then return end
  local copy = AIJ.safe(j.copy, j)
  if copy and edition then copy:setEdition(edition) end
  if not copy and edition then cardlike.createJoker(AIJ.defId(j), { edition = edition }) end
end

function H.effects.create_consumables(state, n, edition)
  if not edition then n = math.min(n, state.freeConsumableSlots or 0) end
  for _ = 1, n do
    cardlike.createConsumable(H.randomConsumableType(state), edition and { edition = edition } or nil)
  end
end

function H.effects.voucher(state)
  local id = AIJ.pick(H.availableTickets(state), state)
  if id then cardlike.redeemTicket(id) end
end

function H.effects.plus_hand(state)
  state.handsPerRound = state.handsPerRound + 1
  state.handsLeft = state.handsLeft + 1
end

function H.effects.plus_discard(state)
  state.discardsPerRound = state.discardsPerRound + 1
  state.discardsLeft = state.discardsLeft + 1
end

function H.randomEnhancement(state)
  local list = {}
  for _, e in ipairs(cardlike.listContent('enhancement') or {}) do
    if e.id ~= 'Default' and e.id ~= 'Prismatic' then list[#list + 1] = e.id end
  end
  return AIJ.pick(list, state)
end

function H.effects.plus_ran_enhance(state)
  for _ = 1, state:random(2, 4) do
    cardlike.addPlayingCard({ enhancement = H.randomEnhancement(state) or 'random' }, { area = 'deck' })
  end
end

function H.effects.give_ran_enhance(state)
  for _ = 1, state:random(3, 8) do
    local c = AIJ.pick(H.deckCards(state), state)
    local e = H.randomEnhancement(state)
    if c and e then c:setEnhancement(e) end
  end
end

function H.effects.ran_tag(state)
  for _ = 1, state:random(1, 5) do
    local id = cardlike.randomPin()
    if id then cardlike.addPin(id) end
  end
end

function H.randomEffect(state, list)
  local good = {}
  for _, e in ipairs(list) do
    if not e.ok or e.ok(state) then good[#good + 1] = e end
  end
  local e = AIJ.pick(good, state)
  if e then e.run(state) end
  return e and e[1]
end

H.addEventPin { key = 'astrology', pos = { x = 0, y = 4 }, minAnte = 999 }
H.fruitPins[AIJ.id('astrology')] = function(state, ht, pin)
  if not ht then return end
  local n = state:random(2, 4)
  state:upgradeHand(ht, n)
  cardlike.centerText('Again! +' .. n .. ' levels', 1.5)
end

local function baseShopJoker(state)
  for _, c in ipairs(state.shopCards or {}) do
    if (c.lastInfo or {}).kind == 'joker' and AIJ.edition(c) == nil and not AIJ.get(c, 'aij_free') then return c end
  end
  return nil
end

local editionPins = {}
local function applyEditionPin(state, edShort)
  local j = baseShopJoker(state)
  if not j then return false end
  H.setEdition(j, H.modEdition(edShort))
  AIJ.set(j, 'aij_free', true)
  return true
end

local function shopEditionPin(key, pos, edShort, minAnte)
  editionPins[#editionPins + 1] = { id = AIJ.id(key), edition = edShort }
  H.addPin {
    key = key, pos = pos, minAnte = minAnte, popWhen = 'shop',
    canUse = function(ctx)
      if baseShopJoker(ctx.state) then return '' end
      return 'Waiting for a shop Joker without an edition'
    end,
    action = function(ctx) applyEditionPin(ctx.state, edShort) end,
  }
end

shopEditionPin('aureate', { x = 2, y = 1 }, 'aureate', 2)
shopEditionPin('glimmer', { x = 2, y = 0 }, 'glimmer')
shopEditionPin('misprinted', { x = 3, y = 1 }, 'misprint', 2)
shopEditionPin('silver', { x = 1, y = 1 }, 'silver', 2)
shopEditionPin('stellar', { x = 0, y = 1 }, 'stellar')

cardlike.on('onShopReroll', function(state)
  for _, e in ipairs(editionPins) do
    for _, p in ipairs(H.held(e.id)) do
      if applyEditionPin(state, e.edition) then H.spend(p) end
    end
  end
end)

local CHAOS = {
  { 'money', run = function(s) H.effects.money(s, 50) end },
  { 'open_booster', run = H.effects.open_booster },
  { 'level_hands', run = H.effects.level_hands },
  { 'create_jokers', ok = function(s) return (s.freeJokerSlots or 0) > 0 end,
    run = function(s) H.effects.create_jokers(s, s:random(1, 4), 'Common') end },
  { 'dupe_joker', ok = function(s) return (s.freeJokerSlots or 0) > 0 and #(s.jokers or {}) > 0 end,
    run = function(s) H.effects.dupe_joker(s) end },
  { 'create_consumables', ok = function(s) return (s.freeConsumableSlots or 0) > 0 end,
    run = function(s) H.effects.create_consumables(s, s:random(2, 3)) end },
}
H.addPin {
  key = 'chaos', pos = { x = 1, y = 0 }, lite = true, popWhen = 'blindSelect',
  action = function(ctx) H.randomEffect(ctx.state, CHAOS) end,
}

H.addPin {
  key = 'fortunate', pos = { x = 4, y = 0 }, popWhen = 'blindSelect',
  canUse = function(ctx)
    if (ctx.state.freeConsumableSlots or 0) > 0 then return '' end
    return 'Needs a free consumable slot'
  end,
  action = function(ctx)
    H.choose {
      title = 'Fortunate Pin', subtitle = 'Choose a Game card to create',
      options = H.consumableOptions('game'),
      onPick = function(id) cardlike.createConsumable(id) end,
    }
  end,
}

H.addEventPin {
  key = 'overstuffed', pos = { x = 3, y = 0 }, lite = true,
  description = 'The next [color="#f3a712"][b]Pack[/b][/color] opened is opened [color="#f3a712"][b]again[/b][/color] for free when it closes\n[color="#9a9a9a"](twice the options and picks)[/color]',
}
H.packPins[AIJ.id('overstuffed')] = 1

H.addPin {
  key = 'soulbound', pos = { x = 0, y = 0 }, minAnte = 4, popWhen = H.ANY_TIME,
  description = 'Creates a random [color="#f3a712"][b]Timed[/b][/color] [color="#d138bf"][b]Legendary[/b][/color] Joker\n[color="#9a9a9a"](Must have room)[/color]',
  canUse = function(ctx)
    if (ctx.state.freeJokerSlots or 0) > 0 then return '' end
    return 'Needs a free Joker slot'
  end,
  action = function(ctx) cardlike.createJoker('Legendary', { sticker = 'timed' }) end,
}

return H


