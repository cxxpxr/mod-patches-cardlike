local GREASE_KEY = 'aij_greasepaint_debuff'

local function greaseMarked(j) return AIJ.safe(function() return j:getDataStore():get(GREASE_KEY) end) == true end
local function greaseMark(j, on)
  AIJ.safe(function()
    if on then j:getDataStore():set(GREASE_KEY, true) else j:getDataStore():delete(GREASE_KEY) end
  end)
end

local function greasepaintUpdate(state)
  local jokers = ofList(state, 'jokers')
  local any = false
  for i, j in ipairs(jokers) do
    if AIJ.is(j, 'greasepaint') then
      any = true
      if not AIJ.isDebuffed(j) then
        for _, n in ipairs({ jokers[i - 1], jokers[i + 1] }) do
          if n and not AIJ.isDebuffed(n) then
            n:setDebuffState(true)
            greaseMark(n, true)
          end
        end
      end
    end
  end
  for i, j in ipairs(jokers) do
    if greaseMarked(j) then
      local l, r = jokers[i - 1], jokers[i + 1]
      local near = any and ((l and AIJ.is(l, 'greasepaint')) or (r and AIJ.is(r, 'greasepaint')))
      if not near then
        if AIJ.isDebuffed(j) then j:setDebuffState(false) end
        greaseMark(j, false)
      end
    end
  end
end

local GREASEPAINT = AIJ.addJoker {
  key = 'greasepaint',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 2, y = 1 },
  blueprint_compat = false,
  config = { xmult = 2 },
  vars = function(card) return { AIJ.val(card, 'greasepaint', 'xmult') } end,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result) greasepaintUpdate(state) end,
    afterAllCardsScored = function(joker, state, step, result)
      local x = AIJ.num(joker, 'xmult')
      for _, j in ipairs(ofList(state, 'jokers')) do
        if j.uid ~= joker.uid and AIJ.isDebuffed(j) then
          result:add(xMult(x))
          result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT, j)
        end
      end
      for _, c in ipairs(step.hand.playedCards or {}) do
        if AIJ.isDebuffed(c) then
          result:add(xMult(x))
          result:say('X' .. AIJ.fmt(x) .. ' Mult', colors.MULT, c)
        end
      end
    end,
  },
}
if GREASEPAINT then
  local since = 0
  cardlike.onFrame(function(frame)
    if not frame.inRun then return end
    since = since + (frame.dt or 0)
    if since < 0.2 then return end
    since = 0
    local state = cardlike.state
    if state and state.money ~= nil then pcall(greasepaintUpdate, state) end
  end)
end

AIJ.addJoker {
