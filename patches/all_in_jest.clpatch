    ["v_aij_recursion_2"] = { name = "Recursion", text = "[color=\"#f3a712\"][b]+#1# Ticket[/b][/color] for sale, tickets cost [color=\"#f3a712\"][b]$#2#[/b][/color] less" },
    ["v_aij_refined_mult"] = { name = "Refined Mult", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["v_aij_seal_of_the_realm"] = { name = "Stamp Of The Realm", text = "[color=\"#f3a712\"][b]Playing cards[/b][/color] may appear with [color=\"#f3a712\"][b]Stamps[/b][/color] that [color=\"#f3a712\"][b]bear[/b][/color] their [color=\"#f3a712\"][b]own[/b][/color] [color=\"#5d5dff\"][b]editions[/b][/color]" },
    ["v_aij_sticker_sheet"] = { name = "Sticker Sheet", text = "[color=\"#f3a712\"][b]Lessens[/b][/color] the effect of [color=\"#ff007f\"][b]detrimental[/b][/color] [color=\"#f3a712\"][b]stickers[/b][/color]" },
    ["v_aij_thaumaturgy"] = { name = "Thaumaturgy", text = "[color=\"#f3a712\"][b]Adds[/b][/color] an additional random [color=\"#d138bf\"][b]Game Pack[/b][/color] to every [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["v_aij_trophy"] = { name = "Trophy", text = "[color=\"#f3a712\"][b]Large Blind[/b][/color] skip Pin has a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to be [color=\"#f3a712\"][b]Gold[/b][/color]" },
    ["v_aij_upper_class"] = { name = "Upper Class", text = "[color=\"#f3a712\"][b]Adds[/b][/color] an additional random [color=\"#1bb18c\"][b]Uncommon Pack[/b][/color] to every [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["v_aij_wax_stamp"] = { name = "Wax Stamp", text = "[color=\"#f3a712\"][b]Playing cards[/b][/color] in [color=\"#f3a712\"][b]Standard[/b][/color] [color=\"#f3a712\"][b]Packs[/b][/color] are [color=\"#f3a712\"][b]twice[/b][/color] as likely to bear a [color=\"#f3a712\"][b]Stamp[/b][/color]" },
