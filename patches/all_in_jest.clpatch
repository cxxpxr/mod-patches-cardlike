}

local INVERTED_BASE = 0.003
local function nancyRoll(state, card)
  if kindOf(card) ~= 'joker' or AIJ.edition(card) then return end
  local amt = 0
  for _, j in ipairs(activeJokers('negative_nancy', state)) do amt = amt + AIJ.num(j, 'amt') end
  if amt <= 1 then return end
  if state:randomFloat() < (amt - 1) * INVERTED_BASE then card:setEdition('Inverted') end
end

local function nancyShop(joker, state, step, result)
  if step.copiedBy then return end
  if activeJokers('negative_nancy', state)[1] ~= joker then return end
  for _, c in ipairs(state.shopCards or {}) do nancyRoll(state, c) end
end

AIJ.addJoker {
  key = 'negative_nancy',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 18, y = 0 },
  config = { amt = 5 },
  blueprint_compat = false,
  vars = function(card) return { AIJ.val(card, 'negative_nancy', 'amt') } end,
  triggers = {
    onShopEnter = nancyShop,
    onShopReroll = nancyShop,
  },
}

cardlike.on('onCardCreated', function(state, step)
  local c = step and step.card
  if not state or not c or not state.jokers then return end
  if #activeJokers('negative_nancy', state) == 0 then return end
  if (c.lastInfo and c.lastInfo.area) ~= 'pack' then return end
  nancyRoll(state, c)
end)

local function invertedJokers(state)
  local n = 0
  for _, j in ipairs((state and state.jokers) or {}) do
    if AIJ.hasEdition(j, 'e_negative') then n = n + 1 end
  end
  return n
end

handSizeTrackers.negative_space = function(joker, state)
  return math.min(AIJ.num(joker, 'max_handsize'), invertedJokers(state) * AIJ.num(joker, 'hand_size'))
end

AIJ.addJoker {
  key = 'negative_space',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 12, y = 12 },
  config = { hand_size = 1, max_handsize = 5 },
  blueprint_compat = false,
  vars = function(card)
    local per, max = AIJ.val(card, 'negative_space', 'hand_size'), AIJ.val(card, 'negative_space', 'max_handsize')
    return { per, card and math.min(max, invertedJokers(cardlike.state) * per) or 0, max }
  end,
  in_pool = function(state) return invertedJokers(state) > 0 end,
  onRemoved = removeTrackedHandSize,
}

AIJ.addJoker {
