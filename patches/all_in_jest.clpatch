local FRUIT_HAND = {
  fruit_card_0 = 'STRAIGHT', fruit_card_1 = 'FULL_HOUSE', fruit_card_2 = 'TWO_PAIR', fruit_card_3 = 'HIGH_CARD',
  fruit_card_4 = 'PAIR', fruit_card_5 = 'THREE_OF_A_KIND', fruit_card_6 = 'FLUSH_HOUSE', fruit_card_7 = 'FLUSH_FIVE',
  fruit_card_8 = 'FIVE_OF_A_KIND', fruit_card_9 = 'FOUR_OF_A_KIND', fruit_card_10 = 'FLUSH', fruit_card_11 = 'STRAIGHT_FLUSH',
}
local carcosa = nil

AIJ.addJoker {
  key = 'lost_carcosa',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 16, y = 7 },
  config = { min = 50, max = 200 },
  description = function(r)
    local card = r and r.card
    return 'Used ' .. B('Fruit cards', AIJ.colors.PLANET) .. ' level up their hand by a random '
      .. B(AIJ.fmt(AIJ.val(card, 'lost_carcosa', 'min')) .. '%') .. ' to '
      .. B(AIJ.fmt(AIJ.val(card, 'lost_carcosa', 'max')) .. '%') .. ' of the normal amount'
      .. '\n' .. grey('(A part of a level is a chance for one more level)')
  end,
  triggers = {
    onConsumableUsed = function(joker, state, step, result)
      local used = step.card
      if consType(used) ~= 'fruit' then return end
      local lo, hi = AIJ.num(joker, 'min'), AIJ.num(joker, 'max')
      local p = state:random(math.floor(lo), math.floor(hi))
      p = math.floor(p / 5 + 0.5) * 5
      if not carcosa or carcosa.uid ~= used.uid then
        carcosa = { uid = used.uid, factor = 1, hand = FRUIT_HAND[AIJ.defId(used) or ''], time = cardlike.time() }
      end
      carcosa.factor = carcosa.factor * p / 100
      result:say(p .. '%', AIJ.colors.PLANET)
    end,
  },
}

cardlike.filter('handLevel', function(levels, handType)
  local c = carcosa
  if not c or type(levels) ~= 'number' or levels <= 0 then return nil end
  if cardlike.time() - c.time > 20 then carcosa = nil return nil end
  if c.hand and c.hand ~= handType then return nil end
  carcosa = nil
  local v = levels * c.factor
  local whole = math.floor(v)
  local state = cardlike.state
  if v > whole and state and state:randomFloat() < v - whole then whole = whole + 1 end
  return whole
end)

AIJ.addJoker {
  key = 'low_priest',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 1, y = 9 }, lite = true,
  config = { xmult = 1, initial_xmult = 3, xmult_mod = 0.2 },
  vars = function(card)
    return { AIJ.val(card, 'low_priest', 'initial_xmult'), AIJ.val(card, 'low_priest', 'xmult_mod') }
  end,
  triggers = {
    afterAllCardsScored = function(joker, state, step, result)
      local hand = step.hand and state:getHand(step.hand.handType)
      local level = hand and hand.level or 1
      local x = math.max(1, AIJ.num(joker, 'initial_xmult') - AIJ.num(joker, 'xmult_mod') * level)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

AIJ.addJoker {
  key = 'lucignolo',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 14, y = 2 },
  config = { dollars = 5 },
  vars = function(card) return { AIJ.val(card, 'lucignolo', 'dollars') } end,
  triggers = {
    onCardsRemoved = function(joker, state, step, result)
      local n = step.cards and #step.cards or 0
      if n > 0 then result:add(plusMoney(n * AIJ.num(joker, 'dollars'))) end
    end,
  },
}

AIJ.addJoker {
  key = 'lucina',
  rarity = 3, cost = 8, atlas = 'joker_atlas', pos = { x = 9, y = 11 },
  blueprint_compat = false,
  triggers = {
    beforeRound = function(joker, state, step, result)
      if step.copiedBy then return end
      local list = state.jokers or {}
      local idx
      for i, j in ipairs(list) do if j == joker then idx = i break end end
      if not idx or idx < 2 then return end
      local left = list[idx - 1]
      if AIJ.safe(left.isLocked, left) then return end
      left:destroy()
      local right = list[idx + 1]
      if right then
        local e = randomEdition(state, false)
        if e then right:setEdition(e) right:punch() end
      end
      result:say('Slice!', colors.MULT)
    end,
  },
}

local function countEnhanced(state, id, list)
  local n = 0
  for _, c in ipairs(list or (state and state.allCards) or {}) do
    if hasEnh(c, id) then n = n + 1 end
  end
  return n
end

AIJ.addJoker {
  key = 'lucky_horseshoe',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 12, y = 14 },
  config = { dollars = 3, xmult = 1.5, odds_money = 2, odds_mult = 3 },
  vars = function(card)
    local id = 'lucky_horseshoe'
    return { AIJ.prob(), AIJ.val(card, id, 'odds_money'), AIJ.val(card, id, 'odds_money'), AIJ.val(card, id, 'odds_mult'),
      AIJ.val(card, id, 'dollars'), AIJ.val(card, id, 'xmult') }
  end,
  in_pool = function(state) return countEnhanced(state, 'm_lucky') > 0 end,
  triggers = {
    onScoreInHand = function(joker, state, step, result)
      local c = step.card
      if AIJ.isDebuffed(c) or not hasEnh(c, 'm_lucky') then return end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds_money'))) then
        result:add(plusMoney(AIJ.num(joker, 'dollars')))
      end
      if state:chance(1 / math.max(1, AIJ.num(joker, 'odds_mult'))) then
        result:add(xMult(AIJ.num(joker, 'xmult')))
      end
    end,
  },
}

AIJ.addJoker {
  key = 'lucky_seven',
  rarity = 2, cost = 7, atlas = 'joker_atlas', pos = { x = 1, y = 0 },
  blueprint_compat = false,
  triggers = {
    beforeAllCardsScored = function(joker, state, step, result)
      if step.copiedBy or not step.hand then return end
      local changed = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if rankOf(c) == 7 and not AIJ.enhancement(c) and not AIJ.isDebuffed(c) then
          c:setEnhancement(AIJ.vanilla('m_lucky'))
          c:punch()
          changed = true
        end
      end
      if changed then result:say('Lucky!') end
    end,
  },
}

AIJ.addJoker {
