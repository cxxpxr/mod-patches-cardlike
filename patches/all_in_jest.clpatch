end)

local function randomLegendary(state)
  local id = AIJ.safe(cardlike.randomJoker, 'Legendary')
  if id then return id end
  local pool = {}
  for _, j in ipairs(cardlike.listContent('joker') or {}) do
    if j.rarity == 'Legendary' then pool[#pool + 1] = j.id end
  end
  return AIJ.pick(pool, state)
end

