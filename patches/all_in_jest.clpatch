AIJ.addJoker {
  key = 'flying_ace',
  rarity = 1, cost = 5, atlas = 'joker_atlas', pos = { x = 0, y = 0 },
  blueprint_compat = false,
  config = { dollar_gain = 2, dollars = 0, aces = {} },
