local function privilegeShop(joker, state)
  local slots = math.max(1, state.cardsAvailableInShopCount or 2)
  for _ = 1, slots do
    if state:randomFloat() < 0.01 then
      local id = cardlike.randomJoker('Legendary')
      if id then cardlike.addShopItem(id) end
    end
  end
end
