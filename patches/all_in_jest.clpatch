add {
  key = 'elf',
  rarity = 2, cost = 6, atlas = 'joker_atlas', pos = { x = 12, y = 13 },
  config = { current_skips = 0, skips = 2, tags = 2 },
  description = function(r)
    local card = r and r.card
    local text = AIJ.fill((AIJ.loc('Joker', 'j_aij_elf') or {}).text or '', {
      AIJ.val(card, 'elf', 'current_skips'), AIJ.val(card, 'elf', 'skips'), AIJ.val(card, 'elf', 'tags') })
    return (text:gsub('Investment Pins', 'Cash Pins'))
  end,
  triggers = {
    onBlindSkipped = function(joker, state, step, result)
      if step.copiedBy then return end
      local n = AIJ.add(joker, 'current_skips', 1)
      local need = AIJ.num(joker, 'skips')
      if n < need then result:say(AIJ.fmt(n) .. '/' .. AIJ.fmt(need), colors.ORANGE)
      elseif n == need then result:say(AIJ.msg('k_active_ex', 'Active!'), colors.ORANGE) end
    end,
    onSold = function(joker, state, step, result)
      if AIJ.num(joker, 'current_skips') < AIJ.num(joker, 'skips') then return end
      local pin = AIJ.vanilla('tag_investment')
      for _ = 1, AIJ.num(joker, 'tags') do cardlike.addPin(pin) end
      result:say(AIJ.msg('k_aij_merry_christmas', 'Merry Christmas!'), colors.GREEN)
    end,
  },
}

