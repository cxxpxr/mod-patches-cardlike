add {
  key = 'dongfang',
  rarity = 4, cost = 20, atlas = 'legendary_atlas', pos = { x = 1, y = 6 }, soul_pos = { x = 1, y = 7 },
  blueprint_compat = false,
  config = { triggers = 2, total_triggers = 2 },
  description = withNote('dongfang', function(card) return { AIJ.val(card, 'dongfang', 'total_triggers') } end),
  triggers = {
    onConsumableUsed = function(joker, state, step, result)
      if step.copiedBy or consumableType(step.card) ~= 'fruit' then return end
      local id = AIJ.defId(step.card)
      local ht = id and FRUIT_HAND[id]
      if not ht then
        local ci = id and cardlike.contentInfo('consumable', id)
        ht = ci and ci.handType
      end
      if not ht then return end
      local n = AIJ.num(joker, 'total_triggers')
      state:upgradeHand(ht, n)
      result:say(AIJ.msg('k_again_ex', 'Again!') .. ' x' .. AIJ.fmt(n), colors.ORANGE)
    end,
  },
}

local DONG_SKIP = { extra_value = true, rarity = true, card_limit = true }
local function dongtongSync()
  local jokers = cardlike.cards('jokers') or {}
  local n = #owned('dongtong')
  for _, j in ipairs(jokers) do
    local id = AIJ.defId(j)
    local defaults = id and not AIJ.isId(id, 'dongtong') and AIJ.defaults[id] or nil
    if defaults and AIJ.isId(id, 'czar') then
      local copied = AIJ.get(j, 'aij_czar_copied')
      defaults = copied and AIJ.defaults[copied] or nil
    end
    if defaults then
      local ds = j:getDataStore()
      local prev = tonumber(ds:get('aij_dongtong_n')) or 0
      if prev ~= n then
        local ratio = (1 + n) / (1 + prev)
        for k, v in pairs(defaults) do
          if type(v) == 'number' and not DONG_SKIP[k] then
            local cur = tonumber(AIJ.get(j, k))
            if cur and not ((k == 'x_mult' or k == 'x_chips') and cur == 1) then AIJ.set(j, k, cur * ratio) end
          end
        end
        ds:set('aij_dongtong_n', n)
      end
    end
  end
end

cardlike.on('onCardObtained', function() dongtongSync() end)
cardlike.on('beforeAllCardsScored', function() dongtongSync() end)
cardlike.on('onRoundStart', function() dongtongSync() end)
AIJ.onJokerGone(function() dongtongSync() end)
local dongtongClock = 0
cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  dongtongClock = dongtongClock + (frame.dt or 0)
  if dongtongClock < 0.5 then return end
  dongtongClock = 0
  dongtongSync()
end)

cardlike.filter('blindTarget', function(target)
  local n = #owned('dongtong')
  if n == 0 or type(target) ~= 'number' then return nil end
  return target * (2 ^ n)
end)

