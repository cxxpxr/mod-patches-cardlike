    ["j_aij_adoring_joker"] = { name = "Adoring Joker", text = "[color=\"#f3a712\"][b]After[/b][/color] [color=\"#f3a712\"][b]Jokers[/b][/color] have triggered, set [color=\"#ff007f\"][b]Mult[/b][/color] to the [color=\"#f3a712\"][b]highest[/b][/color] [color=\"#ff007f\"][b]Mult[/b][/color] reached this [color=\"#f3a712\"][b]Ante[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]#1# [/b][/color][color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_akahachi"] = { name = "Akahachi", text = "" },
    ["j_aij_alas"] = { name = "Alas!", text = "This Joker gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points whenever a card is [color=\"#ff007f\"][b]discarded[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Points)[/color]" },
    ["j_aij_alexandre"] = { name = "Alexandre", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]played hand[/b][/color] is only [color=\"#388f58\"][b]Club[/b][/color] [color=\"#f3a712\"][b]Kings[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_alien_joker"] = { name = "Alien Joker", text = "[color=\"#f3a712\"][b]Forces 1[/b][/color] card to be selected\n[color=\"#f3a712\"][b]Force-selected[/b][/color] cards give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when scored" },
