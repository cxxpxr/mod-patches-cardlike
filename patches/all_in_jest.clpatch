    ["j_aij_hijacker"] = { name = "Hijacker", text = "" },
    ["j_aij_his_majesty"] = { name = "His Majesty", text = "" },
    ["j_aij_historian"] = { name = "Historian", text = "Adds [color=\"#ff007f\"][b]Mult[/b][/color] equal to [color=\"#f3a712\"][b]#1#X[/b][/color] the [color=\"#f3a712\"][b]sell value[/b][/color] of the last sold Joker\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_histrio"] = { name = "Histrio", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] more for each [color=\"#f3a712\"][b]unused hand[/b][/color] at end of round" },
    ["j_aij_hofnarr_the_barbarian"] = { name = "Hofnarr the Barbarian", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult On [color=\"#f3a712\"][b]Finisher Boss Blinds[/b][/color], [color=\"#f3a712\"][b]disables[/b][/color] them and gives [color=\"#ff007f\"][b]X#2#[/b][/color] Mult" },
    ["j_aij_holy_bible"] = { name = "Holy Bible", text = "" },
    ["j_aij_homemade_comic"] = { name = "Homemade Comic", text = "Scored [color=\"#f3a712\"][b]Charged Cards[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_honest_john"] = { name = "Honest John", text = "" },
    ["j_aij_honker"] = { name = "Honker", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult when a [color=\"#f3a712\"][b]Multicard[/b][/color] is scored\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_hot_sauce"] = { name = "Hot Sauce", text = "" },
    ["j_aij_identity_theif"] = { name = "Identity Theif", text = "" },
    ["j_aij_idiot_box"] = { name = "Idiot Box", text = "" },
    ["j_aij_ijoker_co"] = { name = "iJoker.co", text = "[color=\"#f3a712\"][b]Two[/b][/color] random [color=\"#f3a712\"][b]Pins[/b][/color] available for purchase each [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["j_aij_illuminated_joker"] = { name = "Illuminated Joker", text = "[color=\"#f3a712\"][b]Gold[/b][/color] Pins are [color=\"#f3a712\"][b]more[/b][/color] likely to appear" },
    ["j_aij_imageboard"] = { name = "Imageboard", text = "Each [color=\"#f3a712\"][b]scored[/b][/color] card gives [color=\"#ff007f\"][b]+#1#[/b][/color] Mult for each [color=\"#f3a712\"][b]time[/b][/color] its [color=\"#f3a712\"][b]rank[/b][/color] has [color=\"#f3a712\"][b]scored[/b][/color] this hand\n[color=\"#9a9a9a\"](ex. [/color][color=\"#f3a712\"][b]2 2 2[/b][/color][color=\"#9a9a9a\"] -> [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"], [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"], [/color][color=\"#ff007f\"][b]+#3#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_imperial_bower"] = { name = "Imperial Bower", text = "[color=\"#f3a712\"][b]First card[/b][/color] drawn each round counts as [color=\"#f3a712\"][b]any[/b][/color] rank and suit\n[color=\"#9a9a9a\"](Ranks can't make poker hands)[/color]" },
    ["j_aij_imperious_joker"] = { name = "Imperious Joker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if played hand contains a [color=\"#f3a712\"][b]Royal Flush[/b][/color]" },
    ["j_aij_in_memorium"] = { name = "In Memoriam", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult every time an [color=\"#4584fa\"][b]Admin Pack[/b][/color] is opened\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\nAfter acquiring this [color=\"#f3a712\"][b]Joker[/b][/color], [color=\"#f3a712\"][b]One[/b][/color] pack in the next [color=\"#f3a712\"][b]shop[/b][/color] will be an [color=\"#4584fa\"][b]Admin Pack[/b][/color]" },
    ["j_aij_in_vino_veritas"] = { name = "In Vino Veritas", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] hand size when a [color=\"#f3a712\"][b]consumable[/b][/color] is used, [color=\"#f3a712\"][b]resets[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Hand Size)[/color]\n[color=\"#9a9a9a\"](Max [/color][color=\"#f3a712\"][b]+#3#[/b][/color][color=\"#9a9a9a\"] Hand Size)[/color]" },
    ["j_aij_infamous_machine"] = { name = "Infamous Machine", text = "After the [color=\"#f3a712\"][b]first draw[/b][/color] of each round, [color=\"#ff007f\"][b]destroy[/b][/color] the [color=\"#f3a712\"][b]leftmost[/b][/color] [color=\"#f3a712\"][b]playing card[/b][/color] and this [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_infinite_jest"] = { name = "Infinite Jest", text = "Level up [color=\"#f3a712\"][b]all poker[/b][/color] [color=\"#f3a712\"][b]hands[/b][/color] when [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated" },
    ["j_aij_infuriating_note"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"I've taken your stuff,[/color] [color=\"#9a9a9a\"]but you keep pushing through;[/color] [color=\"#9a9a9a\"]I'll have to try harder,[/color] [color=\"#9a9a9a\"]so rats off to you!\" -R. R.[/color]" },
    ["j_aij_infuriating_note_2"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"Some packs are red,[/color] [color=\"#9a9a9a\"]but more of them blue;[/color] [color=\"#9a9a9a\"]no matter what's in 'em,[/color] [color=\"#9a9a9a\"]I'll steal them from you![/color] [color=\"#9a9a9a\"]Thanks for the stuff, joker!\" -R. R.[/color]" },
    ["j_aij_infuriating_note_3"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"What I wouldn't give,[/color] [color=\"#9a9a9a\"]to see the look on your face.[/color] [color=\"#9a9a9a\"]You wished for an item,[/color] [color=\"#9a9a9a\"]and found this note in its place![/color] [color=\"#9a9a9a\"]Thanks for your continued patronage[/color] [color=\"#9a9a9a\"]Fufufufufufu...!\" -R. R.[/color]" },
    ["j_aij_infuriating_note_4"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"I should just kill you,[/color] [color=\"#9a9a9a\"]but that wouldn't be hard;[/color] [color=\"#9a9a9a\"]so just for a laugh,[/color] [color=\"#9a9a9a\"]I've stolen your card![/color] [color=\"#9a9a9a\"]Good luck, fool!\" -R. R.[/color]" },
    ["j_aij_infuriating_note_5"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"If you were to find me,[/color] [color=\"#9a9a9a\"]I'd make you bow on your knees.[/color] [color=\"#9a9a9a\"]You're just a rodent,[/color] [color=\"#9a9a9a\"]and I'm the Big Cheese!\" -R. R.[/color]" },
    ["j_aij_infuriating_note_6"] = { name = "Infuriating Note", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult [color=\"#5d5dff\"][b]Inverted[/b][/color] duplicates of this Joker may appear in the [color=\"#f3a712\"][b]Shop[/b][/color] and [color=\"#f3a712\"][b]Fool Packs[/b][/color]\n[color=\"#9a9a9a\"]\"You want a way through,[/color] [color=\"#9a9a9a\"]but you don't know enough yet;[/color] [color=\"#9a9a9a\"]The path is for you,[/color] [color=\"#9a9a9a\"]so don't cheat on the net!\" -R. R.[/color]" },
    ["j_aij_interstate"] = { name = "Interstate", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Hands this round if [color=\"#f3a712\"][b]first[/b][/color] hand of round contains a [color=\"#f3a712\"][b]Straight[/b][/color]" },
    ["j_aij_investment_banker"] = { name = "Investment Banker", text = "" },
    ["j_aij_invisible_man"] = { name = "Invisible Man", text = "All [color=\"#f3a712\"][b]face cards[/b][/color] count as [color=\"#f3a712\"][b]Kings[/b][/color], [color=\"#f3a712\"][b]Queens[/b][/color], and [color=\"#f3a712\"][b]Jacks[/b][/color]\n[color=\"#9a9a9a\"](Except for making poker hands)[/color]" },
    ["j_aij_iron"] = { name = "Iron", text = "If played hand is [color=\"#f3a712\"][b]Four of a Kind[/b][/color], retrigger all scoring cards" },
    ["j_aij_isonomic_joker"] = { name = "Isonomic Joker", text = "Played cards with [color=\"#f3a712\"][b]Star[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#f3a712\"][b]Consumable[/b][/color] card when scored\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_j_file"] = { name = "J-File", text = "At the start of the [color=\"#f3a712\"][b]round[/b][/color], search [color=\"#f3a712\"][b]#1#[/b][/color] card from your [color=\"#f3a712\"][b]deck[/b][/color] to your hand" },
    ["j_aij_jack_horner"] = { name = "Jack Horner", text = "" },
    ["j_aij_jack_o_lantern"] = { name = "Jack o' Lantern", text = "" },
    ["j_aij_jack_of_all_trades"] = { name = "Jack of All Trades", text = "[color=\"#f3a712\"][b]Jacks[/b][/color] count as any [color=\"#f3a712\"][b]suit[/b][/color]" },
    ["j_aij_jack_sprat"] = { name = "Jack Sprat", text = "" },
    ["j_aij_jackpot"] = { name = "Jackpot", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] at end of round, increases by [color=\"#f3a712\"][b]$#2#[/b][/color] when a [color=\"#f3a712\"][b]Lucky[/b][/color] [color=\"#f3a712\"][b]Card[/b][/color] successfully triggers" },
    ["j_aij_jaffas"] = { name = "Jaffas", text = "" },
    ["j_aij_jamie_credits_joker"] = { name = "Jamie!", text = "[color=\"#9a9a9a\"]\"me and nevernamed are very good friends\"[/color] [color=\"#9a9a9a\"]\"we kiss on the mouth sometimes\"[/color]" },
    ["j_aij_janus"] = { name = "Janus", text = "Effects of [color=\"#f3a712\"][b]editions[/b][/color], [color=\"#f3a712\"][b]enhancements[/b][/color], and [color=\"#f3a712\"][b]stamps[/b][/color] on [color=\"#f3a712\"][b]face cards[/b][/color] are [color=\"#1bb18c\"][b]doubled[/b][/color]" },
    ["j_aij_jawbreaker"] = { name = "Jawbreaker", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Stone[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult if played hand contains no [color=\"#f3a712\"][b]unscored cards[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Kiwi[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_jeez_louise"] = { name = "Jeez Louise", text = "" },
    ["j_aij_jeff_the_joker"] = { name = "Jeff the Joker", text = "When [color=\"#f3a712\"][b]Beta Blind[/b][/color] is selected, [color=\"#ff007f\"][b]destroy[/b][/color] all other Jokers and this Joker gains [color=\"#ff007f\"][b]X#2#[/b][/color] Mult for each\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_jelly_beans"] = { name = "Jelly Beans", text = "" },
    ["j_aij_jeremy_bearimy"] = { name = "Jeremy Bearimy", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all [color=\"#f3a712\"][b]effects[/b][/color] that trigger when a Blind is [color=\"#f3a712\"][b]selected[/b][/color] or [color=\"#f3a712\"][b]defeated[/b][/color]" },
    ["j_aij_jerko"] = { name = "Jerko", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_jester_zombie"] = { name = "Jester Zombie", text = "Retrigger all [color=\"#f3a712\"][b]scored[/b][/color] cards if a [color=\"#f3a712\"][b]playing card[/b][/color] has been [color=\"#ff007f\"][b]destroyed[/b][/color] this blind [color=\"#9a9a9a\"]#1#[/color]" },
    ["j_aij_jesters_privelege"] = { name = "Jester's Privilege", text = "[color=\"#d138bf\"][b]Legendary[/b][/color] Jokers may appear in the [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_jestress"] = { name = "Jestress", text = "" },
    ["j_aij_jill_sprat"] = { name = "Jill Sprat", text = "" },
    ["j_aij_jocker"] = { name = "jocker", text = "" },
    ["j_aij_joculator"] = { name = "Joculator", text = "Draw up to [color=\"#f3a712\"][b]twice[/b][/color] your hand size if you have [color=\"#f3a712\"][b]0[/b][/color] [color=\"#ff007f\"][b]discards[/b][/color] and [color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#3772ff\"][b]hand[/b][/color] remaining" },
    ["j_aij_jogre"] = { name = "Jogre", text = "Sets the [color=\"#f3a712\"][b]end of round[/b][/color] payout to [color=\"#f3a712\"][b]always[/b][/color] be [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_joka_lisa"] = { name = "Joka Lisa", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]hand[/b][/color] [color=\"#f3a712\"][b]size[/b][/color] above [color=\"#f3a712\"][b]7[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_joker_baby"] = { name = "Joker Baby", text = "Scoring [color=\"#f3a712\"][b]2s[/b][/color], [color=\"#f3a712\"][b]3s[/b][/color], [color=\"#f3a712\"][b]4s[/b][/color], and [color=\"#f3a712\"][b]5s[/b][/color] permanently gain [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_joker_png"] = { name = "Joker.png", text = "This Joker copies the ability of a random discovered [color=\"#f3a712\"][b]Joker[/b][/color] from your [color=\"#f3a712\"][b]collection[/b][/color]\n[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to reroll copied Joker, the next use this ante costs [color=\"#f3a712\"][b]+$#2#[/b][/color]" },
    ["j_aij_joker_sighting"] = { name = "Joker Sighting", text = "" },
    ["j_aij_jokey_bear"] = { name = "Jokey Bear", text = "If score of [color=\"#f3a712\"][b]played hand[/b][/color] exceeds the [color=\"#f3a712\"][b]total blind[/b][/color] [color=\"#f3a712\"][b]requirement[/b][/color], [color=\"#ff007f\"][b]X#1#[/b][/color] Mult and earn [color=\"#f3a712\"][b]$#2#[/b][/color]\n[color=\"#f3a712\"][b]Retriggers[/b][/color] until score does not exceed [color=\"#f3a712\"][b]total[/b][/color] [color=\"#f3a712\"][b]blind requirement[/b][/color]" },
    ["j_aij_jokia"] = { name = "Jokia", text = "" },
    ["j_aij_jongleur"] = { name = "Jongleur", text = "[color=\"#f3a712\"][b]-$#1#[/b][/color] [color=\"#1bb18c\"][b]reroll[/b][/color] cost" },
    ["j_aij_joqr"] = { name = "Joqr", text = "" },
    ["j_aij_jpeg"] = { name = ".jpeg", text = "If [color=\"#f3a712\"][b]first hand[/b][/color] of round contains [color=\"#f3a712\"][b]no[/b][/color] repeating [color=\"#f3a712\"][b]suits[/b][/color], apply [color=\"#f3a712\"][b]Wild[/b][/color] to all scoring [color=\"#f3a712\"][b]unenhanced[/b][/color] cards" },
    ["j_aij_judge"] = { name = "Judge", text = "" },
    ["j_aij_juggle_game"] = { name = "Juggle Game", text = "" },
    ["j_aij_jumbo_joker"] = { name = "Jumbo Joker", text = "Only [color=\"#f3a712\"][b]Jumbo[/b][/color] and [color=\"#f3a712\"][b]Mega[/b][/color] [color=\"#f3a712\"][b]Packs[/b][/color] can appear" },
    ["j_aij_jumbocarrot_credits_joker"] = { name = "Jumbocarrot", text = "[color=\"#9a9a9a\"]\"Hi Alex\"[/color]" },
    ["j_aij_kaiju"] = { name = "Kaiju", text = "" },
    ["j_aij_kaleidoscope"] = { name = "Kaleidoscope", text = "" },
    ["j_aij_kalyptos"] = { name = "Kalyptos", text = "Reveals the next [color=\"#f3a712\"][b]#1#[/b][/color] cards in your deck\n[color=\"#V1#\"][b]Activated Ability[/b][/color] [color=\"#f3a712\"][b]Flip[/b][/color] your deck upside down, drawing from and revealing the cards previously on the bottom" },
    ["j_aij_kasperle"] = { name = "Kasperle", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if you have purchased a [color=\"#f3a712\"][b]Ticket[/b][/color] this [color=\"#f3a712\"][b]Ante[/b][/color] [color=\"#9a9a9a\"]#2#[/color]" },
    ["j_aij_killigrew"] = { name = "Killigrew", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult for every [color=\"#f3a712\"][b]Ticket[/b][/color] owned\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_kilroy"] = { name = "Kilroy", text = "[color=\"#f3a712\"][b]Double[/b][/color] this Joker's [color=\"#3772ff\"][b]Point[/b][/color] value when [color=\"#f3a712\"][b]sold[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_kingmaker"] = { name = "Kingmaker", text = "All scoring cards have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to be converted to [color=\"#f3a712\"][b]Kings[/b][/color] after scoring" },
    ["j_aij_komar"] = { name = "Komar", text = "All [color=\"#f3a712\"][b]scored[/b][/color] cards gain [color=\"#3772ff\"][b]Points[/b][/color] equal to the base [color=\"#3772ff\"][b]Point value[/b][/color] of all [color=\"#f3a712\"][b]other[/b][/color] played cards" },
    ["j_aij_krampus"] = { name = "Krampus", text = "Scored [color=\"#f3a712\"][b]Gilded cards[/b][/color] turn into [color=\"#f3a712\"][b]Rock cards[/b][/color]\n[color=\"#f3a712\"][b]Rock cards[/b][/color] earn [color=\"#f3a712\"][b]$#1#[/b][/color] when scored" },
    ["j_aij_kuruko"] = { name = "Kuroko", text = "Scored cards give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per card of matching [color=\"#f3a712\"][b]rank[/b][/color] [color=\"#f3a712\"][b]remaining[/b][/color] in your [color=\"#f3a712\"][b]deck[/b][/color]" },
    ["j_aij_la_commedia_e_finita"] = { name = "La Commedia è Finita", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult when a [color=\"#f3a712\"][b]face[/b][/color] card is [color=\"#f3a712\"][b]destroyed[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_landlord"] = { name = "Landlord", text = "" },
    ["j_aij_laurel"] = { name = "Laurel", text = "Gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]enhanced[/b][/color] card in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_lavatch"] = { name = "Lavatch", text = "Scored [color=\"#V1#\"][b]#3#s[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult, increases by [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a [color=\"#V1#\"][b]#3#[/b][/color] is scored\n[color=\"#9a9a9a\"](Suit changes at end of round)[/color]" },
    ["j_aij_lawfirm"] = { name = "Lawfirm", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#3#[/b][/color] for a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to disable the [color=\"#f3a712\"][b]Boss Blind[/b][/color]" },
    ["j_aij_le_fils_de_banane"] = { name = "Le fils de Banane", text = "Scored [color=\"#f3a712\"][b]face[/b][/color] cards give [color=\"#ff007f\"][b]+#3#[/b][/color] Mult, but have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#ff007f\"][b]destroy[/b][/color] themselves" },
    ["j_aij_lead"] = { name = "Lead", text = "If played hand is [color=\"#f3a712\"][b]Straight[/b][/color], retrigger all scoring cards" },
    ["j_aij_legerdemain"] = { name = "Legerdemain", text = "[color=\"#ff007f\"][b]+#1# Discards[/b][/color] this round when a [color=\"#f3a712\"][b]Joker[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color] during a [color=\"#f3a712\"][b]Blind[/b][/color]" },
    ["j_aij_lemarchand_cube"] = { name = "LeMarchand Cube", text = "Create a random [color=\"#4584fa\"][b]Admin[/b][/color] card every [color=\"#f3a712\"][b]#2#[/b][/color] [color=\"#d138bf\"][b]Game[/b][/color] cards used\n[color=\"#9a9a9a\"](Must have room)[/color]\n[color=\"#9a9a9a\"]([/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"]/[/color][color=\"#f3a712\"][b]#2#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_lexicon"] = { name = "Lexicon", text = "Adds [color=\"#ff007f\"][b]Mult[/b][/color] equal to the [color=\"#f3a712\"][b]sum[/b][/color] of all digits in the [color=\"#f3a712\"][b]ability descriptions[/b][/color] of all other owned [color=\"#f3a712\"][b]Jokers[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_li_keji"] = { name = "Li Keji", text = "" },
    ["j_aij_liftoff"] = { name = "Liftoff", text = "" },
    ["j_aij_line_in_the_sand"] = { name = "Line in the Sand", text = "[color=\"#f3a712\"][b]Discarded[/b][/color] cards do not return to [color=\"#f3a712\"][b]deck[/b][/color] until end of Ante" },
    ["j_aij_liquorice"] = { name = "Liquorice", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Mult[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when hands [color=\"#ff007f\"][b]Mult[/b][/color] exceeds [color=\"#3772ff\"][b]Points[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Grace[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_little_boy_blue"] = { name = "Little Boy Blue", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points Only [color=\"#3772ff\"][b]Point[/b][/color] Jokers appear" },
    ["j_aij_little_devil"] = { name = "Little Devil", text = "When [color=\"#f3a712\"][b]skipping[/b][/color] a [color=\"#f3a712\"][b]Blind[/b][/color], create a [color=\"#f3a712\"][b]Standard[/b][/color], [color=\"#d138bf\"][b]Charm[/b][/color], [color=\"#13afce\"][b]Meteor[/b][/color], [color=\"#4584fa\"][b]Ethereal[/b][/color], or [color=\"#ff007f\"][b]Buffoon [/b][/color][color=\"#f3a712\"][b]Pin[/b][/color]" },
    ["j_aij_little_silhouetto"] = { name = "Little Silhouetto", text = "" },
    ["j_aij_living_statue"] = { name = "Living Statue", text = "" },
    ["j_aij_lonely_night"] = { name = "Lonely Night", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all cards if at least one Joker Slot is [color=\"#f3a712\"][b]empty[/b][/color]" },
    ["j_aij_loregg"] = { name = "Loregg", text = "" },
    ["j_aij_loselose"] = { name = "LOSE/LOSE", text = "" },
    ["j_aij_lost_carcosa"] = { name = "Lost Carcosa", text = "Randomize the [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] of used [color=\"#13afce\"][b]Fruit[/b][/color] cards from [color=\"#f3a712\"][b]#1#%[/b][/color] to [color=\"#f3a712\"][b]#2#%[/b][/color] their original values" },
    ["j_aij_lottery_ticket"] = { name = "Lottery Ticket", text = "" },
    ["j_aij_loveabjuring_band"] = { name = "Love-abjuring Band", text = "" },
    ["j_aij_low"] = { name = "Low", text = "" },
    ["j_aij_low_priest"] = { name = "Low Priest", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult,\n[color=\"#ff007f\"][b]-X#2#[/b][/color] Mult per [color=\"#f3a712\"][b]level[/b][/color] of played hand" },
    ["j_aij_lucignolo"] = { name = "Lucignolo", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] when any playing card is [color=\"#f3a712\"][b]destroyed[/b][/color]" },
    ["j_aij_lucina"] = { name = "Reveling Jester", text = "When Blind is [color=\"#f3a712\"][b]selected[/b][/color], [color=\"#ff007f\"][b]destroy[/b][/color] Joker to the [color=\"#f3a712\"][b]left[/b][/color] and apply a random [color=\"#5d5dff\"][b]Edition[/b][/color] to the Joker to the [color=\"#f3a712\"][b]right[/b][/color]" },
    ["j_aij_lucky_carder"] = { name = "Lucky Carder", text = "" },
    ["j_aij_lucky_horseshoe"] = { name = "Lucky Horseshoe", text = "[color=\"#f3a712\"][b]Paperback cards[/b][/color] held in hand have a [color=\"#1bb18c\"][b]#1# in #3#[/b][/color] chance to earn [color=\"#f3a712\"][b]$#5#[/b][/color] and a [color=\"#1bb18c\"][b]#1# in #4#[/b][/color] chance for [color=\"#ff007f\"][b]X#6#[/b][/color] Mult" },
    ["j_aij_lucky_pierre"] = { name = "Lucky Pierre", text = "" },
    ["j_aij_lucky_seven"] = { name = "Lucky Seven", text = "Turn all scored unenhanced [color=\"#f3a712\"][b]7s[/b][/color] into [color=\"#f3a712\"][b]Paperback cards[/b][/color]" },
    ["j_aij_machine_intelligence"] = { name = "Machine Intelligence", text = "" },
    ["j_aij_mad_hatter"] = { name = "Mad Hatter", text = "" },
    ["j_aij_mad_scientist"] = { name = "Mad Scientist", text = "When a card is [color=\"#f3a712\"][b]enhanced[/b][/color], a different [color=\"#f3a712\"][b]random[/b][/color] [color=\"#f3a712\"][b]enhancement[/b][/color] is fused to it" },
    ["j_aij_magazine_ad"] = { name = "Magazine Ad", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated, apply a [color=\"#f3a712\"][b]Replay Stamp[/b][/color] to a random card in your [color=\"#f3a712\"][b]full deck[/b][/color]" },
    ["j_aij_magic_hat"] = { name = "Magic Hat", text = "[color=\"#f3a712\"][b]+#1# Hand Size[/b][/color] while opening [color=\"#f3a712\"][b]Packs[/b][/color]" },
    ["j_aij_magic_mirror"] = { name = "Magic Mirror", text = "Apply [color=\"#5d5dff\"][b]Inverted[/b][/color] to the first scored [color=\"#f3a712\"][b]face[/b][/color] card this [color=\"#f3a712\"][b]Ante[/b][/color] [color=\"#9a9a9a\"]#1#[/color]" },
    ["j_aij_magick_joker"] = { name = "Magick Joker", text = "Played [color=\"#V1#\"][b]#1#[/b][/color] give their [color=\"#3772ff\"][b]+Points[/b][/color] as [color=\"#ff007f\"][b]+Mult[/b][/color] instead\n[color=\"#9a9a9a\"](Suit changes at end of round)[/color]" },
    ["j_aij_maguelonne"] = { name = "Maguelonne", text = "When Blind is [color=\"#f3a712\"][b]defeated[/b][/color], [color=\"#ff007f\"][b]destroy[/b][/color] a random [color=\"#f3a712\"][b]Face[/b][/color] [color=\"#f3a712\"][b]Card[/b][/color] remaining in your deck and gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_mahoney"] = { name = "Mahoney", text = "Redeem a random [color=\"#f3a712\"][b]Ticket[/b][/color] when Blind is [color=\"#f3a712\"][b]skipped[/b][/color]" },
    ["j_aij_majordomo"] = { name = "Majordomo", text = "All [color=\"#f3a712\"][b]Jokers[/b][/color] in the [color=\"#f3a712\"][b]shop[/b][/color] which cost more than [color=\"#f3a712\"][b]$#1#[/b][/color] gain the [color=\"#f3a712\"][b]Subscription[/b][/color] sticker\n[color=\"#f3a712\"][b]Subscription[/b][/color] subtracts [color=\"#f3a712\"][b]$2[/b][/color] less" },
    ["j_aij_mammon"] = { name = "Mammon", text = "[color=\"#f3a712\"][b]Increase[/b][/color] the payout of [color=\"#f3a712\"][b]Gilded[/b][/color] cards by [color=\"#f3a712\"][b]$#1#[/b][/color] per [color=\"#f3a712\"][b]Gilded[/b][/color] card scored this [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+$#2#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_mandrake"] = { name = "Mandrake", text = "After [color=\"#f3a712\"][b]#2#[/b][/color] rounds, [color=\"#f3a712\"][b]sell[/b][/color] this Joker to [color=\"#ff007f\"][b]destroy[/b][/color] all cards [color=\"#f3a712\"][b]held in hand[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"]/#2#)[/color]" },
    ["j_aij_mannequin"] = { name = "Mannequin", text = "" },
    ["j_aij_marceau"] = { name = "Marceau", text = "Retrigger all [color=\"#f3a712\"][b]on discard[/b][/color] and [color=\"#f3a712\"][b]held in hand[/b][/color] effects [color=\"#f3a712\"][b]#1#[/b][/color] additional times" },
    ["j_aij_marcy_credits_joker"] = { name = "Marcy", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_mariachi"] = { name = "Mariachi", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]unique[/b][/color] [color=\"#f3a712\"][b]enhancement[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_martellino"] = { name = "Martellino", text = "After [color=\"#f3a712\"][b]#2#[/b][/color] rounds, [color=\"#f3a712\"][b]sell[/b][/color] this Joker to create [color=\"#f3a712\"][b]any Joker[/b][/color] from your [color=\"#f3a712\"][b]collection[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"]/#2#)[/color]" },
    ["j_aij_martial_joker"] = { name = "Martial Joker", text = "" },
    ["j_aij_maschera"] = { name = "Maschera", text = "" },
    ["j_aij_mask_merchant"] = { name = "Mask Merchant", text = "" },
    ["j_aij_masquerade"] = { name = "Masquerade", text = "" },
    ["j_aij_master_of_pegs"] = { name = "Master of Pegs", text = "Gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]enhanced[/b][/color] card in [color=\"#f3a712\"][b]full deck[/b][/color], only triggers if [color=\"#f3a712\"][b]no[/b][/color] [color=\"#f3a712\"][b]enhanced[/b][/color] cards are in [color=\"#f3a712\"][b]remaining deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color] [color=\"#9a9a9a\"]#3#[/color]" },
    ["j_aij_matchbox"] = { name = "Matchbox", text = "" },
    ["j_aij_mathurine"] = { name = "Mathurine", text = "" },
    ["j_aij_mean_green"] = { name = "Mean Green", text = "" },
    ["j_aij_meaty_joker"] = { name = "Meaty Joker", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult for every [color=\"#f3a712\"][b]#2#[/b][/color] cards in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\n[color=\"#9a9a9a\"](Minimum [/color][color=\"#ff007f\"][b]X1[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_melancholic_joker"] = { name = "Melancholic Joker", text = "Played cards with [color=\"#e5e5e5\"][b]Spade[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#4584fa\"][b]Admin[/b][/color] card when scored\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_melpomene"] = { name = "Melpomene", text = "Scored [color=\"#f3a712\"][b]face cards[/b][/color] give [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] equal to the [color=\"#f3a712\"][b]base stats[/b][/color] of the played poker hand" },
    ["j_aij_memory_card"] = { name = "Memory Card", text = "If first hand of round is exactly [color=\"#f3a712\"][b]1[/b][/color] card, [color=\"#f3a712\"][b]draw[/b][/color] it [color=\"#f3a712\"][b]first[/b][/color] in future Blinds\n[color=\"#9a9a9a\"](Can only store one card)[/color]\n[color=\"#9a9a9a\"](Only triggers in leftmost position)[/color]" },
    ["j_aij_metrollen"] = { name = "Metrollen", text = "" },
    ["j_aij_metrollen_credits_joker"] = { name = "Metrollen", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_mike_check"] = { name = "Mike Check", text = "Create a random [color=\"#1bb18c\"][b]Uncommon[/b][/color] Joker every [color=\"#f3a712\"][b]#1#[/b][/color] Jokers sold\n[color=\"#9a9a9a\"]([/color][color=\"#f3a712\"][b]#2#[/b][/color][color=\"#9a9a9a\"]/#1#)[/color]" },
    ["j_aij_minibit_credits_joker"] = { name = "Mini Bit", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_minimalist"] = { name = "Minimalist", text = "" },
    ["j_aij_minus_world"] = { name = "Minus World", text = "[color=\"#f3a712\"][b]-#1#[/b][/color] Ante to win\n[color=\"#f3a712\"][b]-#2#[/b][/color] Ante when [color=\"#f3a712\"][b]sold[/b][/color]" },
    ["j_aij_missing_poster"] = { name = "Missing Poster", text = "" },
    ["j_aij_mistake"] = { name = "Mistake", text = "[color=\"#f3a712\"][b]Locked[/b][/color] Jokers can be [color=\"#f3a712\"][b]sold[/b][/color]" },
    ["j_aij_mister_police"] = { name = "Mister Police", text = "" },
    ["j_aij_mistigri"] = { name = "Mistigri", text = "[color=\"#f3a712\"][b]+1[/b][/color] hand size per [color=\"#f3a712\"][b]2[/b][/color] [color=\"#f3a712\"][b]Jacks[/b][/color] held in hand" },
    ["j_aij_mixel_perfect"] = { name = "Mixel Perfect", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]scored hand[/b][/color] contains an [color=\"#f3a712\"][b]odd[/b][/color] number of cards" },
    ["j_aij_mocap"] = { name = "Mocap", text = "When a [color=\"#d138bf\"][b]Legendary[/b][/color], [color=\"#fe5f55\"][b]Rare[/b][/color], or [color=\"#1bb18c\"][b]Uncommon[/b][/color] Joker is [color=\"#f3a712\"][b]sold[/b][/color], create a [color=\"#f3a712\"][b]random[/b][/color] Joker of the next lower rarity\n[color=\"#d138bf\"][b]Legendary[/b][/color] -> [color=\"#fe5f55\"][b]Rare[/b][/color] [color=\"#fe5f55\"][b]Rare[/b][/color] -> [color=\"#1bb18c\"][b]Uncommon[/b][/color] [color=\"#1bb18c\"][b]Uncommon[/b][/color] -> [color=\"#009dff\"][b]Common[/b][/color]" },
    ["j_aij_moldy_joker"] = { name = "Moldy Joker", text = "" },
    ["j_aij_monarchic_joker"] = { name = "Monarchic Joker", text = "Played cards with [color=\"#f3a712\"][b]Crown[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#f3a712\"][b]Minor[/b][/color] [color=\"#f3a712\"][b]Arcana[/b][/color] card when scored\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_monarcho"] = { name = "Monarcho", text = "" },
    ["j_aij_mondrian_joker"] = { name = "Mondrian Joker", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]4[/b][/color] in your [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_monster"] = { name = "Monster", text = "" },
    ["j_aij_moon_man"] = { name = "Moon Man", text = "" },
    ["j_aij_moon_museum"] = { name = "Moon Museum", text = "" },
    ["j_aij_morio"] = { name = "Morio", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated, choose [color=\"#f3a712\"][b]any[/b][/color] [color=\"#d138bf\"][b]Game[/b][/color] card to create\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_moros"] = { name = "Moros", text = "" },
    ["j_aij_mountie"] = { name = "Mountie", text = "" },
    ["j_aij_mp_blind_drawn"] = { name = "Blind-Drawn", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult Cannot see your [color=\"#d138bf\"][b]Nemesis'[/b][/color] score or remaining hands during [color=\"#f3a712\"][b]PvP Blinds[/b][/color]" },
    ["j_aij_mp_fall_of_count_chaligny"] = { name = "Fall of Count Chaligny", text = "Set the [color=\"#f3a712\"][b]required[/b][/color] score of all [color=\"#f3a712\"][b]Blinds[/b][/color] to [color=\"#f3a712\"][b]1X[/b][/color] Base\n[color=\"#9a9a9a\"](Does not affect PvP blinds)[/color]" },
    ["j_aij_mr_catfish"] = { name = "Mr. Catfish", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] every [color=\"#f3a712\"][b]#2#[/b][/color][color=\"#9a9a9a\"] [#3#][/color] cards discarded" },
    ["j_aij_mr_lonely"] = { name = "Mr. Lonely", text = "This Joker gains [color=\"#3772ff\"][b]+#1# Points[/b][/color] per empty [color=\"#f3a712\"][b]Joker slot[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_muckle"] = { name = "Muckle", text = "" },
    ["j_aij_mummer"] = { name = "Mummer", text = "Retrigger all [color=\"#f3a712\"][b]Wooden cards[/b][/color] once per [color=\"#f3a712\"][b]Wooden card[/b][/color] in scored hand" },
    ["j_aij_mummy"] = { name = "Mummy", text = "" },
    ["j_aij_mushroom_cloud"] = { name = "Mushroom Cloud", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] [color=\"#ff007f\"][b]Destroy[/b][/color] all held [color=\"#f3a712\"][b]Jokers[/b][/color] and earn [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_mustachio"] = { name = "Mustachio", text = "" },
    ["j_aij_mute_joker"] = { name = "Mute Joker", text = "This round, first [color=\"#f3a712\"][b]#1#[/b][/color] played [color=\"#ff007f\"][b]destroys[/b][/color] all scored cards\n[color=\"#9a9a9a\"](Poker hand changes at end of round)[/color]" },
    ["j_aij_mysterious_horizon"] = { name = "Mysterious Horizon", text = "" },
    ["j_aij_mystic"] = { name = "Mystic", text = "" },
    ["j_aij_mythie"] = { name = "Mythie", text = "[color=\"#9a9a9a\"]\"Eating toast in bed is[/color] [color=\"#9a9a9a\"]my ability\"[/color]" },
    ["j_aij_mythie_credits_joker"] = { name = "Mythie", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_naiteh"] = { name = "Nai-Teh", text = "Gains [color=\"#f3a712\"][b]+#2#[/b][/color] hand size when [color=\"#f3a712\"][b]Boss Blind[/b][/color] is defeated\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] hand size)[/color]" },
    ["j_aij_napkin"] = { name = "Napkin", text = "This Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when [color=\"#f3a712\"][b]2[/b][/color] Blinds are skipped [color=\"#f3a712\"][b]in a row[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_nature_tapes"] = { name = "Nature Tapes", text = "When a [color=\"#ff007f\"][b]Mult[/b][/color]-type [color=\"#13afce\"][b]Fruit[/b][/color] card is used, this Joker gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2# [/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_necromancer"] = { name = "Necromancer", text = "" },
    ["j_aij_nedda"] = { name = "Nedda", text = "[color=\"#f3a712\"][b]Queens[/b][/color] held in hand give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_negative_nancy"] = { name = "Inverted Nancy", text = "[color=\"#5d5dff\"][b]Inverted[/b][/color] Jokers appear [color=\"#f3a712\"][b]#1#X[/b][/color] more often in the [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_negative_space"] = { name = "Inverted Space", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] Hand Size for every [color=\"#5d5dff\"][b]Inverted[/b][/color] Joker held\n[color=\"#9a9a9a\"](Currently [/color][color=\"#f3a712\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Hand Size)[/color]\n[color=\"#9a9a9a\"](Max of [/color][color=\"#f3a712\"][b]+#3#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_neighborhood_watch"] = { name = "Neighborhood Watch", text = "" },
    ["j_aij_neon_sign"] = { name = "Neon Sign", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if played hand contains a [color=\"#f3a712\"][b]Full House[/b][/color] and the previous hand [color=\"#f3a712\"][b]did not[/b][/color]\n[color=\"#9a9a9a\"](#2#)[/color]" },
    ["j_aij_neptunium"] = { name = "Neptunium", text = "If played hand is [color=\"#f3a712\"][b]Straight Flush[/b][/color], retrigger all scoring cards [color=\"#f3a712\"][b]#1#[/b][/color] times" },
    ["j_aij_nervous_joker"] = { name = "Nervous Joker", text = "" },
    ["j_aij_neutronium"] = { name = "Neutronium", text = "If played hand is [color=\"#f3a712\"][b]Flush Five[/b][/color], retrigger all scoring cards" },
    ["j_aij_nevernamed_credits_joker"] = { name = "Nevernamed", text = "[color=\"#9a9a9a\"]\"This space intentionally[/color] [color=\"#9a9a9a\"]left blank\"[/color]" },
    ["j_aij_ngmp"] = { name = "Ng'Mp", text = "" },
    ["j_aij_nichola"] = { name = "Nichola", text = "When round begins, add one random [color=\"#f3a712\"][b]Queen[/b][/color] to your hand with a random [color=\"#f3a712\"][b]Enhancement[/b][/color], [color=\"#5d5dff\"][b]Edition[/b][/color] and [color=\"#f3a712\"][b]Stamp[/b][/color]" },
    ["j_aij_nihilartikel"] = { name = "Nihilartikel", text = "[color=\"#5d5dff\"][b]+#1#[/b][/color] Joker Slots,\n[color=\"#ff007f\"][b]-$#2#[/b][/color] at end of round" },
    ["j_aij_ninja"] = { name = "Ninja", text = "[color=\"#f3a712\"][b]Rescore[/b][/color] the [color=\"#f3a712\"][b]first[/b][/color] scoring card whenever the [color=\"#f3a712\"][b]last[/b][/color] scoring card scores" },
    ["j_aij_no_arms_no_legs"] = { name = "No Arms. No Legs.", text = "" },
    ["j_aij_no_i_am_not_a_joker"] = { name = "No, I Am Not a Joker", text = "" },
    ["j_aij_no_junk_mail"] = { name = "No Junk Mail", text = "[color=\"#f3a712\"][b]Deck Packs[/b][/color] in the Shop are [color=\"#f3a712\"][b]free[/b][/color]" },
    ["j_aij_nobody"] = { name = "Nobody", text = "[color=\"#9a9a9a\"]Does nothing...?[/color]" },
    ["j_aij_nosferatu"] = { name = "Nosferatu", text = "" },
    ["j_aij_notsoai_credits_joker"] = { name = "NotSoAI", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_null_joker"] = { name = "Null Joker", text = "Sets all [color=\"#1bb18c\"][b]odds[/b][/color] to [color=\"#f3a712\"][b]zero[/b][/color]\n[color=\"#9a9a9a\"](ex: [/color][color=\"#1bb18c\"][b]1 in 3[/b][/color][color=\"#9a9a9a\"] -> [/color][color=\"#1bb18c\"][b]0 in 3[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_number_eight_wire"] = { name = "Number 8 Wire", text = "" },
    ["j_aij_numbertaker"] = { name = "Numbertaker", text = "Removes the [color=\"#f3a712\"][b]ranks[/b][/color] of scored [color=\"#f3a712\"][b]numbered[/b][/color] cards\nThis [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]Mult[/b][/color] equal to removed ranks\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_nutcracker"] = { name = "Nutcracker", text = "" },
    ["j_aij_nybbas"] = { name = "Nybbas", text = "" },
    ["j_aij_obsessive_objective"] = { name = "Obsessive Objective", text = "" },
    ["j_aij_octopus"] = { name = "Octopus", text = "Scoring [color=\"#f3a712\"][b]7s[/b][/color] and [color=\"#f3a712\"][b]9s[/b][/color] become [color=\"#f3a712\"][b]8s[/b][/color]" },
    ["j_aij_odd_rod"] = { name = "Odd Rod", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all played cards with [color=\"#f3a712\"][b]odd[/b][/color] rank" },
    ["j_aij_office_assistant"] = { name = "Office Assistant", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Repairs [color=\"#f3a712\"][b]Timed[/b][/color] or [color=\"#f3a712\"][b]Subscription[/b][/color] Joker to the [color=\"#f3a712\"][b]right[/b][/color]" },
    ["j_aij_oil_and_water"] = { name = "Oil and Water", text = "" },
    ["j_aij_oklo_reactor"] = { name = "Oklo Reactor", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all played [color=\"#f3a712\"][b]Gold[/b][/color] [color=\"#f3a712\"][b]Cards twice[/b][/color]" },
    ["j_aij_old_joker"] = { name = "Old Joker", text = "This Joker gains [color=\"#3772ff\"][b]+#2#[/b][/color] Points and [color=\"#ff007f\"][b]+#4#[/b][/color] Mult when [color=\"#f3a712\"][b]Boss[/b][/color] [color=\"#f3a712\"][b]Blind[/b][/color] is defeated\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points, [/color][color=\"#ff007f\"][b]+#3#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\n[color=\"#9a9a9a\"](Always Locked)[/color]" },
    ["j_aij_omelette"] = { name = "Omelette", text = "" },
    ["j_aij_omlette"] = { name = "Omelette", text = "Gains [color=\"#f3a712\"][b]$#1#[/b][/color] of sell value when a [color=\"#3772ff\"][b]hand[/b][/color] or [color=\"#ff007f\"][b]discard[/b][/color] is used" },
    ["j_aij_on_your_sleeve"] = { name = "On Your Sleeve", text = "" },
    ["j_aij_one_bit_joker"] = { name = "1-Bit Joker", text = "" },
    ["j_aij_one_little_duck"] = { name = "One Little Duck", text = "This Joker gains [color=\"#ff007f\"][b]+#2#[/b][/color] Mult for each [color=\"#f3a712\"][b]2[/b][/color] that is [color=\"#f3a712\"][b]played[/b][/color] but not [color=\"#f3a712\"][b]scored[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_onearmed_bandit"] = { name = "One-armed Bandit", text = "" },
    ["j_aij_onifuda"] = { name = "Onifuda", text = "" },
    ["j_aij_open_mind"] = { name = "Open Mind", text = "[color=\"#f3a712\"][b]+#1#[/b][/color] additional [color=\"#f3a712\"][b]Packs[/b][/color] available for purchase in [color=\"#f3a712\"][b]Shop[/b][/color]" },
    ["j_aij_opening_move"] = { name = "Opening Move", text = "Gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult for the round for each card [color=\"#f3a712\"][b]scored[/b][/color] in [color=\"#f3a712\"][b]first hand[/b][/color] of round\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]\nThe [color=\"#f3a712\"][b]first hand[/b][/color] of each round is [color=\"#ff007f\"][b]not[/b][/color] added to your score" },
    ["j_aij_origami_joker"] = { name = "Origami Joker", text = "" },
    ["j_aij_orphic_joker"] = { name = "Orphic Joker", text = "Create [color=\"#f3a712\"][b]#1#[/b][/color] random [color=\"#fe5f55\"][b]Rare[/b][/color] [color=\"#f3a712\"][b]Joker[/b][/color] when Blind is [color=\"#f3a712\"][b]skipped[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_outlet"] = { name = "Outlet", text = "When Blind is [color=\"#f3a712\"][b]selected[/b][/color], add a random [color=\"#f3a712\"][b]Charged[/b][/color] [color=\"#f3a712\"][b]Card[/b][/color] to your hand" },
    ["j_aij_outside_in_joker"] = { name = "Outside In Joker", text = "" },
    ["j_aij_over_the_counter"] = { name = "Over the Counter", text = "When opening a [color=\"#f3a712\"][b]Booster[/b][/color] [color=\"#f3a712\"][b]Pack[/b][/color], choose [color=\"#f3a712\"][b]#1#[/b][/color] card from your [color=\"#f3a712\"][b]deck[/b][/color] to draw" },
    ["j_aij_overdesigned_joker"] = { name = "Overdesigned Joker", text = "Scored [color=\"#V1#\"][b]#1#[/b][/color] #3# [color=\"#V3#\"][b]#4##2#[/b][/color]#5#\nSuit and effect [color=\"#f3a712\"][b]rotate[/b][/color] when a card is [color=\"#f3a712\"][b]scored[/b][/color]\n[color=\"#9a9a9a\"]([/color][color=\"#V4#\"][b]Hearts[/b][/color][color=\"#9a9a9a\"]->[/color][color=\"#V5#\"][b]Clubs[/b][/color][color=\"#9a9a9a\"]->[/color][color=\"#V6#\"][b]Diamonds[/b][/color][color=\"#9a9a9a\"]->[/color][color=\"#V7#\"][b]Spades[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_pablillos"] = { name = "Pablillos", text = "All [color=\"#f3a712\"][b]Skip Pins[/b][/color] are replaced with their [color=\"#f3a712\"][b]Gold[/b][/color] equivalent" },
    ["j_aij_pace"] = { name = "Pace", text = "All Joker [color=\"#ff007f\"][b]Rarities[/b][/color] have an [color=\"#1bb18c\"][b]equal[/b][/color] chance of appearing in the [color=\"#f3a712\"][b]Shop[/b][/color]\n[color=\"#9a9a9a\"](except Legendary)[/color]\nAll Jokers cost [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_pain_joker"] = { name = "Pain Joker", text = "" },
    ["j_aij_panasco"] = { name = "Panasco", text = "" },
    ["j_aij_pangram"] = { name = "Pangram", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]unique[/b][/color] rank [color=\"#f3a712\"][b]held in hand[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_pantomimus"] = { name = "Pantomimus", text = "This Joker gains [color=\"#3772ff\"][b]+#2#[/b][/color] Points per card [color=\"#f3a712\"][b]held in[/b][/color] [color=\"#f3a712\"][b]hand[/b][/color] at end of [color=\"#f3a712\"][b]round[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_paper_bag"] = { name = "Paper Bag", text = "This Joker gains [color=\"#3772ff\"][b]+#1#[/b][/color] Points per [color=\"#f3a712\"][b]level[/b][/color] of each [color=\"#ff007f\"][b]discarded[/b][/color] poker hand\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_papermoon_credits_joker"] = { name = "Papermoon", text = "[color=\"#9a9a9a\"]\"We're invited to a lifelong[/color] [color=\"#9a9a9a\"]party, it's rude to overstay.\"[/color]" },
    ["j_aij_paracosm"] = { name = "Paracosm", text = "Upgrade [color=\"#f3a712\"][b]most played[/b][/color] poker hand by [color=\"#f3a712\"][b]#1#[/b][/color] levels when Blind is [color=\"#f3a712\"][b]skipped[/b][/color]\n[color=\"#9a9a9a\"](Currently #2#)[/color]" },
    ["j_aij_parfait"] = { name = "Parfait", text = "At end of round, [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance for Joker to the [color=\"#f3a712\"][b]right[/b][/color] to [color=\"#f3a712\"][b]permanently[/b][/color] gain [color=\"#ff007f\"][b]X#3#[/b][/color] Mult\n[color=\"#ff007f\"][b]Self-destructs[/b][/color] after triggering" },
    ["j_aij_parking_space"] = { name = "Parking Space", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult if this Joker is in [color=\"#f3a712\"][b]Joker Slot #2#[/b][/color]\n[color=\"#9a9a9a\"](Slot changes at end of round)[/color]" },
    ["j_aij_party_streamers"] = { name = "Party Streamers", text = "If [color=\"#f3a712\"][b]first hand[/b][/color] of round is exactly [color=\"#f3a712\"][b]1[/b][/color] card with no [color=\"#f3a712\"][b]Stamp[/b][/color], it gets a [color=\"#ff007f\"][b]Red[/b][/color], [color=\"#3772ff\"][b]Blue[/b][/color], or [color=\"#f3a712\"][b]Gold[/b][/color] [color=\"#f3a712\"][b]Stamp[/b][/color]" },
    ["j_aij_party_time"] = { name = "Party Time!", text = "All [color=\"#f3a712\"][b]Jokers[/b][/color] permanently gain [color=\"#3772ff\"][b]+#1#[/b][/color] Points when [color=\"#f3a712\"][b]Blind[/b][/color] is [color=\"#f3a712\"][b]defeated[/b][/color]" },
    ["j_aij_peanut_brittle"] = { name = "Peanut Brittle", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Glass[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when when a Fragile card [color=\"#f3a712\"][b]breaks[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Vision[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_pedestrian"] = { name = "Pedestrian", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] scoring card if its [color=\"#f3a712\"][b]rank[/b][/color] is [color=\"#f3a712\"][b]lower[/b][/color] than the [color=\"#f3a712\"][b]previous[/b][/color] scoring card" },
    ["j_aij_pedrolino"] = { name = "Pedrolino", text = "[color=\"#f3a712\"][b]Sell[/b][/color] this card to reduce the [color=\"#f3a712\"][b]score requirement[/b][/color] of the current [color=\"#f3a712\"][b]Blind[/b][/color] by [color=\"#f3a712\"][b]#1#%[/b][/color]" },
    ["j_aij_peeping_tom"] = { name = "Peeping Tom", text = "Reveals the next [color=\"#f3a712\"][b]#1#[/b][/color] cards in your deck" },
    ["j_aij_pell_mel"] = { name = "Pell Mel", text = "Gives [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]unique[/b][/color] suit in [color=\"#f3a712\"][b]played hand[/b][/color]" },
    ["j_aij_pellesini"] = { name = "Pellesini", text = "When any Joker is [color=\"#ff007f\"][b]destroyed[/b][/color], create an [color=\"#f3a712\"][b]exact[/b][/color] copy\n[color=\"#9a9a9a\"](Must have room)[/color]\n[color=\"#ff007f\"][b]Destroy[/b][/color] rightmost Joker and earn its [color=\"#f3a712\"][b]sell value[/b][/color] when selecting [color=\"#f3a712\"][b]Blind[/b][/color]" },
    ["j_aij_pellucid_joker"] = { name = "Pellucid Joker", text = "When a [color=\"#f3a712\"][b]Joker[/b][/color] with an [color=\"#5d5dff\"][b]Edition[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color], add a random playing card with the same [color=\"#5d5dff\"][b]Edition[/b][/color] to deck" },
    ["j_aij_pencil_drawing"] = { name = "Pencil Drawing", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Pay [color=\"#f3a712\"][b]$#1#[/b][/color] to add #2# [color=\"#f3a712\"][b]#3#[/b][/color] of [color=\"#V2#\"][b]#4#[/b][/color] to your hand\n[color=\"#9a9a9a\"](Card changes after use[/color] [color=\"#9a9a9a\"]and after each hand)[/color]" },
    ["j_aij_pengelding"] = { name = "Pengelding", text = "Cards held in hand give [color=\"#ff007f\"][b]X#3#[/b][/color] Mult, increases by [color=\"#ff007f\"][b]X#1#[/b][/color] per [color=\"#f3a712\"][b]$#2#[/b][/color] of [color=\"#f3a712\"][b]sell value[/b][/color] in all owned Jokers" },
    ["j_aij_penny"] = { name = "Penny", text = "Cards with [color=\"#f3a712\"][b]Cash Stamp[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#f3a712\"][b]retrigger[/b][/color]" },
    ["j_aij_penny_dreadful"] = { name = "Penny Dreadful", text = "" },
    ["j_aij_per_aspera_ad_astra"] = { name = "Per Aspera ad Astra", text = "" },
    ["j_aij_personalized_joker"] = { name = "Personalized Joker", text = "" },
    ["j_aij_petrushka"] = { name = "Petrushka", text = "Gives [color=\"#ff007f\"][b]+Mult[/b][/color] equal to the total [color=\"#f3a712\"][b]rank[/b][/color] of all [color=\"#f3a712\"][b]scored cards[/b][/color]\n[color=\"#9a9a9a\"](A=14, K=13, Q=12, J=11)[/color]" },
    ["j_aij_phantom_of_truth"] = { name = "Phantom of Truth", text = "" },
    ["j_aij_phlegmatic_joker"] = { name = "Phlegmatic Joker", text = "Played cards with [color=\"#388f58\"][b]Club[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create the [color=\"#13afce\"][b]Fruit[/b][/color] card for the [color=\"#f3a712\"][b]played hand[/b][/color] when scored\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_phoney_baloney"] = { name = "Phoney Baloney", text = "Gives [color=\"#f3a712\"][b]#2#[/b][/color] free [color=\"#1bb18c\"][b]rerolls[/b][/color] at the start of each [color=\"#f3a712\"][b]Ante[/b][/color], [color=\"#f3a712\"][b]consumed[/b][/color] when reaching [color=\"#f3a712\"][b]0[/b][/color] [color=\"#1bb18c\"][b]rerolls[/b][/color] [color=\"#9a9a9a\"]([/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"] Remaining)[/color]" },
    ["j_aij_picasso"] = { name = "Picasso", text = "" },
    ["j_aij_piece_of_mind"] = { name = "Piece of Mind", text = "" },
    ["j_aij_pierrette"] = { name = "Pierrette", text = "Retrigger all [color=\"#f3a712\"][b]card[/b][/color] [color=\"#f3a712\"][b]discarded[/b][/color] effects" },
    ["j_aij_pierrot"] = { name = "Pierrot", text = "[color=\"#f3a712\"][b]Numbered[/b][/color] cards held in hand give their [color=\"#3772ff\"][b]Point[/b][/color] value" },
    ["j_aij_pigpen"] = { name = "Pigpen", text = "Gives [color=\"#3772ff\"][b]Points[/b][/color] equal to the number of times [color=\"#f3a712\"][b]poker hand[/b][/color] has been played, multiplied by its [color=\"#f3a712\"][b]level[/b][/color]" },
    ["j_aij_pinhead"] = { name = "Pinhead", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] if [color=\"#f3a712\"][b]Blind[/b][/color] is beaten in a [color=\"#f3a712\"][b]single hand[/b][/color]" },
    ["j_aij_pink_slip"] = { name = "Pink Slip", text = "[color=\"#f3a712\"][b]+#1# Selection Limit[/b][/color] for [color=\"#ff007f\"][b]Discards[/b][/color]" },
    ["j_aij_pinup_poster"] = { name = "Pin-Up Poster", text = "This Joker is always [color=\"#f3a712\"][b]pinned[/b][/color] to the [color=\"#f3a712\"][b]left[/b][/color] of your Jokers\nGains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#ff007f\"][b]Hearts[/b][/color] suit card in your [color=\"#f3a712\"][b]remaining deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_pipine"] = { name = "Pipine", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] discards per round" },
    ["j_aij_piss_take"] = { name = "Piss Take", text = "" },
    ["j_aij_plain_jane"] = { name = "Plain Jane", text = "Scored [color=\"#f3a712\"][b]unenhanced[/b][/color] cards give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_plain_packaging"] = { name = "Plain Packaging", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult, [color=\"#ff007f\"][b]-#2#[/b][/color] Mult when a [color=\"#f3a712\"][b]Joker[/b][/color] is [color=\"#f3a712\"][b]sold[/b][/color] or [color=\"#ff007f\"][b]destroyed[/b][/color]" },
    ["j_aij_planetarium"] = { name = "Planetarium", text = "[color=\"#3772ff\"][b]Points[/b][/color]-type [color=\"#13afce\"][b]Fruit[/b][/color] cards in your [color=\"#f3a712\"][b]consumable[/b][/color] area give [color=\"#3772ff\"][b]+#1#[/b][/color] Points for their specified [color=\"#f3a712\"][b]poker hand[/b][/color]\n[color=\"#ff007f\"][b]Mult[/b][/color]-type [color=\"#13afce\"][b]Fruit[/b][/color] cards in your [color=\"#f3a712\"][b]consumable[/b][/color] area give [color=\"#ff007f\"][b]+#2#[/b][/color] Mult for their specified [color=\"#f3a712\"][b]poker hand[/b][/color]" },
    ["j_aij_plastic_surgery"] = { name = "Plastic Surgery", text = "" },
    ["j_aij_platinum_chip"] = { name = "Platinum Point", text = "" },
    ["j_aij_playjoy"] = { name = "Playjoy", text = "" },
    ["j_aij_plum_pudding"] = { name = "Plum Pudding", text = "" },
    ["j_aij_plutonium"] = { name = "Plutonium", text = "If played hand is [color=\"#f3a712\"][b]High Card[/b][/color], retrigger all scoring cards [color=\"#f3a712\"][b]#1#[/b][/color] times" },
    ["j_aij_pog"] = { name = "Pog", text = "Each [color=\"#f3a712\"][b]booster pack[/b][/color] also contains a [color=\"#f3a712\"][b]Pin[/b][/color] that can be acquired by [color=\"#f3a712\"][b]skipping[/b][/color] the pack" },
    ["j_aij_poison_apple"] = { name = "Poison Apple", text = "" },
    ["j_aij_poker_face"] = { name = "Poker Face", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]consecutive[/b][/color] hand played that does [color=\"#f3a712\"][b]not[/b][/color] score [color=\"#f3a712\"][b]greater[/b][/color] than the [color=\"#f3a712\"][b]total[/b][/color] required score of the [color=\"#f3a712\"][b]blind[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_police_sketch"] = { name = "Police Sketch", text = "If played hand is [color=\"#f3a712\"][b]Four of[/b][/color] [color=\"#f3a712\"][b]a Kind[/b][/color], turn [color=\"#f3a712\"][b]unscored[/b][/color] cards into [color=\"#f3a712\"][b]Canvas Cards[/b][/color]" },
    ["j_aij_polybius"] = { name = "Polybius", text = "Gives the [color=\"#ff007f\"][b]Mult[/b][/color] and [color=\"#3772ff\"][b]Points[/b][/color] of all hand types [color=\"#f3a712\"][b]contained[/b][/color] [color=\"#f3a712\"][b]within[/b][/color] played hand" },
    ["j_aij_polymorphic_joker"] = { name = "Polymorphic Joker", text = "" },
    ["j_aij_polyphemus"] = { name = "Polyphemus", text = "" },
    ["j_aij_pompey"] = { name = "Pompey", text = "[color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]Joker[/b][/color] to the [color=\"#f3a712\"][b]right[/b][/color], Pompey included\n[color=\"#9a9a9a\"](Currently[/color] [color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_pope"] = { name = "Pope", text = "" },
    ["j_aij_poppins"] = { name = "Poppins", text = "Earn [color=\"#f3a712\"][b]$#1#[/b][/color] per [color=\"#f3a712\"][b]unique[/b][/color] poker hand [color=\"#f3a712\"][b]contained[/b][/color] [color=\"#f3a712\"][b]within[/b][/color] played hand" },
    ["j_aij_pops"] = { name = "Pops!", text = "" },
    ["j_aij_postcard_from_perdition_trail"] = { name = "Postcard from Perdition Trail", text = "Scoring cards with [color=\"#f3a712\"][b]stamps[/b][/color] have their stamps [color=\"#ff007f\"][b]removed[/b][/color], then [color=\"#f3a712\"][b]permanently[/b][/color] gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_pour_one_out"] = { name = "Pour One Out", text = "Create a random [color=\"#f3a712\"][b]consumable[/b][/color] every [color=\"#f3a712\"][b]#1#[/b][/color] [color=\"#9a9a9a\"][#2#][/color] discarded cards" },
    ["j_aij_pput_together"] = { name = "Put Together", text = "" },
    ["j_aij_prank_caller"] = { name = "Prank Caller", text = "" },
    ["j_aij_pretzel_sticks"] = { name = "Pretzel Sticks", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Wood[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when a [color=\"#f3a712\"][b]held in hand[/b][/color] effect is triggered\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]The Sanctuary Gate[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_prisoners_cinema"] = { name = "Prisoner's Cinema", text = "[color=\"#f3a712\"][b]#1#[/b][/color] random [color=\"#f3a712\"][b]Pack[/b][/color] each shop is [color=\"#f3a712\"][b]free[/b][/color]" },
    ["j_aij_privelege_fabled"] = { name = "Jester's Privilege", text = "[color=\"#d138bf\"][b]Legendary[/b][/color] Jokers are [color=\"#f3a712\"][b]more common[/b][/color]" },
    ["j_aij_profile"] = { name = "Profile", text = "Scoring cards [color=\"#f3a712\"][b]adjacent[/b][/color] to [color=\"#f3a712\"][b]face cards[/b][/color] give [color=\"#ff007f\"][b]+#1#[/b][/color] Mult" },
    ["j_aij_propaganda"] = { name = "Propaganda", text = "Cards of the [color=\"#f3a712\"][b]most[/b][/color] [color=\"#f3a712\"][b]common[/b][/color] suit in your [color=\"#f3a712\"][b]deck[/b][/color] give [color=\"#ff007f\"][b]+#2#[/b][/color] Mult when scored\n[color=\"#9a9a9a\"](Currently: [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_protophanes"] = { name = "Protophanes", text = "[color=\"#f3a712\"][b]Reveal[/b][/color] the last card in your [color=\"#f3a712\"][b]deck[/b][/color] [color=\"#f3a712\"][b]Cards[/b][/color] that share its [color=\"#f3a712\"][b]rank[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_prototype"] = { name = "Prototype", text = "[color=\"#9a9a9a\"]\"Lol I don't know if I[/color] [color=\"#9a9a9a\"]have any quotes in me\"[/color]" },
    ["j_aij_prototype_credits_joker"] = { name = "Prototype", text = "[color=\"#9a9a9a\"]\"Skibby Dee\"[/color]" },
    ["j_aij_psalmanazar"] = { name = "Psalmanazar", text = "" },
    ["j_aij_psycho"] = { name = "Psycho", text = "[color=\"#V1#\"][b]Activated Ability[/b][/color] Use while in a [color=\"#f3a712\"][b]Blind[/b][/color] to [color=\"#ff007f\"][b]destroy[/b][/color] Joker to the [color=\"#f3a712\"][b]left[/b][/color] and gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]$1[/b][/color] of its [color=\"#f3a712\"][b]sell value[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_public_bathroom"] = { name = "Public Bathroom", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per scored [color=\"#f3a712\"][b]2[/b][/color] in a [color=\"#f3a712\"][b]Flush[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_pulcinella"] = { name = "Pulcinella", text = "" },
    ["j_aij_punch_and_judy"] = { name = "Punch and Judy", text = "If [color=\"#f3a712\"][b]played hand[/b][/color] contains exactly [color=\"#f3a712\"][b]one King[/b][/color] and [color=\"#f3a712\"][b]one Queen[/b][/color], retrigger all scoring cards\n[color=\"#f3a712\"][b]Kings[/b][/color] and [color=\"#f3a712\"][b]Queens[/b][/color] always score" },
    ["j_aij_punk_joker"] = { name = "Punk Joker", text = "If hand scores a [color=\"#f3a712\"][b]Plaid card[/b][/color], turn a random unenhanced scored card into a [color=\"#f3a712\"][b]Plaid card[/b][/color]" },
    ["j_aij_pure_baseball_card"] = { name = "Pure Baseball Card", text = "[color=\"#fe5f55\"][b]Rare [/b][/color][color=\"#f3a712\"][b]Jokers[/b][/color] permanently gain [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when [color=\"#f3a712\"][b]Blind[/b][/color] is [color=\"#f3a712\"][b]defeated[/b][/color]" },
    ["j_aij_pygmalion"] = { name = "Pygmalion", text = "All [color=\"#f3a712\"][b]Rock[/b][/color] cards are considered [color=\"#f3a712\"][b]Queens[/b][/color]" },
    ["j_aij_quadrangled_joker"] = { name = "Quadrangled Joker", text = "Adds the [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color] of [color=\"#f3a712\"][b]Four of a Kind[/b][/color] if played hand has exactly [color=\"#f3a712\"][b]4[/b][/color] cards\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Points, [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_quantum_computing"] = { name = "Quantum Computing", text = "" },
    ["j_aij_quantum_foam"] = { name = "Quantum Foam", text = "[color=\"#f3a712\"][b]Unenhanced[/b][/color] cards have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to [color=\"#f3a712\"][b]retrigger[/b][/color]" },
    ["j_aij_quark"] = { name = "Quark", text = "Level up [color=\"#f3a712\"][b]Three of a Kind[/b][/color] if scored hand is exactly [color=\"#f3a712\"][b]three[/b][/color] cards of the [color=\"#f3a712\"][b]same rank[/b][/color] but [color=\"#f3a712\"][b]different suits[/b][/color]" },
    ["j_aij_queen_bee"] = { name = "Queen Bee", text = "Scoring [color=\"#f3a712\"][b]Queens[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult per [color=\"#f3a712\"][b]6[/b][/color] held in hand\n[color=\"#9a9a9a\"](Will give [/color][color=\"#ff007f\"][b]X#2#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_quicklime_heart"] = { name = "Quicklime Heart", text = "" },
    ["j_aij_quicksilver"] = { name = "Quicksilver", text = "If played hand is [color=\"#f3a712\"][b]Pair[/b][/color], retrigger all scoring cards" },
    ["j_aij_rag_joker"] = { name = "Rag Joker", text = "" },
    ["j_aij_rahere"] = { name = "Rahere", text = "" },
    ["j_aij_rat_maze"] = { name = "Rat Maze", text = "" },
    ["j_aij_rattling_snow_credits_joker"] = { name = "RattlingSnow353", text = "[color=\"#9a9a9a\"]\"Jack of all trades, master of[/color] [color=\"#9a9a9a\"]none, though oftentimes better[/color] [color=\"#9a9a9a\"]than a master of one.\"[/color]" },
    ["j_aij_read_em_and_weep"] = { name = "Read 'em and Weep", text = "If hand contains a [color=\"#f3a712\"][b]Straight[/b][/color], convert all [color=\"#f3a712\"][b]played[/b][/color] cards to the same random [color=\"#f3a712\"][b]suit[/b][/color] before scoring" },
    ["j_aij_realty_sign"] = { name = "Realty Sign", text = "Playing a [color=\"#f3a712\"][b]Full House[/b][/color] increases the [color=\"#f3a712\"][b]sell value[/b][/color] of this Joker by [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_red_joker"] = { name = "Red Joker", text = "Gains [color=\"#ff007f\"][b]+#2#[/b][/color] Mult per card scored, [color=\"#f3a712\"][b]resets[/b][/color] when playing a card that was previously scored\n[color=\"#9a9a9a\"](Card history clears on reset)[/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_red_sky"] = { name = "Red Sky", text = "Scored cards in [color=\"#f3a712\"][b]first[/b][/color] and [color=\"#f3a712\"][b]last hand[/b][/color] of round give their [color=\"#3772ff\"][b]+Points[/b][/color] as [color=\"#ff007f\"][b]+Mult[/b][/color] instead" },
    ["j_aij_red_wine"] = { name = "Red Wine", text = "[color=\"#f3a712\"][b]First[/b][/color] scoring card each [color=\"#f3a712\"][b]hand[/b][/color] is converted to [color=\"#c23447\"][b]Hearts[/b][/color] suit" },
    ["j_aij_remina"] = { name = "Remina", text = "When [color=\"#f3a712\"][b]Beta Blind[/b][/color] or [color=\"#f3a712\"][b]Alpha Blind[/b][/color] is selected, this Joker [color=\"#ff007f\"][b]destroys[/b][/color] all [color=\"#13afce\"][b]Fruit Cards[/b][/color] in your [color=\"#f3a712\"][b]consumable[/b][/color] area and gains their [color=\"#3772ff\"][b]Points[/b][/color] and [color=\"#ff007f\"][b]Mult[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color] [color=\"#9a9a9a\"]Points, [/color][color=\"#ff007f\"][b]+#1#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_requiem"] = { name = "Requiem", text = "All [color=\"#f3a712\"][b]Jokers[/b][/color] and [color=\"#f3a712\"][b]Buffoon[/b][/color] [color=\"#f3a712\"][b]Packs[/b][/color] are [color=\"#f3a712\"][b]free[/b][/color]" },
    ["j_aij_revolving_jubilation"] = { name = "Revolving Jubilation", text = "" },
    ["j_aij_richie_rich"] = { name = "Richie Rich", text = "[color=\"#f3a712\"][b]X#1#[/b][/color] [color=\"#f3a712\"][b]$[/b][/color] at end of round" },
    ["j_aij_right_angle"] = { name = "Right Angle", text = "Score all [color=\"#f3a712\"][b]10s[/b][/color] held in hand when a [color=\"#f3a712\"][b]9[/b][/color] is scored" },
    ["j_aij_rising_sun"] = { name = "Rising Sun", text = "Retrigger [color=\"#f3a712\"][b]first[/b][/color] and [color=\"#f3a712\"][b]last[/b][/color] scored cards on [color=\"#f3a712\"][b]first[/b][/color] and [color=\"#f3a712\"][b]last hand[/b][/color] of round" },
    ["j_aij_robin"] = { name = "Robin", text = "" },
    ["j_aij_rock_candy"] = { name = "Rock Candy", text = "" },
    ["j_aij_rock_n_roll_clown"] = { name = "Rock n' Roll Clown", text = "Scoring cards give [color=\"#3772ff\"][b]+#1#[/b][/color] Points per [color=\"#f3a712\"][b]level[/b][/color] of [color=\"#f3a712\"][b]all[/b][/color] poker hands [color=\"#f3a712\"][b]combined[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Points)[/color]" },
    ["j_aij_rodeo_clown"] = { name = "Rodeo Clown", text = "This Joker gains [color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]Blind[/b][/color] is defeated on [color=\"#f3a712\"][b]final hand[/b][/color] of round\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#2#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_rodeo_star"] = { name = "Rodeo Star", text = "" },
    ["j_aij_roland"] = { name = "Roland", text = "" },
    ["j_aij_rounding_error"] = { name = "Rounding Error", text = "" },
    ["j_aij_rubberhose"] = { name = "Rubberhose", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult if [color=\"#f3a712\"][b]played hand[/b][/color] contains only [color=\"#e5e5e5\"][b]Dark Suits[/b][/color] or only [color=\"#c23447\"][b]Light Suits[/b][/color]" },
    ["j_aij_rudolph"] = { name = "Rudolph", text = "If [color=\"#f3a712\"][b]first[/b][/color] scored card in hand has a [color=\"#f3a712\"][b]Replay Stamp[/b][/color], retrigger [color=\"#f3a712\"][b]all[/b][/color] other cards" },
    ["j_aij_rue_barre"] = { name = "Rue Barrée", text = "" },
    ["j_aij_rummikub"] = { name = "Rummikub", text = "When [color=\"#f3a712\"][b]Boss Blind[/b][/color] is [color=\"#ff007f\"][b]defeated[/b][/color], create a playing card with a chosen [color=\"#f3a712\"][b]rank[/b][/color], [color=\"#f3a712\"][b]suit[/b][/color], and [color=\"#f3a712\"][b]enhancement[/b][/color], and add it to the deck" },
    ["j_aij_run"] = { name = ">RUN", text = "[color=\"#f3a712\"][b]Jokers[/b][/color] to the [color=\"#f3a712\"][b]left[/b][/color] of this [color=\"#f3a712\"][b]Joker[/b][/color] trigger [color=\"#f3a712\"][b]before[/b][/color] hand is scored, instead of [color=\"#f3a712\"][b]after[/b][/color]\n[color=\"#9a9a9a\"](If applicable)[/color]" },
    ["j_aij_sack_joker"] = { name = "Sack Joker", text = "" },
    ["j_aij_saltimbanco"] = { name = "Saltimbanco", text = "During scoring, successful [color=\"#1bb18c\"][b]probabilities[/b][/color] give [color=\"#ff007f\"][b]XMult[/b][/color] equal to [color=\"#ff007f\"][b]X1[/b][/color] plus their [color=\"#ff007f\"][b]fail[/b][/color] chance\n[color=\"#9a9a9a\"](Ex: [/color][color=\"#1bb18c\"][b]1 in 4[/b][/color] [color=\"#9a9a9a\"] -> [/color][color=\"#ff007f\"][b]X1.75[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_saluto"] = { name = "Saluto", text = "Create a free [color=\"#fe5f55\"][b]Rare Pack[/b][/color] in each shop" },
    ["j_aij_sam_mcgee"] = { name = "Sam McGee", text = "Gives [color=\"#ff007f\"][b]X#2#[/b][/color] Mult for each card past [color=\"#f3a712\"][b]#1#[/b][/color] in [color=\"#f3a712\"][b]played hand[/b][/color]" },
    ["j_aij_sandman"] = { name = "Sandman", text = "" },
    ["j_aij_sanguine_joker"] = { name = "Sanguine Joker", text = "Played cards with [color=\"#c23447\"][b]Heart[/b][/color] suit have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to create a random [color=\"#f3a712\"][b]Pin[/b][/color] when scored" },
    ["j_aij_sannio"] = { name = "Sannio", text = "" },
    ["j_aij_santimariyambu"] = { name = "Santimariyambu", text = "" },
    ["j_aij_sapphic_joker"] = { name = "Sapphic Joker", text = "Scoring [color=\"#f3a712\"][b]Queens[/b][/color] give [color=\"#3772ff\"][b]+#2#[/b][/color] Points and [color=\"#ff007f\"][b]+#1#[/b][/color] Mult per [color=\"#f3a712\"][b]Queen[/b][/color] in [color=\"#f3a712\"][b]full deck[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#3772ff\"][b]+#4#[/b][/color][color=\"#9a9a9a\"] Points, [/color][color=\"#ff007f\"][b]+#3#[/b][/color][color=\"#9a9a9a\"] Mult)[/color]" },
    ["j_aij_sator_square"] = { name = "Sator Square", text = "" },
    ["j_aij_saucy_jacky"] = { name = "Saucy Jacky", text = "[color=\"#ff007f\"][b]Destroy[/b][/color] all scored [color=\"#f3a712\"][b]Queens[/b][/color]\nScored [color=\"#f3a712\"][b]Jacks[/b][/color] give [color=\"#ff007f\"][b]+#2#[/b][/color] Mult per [color=\"#f3a712\"][b]Queen[/b][/color] [color=\"#ff007f\"][b]destroyed[/b][/color] this way\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]+#1#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]" },
    ["j_aij_saveloy"] = { name = "Saveloy", text = "[color=\"#ff007f\"][b]+#1#[/b][/color] Mult, [color=\"#ff007f\"][b]-#2#[/b][/color] Mult for every [color=\"#1bb18c\"][b]reroll[/b][/color] in the [color=\"#f3a712\"][b]shop[/b][/color]" },
    ["j_aij_scanlines"] = { name = "Scanlines", text = "" },
    ["j_aij_scapino"] = { name = "Scapino", text = "[color=\"#1bb18c\"][b]Rerolling[/b][/color] in the [color=\"#f3a712\"][b]Shop[/b][/color] costs [color=\"#f3a712\"][b]+$#1#[/b][/color], but also restocks [color=\"#f3a712\"][b]Packs[/b][/color]" },
    ["j_aij_scarab"] = { name = "Scarab", text = "[color=\"#f3a712\"][b]-#1#[/b][/color] Ante while this Joker is held\n[color=\"#9a9a9a\"](Cannot be sold or destroyed[/color] [color=\"#9a9a9a\"]during the Win Ante)[/color]" },
    ["j_aij_scaramouche"] = { name = "Scaramouche", text = "[color=\"#f3a712\"][b]Retrigger[/b][/color] all scored cards if [color=\"#f3a712\"][b]played hand[/b][/color] is a [color=\"#f3a712\"][b]#1#[/b][/color]\n[color=\"#9a9a9a\"](Hand changes at[/color] [color=\"#9a9a9a\"]end of round)[/color]" },
    ["j_aij_scarecrow"] = { name = "Scarecrow", text = "" },
    ["j_aij_scary_story"] = { name = "Scary Story", text = "Base edition playing cards in [color=\"#f3a712\"][b]Deck Packs[/b][/color] have a [color=\"#1bb18c\"][b]#1# in #2#[/b][/color] chance to become [color=\"#5d5dff\"][b]Inverted[/b][/color]" },
    ["j_aij_scopaesthesia"] = { name = "Scopaesthesia", text = "[color=\"#f3a712\"][b]Reveal[/b][/color] the next card in your [color=\"#f3a712\"][b]deck[/b][/color] [color=\"#f3a712\"][b]Cards[/b][/color] that share its [color=\"#f3a712\"][b]rank[/b][/color] give [color=\"#ff007f\"][b]X#1#[/b][/color] Mult" },
    ["j_aij_scorecard"] = { name = "Scorecard", text = "When [color=\"#f3a712\"][b]Blind[/b][/color] is selected, level up a [color=\"#f3a712\"][b]random[/b][/color] [color=\"#f3a712\"][b]poker hand[/b][/color] by [color=\"#f3a712\"][b]#1#[/b][/color]" },
    ["j_aij_scott_free"] = { name = "Scott Free", text = "[color=\"#f3a712\"][b]Un-enhanced[/b][/color] cards held in hand at [color=\"#f3a712\"][b]end of round[/b][/color] earn [color=\"#f3a712\"][b]$#1#[/b][/color]" },
    ["j_aij_screamer"] = { name = "Screamer", text = "" },
    ["j_aij_screaming_joker"] = { name = "Screaming Joker", text = "" },
    ["j_aij_scroggin"] = { name = "Scroggin", text = "This [color=\"#f3a712\"][b]Joker[/b][/color] gains [color=\"#ff007f\"][b]X#1#[/b][/color] Mult when a card is enhanced to [color=\"#f3a712\"][b]Wild[/b][/color], loses [color=\"#ff007f\"][b]X#2#[/b][/color] Mult when hand contains a [color=\"#f3a712\"][b]Flush[/b][/color]\n[color=\"#9a9a9a\"](Currently [/color][color=\"#ff007f\"][b]X#3#[/b][/color] [color=\"#9a9a9a\"]Mult)[/color]\nCreates [color=\"#d138bf\"][b]Gothic[/b][/color] when [color=\"#f3a712\"][b]obtained[/b][/color]\n[color=\"#9a9a9a\"](Must have room)[/color]" },
    ["j_aij_scrunched_joker"] = { name = "Scrunched Joker", text = "[color=\"#3772ff\"][b]+#1#[/b][/color] Points and [color=\"#ff007f\"][b]+#2#[/b][/color] Mult on [color=\"#f3a712\"][b]first[/b][/color] and [color=\"#f3a712\"][b]last[/b][/color] hand of round\n[color=\"#3772ff\"][b]+#3#[/b][/color] Points and [color=\"#ff007f\"][b]+#4#[/b][/color] Mult otherwise" },
    ["j_aij_sculptor"] = { name = "Sculptor", text = "" },
    ["j_aij_scurra"] = { name = "Scurra", text = "Retrigger all played cards with a [color=\"#ff007f\"][b]Replay Stamp[/b][/color] [color=\"#f3a712\"][b]#1#[/b][/color] additional time" },
    ["j_aij_sd_card"] = { name = "SD Card", text = "" },
    ["j_aij_second_tier_meme"] = { name = "Second Tier Meme", text = "If hand is your [color=\"#f3a712\"][b]second[/b][/color] [color=\"#f3a712\"][b]most[/b][/color] played poker hand, [color=\"#f3a712\"][b]retrigger[/b][/color] all [color=\"#f3a712\"][b]scoring[/b][/color] cards\n[color=\"#9a9a9a\"](Currently: [/color][color=\"#f3a712\"][b]#1#[/b][/color][color=\"#9a9a9a\"])[/color]" },
    ["j_aij_selene"] = { name = "Selene", text = "" },
