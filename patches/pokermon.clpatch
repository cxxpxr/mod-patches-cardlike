-- Pokemon jokers 601-630 (Klinklang, Elgyem, Beheeyem, Litwick line, Axew line, Golett, Golurk, Pawniard, Bisharp).
-- Port of pokejokers_21.lua.
local poke = cardlike.require('lib.pokermon')

--- Create an Inverted (Negative) Fruit card of one of the top highest level hands (Elgyem, Beheeyem).
local function create_top_fruit(card, state, top)
  -- highest level first; the Hands tab order breaks ties
  local order = {}
  for i, id in ipairs(poke.visible_hands(state)) do order[i] = { id = id, pos = i, level = (state.hands[id] or {}).level or 1 } end
  table.sort(order, function(a, b)
    if a.level ~= b.level then return a.level > b.level end
    return a.pos < b.pos
  end)
  local best = {}
  for i = 1, math.min(top, #order) do best[i] = order[i] end
  local pick = poke.random_element(best, state)
  local fruit = pick and poke.FRUIT_OF_HAND[pick.id] or 'fruit'
  poke.create_consumeable({ key = fruit, edition = 'e_negative' }, card)
end

--- Number of different Fruit cards you hold.
local function unique_fruit_count(state)
  if not state or not state.consumables then return 0 end
  local seen, n = {}, 0
  for _, c in ipairs(state.consumables) do
    local info = c.lastInfo or {}
    local id = info.consumable or c:getConsumableDef()
    if info.type == 'fruit' and id and not seen[id] then
      seen[id] = true
      n = n + 1
    end
  end
  return n
end

---------------------------------------------------------------------------
-- Axew line: a Nature of two random visible hand types, chosen when the card appears.
---------------------------------------------------------------------------

local function hand_nature(card, state)
  local ids = {}
  for _, id in ipairs(poke.visible_hands(state)) do ids[#ids + 1] = id end
  poke.shuffle(ids, state)
  poke.set(card, 'targets', { { ids[1] or 'HIGH_CARD' }, { ids[2] or 'PAIR' } })
end

local function nature_vars(get, card)
  local t = get('targets') or {}
  local a = t[1] and t[1][1]
  local b = t[2] and t[2][1]
  return a and poke.hand_name(a) or 'None', b and poke.hand_name(b) or 'None'
end

local function is_nature(card, hand_type)
  local t = poke.get(card, 'targets') or {}
  return (t[1] and t[1][1] == hand_type) or (t[2] and t[2][1] == hand_type) or false
end

--- Triggers of the Axew line. factor: 2 or 3. first_only: only the first Nature hand of each round (Axew).
--- Base Points and Mult of the hand are multiplied when the first scoring card starts to score: the game sets the
--- base values after beforeAllCardsScored, so the multiplication waits for beforeScore.
local function nature_triggers(factor, first_only, count_played)
  return {
    beforeAllCardsScored = function(card, state, step, result)
      if not is_nature(card, step.hand.handType) then return end
      if first_only and poke.get(card, 'active') == false then return end
      poke.add(card, 'poke_nature_pending', 1)
      if first_only and not step.copiedBy then poke.set(card, 'active', false) end
    end,
    beforeScore = function(card, state, step, result)
      local pending = poke.get(card, 'poke_nature_pending', 0) or 0
      if pending <= 0 then return end
      poke.set(card, 'poke_nature_pending', pending - 1)
      result:add(xChips(factor))
      result:add(xMult(factor))
      result:say('X' .. factor .. ' Base', colors.ORANGE)
    end,
    afterAllCardsScored = function(card, state, step, result)
      if count_played and not step.copiedBy and is_nature(card, step.hand.handType) then
        poke.add(card, 'nature_played', 1)
      end
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'poke_nature_pending', 0) end
    end,
    afterRound = function(card, state, step, result)
      if first_only and not step.copiedBy then poke.set(card, 'active', true) end
    end,
  }
end

local function sell_value(card, def)
  if card and card.uid then return card:getSellValue() end
  return math.max(1, math.floor((def.cost or 2) / 2))
end

---------------------------------------------------------------------------

-- Klinklang 601: earn $1 and gain X0.4 Mult for every 8 cards drawn during Blinds. The X Mult resets at the end
-- of the round.
poke.addPokemon {
  name = 'klinklang',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'Two',
  ptype = 'Metal',
  gen = 5,
  config = { money = 1, Xmult = 1, Xmult_mod = 0.4, Xmult2 = 1, drawn = 0, to_draw = 8 },
  vars = function(get)
    return { get('money'), get('to_draw'), math.max(0, get('to_draw') - get('drawn')), get('Xmult'), get('Xmult_mod') }
  end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      if step.copiedBy then return end
      local drawn = poke.add(card, 'drawn', #poke.drawn_cards(state, step))
      local to_draw = poke.get(card, 'to_draw')
      if drawn >= to_draw then
        poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
        local earned = poke.ease_poke_dollars(card, 'klinklang', poke.get(card, 'money') * math.floor(drawn / to_draw), true, state)
        poke.set(card, 'drawn', drawn % to_draw)
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
        result:add(plusMoney(earned))
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult2'))
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Elgyem 605: when a Blind is selected, create an Inverted Fruit card of one of your 5 highest level hands.
-- Evolves when holding 5 different Fruit cards.
poke.addPokemon {
  name = 'elgyem',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Psychic',
  gen = 5,
  config = { top_planets = 5, current_planet_count = 0 },
  evo_rqmt = 5,
  attributes = { 'planet', 'generation', 'space', 'condition_evo' },
  vars = function(get, card, state)
    return { get('top_planets'), card and unique_fruit_count(state) or 0, 5 }
  end,
  triggers = {
    beforeRound = function(card, state, step, result)
      create_top_fruit(card, state, poke.get(card, 'top_planets'))
    end,
  },
  evolution = function(card, state)
    local n = unique_fruit_count(state)
    poke.set(card, 'current_planet_count', n)
    return poke.scaling_evo(card, state, 'beheeyem', n, 5)
  end,
}

-- Beheeyem 606: when a Blind is selected, create an Inverted Fruit card of one of your 3 highest level hands.
-- After opening 9 Packs, put a Fruit Bowl (Telescope) or Blender (Observatory) ticket in the shop if able.
local TELESCOPE, OBSERVATORY = 'ticket_10', 'ticket_11'

local function ticket_in_shop(state, id)
  for _, c in ipairs(state.shopCards or {}) do
    if (c.lastInfo or {}).consumable == id then return true end
  end
  return false
end

poke.addPokemon {
  name = 'beheeyem',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Psychic',
  gen = 5,
  config = { top_planets = 3, boosters_to_open = 9 },
  attributes = { 'planet', 'generation', 'space' },
  vars = function(get) return { get('top_planets'), get('boosters_to_open') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      create_top_fruit(card, state, poke.get(card, 'top_planets'))
    end,
    onPackOpened = function(card, state, step, result)
      if step.copiedBy then return end
      if state:hasTicket(TELESCOPE) and state:hasTicket(OBSERVATORY) then return end
      local left = poke.get(card, 'boosters_to_open')
      if left > 1 then
        poke.set(card, 'boosters_to_open', left - 1)
        return
      end
      -- the last Pack: the ticket goes into the shop (outside the shop the count waits at 1)
      local want
      if not state:hasTicket(TELESCOPE) then want = TELESCOPE
      elseif not state:hasTicket(OBSERVATORY) then want = OBSERVATORY end
      if want and ticket_in_shop(state, want) then want = nil end
      if want then
        if not cardlike.addShopItem(want) then return end
        card:punch()
        result:say('+1 Ticket', colors.ORANGE)
      end
      poke.set(card, 'boosters_to_open', 9)
    end,
  },
}

-- Litwick 607: +3 Mult, tripled with $7 or more sell value. Drains $1 from adjacent jokers at the end of the round.
-- Evolves at $13 sell value.
poke.addPokemon {
  name = 'litwick',
  rarity = 2,
  cost = 6,
  stage = 'Basic',
  ptype = 'Fire',
  gen = 5,
  config = { mult = 3, money_minus = 1, sell_goal = 7 },
  evo_rqmt = 13,
  attributes = { 'drain', 'mult', 'sell_value', 'scaling', 'scaling_evo' },
  vars = function(get, card)
    return { get('money_minus'), 13, sell_value(card, poke.pokemon.litwick), get('mult'), get('sell_goal') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if card:getSellValue() >= poke.get(card, 'sell_goal') then mult = mult * 3 end
      result:add(plusMult(mult))
    end,
    afterRound = function(card, state, step, result)
      for _, v in ipairs(poke.get_adjacent_jokers(card, state)) do
        poke.drain_value(card, v, poke.get(card, 'money_minus'))
      end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'lampent', card:getSellValue(), 13)
  end,
}

-- Lampent 608: drains $1 from all other jokers at the end of the round. Adds its sell value to Mult.
-- Evolves with a Dusk Stone.
poke.addPokemon {
