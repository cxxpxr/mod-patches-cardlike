    beforeRound = function(card, state, step, result)
      if state.money < poke.get(card, 'money_threshold') then
        card:punch()
        result:add(plusMoney(poke.ease_poke_dollars(card, 'pikachu', poke.get(card, 'money'), true, state)))
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      if state.money >= poke.get(card, 'money_threshold') then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'raichu') end,
}

-- Mult for every $money_count you have (Raichu, Mega Raichu Y).
local function money_mult(card, state)
  if not state or state.money == nil then return 0 end
  return poke.get(card, 'mult_mod') * math.floor(math.max(0, state.money) / poke.get(card, 'money_count'))
end

