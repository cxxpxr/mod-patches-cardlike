-- Vileplume 045
poke.addPokemon {
  name = 'vileplume', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 1,
  config = { Xmult_multi = 1.5, mult = 7, Xmult_multi2 = 1.3 },
  attributes = { 'mult', 'xmult', 'rank', 'ace', 'three', 'five', 'seven', 'nine' },
  vars = function(get) return { get('Xmult_multi'), get('mult'), get('Xmult_multi2') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or not poke.is_odd(step.card) then return end
      local which = pick3(state, 1, 2, 3)
      if which == 1 then result:add(plusMult(poke.get(card, 'mult')))
      elseif which == 2 then result:add(xMult(poke.get(card, 'Xmult_multi2')))
      else result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
}

