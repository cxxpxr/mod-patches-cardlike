-- Ampharos 181
poke.addPokemon {
  name = 'ampharos', rarity = 'poke_safari', cost = 9, stage = 'Two', ptype = 'Lightning', gen = 2,
  config = { Xmult = 1, Xmult_mod = 0.3 },
  custom_values_to_keep = { 'Xmult' },
  megas = { 'mega_ampharos' },
  attributes = { 'xmult', 'scaling' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x >= 0.01 then result:add(xMult(x)) end
    end,
    onCardsAdded = function(card, state, step, result)
      if step.copiedBy then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
    end,
  },
}

poke.addPokemon {
  name = 'mega_ampharos', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Dragon', gen = 2,
  blueprint_compat = false,
  config = { Xmult = 1, Xmult_mod = 0.3 },
  custom_values_to_keep = { 'Xmult' },
  attributes = { 'xmult', 'hand_size', 'full_deck', 'hands', 'discard' },
  vars = function(get, card, state)
    return { get('Xmult'), state and state.unDrawnCards and math.ceil(#state.unDrawnCards / 2) or 0 }
  end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local want = math.ceil(#(state.unDrawnCards or {}) / 2)
      local have = state.handSize + (state.extraEphemeralHandSize or 0)
      if have < want then state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + (want - have) end
      state.discardsLeft = 0
      poke.ease_hands_played(-(state.handsLeft - 1), state)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 0 and x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

-- Bellossom 182
-- Odd scoring cards: a 50% roll upgrades them (plain -> Plaid or Seed, enhanced without edition -> Luna, Holo or
-- Chroma). The odd cards that are not upgraded give +7 Mult when scored.
local bellossom_marks = {}
poke.addPokemon {
  name = 'bellossom', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 2,
  blueprint_compat = false,
  config = { mult = 7 },
  attributes = { 'mult', 'rank', 'ace', 'three', 'five', 'seven', 'nine', 'modify_card', 'enhancements', 'editions' },
  vars = function(get) return { get('mult') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local marks = {}
      bellossom_marks[card.uid] = marks
      local upgraded = 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        local upgrade = state:randomFloat() > 0.5
        local enh = poke.enhancement(c)
        local edition = poke.info(c).edition
        local has_edition = edition ~= nil and edition ~= 'default'
        if poke.is_odd(c) and upgrade and not (enh ~= 'Default' and has_edition) then
          upgraded = upgraded + 1
          if enh ~= 'Default' then
            c:setEdition(poke.random_edition(state))
          else
            c:setEnhancement(state:randomFloat() < 0.5 and 'Plaid' or poke.ENHANCEMENT_IDS.m_poke_seed)
          end
          c:punch()
        else
          marks[c.uid] = true
        end
      end
      if upgraded > 0 then result:say(poke.text.dict('poke_petal_dance_ex', 'Petal!'), colors.MULT) end
    end,
    onScore = function(card, state, step, result)
      local c = step.card
      if poke.is_debuffed(c) or not poke.is_odd(c) then return end
      local marks = bellossom_marks[card.uid]
      if marks and marks[c.uid] then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then bellossom_marks[card.uid] = nil end
    end,
  },
}

-- Marill 183
poke.addPokemon {
  name = 'marill', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Water', gen = 2,
  config = { bonus_scored = 0, Xmult = 2 },
  evo_rqmt = 15,
  attributes = { 'xmult', 'enhancements', 'condition_evo' },
  vars = function(get) return { math.max(0, 15 - get('bonus_scored')), get('Xmult') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.copiedBy or poke.is_debuffed(step.card) then return end
      if poke.enhancement(step.card) == 'Chipped' then poke.add(card, 'bonus_scored', 1) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local enhanced, plain = false, false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.enhancement(c) == 'Default' then plain = true else enhanced = true end
      end
      if enhanced and plain then result:add(xMult(poke.get(card, 'Xmult'))) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'azumarill', poke.get(card, 'bonus_scored'), 15)
  end,
}

-- Azumarill 184
poke.addPokemon {
  name = 'azumarill', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Water', gen = 2,
  config = { Xmult = 2 },
  attributes = { 'xmult', 'enhancements' },
  vars = function(get) return { get('Xmult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      local bonus, other = false, false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.enhancement(c) == 'Chipped' and not poke.is_debuffed(c) then bonus = true else other = true end
      end
      if bonus and other then x = x * 2 end
      result:add(xMult(x))
    end,
  },
}

