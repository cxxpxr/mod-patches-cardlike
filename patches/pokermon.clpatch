== file lib/registry.lua (362 lines)
-- The Pokemon registry: P.addPokemon registers a Pokemon joker with Cardlike and remembers its Pokermon data
-- (stage, type, config defaults, evolution data) so the rest of the library can look it up by name or by card.
local P = cardlike.require('lib.base')

P.pokemon = {}      -- name -> def (the table given to P.addPokemon, after cardlike.addJoker filled in id)
P.pokemon_list = {} -- defs in load order
P.by_id = {}        -- full joker id -> def

-- Ids of the built-in jokers (they have no mod prefix), read once.
local builtin_jokers
local function builtin_joker(id)
  if not builtin_jokers then
    builtin_jokers = {}
    for _, info in ipairs(cardlike.listContent('joker') or {}) do
      if type(info.id) == 'string' and not info.id:find(':', 1, true) then builtin_jokers[info.id] = true end
    end
  end
  return builtin_jokers[id] == true
end

--- Full joker id of a Pokemon name. Accepts 'bulbasaur', 'j_poke_bulbasaur' and 'pokermon:bulbasaur'. A built-in
--- joker id ('joker_jimbo') and a full id of another mod stay as they are.
function P.id(name)
  if type(name) ~= 'string' then return nil end
  if name:find(':', 1, true) then return name end
  local short = name:gsub('^j_poke_', '')
  local def = P.pokemon[short]
  if def then return def.id end
  if short == name and builtin_joker(name) then return name end
  return P.MOD_ID .. ':' .. short
end

--- Whether a joker id (a Pokemon name, a full id or a built-in id) names a joker that exists.
function P.joker_exists(name)
  local id = P.id(name)
  return id ~= nil and (P.by_id[id] ~= nil or builtin_joker(id) or cardlike.contentInfo('joker', id) ~= nil)
end

--- Short Pokemon name of a joker id ('pokermon:bulbasaur' -> 'bulbasaur').
function P.short(id)
  if type(id) ~= 'string' then return nil end
  return (id:gsub('^.*:', ''):gsub('^j_poke_', ''))
end

--- The Pokemon def of a joker card, a joker id or a name. nil for jokers that are not Pokemon.
function P.def(x)
  if x == nil then return nil end
  if type(x) == 'table' then
    if x.name and x.stage ~= nil and P.pokemon[x.name] == x then return x end
    if x.uid then
      local id = x.getJokerDef and x:getJokerDef()
      return id and P.by_id[id]
    end
    return nil
  end
  if type(x) == 'string' then
    return P.by_id[x] or P.pokemon[(x:gsub('^j_poke_', ''))] or P.by_id[P.MOD_ID .. ':' .. x]
  end
  return nil
end

--- Pokemon name of a joker card ('bulbasaur'), or nil.
function P.name(card)
  local def = P.def(card)
  return def and def.name
end

function P.is_pokemon(card)
  local def = P.def(card)
  return def ~= nil and def.stage ~= nil and def.stage ~= 'Other'
end

--- Default value of a config key for a def.
function P.default(def, key)
  if not def or type(def.config) ~= 'table' then return nil end
  local v = def.config[key]
  if type(v) == 'table' then return P.deep_copy(v) end
  return v
end

--- A value of a joker: its data store value, or the config default of its Pokemon def.
--- (Joker values that change live in the card's data store under the same names as the original config.extra.)
function P.get(card, key, default)
  if card and card.uid then
    local v = card:getDataStore():get(key)
    if v ~= nil then return v end
  end
  local def = P.def(card)
  local v = P.default(def, key)
  if v == nil then return default end
  return v
end

function P.set(card, key, value)
  if card and card.uid then card:getDataStore():set(key, value) end
  return value
end

--- Add to a number value and return the new value.
function P.add(card, key, delta)
  local v = (tonumber(P.get(card, key, 0)) or 0) + (delta or 1)
  P.set(card, key, v)
  return v
end

--- A getter for description functions: get(key) reads the card's value, or the default when there is no card.
function P.getter(card, def)
  return function(key, default)
    if card then return P.get(card, key, default) end
    local v = P.default(def, key)
    if v == nil then return default end
    return v
  end
end

local function description_for(def)
  return function(r)
    local card = r and r.card
    local state = card and cardlike.state or nil
    local get = P.getter(card, def)
    local vars = {}
    if def.vars then
      local ok, v = pcall(def.vars, get, card, state)
      if ok and type(v) == 'table' then vars = v end
      if not ok then cardlike.log('vars of ' .. def.name .. ': ' .. tostring(v)) end
    end
    local text
    if type(def.text) == 'function' then
      text = def.text(get, card, state, vars)
    elseif type(def.text) == 'table' or type(def.text) == 'string' then
      text = P.text.format(def.text, vars)
    else
      local entry = P.text.entry('Joker', def.loc_key or ('j_poke_' .. def.name))
      text = entry and P.text.format(entry.text, vars) or ''
    end
    local extra = P.ui.pokemon_info_lines(def, card)
    if extra ~= '' then text = text .. '\n' .. extra end
    return text
  end
end

-- Hooks that run for every Pokemon when it joins or leaves your jokers.
P.on_added_hooks, P.on_removed_hooks = {}, {}

--- Register a Pokemon joker. Fields (all optional except name):
---   name        Pokemon name, also the joker id ('bulbasaur' -> 'pokermon:bulbasaur').
---   rarity      1, 2, 3, 4, 'poke_safari', 'poke_mega', or a Cardlike rarity.
---   cost        buy price.
---   stage       'Baby', 'Basic', 'One', 'Two', 'Legendary', 'Mega', 'Other'.
---   ptype       'Grass', 'Fire', ... (see P.TYPES).
---   gen         generation (1 to 9), for the generation settings.
---   config      default values (the original config.extra). They live in the card's data store.
---   evo_rqmt, item_req, evo_list, megas, aux_poke, starter, attributes, copy_scaled, custom_values_to_keep,
---   no_energy_limit, enhancement_gate: as in Pokermon.
---   blueprint_compat  false stops Copycat (Cardlike copyable).
---   vars(get, card, state)  returns the #1#, #2# values of the English text (get(key) reads a value).
---   text        text lines to use in place of the English text of 'j_poke_<name>', or function(get, card, state, vars).
---   triggers, onAdded, onRemoved, dollarsAtRoundEnd, buttons: as in cardlike.addJoker.
---   evolution(card, state)  runs at the end of each won round; call P.level_evo / P.scaling_evo / P.item_evo there.
---   in_pool(state)  return false to keep the joker out of the shop and packs.
---   sprite, layerSprite  override the art (default: from the sprite table by name, see lib/sprites.lua).
---   passives    effects while the joker is owned: { hand_size = 'h_size', discards = 'd_size', ... } (lib/passives.lua).
---   nature(card, state)  picks the card's Nature once, when it appears (P.rank_nature, P.suit_nature).
---   hand_rules, splash, chance_mod, prevent_debuff, undebuffable: shared rules, see lib/rules.lua.
function P.addPokemon(def)
  assert(type(def) == 'table' and type(def.name) == 'string', 'P.addPokemon needs a table with a name')
  def.config = def.config or {}
  def.attributes = def.attributes or {}
  if def.ptype then def.attributes[#def.attributes + 1] = def.ptype:lower() .. '_type' end
  if def.stage then def.attributes[#def.attributes + 1] = 'stage_' .. def.stage:lower() end
  def.poke_rarity = def.rarity
  local art = {}
  if not def.sprite then art = P.sprites.pokemon(def.name) or {} end
  local entry = P.text.entry('Joker', def.loc_key or ('j_poke_' .. def.name))
  local joker = {
    id = def.name,
    readableName = def.readableName or (entry and P.text.terms(entry.name)) or def.name,
    rarity = P.rarity(def.rarity),
    price = def.cost,
    copyable = def.blueprint_compat ~= false and def.copyable ~= false,
    description = description_for(def),
    triggers = def.triggers,
    dollarsAtRoundEnd = def.dollarsAtRoundEnd,
    buttons = def.buttons,
    sprite = def.sprite or art.sprite,
    layerSprite = def.layerSprite or art.layerSprite,
    image = def.image,
    credits = def.credits or art.credits,
    onAdded = function(card, state)
      -- write the config defaults the card does not have yet
      local ds = card:getDataStore()
      for k, v in pairs(def.config) do
        if not ds:has(k) then ds:set(k, P.default(def, k)) end
      end
      for _, h in ipairs(P.on_added_hooks) do h(card, state, def) end
      P.set_nature(card, state, def)
      P.apply_passives(card, state, def)
      if def.onAdded then return def.onAdded(card, state) end
    end,
    onRemoved = function(card, state)
      for _, h in ipairs(P.on_removed_hooks) do h(card, state, def) end
      P.remove_passives(card, state)
      if def.onRemoved then return def.onRemoved(card, state) end
    end,
  }
  local id = cardlike.addJoker(joker)
  def.id = id
  def.joker = joker
  if not P.pokemon[def.name] then P.pokemon_list[#P.pokemon_list + 1] = def end
  P.pokemon[def.name] = def
  P.by_id[id] = def
  if def.family then P.add_to_family(nil, def.family) end
  return id
end

---------------------------------------------------------------------------
-- Natures (Balatro set_ability picks them when the card is created): a def's nature(card, state) sets the card's
-- 'targets' once. The library runs it when the card appears (onCardCreated, so the shop shows it) or, at the latest,
-- when it joins your jokers. Evolution keeps 'targets' and the 'poke_nature_set' flag, so a card keeps its Nature.
---------------------------------------------------------------------------

function P.set_nature(card, state, def)
  def = def or P.def(card)
  if not def or not def.nature or not card or not card.uid then return end
  local ds = card:getDataStore()
  if ds:get('poke_nature_set') then return end
  state = state or cardlike.state
  if not state or state.money == nil then return end
  ds:set('poke_nature_set', true)
  def.nature(card, state)
end

--- A Nature of n random ranks (Treecko line, Corphish line): targets = { { value = 'King', id = 13 }, ... }.
function P.rank_nature(n)
  return function(card, state)
    P.set(card, 'targets', P.get_target_card_ranks(n or 3, P.get(card, 'targets'), false, state))
  end
end

--- A Nature of one suit of the deck, from limit (Wurmple line): targets = { { suit = 'Hearts' } }.
function P.suit_nature(limit)
  return function(card, state)
    P.set(card, 'targets', P.get_target_card_suit(true, limit[1], limit, state))
  end
end

cardlike.on('onCardCreated', function(state, step)
  local card = step.card
  if card and card.lastInfo and card.lastInfo.kind == 'joker' then P.set_nature(card, state) end
end)

--- Run a def's own add or remove code for a card (used when a Pokemon evolves: the old form leaves, the new one joins).
function P.call_added(card, state, def)
  if def and def.joker and def.joker.onAdded then def.joker.onAdded(card, state) end
end
function P.call_removed(card, state, def)
  if def and def.joker and def.joker.onRemoved then def.joker.onRemoved(card, state) end
end

---------------------------------------------------------------------------
-- Pools: which Pokemon can appear (Balatro in_pool, family rules, generation settings, Pokemon Only)
---------------------------------------------------------------------------

function P.get_gen_allowed(def)
  local gen = def and def.gen
  if not gen then return true end
  local keys = { 'gen_one', 'gen_two', 'gen_three', 'gen_four', 'gen_five', 'gen_six', 'gen_seven', 'gen_eight', 'gen_nine' }
  local k = keys[gen]
  if not k then return true end
  return P.settings[k] ~= false
end

local function has_attr(def, attr)
  for _, a in ipairs(def.attributes or {}) do if a == attr then return true end end
  return false
end
P.has_attribute = has_attr

--- Whether a Pokemon may appear now (in the shop, in packs or from a random pick).
function P.can_appear(def, state)
  if not def then return true end
  if def.hidden then return false end
  local r = def.poke_rarity
  if r == 'poke_safari' or r == 'poke_mega' or r == 'safari' or r == 'mega' then return false end
  if not P.get_gen_allowed(def) then return false end
  if not P.settings.hazards_on and has_attr(def, 'hazards') then return false end
  if def.stage and def.stage ~= 'Other' and P.family_present(def, state) then return false end
  if def.in_pool then
    local ok, v = pcall(def.in_pool, state)
    if ok and v == false then return false end
  end
  if def.enhancement_gate and state then
    local found = false
    local gate = P.ENHANCEMENT_IDS and P.ENHANCEMENT_IDS[def.enhancement_gate] or def.enhancement_gate
    for _, c in ipairs(state.allCards or {}) do
      if (c.lastInfo or {}).enhancement == gate then found = true break end
    end
    if not found then return false end
  end
  return true
end

cardlike.filter('jokerPool', function(ids, rarity)
  local state = cardlike.state
  local keep = {}
  for _, id in ipairs(ids) do
    local def = P.by_id[id]
    if def then
      if P.can_appear(def, state) then keep[#keep + 1] = id end
    elseif not P.settings.pokemon_only then
      keep[#keep + 1] = id
    end
  end
  return keep
end)

-- Remember the Pokemon that appeared this run (Balatro used_jokers): one of each family appears per run.
local function mark_seen(card)
  local def = P.def(card)
  if def then P.run.seen[def.name] = true end
end
cardlike.on('onCardObtained', function(state, step) if step.card then mark_seen(step.card) end end)
cardlike.on('onCardBought', function(state, step) if step.card then mark_seen(step.card) end end)

--- A random Pokemon joker id. options: seed (unused), stage (name or list), rarity (1..4, name or list), type,
--- exclude_keys, exclude_types. Balatro: pokermon.get_random_poke_key / get_random_poke_key_options.
function P.get_random_poke_key(options, state)
  options = options or {}
  state = state or cardlike.state
  local stages = P.convert_to_set(options.stage or options.pokestage)
  local rarity = options.rarity or options.pokerarity
  local rarities
  if rarity then
    rarities = {}
    for _, r in ipairs(type(rarity) == 'table' and rarity or { rarity }) do rarities[P.rarity(r)] = true end
  end
  local ptype = options.type or options.poketype
  local exclude = P.convert_to_set(options.exclude_keys) or {}
  local exclude_types = P.convert_to_set(options.exclude_types) or {}
  local list = {}
  for _, def in ipairs(P.pokemon_list) do
    if def.stage and def.stage ~= 'Other' and not def.aux_poke and def.poke_rarity ~= 'poke_mega'
        and (not stages or stages[def.stage]) and (not rarities or rarities[P.rarity(def.poke_rarity)])
        and (not ptype or ptype == def.ptype) and not exclude_types[def.ptype or '']
        and not exclude[def.name] and not exclude[def.id] and not exclude['j_poke_' .. def.name]
        and P.get_gen_allowed(def) and not P.family_present(def, state) and not def.hidden
        and (not def.in_pool or def.in_pool(state) ~= false) then
      list[#list + 1] = def.id
    end
  end
  if #list == 0 then return P.id('caterpie') end
  local r = state and state.random and state:random(1, #list) or math.floor(cardlike.random() * #list) + 1
  return list[r]
end
P.get_random_poke_key_options = P.get_random_poke_key

--- Create a random Pokemon joker (Balatro pokermon.create_random_poke_joker). Returns the card or nil.
function P.create_random_poke_joker(options, opts)
  local id = P.get_random_poke_key(options)
  return cardlike.createJoker(id, opts)
end


== file lib/rules.lua (363 lines)
-- Game rules that several Pokemon change. A Pokemon turns a rule on with a field of its def; the library has one
-- filter or listener per rule, so the rules agree when several of these jokers are owned.
--
--   chance_mod = 'plus_odds'       adds config plus_odds to the numerator of every chance (Venonat, Venomoth)
--   chance_mod = 'plus_odds_flat'  chances x (1 + plus_odds), summed over these jokers (Togekiss)
--   chance_mod = 'lucky_triple'    chances x3 after a Paperback card triggered this round (Leafeon)
--   chance_mod = 'fail'            every chance roll fails (Absol)
--   config.debt = N                money can go down to -$N (Snorunt, Glalie, Froslass)
--   splash = true                  every played card scores (Balatro Splash, Cardlike Rainbow: Magikarp, Feebas, Luvdisc)
--   prevent_debuff = function(playing_card) return true end   those cards cannot be debuffed (Tentacruel, Tangrowth)
--   undebuffable = true            the joker itself cannot be debuffed (Gholdengo)
--   face_rule = function(playing_card) return true end       those cards are also face cards (Probopass, Panpour)
--   no_slot = true                 taking the joker from the shop needs no free joker slot (Shell, Roaming Gimmighoul)
--   hand_rules = { ... }           Flush and Straight rules, see the hand part section below
-- Also here: the joker-destroyed tracker (P.on_joker_destroyed) and the Unown data store keys (P.UNOWN).
local P = cardlike.require('lib.base')

-- Your jokers that are not debuffed and whose def has a field, as { card, def } pairs.
local function active_with(state, field)
  local out = {}
  for _, j in ipairs(state and state.jokers or {}) do
    local def = P.def(j)
    if def and def[field] ~= nil and not P.is_debuffed(j) then out[#out + 1] = { j, def } end
  end
  return out
end
P.active_with = active_with

---------------------------------------------------------------------------
-- Chances (Balatro mod_probability and fix_probability)
---------------------------------------------------------------------------

--- How much the Pokemon multiply every chance now (1: no change), and whether every chance fails.
function P.chance_factor(state)
  state = state or cardlike.state
  if not state or state.money == nil then return 1, false end
  local plus, flat, scale, fail = 0, 0, 1, false
  for _, pair in ipairs(active_with(state, 'chance_mod')) do
    local card, kind = pair[1], pair[2].chance_mod
    if kind == 'plus_odds' then plus = plus + (P.get(card, 'plus_odds', 0) or 0)
    elseif kind == 'plus_odds_flat' then flat = flat + (P.get(card, 'plus_odds', 1) or 1)
    elseif kind == 'lucky_triple' then
      if (P.run.lucky_triggers or 0) > 0 then scale = scale * 3 end
    elseif kind == 'fail' then fail = true end
  end
  local m = state.chanceMultiplier or 1
  if m <= 0 then m = 1 end
  return (m + plus) / m * (1 + flat) * scale, fail
end

cardlike.filter('chance', function(p)
  local factor, fail = P.chance_factor(cardlike.state)
  if fail then return false end
  if type(p) ~= 'number' or p <= 0 or factor == 1 then return nil end
  return math.min(1, p * factor)
end)

--- The shown numerator of a chance "num in dem": after the chance multiplier and the Pokemon above.
function P.chance_num(num, state)
  num = num or 1
  if not state or state.money == nil then return num end
  local factor = P.chance_factor(state)
  return num * (state.chanceMultiplier or 1) * factor
end

--- The "#1# in #2#" values of a chance (Balatro SMODS.get_probability_vars): numerator, denominator.
function P.chance_vars(num, dem, state)
  return P.chance_num(num, state), dem
end

---------------------------------------------------------------------------
-- Debt: "Go up to -$N in debt". Cardlike lets money go down to a lowest amount (below $0 only with IOU). There is no
-- event or filter for it, so this hooks the state method that returns the lowest amount (the hook works in the game;
-- the test harness does not run hooks).
---------------------------------------------------------------------------

function P.total_debt(state)
  local n = 0
  for _, j in ipairs(state and state.jokers or {}) do
    local def = P.def(j)
    if def and def.config.debt ~= nil and not P.is_debuffed(j) then n = n + (tonumber(P.get(j, 'debt', 0)) or 0) end
  end
  return n
end

cardlike.hook('SaveState.getLowestAmount', {
  after = function(state, result)
    if type(result) ~= 'number' then return nil end
    local debt = P.total_debt(cardlike.state)
    if debt > 0 then return result - debt end
  end,
})

---------------------------------------------------------------------------
-- Splash: every played card scores.
---------------------------------------------------------------------------

cardlike.filter('scoringCards', function(uids, played)
  local state = cardlike.state
  if not state or state.money == nil or type(played) ~= 'table' then return nil end
  if #active_with(state, 'splash') == 0 then return nil end
  local all = {}
  for _, c in ipairs(played) do all[#all + 1] = c.uid end
  if #all == 0 then return nil end
  return all
end)

---------------------------------------------------------------------------
-- Face cards: a def's face_rule(playing_card) returns true for cards that also count as face cards while the joker
-- is owned and not debuffed (Probopass, Panpour, Simipour).
---------------------------------------------------------------------------

cardlike.filter('isFace', function(face, card)
  if face then return nil end
  local state = cardlike.state
  if not card or not state or state.money == nil then return nil end
  local info = card.lastInfo or {}
  if info.kind ~= nil and info.kind ~= 'playing' then return nil end
  for _, pair in ipairs(active_with(state, 'face_rule')) do
    if pair[2].face_rule(card) then return true end
  end
  return nil
end)

---------------------------------------------------------------------------
-- Jokers that take no joker slot when you take them from the shop (the original is Negative and destroys itself at
-- once): no_slot = true (Slowpoke's Shell, Roaming Gimmighoul).
---------------------------------------------------------------------------

cardlike.filter('hasRoom', function(has, card)
  if has then return nil end
  local info = card and (card.lastInfo or card:info())
  local def = info and info.kind == 'joker' and P.by_id[info.joker]
  if def and def.no_slot then return true end
  return nil
end)

---------------------------------------------------------------------------
-- Cards that cannot be debuffed. Cardlike has no way to stop a debuff, so the debuff is taken off again when the game
-- reaches these moments: cards in hand when cards are drawn, played cards before they score, and the undebuffable
-- jokers at the start of a round, a draw, a hand and the shop (a debuffed joker runs no triggers, so these are
-- listeners).
---------------------------------------------------------------------------

local function undebuff_cards(state, cards)
  local rules = active_with(state, 'prevent_debuff')
  if #rules == 0 then return end
  for _, c in ipairs(cards or {}) do
    if c:getDebuffState() then
      for _, pair in ipairs(rules) do
        if pair[2].prevent_debuff(c) then
          c:setDebuffState(false)
          break
        end
      end
    end
  end
end

local function undebuff_jokers(state)
  for _, j in ipairs(state and state.jokers or {}) do
    local def = P.def(j)
    if def and def.undebuffable and j:getDebuffState() then j:setDebuffState(false) end
  end
end

cardlike.on('onRoundStart', function(state) undebuff_jokers(state) end)
cardlike.on('onShopEnter', function(state) undebuff_jokers(state) end)
cardlike.on('onHandDrawn', function(state)
  undebuff_jokers(state)
  undebuff_cards(state, state.cardsInHand)
end)
cardlike.on('beforeAllCardsScored', function(state, step)
  undebuff_jokers(state)
  undebuff_cards(state, step.hand and step.hand.allCards)
end)

---------------------------------------------------------------------------
-- Destroyed jokers. Cardlike has no joker-destroyed event: the library remembers your jokers at each step, and a
-- joker that is gone without being sold was destroyed. P.on_joker_destroyed(function(state, uid, joker_id) end).
---------------------------------------------------------------------------

local destroyed_handlers = {}
function P.on_joker_destroyed(fn) destroyed_handlers[#destroyed_handlers + 1] = fn end

local known_jokers, sold_jokers = nil, {}
local function check_destroyed_jokers(state)
  if not state or not state.jokers then return end
  local now = {}
  for _, j in ipairs(state.jokers) do now[j.uid] = j:getJokerDef() end
  if known_jokers and #destroyed_handlers > 0 then
    for uid, jid in pairs(known_jokers) do
      if not now[uid] and not sold_jokers[uid] then
        for _, fn in ipairs(destroyed_handlers) do fn(state, uid, jid) end
      end
    end
  end
  known_jokers, sold_jokers = now, {}
end
cardlike.on('onRunStart', function() known_jokers, sold_jokers = nil, {} end)
cardlike.on('onCardSold', function(state, step)
  if step.card then sold_jokers[step.card.uid] = true end
end)
for _, ev in ipairs({ 'onCardObtained', 'onCardPlaced', 'afterHand', 'afterRound', 'onBlindDefeated', 'onRoundStart',
    'onShopEnter', 'onShopExit', 'onConsumableUsed', 'onPackOpened', 'onPackSkipped' }) do
  cardlike.on(ev, function(state) check_destroyed_jokers(state) end)
end

---------------------------------------------------------------------------
-- Unown: the data store keys the Unown joker writes and the Ruins of Alph reads.
--   triggered  the Unown gave its Mult this hand     merged  the Ruins of Alph took it     form  its letter ('A'..)
---------------------------------------------------------------------------

P.UNOWN = { triggered = 'triggered', merged = 'merged', form = 'form' }

---------------------------------------------------------------------------
-- Hand parts (the original patched Balatro's Flush and Straight parts for these Pokemon). One handType filter for all
-- of them, so they agree when several are owned. A def turns a rule on with hand_rules:
--   four_fingers = true   Flushes and Straights with 4 cards (Pansear, Simisear; like Fourk)
--   three_cards = true    Flushes and Straights with 3 cards (Aipom); 'exact': only when exactly 3 cards are played
--                         (Ambipom)
--   shortcut = true       Straights may skip one rank (Pansage, Simisage; like Bridge)
--   pairs_fill = true     cards of the same rank fill the gaps of a Straight (Surskit, Masquerain)
--   flower_wild = true    Flower cards count as every suit for Flushes (Shaymin Sky)
-- Owning Fourk or Bridge adds their rule while one of these Pokemon is owned.
---------------------------------------------------------------------------

local STRENGTH = {}
for i, t in ipairs({ 'HIGH_CARD', 'PAIR', 'TWO_PAIR', 'THREE_OF_A_KIND', 'STRAIGHT', 'FLUSH', 'FULL_HOUSE',
    'FOUR_OF_A_KIND', 'STRAIGHT_FLUSH', 'ROYAL_FLUSH', 'FLUSH_HOUSE', 'FIVE_OF_A_KIND', 'FLUSH_FIVE' }) do STRENGTH[t] = i end

local FLOWER = P.MOD_ID .. ':flower'

--- The hand rules of your jokers now: { four, three, gap, pairs_fill, flower_wild } or nil when none is on.
function P.hand_rules(state, played_count)
  local rules = { }
  local any = false
  for _, j in ipairs(state and state.jokers or {}) do
    local def = P.def(j)
    local r = def and def.hand_rules
    if r then
      if r.four_fingers then rules.four = true any = true end
      if r.three_cards == true or (r.three_cards == 'exact' and played_count == 3) then rules.three = true any = true end
      if r.shortcut then rules.gap = true any = true end
      if r.pairs_fill then rules.pairs_fill = true any = true end
      if r.flower_wild then rules.flower_wild = true any = true end
    end
  end
  if not any then return nil end
  if state:hasJoker('joker_fourk') then rules.four = true end
  if state:hasJoker('joker_bridge') then rules.gap = true end
  return rules
end

-- The cards of the largest one-suit group, when it has at least min cards (Flower cards fill every suit).
local function find_flush(cards, min, flower_wild)
  local suits = {}
  for _, c in ipairs(cards) do
    for s, yes in pairs(P.info(c).suits or {}) do if yes then suits[s] = true end end
  end
  local best
  for s in pairs(suits) do
    local group = {}
    for _, c in ipairs(cards) do
      local i = P.info(c)
      local wild = flower_wild and i.enhancement == FLOWER and not i.noRank
      if wild or (i.suits or {})[s] then group[#group + 1] = c end
    end
    if #group >= min and (not best or #group > #best) then best = group end
  end
  if not best and flower_wild then
    local group = {}
    for _, c in ipairs(cards) do
      local i = P.info(c)
      if i.enhancement == FLOWER and not i.noRank then group[#group + 1] = c end
    end
    if #group >= min then best = group end
  end
  return best
end

-- The cards of the longest run of ranks (Ace high or low), when it has at least min ranks. gap: a run may skip one
-- rank between two cards.
local function find_straight(cards, min, gap)
  local present = {}
  for _, c in ipairs(cards) do
    local r = P.rank_of(c)
    if r then
      present[r] = true
      if r == 14 then present[1] = true end
    end
  end
  local values = {}
  for r = 1, 14 do if present[r] then values[#values + 1] = r end end
  local best_from, best_len, start, len = nil, 0, 1, 0
  for i = 1, #values do
    if i == 1 or values[i] - values[i - 1] > (gap and 2 or 1) then
      start, len = i, 1
    else
      len = len + 1
    end
    if len > best_len then best_from, best_len = start, len end
  end
  if best_len < min then return nil end
  local run = {}
  for i = best_from, best_from + best_len - 1 do
    run[values[i]] = true
    if values[i] == 1 then run[14] = true end
  end
  local out = {}
  for _, c in ipairs(cards) do
    local r = P.rank_of(c)
    if r and run[r] then out[#out + 1] = c end
  end
  return out
end

cardlike.filter('handType', function(value, played)
  local state = cardlike.state
  if type(value) ~= 'table' or type(played) ~= 'table' or not state or state.money == nil then return nil end
  local rules = P.hand_rules(state, #played)
  if not rules then return nil end
  local current = STRENGTH[value.handType]
  if not current then return nil end
  local size = rules.three and 3 or (rules.four and 4 or 5)
  local straight_min = size
  if rules.pairs_fill then
    -- each group of 2, 3, 4 or 5 cards of one rank shortens the run the Straight needs by 1, 2, 3 or 4
    local counts = {}
    for _, c in ipairs(played) do
      local r = P.rank_of(c)
      if r then counts[r] = (counts[r] or 0) + 1 end
    end
    for _, n in pairs(counts) do if n >= 2 and n <= 5 then straight_min = straight_min - (n - 1) end end
    straight_min = math.max(2, straight_min)
  elseif #played < size then
    return nil
  end
  local flush = #played >= size and find_flush(played, size, rules.flower_wild) or nil
  local straight = find_straight(played, straight_min, rules.gap)
  local new_type, scoring
  if flush and straight then
    new_type = 'STRAIGHT_FLUSH'
    local set = {}
    for _, c in ipairs(flush) do set[c.uid] = true end
    for _, c in ipairs(straight) do set[c.uid] = true end
    scoring = {}
    for _, c in ipairs(played) do if set[c.uid] then scoring[#scoring + 1] = c end end
  elseif flush then
    new_type, scoring = 'FLUSH', flush
  elseif straight then
    new_type, scoring = 'STRAIGHT', straight
  end
  if not new_type or STRENGTH[new_type] <= current then return nil end
  -- cards with no rank (Rock cards) always score
  local set = {}
  for _, c in ipairs(scoring) do set[c.uid] = true end
  for _, c in ipairs(played) do if P.info(c).noRank then set[c.uid] = true end end
  local uids = {}
  for _, c in ipairs(played) do if set[c.uid] then uids[#uids + 1] = c.uid end end
  return { handType = new_type, scoring = uids }
end)


== file lib/run.lua (398 lines)
-- Run values and settings.
--
-- P.run is one Lua table for the values that belong to the whole run (Balatro's G.GAME.poke_* values). The library
-- saves it with cardlike.onSave and loads it with cardlike.onLoad, so joker files must NOT call cardlike.onSave or
-- cardlike.onLoad themselves: they keep their run values in P.run.vars (see PORT_NOTES.md).
--
-- P.settings is the table from cardlike.settings() with the Pokermon defaults filled in.
local P = cardlike.require('lib.base')

---------------------------------------------------------------------------
-- Settings (kept between runs)
---------------------------------------------------------------------------

P.SETTING_DEFAULTS = {
  pokemon_only = true,       -- only Pokermon jokers in the joker pools
  unlimited_energy = false,  -- no energy limit
  precise_energy = true,     -- energy adds exact fractions (off: rounded values with a chance for the rest)
  gen_one = true, gen_two = true, gen_three = true, gen_four = true, gen_five = true, gen_six = true, gen_seven = true,
  gen_eight = true, gen_nine = true,
  hazards_on = true,         -- jokers that place hazard cards can appear
  detailed_tooltips = true,  -- extra lines (type, energy, evolution item) in joker descriptions
  energy_count = false,      -- draw the energy count under each joker
  sell_value = false,        -- draw the sell value under each joker
  shiny_playing_cards = false, -- the Shiny edition can go on playing cards
  spritesheet = 'SeriesA',   -- 'Basic' or 'SeriesA' (joker art, applies after a reload)
  scry_view = true,          -- show the Foresight cards next to the deck
  pokemon_aprilfools = false, -- joke content (applies after a reload)
  pokemon_legacy = false,    -- legacy content (applies after a reload)
}

local stored = cardlike.settings()
P.settings = setmetatable({}, {
  __index = function(_, k)
    local v = stored[k]
    if v == nil then return P.SETTING_DEFAULTS[k] end
    return v
  end,
  __newindex = function(_, k, v) stored[k] = v end,
})

---------------------------------------------------------------------------
-- Run values (saved with the run)
---------------------------------------------------------------------------

local function new_run()
  return {
    energy_plus = 0,          -- extra energy limit (Energy Search / Energy Research tickets, decks)
    scry_amount = 0,          -- Foresight: cards shown from the top of the deck
    hazard_level = 0,         -- hazard cards added to the hand at the start of each round
    hazard_max = 3,
    growth_level = 0,         -- extra levels that Seed cards gain when they score
    negative_edition_rate = 1,
    save_all = false,         -- Super Rod: consumables can be saved from every pack
    last_item = nil,          -- id of the last Item used (Twisted Spoon)
    poli_suit = nil,          -- Poliwag line suit (changes after each hand)
    lucky_triggers = 0,       -- Lucky card triggers this round (Leafeon)
    ante_discards_used = 0,   -- discards this ante (Garbodor)
    celebi_skips = 0,
    slots_added = 0,
    current_round = {},       -- targets that change each round (see P.reset_round_targets)
    modifiers = {},           -- challenge and deck rules (Balatro G.GAME.modifiers.poke_*)
    seen = {},                -- Pokemon names that appeared this run (one of each family, Showman rules)
    -- run counters (read them with the functions below)
    starting_deck_size = nil, -- cards in the deck when the run started (Balatro G.GAME.starting_deck_size)
    blinds_skipped = 0,       -- Balatro G.GAME.skips
    consumables_used = {},    -- uses per consumable type ('game', 'fruit', 'pokermon:item', ...)
    fruits_used = {},         -- Fruit card ids used this run (unique Planet cards)
    last_hand = nil,          -- { type = 'PAIR', name = 'Pair' }: the last hand played (Balatro last_hand_played)
    round_hands = 0,          -- hands played this round, counted after each hand
    round_hand_types = {},    -- the same per hand type (Balatro hands[x].played_this_round)
    hand_uids = nil,          -- the cards in hand after the last draw (for P.drawn_cards)
    vars = {},                -- free space for joker files: P.run.vars[<your key>]
  }
end

P.run = new_run()

cardlike.onSave(function()
  return P.run
end)

cardlike.onLoad(function(data)
  P.run = new_run()
  if type(data) == 'table' then
    for k, v in pairs(data) do P.run[k] = v end
  end
end)

--- A run value with a default: P.run_value('celebi_skips', 0).
function P.run_value(key, default)
  local v = P.run[key]
  if v == nil then return default end
  return v
end

--- The value of a run modifier (challenge or deck rule), for example P.modifier('no_energy').
function P.modifier(name)
  local m = P.run.modifiers or {}
  return m[name]
end

function P.set_modifier(name, value)
  P.run.modifiers = P.run.modifiers or {}
  P.run.modifiers[name] = value
end

---------------------------------------------------------------------------
-- Targets that change every round (Balatro reset_game_globals)
---------------------------------------------------------------------------

local function random_element(state, list)
  if #list == 0 then return nil end
  return list[state:random(1, #list)]
end

--- A random rank from the deck for this round: P.run.current_round[name] = { rank = 'King', id = 13 }.
function P.reset_rank(state, name)
  local cr = P.run.current_round
  cr[name] = { rank = 'Ace', id = 14 }
  local valid = {}
  for _, c in ipairs(state.allCards or {}) do
    local info = c.lastInfo or {}
    if not info.noRank and info.rank then valid[#valid + 1] = info.rank end
  end
  local r = random_element(state, valid)
  if r then cr[name] = { rank = P.RANK_NAMES[r] or tostring(r), id = r } end
end

--- A random Pokemon type among your jokers (types in exclude_names are skipped).
function P.reset_type(state, name, exclude_names)
  local cr = P.run.current_round
  cr[name] = 'Grass'
  local valid = {}
  local excluded = P.convert_to_set(exclude_names) or {}
  for _, j in ipairs(state.jokers or {}) do
    local pname = P.name(j)
    local t = P.get_type(j)
    if t and not excluded[pname or ''] then valid[#valid + 1] = t end
  end
  local t = random_element(state, valid)
  if t then cr[name] = t end
end

local function reset_suit(state, name)
  local cr = P.run.current_round
  local options = {}
  for _, s in ipairs(P.SUITS) do if s ~= cr[name] then options[#options + 1] = s end end
  cr[name] = random_element(state, options) or 'Spades'
end

function P.reset_espeon_suit(state) reset_suit(state, 'espeon_suit') end
function P.reset_gligar_suit(state) reset_suit(state, 'gligar_suit') end

function P.reset_bronzo_card(state)
  local cr = P.run.current_round
  cr.bronzo_rank, cr.bronzo_id, cr.bronzo_suit = 'Ace', 14, 'Spades'
  local valid = {}
  for _, c in ipairs(state.allCards or {}) do
    local info = c.lastInfo or {}
    if not info.noRank and info.rank and info.suit then valid[#valid + 1] = info end
  end
  local pick = random_element(state, valid)
  if pick then
    cr.bronzo_rank, cr.bronzo_id, cr.bronzo_suit = P.RANK_NAMES[pick.rank] or tostring(pick.rank), pick.rank, pick.suit
  end
end

-- Other files can add their own per-round resets: P.add_round_reset(function(state) ... end).
P.round_resets = {}
function P.add_round_reset(fn) P.round_resets[#P.round_resets + 1] = fn end

--- Pick this round's targets (bulb1card, sneaselcard, bramblincard, wingullcard, bronzo, espeon, gligar, cattype).
function P.reset_round_targets(state)
  P.run.current_round = P.run.current_round or {}
  for _, name in ipairs({ 'bulb1card', 'sneaselcard', 'bramblincard', 'wingullcard' }) do P.reset_rank(state, name) end
  P.reset_bronzo_card(state)
  P.reset_espeon_suit(state)
  P.reset_gligar_suit(state)
  P.reset_type(state, 'cattype', { 'skitty', 'delcatty' })
  for _, fn in ipairs(P.round_resets) do fn(state) end
end

--- A round target, with a default: P.round_target('bulb1card') -> { rank = 'Ace', id = 14 }.
function P.round_target(name, default)
  local v = (P.run.current_round or {})[name]
  if v == nil then return default end
  return v
end

--- Rank name of a round target card, for texts: P.round_rank('bulb1card') -> 'Ace'.
function P.round_rank(name)
  local v = P.round_target(name)
  return type(v) == 'table' and v.rank or 'Ace'
end

--- Rank id of a round target card: P.round_rank_id('bulb1card') -> 14.
function P.round_rank_id(name)
  local v = P.round_target(name)
  return type(v) == 'table' and v.id or 14
end

cardlike.on('onRunStart', function(state)
  P.reset_round_targets(state)
  if P.modifier('no_energy') then P.run.no_energy = true end
end)

cardlike.on('onBlindDefeated', function(state)
  -- after the evolution checks (lib/evolution.lua listens first)
  P.run.lucky_triggers = 0
end)

cardlike.on('onCashOut', function(state)
  P.reset_round_targets(state)
end)

-- Poliwag line: the suit changes after every hand.
function P.change_poli_suit()
  local suits = P.SUITS
  local cur = P.run.poli_suit
  if not cur then P.run.poli_suit = 'Hearts' return end
  for i, s in ipairs(suits) do
    if s == cur then P.run.poli_suit = suits[i % #suits + 1] return end
  end
  P.run.poli_suit = 'Hearts'
end

cardlike.on('afterHand', function(state, step)
  P.change_poli_suit()
end)

cardlike.on('onDiscard', function(state, step)
  P.run.ante_discards_used = (P.run.ante_discards_used or 0) + 1
end)

cardlike.on('onAnteChanged', function(state, step)
  P.run.ante_discards_used = 0
end)

---------------------------------------------------------------------------
-- Run counters (Balatro G.GAME values that Cardlike's state does not have). The library counts them for every file.
---------------------------------------------------------------------------

--- Cards in the deck when the run started (Balatro G.GAME.starting_deck_size). 52 outside a run.
function P.starting_deck_size()
  local n = P.run.starting_deck_size
  if type(n) ~= 'number' or n <= 0 then return 52 end
  return n
end

--- Cards in the whole deck now.
function P.deck_size(state)
  if not state or state.money == nil then return P.starting_deck_size() end
  return state.deckSize or #(state.allCards or {})
end

--- Blinds skipped this run (Balatro G.GAME.skips).
function P.blinds_skipped() return P.run.blinds_skipped or 0 end

--- Consumables of a type used this run: 'game', 'fruit', 'admin', 'pokermon:item', 'pokermon:energy', or nil for all.
function P.consumables_used(ctype)
  local used = P.run.consumables_used or {}
  if ctype then return used[ctype] or 0 end
  local n = 0
  for _, v in pairs(used) do n = n + v end
  return n
end

--- Different Fruit cards (Planet cards) used this run.
function P.unique_fruits_used()
  local n = 0
  for _ in pairs(P.run.fruits_used or {}) do n = n + 1 end
  return n
end

--- The last hand played in the run: { type = 'PAIR', name = 'Pair' } or nil.
function P.last_hand() return P.run.last_hand end

--- Hands played this round before the hand that is scoring now (0 during the first hand of the round).
function P.hands_played_this_round() return P.run.round_hands or 0 end

--- Times a hand type was played this round before the hand that is scoring now.
function P.times_played_this_round(hand_type)
  return (P.run.round_hand_types or {})[hand_type] or 0
end

--- A roll of the joker's own chance: config num in dem (after the chance multiplier and the chance filter).
function P.roll(card, state, num_key, dem_key)
  state = state or cardlike.state
  return state:chance(P.get(card, num_key or 'num', 1) / P.get(card, dem_key or 'dem', 1))
end

--- The consumable type of a consumable card ('game', 'fruit', 'pokermon:item', ...).
function P.consumable_type(card)
  if not card then return nil end
  return (card.lastInfo and card.lastInfo.type) or card:getConsumableType()
end

cardlike.on('onRunStart', function(state)
  P.run.starting_deck_size = state.deckSize or #(state.allCards or {})
end)

local function new_round_counts()
  P.run.round_hands = 0
  P.run.round_hand_types = {}
end
cardlike.on('onRoundStart', function(state)
  if type(P.run.starting_deck_size) ~= 'number' then P.run.starting_deck_size = state.deckSize end
  new_round_counts()
end)
-- (beforeRound comes right after onRoundStart; counting again there costs nothing)
cardlike.on('beforeRound', function(state) new_round_counts() end)

cardlike.on('onBlindSkipped', function(state)
  P.run.blinds_skipped = (P.run.blinds_skipped or 0) + 1
end)

cardlike.on('onConsumableUsed', function(state, step)
  local c = step.card
  if not c then return end
  local ctype = P.consumable_type(c)
  if not ctype then return end
  P.run.consumables_used = P.run.consumables_used or {}
  P.run.consumables_used[ctype] = (P.run.consumables_used[ctype] or 0) + 1
  if ctype == 'fruit' then
    local id = (c.lastInfo or {}).consumable or c:getConsumableDef()
    if id then
      P.run.fruits_used = P.run.fruits_used or {}
      P.run.fruits_used[id] = true
    end
  end
end)

cardlike.on('afterHand', function(state, step)
  local hand = step and step.hand
  if not hand then return end
  P.run.last_hand = { type = hand.handType, name = hand.handName or hand.handType }
  P.run.round_hands = (P.run.round_hands or 0) + 1
  P.run.round_hand_types = P.run.round_hand_types or {}
  if hand.handType then
    P.run.round_hand_types[hand.handType] = (P.run.round_hand_types[hand.handType] or 0) + 1
  end
end)

---------------------------------------------------------------------------
-- Drawn cards (Balatro SMODS.drawn_cards). onHandDrawn does not list the drawn cards, so the library keeps the cards
-- in hand after every draw (in the run values, so it survives a reload) and the drawn cards are the new ones.
---------------------------------------------------------------------------

-- The answer of the draw that is happening now, for the other jokers that ask in the same draw. The game runs the
-- jokers' onHandDrawn triggers first and the listeners after them, so the library's listener closes the draw.
local drawn_sig, drawn_list, drawn_open = nil, {}, false

--- The cards drawn by the draw that is happening now (call it from onHandDrawn). step.first: all cards in hand.
function P.drawn_cards(state, step)
  state = state or cardlike.state
  local hand = state.cardsInHand or {}
  local ids = {}
  for i, c in ipairs(hand) do ids[i] = c.uid end
  local first = step and step.first
  local sig = table.concat(ids, ',') .. (first and ':first' or '')
  if drawn_open and sig == drawn_sig then return drawn_list end
  local before = {}
  if not first then
    for _, uid in ipairs(P.run.hand_uids or {}) do before[uid] = true end
  end
  local out = {}
  for _, c in ipairs(hand) do
    if not before[c.uid] then out[#out + 1] = c end
  end
  P.run.hand_uids = ids
  drawn_sig, drawn_list, drawn_open = sig, out, true
  return out
end

-- Every draw updates the kept hand, also when no joker asks; then the draw is over.
cardlike.on('onHandDrawn', function(state, step)
  P.drawn_cards(state, step)
  drawn_open = false
end)
cardlike.on('onRoundStart', function(state)
  P.run.hand_uids = {}
  drawn_sig, drawn_list, drawn_open = nil, {}, false
end)

---------------------------------------------------------------------------
-- Enhancement triggers: which enhancements gave their bonus for the card that is scoring now (enhancementScore does
-- not say which card, and it fires before the jokers' onScore of that card). Chansey, Blissey: Paperback (Lucky).
---------------------------------------------------------------------------

local fired = {}
cardlike.on('beforeScore', function() fired = {} end)
cardlike.on('enhancementScore', function(state, step)
  if step.enhancement then fired[step.enhancement] = true end
end)

--- Whether the enhancement (a Cardlike id, for example 'Paperback') gave its bonus for the card scoring now.
function P.enhancement_triggered(id) return fired[id] == true end


== file lib/scry.lua (70 lines)
-- Foresight (scry): you see the next cards of your deck. P.run.scry_amount says how many. Jokers that give
-- Foresight add to it in onAdded and take it back in onRemoved (P.scry.add). The cards show in a small panel next to
-- the deck while you play (setting scry_view). Jokers that score the Foresight cards read P.scry.cards(state).
local P = cardlike.require('lib.base')
local S = P.scry

--- Foresight cards now.
function S.amount()
  local n = (P.run.scry_amount or 0) + (P.modifier('foresight_plus') or 0)
  return math.max(0, n)
end

--- Add (or with a negative n, remove) Foresight.
function S.add(n)
  P.run.scry_amount = math.max(0, (P.run.scry_amount or 0) + (n or 0))
end

--- The Foresight cards: the next cards that will be drawn, first one first (card handles).
function S.cards(state)
  state = state or cardlike.state
  local n = S.amount()
  if n <= 0 then return {} end
  local deck = state.unDrawnCards or {}
  local out = {}
  -- the game draws from the end of the undrawn list
  for i = #deck, math.max(1, #deck - n + 1), -1 do out[#out + 1] = deck[i] end
  return out
end

local SUIT_SHORT = { Spades = 'S', Hearts = 'H', Clubs = 'C', Diamonds = 'D' }
local SUIT_COLOUR = { Spades = '#c8c8e0', Hearts = colors.HEARTS_COLOR, Clubs = '#4fb477', Diamonds = '#e8a33a' }

local function label(card)
  local info = card.lastInfo or {}
  if info.noRank then return 'Stone', colors.GREY end
  local r = P.RANK_NAMES[info.rank or 0] or '?'
  if r == 'Jack' then r = 'J' elseif r == 'Queen' then r = 'Q' elseif r == 'King' then r = 'K' elseif r == 'Ace' then r = 'A' end
  local s = info.suit or ''
  return r .. (SUIT_SHORT[s] or (':' .. s:gsub('^.*:', ''))), SUIT_COLOUR[s] or colors.WHITE
end

-- The Foresight panel, above the deck (bottom right), while a hand can be played.
local ui = cardlike.ui
local scry_panel
local function scry_content()
  local state = cardlike.state
  if not P.settings.scry_view or state.money == nil or not state:isPhase('play') then return nil end
  local cards = S.cards(state)
  if #cards == 0 then return nil end
  local row = ui.row { gap = 6, align = 'center' }
  for i, c in ipairs(cards) do
    local text, colour = label(c)
    row[i] = ui.text { text = text, size = 18, color = colour }
  end
  return ui.column { background = '#262625dd', padding = 8, gap = 4, align = 'center',
    ui.text { text = 'Foresight', size = 14, color = P.colours.psychic },
    row,
  }
end

cardlike.onFrame(function(frame)
  if not frame.inRun then
    if scry_panel and scry_panel.isOpen() then scry_panel.close() end
    return
  end
  if not scry_panel or not scry_panel.isOpen() then
    scry_panel = ui.open { at = 'bottomRight', offset = { x = -40, y = -250 }, closeOnEscape = false, content = scry_content }
  end
end)


== file lib/sprites.lua (132 lines)
-- Sprite sheets and Pokemon art.
--
-- Joker art: every non-empty 142 x 190 frame of the original joker sheets (Basic Series and Series A, 2x) is packed
-- into images/pokemon/pokemon_<n>.png (sheet ids 'pokemon_<n>'). lib/data/sprite_index.lua says where each original
-- frame went. P.sprites.frame('AtlasJokersBasicGen01', 4, 0) gives the Cardlike sprite of an original frame.
--
-- A Pokemon's art is chosen like Pokermon does (P.sprites.pokemon(name)):
--   1. Look up the name in the sprite table (lib/data/sprite_table.lua): base.pos, base.soul_pos, gen_atlas,
--      others_atlas and alts.
--   2. The series is the 'spritesheet' setting ('SeriesA' by default, else 'Basic'). Series A is used only when
--      the entry has alts.AtlasJokersSeriesA; an animated Series A entry (anim_atlas) uses its first frame.
--   3. The sheet name is <prefix><Gen0N | Others | Natdex>: prefix AtlasJokersBasic or AtlasJokersSeriesA, Gen0N
--      from gen_atlas, Others when others_atlas is set, else Natdex.
--   4. sprite = that sheet's frame at pos; layerSprite = its frame at soul_pos (alt soul_pos first). A frame that is
--      empty in Series A falls back to the Basic Series frame.
-- A pos that is a list (several looks, for example Shellos) uses the first entry.
local P = cardlike.require('lib.base')
local S = P.sprites

local INDEX = cardlike.require('lib.data.sprite_index')
local TABLE = cardlike.require('lib.data.sprite_table')

S.table = {}
for _, entry in ipairs(TABLE) do S.table[entry.name] = entry end

for i = 1, INDEX.sheetCount do
  cardlike.addSpriteSheet { id = 'pokemon_' .. i, file = 'images/pokemon/pokemon_' .. i .. '.png', frameWidth = 142, frameHeight = 190 }
end

-- Other sheets (2x art). Frame sizes in pixels.
S.SHEETS = {
  consumables = { 'images/consumables.png', 142, 190 },   -- Items, Energy, Spectral cards (10 x 11 frames)
  bird_energy = { 'images/bird_energy.png', 142, 190 },
  boosters = { 'images/boosters.png', 142, 190 },         -- packs (5 x 2)
  decks = { 'images/decks.png', 142, 190 },               -- deck backs (11 x 2)
  enhancements = { 'images/enhancements.png', 142, 190 }, -- hazard, seed stages, flower (7 x 2)
  stickers = { 'images/stickers.png', 142, 190 },         -- type stickers and stamps (10 x 2)
  vouchers = { 'images/vouchers.png', 142, 190 },         -- tickets (4 x 3)
  tags = { 'images/tags.png', 68, 68 },                   -- pins (5 x 1)
  blinds = { 'images/blinds.png', 68, 68 },               -- boss blinds, one per row (1 x 26)
  pokestakes = { 'images/pokestakes.png', 58, 58 },
  elite_stake = { 'images/elite_stake.png', 58, 58 },
  elite_stake_sticker = { 'images/elite_stake_sticker.png', 142, 190 },
  pokestakes_stickers = { 'images/pokestakes_stickers.png', 142, 190 },
  capture_disc = { 'images/capture_disc.png', 142, 190 },
  miror_budicolo = { 'images/miror_budicolo.png', 142, 190 },
  placeholder_joker = { 'images/placeholder_joker.png', 142, 190 },
  placeholder_item = { 'images/placeholder_item.png', 142, 190 },
  unown_swarm = { 'images/unown_swarm.png', 580, 570 },   -- frame 0: the swarm, frame 1: its floating layer
}
for id, s in pairs(S.SHEETS) do
  cardlike.addSpriteSheet { id = id, file = s[1], frameWidth = s[2], frameHeight = s[3] }
end

--- A sprite table for a frame of one of the sheets above: P.sprites.at('consumables', 0, 3).
function S.at(sheet, x, y)
  return { sheet = sheet, x = x or 0, y = y or 0 }
end

--- The packed sprite of a frame of an original Pokermon joker sheet, or nil when that frame is empty.
function S.frame(atlas, x, y)
  local frames = INDEX.frames[atlas]
  local f = frames and frames[(x or 0) .. ',' .. (y or 0)]
  if not f then return nil end
  return { sheet = 'pokemon_' .. f[1], x = f[2], y = f[3] }
end

local function gen_suffix(entry)
  if entry.gen_atlas then return string.format('Gen%02d', entry.gen_atlas) end
  if entry.others_atlas then return 'Others' end
  return 'Natdex'
end

local function first_pos(pos)
  if type(pos) ~= 'table' then return nil end
  if pos.x then return pos end
  return pos[1]
end

--- The series used for joker art: 'SeriesA' or 'Basic'.
function S.series()
  local s = P.settings.spritesheet
  if s == 'Basic' or s == 'Classic' then return 'Basic' end
  return 'SeriesA'
end

--- Art of a Pokemon by name: { sprite = ..., layerSprite = ..., credits = ... } or nil.
function S.pokemon(name, series)
  local entry = S.table[name]
  if not entry then return nil end
  series = series or S.series()
  local base = entry.base or {}
  local pos = first_pos(base.pos)
  if not pos then return nil end
  local soul = base.soul_pos
  local basic_atlas = 'AtlasJokersBasic' .. gen_suffix(entry)
  local atlas = basic_atlas
  local alt = entry.alts and entry.alts.AtlasJokersSeriesA
  local artist = base.artist
  if series == 'SeriesA' and alt then
    if alt.anim_atlas then
      atlas = alt.anim_atlas
      pos = { x = 0, y = 0 }
      soul = nil
    else
      atlas = 'AtlasJokersSeriesA' .. gen_suffix(entry)
      soul = alt.soul_pos or soul
    end
    artist = alt.artist or artist
  end
  local sprite = S.frame(atlas, pos.x, pos.y) or S.frame(basic_atlas, first_pos(base.pos).x, first_pos(base.pos).y)
  local layer = nil
  if soul then
    layer = S.frame(atlas, soul.x, soul.y) or (base.soul_pos and S.frame(basic_atlas, base.soul_pos.x, base.soul_pos.y))
  end
  local credits
  if artist then
    local names = {}
    local list = (type(artist) == 'table' and not artist.name) and artist or { artist }
    local function add(a)
      if type(a) == 'table' then
        if a.name ~= nil then add(a.name) else for _, x in ipairs(a) do add(x) end end
      else
        names[#names + 1] = tostring(a)
      end
    end
    for _, a in ipairs(list) do add(a) end
    credits = 'Art: ' .. table.concat(names, ', ')
  end
  return { sprite = sprite, layerSprite = layer, credits = credits, atlas = atlas, pos = pos, soul_pos = soul }
end


== file lib/text.lua (416 lines)
-- Text helpers. Pokermon keeps its English text as lists of lines with {C:colour} codes and #1# variables
-- (lib/data/loc*.lua). P.text.format turns such a list into one Cardlike description: [color] and [b] markup,
-- the variables filled in, lines joined into sentences, notes in brackets on their own line, and the Cardlike
-- names of vanilla content (Tarot card -> Game card, Chips -> Points, Foil -> Luna, ...).
local P = cardlike.require('lib.base')
local T = P.text

-- The English texts. Loaded now: cardlike.require only works while the mod loads.
local LOC = cardlike.require('lib.data.loc')
local LOC_JOKERS = cardlike.require('lib.data.loc_jokers')
T.loc, T.loc_jokers = LOC, LOC_JOKERS

-- Colour names used in the text codes.
local COLOURS = {
  mult = colors.MULT, red = colors.MULT, chips = colors.CHIPS, blue = colors.CHIPS, money = colors.MONEY,
  attention = colors.ORANGE, attenion = colors.ORANGE, filter = colors.ORANGE, active = colors.GREEN, green = colors.GREEN,
  inactive = colors.GREY, gray = colors.GREY, grey = colors.GREY, white = colors.WHITE, black = colors.GREY,
  tarot = colors.PURPLE, planet = '#13afce', spectral = '#4584fa', purple = colors.PURPLE, legendary = '#b26cbb',
  dark_edition = '#5d5dff', edition = '#5d5dff', hearts = colors.HEARTS_COLOR, spades = '#a0a0c0', clubs = colors.CLUBS_COLOR,
  diamonds = '#e8a33a', important = colors.ORANGE,
}

function T.colour(name)
  if type(name) ~= 'string' then return nil end
  name = name:lower()
  if COLOURS[name] then return COLOURS[name] end
  if name:sub(1, 5) == 'poke_' and P.colours[name:sub(6)] then return P.colours[name:sub(6)] end
  if P.colours[name] then return P.colours[name] end
  return nil
end

-- Vanilla words in Pokermon text and their Cardlike names. Each rule is a Lua pattern over the plain text with two
-- position captures around the part to replace. Longer rules come first. T.format matches the rules over all lines of
-- a text at once (lines joined with a new line), so a term split over two lines ("Glass" / "card") is found too:
-- write the space between words as %s+.
local STONES = { Fire = 1, Water = 1, Thunder = 1, Leaf = 1, Moon = 1, Sun = 1, Shiny = 1, Dusk = 1, Dawn = 1, Ice = 1,
  Hard = 1, Ever = 1, Mega = 1, Key = 1, Mega_ = 1, Evolution = 1 }
local function prev_word(s, i)
  local before = s:sub(1, i - 1)
  return before:match('(%a+)[^%a]*$')
end
local function next_word(s, i)
  return s:match('^[^%a]*(%a+)', i)
end
local function not_after_stone_item(s, i) return STONES[prev_word(s, i) or ''] == nil end
local function not_after_shadow(s, i) return prev_word(s, i) ~= 'Shadow' end
-- "Gold" alone is a Gold card, but not a Gold Stake or a Gold Pin.
local NOT_GOLD_CARD = { Stake = 1, Stakes = 1, Pin = 1, Pins = 1, Stamp = 1, Stamps = 1, Seal = 1, Seals = 1 }
local function gold_card(s, i) return NOT_GOLD_CARD[next_word(s, i + 4) or ''] == nil end
-- Death is the Tarot card (Cardlike Mage) only when it names a card: "a Death", "of Death", "Death card".
local DEATH_BEFORE = { a = 1, an = 1, of = 1, the = 1 }
local function death_card(s, i)
  local nxt = (next_word(s, i + 5) or ''):lower()
  return DEATH_BEFORE[(prev_word(s, i) or ''):lower()] ~= nil or nxt == 'card' or nxt == 'cards'
end
-- "Splash" is the Splash joker (Cardlike Rainbow), not the Pokermon splash screen card.
local function splash_joker(s, i) return prev_word(s, i) ~= 'Pokemon' and next_word(s, i + 6) ~= 'Card' end

local RULES = {
  { '%f[%a]()Booster%s+Packs()%f[%A]', 'Packs' }, { '%f[%a]()Booster%s+Pack()%f[%A]', 'Pack' },
  { '%f[%a]()Boosters()%f[%A]', 'Packs' }, { '%f[%a]()Booster()%f[%A]', 'Pack' },
  { '%f[%a]()Buffoon%s+Packs()', 'Fool Packs' }, { '%f[%a]()Arcana%s+Packs()', 'Game Packs' },
  { '%f[%a]()Celestial%s+Packs()', 'Fruit Packs' }, { '%f[%a]()Spectral%s+Packs()', 'Admin Packs' },
  { '%f[%a]()Standard%s+Packs()', 'Deck Packs' },
  { '%f[%a]()Buffoon%s+Pack()', 'Fool Pack' }, { '%f[%a]()Arcana%s+Pack()', 'Game Pack' },
  { '%f[%a]()Celestial%s+Pack()', 'Fruit Pack' }, { '%f[%a]()Spectral%s+Pack()', 'Admin Pack' },
  { '%f[%a]()Standard%s+Pack()', 'Deck Pack' },
  { '%f[%a]()Tarot()%s+[CcP]', 'Game' }, { '%f[%a]()Tarots()%f[%A]', 'Game Cards' }, { '%f[%a]()Tarot()%f[%A]', 'Game Card' },
  { '%f[%a]()Planet()%s+[CcP]', 'Fruit' }, { '%f[%a]()planet()%s+[Cc]ard', 'Fruit' }, { '%f[%a]()Planets()%f[%A]', 'Fruit Cards' }, { '%f[%a]()Planet()%f[%A]', 'Fruit Card' },
  { '%f[%a]()Spectral()%s+[CcP]', 'Admin' }, { '%f[%a]()Spectrals()%f[%A]', 'Admin Cards' }, { '%f[%a]()Spectral()%f[%A]', 'Admin Card' },
  { '%f[%a]()Vouchers()%f[%A]', 'Tickets' }, { '%f[%a]()Voucher()%f[%A]', 'Ticket' },
  { '%f[%a]()Coupon%s+Tag()%f[%A]', 'Shop Pin' }, { '%f[%a]()Speed%s+Tag()%f[%A]', 'Energy Drink Pin' },
  { '%f[%a]()Double%s+Tag()%f[%A]', 'Donut Pin' }, { '%f[%a]()D6%s+Tag()%f[%A]', 'Discount Pin' },
  { '%f[%a]()Standard%s+Tag()%f[%A]', 'Deck Pin' }, { '%f[%a]()Ethereal%s+Tag()%f[%A]', 'Key Cap Pin' },
  { '%f[%a]()Negative%s+Tag()%f[%A]', 'Pearl Pin' }, { '%f[%a]()Garbage%s+Tag()%f[%A]', 'Trash Pin' },
  { '%f[%a]()Tags()%f[%A]', 'Pins', not_after_shadow }, { '%f[%a]()Tag()%f[%A]', 'Pin', not_after_shadow },
  { '%f[%a]()Red%s+Seal()%f[%A]', 'Replay Stamp' }, { '%f[%a]()Gold%s+Seal()%f[%A]', 'Cash Stamp' },
  { '%f[%a]()Blue%s+Seal()%f[%A]', 'Fruit Stamp' }, { '%f[%a]()Purple%s+Seal()%f[%A]', 'Game Stamp' },
  { '%f[%a]()Seals()%f[%A]', 'Stamps' }, { '%f[%a]()Seal()%f[%A]', 'Stamp' }, { '%f[%a]()seals()%f[%A]', 'stamps' },
  { '%f[%a]()seal()%f[%A]', 'stamp' },
  { '%f[%a]()Bonus()%s+[Cc]ard', 'Chipped' }, { '%f[%a]()Mult%s+[Cc]ard()', 'Multicard' }, { '%f[%a]()Wild()%s+[Cc]ard', 'Plaid' },
  { '%f[%a]()Glass()%s+[Cc]ard', 'Fragile' }, { '%f[%a]()Steel()%s+[Cc]ard', 'Wooden' },
  { '%f[%a]()Stone()%s+[Cc]ard', 'Rock', not_after_stone_item }, { '%f[%a]()Gold()%s+[Cc]ard', 'Gilded' },
  { '%f[%a]()Lucky()%s+[Cc]ard', 'Paperback' },
  -- enhancement names that stand alone ("Stone and Glass cards", "also Steel cards", "become Wild or Seed")
  { '%f[%a]()Wild()%f[%A]', 'Plaid' }, { '%f[%a]()Glass()%f[%A]', 'Fragile' }, { '%f[%a]()Steel()%f[%A]', 'Wooden' },
  { '%f[%a]()Stone()%f[%A]', 'Rock', not_after_stone_item }, { '%f[%a]()Gold()%f[%A]', 'Gilded', gold_card },
  { '%f[%a]()Death()%f[%A]', 'Mage', death_card }, { '%f[%a]()Splash()%f[%A]', 'Rainbow', splash_joker },
  { '%f[%a]()Holographic()%f[%A]', 'Holo' }, { '%f[%a]()Polychrome()%f[%A]', 'Chroma' }, { '%f[%a]()Foil()%f[%A]', 'Luna' },
  { '%f[%a]()a%s+Negative()%f[%A]', 'an Inverted' }, { '%f[%a]()Negative()%f[%A]', 'Inverted' }, { '%f[%a]()Eternal()%f[%A]', 'Locked' }, { '%f[%a]()Perishable()%f[%A]', 'Timed' },
  { '%f[%a]()Rental()%f[%A]', 'Subscription' },
  { '%f[%a]()Small%s+Blind()%f[%A]', 'Beta Blind' }, { '%f[%a]()Big%s+Blind()%f[%A]', 'Alpha Blind' },
  { '%f[%a]()Showdown()%f[%A]', 'Finisher' },
  { '%f[%a]()Chips()%f[%A]', 'Points' }, { '%f[%a]()chips()%f[%A]', 'points' },
  { '%f[%a]()Chip()%f[%A]', 'Point' }, { '%f[%a]()chip()%f[%A]', 'point' },
  { '%f[%a]()Blueprint()%f[%A]', 'Copycat' }, { '%f[%a]()Brainstorm()%f[%A]', 'Copyleft Cat' },
  { '%f[%a]()Four%s+Fingers()%f[%A]', 'Fourk' }, { '%f[%a]()Pareidolia()%f[%A]', 'Joyful Joker' }, { '%f[%a]()Shortcut()%f[%A]', 'Bridge' },
  { '%f[%a]()Telescope()%f[%A]', 'Fruit Bowl' }, { '%f[%a]()Observatory()%f[%A]', 'Blender' }, { '%f[%a]()Black%s+Hole()%f[%A]', 'UPDATE' }, { '%f[%a]()The%s+Soul()%f[%A]', 'POWER' },
  { '%f[%a]()Trance()%f[%A]', 'CAPITAL' }, { '%f[%a]()Aura()%f[%A]', 'SHIFT' }, { '%f[%a]()Medium()%f[%A]', 'OPTION' },
  { '%f[%a]()The%s+World()%f[%A]', 'Malice' }, { '%f[%a]()The%s+Moon()%f[%A]', 'Luck' }, { '%f[%a]()The%s+Star()%f[%A]', 'Greed' },
  { '%f[%a]()The%s+Devil()%f[%A]', 'Star' }, { '%f[%a]()Wheel%s+of%s+Fortune()%f[%A]', 'Chance' }, { '%f[%a]()Justice()%f[%A]', 'Vision' },
  { '%f[%a]()The%s+Hierophant()%f[%A]', 'Blind' }, { '%f[%a]()Hierophant()%f[%A]', 'Blind' }, { '%f[%a]()The%s+Magician()%f[%A]', 'Pearl' },
  { '%f[%a]()The%s+Fool()%f[%A]', 'Prism' }, { '%f[%a]()Cryptid()%f[%A]', 'COMMAND' },
  { '%f[%a]()an%s+Empress()%f[%A]', 'a Grace' }, { '%f[%a]()The%s+Empress()%f[%A]', 'Grace' },
  { '%f[%a]()Empress()%f[%A]', 'Grace' },
}
T.RULES = RULES

--- Replace vanilla terms in plain text (no markup). Also used for names.
function T.terms(s)
  if type(s) ~= 'string' then return s end
  for _, rule in ipairs(RULES) do
    local init = 1
    while true do
      local a, b, p1, p2 = s:find(rule[1], init)
      if not a then break end
      if rule[3] and not rule[3](s, p1) then
        init = b + 1
      else
        s = s:sub(1, p1 - 1) .. rule[2] .. s:sub(p2)
        init = p1 + #rule[2]
      end
    end
  end
  return s
end

-- Split one line into segments: { text = '...', code = '{C:mult}' or nil }. A code applies to the text after it.
local function segments(line)
  local out = {}
  local pos = 1
  local code = nil
  while pos <= #line do
    local a, b = line:find('{[^{}]*}', pos)
    if not a then
      out[#out + 1] = { text = line:sub(pos), code = code }
      break
    end
    if a > pos then out[#out + 1] = { text = line:sub(pos, a - 1), code = code } end
    code = line:sub(a + 1, b - 1)
    if code == '' then code = nil end
    out[#out + 1] = { text = '', code = code, mark = true }
    pos = b + 1
  end
  return out
end

-- Apply the term rules across segments: the plain text is matched as a whole, and each replacement goes into
-- the segment where it starts (so "{C:attention}Stone{} cards" becomes "{C:attention}Rock{} cards").
local function replace_terms(segs)
  for _, rule in ipairs(RULES) do
    local init = 1
    while true do
      local plain, owner = {}, {}
      for i, sg in ipairs(segs) do
        for c = 1, #sg.text do
          plain[#plain + 1] = sg.text:sub(c, c)
          owner[#owner + 1] = { i, c }
        end
      end
      local s = table.concat(plain)
      local a, b, p1, p2 = s:find(rule[1], init)
      if not a then break end
      if rule[3] and not rule[3](s, p1) then
        init = b + 1
      else
        -- remove characters p1 .. p2-1, then insert the replacement where p1 was
        local first = owner[p1]
        local removed = {}
        for k = p1, p2 - 1 do removed[#removed + 1] = owner[k] end
        for k = #removed, 1, -1 do
          local o = removed[k]
          local sg = segs[o[1]]
          sg.text = sg.text:sub(1, o[2] - 1) .. sg.text:sub(o[2] + 1)
        end
        local sg = segs[first[1]]
        sg.text = sg.text:sub(1, first[2] - 1) .. rule[2] .. sg.text:sub(first[2])
        init = p1 + #rule[2]
      end
    end
  end
end

--- Text for a number in a description: whole numbers without a decimal point, others with up to 2 decimals.
function T.num(v)
  if type(v) ~= 'number' then return tostring(v) end
  if v == math.floor(v) and math.abs(v) < 1e15 then return string.format('%d', v) end
  local s = string.format('%.2f', v):gsub('0+$', ''):gsub('%.$', '')
  return s
end

local function fill_vars(s, vars)
  return (s:gsub('#(%d+)#', function(n)
    local v = vars and vars[tonumber(n)]
    if v == nil then return '?' end
    return T.num(v)
  end))
end

local function style(text, code, vars)
  if text == '' or not code then return text end
  local colour, boxed
  for part in code:gmatch('[^,]+') do
    local k, v = part:match('^%s*(%a+):(.-)%s*$')
    if k == 'C' or k == 'c' then colour = colour or T.colour(v)
    elseif k == 'X' then boxed = T.colour(v) or colors.ORANGE
    elseif k == 'V' then
      local c = vars and vars.colours and vars.colours[tonumber(v)]
      if type(c) == 'string' then colour = c end
    end
  end
  if boxed then
    -- A coloured box (X Mult): bold text in the box colour. Balatro pads boxes with spaces; the text around a box
    -- always has its own spaces, so the padding is left out.
    local inner = text:match('^%s*(.-)%s*$')
    if inner == '' then return text end
    return colorize(bold(inner), boxed)
  end
  if colour then return colorize(text, colour) end
  return text
end

local cache, cache_size = {}, 0
local prev_last

-- The segments of every line, after the term rules ran over all lines joined with a new line (so a term split over
-- two lines is renamed too). Returns one segment list per line; a renamed term that spans two lines joins them.
local function line_segments(lines)
  local key = table.concat(lines, '\n')
  local cached = cache[key]
  if cached then return cached end
  local all = {}
  for i, line in ipairs(lines) do
    if i > 1 then all[#all + 1] = { text = '\n', sep = true } end
    for _, sg in ipairs(segments(line)) do all[#all + 1] = sg end
  end
  replace_terms(all)
  local out, cur = {}, {}
  for _, sg in ipairs(all) do
    if not sg.sep then
      cur[#cur + 1] = sg
    elseif sg.text == '\n' then
      out[#out + 1] = cur
      cur = {}
    end
  end
  out[#out + 1] = cur
  if cache_size > 2000 then cache, cache_size = {}, 0 end
  cache[key] = out
  cache_size = cache_size + 1
  return out
end

-- Words after which the next line continues the same sentence.
local CONTINUE = {}
for w in ([[a an the of to for each and or with in by per your all if when from into than at on as is are every any
  gains gain create creates give gives earn earns becomes become has have this that its their held played scored
  random one two three first last]]):gmatch('%a+') do CONTINUE[w] = true end
-- Of those, the words that always lead into the next line (the others can end a sentence).
local LEADS = {}
for w in ([[a an the of to for each and or with in by per your all if when from into than at on as is are every any]]):gmatch('%a+') do
  LEADS[w] = true
end
-- Words that start a new ability when a line begins with them (unless the line before leads into them).
local STARTS = {}
for w in ([[If Gain Gains Earn Earns Create Creates Each When After Retrigger Retriggers Destroy Destroys Applies
  Played Every]]):gmatch('%a+') do STARTS[w] = true end
T.TYPES_SET = { Grass = true, Fire = true, Water = true, Lightning = true, Psychic = true, Fighting = true, Colorless = true,
  Dark = true, Metal = true, Fairy = true, Dragon = true, Earth = true, Bird = true, Mult = true, Points = true, Joker = true,
  Jokers = true, Energy = true, Item = true, Items = true, Pokemon = true, Game = true, Fruit = true, Admin = true, Mega = true,
  Ace = true, Aces = true, King = true, Kings = true, Queen = true, Queens = true, Jack = true, Jacks = true, Hearts = true,
  Spades = true, Clubs = true, Diamonds = true, Rock = true, Plaid = true, Fragile = true, Wooden = true, Gilded = true,
  Paperback = true, Chipped = true, Multicard = true, Luna = true, Holo = true, Chroma = true, Inverted = true, Pack = true,
  Packs = true, Stamp = true, Hazard = true, Seed = true, Flower = true, Tera = true, Basic = true, Stage = true, Safari = true,
  Legendary = true, Common = true, Uncommon = true, Rare = true, Boss = true, Blind = true, Straight = true, Flush = true,
  Pair = true, Pairs = true, Full = true, House = true, High = true, Card = true, Cards = true, Stone = true, Two = true,
  Three = true, Four = true, Five = true, Foresight = true, Ticket = true, Pin = true, Chance = true, Wild = true, Mage = true,
  Rainbow = true, Point = true }

--- Turn Pokermon text lines into one Cardlike description. `lines` is a list of lines (or a list of such lists for
--- text with several boxes). `vars` fills #1#, #2#, ...; vars.colours fills {V:1} colour codes.
function T.format(lines, vars)
  if type(lines) == 'string' then lines = { lines } end
  if type(lines) ~= 'table' then return '' end
  if type(lines[1]) == 'table' then
    local parts = {}
    for i, box in ipairs(lines) do parts[i] = T.format(box, vars) end
    return table.concat(parts, '\n')
  end
  local filled = {}
  for i, raw in ipairs(lines) do
    -- Cardlike has no joker selection: effects on the "leftmost or selected" joker go to the leftmost one.
    filled[i] = fill_vars(raw, vars):gsub(' or selected', ''):gsub('leftmost or$', 'leftmost')
  end
  local out = {}
  local prev_note, prev_foresight = false, false
  prev_last = nil
  for _, segs in ipairs(line_segments(filled)) do
    local parts = {}
    local plain = ''
    local divider = false
    for _, sg in ipairs(segs) do
      if sg.code and sg.code:match('^br:') then
        -- a divider line: the text after {br:N} is filler that Balatro does not draw
        divider = true
      else
        parts[#parts + 1] = style(sg.text, sg.code, vars)
        plain = plain .. sg.text
      end
    end
    local text = table.concat(parts)
    local trimmed = plain:match('^%s*(.-)%s*$')
    local note = trimmed:sub(1, 1) == '('
    -- A line that starts a new sentence (a capital word after a line that does not lead into it) gets its own line.
    -- A "+N Foresight" line is a whole ability, so the next line starts a new one.
    local first = trimmed:match('^(%u%l+)')
    local sentence = prev_foresight
    if first and #out > 0 and not note and not prev_note and not T.TYPES_SET[first] and not CONTINUE[prev_last or ''] then
      sentence = true
    end
    -- "Gain ...", "If ...", or a chance "1 in 4 ..." after a line that ends a phrase starts a new ability.
    if #out > 0 and not note and not prev_note and not LEADS[prev_last or '']
        and ((first and STARTS[first]) or trimmed:match('^[%d%.]+%s+in%s+[%d%.]+')) then
      sentence = true
    end
    prev_last = (trimmed:match('(%a+)%s*$') or ''):lower()
    if trimmed:match(',%s*$') then prev_last = 'and' end
    if divider then
      out[#out + 1] = '\n'
      prev_note = true
    end
    if trimmed ~= '' then
      if #out == 0 then
        out[#out + 1] = text
      elseif note or prev_note or sentence then
        out[#out + 1] = '\n' .. text
      else
        out[#out + 1] = ' ' .. text
      end
      prev_note = note
      prev_foresight = trimmed:match('^%+%S+%s+Foresight$') ~= nil
    end
  end
  local s = table.concat(out):gsub('\n\n+', '\n'):gsub('^\n', ''):gsub('  +', ' '):gsub('\n ', '\n'):gsub('^ ', '')
  return s
end

--- Loc table lookup: P.text.entry('Joker', 'j_poke_bulbasaur') -> { name, text } or nil.
function T.entry(set, key)
  if set == 'Joker' then
    return LOC_JOKERS[key]
  end
  local sec = LOC.descriptions[set]
  return sec and sec[key]
end

--- Description text of a loc entry with variables: P.text.describe('poke_item', 'c_poke_pokeball', { ... }).
function T.describe(set, key, vars)
  local e = T.entry(set, key)
  if not e then return '' end
  return T.format(e.text, vars)
end

--- The English text of a joker ('j_poke_x' key or a Pokemon name), with extra lines at the end (nil lines are left
--- out). For text functions that add a line such as "Copying: Pikachu".
function T.joker(key, vars, ...)
  if not key:find('^j_') then key = 'j_poke_' .. key end
  local e = T.entry('Joker', key)
  local text = e and T.format(e.text, vars) or ''
  for i = 1, select('#', ...) do
    local line = select(i, ...)
    if line and line ~= '' then text = (text ~= '' and text .. '\n' or '') .. line end
  end
  return text
end

--- A text function for jokers with abilities in tiers ("1+ :", "2+ :"): each tier on its own line (T.format would
--- join them into sentences). Use it as the def's text: text = poke.text.tiers('omanyte').
function T.tiers(key)
  if not key:find('^j_') then key = 'j_poke_' .. key end
  return function(get, card, state, vars)
    local entry = T.entry('Joker', key)
    local groups = {}
    for _, line in ipairs(entry and entry.text or {}) do
      if #groups == 0 or line:find('^{X:attention') or line:find('^{C:inactive') then
        groups[#groups + 1] = { line }
      else
        table.insert(groups[#groups], line)
      end
    end
    local out = {}
    for i, g in ipairs(groups) do out[i] = T.format(g, vars) end
    return table.concat(out, '\n')
  end
end

--- Name of a loc entry with the Cardlike terms.
function T.name(set, key, fallback)
  local e = T.entry(set, key)
  local n = e and e.name or fallback or key
  return T.terms((n:gsub('{[^}]*}', '')))
end

--- A dictionary message ('poke_evolve_success' -> 'Evolved!').
function T.dict(key, fallback)
  local v = LOC.dictionary[key]
  if type(v) == 'string' then return T.terms(v) end
  return fallback or key
end

--- Plain text for the type name of a Pokemon, coloured: 'Grass' -> [color="#289830"]Grass[/color].
function T.type_name(ptype)
  if not ptype then return '' end
  return colorize(ptype, P.colours[ptype:lower()] or colors.GREY)
end


== file lib/types.lua (70 lines)
-- Pokemon types. A Pokemon joker's type is its def's ptype. A Tera effect (type sticker) overrides it: the new type
-- is kept in the card's data store under 'poke_tera', so it also works on jokers that are not Pokemon.
local P = cardlike.require('lib.base')

--- The Tera type of a card, or false (Balatro type_sticker_applied).
function P.type_sticker_applied(card)
  if not card or not card.uid then return false end
  local t = card:getDataStore():get('poke_tera')
  return t or false
end

--- The type of a joker: its Tera type, else its Pokemon type, else nil.
function P.get_type(card)
  if not card then return nil end
  local tera = P.type_sticker_applied(card)
  if tera then return tera end
  local def = P.def(card)
  return def and def.ptype or nil
end

function P.is_type(card, ptype)
  return card ~= nil and P.get_type(card) == ptype
end

--- Give a joker a Tera type (a random type when ptype is nil).
function P.apply_type_sticker(card, ptype, state)
  state = state or cardlike.state
  if not card then return nil end
  ptype = ptype or P.random_element(P.TYPES, state)
  card:getDataStore():set('poke_tera', ptype)
  card:popup(ptype .. '!', P.colours[ptype:lower()] or colors.ORANGE)
  return ptype
end

--- Remove a joker's Tera type.
function P.remove_type_sticker(card)
  if card then card:getDataStore():delete('poke_tera') end
end

--- Your jokers of a type (without exclude_card, and without jokers named exclude_name).
function P.find_pokemon_type(ptype, exclude_card, exclude_name, state)
  state = state or cardlike.state
  local out = {}
  for _, j in ipairs(state.jokers or {}) do
    if P.is_type(j, ptype) and j ~= exclude_card and (not exclude_name or P.name(j) ~= exclude_name) then
      out[#out + 1] = j
    end
  end
  return out
end

--- Jokers of a type plus matching Energy cards you hold (Balatro find_cards_by_ptype).
function P.find_cards_by_ptype(card, ptype, count_self, state)
  state = state or cardlike.state
  local n = #P.find_pokemon_type(ptype, nil, nil, state)
  if P.is_type(card, ptype) and not count_self then n = n - 1 end
  local energy_id = P.energy.card_id(ptype)
  for _, c in ipairs(state.consumables or {}) do
    if c:getConsumableDef() == energy_id then n = n + 1 end
  end
  return math.max(0, n)
end

--- Rich text badge of a type, for descriptions.
function P.type_badge(ptype, tera)
  if not ptype then return '' end
  local label = ptype .. (tera and ' Tera' or '')
  return colorize(bold(label), P.colours[ptype:lower()] or colors.GREY)
end


== file lib/ui.lua (181 lines)
-- Pokermon UI: extra description lines, the settings page, energy and sell value under jokers, the Pokedex button.
local P = cardlike.require('lib.base')
local U = P.ui
local ui = cardlike.ui

local STAGE_NAMES = { Baby = 'Baby', Basic = 'Basic', One = 'Stage 1', Two = 'Stage 2', Legendary = 'Legendary', Mega = 'Mega', Other = nil }

--- Lines under a Pokemon's description: type and stage, energy, evolution item.
function U.pokemon_info_lines(def, card)
  local lines = {}
  local ptype = card and P.get_type(card) or def.ptype
  local tera = card and P.type_sticker_applied(card)
  local head = {}
  if ptype then head[#head + 1] = P.type_badge(ptype, tera) end
  local stage = STAGE_NAMES[def.stage or '']
  if stage then head[#head + 1] = colorize(stage, colors.GREY) end
  if #head > 0 then lines[#lines + 1] = table.concat(head, ' ') end
  local energy = P.energy.info_line(card)
  if energy then lines[#lines + 1] = energy end
  if P.settings.detailed_tooltips then
    if card and P.get(card, 'poke_evolve') then
      lines[#lines + 1] = colorize('Evolves at the end of the round', colors.ORANGE)
    elseif def.item_req then
      local names = {}
      for _, id in ipairs(P.get_evo_item_keys(def)) do
        local info = cardlike.contentInfo('consumable', id)
        names[#names + 1] = info and info.name or P.short(id)
      end
      if #names > 0 then lines[#lines + 1] = colorize('Evolution item: ' .. table.concat(names, ' or '), colors.GREY) end
    end
    if def.megas and #def.megas > 0 then
      lines[#lines + 1] = colorize('Can Mega Evolve with a Mega Stone', P.colours.mega)
    end
  end
  return table.concat(lines, '\n')
end

---------------------------------------------------------------------------
-- Settings page
---------------------------------------------------------------------------

local function toggle(label, key, note)
  return ui.toggle { label = label .. (note or ''), value = function() return P.settings[key] ~= false end,
    onChange = function(v) P.settings[key] = v end, size = 18 }
end

local function pool_tab()
  local gens = ui.row { gap = 24 }
  local left = ui.column { gap = 6 }
  local right = ui.column { gap = 6 }
  local keys = { 'gen_one', 'gen_two', 'gen_three', 'gen_four', 'gen_five', 'gen_six', 'gen_seven', 'gen_eight', 'gen_nine' }
  for i, k in ipairs(keys) do
    local t = toggle('Gen ' .. i .. ' allowed', k)
    if i <= 5 then left[#left + 1] = t else right[#right + 1] = t end
  end
  gens[1], gens[2] = left, right
  return ui.column { gap = 10,
    toggle('Pokemon only (no other jokers in the shop)', 'pokemon_only'),
    toggle('Hazard jokers allowed', 'hazards_on'),
    gens,
  }
end

local function energy_tab()
  return ui.column { gap = 10,
    toggle('Unlimited energy', 'unlimited_energy'),
    toggle('Precise energy scaling', 'precise_energy'),
    toggle('Show energy count on jokers', 'energy_count'),
    toggle('Show sell value on jokers', 'sell_value'),
  }
end

local SERIES = { 'Basic', 'SeriesA' }
local SERIES_NAMES = { 'Basic Series', 'Series A' }

local function visual_tab()
  return ui.column { gap = 10,
    toggle('Detailed descriptions', 'detailed_tooltips'),
    toggle('Show Foresight cards', 'scry_view'),
    toggle('Shiny edition on playing cards', 'shiny_playing_cards'),
    ui.choice { label = 'Joker art (reload the game to apply)', options = SERIES_NAMES, width = 200,
      value = function() return P.settings.spritesheet == 'Basic' and 1 or 2 end,
      onChange = function(i) P.settings.spritesheet = SERIES[i] end },
  }
end

local function content_tab()
  return ui.column { gap = 10,
    ui.text { text = 'Reload the game to apply these:', size = 18, color = colors.GREY },
    toggle('Joke content', 'pokemon_aprilfools'),
    toggle('Legacy content', 'pokemon_legacy'),
  }
end

cardlike.onSettings(function()
  ui.open {
    modal = true,
    content = function()
      return ui.column { style = 'window', gap = 14, align = 'center', minWidth = 640,
        ui.text { text = 'Pokermon', size = 40, color = P.colours.fire },
        ui.tabs { tabs = {
          { label = 'Joker Pool', content = pool_tab },
          { label = 'Energy', content = energy_tab },
          { label = 'Visual', content = visual_tab },
          { label = 'Content', content = content_tab },
        } },
        ui.button { label = 'Close', onPress = function() ui.closeAll() end },
      }
    end,
  }
end)

---------------------------------------------------------------------------
-- Energy count and sell value under jokers
---------------------------------------------------------------------------

cardlike.onFrame(function(frame)
  if not frame.inRun then return end
  local show_energy, show_sell = P.settings.energy_count, P.settings.sell_value
  if not show_energy and not show_sell then return end
  local draw = cardlike.draw
  for _, j in ipairs(cardlike.state.jokers or {}) do
    local rect = j:screenRect()
    if rect then
      local y = rect.y + rect.height + 4
      if show_energy and P.def(j) then
        local e = P.energy.get_total_energy(j)
        if e > 0 then
          local text = P.text.num(e) .. '/' .. (P.settings.unlimited_energy and 'Inf' or P.text.num(P.energy.limit(j)))
          draw.rect { x = rect.x + rect.width / 2 - 34, y = y, width = 68, height = 22, radius = 6, color = '#262625cc' }
          draw.text { text = text, x = rect.x, y = y + 3, size = 14, width = rect.width, align = 'center', color = P.colours.pink }
          y = y + 24
        end
      end
      if show_sell then
        local v = j:getSellValue()
        draw.rect { x = rect.x + rect.width / 2 - 26, y = y, width = 52, height = 22, radius = 6, color = '#262625cc' }
        draw.text { text = '$' .. tostring(v), x = rect.x, y = y + 3, size = 14, width = rect.width, align = 'center', color = colors.MONEY }
      end
    end
  end
end)

---------------------------------------------------------------------------
-- Pokedex: drag a Pokemon onto DEX to see its evolution line
---------------------------------------------------------------------------

function U.open_pokedex(card)
  local name = P.name(card)
  if not name then return end
  local family = P.get_family_list(name)
  if #family == 0 then family = { name } end
  local col = ui.column { gap = 6, align = 'center' }
  for _, m in ipairs(family) do
    local n = type(m) == 'table' and m.key or m
    local def = P.def(n)
    local entry = P.text.entry('Joker', 'j_poke_' .. n)
    local label = entry and entry.name or n
    if type(m) == 'table' and m.form then label = label .. ' (' .. tostring(m.form) .. ')' end
    local colour = def and P.colours[(def.ptype or ''):lower()] or colors.GREY
    col[#col + 1] = ui.text { text = '#' .. P.get_dex_number(n) .. '  ' .. label .. (def and '' or '  (not in this game)'), size = 20,
      color = n == name and colors.ORANGE or colour }
  end
  for _, id in ipairs(P.get_evo_item_keys(P.def(name))) do
    local info = cardlike.contentInfo('consumable', id)
    col[#col + 1] = ui.text { text = 'Item: ' .. (info and info.name or P.short(id)), size = 18, color = P.colours.item }
  end
  ui.open { modal = true, content = ui.column { style = 'window', gap = 12, align = 'center',
    ui.text { text = 'Pokedex', size = 32, color = P.colours.fire },
    col,
    ui.button { label = 'Close', onPress = function() ui.closeAll() end },
  } }
end

cardlike.addCardButton {
  id = 'pokedex',
  label = 'DEX',
  appliesTo = function(card, state) return card:getKind() == 'joker' and P.def(card) ~= nil end,
  press = function(card, state) U.open_pokedex(card) end,
}


== file lib/utils.lua (757 lines)
-- General helpers that the Pokemon jokers use (Balatro pokermon.* utilities, written with the Cardlike API).
local P = cardlike.require('lib.base')

function P.deep_copy(t)
  if type(t) ~= 'table' then return t end
  local out = {}
  for k, v in pairs(t) do out[k] = P.deep_copy(v) end
  return out
end

function P.filter(list, fn)
  local out = {}
  for _, v in pairs(list or {}) do if fn(v) then out[#out + 1] = v end end
  return out
end

function P.has(list, element)
  for _, v in pairs(list or {}) do if v == element then return true end end
  return false
end

function P.any(list, fn)
  for _, v in pairs(list or {}) do if fn(v) then return true end end
  return false
end

function P.table_append(t1, t2)
  for _, v in ipairs(t2 or {}) do t1[#t1 + 1] = v end
  return t1
end

--- A set of the values of a list (or of one value). nil for nil.
function P.convert_to_set(x)
  if x == nil then return nil end
  local set = {}
  if type(x) == 'table' then
    for k, v in pairs(x) do set[v == true and k or v] = true end
  else
    set[x] = true
  end
  return set
end

--- Seeded shuffle of a list (in place).
function P.shuffle(list, state)
  state = state or cardlike.state
  for i = #list, 2, -1 do
    local j = state:random(1, i)
    list[i], list[j] = list[j], list[i]
  end
  return list
end

--- Up to args.amt random elements of args.array (seeded). args.add_con filters, args.mod_func runs on each pick.
function P.pseudorandom_multi(args, state)
  local elements = {}
  for _, v in ipairs(args.array or {}) do
    if not args.add_con or args.add_con(v) then elements[#elements + 1] = v end
  end
  P.shuffle(elements, state)
  local out = {}
  local amt = args.amt and math.min(#elements, args.amt) or #elements
  for i = 1, amt do
    if args.mod_func then args.mod_func(elements[i]) end
    out[#out + 1] = elements[i]
  end
  return out
end

--- A random element of a list (seeded).
function P.random_element(list, state)
  if not list or #list == 0 then return nil end
  state = state or cardlike.state
  return list[state:random(1, #list)]
end

---------------------------------------------------------------------------
-- Playing cards
---------------------------------------------------------------------------

local function rank_of(card)
  local info = card.lastInfo
  if info and info.rank and not info.noRank then return info.rank end
  if info and info.noRank then return nil end
  return card:getRank()
end
P.rank_of = rank_of

function P.is_even(card)
  local r = rank_of(card)
  return r == 2 or r == 4 or r == 6 or r == 8 or r == 10
end

function P.is_odd(card)
  local r = rank_of(card)
  return r == 3 or r == 5 or r == 7 or r == 9 or r == 14
end

--- Rank name of a rank id (13 -> 'King').
function P.get_rank(card_or_id)
  local id = type(card_or_id) == 'number' and card_or_id or rank_of(card_or_id)
  return P.RANK_NAMES[id] or tostring(id)
end

--- Points a playing card scores (Balatro total_chips).
function P.total_chips(card)
  return card:getPointValue()
end

--- Whether a card has an enhancement (or one of several). Accepts Balatro keys ('m_glass') and Cardlike ids
--- ('Fragile', 'pokermon:seed'): P.has_enhancement(card, 'm_stone', 'm_glass').
function P.has_enhancement(card, ...)
  local e = card.lastInfo and card.lastInfo.enhancement or card:getEnhancement()
  for i = 1, select('#', ...) do
    local want = select(i, ...)
    local id = P.ENHANCEMENT_IDS[want] or want
    if e == id then return true end
    if type(id) == 'string' and not id:find(':', 1, true) and type(e) == 'string' and e:match(':' .. id .. '$') then return true end
  end
  return false
end

--- The card's snapshot (card.lastInfo, or a new one).
function P.info(card) return card.lastInfo or card:info() or {} end

--- Whether a card is debuffed (from the snapshot when it has the value).
function P.is_debuffed(card)
  local info = card and card.lastInfo
  if info and info.debuffed ~= nil then return info.debuffed end
  return card:getDebuffState()
end

--- The enhancement id of a card. fresh = true asks the game (another joker may have changed it in this step).
function P.enhancement(card, fresh)
  if not fresh and card.lastInfo and card.lastInfo.enhancement then return card.lastInfo.enhancement end
  return card:getEnhancement()
end

--- Whether a playing card has one of the ranks: P.rank_is(card, 3, 6). Cards with no rank never match.
function P.rank_is(card, ...)
  local r = rank_of(card)
  if not r then return false end
  for i = 1, select('#', ...) do if r == select(i, ...) then return true end end
  return false
end

--- Whether a list of playing cards has a card of one of the ranks: P.any_rank(step.hand.playedCards, 5, 6, 7).
function P.any_rank(cards, ...)
  for _, c in ipairs(cards or {}) do
    if P.rank_is(c, ...) then return true end
  end
  return false
end

--- The cards of the played hand that did not score.
function P.unscored_cards(hand)
  local scored = {}
  for _, c in ipairs(hand and hand.playedCards or {}) do scored[c.uid] = true end
  local out = {}
  for _, c in ipairs(hand and hand.allCards or {}) do
    if not scored[c.uid] then out[#out + 1] = c end
  end
  return out
end

--- Every suit: the base suits, then mod suits.
local all_suits
function P.all_suits()
  if all_suits then return all_suits end
  all_suits = {}
  local seen = {}
  for _, s in ipairs(P.SUITS) do all_suits[#all_suits + 1] = s; seen[s] = true end
  for _, s in ipairs(cardlike.listContent('suit') or {}) do
    if s.id and not seen[s.id] then all_suits[#all_suits + 1] = s.id; seen[s.id] = true end
  end
  return all_suits
end

P.SUIT_SINGULAR = { Spades = 'Spade', Hearts = 'Heart', Clubs = 'Club', Diamonds = 'Diamond' }

--- 'Heart' for 'Hearts' (texts say "each Heart").
function P.suit_name(suit) return P.SUIT_SINGULAR[suit] or tostring(suit) end

--- The text colour of a suit (the {C:hearts} colours).
function P.suit_colour(suit) return P.text.colour(tostring(suit)) or colors.ORANGE end

--- A random Luna, Holo or Chroma edition (Balatro Foil, Holographic, Polychrome with their weights).
function P.random_edition(state)
  state = state or cardlike.state
  local r = state:randomFloat()
  if r < 0.5 then return 'Luna' end
  if r < 0.85 then return 'Holo' end
  return 'Chroma'
end

--- A random stamp: from list (ids of other mods that are not loaded are left out), or from every stamp.
function P.random_stamp(state, list)
  local ids = {}
  if list then
    for _, s in ipairs(list) do
      if not s:find(':', 1, true) or cardlike.contentInfo('stamp', s) then ids[#ids + 1] = s end
    end
  else
    for _, s in ipairs(cardlike.listContent('stamp') or {}) do ids[#ids + 1] = s.id end
    if #ids == 0 then ids = { 'Replay Stamp', 'Cash Stamp', 'Fruit Stamp', 'Game Stamp' } end
  end
  return P.random_element(ids, state)
end

-- Consumable types a random consumable can come from (Balatro SMODS.ConsumableTypes).
P.CONSUMABLE_TYPES = { 'game', 'fruit', 'admin', P.MOD_ID .. ':item', P.MOD_ID .. ':energy' }

---------------------------------------------------------------------------
-- Hand types
---------------------------------------------------------------------------

-- Built-in hand types in the order of the Hands tab.
P.HAND_ORDER = { 'HIGH_CARD', 'PAIR', 'TWO_PAIR', 'THREE_OF_A_KIND', 'STRAIGHT', 'FLUSH', 'FULL_HOUSE',
  'FOUR_OF_A_KIND', 'STRAIGHT_FLUSH', 'ROYAL_FLUSH', 'FIVE_OF_A_KIND', 'FLUSH_HOUSE', 'FLUSH_FIVE' }
P.HAND_NAMES = { HIGH_CARD = 'High Card', PAIR = 'Pair', TWO_PAIR = 'Two Pair', THREE_OF_A_KIND = 'Three of a Kind',
  STRAIGHT = 'Straight', FLUSH = 'Flush', FULL_HOUSE = 'Full House', FOUR_OF_A_KIND = 'Four of a Kind',
  STRAIGHT_FLUSH = 'Straight Flush', ROYAL_FLUSH = 'Royal Flush', FIVE_OF_A_KIND = 'Five of a Kind',
  FLUSH_HOUSE = 'Flush House', FLUSH_FIVE = 'Flush Five' }
-- Hands that show in the Hands tab before they are played (the others are secret until played).
local ALWAYS_VISIBLE = { HIGH_CARD = true, PAIR = true, TWO_PAIR = true, THREE_OF_A_KIND = true, STRAIGHT = true,
  FLUSH = true, FULL_HOUSE = true, FOUR_OF_A_KIND = true, STRAIGHT_FLUSH = true }
-- The Fruit card (Balatro Planet card) of each built-in hand type.
P.FRUIT_OF_HAND = { STRAIGHT = 'fruit_card_0', FULL_HOUSE = 'fruit_card_1', TWO_PAIR = 'fruit_card_2',
  HIGH_CARD = 'fruit_card_3', PAIR = 'fruit_card_4', THREE_OF_A_KIND = 'fruit_card_5', FLUSH_HOUSE = 'fruit_card_6',
  FLUSH_FIVE = 'fruit_card_7', FIVE_OF_A_KIND = 'fruit_card_8', FOUR_OF_A_KIND = 'fruit_card_9', FLUSH = 'fruit_card_10',
  STRAIGHT_FLUSH = 'fruit_card_11' }
P.HAND_OF_FRUIT = {}
for hand, fruit in pairs(P.FRUIT_OF_HAND) do P.HAND_OF_FRUIT[fruit] = hand end
-- A Royal Flush is a Straight Flush for its Fruit card (after HAND_OF_FRUIT, which keeps Apple for Straight Flush).
P.FRUIT_OF_HAND.ROYAL_FLUSH = 'fruit_card_11'

--- The name of a hand type id.
function P.hand_name(id)
  if P.HAND_NAMES[id] then return P.HAND_NAMES[id] end
  local info = cardlike.contentInfo('handType', id)
  if info and info.name then return info.name end
  return tostring(id)
end

local function hand_position(id)
  for i, h in ipairs(P.HAND_ORDER) do if h == id then return i end end
  return #P.HAND_ORDER + 1
end

--- The hand types the player can see (not secret, or played this run), in the Hands tab order.
function P.visible_hands(state)
  local out = {}
  for id, h in pairs(state and state.hands or {}) do
    if ALWAYS_VISIBLE[id] or (h.played or 0) > 0 then out[#out + 1] = id end
  end
  table.sort(out, function(a, b)
    local ra, rb = hand_position(a), hand_position(b)
    if ra ~= rb then return ra < rb end
    return a < b
  end)
  return out
end

--- Number of cards in a hand with rank id (Balatro get_ancient_amount). Stores it in the joker as 'ancient_count'.
function P.get_ancient_amount(cards, id, joker)
  local count = 0
  for _, c in ipairs(cards or {}) do if rank_of(c) == id then count = count + 1 end end
  if joker then P.set(joker, 'ancient_count', count) end
  return count
end

--- Whether the cards have at least num different suits (wild cards fill missing suits last).
function P.suit_check(cards, num)
  local suits, count = {}, 0
  local wild = {}
  for _, c in ipairs(cards or {}) do
    local info = c.lastInfo or c:info() or {}
    if info.anySuit then wild[#wild + 1] = c
    elseif info.suit and not suits[info.suit] and info.suits and info.suits[info.suit] then
      suits[info.suit] = true
      count = count + 1
    end
  end
  for _ in ipairs(wild) do
    for _, s in ipairs(P.SUITS) do
      if not suits[s] then suits[s] = true count = count + 1 break end
    end
  end
  return count >= num
end

--- Whether every card shares one suit.
function P.is_same_suit(cards)
  for _, s in ipairs(P.SUITS) do
    local all = true
    for _, c in ipairs(cards or {}) do if not c:isSuit(s) then all = false break end end
    if all then return true end
  end
  return false
end

--- For each suit, the first card that can take it (wild cards are spread over the missing suits).
function P.get_first_of_each_suit(cards)
  local claimed = {}
  local function assign(card, checked)
    for _, s in ipairs(P.SUITS) do
      if card:isSuit(s) and not checked[s] then
        checked[s] = true
        if not claimed[s] or assign(claimed[s], checked) then
          claimed[s] = card
          return true
        end
      end
    end
    return false
  end
  for _, c in ipairs(cards or {}) do assign(c, {}) end
  return claimed
end

--- Playing cards that match a function (default: the undrawn deck).
function P.find_playing_card(fn, list, state)
  state = state or cardlike.state
  local out = {}
  for _, c in ipairs(list or state.unDrawnCards or {}) do if fn(c) then out[#out + 1] = c end end
  return out
end

--- True when no undrawn card matches.
function P.get_depleted(fn, state)
  state = state or cardlike.state
  for _, c in ipairs(state.unDrawnCards or {}) do if fn(c) then return false end end
  return true
end

--- Change a card's rank: decrease = true (-1), false (+1) or nil (random rank).
function P.vary_rank(card, decrease, state)
  state = state or cardlike.state
  local r = card:getRank()
  if decrease == nil then
    card:setRank(state:random(2, 14))
  elseif decrease then
    card:setRank(r <= 2 and 14 or r - 1)
  else
    card:setRank(r >= 14 and 2 or r + 1)
  end
end

--- The next rank above id that is in your deck (Balatro next_owned_rank). Returns id, rank name.
function P.next_owned_rank(id, state)
  state = state or cardlike.state
  local owned = {}
  for _, c in ipairs(state.allCards or {}) do
    local r = rank_of(c)
    if r then owned[r] = true end
  end
  for step = 1, 13 do
    local r = (id - 2 + step) % 13 + 2
    if owned[r] then return r, P.RANK_NAMES[r] end
  end
  return id, P.RANK_NAMES[id]
end

--- The lowest rank below id in your deck. Returns id, rank name.
function P.get_lowest_rank(id, state)
  state = state or cardlike.state
  local low = id
  for _, c in ipairs(state.allCards or {}) do
    local r = rank_of(c)
    if r and r < low then low = r end
  end
  return low, P.RANK_NAMES[low]
end

--- Change cards like Pokermon's convert_cards: t.mod_conv (enhancement), t.edition, t.suit_conv, t.seal (stamp),
--- t.random (random rank), t.up / t.down (rank +1 / -1), t.bonus_chips (permanent points).
function P.convert_cards(cards, t, state)
  if not cards then return end
  if cards.uid then cards = { cards } end
  for _, c in ipairs(cards) do
    if t.mod_conv then c:setEnhancement(P.ENHANCEMENT_IDS[t.mod_conv] or t.mod_conv) end
    if t.edition then c:setEdition(P.EDITION_IDS[t.edition] or t.edition) end
    if t.suit_conv then c:setSuit(t.suit_conv) end
    if t.seal then c:setStamp(P.STAMP_IDS[t.seal] or t.seal) end
    if t.random then P.vary_rank(c, nil, state) end
    if t.up or t.down then P.vary_rank(c, not t.up, state) end
    if t.bonus_chips then c:addAdditionalPointValue(t.bonus_chips) end
    c:punch()
  end
end

--- Give cards an enhancement with a message (Balatro enhance_cards).
function P.enhance_cards(cards, enhancement, source, message)
  P.convert_cards(cards, { mod_conv = enhancement })
  if source and message then source:popup(message, colors.ORANGE) end
end

--- Destroy a card (Balatro remove_card).
function P.remove_card(target, source)
  if source then source:punch() end
  if target then target:destroy() end
end

--- Targets for 'rank' jokers: num random ranks { value = 'King', id = 13 } (from the deck when use_deck).
function P.get_target_card_ranks(num, default, use_deck, state)
  state = state or cardlike.state
  if not state or state.allCards == nil then return default end
  local out = {}
  if use_deck then
    for _ = 1, num do
      local valid = {}
      for _, c in ipairs(state.allCards) do
        local r = rank_of(c)
        local taken = false
        for _, t in ipairs(out) do if t.id == r then taken = true end end
        if r and not taken then valid[#valid + 1] = r end
      end
      local r = P.random_element(valid, state)
      if r then out[#out + 1] = { value = P.RANK_NAMES[r], id = r }
      elseif #out > 0 then out[#out + 1] = out[1]
      else out[#out + 1] = { value = 'Ace', id = 14 } end
    end
  else
    local all = {}
    for r = 2, 14 do all[#all + 1] = { value = P.RANK_NAMES[r], id = r } end
    out = P.pseudorandom_multi({ array = all, amt = num }, state)
  end
  table.sort(out, function(a, b) return a.id < b.id end)
  return out
end

--- A target suit: { { suit = 'Hearts' } } (from the deck when use_deck).
function P.get_target_card_suit(use_deck, default, limit_suits, state)
  state = state or cardlike.state
  local allowed = limit_suits or P.SUITS
  if not state or state.allCards == nil then return { { suit = default or 'Spades' } } end
  if use_deck then
    local valid = {}
    for _, c in ipairs(state.allCards) do
      local info = c.lastInfo or {}
      if info.suit and not info.anySuit and not info.noRank and P.has(allowed, info.suit) then valid[#valid + 1] = info.suit end
    end
    return { { suit = P.random_element(valid, state) or default or 'Spades' } }
  end
  return { { suit = P.random_element(allowed, state) } }
end

--- num different random enhancements (Cardlike ids).
function P.get_target_card_enhancements(num, options, state)
  local opts = {}
  for _, e in ipairs(options or { 'm_bonus', 'm_mult', 'm_wild', 'm_glass', 'm_steel', 'm_gold', 'm_lucky' }) do
    opts[#opts + 1] = P.ENHANCEMENT_IDS[e] or e
  end
  return P.pseudorandom_multi({ array = opts, amt = num }, state)
end

--- Add the rank names of targets to a vars list (for texts).
function P.add_target_cards_to_vars(vars, targets)
  for _, t in ipairs(targets or {}) do vars[#vars + 1] = t.value or 'Ace' end
  return vars
end

---------------------------------------------------------------------------
-- Jokers
---------------------------------------------------------------------------

--- The first joker that matches (a Pokemon name, a joker id or a function).
function P.find_card(key_or_fn, state)
  state = state or cardlike.state
  for _, j in ipairs(state.jokers or {}) do
    if type(key_or_fn) == 'function' then
      if key_or_fn(j) then return j end
    else
      local id = j:getJokerDef()
      if id == key_or_fn or id == P.id(key_or_fn) then return j end
    end
  end
  return nil
end

--- Cardlike has no selected joker: the leftmost joker that matches (Balatro find_leftmost_or_highlighted).
function P.find_leftmost_or_highlighted(fn, state)
  state = state or cardlike.state
  if not fn then return (state.jokers or {})[1] end
  return P.find_card(fn, state)
end

--- Jokers next to a joker.
function P.get_adjacent_jokers(card, state)
  state = state or cardlike.state
  local list = state.jokers or {}
  local out = {}
  for i, j in ipairs(list) do
    if j == card then
      if list[i - 1] then out[#out + 1] = list[i - 1] end
      if list[i + 1] then out[#out + 1] = list[i + 1] end
      break
    end
  end
  return out
end

--- Whether you own a joker (Pokemon name or joker id).
function P.owns(state, name)
  state = state or cardlike.state
  return state ~= nil and state.hasJoker ~= nil and state:hasJoker(P.id(name))
end

--- Your jokers of a Pokemon (name or id) that are not debuffed.
function P.active_jokers(state, name)
  state = state or cardlike.state
  local id = P.id(name)
  local out = {}
  for _, j in ipairs(state and state.jokers or {}) do
    if j:getJokerDef() == id and not P.is_debuffed(j) then out[#out + 1] = j end
  end
  return out
end

--- The joker to the right of card (nil for the rightmost).
function P.right_joker(card, state)
  state = state or cardlike.state
  local jokers = state and state.jokers or {}
  for i, j in ipairs(jokers) do
    if j == card then return jokers[i + 1] end
  end
  return nil
end

--- The rightmost joker, when it is not card.
function P.rightmost_joker(card, state)
  state = state or cardlike.state
  local jokers = state and state.jokers or {}
  local last = jokers[#jokers]
  if last == card then return nil end
  return last
end

--- Jokers with at least `level` energy (default 1).
function P.energized_count(state, level)
  state = state or cardlike.state
  local n = 0
  for _, j in ipairs(state and state.jokers or {}) do
    if P.energy.get_total_energy(j) >= (level or 1) then n = n + 1 end
  end
  return n
end

--- Raise a card's sell value by amount. A fraction (from energy) carries over to the next time. Returns the whole
--- dollars added.
function P.sell_value_up(card, amount)
  local total = (P.get(card, 'poke_sell_frac', 0) or 0) + (amount or 0)
  local whole = math.floor(total)
  P.set(card, 'poke_sell_frac', total - whole)
  if whole > 0 then card:addSellValue(whole) end
  card:popup(P.text.dict('k_val_up', 'Value Up!'), colors.MONEY)
  return whole
end

---------------------------------------------------------------------------
-- Interest, as the game pays it at the end of a round: $1 for every $5 up to the cap ($25, $50 with Money Bowl, $100
-- with Insert Coin), more with Scrooge, none on a deck without interest (Grass Deck). Cardlike has no interest fields.
---------------------------------------------------------------------------

function P.interest_cap(state)
  if state:hasTicket('ticket_21') then return 100 end
  if state:hasTicket('ticket_20') then return 50 end
  return 25
end

function P.no_interest(state)
  if state.deck == 'Grass Deck' then return true end
  local info = state.deck and cardlike.contentInfo('deck', state.deck)
  return info ~= nil and info.noInterest == true
end

--- The interest the player would earn now. extra_cap raises the cap (Mega Raichu X).
function P.interest(state, extra_cap)
  if P.no_interest(state) then return 0 end
  local cap = P.interest_cap(state) + (extra_cap or 0)
  local per = 1 + (state:countJoker('joker_scrooge') or 0)
  return math.floor(math.min(cap, math.max(0, state.money)) / 5 + 0.5) * per
end

---------------------------------------------------------------------------
-- Loyalty counter (Balatro Loyalty Card) over the hands played since the joker joined: Slugma, Magcargo, Jirachi.
---------------------------------------------------------------------------

--- Remember the hands played when the joker joined (call from onAdded).
function P.loyalty_start(card, state)
  if not card:getDataStore():has('hands_at_create') then P.set(card, 'hands_at_create', state.totalHandsPlayed or 0) end
end

--- Hands left before the loyalty triggers, with config 'every': 0 means this hand. Call it during the hand (Cardlike
--- already counted the hand being played in totalHandsPlayed).
function P.loyalty_remaining(card, state)
  local every = P.get(card, 'every', 2)
  local before = (state.totalHandsPlayed or 1) - 1 - (P.get(card, 'hands_at_create', 0) or 0)
  return (every - 1 - before) % (every + 1)
end

--- 'Active!' or '2 remaining', for texts.
function P.loyalty_text(remaining)
  if (remaining or 0) == 0 then return 'Active!' end
  return P.text.num(remaining) .. ' remaining'
end

--- Consumables you hold, optionally of one type ('pokermon:item', 'pokermon:energy', 'game', ...).
function P.get_consumeables(ctype, state)
  state = state or cardlike.state
  local out = {}
  for _, c in ipairs(state.consumables or {}) do
    local t = c.lastInfo and c.lastInfo.type or c:getConsumableType()
    if not ctype or t == ctype or t == P.MOD_ID .. ':' .. tostring(ctype) or (ctype == 'poke_item' and t == P.MOD_ID .. ':item')
        or (ctype == 'poke_energy' and t == P.MOD_ID .. ':energy') then
      out[#out + 1] = c
    end
  end
  return out
end

--- Add or remove hands this round, never below 1 hand left (Balatro pokermon.ease_hands_played).
function P.ease_hands_played(mod, state)
  state = state or cardlike.state
  if mod >= 0 then
    state.handsLeft = state.handsLeft + mod
  else
    local dec = math.min(state.handsLeft - 1, -mod)
    if dec > 0 then state.handsLeft = state.handsLeft - dec end
  end
end

--- Earn money with the joker's energy bonus chance (Balatro ease_poke_dollars). Returns the amount.
--- calc_only = true only computes it (give it with plusMoney in a result).
function P.ease_poke_dollars(card, seed, amt, calc_only, state)
  state = state or cardlike.state
  local earned = amt
  local frac = card and P.get(card, 'poke_frac_money') or nil
  if type(frac) == 'number' and frac > state:randomFloat() then earned = earned + 1 end
  if not calc_only then state:mutateMoney(earned) end
  return earned
end

--- Lower a joker's sell value by up to amount (never below 1) and add it to card (Balatro drain_value).
function P.drain_value(card, target, amount, one_way)
  local drain = math.min(target:getSellValue() - 1, amount)
  if drain > 0 then
    target:addSellValue(-drain)
    target:popup(P.text.dict('poke_val_down', 'Value Down!'), colors.MULT)
    if not one_way and card then
      card:addSellValue(drain)
      card:popup('Value Up!', colors.MONEY)
    end
  end
  return drain
end

--- Remove up to amount points from a playing card (Balatro drain_chips): the base points first, down to 1 point,
--- then the bonus points. Cardlike cannot change the rank points, so the drain is negative bonus points and the card
--- keeps at least 1 point. Returns the drained amount.
function P.drain_chips(card, amount)
  if not amount or amount <= 0 then return 0 end
  local d = math.min(amount, (card:getPointValue() or 0) - 1)
  if d <= 0 then return 0 end
  card:addAdditionalPointValue(-d)
  return d
end

--- 'Nope!' message on a card.
function P.nope(card)
  if card then card:popup('Nope!', colors.PURPLE) else cardlike.centerText('Nope!', 1.2) end
end

--- A joker faints: it is debuffed until the end of the round (Balatro card.ability.fainted). A fainted joker does not
--- count the round for its level evolution; the library brings it back after the evolution step.
function P.faint(card, state, message)
  state = state or cardlike.state
  P.set(card, 'poke_fainted', state.round or 0)
  card:setDebuffState(true)
  if message then card:popup(message, colors.MULT) end
end

--- Bring back the jokers that fainted (after the evolution step of the round).
function P.revive_fainted(state)
  for _, j in ipairs(state.jokers or {}) do
    if P.get(j, 'poke_fainted') then
      j:getDataStore():delete('poke_fainted')
      j:setDebuffState(false)
    end
  end
end

--- Baby Pokemon faint (are debuffed for the round) when a non-Baby joker is to their right.
--- Call it from afterAllCardsScored (Balatro faint_baby_poke in joker_main).
function P.faint_baby_poke(card, state, step)
  if step and step.copiedBy then return end
  state = state or cardlike.state
  local jokers = state.jokers or {}
  local last = jokers[#jokers]
  local alive = last ~= nil and (P.def(last) or {}).stage == 'Baby'
  if alive then
    local self_pos, adult_pos = 0, 0
    for i, j in ipairs(jokers) do
      if j == card then self_pos = i end
      if (P.def(j) or {}).stage ~= 'Baby' then adult_pos = i end
    end
    if adult_pos > self_pos then alive = false end
  end
  if not alive then P.faint(card, state, P.text.dict('poke_faint_ex', 'Fainted!')) end
end

--- The scoring trigger of a Baby Pokemon: it may faint, then gives its X Mult below 1 (config Xmult_minus).
function P.baby_main(card, state, step, result)
  P.faint_baby_poke(card, state, step)
  result:add(xMult(P.get(card, 'Xmult_minus')))
end

--- Volatile jokers work only at one end of your jokers: direction 'left' or 'right' (Balatro volatile_active).
function P.volatile_active(card, direction, state)
  state = state or cardlike.state
  local first_pos, self_pos, normal_pos = nil, 0, 0
  for i, j in ipairs(state.jokers or {}) do
    if j == card then self_pos = i end
    if not P.get(j, 'volatile') then
      normal_pos = i
      first_pos = first_pos or i
    end
  end
  if direction == 'left' and first_pos and first_pos < self_pos then return false end
  if direction == 'right' and normal_pos > self_pos then return false end
  return true
end

--- Whether a card is shown in the collection (no run): Cardlike description functions get r.card = nil there.
function P.is_in_collection(card)
  return card == nil or cardlike.state.money == nil
end

--- Put a card for sale in the shop (Balatro add_shop_card): an id, free when is_free.
function P.add_shop_card(id, source, is_free)
  local ok = cardlike.addShopItem(id, { free = is_free })
  if ok and source then source:popup(P.text.dict('poke_plus_shop', '+1 Shop Card'), colors.GREEN) end
  return ok
end

---------------------------------------------------------------------------
-- Animation helpers of the original code. Cardlike animates changes by itself, so these only bounce the cards.
---------------------------------------------------------------------------

function P.juice_flip(card) if card then card:punch() end end
function P.juice_flip_hand(card) if card then card:punch() end end
function P.juice_flip_table(card) if card then card:punch() end end
function P.juice_flip_single(card) if card then card:punch() end end
function P.unhighlight_cards() end
--- Runs fn at once (the original queued it as an event).
function P.conversion_event_helper(fn) fn() end


== file main.lua (22 lines)
-- Pokermon for Cardlike.
-- lib/     the shared Pokermon library (evolution, energy, types, items, sprites, texts, settings)
-- content/ everything that is not a Pokemon joker (Items, Energy, packs, pins, tickets, decks, blinds, ...)
-- jokers/  the Pokemon jokers, one file per original pokejokers_XX.lua
local poke = cardlike.require('lib.pokermon')

cardlike.require('content.base')
for _, name in ipairs({ 'consumables', 'boosters', 'seals', 'stickers', 'editions', 'enhancements', 'vouchers', 'blinds',
    'stakes', 'tags', 'backs', 'challenges', 'skins', 'rules' }) do
  if cardlike.fileInfo(cardlike.modPath() .. 'content/' .. name .. '.lua') then cardlike.require('content.' .. name) end
end

local joker_files = {}
for i = 1, 35 do joker_files[#joker_files + 1] = string.format('pokejokers_%02d', i) end
for _, name in ipairs({ 'zmissingno', 'zotherjokers', 'zzzapril_fools' }) do joker_files[#joker_files + 1] = name end

for _, name in ipairs(joker_files) do
  if cardlike.fileInfo(cardlike.modPath() .. 'jokers/' .. name .. '.lua') then cardlike.require('jokers.' .. name) end
end

return poke


