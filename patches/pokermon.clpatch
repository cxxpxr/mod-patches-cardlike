-- Kingdra 230
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'kingdra', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Dragon', gen = 2,
  config = { mult = 0, mult_mod = 1, Xmult = 1, Xmult_mod = .05 },
  attributes = { 'mult', 'xmult', 'rank', 'six', 'king', 'scaling' },
  vars = function(get) return { get('mult'), get('mult_mod'), get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.copiedBy or step.card:getDebuffState() or poke.rank_of(step.card) ~= 6 then return end
      local king = false
      for _, c in ipairs(state.cardsInHand or {}) do if poke.rank_of(c) == 13 then king = true break end end
      if king then
        poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
      else
        poke.add(card, 'mult', poke.get(card, 'mult_mod'))
        result:say('+' .. poke.text.num(poke.get(card, 'mult_mod')) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult, x = poke.get(card, 'mult'), poke.get(card, 'Xmult')
      if mult <= 0 and x <= 1 then return end
      if mult > 0 then result:add(plusMult(mult)) end
      if x > 1 then result:add(xMult(x)) end
      result:say(poke.text.dict('poke_twister_ex', 'Twister!'), poke.colours.dragon)
    end,
  },
}

