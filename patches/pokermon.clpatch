      if step.copiedBy or not poke.volatile_active(card, poke.get(card, 'volatile'), state) then return end
      local jokers = state.jokers or {}
      local target = jokers[#jokers]
      if target and target ~= card and not target:isLocked() and target:getSticker() ~= 'timed' then
        target:setLocked(true)
        card:punch()
        target:popup(poke.text.dict('poke_shadow_tag_ex', 'Shadow Tag!'), '#5d5dff')
      end
    end,
    repeatCard = function(card, state, step, result)
      if poke.rank_is(step.card, 6, 7, 8, 9, 10) then return poke.get(card, 'retriggers') end
    end,
  },
}

-- Girafarig 203
poke.addPokemon {
  name = 'girafarig', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 2,
  config = { Xmult_multi = 2, death_used = 0 },
  attributes = { 'face', 'xmult', 'hand_type', 'condition_evo' },
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if not (step.hand.contains or {}).TWO_PAIR then return end
      local cards = step.hand.playedCards or {}
      local first = first_face(step.hand)
      local last
      for i = #cards, 1, -1 do
        if cards[i]:isFace() and cards[i] ~= first then last = cards[i] break end
      end
      if step.card == first or step.card == last then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
    -- Balatro Death is Cardlike's Mage (cart_card_3)
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not step.card or step.card:getConsumableDef() ~= 'cart_card_3' then return end
      local sel = state.selectedCards or {}
      if #sel > 1 and sel[1]:isFace() and sel[2]:isFace() then poke.add(card, 'death_used', 1) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'farigiraf', poke.get(card, 'death_used'), 1) end,
}

-- Pineco 204, Forretress 205: Volatile Left, +Points then faint for the round. A Pokemon that fainted this round does
-- not count the round toward its level evolution (the library checks evolution before fainted jokers come back).
local function explode(card, state, result, chips)
  result:add(plusChips(chips))
  result:say(poke.text.dict('poke_explosion_ex', 'BOOM!'), colors.CHIPS)
  poke.faint(card, state)
end

poke.addPokemon {
  name = 'pineco', rarity = 1, cost = 3, stage = 'Basic', ptype = 'Grass', gen = 2,
  config = { chips = 120, rounds = 3, volatile = 'left' },
  attributes = { 'chips', 'volatile', 'round_evo' },
  vars = function(get) return { get('chips'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if poke.volatile_active(card, poke.get(card, 'volatile'), state) then explode(card, state, result, poke.get(card, 'chips')) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'forretress') end,
}

poke.addPokemon {
  name = 'forretress', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Metal', gen = 2,
  config = { chips = 150, chip_mod = 5, volatile = 'left' },
  attributes = { 'chips', 'volatile', 'enhancements', 'round_evo' },
  vars = function(get) return { get('chips'), get('chip_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not poke.volatile_active(card, poke.get(card, 'volatile'), state) then return end
      local multiplier = 1
      for _, c in ipairs(state.cardsInHand or {}) do
        if poke.enhancement(c) == 'Wooden' then multiplier = 2 break end
      end
      explode(card, state, result, poke.get(card, 'chips') * multiplier)
    end,
  },
}

