== file jokers/pokejokers_02.lua (683 lines)
-- Pokemon jokers 031 to 060 (original file pokemon/pokejokers_02.lua): Nidoqueen to Poliwag.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Asks the game (not the snapshot): another joker may have changed the card earlier in the same step.
local function enhancement_of(c) return poke.enhancement(c, true) end

-- A card held in hand of one rank gives a bonus (Nidoran line). A debuffed card says so.
local function held_rank_bonus(step, result, rank, bonus)
  if poke.rank_of(step.card) ~= rank then return end
  if poke.is_debuffed(step.card) then
    result:say('Debuffed', colors.MULT, step.card)
    return
  end
  result:add(bonus)
end

-- Exactly one played card and it is a face card (Psyduck line).
local function single_face(hand)
  return #(hand.allCards or {}) == 1 and hand.playedCards[1] ~= nil and hand.playedCards[1]:isFace()
end

-- Oddish line: one of three values at random.
local function pick3(state, a, b, c)
  local r = state:randomFloat()
  if r < 1 / 3 then return 1, a elseif r < 2 / 3 then return 2, b end
  return 3, c
end

-- Golduck: remembers the enhancement of each playing card, per Golduck, to see when a card becomes Gilded.
local golduck_seen = {}
local function golduck_table(joker, step)
  local key = (step and step.copiedBy or joker).uid
  golduck_seen[key] = golduck_seen[key] or {}
  return golduck_seen[key]
end
local function golduck_snapshot(joker, state, step)
  local t = golduck_table(joker, step)
  for _, c in ipairs(state.allCards or {}) do t[c.uid] = enhancement_of(c) end
end

