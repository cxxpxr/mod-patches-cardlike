-- Arbok 024
poke.addPokemon {
  name = 'arbok', rarity = 2, cost = 7, stage = 'One', ptype = 'Dark', gen = 1,
  config = { mult = 15, rounds = 4 },
  attributes = { 'hand_type', 'mult', 'ace', 'tarot', 'generation', 'rank' },
  vars = function(get) return { get('mult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.hand.contains.STRAIGHT then return end
      result:add(plusMult(poke.get(card, 'mult')))
      if state.freeConsumableSlots <= 0 then return end
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.rank_of(c) == 14 then
          poke.create_consumeable({ set = 'game' }, card)
          break
        end
      end
    end,
  },
}

