-- Zubat 041
poke.addPokemon {
  name = 'zubat', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Dark', gen = 1,
  config = { mult = 0, mult_mod = 2 },
  evo_rqmt = 12,
  attributes = { 'mult', 'modify_card', 'enhancements', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('mult'), get('mult_mod'), 12 } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local target
      for _, c in ipairs(step.hand.playedCards) do
        if enhancement_of(c) ~= 'Default' then target = c break end
      end
      if target and not poke.is_debuffed(target) then
        target:setEnhancement('Default')
        target:punch()
        local n = poke.get(card, 'mult_mod')
        poke.add(card, 'mult', n)
        result:say('+' .. poke.text.num(n) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'golbat', poke.get(card, 'mult'), 12) end,
}

-- Golbat 042
poke.addPokemon {
  name = 'golbat', rarity = 3, cost = 8, stage = 'One', ptype = 'Dark', gen = 1,
  config = { mult = 0, mult_mod = 2, eaten = 0 },
  evo_rqmt = 16,
  attributes = { 'mult', 'modify_card', 'enhancements', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('mult'), get('mult_mod'), math.max(0, 16 - get('eaten')) } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local count = 0
      for _, c in ipairs(step.hand.playedCards) do
        if enhancement_of(c) ~= 'Default' and not poke.is_debuffed(c) then
          c:setEnhancement('Default')
          c:punch()
          count = count + 1
        end
      end
      if count > 0 then
        poke.add(card, 'eaten', count)
        local n = poke.get(card, 'mult_mod') * count
        poke.add(card, 'mult', n)
        result:say('+' .. poke.text.num(n) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then
        result:add(plusMult(mult))
        result:say(poke.text.dict('poke_screech_ex', 'Screech!'), colors.MULT)
      end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'crobat', poke.get(card, 'eaten'), 16) end,
}

-- Oddish 043
poke.addPokemon {
  name = 'oddish', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 1, knockoff_starter = true,
  config = { mult = 1, mult2 = 5, rounds = 4, mult1 = 3 },
  attributes = { 'mult', 'rank', 'ace', 'three', 'five', 'seven', 'nine', 'round_evo' },
  vars = function(get) return { get('mult'), get('mult2'), get('rounds'), get('mult1') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or not poke.is_odd(step.card) then return end
      local _, value = pick3(state, poke.get(card, 'mult'), poke.get(card, 'mult1'), poke.get(card, 'mult2'))
      result:add(plusMult(value))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'gloom') end,
}

