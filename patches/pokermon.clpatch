-- Gliscor 472
local function gliscor_count(state, skip_selected)
  local suit = poke.round_target('gligar_suit') or 'Clubs'
  local n = 0
  for _, c in ipairs(state.cardsInHand or {}) do
    local info = c.lastInfo or {}
    if (c:isSuit(suit) or info.debuffed) and not (skip_selected and info.selected) then n = n + 1 end
  end
  return n
end
poke.addPokemon {
  name = 'gliscor',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Earth',
  gen = 4,
  config = { Xmult_multi = 0.25 },
  attributes = { 'suit', 'xmult' },
  vars = function(get, card, state)
    local suit = poke.round_target('gligar_suit') or 'Clubs'
    local count = (card and state and state.cardsInHand) and gliscor_count(state, true) or 0
    return { get('Xmult_multi'), suit, 1 + get('Xmult_multi') * count, colours = { poke.suit_colour(suit) } }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) then return end
      local n = gliscor_count(state, false)
      if n > 0 then result:add(xMult(1 + poke.get(card, 'Xmult_multi') * n)) end
    end,
  },
}

-- Mamoswine 473
poke.addPokemon {
  name = 'mamoswine',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Earth',
  gen = 4,
  config = { mult = 15, money = 4, num = 1, dem = 2 },
  attributes = { 'mult', 'enhancements', 'chance', 'economy' },
  vars = function(get, card, state) return { get('mult'), get('money'), poke.chance_num(get('num'), state), get('dem') } end,
  triggers = {
    onScore = function(card, state, step, result)
      local earn = poke.has_enhancement(step.card, 'm_stone', 'm_glass') and state:chance(poke.get(card, 'num') / poke.get(card, 'dem'))
      local scoring = step.hand.playedCards or {}
      if step.card == scoring[1] then
        local n = 0
        for _, c in ipairs(scoring) do if poke.has_enhancement(c, 'm_stone', 'm_glass') then n = n + 1 end end
        if n > 0 then result:add(plusMult(poke.get(card, 'mult') * n)) end
      end
      if earn then result:add(plusMoney(poke.ease_poke_dollars(card, '2mamoswine', poke.get(card, 'money'), true, state))) end
    end,
  },
}

-- Porygon-Z 474
poke.addPokemon {
  name = 'porygonz',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Colorless',
  gen = 4,
  config = { Xmult_mod = 0.1 },
  attributes = { 'energy_limit', 'energy', 'generation', 'xmult', 'passive' },
  vars = function(get) return { 1 + poke.consumables_used(poke.MOD_ID .. ':energy') * get('Xmult_mod'), get('Xmult_mod') } end,
  passives = { energy_limit = 3 },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.consumables_used(poke.MOD_ID .. ':energy') * poke.get(card, 'Xmult_mod')
      if x > 1 then result:add(xMult(x)) end
    end,
    onConsumableUsed = function(card, state, step, result)
      local c = step.card
      local t = c and ((c.lastInfo and c.lastInfo.type) or c:getConsumableType())
      if t ~= poke.MOD_ID .. ':energy' or state.freeConsumableSlots <= 0 then return end
      if state:randomFloat() < 1 / 256 then
        poke.create_consumeable('bird_energy', card)
      else
        poke.create_consumeable({ set = 'poke_energy' }, card)
      end
    end,
  },
}

-- Gallade 475
poke.addPokemon {
  name = 'gallade',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Fighting',
  gen = 4,
  config = { Xmult_mod = 0.5, e_level = 2 },
  attributes = { 'energy_count', 'item', 'xmult', 'hand_type', 'passive' },
  vars = function(get, card, state)
    local n = state and poke.energized_count(state, get('e_level')) or 0
    return { get('Xmult_mod'), 1 + get('Xmult_mod') * n, get('e_level') }
  end,
  onAdded = function(card, state) poke.holding(card, 'double_rainbow_energy', state) end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.get(card, 'Xmult_mod') * poke.energized_count(state, poke.get(card, 'e_level'))
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

-- Probopass 476: Rock (Stone) cards count as face cards while you own it (face_rule, lib/rules.lua).

poke.addPokemon {
