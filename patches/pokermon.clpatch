-- Pokemon jokers 151-180 (Mew to Flaaffy), ported from Pokermon pokejokers_06.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local function none_text() return poke.text.dict('poke_none', 'None') end

-- "one or more playing cards were added / destroyed": the game sends one event per card, so count one change per
-- player action (same hand, discard, consumable use and moment).
local function first_of_batch(card, key, state)
  local ds = card:getDataStore()
  local k = table.concat({ state.round or 0, state.handsPlayed or 0, state.discardsUsed or 0, state.phase or '',
    (state.gameCardsUsed or 0) + (state.fruitCardsUsed or 0), state.money or 0 }, ':')
  local now = cardlike.time() or 0
  if ds:get(key) == k and math.abs(now - (ds:get(key .. '_t') or -100)) < 1.5 then return false end
  ds:set(key, k)
  ds:set(key .. '_t', now)
  return true
end

-- Chikorita line: every card held at the end of the round after the first `skip` cards earns money.
local function held_money_after(card, state, result, skip)
  for i, c in ipairs(state.cardsInHand or {}) do
    if i > skip and not c:getDebuffState() then
      local earned = poke.ease_poke_dollars(card, 'chikorita', poke.get(card, 'money'), true, state)
      result:add(plusMoney(earned))
      result:say('$' .. poke.text.num(earned), colors.MONEY, c)
    end
  end
end

-- Totodile line: gains Points for each card played this round, resets at the end of the round.
local totodile_triggers = {
  beforeAllCardsScored = function(card, state, step, result)
    if step.copiedBy then return end
    poke.add(card, 'chips', poke.get(card, 'chip_mod') * #step.hand.allCards)
    result:say('Upgrade!', colors.CHIPS)
  end,
  afterAllCardsScored = function(card, state, step, result)
    local chips = poke.get(card, 'chips')
    if chips > 0 then result:add(plusChips(chips)) end
  end,
  afterRound = function(card, state, step, result)
    if step.copiedBy then return end
    poke.set(card, 'chips', 0)
    result:say('Reset', colors.CHIPS)
  end,
}

-- Cyndaquil line: +Mult for each discard left.
local function cyndaquil_score(card, state, step, result)
  local d = state.discardsLeft or 0
  if d > 0 then result:add(plusMult(poke.get(card, 'mult') * d)) end
end

-- Foresight Pokemon: each Foreseen card gives its Points.
local function scry_score(card, state, step, result)
  for _, c in ipairs(poke.scry.cards(state)) do
    if not (c.lastInfo or {}).debuffed then
      local chips = poke.total_chips(c)
      if chips ~= 0 then result:add(plusChips(chips)) end
    end
  end
end
-- Mareep line: gains X Mult when cards are added, loses X Mult when cards are destroyed.
local mareep_triggers = {
  afterAllCardsScored = function(card, state, step, result)
    local x = poke.get(card, 'Xmult')
    if x >= 0.01 then result:add(xMult(x)) end
  end,
  onCardsAdded = function(card, state, step, result)
    if step.copiedBy or not first_of_batch(card, 'j06_added', state) then return end
    local x = poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
    result:say('X' .. poke.text.num(x) .. ' Mult', colors.MULT)
  end,
  onCardsRemoved = function(card, state, step, result)
    if step.copiedBy or not first_of_batch(card, 'j06_removed', state) then return end
    local minus = poke.get(card, 'Xmult_minus')
    poke.add(card, 'Xmult', -minus)
    result:say('-X' .. poke.text.num(minus) .. ' Mult', colors.MULT)
  end,
}

-- Natu line: Fruit cards level up their hand one more time.
local function natu_consumable(card, state, step, result)
  local info = step.card and (step.card.lastInfo or step.card:info()) or {}
  if info.type ~= 'fruit' then return end
  local hand = poke.HAND_OF_FRUIT[info.consumable or '']
  if not hand then return end
  state:upgradeHand(hand, 1)
  result:say('Upgrade!', colors.ORANGE)
end

---------------------------------------------------------------------------
-- Pokemon
---------------------------------------------------------------------------

-- Mew 151: at the end of the shop create an Inverted Game, Admin or Item card; 15% for an Inverted joker instead.
poke.addPokemon {
  name = 'mew', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Psychic', gen = 1,
  config = { percent = 15 },
  attributes = { 'generation', 'tarot', 'spectral', 'item', 'joker' },
  vars = function(get) return { get('percent') } end,
  triggers = {
    onShopExit = function(card, state, step, result)
      -- the odds cannot be increased: a plain roll, not state:chance
      if state:randomFloat() < poke.get(card, 'percent') / 100 then
        local r = state:randomFloat()
        local rarity = r < 0.7 and 'Common' or (r < 0.95 and 'Uncommon' or 'Rare')
        local joker = cardlike.createJoker(rarity, { edition = 'Inverted' })
        if joker then joker:popup('+1 Joker', colors.CHIPS) end
      else
        local set = poke.random_element({ 'game', 'admin', 'poke_item' }, state)
        poke.create_consumeable({ set = set, edition = 'e_negative' })
      end
      card:punch()
    end,
  },
}

-- Chikorita 152: +1 hand size. Every card held beyond the fourth earns $1 at the end of the round.
poke.addPokemon {
  name = 'chikorita', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 2, starter = true,
  config = { money = 1, h_size = 1, rounds = 5 },
  attributes = { 'starter', 'hand_size', 'passive', 'economy', 'round_evo' },
  vars = function(get) return { get('h_size'), get('money'), get('rounds') } end,
  passives = { hand_size = 'h_size' },
  triggers = {
    afterRound = function(card, state, step, result) held_money_after(card, state, result, 4) end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'bayleef') end,
}

-- Bayleef 153: +1 hand size. Every card held beyond the second earns $1 at the end of the round.
poke.addPokemon {
  name = 'bayleef', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Grass', gen = 2,
  config = { money = 1, h_size = 1, rounds = 5 },
  attributes = { 'starter', 'hand_size', 'passive', 'economy', 'round_evo' },
  vars = function(get) return { get('h_size'), get('money'), get('rounds') } end,
  passives = { hand_size = 'h_size' },
  triggers = {
    afterRound = function(card, state, step, result) held_money_after(card, state, result, 2) end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'meganium') end,
}

-- Meganium 154: +1 hand size. Every card held earns $1 at the end of the round.
poke.addPokemon {
  name = 'meganium', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 2,
  config = { money = 1, h_size = 1 },
  megas = { 'mega_meganium' },
  attributes = { 'starter', 'hand_size', 'passive', 'economy' },
  vars = function(get) return { get('h_size'), get('money') } end,
  passives = { hand_size = 'h_size' },
  triggers = {
    afterRound = function(card, state, step, result) held_money_after(card, state, result, 0) end,
  },
}

-- Mega Meganium 154-1: the first held card of each suit gives $2 and retriggers.
local function first_of_suit(card, state)
  return poke.has(poke.get_first_of_each_suit(state.cardsInHand or {}), card)
end
poke.addPokemon {
  name = 'mega_meganium', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Grass', gen = 2,
  blueprint_compat = false,
  config = { money_mod = 2, retriggers = 1 },
  attributes = { 'starter', 'economy', 'retrigger', 'suit' },
  vars = function(get) return { get('money_mod'), get('retriggers') } end,
  triggers = {
    onScoreInHand = function(card, state, step, result)
      if step.card:getDebuffState() or not first_of_suit(step.card, state) then return end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'mega meganium', poke.get(card, 'money_mod'), true, state)))
    end,
    repeatHeldCard = function(card, state, step, result)
      if first_of_suit(step.card, state) then return poke.get(card, 'retriggers') end
    end,
  },
}

-- Cyndaquil 155: +1 discard. +4 Mult for each discard left.
poke.addPokemon {
  name = 'cyndaquil', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Fire', gen = 2, starter = true,
