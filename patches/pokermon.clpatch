-- The shared Pokermon library table. Every lib file adds its functions to this one table, so the files can
-- call each other at run time without require cycles. Joker files get it with:
--   local poke = cardlike.require('lib.pokermon')
local P = {
  MOD_ID = 'pokermon',
  energy = {},
  sprites = {},
  scry = {},
  items = {},
  ui = {},
  text = {},
}
return P


== file lib/cardbonus.lua (75 lines)
-- Permanent bonuses on playing cards (Balatro card.ability.perma_*). Kept in the playing card's data store and
-- given with the cardBonuses filter and a round-end listener:
--   poke_perma_mult      +Mult when the card scores          (perma_mult)
--   poke_perma_x_mult    X(1 + value) Mult when it scores     (perma_x_mult)
--   poke_perma_x_chips   X(1 + value) Points when it scores   (perma_x_chips)
--   poke_perma_p_dollars +$ when it scores                   (perma_p_dollars)
--   poke_perma_h_mult    +Mult when held in hand             (perma_h_mult)
--   poke_perma_h_x_mult  X(1 + value) Mult when held         (perma_h_x_mult)
--   poke_perma_h_chips   +Points when held                   (perma_h_chips)
--   poke_perma_h_dollars +$ when held at the end of a round  (perma_h_dollars)
-- Permanent +Points use Cardlike's own card:addAdditionalPointValue (perma_bonus).
local P = cardlike.require('lib.base')

local KEYS = { mult = true, x_mult = true, x_chips = true, p_dollars = true, h_mult = true, h_x_mult = true, h_chips = true, h_dollars = true }

--- Add to a permanent bonus of a playing card: P.add_perma_bonus(card, 'x_mult', 0.5). kind 'chips' adds points.
function P.add_perma_bonus(card, kind, amount)
  if kind == 'chips' or kind == 'bonus' then
    card:addAdditionalPointValue(amount)
    return card:getAdditionalPointValue()
  end
  assert(KEYS[kind], 'unknown permanent bonus ' .. tostring(kind))
  local ds = card:getDataStore()
  local key = 'poke_perma_' .. kind
  local v = (ds:get(key) or 0) + amount
  ds:set(key, v)
  return v
end

function P.get_perma_bonus(card, kind)
  if kind == 'chips' or kind == 'bonus' then return card:getAdditionalPointValue() or 0 end
  return card:getDataStore():get('poke_perma_' .. kind) or 0
end

local function num(store, key)
  local v = store and store['poke_perma_' .. key]
  return type(v) == 'number' and v or 0
end

cardlike.filter('cardBonuses', function(list, card, held)
  if not card or not card.uid then return nil end
  local store = card.lastInfo and card.lastInfo.store
  if store == nil then
    local info = card:info()
    store = info and info.store
  end
  if not store then return nil end
  local add = {}
  if held then
    if num(store, 'h_chips') ~= 0 then add[#add + 1] = plusChips(num(store, 'h_chips')) end
    if num(store, 'h_mult') ~= 0 then add[#add + 1] = plusMult(num(store, 'h_mult')) end
    if num(store, 'h_x_mult') ~= 0 then add[#add + 1] = xMult(1 + num(store, 'h_x_mult')) end
  else
    if num(store, 'mult') ~= 0 then add[#add + 1] = plusMult(num(store, 'mult')) end
    if num(store, 'x_chips') ~= 0 then add[#add + 1] = xChips(1 + num(store, 'x_chips')) end
    if num(store, 'x_mult') ~= 0 then add[#add + 1] = xMult(1 + num(store, 'x_mult')) end
    if num(store, 'p_dollars') ~= 0 then add[#add + 1] = plusMoney(num(store, 'p_dollars')) end
  end
  if #add == 0 then return nil end
  local out = {}
  for _, b in ipairs(list or {}) do out[#out + 1] = b end
  for _, b in ipairs(add) do out[#out + 1] = b end
  return out
end)

cardlike.on('afterRound', function(state)
  for _, c in ipairs(state.cardsInHand or {}) do
    local m = num((c.lastInfo or {}).store, 'h_dollars')
    if m ~= 0 and not c:getDebuffState() then
      state:mutateMoney(m)
      c:popup('$' .. P.text.num(m), colors.MONEY)
    end
  end
end)


