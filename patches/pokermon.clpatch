== file jokers/pokejokers_30.lua (217 lines)
-- Pokermon jokers 871-900: Dreepy, Drakloak, Dragapult, Dreepy Dart, Wyrdeer, Kleavor.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local function has_straight_flush(step)
  local c = step.hand and step.hand.contains or {}
  return c.STRAIGHT_FLUSH or c.ROYAL_FLUSH
end

-- Sum of the sell values of your jokers (0 outside a run).
local function total_sell_value(state)
  local total = 0
  for _, j in ipairs(state and state.jokers or {}) do total = total + (j:getSellValue() or 0) end
  return total
end

-- Every joker gains sell value.
local function add_sell_value_to_jokers(state, amount, except)
  for _, j in ipairs(state.jokers or {}) do
    if j ~= except then j:addSellValue(amount) end
  end
end

-- Dreepy and Dreepy Dart when sold: +$ sell value on every joker, and every card in hand takes the suit of the
-- leftmost card in hand.
local function dreepy_sold(card, state, result)
  add_sell_value_to_jokers(state, poke.get(card, 'money'), card)
  local hand = state.cardsInHand or {}
  local first = hand[1]
  if first and not (first.lastInfo or {}).noRank then
    local suit = first:getSuit()
    for _, c in ipairs(hand) do
      if c:getSuit() ~= suit then
        c:setSuit(suit)
        c:punch()
      end
    end
  end
  result:say(poke.text.dict('k_val_up', 'Value Up!'), colors.MONEY)
end

---------------------------------------------------------------------------
-- Dreepy 885
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'dreepy', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 8,
  blueprint_compat = false,
  config = { money = 1, straight_flush_played = 0 },
  attributes = { 'sell_value', 'joker', 'suit', 'condition_evo' },
  vars = function(get) return { get('money') } end,
  triggers = {
    onSold = function(card, state, step, result) dreepy_sold(card, state, result) end,
    afterAllCardsScored = function(card, state, step, result)
      if has_straight_flush(step) then poke.add(card, 'straight_flush_played', 1) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'drakloak', poke.get(card, 'straight_flush_played'), 1)
  end,
}

---------------------------------------------------------------------------
-- Drakloak 886
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'drakloak', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Psychic', gen = 8,
  config = { money = 1, total_sell_value = 0, Xmult = .01 },
  evo_rqmt = 40,
  attributes = { 'xmult', 'sell_value', 'joker', 'hand_type', 'condition_evo' },
  vars = function(get, card, state)
    local total = card and total_sell_value(state) or get('total_sell_value')
    return { get('money'), total, 40, get('Xmult'), 1 + total * get('Xmult') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if has_straight_flush(step) then
        add_sell_value_to_jokers(state, poke.get(card, 'money'))
        result:say(poke.text.dict('k_val_up', 'Value Up!'), colors.MONEY)
      end
      local total = total_sell_value(state)
      poke.set(card, 'total_sell_value', total)
      result:add(xMult(1 + total * poke.get(card, 'Xmult')))
    end,
  },
  evolution = function(card, state)
    local total = total_sell_value(state)
    poke.set(card, 'total_sell_value', total)
    return poke.scaling_evo(card, state, 'dragapult', total, 40)
  end,
}

---------------------------------------------------------------------------
-- Dragapult 887
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'dragapult', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Psychic', gen = 8,
  config = { money = 2, total_sell_value = 0, Xmult = .03 },
  attributes = { 'xmult', 'sell_value', 'joker', 'hand_type', 'generation' },
  vars = function(get, card, state)
    local total = card and total_sell_value(state) or get('total_sell_value')
    return { get('money'), get('Xmult'), 1 + total * get('Xmult') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if has_straight_flush(step) and not state:hasJoker(poke.id('dreepy_dart')) then
        for _ = 1, 2 do cardlike.createJoker(poke.id('dreepy_dart'), { edition = 'Inverted' }) end
        result:say(poke.text.dict('poke_darts_ex', 'Darts!'), colors.MULT)
      end
      local total = total_sell_value(state)
      poke.set(card, 'total_sell_value', total)
      result:add(xMult(1 + total * poke.get(card, 'Xmult')))
    end,
  },
}

---------------------------------------------------------------------------
-- Dreepy Dart (made by Dragapult, always Inverted, never in the shop)
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'dreepy_dart', rarity = 'poke_safari', cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 8,
  aux_poke = true,
  blueprint_compat = false,
  config = { money = 1, suit = 'Spades' },
  attributes = { 'sell_value', 'joker', 'suit' },
  in_pool = function() return false end,
  vars = function(get) return { get('money'), get('suit') } end,
  onAdded = function(card, state)
    local ds = card:getDataStore()
    if not ds:get('poke_dart_made') then
      ds:set('poke_dart_made', true)
      if card:getEdition() ~= 'Inverted' then card:setEdition('Inverted') end
    end
  end,
  triggers = {
    onSold = function(card, state, step, result) dreepy_sold(card, state, result) end,
  },
}

---------------------------------------------------------------------------
-- Wyrdeer 899: Foresight. The highest ranked Foreseen card adds double its rank to Mult. Each played hand gives
-- +1 Foresight until the end of the round.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'wyrdeer', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Psychic', gen = 8,
  config = { scry = 2, scry_plus = 1, scry_added = 0 },
  attributes = { 'foresight', 'mult', 'hands', 'reset' },
  vars = function(get) return { get('scry'), get('scry_plus') } end,
  onAdded = function(card, state)
    poke.scry.add(poke.get(card, 'scry') + poke.get(card, 'scry_added'))
  end,
  onRemoved = function(card, state)
    poke.scry.add(-(poke.get(card, 'scry') + poke.get(card, 'scry_added')))
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      poke.scry.add(poke.get(card, 'scry_plus'))
      poke.add(card, 'scry_added', poke.get(card, 'scry_plus'))
    end,
    afterAllCardsScored = function(card, state, step, result)
      local highest, best
      for _, c in ipairs(poke.scry.cards(state)) do
        local info = c.lastInfo or {}
        if not info.noRank then
          local r = info.rank or c:getRank()
          if not highest or r > highest then highest, best = r, c end
        end
      end
      if best and not best:getDebuffState() then
        result:add(plusMult(2 * best:getBasePointValue()))
      end
    end,
    afterRound = function(card, state, step, result)
      local added = poke.get(card, 'scry_added')
      if added > 0 then
        poke.scry.add(-added)
        poke.set(card, 'scry_added', 0)
        result:say('Reset', colors.PURPLE)
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Kleavor 900: when a blind starts, destroy the joker to the right and gain +Mult. If it was not Common, add a Rock
-- card with Luna, Holo or Chroma to the deck.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'kleavor', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Earth', gen = 8,
  config = { mult = 0, mult_mod = 4 },
  attributes = { 'destroy_card', 'mult', 'generation', 'enhancements', 'scaling' },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local jokers = state.jokers or {}
      local right
      for i, j in ipairs(jokers) do
        if j == card then right = jokers[i + 1] break end
      end
      if not right or right:isLocked() then return end
      if right:getRarity() ~= 'Common' then
        cardlike.addPlayingCard({ enhancement = 'Rock', edition = poke.random_edition(state) }, { area = 'deck' })
      end
      right:destroy()
      poke.add(card, 'mult', poke.get(card, 'mult_mod'))
      result:say('+' .. poke.text.num(poke.get(card, 'mult')) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
}


