-- Ledyba 165: +1 Mult for every 5 cards left in the deck.
local function deck_left(state)
  if not state then return 0 end
  return state.cardsLeftInDeck or #(state.unDrawnCards or {})
end
poke.addPokemon {
  name = 'ledyba', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 2,
  config = { mult = 1, rounds = 4 },
  attributes = { 'mult', 'round_evo' },
  vars = function(get, card, state) return { get('mult'), get('rounds'), get('mult') * math.floor(deck_left(state) / 5) } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local m = poke.get(card, 'mult') * math.floor(deck_left(state) / 5)
      if m ~= 0 then result:add(plusMult(m)) end
