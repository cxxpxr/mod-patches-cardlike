}

-- Roselia 315
poke.addPokemon {
  name = 'roselia', rarity = 2, cost = 7, gen = 3, stage = 'Basic', ptype = 'Grass',
  item_req = 'shinystone',
  config = { retriggers = 2 },
  attributes = { 'rank', 'ace', 'three', 'five', 'seven', 'nine', 'retrigger', 'enhancements', 'item_evo' },
  vars = function(get) return { get('retriggers') } end,
  triggers = {
    repeatCard = function(card, state, step, result)
      if poke.hands_played_this_round() > 0 then return end
      if step.card == step.hand.playedCards[1] and poke.is_odd(step.card) then
        return poke.get(card, 'retriggers')
      end
    end,
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or poke.hands_played_this_round() > 0 then return end
      local first = step.hand.playedCards[1]
      if first and not poke.is_odd(first) then
        first:setEnhancement(poke.ENHANCEMENT_IDS.m_poke_seed)
        first:punch()
      end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'roserade') end,
}

