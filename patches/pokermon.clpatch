}

-- Xatu 178: Fruit cards level up their hand one more time. Opening a Fruit Pack creates the Fruit card of the last
-- hand played (must have room).
poke.addPokemon {
  name = 'xatu', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Psychic', gen = 2,
  config = {},
  attributes = { 'planet' },
  vars = function(get)
    local h = poke.last_hand()
    return { h and h.name or none_text() }
  end,
  triggers = {
    onConsumableUsed = natu_consumable,
    onPackOpened = function(card, state, step, result)
      local info = step.card and (step.card.lastInfo or step.card:info()) or {}
      local id = tostring(info.consumable or '')
      if not (id:match('^pack_fruit') or tostring(info.name or ''):match('^Fruit Pack')) then return end
      local h = poke.last_hand()
      local fruit = h and poke.FRUIT_OF_HAND[h.type]
      if not fruit or (state.freeConsumableSlots or 0) < 1 then return end
      local c = cardlike.createConsumable(fruit)
      if c then c:popup('+1 Fruit Card', colors.PURPLE) end
    end,
  },
}

-- Mareep 179: gains X0.1 Mult when cards are added to the deck, loses X0.1 when cards are destroyed. Evolves at X1.5.
