-- Challenges (original challenges/pokechallenges.lua). Custom rules become run modifiers (poke.set_modifier) in
-- onRunStart; content/rules.lua enforces them. Pokemon jokers are named with poke.id: a joker that is not loaded
-- (for example while the Pokemon files are missing) is skipped by the game.
local poke = cardlike.require('lib.pokermon')
local loc = cardlike.require('lib.data.loc')
local decks = cardlike.require('content.backs')

local COLOR = '#0064b2'

local function cname(key, fallback) return loc.challenge_names['c_poke_' .. key] or fallback end

-- Rule text from the original v_text entries, as plain text.
local function rule(key, fallback)
  local lines = loc.v_text['ch_c_' .. key]
  if type(lines) ~= 'table' then return fallback end
  local s = table.concat(lines, ' '):gsub('{[^}]*}', '')
  return poke.text.terms(s)
end

local R = {
  no_shop_jokers = 'Jokers in the shop cannot be bought',
  all_eternal = 'All Jokers are Locked',
  no_interest = 'Earn no Interest',
  no_reward = 'Blinds give no reward money',
  no_extra_hand_money = 'Extra hands no longer earn money',
  no_reward_small = 'Beta Blinds give no reward money',
  no_reward_big = 'Alpha Blinds give no reward money',
}

local function pid(name) return poke.id(name) end
local function locked(name, edition) return { id = pid(name), locked = true, edition = edition } end

-- Fool packs (Balatro Buffoon packs) of the game, for the bans.
local function fool_packs()
  local out = {}
  for _, p in ipairs(cardlike.listContent('pack') or {}) do
    if type(p.name) == 'string' and p.name:find('Fool') then out[#out + 1] = p.id end
  end
  return out
end

local function list(...)
  local out = {}
  for _, t in ipairs({ ... }) do for _, v in ipairs(t) do out[#out + 1] = v end end
  return out
end

-- Common bans (Balatro Judgement, Wraith, The Soul, the Poke Balls, Antimatter, Buffoon packs and joker pins).
local BALLS = { 'pokermon:pokeball', 'pokermon:greatball', 'pokermon:ultraball', 'pokermon:masterball' }
local NO_JOKER_SOURCES = { 'cart_card_2', 'admin_card_9', 'admin_card_17', 'ticket_23' }
local JOKER_PINS = { 'pin_1', 'pin_0', 'pin_6', 'pin_7', 'pin_2', 'pin_3', 'pin_16', 'pin_10',
  'pokermon:shiny_tag', 'pokermon:stage_one_tag', 'pokermon:safari_tag', 'pokermon:starter_tag' }

-- Blinds a challenge bans (Cardlike has no blind ban: content/rules.lua swaps them through the bossBlind filter).
local function ban_blinds(ids)
  local set = {}
  for _, id in ipairs(ids) do set[poke.MOD_ID .. ':' .. id] = true end
  poke.set_modifier('banned_blinds', set)
end

cardlike.addChallenge {
  id = 'nuzlocke',
  name = cname('nuzlocke', 'Nuzlocke'),
  color = COLOR,
  rules = { R.no_shop_jokers, R.all_eternal, rule('poke_add_joker_slots'), rule('poke_nuzlocke') },
  jokerSlots = 1,
  banned = list(NO_JOKER_SOURCES, BALLS, fool_packs(), JOKER_PINS, {
    'joker_prado', 'joker_fall', 'joker_mona_lisa', 'joker_extinguish', 'joker_matryoshka_dolls', 'joker_bloxy_cola',
    'joker_air_hokcey', 'joker_pool_table', 'joker_countdown', 'joker_determination', 'joker_blank_joker',
    pid('gastly'), pid('haunter'), pid('gengar'), pid('koffing'), pid('weezing'), pid('ditto'), pid('mewtwo'),
    pid('scyther'), pid('scizor'), pid('jelly_donut'),
  }),
  onRunStart = function(state)
    poke.set_modifier('no_shop_jokers', true)
    poke.set_modifier('all_eternal', true)
    poke.set_modifier('add_joker_slots', true)
    poke.set_modifier('nuzlocke', true)
    ban_blinds({ 'mirror' })
  end,
}

cardlike.addChallenge {
