-- Pokemon jokers 241-269 (original pokejokers_09.lua): Miltank to Dustox.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local DEFAULT_RANKS = { { value = 'Ace', id = 14 }, { value = 'King', id = 13 }, { value = 'Queen', id = 12 } }

-- Natures: Balatro picks a joker's nature (target ranks or suit) when the card is created. The library runs the def's
-- nature function when the card appears (see P.set_nature); evolution keeps the targets.

--- Whether a playing card's rank is one of the target ranks.
local function is_target_rank(card, targets)
  local r = poke.rank_of(card)
  if not r then return false end
  for _, t in ipairs(targets or {}) do if t.id == r then return true end end
  return false
end

local function nature_suit(get) return ((get('targets') or {})[1] or {}).suit or 'Spades' end

---------------------------------------------------------------------------
-- Miltank 241
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'miltank', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Colorless', gen = 2, blueprint_compat = false,
  config = { money = 4 },
  attributes = { 'types', 'joker', 'economy' },
  vars = function(get, card, state)
    return { get('money'), get('money') * #poke.find_pokemon_type('Colorless', nil, nil, state) }
  end,
  dollarsAtRoundEnd = function(card, state)
    local earned = poke.get(card, 'money') * #poke.find_pokemon_type('Colorless', nil, nil, state)
    if earned > 0 then return poke.ease_poke_dollars(card, 'miltank', earned, true, state) end
    return 0
  end,
}

---------------------------------------------------------------------------
-- Blissey 242: the first 2 successful Lucky (Paperback) triggers each round add a Chroma copy of the card to hand.
---------------------------------------------------------------------------

poke.addPokemon {
  name = 'blissey', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Colorless', gen = 2,
  enhancement_gate = 'Paperback',
  config = { limit = 2, triggers = 0 },
  attributes = { 'enhancements', 'generation' },
  vars = function(get) return { get('limit'), get('triggers') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.enhancement_triggered('Paperback') or step.card:getEnhancement() ~= 'Paperback' then return end
      if poke.get(card, 'triggers') >= poke.get(card, 'limit') then return end
      local copy = step.card:copy('hand')
      if copy then copy:setEdition('Chroma') end
      if not step.copiedBy then poke.add(card, 'triggers', 1) end
      result:say('Copied!', colors.CHIPS)
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'triggers', 0) end
    end,
  },
}

---------------------------------------------------------------------------
-- Raikou 243
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'raikou', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Lightning', gen = 2, blueprint_compat = false,
  config = { money = 9 },
  attributes = { 'modify_card', 'rank', 'economy', 'hands' },
  vars = function(get) return { get('money') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      if #step.hand.allCards ~= 1 or state.handsPlayed ~= 1 or #(step.held or {}) == 0 then return end
      local played = step.hand.playedCards[1] or step.hand.allCards[1]
      local rank = played and poke.rank_of(played)
      if rank then
        local held = {}
        for _, c in ipairs(step.held) do held[#held + 1] = c end
        poke.shuffle(held, state)
        for i = 1, math.min(3, #held) do
          held[i]:setRank(rank)
          held[i]:punch()
        end
      end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'raikou', poke.get(card, 'money'), true, state)))
    end,
  },
}

---------------------------------------------------------------------------
-- Entei 244: if the first discard of the round is exactly 4 cards, destroy one of them and gain X0.4 Mult.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'entei', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Fire', gen = 2,
  config = { Xmult = 1, Xmult_mod = 0.4 },
  attributes = { 'discard', 'destroy_card', 'xmult', 'scaling' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    onDiscardCard = function(card, state, step, result)
      if step.copiedBy or state.discardsUsed ~= 1 then return end
      local cards = step.discardedCards or {}
      if #cards ~= 4 then return end
      local uids = {}
      for i, c in ipairs(cards) do uids[i] = tostring(c.uid) end
      local key = state.round .. ':' .. table.concat(uids, ',')
      local pick = poke.get(card, 'entei_pick')
      if type(pick) ~= 'table' or pick.key ~= key then
        pick = { key = key, uid = poke.random_element(cards, state).uid }
        poke.set(card, 'entei_pick', pick)
      end
      if step.card.uid ~= pick.uid then return end
      local x = poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(x) .. ' Mult', colors.MULT)
      return true
    end,
  },
}

