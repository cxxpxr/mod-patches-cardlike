  config = { Xmult_mod = 0.5, rounds = 4 },
  vars = function(get, card, state)
    return { get('Xmult_mod'), 1 + math.max(0, get('Xmult_mod') * (state and state.handsLeft or 0)), get('rounds') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.get(card, 'Xmult_mod') * math.max(0, state.handsLeft)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
  -- Only rounds without a discard count.
  evolution = function(card, state)
    if (state.discardsUsed or 0) > 0 then return false end
    return poke.level_evo(card, state, 'slaking')
  end,
}

