-- Dodrio 085
poke.addPokemon {
  name = 'dodrio', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Colorless', gen = 1,
  config = { mult = 7, h_size = 1 },
  attributes = { 'mult', 'face', 'hand_size' },
  vars = function(get) return { get('mult'), get('h_size') } end,
  triggers = {
    onScore = function(card, state, step, result)
      for _, uid in ipairs(first_faces(step.hand.playedCards, 3)) do
        if uid == step.card.uid then result:add(plusMult(poke.get(card, 'mult'))) return end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local cards = step.hand.playedCards or {}
      if #cards ~= 3 or #first_faces(cards, 3) ~= 3 then return end
      -- +hand size for this round only (Balatro temp_handsize)
      state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
      result:say('+' .. poke.get(card, 'h_size') .. ' Hand Size', colors.ORANGE)
    end,
  },
}

-- Seel and Dewgong: a random stamp on the first scoring card of the first hand of the round.
local function stamp_first_card(state, step)
  local first = (step.hand.playedCards or {})[1]
  if not first then return false end
  first:setStamp(poke.random_stamp(state))
  first:punch()
  return true
end

-- Seel 086
poke.addPokemon {
  name = 'seel', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Water', gen = 1,
  blueprint_compat = false,
  config = { num = 1, dem = 2, rounds = 5 },
  attributes = { 'chance', 'modify_card', 'seals', 'hands', 'round_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem, get('rounds') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or state.handsPlayed ~= 1 then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) and stamp_first_card(state, step) then
        result.activated = true
      end
