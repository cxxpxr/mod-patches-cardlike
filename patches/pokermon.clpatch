---------------------------------------------------------------------------
-- Kecleon 352: copies the type of the joker to its right (as a Tera type). Its art does not change.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'kecleon', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Colorless', gen = 3,
  config = { Xmult = 2 },
  attributes = { 'types', 'joker', 'xmult' },
  vars = function(get, card, state)
    local t = card and poke.get_type(card) or 'Colorless'
    local colour = poke.colours[t:lower()] or colors.GREY
    return { get('Xmult'), t, colours = { colour, colour } }
  end,
  onAdded = function(card, state) kecleon_sync(card, state) end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result) kecleon_sync(card, state) end,
    afterAllCardsScored = function(card, state, step, result)
      local t = kecleon_sync(card, state)
      if #poke.find_pokemon_type(t, nil, nil, state) >= 3 then result:add(xMult(poke.get(card, 'Xmult'))) end
    end,
  },
}

local function sync_all_kecleon(state)
  if not state or not state.jokers then return end
  local id = poke.id('kecleon')
  for _, j in ipairs(state.jokers) do
    if j:getJokerDef() == id then kecleon_sync(j, state) end
  end
end
for _, ev in ipairs({ 'onCardPlaced', 'onCardObtained', 'onCardSold', 'onRoundStart', 'onShopEnter', 'onShopExit' }) do
  cardlike.on(ev, function(state) sync_all_kecleon(state) end)
end

