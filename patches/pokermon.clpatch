-- Nidoqueen 031
poke.addPokemon {
  name = 'nidoqueen', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Dark', gen = 1,
  config = { chips = 90, h_size = 1 },
  attributes = { 'hand_size', 'passive', 'chips', 'rank', 'queen' },
  vars = function(get) return { get('chips'), get('h_size') } end,
  passives = { hand_size = 'h_size' },
  triggers = {
    onScoreInHand = function(card, state, step, result)
      held_rank_bonus(step, result, 12, plusChips(poke.get(card, 'chips')))
    end,
  },
}

