  triggers = {
    onPackOpened = function(card, state, step, result) rotom_pack_item(card, state, result) end,
    -- first discard of the round with exactly 2 cards: both become Multicards (Mult cards)
    onDiscard = function(card, state, step, result)
      if step.copiedBy or state.discardsUsed ~= 1 then return end
      local cards = step.discardedCards or {}
      if #cards ~= 2 then return end
      poke.convert_cards(cards, { mod_conv = 'm_mult' }, state)
      result:say('Mult!', colors.MULT)
    end,
  },
}

poke.addPokemon {
