local function disable_boss(card, state)
  if state.blind and state.blind.boss and not state.bossDisabled then
    state:disableBoss()
    card:popup('Boss Blind disabled', colors.ORANGE)
    return true
  end
  return false
end

poke.addPokemon {
  name = 'mega_gyarados', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Water', gen = 1,
  config = { Xmult = 3 },
  vars = function(get) return { get('Xmult') } end,
  attributes = { 'xmult', 'boss_blind' },
  onAdded = function(card, state)
    -- Mega Evolving during a boss blind disables it at once
    if state.phase == 'play' or state.phase == 'scoring' then disable_boss(card, state) end
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      disable_boss(card, state)
    end,
  },
}

