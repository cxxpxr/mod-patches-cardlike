-- Victreebel 071
poke.addPokemon {
  name = 'victreebel', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 1,
  config = { chips = 24, retriggers = 1, retrigger_max = 4, round_retriggers = 0 },
  megas = { 'mega_victreebel' },
  attributes = { 'chips', 'rank', 'two', 'four', 'six', 'eight', 'ten', 'retrigger' },
  vars = function(get)
    return { get('chips'), get('retrigger_max'), math.max(0, get('retrigger_max') - get('round_retriggers')) }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_even(step.card) then result:add(plusChips(poke.get(card, 'chips'))) end
    end,
    repeatCard = function(card, state, step, result)
      if step.card:getDebuffState() or not poke.is_even(step.card) then return end
      if poke.get(card, 'round_retriggers') >= poke.get(card, 'retrigger_max') then return end
      if not step.copiedBy then poke.add(card, 'round_retriggers', 1) end
      result:say('Again!', colors.ORANGE)
      return poke.get(card, 'retriggers')
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'round_retriggers', 0) end
    end,
  },
}

-- Mega Victreebel 071-1
poke.addPokemon {
  name = 'mega_victreebel', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Grass', gen = 1,
  config = { retriggers = 1 },
  attributes = { 'rank', 'two', 'four', 'six', 'eight', 'ten', 'retrigger' },
  vars = function(get) return { get('retriggers') } end,
  -- Holding Medium, which is Cardlike's OPTION (admin_card_11).
  onAdded = function(card, state) poke.holding(card, 'admin_card_11', state) end,
  triggers = {
    repeatCard = function(card, state, step, result)
      if step.card:getDebuffState() then return end
      local n = 0
      if poke.is_even(step.card) then n = n + poke.get(card, 'retriggers') end
      local stamp = step.card:getStamp()
      if stamp == 'Game Stamp' or stamp == 'Game' then n = n + poke.get(card, 'retriggers') end
      if n > 0 then
        result:say('Again!', colors.ORANGE)
        return n
      end
    end,
  },
}

