---------------------------------------------------------------------------
-- Sandshrew line: Points for each Fragile card in the deck
---------------------------------------------------------------------------

local function fragile_count(state)
  if not state or state.allCards == nil then return 0 end
  local n = 0
  for _, c in ipairs(state.allCards) do
    if poke.has_enhancement(c, 'm_glass') then n = n + 1 end
  end
  return n
end

local function sandshrew_score(card, state, step, result)
  local chips = poke.get(card, 'chip_mod') * fragile_count(state)
  if chips > 0 then result:add(plusChips(chips)) end
end

-- Sandshrew 027
poke.addPokemon {
  name = 'sandshrew', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Earth', gen = 1,
  -- the original gate 'm_glass' (Fragile is its Cardlike id)
  enhancement_gate = 'Fragile',
  config = { rounds = 4, chip_mod = 25, sandshrew_tally = 0 },
  attributes = { 'chips', 'enhancements', 'full_deck', 'round_evo' },
  vars = function(get, card, state)
    return { get('rounds'), get('chip_mod'), get('chip_mod') * fragile_count(state) }
  end,
  triggers = { afterAllCardsScored = sandshrew_score },
  evolution = function(card, state) return poke.level_evo(card, state, 'sandslash') end,
}

-- Sandslash 028
poke.addPokemon {
  name = 'sandslash', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Earth', gen = 1,
  enhancement_gate = 'Fragile',
  config = { chip_mod = 40, sandshrew_tally = 0, num = 1, dem = 3 },
  attributes = { 'chips', 'enhancements', 'full_deck', 'discard', 'chance', 'modify_card' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('chip_mod'), get('chip_mod') * fragile_count(state), num, dem }
  end,
  triggers = {
    afterAllCardsScored = sandshrew_score,
    onDiscardCard = function(card, state, step, result)
      if step.copiedBy then return end
      local e = step.card:getEnhancement()
      if e == nil or e == 'Default' then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        poke.convert_cards({ step.card }, { mod_conv = 'm_glass' }, state)
      end
    end,
  },
}

