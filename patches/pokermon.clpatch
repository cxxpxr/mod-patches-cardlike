-- Weird Tree (aux form of Sudowoodo): a Grass Tera type when it appears; transforms into Sudowoodo at the end of the
-- round when it is not Grass or you have a Water type.
poke.addPokemon {
  name = 'weird_tree', rarity = 3, cost = 6, stage = 'Basic', ptype = 'Earth', gen = 2,
  blueprint_compat = false,
  aux_poke = true,
  attributes = { 'types' },
  onAdded = function(card, state)
    if not poke.get(card, 'weird_tree_init') then
      poke.set(card, 'weird_tree_init', true)
      poke.apply_type_sticker(card, 'Grass', state)
    end
  end,
  in_pool = function(state)
    return not (poke.owns(state, 'sudowoodo') or poke.owns(state, 'bonsly'))
  end,
  evolution = function(card, state)
    local ready = (not poke.is_type(card, 'Grass')) or poke.find_cards_by_ptype(card, 'Water', true, state) > 0
    return poke.scaling_evo(card, state, 'sudowoodo', ready and 1 or 0, 1, poke.text.dict('poke_transform_success', 'Transformed!'))
  end,
}

-- Politoed 186
poke.addPokemon {
  name = 'politoed', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Water', gen = 2,
  config = { retriggers = 1 },
  attributes = { 'retrigger', 'suit', 'types', 'joker' },
  vars = function(get, card, state)
    local suit = poke.run.poli_suit or 'Spades'
    local water = state and #poke.find_pokemon_type('Water', nil, nil, state) or 0
    return { get('retriggers'), poke.suit_name(suit), 'Spades', 'Hearts', 'Clubs', 'Diamonds', get('retriggers') + water,
      colours = { poke.suit_colour(suit) } }
  end,
  triggers = {
    repeatCard = function(card, state, step, result)
      local suit = poke.run.poli_suit or 'Spades'
      for _, c in ipairs(step.hand.playedCards or {}) do
        if c:isSuit(suit) then
          if c == step.card then
            return poke.get(card, 'retriggers') + #poke.find_pokemon_type('Water', nil, nil, state)
          end
          return nil
        end
      end
    end,
  },
}

-- Hoppip 187, Skiploom 188, Jumpluff 189: the first 2 / 3 / all discarded cards become Seed cards, then the joker
-- destroys itself.
local function seed_discard(count, message_key, message)
  return function(card, state, step, result)
    if step.copiedBy then return end
    local cards = step.discardedCards or {}
    if #cards == 0 then return end
    local target = {}
    for i, c in ipairs(cards) do
      if not count or i <= count then target[#target + 1] = c end
    end
    poke.convert_cards(target, { mod_conv = 'm_poke_seed' }, state)
    result:say(poke.text.dict(message_key, message), colors.GREEN)
    result:destroySelf()
  end
end

