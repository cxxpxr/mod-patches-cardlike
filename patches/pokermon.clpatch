    each_sel(ctx, function(c) c:setEnhancement('Fragile') end)
    each_sel(ctx, function(c) if ctx.state:chance(1 / 4) then c:destroy() end end)
  end,
}

-- Linking Cord: of 2 selected cards, the left one goes up a rank and the right one down a rank.
item {
