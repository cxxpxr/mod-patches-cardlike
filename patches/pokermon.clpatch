}

-- Chandelure 609: each joker with $1 sell value gives X1.3 Mult. Adds its sell value to Mult.
poke.addPokemon {
  name = 'chandelure',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Fire',
  gen = 5,
  config = { Xmult_multi = 1.3 },
  attributes = { 'xmult', 'mult', 'sell_value', 'joker' },
  vars = function(get, card) return { get('Xmult_multi'), sell_value(card, poke.pokemon.chandelure) } end,
  triggers = {
