    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem, get('card_limit') }
  end,
  passives = { consumable_slots = 'card_limit' },
  triggers = {
    -- The Fool is Cardlike's Prism (cart_card_21).
    afterAllCardsScored = function(card, state, step, result) abra_line(card, state, step, result, nil, 'twisted_spoon', 'cart_card_21') end,
  },
}

-- Mega Alakazam 065-1
poke.addPokemon {
  name = 'mega_alakazam', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Psychic', gen = 1,
  config = { Xmult_multi2 = 2, Xmult_multi = 1.5, card_limit = 1 },
  attributes = { 'passive', 'xmult', 'item' },
  vars = function(get) return { get('Xmult_multi'), get('Xmult_multi2'), get('card_limit') } end,
  passives = { consumable_slots = 'card_limit' },
  triggers = {
    -- Balatro other_consumeable: each held consumable gives X Mult.
    afterAllCardsScored = function(card, state, step, result)
      local spoon = poke.items.id('twisted_spoon')
      for _, c in ipairs(state.consumables or {}) do
        local x = c:getConsumableDef() == spoon and poke.get(card, 'Xmult_multi2') or poke.get(card, 'Xmult_multi')
        result:add(xMult(x))
        c:punch()
      end
    end,
  },
}

