-- Pokermon Admin cards (Balatro Spectral cards, original consumables/02_mart_spectral.lua).
local poke = cardlike.require('lib.pokermon')
local C = cardlike.require('content.consumables.common')

local function stamp_card(id, pos, stamp, label)
  cardlike.addConsumable {
    id = id,
    type = 'admin',
    readableName = C.name('Spectral', 'c_poke_' .. id),
    price = 4,
    sprite = poke.sprites.at('consumables', pos[1], pos[2]),
    description = function(r) return C.desc('Spectral', 'c_poke_' .. id, {}) end,
    canUse = function(ctx) return C.need(ctx, 1, 1) end,
    action = function(ctx)
      local card = C.sel(ctx)[1]
      if card then
        card:setStamp(stamp)
        card:popup(label, poke.colours.pink)
      end
    end,
  }
end

stamp_card('obituary', { 1, 4 }, poke.STAMP_IDS.poke_pink_seal, 'Pink Stamp')
stamp_card('revenant', { 2, 5 }, poke.STAMP_IDS.poke_silver, 'Silver Stamp')

-- Nightmare: destroys the leftmost joker and creates 2 Inverted Energy cards of its type (Colorless for typeless jokers).
cardlike.addConsumable {
  id = 'nightmare',
  type = 'admin',
  readableName = C.name('Spectral', 'c_poke_nightmare'),
  price = 3,
  sprite = poke.sprites.at('consumables', 0, 4),
  description = function(r) return C.desc('Spectral', 'c_poke_nightmare', {}) end,
  canUse = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if not choice then return 'No joker' end
    if choice:isLocked() then return 'The leftmost joker is Locked' end
    return ''
  end,
  action = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if not choice then return end
    local energy = poke.energy.get_matching_energy(choice, true) or poke.energy.card_id('Colorless')
    if not cardlike.contentInfo('consumable', energy) then energy = poke.energy.card_id('Colorless') end
    local count = energy == poke.MOD_ID .. ':bird_energy' and 1 or 2
    for _ = 1, count do cardlike.createConsumable(energy, { edition = 'Inverted', force = true }) end
    choice:destroy()
  end,
}

-- Transformation: energizes the leftmost joker with a type and evolves it to the last stage of its line.
-- Hidden: appears rarely in place of an Energy card (soul_rate 0.025).
cardlike.addConsumable {
  id = 'transformation',
  type = 'admin',
  readableName = C.name('Spectral', 'c_poke_transformation'),
  price = 4,
  hidden = true,
  sprite = poke.sprites.at('consumables', 2, 1),
  description = function(r) return C.desc('Spectral', 'c_poke_transformation', { C.energy_limit() }) end,
  canUse = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if choice and poke.get_type(choice) then return '' end
    return 'The leftmost joker has no type'
  end,
  action = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if not choice then return end
    local t = poke.get_type(choice)
    if t then poke.energy.increase(choice, t) end
    local def = poke.def(choice)
    if def and not def.aux_poke then
      local highest = poke.get_highest_evo(choice, ctx.state)
      if type(highest) == 'string' then poke.evolve(choice, highest, nil, ctx.state) end
    end
  end,
}

---------------------------------------------------------------------------
-- Mega Stone: reusable once per round. Mega Evolves the leftmost Pokemon that can, or turns its Mega back.
-- One Mega per stone: the stone keeps the uid of its Mega in 'poke_used_on'. Selling the stone reverts the Mega.
-- Hidden: appears rarely in place of an Item (soul_rate 0.006).
---------------------------------------------------------------------------

local MEGASTONE = poke.MOD_ID .. ':megastone'

local function is_mega(joker)
  local def = poke.def(joker)
  return def ~= nil and (def.poke_rarity == 'poke_mega' or def.stage == 'Mega')
end

local function mega_target(stone, state)
  local used_on = stone and stone:getDataStore():get('poke_used_on')
  local infinite = poke.modifier('infinite_megastone')
  return poke.find_card(function(j)
    if not used_on and poke.get_mega(j, state) and not j:getDebuffState() then return true end
    if is_mega(j) and used_on and j:getId() == used_on then return true end
    if infinite and ((poke.get_mega(j, state) and not j:getDebuffState()) or is_mega(j)) then return true end
    return false
  end, state)
end

local function find_by_uid(state, uid)
  if not uid then return nil end
  for _, j in ipairs(state.jokers or {}) do if j:getId() == uid then return j end end
  return nil
end

cardlike.addConsumable {
  id = 'megastone',
  type = 'admin',
  readableName = C.name('Spectral', 'c_poke_megastone'),
  price = 4,
  hidden = true,
  credits = 'Art: MyDude_YT, Lemmanade',
  sprite = poke.sprites.at('consumables', 4, 5),
  description = function(r)
    local text = C.desc('Spectral', 'c_poke_megastone', {})
    if not poke.modifier('infinite_megastone') then
      text = text .. '\n' .. colorize('(Only 1 Joker can Mega Evolve per Mega Stone you have)', colors.GREY)
    end
    local card = r and r.card
    if card and C.in_run() then
      local j = find_by_uid(cardlike.state, card:getDataStore():get('poke_used_on'))
      if j then text = text .. '\n' .. colorize('Used on: ' .. j:getName(), colors.ORANGE) end
      if not poke.items.usable(card) then text = text .. '\n' .. colorize('(Used this round)', colors.MULT) end
    end
    return text
  end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    if #(ctx.state.jokers or {}) == 0 then return 'No joker' end
    if not mega_target(ctx.self, ctx.state) then return 'No Pokemon can Mega Evolve' end
    return ''
  end,
  action = function(ctx)
    local state = ctx.state
    local target = mega_target(ctx.self, state)
    local ds = ctx.self:getDataStore()
    if target then
      local mega = poke.get_mega(target, state)
      if mega then
        if poke.modifier('infinite_megastone') then ds:delete('poke_used_on') else ds:set('poke_used_on', target:getId()) end
        poke.evolve(target, mega, nil, state)
      else
        local prev = poke.get_previous_evo(target, true)
        ds:delete('poke_used_on')
        if prev then poke.devolve(target, prev, nil, state) end
      end
    end
    poke.items.keep_on_use(ctx)
  end,
}

-- At the end of the round a stone forgets a Mega that is gone.
cardlike.on('onBlindDefeated', function(state)
  for _, stone in ipairs(C.held(state, MEGASTONE)) do
    local ds = stone:getDataStore()
    local uid = ds:get('poke_used_on')
    if uid and not find_by_uid(state, uid) then ds:delete('poke_used_on') end
  end
end)

-- Selling the stone turns its Mega back.
cardlike.on('onCardSold', function(state, step)
  local stone = step.card
  if not stone or stone:getKind() ~= 'consumable' or stone:getConsumableDef() ~= MEGASTONE then return end
  local target = find_by_uid(state, stone:getDataStore():get('poke_used_on'))
  if target then
    local prev = poke.get_previous_evo(target, true)
    if prev then poke.devolve(target, prev, nil, state) end
  end
end)


== file content/editions.lua (116 lines)
-- Shiny edition (original editions/editions1.lua and assets/shaders/shiny.fs).
-- Shiny: +1 pack slot in the shop for each Shiny card you own. The card sparkles with golden stars.
local poke = cardlike.require('lib.pokermon')

local SHINY = poke.MOD_ID .. ':shiny'

-- The shiny.fs star effect as a Cardlike edition shader: two groups of stars (5 and 4 points) appear at random places
-- over the card and fade in and out; their colour is a golden HSL colour mixed over the card art.
local SHADER = [[
float pk_hash(float value, float index) {
  return fract(sin(dot(vec2(index / value, value / index), vec2(12.9898, 78.233))) * 43758.5453);
}
float pk_logistic(float x) {
  return 1.0 / (1.0 + exp(6.0 - 8.0 * x)) - 0.005;
}
float pk_hide(float x) {
  return 1.0 - pow(abs(sin(1.57079632679 * x)), 20.0);
}
void main() {
  vec2 uv = snapUv(vUv0);
  vec4 base = sampleCard(uv);
  float PK_PI = 3.14159265359;
  vec2 p = vUv0 - vec2(0.5, 0.5);
  float tilt = uNormal.x * 3.0;
  float tv = uTime + 7777.0;
  float alpha = 0.0;
  float light = 0.7;
  for (float i = 4.0; i < 8.0; i += 1.0) {
    float iv = sqrt(i);
    float iter = fract(tv / iv);
    float h = floor(tv / iv);
    float ang = 2.0 * PK_PI * pk_hash(h, 1.0);
    float dist = 0.1 + 0.3 * pk_hash(h, 2.0);
    vec2 q = p + vec2(dist * cos(ang), dist * sin(ang));
    float size = sin(iter * PK_PI) * (iv / 3.0) * (0.05 + 0.2 * pk_hash(h, 3.0));
    float sa = atan(q.x, q.y) + sin(tilt + uTime + PK_PI * pk_hash(h, 4.0));
    float star = size * 0.2 / cos(asin(cos(5.0 * sa)) / 10.0 + 0.942477796077);
    float len = max(length(q), 0.0001);
    float sc = 1.2 - 15.0 * abs(len - star) - 0.0075 / len;
    float op = clamp(pk_hide(iter) * pk_logistic(sc), 0.0, 1.0);
    float prev = alpha;
    alpha = op + prev * (1.0 - op);
    if (alpha > 0.00001) {
      light = (0.3 * pk_hash(h, 9.0) + 0.6) * (op / alpha) + (light * prev / alpha);
    }
  }
  for (float j = 1.0; j < 8.0; j += 1.0) {
    float jv = sqrt(j);
    float iter2 = fract(tv / jv);
    float h2 = floor(tv / jv);
    float ang2 = 2.0 * PK_PI * pk_hash(h2, 5.0);
    float dist2 = 0.1 + 0.3 * pk_hash(h2, 6.0);
    vec2 q2 = p + vec2(dist2 * cos(ang2), dist2 * sin(ang2));
    float size2 = sin(iter2 * PK_PI) * (jv / 3.0) * (0.05 + 0.2 * pk_hash(h2, 7.0));
    float sa2 = atan(q2.x, q2.y) + sin(tilt * 10.0 + uTime + PK_PI * pk_hash(h2, 8.0));
    float star2 = size2 * 0.05 / cos(asin(cos(4.0 * sa2)) / 3.0 + 0.942477796077);
    float sc2 = star2 / max(length(q2), 0.0001);
    float op2 = clamp(pk_hide(iter2) * pk_logistic(sc2), 0.0, 1.0);
    float prev2 = alpha;
    alpha = op2 + prev2 * (1.0 - op2);
    if (alpha > 0.00001) {
      light = (op2 / alpha) + (light * prev2 * (1.0 - op2) / alpha);
    }
  }
  vec3 starColour = hslToRgb(0.14, 1.0, clamp(light, 0.0, 1.0));
  float mask = base.a > 0.01 ? clamp(alpha, 0.0, 1.0) : 0.0;
  vec3 rgb = mix(base.rgb, starColour, mask);
  gl_FragColor = applyOverlays(vec4(rgb, base.a * uOpacity), vUv0);
}
]]

cardlike.addEdition {
  id = 'shiny',
  readableName = 'Shiny',
  description = poke.text.describe('Edition', 'e_poke_shiny'),
  cost = 5,
  rollChance = 0.002,
  like = 'Chroma',
  shader = SHADER,
}

-- The Shiny edition stays off playing cards unless the setting shiny_playing_cards is on.
cardlike.on('onCardCreated', function(state, step)
  local card = step.card
  if not card or poke.settings.shiny_playing_cards then return end
  local info = card.lastInfo or card:info() or {}
  if info.kind == 'playing' and info.edition == SHINY then card:setEdition('default') end
end)

-- +1 pack slot in the shop for each Shiny card you own (jokers, consumables and playing cards).
local function count_shiny(state)
  local n = 0
  for _, list in ipairs({ state.jokers or {}, state.consumables or {}, state.allCards or {} }) do
    for _, c in ipairs(list) do
      if (c.lastInfo or {}).edition == SHINY then n = n + 1 end
    end
  end
  return n
end

local function update_pack_slots(state)
  if state.money == nil then return end
  local n = count_shiny(state)
  local applied = poke.run.vars.shiny_pack_slots or 0
  if n ~= applied then
    state.packsAvailableInShopCount = math.max(0, state.packsAvailableInShopCount + (n - applied))
    poke.run.vars.shiny_pack_slots = n
  end
end

cardlike.on('onCashOut', function(state) update_pack_slots(state) end)
cardlike.on('onShopEnter', function(state) update_pack_slots(state) end)
cardlike.on('onCardObtained', function(state, step)
  if step.card and (step.card.lastInfo or {}).edition == SHINY then cardlike.playSound('e_shiny') end
end)


== file content/enhancements.lua (139 lines)
-- Enhancements: Hazard, Seed, Flower, and Ludicolo (joke content) (original enhancements/enhancement1.lua).
local poke = cardlike.require('lib.pokermon')

local HAZARD = poke.MOD_ID .. ':hazard'
local SEED = poke.MOD_ID .. ':seed'
local FLOWER = poke.MOD_ID .. ':flower'
local LUDICOLO = poke.MOD_ID .. ':ludicolo'

-- Enhancement check that accepts the full id or the short id.
local function is_enh(card, full)
  local e = card:getEnhancement()
  return e == full or (type(e) == 'string' and full:sub(-#e - 1) == ':' .. e)
end

local function text(key, vars) return poke.text.describe('Enhanced', key, vars) end
local function name(key, fallback) return poke.text.name('Enhanced', key, fallback) end

-- Hazard: no rank, always scores. 1 in 3 chance to be destroyed when held in hand at the end of the round.
cardlike.addEnhancement {
  id = 'hazard',
  readableName = name('m_poke_hazard', 'Hazard Card'),
  description = function(r)
    local state = cardlike.state
    local chance = state.money ~= nil and state:getChanceString(1 / 3) or '1 in 3'
    return 'No rank or suit. Always scores\n' .. colorize(chance, colors.GREEN)
      .. ' chance to be destroyed if ' .. colorize('held', colors.ORANGE) .. ' in hand at end of round'
  end,
  sprite = poke.sprites.at('enhancements', 0, 0),
  credits = 'Art: PrincessRoxie',
  noRank = true,
  triggerTime = 'never',
}

cardlike.on('afterRound', function(state)
  -- Heavy-Duty Boots (content/consumables/rare.lua) stop the destruction this round
  if poke.run.vars and poke.run.vars.hazard_off then return end
  for _, c in ipairs(state.cardsInHand or {}) do
    if is_enh(c, HAZARD) and state:chance(1 / 3) then c:destroy() end
  end
end)

-- Seed: grows 1 + growth level times when scored. After growing 5 times it earns $15 and becomes a Flower card.
local SEED_MAX, SEED_MONEY = 5, 15
cardlike.addEnhancement {
  id = 'seed',
  readableName = name('m_poke_seed', 'Seed Card'),
  description = function(r)
    local card = r and r.card
    local level = card and card.uid and card:getDataStore():get('poke_seed_level') or 0
    local grow = 1 + poke.growth_level()
    return text('m_poke_seed', { SEED_MAX, math.max(0, SEED_MAX - level), SEED_MONEY, grow, grow > 1 and 'times' or 'time' })
  end,
  sprite = poke.sprites.at('enhancements', 1, 0),
  credits = 'Art: MyDude_YT',
  triggerTime = 'never',
}

cardlike.on('onScore', function(state, step, result)
  local card = step.card
  if not card or not is_enh(card, SEED) or card:getDebuffState() then return end
  local ds = card:getDataStore()
  local level = (ds:get('poke_seed_level') or 0) + 1 + poke.growth_level()
  ds:set('poke_seed_level', level)
  cardlike.playSound('seed_' .. math.min(SEED_MAX, level))
  if level >= SEED_MAX then
    ds:delete('poke_seed_level')
    card:setEnhancement(FLOWER)
    result:add(plusMoney(SEED_MONEY))
    result:say('Bloom!', colors.GREEN, card)
  else
    result:say('Upgrade!', colors.GREEN, card)
  end
end)

-- Flower: X2 Mult when the played hand has 4 or more suits (3 with Roserade; +1 X Mult with Shaymin).
cardlike.addEnhancement {
  id = 'flower',
  readableName = name('m_poke_flower', 'Flower Card'),
  description = text('m_poke_flower', { 2 }),
  sprite = poke.sprites.at('enhancements', 6, 0),
  credits = 'Art: MyDude_YT',
  triggerTime = 'scored',
  getBonus = function(state, card)
    local suits = state:hasJoker(poke.id('roserade')) and 3 or 4
    -- the suits of the scoring cards (Balatro scoring_hand), not of every played card
    local played = state.playedCards or {}
    local hand = cardlike.evaluateHand(played)
    local scoring = played
    if hand and type(hand.scoring) == 'table' then
      local set = {}
      for _, uid in pairs(hand.scoring) do set[uid] = true end
      scoring = {}
      for _, c in ipairs(played) do
        if set[c.uid] or (c.lastInfo or {}).noRank then scoring[#scoring + 1] = c end
      end
    end
    if not poke.suit_check(scoring, suits) then return {} end
    local extra = (state:hasJoker(poke.id('shaymin')) or state:hasJoker(poke.id('shaymin_sky'))) and 1 or 0
    return { xMult(2 + extra) }
  end,
}

-- Ludicolo (joke content, setting pokemon_aprilfools): no rank, always scores, and dances.
if poke.settings.pokemon_aprilfools then
  cardlike.addEnhancement {
    id = 'ludicolo',
    readableName = name('m_poke_ludicolo', 'Ludicolo'),
    description = text('m_poke_ludicolo'),
    sprite = poke.sprites.at('miror_budicolo', 0, 0),
    noRank = true,
    triggerTime = 'never',
  }

  cardlike.on('onScore', function(state, step, result)
    if step.card and is_enh(step.card, LUDICOLO) then
      cardlike.playSound('ludicolo_cry')
      result:say('Ludicolo!', colors.GREEN, step.card)
    end
  end)

  -- Miror B. music plays while a Ludicolo card is in your hand.
  local playing = false
  cardlike.onFrame(function(frame)
    local found = false
    if frame.inRun then
      for _, c in ipairs(cardlike.state.cardsInHand or {}) do
        if (c.lastInfo or {}).enhancement == LUDICOLO then found = true break end
      end
    end
    if found and not playing then
      cardlike.playSound('miror_b_music', { loop = true, channel = 'poke_miror_b' })
      playing = true
    elseif not found and playing then
      cardlike.stopSound('poke_miror_b')
      playing = false
    end
  end)
end


== file content/rules.lua (231 lines)
-- Run rules: the parts of Pokermon's game patches (lovely files, pokermon.lua calculate and overrides) that change
-- the game for the player, and the challenge and deck rules set with poke.set_modifier.
local poke = cardlike.require('lib.pokermon')

local function mod(name) return poke.modifier(name) end
local FORESEEN = cardlike.require('lib.data.loc').v_dictionary.poke_unforeseen_debuff or '#1# is Foreseen'

local function random_pick(list)
  if #list == 0 then return nil end
  return list[math.floor(cardlike.random() * #list) + 1]
end

---------------------------------------------------------------------------
-- Editions: Jirachi raises the chance of Inverted (Balatro Negative) editions.
---------------------------------------------------------------------------

-- Balatro rolls Negative about 0.3% of the time for a joker; each extra point of rate adds that much again.
local NEGATIVE_BASE = 0.003
cardlike.filter('edition', function(edition)
  local rate = poke.run.negative_edition_rate or 1
  if rate > 1 and edition ~= 'Inverted' and cardlike.random() < (rate - 1) * NEGATIVE_BASE then return 'Inverted' end
end)

---------------------------------------------------------------------------
-- New cards: Luminous Deck (Tera type and 1 energy on new jokers), forced stamps (Obituary and Revenant decks)
---------------------------------------------------------------------------

cardlike.on('onCardCreated', function(state, step)
  local card = step.card
  if not card or not mod('apply_type') or card:getKind() ~= 'joker' then return end
  local ds = card:getDataStore()
  if ds:get('poke_luminous') then return end
  ds:set('poke_luminous', true)
  local t = poke.apply_type_sticker(card, nil, state)
  poke.energy.increase(card, t, 1, true)
end)

cardlike.on('onCardsAdded', function(state, step)
  local stamp = mod('force_seal')
  if not stamp then return end
  for _, c in ipairs(step.cards or {}) do c:setStamp(stamp) end
end)

---------------------------------------------------------------------------
-- Challenge rules on jokers
---------------------------------------------------------------------------

-- all_eternal: every joker you get is Locked.
cardlike.on('onCardObtained', function(state, step)
  local card = step.card
  if mod('all_eternal') and card and card:getKind() == 'joker' then card:setLocked(true) end
end)

-- noncolorless (Imposter Syndrome): jokers that are not Colorless (Tera type counts) are debuffed.
local RULE_MARK = 'poke_rule_debuff'
local function imposter_refresh(state)
  if not mod('noncolorless') then return end
  for _, j in ipairs(state.jokers or {}) do
    local ds = j:getDataStore()
    if poke.is_type(j, 'Colorless') then
      if ds:get(RULE_MARK) then
        ds:delete(RULE_MARK)
        if not ds:get('poke_fainted') and not ds:get('poke_blind_debuff') then j:setDebuffState(false) end
      end
    elseif not j:getDebuffState() then
      ds:set(RULE_MARK, true)
      j:setDebuffState(true)
    end
  end
end
for _, event in ipairs({ 'onRoundStart', 'onCardObtained', 'onShopEnter', 'onConsumableUsed', 'onHandDrawn' }) do
  cardlike.on(event, function(state) imposter_refresh(state) end)
end

-- add_ditto (Imposter Syndrome): a Ditto joins when a Boss Blind is defeated.
cardlike.on('onBlindDefeated', function(state)
  if mod('add_ditto') and state.blind and state.blind.boss and poke.def('ditto') and (state.freeJokerSlots or 0) > 0 then
    cardlike.createJoker(poke.id('ditto'))
  end
end)

-- no_shop_jokers: jokers in the shop cannot be bought. no_energy: Energy cards in the shop cannot be bought.
cardlike.filter('canBuy', function(ok, card)
  local state = cardlike.state
  if not state:isPhase('shop') or not card then return nil end
  local info = card.lastInfo or {}
  if mod('no_shop_jokers') and info.kind == 'joker' then return false end
  if mod('no_energy') and info.kind == 'consumable' and info.type == poke.MOD_ID .. ':energy' then return false end
  return nil
end)

---------------------------------------------------------------------------
-- Antes: joker slots (Nuzlocke), the first shop's Fool Pack (Nuzlocke), the Vending Deck pin
---------------------------------------------------------------------------

cardlike.on('onAnteChanged', function(state, step)
  if (step.delta or 1) <= 0 then return end
  if mod('add_joker_slots') then
    poke.run.slots_added = (poke.run.slots_added or 0) + 1
    if poke.run.slots_added <= 5 then state.additionalJokerSlots = state.additionalJokerSlots + 1 end
  end
  if mod('nuzlocke') then poke.run.vars.first_shop_fool = false end
  -- Vending Deck: a Sticky Note Pin (Balatro Voucher Tag) after each odd Boss Blind.
  if mod('vending') and ((step.ante or state.ante) - 1) % 2 == 1 then cardlike.addPin('pin_9') end
end)

cardlike.on('onShopEnter', function(state)
  if not mod('nuzlocke') or poke.run.vars.first_shop_fool then return end
  poke.run.vars.first_shop_fool = true
  local fools = {}
  for _, p in ipairs(cardlike.listContent('pack') or {}) do
    if type(p.name) == 'string' and p.name:find('Fool') and not p.name:find('Jumbo') and not p.name:find('Mega') then fools[#fools + 1] = p.id end
  end
  local pick = random_pick(fools)
  if pick then cardlike.addShopItem(pick) end
end)

---------------------------------------------------------------------------
-- Boss blinds: banned blinds (challenges), Elite Stake finisher antes
---------------------------------------------------------------------------

local function other_blind(want_finisher, avoid, ante)
  local options = {}
  for _, b in ipairs(cardlike.listContent('blind') or {}) do
    if b.boss and (b.finisher == true) == want_finisher and not avoid[b.id] and (not b.minAnte or b.minAnte <= (ante or 99)) then
      options[#options + 1] = b.id
    end
  end
  return random_pick(options)
end

local function blind_info(id)
  for _, b in ipairs(cardlike.listContent('blind') or {}) do if b.id == id then return b end end
  return nil
end

cardlike.filter('bossBlind', function(id)
  local state = cardlike.state
  local banned = mod('banned_blinds') or {}
  local info = blind_info(id) or {}
  -- Elite Stake: the last antes before each eighth ante have finisher bosses (Balatro showdown antes).
  if mod('elite4') and not info.finisher and (state.ante or 1) % 8 >= 5 then
    local pick = other_blind(true, banned, 99)
    if pick then return pick end
  end
  if banned[id] then
    return other_blind(info.finisher == true, banned, state.ante)
  end
end)

---------------------------------------------------------------------------
-- Hands: Mean Look (you cannot play a hand that the Foresight cards contain)
---------------------------------------------------------------------------

cardlike.filter('canPlayHand', function(ok, selected)
  if not mod('unforeseen_hand') or type(selected) ~= 'table' or #selected == 0 then return nil end
  local scry = poke.scry.cards(cardlike.state)
  if #scry == 0 then return nil end
  local played = cardlike.evaluateHand(selected)
  local foreseen = cardlike.evaluateHand(scry)
  if played and foreseen and foreseen.contains and foreseen.contains[played.handType] then
    local text = FORESEEN
    cardlike.centerText((text:gsub('#1#', played.name or played.handType)), 1.5)
    return false
  end
  return nil
end)

---------------------------------------------------------------------------
-- Scoring: Lucky (Paperback) triggers this round, for Leafeon
---------------------------------------------------------------------------

cardlike.on('enhancementScore', function(state, step)
  if step.enhancement == 'Paperback' then poke.run.lucky_triggers = (poke.run.lucky_triggers or 0) + 1 end
end)

---------------------------------------------------------------------------
-- Cash out: money per enhanced card (Debris Deck), no interest, no blind reward, no hand money
---------------------------------------------------------------------------

local function interest(state)
  local cap = 25
  if state:hasTicket('ticket_21') then cap = 100 elseif state:hasTicket('ticket_20') then cap = 50 end
  local n = math.floor(math.min(cap, math.max(0, state.money or 0)) / 5 + 0.5)
  return n * (1 + (state:countJoker('joker_scrooge') or 0))
end

local function blind_reward(state)
  local b = state.blind or {}
  if type(b.reward) == 'number' then return b.reward end
  if b.boss then return b.finisher and 8 or 5 end
  if b.id == 'Alpha Blind' then return 4 end
  return 3
end

cardlike.filter('cashOut', function(total)
  local state = cardlike.state
  local b = state.blind or {}
  local per = mod('money_per_enhancement')
  if per and mod('enhance_bonus') then
    local tally = 0
    for _, c in ipairs(state.allCards or {}) do
      if (c.lastInfo or {}).enhancement == mod('enhance_bonus') then tally = tally + 1 end
    end
    if tally > 0 then cardlike.addRoundReward(tostring(mod('enhance_bonus_text') or 'Enhanced cards') .. ' (' .. tally .. ')', tally * per) end
  end
  local no_interest_deck = state.deck == poke.MOD_ID .. ':diceydeck' or state.deck == 'Grass Deck'
  if (mod('no_interest') or mod('reset_no_interest')) and not no_interest_deck then
    local n = interest(state)
    if n > 0 then cardlike.addRoundReward('No Interest', -n) end
  end
  local no_reward = mod('no_reward') or (not b.boss and ((b.id == 'Alpha Blind' and mod('no_reward_big'))
    or (b.id ~= 'Alpha Blind' and mod('no_reward_small'))))
  if no_reward then
    local r = blind_reward(state)
    if r > 0 then cardlike.addRoundReward('No Blind Reward', -r) end
  end
  if mod('no_extra_hand_money') and (state.handsLeft or 0) > 0 then
    cardlike.addRoundReward('No Hand Money', -state.handsLeft)
  end
  return nil
end)

-- Double Rainbow Energy turns interest off for one round (modifier reset_no_interest).
cardlike.on('onCashOut', function(state)
  if mod('reset_no_interest') then
    poke.set_modifier('reset_no_interest', nil)
    poke.set_modifier('no_interest', nil)
  end
end)


== file content/seals.lua (91 lines)
-- Seals -> Cardlike stamps: Pink Stamp, Silver Stamp, DNA Stamp (original seals/seals1.lua).
local poke = cardlike.require('lib.pokermon')

local function text(key, vars) return poke.text.describe('Other', key, vars) end
local function name(key, fallback) return poke.text.name('Other', key, fallback) end

-- Pink Seal: scored in the first hand of the round, creates an Energy card that matches the type of one of your
-- jokers (a random Energy card when none has a type).
cardlike.addStamp {
  id = 'pink_seal',
  readableName = name('poke_pink_seal_seal', 'Pink Seal'),
  description = text('poke_pink_seal_seal'),
  sprite = poke.sprites.at('stickers', 0, 0),
  credits = 'Art: KatRoman',
  onScore = function(state, card)
    if (state.handsPlayed or 0) ~= 0 or (state.freeConsumableSlots or 0) < 1 then return {} end
    local options = {}
    for _, j in ipairs(state.jokers or {}) do
      local id = poke.energy.get_matching_energy(j, true)
      if id then options[#options + 1] = id end
    end
    local energy = poke.random_element(options, state)
    if energy == poke.energy.card_id('Bird') then card:setStamp(nil) end
    local made = cardlike.createConsumable(energy or (poke.MOD_ID .. ':energy'))
    if made then card:popup(poke.text.dict('poke_plus_energy', '+1 Energy'), poke.colours.pink) end
    if poke.modifier('pink_seal_selfdestruct') and state:chance(1 / 3) then card:setStamp(nil) end
    return {}
  end,
}

-- Silver Seal: held in hand during scoring, creates an Item card and is discarded. Cardlike cannot discard a card
-- from the hand during scoring, so the card goes back into the deck after the hand.
local SILVER = poke.MOD_ID .. ':silver'
cardlike.addStamp {
  id = 'silver',
  readableName = name('poke_silver_seal', 'Silver Seal'),
  description = text('poke_silver_seal'),
  sprite = poke.sprites.at('stickers', 3, 1),
  credits = 'Art: KatRoman',
  onHeld = function(state, card)
    local ds = card:getDataStore()
    if ds:get('poke_silver_used') then return {} end
    ds:set('poke_silver_used', true)
    if (state.freeConsumableSlots or 0) > 0 then cardlike.createConsumable(poke.MOD_ID .. ':item') end
    return {}
  end,
}

cardlike.on('afterHand', function(state)
  for _, c in ipairs(state.cardsInHand or {}) do
    local ds = c:getDataStore()
    if ds:get('poke_silver_used') then
      ds:delete('poke_silver_used')
      if c:getStamp() == SILVER then c:moveTo('deck') end
    end
  end
end)

-- DNA Seal: when the played hand is exactly 1 card, a copy of it without the stamp joins your hand. Each Deoxys
-- you own adds to the copy: Attack form X Mult, Speed form money when held at the end of the round, Defense form
-- points (see the permanent bonuses below).
cardlike.addStamp {
  id = 'dna_seal',
  readableName = name('poke_dna_seal_seal', 'DNA Seal'),
  description = text('poke_dna_seal_seal'),
  sprite = poke.sprites.at('stickers', 6, 1),
  credits = 'Art: CBMX',
  onScore = function(state, card)
    if #(state.playedCards or {}) ~= 1 then return {} end
    local copy = cardlike.addPlayingCard({ copyOf = card }, { area = 'hand' })
    if not copy then return {} end
    copy:setStamp(nil)
    local xmult, money, chips = 0, 0, 0
    for _, j in ipairs(state.jokers or {}) do
      if poke.name(j) == 'deoxys' then
        local form = poke.get(j, 'form')
        if form == 1 then xmult = xmult + (poke.get(j, 'Xmult_multi', 0) or 0) end
        if form == 2 then money = money + (poke.get(j, 'money_mod', 0) or 0) end
        if form == 3 then chips = chips + (poke.get(j, 'chip_mod', 0) or 0) end
      end
    end
    if xmult > 0 then poke.add_perma_bonus(copy, 'x_mult', xmult) end
    if money > 0 then poke.add_perma_bonus(copy, 'h_dollars', money) end
    if chips > 0 then poke.add_perma_bonus(copy, 'chips', chips) end
    card:popup('Copied!', colors.CHIPS)
    return {}
  end,
}

-- The permanent bonuses of the copy (X Mult, held money) are given by lib/cardbonus.lua.


== file content/skins.lua (33 lines)
-- Card skins: RBY and GSC Pokemon face cards (pokesprites.lua deck skins).
-- Sprites by GAME FREAK, arranged by Catzzadilla. Each sheet has the Jack, Queen and King (142 x 190) left to right.
-- Each Balatro palette (normal and high contrast) is its own skin here.
local SKINS = {
  { id = 'rby_spades', suit = 'Spades', name = 'RBY Sprites: Ghost Trio', file = 'Gen01RBYSpades' },
  { id = 'rby_clubs', suit = 'Clubs', name = 'RBY Sprites: Fossil Trio', file = 'Gen01RBYClubs' },
  { id = 'rby_hearts', suit = 'Hearts', name = 'RBY Sprites: Eeveelution Trio', file = 'Gen01RBYHearts' },
  { id = 'rby_diamonds', suit = 'Diamonds', name = 'RBY Sprites: Dragon Trio', file = 'Gen01RBYDiamonds' },
  { id = 'gsc_spades_morning', suit = 'Spades', name = 'GSC Sprites: Day and Night (Morning)', file = 'Gen02GSCSpadesMorning' },
  { id = 'gsc_spades_evening', suit = 'Spades', name = 'GSC Sprites: Day and Night (Evening)', file = 'Gen02GSCSpadesEvening' },
  { id = 'gsc_clubs', suit = 'Clubs', name = 'GSC Sprites: Mystic Mons', file = 'Gen02GSCClubs' },
  { id = 'gsc_hearts', suit = 'Hearts', name = 'GSC Sprites: Allies of Ash', file = 'Gen02GSCHearts' },
  { id = 'gsc_diamonds', suit = 'Diamonds', name = 'GSC Sprites: Johto Giants', file = 'Gen02GSCDiamonds' },
}

for _, s in ipairs(SKINS) do
  for _, hc in ipairs({ false, true }) do
    local sheet = 'skin_' .. s.id .. (hc and '_hc' or '')
    cardlike.addSpriteSheet { id = sheet, file = 'images/skins/' .. s.file .. (hc and 'HC' or '') .. '.png', frameWidth = 142, frameHeight = 190 }
    cardlike.addCardSkin {
      id = s.id .. (hc and '_hc' or ''),
      name = s.name .. (hc and ' (High Contrast)' or ''),
      suit = s.suit,
      credits = 'Sprites by GAME FREAK, arranged by Catzzadilla',
      frames = {
        Jack = { sheet = sheet, x = 0, y = 0 },
        Queen = { sheet = sheet, x = 1, y = 0 },
        King = { sheet = sheet, x = 2, y = 0 },
      },
    }
  end
end


== file content/stakes.lua (31 lines)
-- Elite Stake (original stakes/stakes.lua).
-- Pokermon: +2 Antes to win, and the last 4 Antes have Showdown boss blinds. Cardlike cannot move the winning Ante,
-- so here the last 3 Antes before each finisher Ante (5, 6 and 7 of every 8) get a finisher blind as their boss.
local poke = cardlike.require('lib.pokermon')

cardlike.addStake {
  id = 'elite',
  name = poke.text.name('Stake', 'stake_poke_elite', 'Elite Stake'),
  description = 'Ante ' .. bold('5') .. ', ' .. bold('6') .. ' and ' .. bold('7') .. ' have ' .. colorize('Finisher Blinds', colors.ORANGE)
    .. ' as boss blinds. Applies all previous Stakes',
  color = '#ba8514',
  sprite = poke.sprites.at('elite_stake', 0, 0),
}

-- Cardlike numbers mod stakes after Iridium (8) in load order. Pokermon loads early (priority -1), so its only stake
-- is 9 unless a mod with a lower priority adds stakes.
local ELITE_STAKE = 9
local FINISHERS = { 'Tycoon Troll', 'Frame Flip', 'Hand Halt', 'Card Cut', 'Blox Bind' }

cardlike.on('onRunStart', function(state)
  if state.stake == ELITE_STAKE then poke.set_modifier('elite4', true) end
end)

cardlike.filter('bossBlind', function(id)
  local state = cardlike.state
  if not poke.modifier('elite4') or state.money == nil then return nil end
  local step = (state.ante or 1) % 8
  if step >= 5 then return FINISHERS[state:random(1, #FINISHERS)] end
  return nil
end)


== file content/stickers.lua (15 lines)
-- Stickers (original stickers/stickers.lua).
-- Pokermon's stickers are the 12 type stickers (Tera: grass_sticker ... earth_sticker) and the Bird sticker. They never
-- appear on their own (rate 0); they only mark a joker's changed type. In this port the type lives in the joker's data
-- store ('poke_tera', see lib/types.lua: poke.apply_type_sticker / poke.get_type), and the description shows it as a
-- "<Type> Tera" badge. A Cardlike sticker is not used for them, because a card has one sticker slot and that slot keeps
-- Locked, Timed and Subscription.
local poke = cardlike.require('lib.pokermon')

-- The picture positions of the type stickers in images/stickers.png, for anything that wants to draw them.
poke.TYPE_STICKER_POS = {}
for i, t in ipairs(poke.TYPES) do
  poke.TYPE_STICKER_POS[t] = { x = i % 10, y = math.floor(i / 10) }
end
poke.TYPE_STICKER_POS.Bird = { x = 4, y = 1 }


== file content/tags.lua (159 lines)
-- Pins (Balatro tags). Original file: tags/tags1.lua. Art: sheet 'tags' (68 x 68).
local poke = cardlike.require('lib.pokermon')

local function name(key) return poke.text.name('Tag', 'tag_poke_' .. key) end
local function desc(key, vars) return poke.text.describe('Tag', 'tag_poke_' .. key, vars or {}) end

local function pack_id(key) return poke.MOD_ID .. ':' .. key end

-- Jokers that a pin puts in the shop for free: price 0 until bought (checked by id or by a data store mark).
local function free_ids() poke.run.vars.free_shop_ids = poke.run.vars.free_shop_ids or {} return poke.run.vars.free_shop_ids end

cardlike.filter('price', function(price, card)
  if not card or not card.lastInfo then return nil end
  local info = card.lastInfo
  if info.kind ~= 'joker' or info.area ~= 'shop' then return nil end
  if (info.store or {}).poke_free or free_ids()[info.joker] then return 0 end
end)

cardlike.on('onCardBought', function(state, step)
  local card = step.card
  if not card or card:getKind() ~= 'joker' then return end
  local ds = card:getDataStore()
  if ds:get('poke_free') then ds:delete('poke_free') return end
  local ids = free_ids()
  local id = card:getJokerDef()
  if ids[id] then ids[id] = nil end
end)

cardlike.on('onShopExit', function(state) poke.run.vars.free_shop_ids = {} end)

-- Pocket Pin: a free Mega Pocket Pack when the next blind is picked; from Ante 5 it can hold a Mega Stone.
cardlike.addPin {
  id = 'pocket_tag',
  readableName = name('pocket_tag'),
  description = desc('pocket_tag', { 25 }),
  sprite = poke.sprites.at('tags', 0, 0),
  minAnte = 2,
  popWhen = 'blindSelect',
  action = function(ctx)
    poke.run.vars.pocket_pack_from_pin = true
    local n = ctx.state:random(1, 2)
    if not cardlike.openPack(pack_id('pokepack_mega_' .. n)) then poke.run.vars.pocket_pack_from_pin = nil end
  end,
}

-- Shiny Pin: the next shop joker without an edition becomes Shiny and free.
cardlike.addPin {
  id = 'shiny_tag',
  readableName = name('shiny_tag'),
  description = desc('shiny_tag'),
  sprite = poke.sprites.at('tags', 1, 0),
  minAnte = 3,
  popWhen = 'shop',
  canUse = function(ctx)
    for _, c in ipairs(ctx.state.shopCards or {}) do
      if c:getKind() == 'joker' and c:getEdition() == 'default' then return '' end
    end
    return 'No plain joker in the shop'
  end,
  action = function(ctx)
    for _, c in ipairs(ctx.state.shopCards or {}) do
      if c:getKind() == 'joker' and c:getEdition() == 'default' then
        if cardlike.contentInfo('edition', poke.MOD_ID .. ':shiny') then c:setEdition(poke.MOD_ID .. ':shiny') end
        c:getDataStore():set('poke_free', true)
        c:punch()
        return
      end
    end
  end,
}

-- Stage 1 Pin and Safari Pin: the shop has a free Stage 1 (or Safari) Pokemon.
local function shop_pokemon(options)
  return function(state)
    local id = poke.get_random_poke_key(options, state)
    if not poke.def(id) then return nil end
    free_ids()[id] = true
    return { joker = id }
  end
end

cardlike.addPin {
  id = 'stage_one_tag',
  readableName = name('stage_one_tag'),
  description = desc('stage_one_tag'),
  sprite = poke.sprites.at('tags', 2, 0),
  minAnte = 2,
  shopItem = shop_pokemon({ stage = 'One' }),
}

cardlike.addPin {
  id = 'safari_tag',
  readableName = name('safari_tag'),
  description = desc('safari_tag'),
  sprite = poke.sprites.at('tags', 3, 0),
  minAnte = 3,
  shopItem = shop_pokemon({ rarity = 'poke_safari' }),
}

-- Jirachi Pin (made by Jirachi, never offered for a skip): opens a Wish Pack while you own Jirachi.
local jirachi_pin = cardlike.addPin {
  id = 'jirachi_tag',
  readableName = 'Jirachi Pin',
  description = 'Opens a free [b]Wish Pack[/b] when the next blind is picked, if you still have [b]Jirachi[/b]',
  sprite = poke.sprites.at('tags', 4, 0),
  popWhen = 'blindSelect',
  action = function(ctx)
    local jirachi = poke.find_card(function(j) return poke.name(j) == 'jirachi' end, ctx.state)
    if jirachi then
      cardlike.openPack(pack_id('pokepack_wish_pack'))
      jirachi:punch()
    end
  end,
}

-- Starter Pin: a free Starter Pack.
local function starter_pin(key, pack, credits)
  return cardlike.addPin {
    id = key,
    readableName = name(key),
    description = desc(key),
    sprite = poke.sprites.at('tags', 4, 0),
    credits = credits,
    minAnte = 2,
    popWhen = 'blindSelect',
    action = function(ctx) cardlike.openPack(pack_id(pack)) end,
  }
end
local starter_pin_id = starter_pin('starter_tag', 'pokepack_starter_pack', 'Art: Sonfive, Catzzadilla, InertSteak')
local starterq_pin_id = starter_pin('starterq_tag', 'pokepack_starterq_pack', 'Art: Sonfive, Catzzadilla, InertSteak')

-- The Starter Pin is offered only when every starter group has a Pokemon (Grass, Fire and Water starters,
-- Pikachu or Eevee, a pseudo-legendary). The Jirachi and "...?" pins are never offered.
local function starters_ready(state)
  local have = { Grass = false, Fire = false, Water = false, extra = false, pseudo = false }
  for _, def in ipairs(poke.pokemon_list) do
    if not poke.family_present(def, state) then
      if def.starter and have[def.ptype or ''] ~= nil then have[def.ptype] = true end
      if def.pseudol then have.pseudo = true end
      if def.name == 'pikachu' or def.name == 'eevee' then have.extra = true end
    end
  end
  for _, v in pairs(have) do if not v then return false end end
  return true
end

cardlike.filter('skipPin', function(id, slot)
  local state = cardlike.state
  local function blocked(p)
    return p == jirachi_pin or p == starterq_pin_id or (p == starter_pin_id and not starters_ready(state))
  end
  if not blocked(id) then return nil end
  for _ = 1, 6 do
    local other = cardlike.randomPin()
    if other and not blocked(other) then return other end
  end
  return 'pin_0'
end)


