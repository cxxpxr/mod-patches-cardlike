-- Drilbur 529: the first played Rock (Stone) card each round is destroyed and creates Treasure. Evolves after 4.
poke.addPokemon {
  name = 'drilbur',
  rarity = 1,
  cost = 4,
  stage = 'Basic',
  ptype = 'Earth',
  gen = 5,
  enhancement_gate = 'Rock',
  blueprint_compat = false,
  config = { active = true, stones_destroyed = 0 },
  evo_rqmt = 4,
  attributes = { 'enhancements', 'destroy_card', 'generation', 'item', 'economy', 'trigger_evo' },
  vars = function(get) return { math.max(0, 4 - get('stones_destroyed')) } end,
  triggers = {
