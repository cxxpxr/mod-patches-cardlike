-- Parasect 047
poke.addPokemon {
  name = 'parasect', rarity = 2, cost = 8, stage = 'One', ptype = 'Grass', gen = 1,
  config = { mult = 0, mult_mod = 3, mult_mod2 = 2 },
  attributes = { 'mult', 'hand_type', 'scaling' },
  vars = function(get) return { get('mult'), get('mult_mod'), get('mult_mod2') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      if step.hand.contains.TWO_PAIR then
        local n = poke.get(card, 'mult_mod')
        poke.add(card, 'mult', n)
        result:say('+' .. poke.text.num(n) .. ' Mult', colors.MULT)
      elseif poke.get(card, 'mult') > 0 then
        local n = poke.get(card, 'mult_mod2')
        poke.set(card, 'mult', math.max(0, poke.get(card, 'mult') - n))
        result:say('-' .. poke.text.num(n) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
}

