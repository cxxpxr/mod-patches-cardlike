-- Pokemon jokers 901 to 930 (original pokemon/pokejokers_31.lua).
-- Hisuian Qwilfish and Overqwil are inside a block comment in the original file (not loaded), so they are not here.
local poke = cardlike.require('lib.pokermon')

-- Ursaluna 901: gains Mult and creates an Item with an edition when a pack is skipped.
poke.addPokemon {
  name = 'ursaluna',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Earth',
  gen = 8,
  config = { mult = 0, mult_mod = 2 },
  attributes = { 'mult', 'scaling', 'item', 'generation' },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    onPackSkipped = function(card, state, step, result)
      if not step.copiedBy then poke.add(card, 'mult', poke.get(card, 'mult_mod')) end
      result:say('Upgrade!', colors.MULT)
      if (state.freeConsumableSlots or 0) > 0 then
        poke.create_consumeable({ set = 'poke_item', edition = poke.random_edition(state) }, card)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
}

-- Tarountula 917: +1 hazard layer, +1 hand size. Evolves after 4 rounds.
poke.addPokemon {
  name = 'tarountula',
  rarity = 1,
  cost = 5,
  stage = 'Basic',
  ptype = 'Grass',
  gen = 9,
  config = { hazard_level = 1, rounds = 4, h_size = 1 },
  attributes = { 'hazards', 'hand_size', 'passive', 'round_evo' },
  vars = function(get) return { get('hazard_level'), get('rounds'), get('h_size') } end,
  passives = { hand_size = 'h_size', hazard_level = 'hazard_level' },
  evolution = function(card, state) return poke.level_evo(card, state, 'spidops') end,
}

-- Random stamp for Spidops: the four built-in stamps and the Pokermon stamps.
local STAMPS = { 'Replay Stamp', 'Cash Stamp', 'Fruit Stamp', 'Game Stamp', 'pokermon:pink_seal', 'pokermon:silver', 'pokermon:dna_seal' }

-- Spidops 918: +1 hazard layer, +2 hand size. Every 8th playing card added to the deck gets a random stamp.
poke.addPokemon {
  name = 'spidops',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Grass',
  gen = 9,
  blueprint_compat = false,
  config = { hazard_level = 1, h_size = 2, card_goal = 8, cards_added = 0 },
  attributes = { 'hazards', 'hand_size', 'passive', 'modify_card', 'seals' },
  vars = function(get)
    return { get('hazard_level'), get('h_size'), get('card_goal'), math.max(0, get('card_goal') - get('cards_added')) }
  end,
  passives = { hand_size = 'h_size', hazard_level = 'hazard_level' },
  triggers = {
    onCardsAdded = function(card, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(step.cards or {}) do
        local n = poke.add(card, 'cards_added', 1)
        if n >= poke.get(card, 'card_goal') then
          result:say(poke.text.dict('poke_sticky_web_ex', 'Sticky Web!'), colors.ORANGE)
          local stamp = poke.random_stamp(state, STAMPS)
          if stamp then c:setStamp(stamp) end
          poke.set(card, 'cards_added', 0)
        end
      end
    end,
  },
}

-- Fidough and Dachsbun: gain Points when the hand contains the target rank; the rank then moves up to the next owned
-- rank. A new card starts at the lowest rank in the deck.
local function set_lowest_rank(card, state)
  local ds = card:getDataStore()
  if ds:get('poke_rank_init') or not state or not state.allCards then return end
  ds:set('poke_rank_init', true)
  local id, rank = poke.get_lowest_rank(14, state)
  poke.set(card, 'id', id)
  poke.set(card, 'rank', rank)
end

local function rank_in_hand(card, step)
  local want = poke.get(card, 'id')
  for _, c in ipairs(step.hand.playedCards or {}) do
    if poke.rank_of(c) == want then return true end
  end
  return false
end

local function fire_count(state)
  return #poke.find_pokemon_type('Fire', nil, nil, state)
end

-- Fidough 926: gains Points when the hand has the target rank. Evolves when you have a Fire joker.
poke.addPokemon {
  name = 'fidough',
  rarity = 1,
  cost = 4,
  stage = 'Basic',
  ptype = 'Fairy',
  gen = 9,
  config = { chips = 0, chip_mod = 8, rank = '2', id = 2 },
  attributes = { 'chips', 'scaling', 'rank', 'condition_evo' },
  vars = function(get) return { get('chips'), get('chip_mod'), get('rank') } end,
  onAdded = function(card, state) set_lowest_rank(card, state) end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not rank_in_hand(card, step) then return end
      local id, rank = poke.next_owned_rank(poke.get(card, 'id'), state)
      poke.set(card, 'id', id)
      poke.set(card, 'rank', rank)
      poke.add(card, 'chips', poke.get(card, 'chip_mod'))
      result:say('Upgrade!', colors.CHIPS)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'dachsbun', fire_count(state), 1) end,
}

-- Dachsbun 927: as Fidough, and each Fire joker adds +2 to the Points gained.
poke.addPokemon {
  name = 'dachsbun',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Fairy',
  gen = 9,
  config = { chips = 0, chip_mod = 10, rank = '2', id = 2 },
  attributes = { 'chips', 'scaling', 'rank', 'joker', 'types' },
  vars = function(get) return { get('chips'), get('chip_mod'), get('rank') } end,
  onAdded = function(card, state) set_lowest_rank(card, state) end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not rank_in_hand(card, step) then return end
      local id, rank = poke.next_owned_rank(poke.get(card, 'id'), state)
      poke.set(card, 'id', id)
      poke.set(card, 'rank', rank)
      poke.add(card, 'chips', poke.get(card, 'chip_mod') + fire_count(state) * 2)
      result:say('Upgrade!', colors.CHIPS)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

-- Smoliv 928: gains $2 of sell value at the end of each round. Evolves at $12 sell value.
poke.addPokemon {
