      if not poke.has_enhancement(step.card, 'm_stone') then return end
      for _, c in ipairs(step.hand.playedCards) do
        if poke.has_enhancement(c, 'm_stone') then
          if c == step.card then return poke.get(card, 'retriggers') end
          return
