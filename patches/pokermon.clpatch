      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'ursaring', poke.get(card, 'mult'), 12) end,
}

