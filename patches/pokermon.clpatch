---------------------------------------------------------------------------
-- Baltoy 343 (the original shows its first lines with a custom UI; the text is written out here)
---------------------------------------------------------------------------
local function hazard_chip_gain(card, state, step, result)
  if step.copiedBy or not poke.has_enhancement(step.card, HAZARD) then return end
  local low = math.floor(poke.get(card, 'chip_mod'))
  local high = math.max(low, math.floor(poke.get(card, 'chip_mod1')))
  local gain = state:random(low, high)
  poke.add(card, 'chips', gain)
  result:say('+' .. gain .. ' Points', colors.CHIPS)
end

poke.addPokemon {
  name = 'baltoy', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Earth', gen = 3,
  config = { chips = 0, chip_mod = 1, chip_mod1 = 6, hazard_level = 1 },
  evo_rqmt = 40,
  attributes = { 'hazards', 'discard', 'enhancements', 'chips', 'scaling', 'scaling_evo' },
  text = { '{C:poke_hazard}+#2#{} hazard layer', '{br:2}x', 'Gains {C:chips}+#4#-#5#{} Chips for each', 'discarded {C:attention}Hazard{} card',
    '{C:inactive}(Evolves at {C:chips}+#1#{C:inactive} / #3# Chips)' },
  vars = function(get)
    return { get('chips'), get('hazard_level'), 40, math.floor(get('chip_mod')), math.floor(get('chip_mod1')) }
  end,
  passives = { hazard_level = 'hazard_level' },
  triggers = {
    onDiscardCard = function(card, state, step, result) hazard_chip_gain(card, state, step, result) end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'claydol', poke.get(card, 'chips'), 40) end,
}

-- Claydol 344: discarded Hazard cards come back to the hand. Cardlike cannot move a discarded card, so the card is
-- destroyed and an exact copy joins the hand.
poke.addPokemon {
  name = 'claydol', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Earth', gen = 3,
  config = { chips = 0, chip_mod = 1, chip_mod1 = 8, hazard_level = 1, num = 1, dem = 3 },
  attributes = { 'hazards', 'discard', 'enhancements', 'chips', 'scaling', 'chance' },
  text = { '{C:poke_hazard}+#2#{} hazard layer', '{br:2}x', 'Gains {C:chips}+#5#-#6#{} Chips for each', 'discarded {C:attention}Hazard{} card',
    '{br:2}x', '{C:green}#3# in #4#{} chance for', 'discarded {C:attention}Hazard{} cards', 'to be returned to {C:attention}hand',
    '{C:inactive}(Currently {C:chips}+#1#{C:inactive} Chips)' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('chips'), get('hazard_level'), num, dem, math.floor(get('chip_mod')), math.floor(get('chip_mod1')) }
  end,
  passives = { hazard_level = 'hazard_level' },
  triggers = {
    onDiscardCard = function(card, state, step, result)
      hazard_chip_gain(card, state, step, result)
      if step.copiedBy or not poke.has_enhancement(step.card, HAZARD) then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        local info = step.card:info() or step.card.lastInfo or {}
        returned[step.card.uid] = true
        local copy = cardlike.addPlayingCard({ rank = info.rank, suit = info.suit, enhancement = info.enhancement,
          edition = info.edition ~= 'default' and info.edition or nil, stamp = info.stamp, bonusPoints = info.bonusPoints }, { area = 'hand' })
        if copy then copy:popup('Returned!', poke.colours.hazard) end
        return true
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

