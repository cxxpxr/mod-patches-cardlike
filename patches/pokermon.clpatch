== file content/backs.lua (140 lines)
-- Decks (original backs/backs1.lua). Deck rules that last the whole run are run modifiers (poke.set_modifier) that
-- content/rules.lua enforces. The file returns the deck effects, which the Mystery Dungeon challenge also uses.
local poke = cardlike.require('lib.pokermon')

local function name(key, fallback) return poke.text.name('Back', 'b_poke_' .. key, fallback) end
local function text(key, vars) return poke.text.describe('Back', 'b_poke_' .. key, vars) end
local function dict(key, fallback) return poke.text.dict(key, fallback) end
local function art(x) return poke.sprites.at('decks', x, 0) end

local STADIUM = { 'Chipped', 'Multicard', 'Plaid', 'Fragile', 'Wooden', 'Rock', 'Gilded', 'Paperback' }

-- A standard 52 card deck, with a function to change each card.
local function standard_cards(change)
  local list = {}
  for _, suit in ipairs(poke.SUITS) do
    for rank = 2, 14 do
      local c = { rank = rank, suit = suit }
      if change then change(c, #list + 1) end
      list[#list + 1] = c
    end
  end
  return list
end

-- Give every playing card a stamp now (used when the deck is applied by the Mystery Dungeon challenge).
local function stamp_all(state, stamp)
  for _, c in ipairs(state.allCards or {}) do c:setStamp(stamp) end
end

-- Deck effects by deck id: function(state). Kept in a table so that the Mystery Dungeon challenge can apply one.
local effects = {}

effects.pokemondeck = function(state)
  cardlike.redeemTicket('goodrod')
  cardlike.createConsumable('pokeball', { force = true })
end

effects.luminousdeck = function(state)
  poke.set_modifier('apply_type', true)
end

effects.telekineticdeck = function(state)
  cardlike.redeemTicket('ticket_8') -- Pro Gamer (Balatro Crystal Ball)
  cardlike.createConsumable('twisted_spoon', { force = true })
  cardlike.createConsumable('twisted_spoon', { force = true })
end

effects.ampeddeck = function(state)
  cardlike.redeemTicket('energysearch')
  cardlike.createConsumable('double_rainbow_energy', { force = true })
end

effects.futuredeck = function(state)
  poke.scry.add(4)
end

effects.stadiumdeck = function(state, from_challenge)
  if not from_challenge then return end -- the deck's own card list does it
  local cards = state.allCards or {}
  for i = 1, math.min(#cards, #STADIUM) do cards[i]:setEnhancement(STADIUM[i]) end
end

effects.megadeck = function(state)
  cardlike.redeemTicket('ticket_6') -- Reroll Sale (Balatro Reroll Surplus)
  cardlike.redeemTicket('ticket_7') -- Infiniroll (Balatro Reroll Glut)
  cardlike.redeemTicket('ticket_8') -- Pro Gamer (Balatro Crystal Ball)
  cardlike.createConsumable('megastone', { force = true })
  state.cardsAvailableInShopCount = math.max(1, state.cardsAvailableInShopCount - 1)
end

effects.vendingdeck = function(state)
  poke.set_modifier('vending', true)
end

effects.diceydeck = function(state, from_challenge)
  poke.change_hazard_max(1)
  poke.change_hazard_level(1)
  state.handSize = state.handSize + 1
  poke.set_modifier('enhance_bonus', poke.HAZARD_ID)
  poke.set_modifier('money_per_enhancement', 1)
  poke.set_modifier('enhance_bonus_text', dict('poke_hazards_in_deck', 'Hazards in Deck'))
  -- the deck itself has noInterest; the Mystery Dungeon challenge needs the rule
  if from_challenge then poke.set_modifier('no_interest', true) end
end

effects.obituarydeck = function(state, from_challenge)
  poke.set_modifier('force_seal', poke.MOD_ID .. ':pink_seal')
  if from_challenge then stamp_all(state, poke.MOD_ID .. ':pink_seal') end
end

effects.revenantdeck = function(state, from_challenge)
  poke.set_modifier('force_seal', poke.MOD_ID .. ':silver')
  if from_challenge then stamp_all(state, poke.MOD_ID .. ':silver') end
end

local function deck(id, x, description, extra)
  local def = {
    id = id,
    name = name(id, id),
    description = description,
    sprite = art(x),
    onRunStart = function(ctx) effects[id](ctx.state, false) end,
  }
  for k, v in pairs(extra or {}) do def[k] = v end
  cardlike.addDeck(def)
end

deck('pokemondeck', 0, text('pokemondeck', { dict('goodrod_variable', 'Good Rod'), dict('pokeball_variable', 'Pokeball') }))
deck('luminousdeck', 1, text('luminousdeck'))
deck('telekineticdeck', 3, text('telekineticdeck', { 'Pro Gamer', dict('twisted_spoon_variable', 'Twisted Spoon') }), { credits = 'Art: MyDude_YT' })
deck('ampeddeck', 4, text('ampeddeck', { 'Energy Search', dict('double_rainbow_energy_variable', 'Double Rainbow Energy') }), { credits = 'Art: MyDude_YT' })
deck('futuredeck', 6, text('futuredeck', { 4 }), { credits = 'Art: Catzzadilla' })
deck('stadiumdeck', 8, 'Deck starts with a ' .. colorize('Chipped, Multicard, Plaid, Fragile, Wooden, Rock, Gilded', colors.ORANGE)
  .. ' and ' .. colorize('Paperback', colors.ORANGE) .. ' card', {
  credits = 'Art: InertSteak',
  cards = standard_cards(function(c, i) if STADIUM[i] then c.enhancement = STADIUM[i] end end),
})
deck('megadeck', 9, text('megadeck', { dict('megastone_variable', 'Mega Stone'), 'Reroll Sale', 'Infiniroll', 1, 'Pro Gamer' }),
  { credits = 'Art: Catzzadilla, Sonfive' })
deck('vendingdeck', 7, text('vendingdeck', { 'Sticky Note Pin' }))
deck('diceydeck', 10, text('diceydeck', { 1, 1, 1, 1 }), { credits = 'Art: Catzzadilla', noInterest = true })

-- Legacy decks (setting pokemon_legacy, applies after a reload).
if poke.settings.pokemon_legacy then
  deck('obituarydeck', 2, text('obituarydeck', { dict('pinkseal_variable', 'Pink Seal') }), {
    cards = standard_cards(function(c) c.stamp = poke.MOD_ID .. ':pink_seal' end),
  })
  deck('revenantdeck', 5, text('revenantdeck', { dict('silverseal_variable', 'Silver Seal') }), {
    credits = 'Art: Sonfive',
    cards = standard_cards(function(c) c.stamp = poke.MOD_ID .. ':silver' end),
  })
end

-- The non-legacy deck effects, for the Mystery Dungeon challenge (content/challenges.lua).
return {
  effects = effects,
  mystery_list = { 'pokemondeck', 'luminousdeck', 'telekineticdeck', 'ampeddeck', 'futuredeck', 'stadiumdeck', 'megadeck',
    'vendingdeck', 'diceydeck' },
}


== file content/base.lua (43 lines)
-- Rarities, consumable types, sounds and music.
local P = cardlike.require('lib.pokermon')

-- Mod rarities: Safari (evolved forms) and Mega. Their jokers never roll in the shop (lib/registry.lua removes them
-- from the joker pools); `like` only sets the look and the sell price rules.
cardlike.addRarity { id = P.RARITY_SAFARI, like = 'Rare' }
cardlike.addRarity { id = P.RARITY_MEGA, like = 'Legendary' }

cardlike.addConsumableType { id = 'energy', readableName = 'Energy', color = '#4aba8d', shopWeight = 1.5 }
cardlike.addConsumableType { id = 'item', readableName = 'Item', color = '#9aa4b7', shopWeight = 3 }

cardlike.addSound { id = 'e_shiny', file = 'sounds/e_shiny.ogg', volume = 0.4 }
cardlike.addSound { id = 'energy_use', file = 'sounds/energy_use.ogg' }
cardlike.addSound { id = 'shellchomp', file = 'sounds/chomp.ogg' }
for i = 1, 5 do cardlike.addSound { id = 'seed_' .. i, file = 'sounds/seed_' .. i .. '.ogg' } end
cardlike.addSound { id = 'ludicolo_cry', file = 'sounds/ludicolo.ogg' }
cardlike.addSound { id = 'pocket_music_high', file = 'sounds/pocket_music_high.ogg', volume = 0.5 }
cardlike.addSound { id = 'pocket_music_high_knockoff', file = 'sounds/pocket_music_high_knockoff.ogg', volume = 0.5 }
cardlike.addSound { id = 'pocket_music_low', file = 'sounds/pocket_music_low.ogg', volume = 0.5 }
cardlike.addSound { id = 'voltorb_flip_music', file = 'sounds/voltorb_flip_music.ogg', volume = 0.5 }
cardlike.addSound { id = 'miror_b_music', file = 'sounds/miror_b_music.ogg', volume = 0.5 }

-- Pack music: Pocket and Starter packs play their own music while they are open (Balatro select_music_track).
P.pack_music = P.pack_music or {}  -- pack id -> sound id; lib users can add entries
local playing
cardlike.on('onPackOpened', function(state, step)
  local id = step.card and step.card:getConsumableDef()
  local music = id and P.pack_music[id]
  if music then
    cardlike.playSound(music, { loop = true, channel = 'poke_pack_music' })
    playing = true
  end
end)
local function stop_music()
  if playing then
    cardlike.stopSound('poke_pack_music')
    playing = false
  end
end
cardlike.onFrame(function(frame)
  if playing and not cardlike.state:isPhase('pack') then stop_music() end
end)


== file content/blinds.lua (213 lines)
-- Boss blinds (original blinds/pokebossblind.lua). The Magma and The Aqua are defined there but never registered,
-- so they are not ported.
local poke = cardlike.require('lib.pokermon')

local function name(key, fallback) return poke.text.name('Blind', 'bl_poke_' .. key, fallback) end
local function text(key, vars) return poke.text.describe('Blind', 'bl_poke_' .. key, vars) end
local function full(id) return poke.MOD_ID .. ':' .. id end
local function active(state, id) return state.blind and state.blind.id == full(id) and not state.bossDisabled end

-- Jokers debuffed by a blind keep a mark, so they come back when the blind ends (also after a reload).
local MARK = 'poke_blind_debuff'
local function debuff_joker(j)
  if not j:getDebuffState() then
    j:getDataStore():set(MARK, true)
    j:setDebuffState(true)
    j:punch()
  end
end
local function restore_jokers(state)
  for _, j in ipairs(state.jokers or {}) do
    local ds = j:getDataStore()
    if ds:get(MARK) then
      ds:delete(MARK)
      if not ds:get('poke_fainted') then j:setDebuffState(false) end
    end
  end
end

local function random_types(state, amount)
  local list = poke.shuffle(poke.deep_copy(poke.TYPES), state)
  local out = {}
  for i = 1, amount do out[i] = list[i] end
  return out
end

-- Blinds that debuff jokers of random types: the types are picked when the blind starts and when a hand is played,
-- and apply from the next draw.
local pending = {}   -- blind id -> types to apply at the next draw
local current = {}   -- blind id -> types in effect
local function apply_types(state, id)
  local types = pending[id]
  if not types then return end
  pending[id] = nil
  current[id] = types
  restore_jokers(state)
  local set = poke.convert_to_set(types)
  for _, j in ipairs(state.jokers or {}) do
    local t = poke.get_type(j)
    if t and set[t] then debuff_joker(j) end
  end
end

-- The Mirror: the rightmost joker turns into Ditto at the start of the round.
cardlike.addBlind {
  id = 'mirror',
  name = name('mirror', 'The Mirror'),
  description = text('mirror'),
  color = '#c57be6',
  minAnte = 3,
  mult = 2,
  reward = 5,
  sprite = poke.sprites.at('blinds', 0, 1),
  credits = 'Art: InertSteak',
}

-- The Rocket: cards are drawn face down while you have $25 or more.
cardlike.addBlind {
  id = 'rocket',
  name = name('rocket', 'The Rocket'),
  description = text('rocket'),
  color = '#c90000',
  minAnte = 2,
  mult = 2,
  reward = 5,
  sprite = poke.sprites.at('blinds', 0, 2),
  credits = 'Art: Catzzadilla',
}

-- The Star: a random type is debuffed every hand.
cardlike.addBlind {
  id = 'star',
  name = name('star', 'The Star'),
  description = text('star'),
  color = '#d9b673',
  minAnte = 3,
  mult = 2,
  reward = 5,
  sprite = poke.sprites.at('blinds', 0, 24),
  credits = 'Art: Catzzadilla',
  onRoundStart = function(state) pending[full('star')] = random_types(state, 1) end,
  onPressPlay = function(state) pending[full('star')] = random_types(state, 1) end,
  onDefeated = function(state) pending[full('star')] = nil; current[full('star')] = nil; restore_jokers(state) end,
}

-- Gray Godfather: -$5 when a hand is played or discarded, then a random joker is destroyed if you are in debt.
local GODFATHER_DOLLARS = 5
local function godfather_pay(state)
  state:mutateMoney(-GODFATHER_DOLLARS)
  if state.money < 0 then
    local options = {}
    for _, j in ipairs(state.jokers or {}) do if not j:isLocked() then options[#options + 1] = j end end
    local target = poke.random_element(options, state)
    if target then target:destroy() end
  end
end
cardlike.addBlind {
  id = 'gray_godfather',
  name = name('gray_godfather', 'Gray Godfather'),
  description = text('gray_godfather', { GODFATHER_DOLLARS }),
  color = '#b3b3b3',
  minAnte = 8,
  finisher = true,
  mult = 2,
  reward = 8,
  sprite = poke.sprites.at('blinds', 0, 3),
  onPressPlay = function(state) if not state.bossDisabled then godfather_pay(state) end end,
}

-- White Executive: when the blind starts, debuffs as many deck cards as the total sell value of your jokers and
-- consumables.
local function executive_total(state)
  local total = 0
  if not state or state.money == nil then return 0 end
  for _, list in ipairs({ state.jokers or {}, state.consumables or {} }) do
    for _, c in ipairs(list) do total = total + (c:getSellValue() or 0) end
  end
  return math.floor(total)
end
local executive_debuffed = {}
cardlike.addBlind {
  id = 'white_executive',
  name = name('white_executive', 'White Executive'),
  description = function(r) return text('white_executive', { executive_total(cardlike.state) }) end,
  color = '#e8e8f8',
  minAnte = 8,
  finisher = true,
  mult = 2,
  reward = 8,
  sprite = poke.sprites.at('blinds', 0, 4),
  onRoundStart = function(state)
    executive_debuffed = {}
    local picks = poke.pseudorandom_multi({ array = state.allCards or {}, amt = executive_total(state) }, state)
    for _, c in ipairs(picks) do executive_debuffed[c.uid] = true end
  end,
  shouldDebuff = function(state, card)
    return not state.bossDisabled and executive_debuffed[card.uid] == true
  end,
  onDefeated = function(state) executive_debuffed = {} end,
}

-- Iridescent Hacker: 1 to 3 random types are debuffed every hand.
local function hacker_types(state)
  local r = state:randomFloat()
  local n = 1
  if r > .66 then n = n + 1 end
  if r > .33 then n = n + 1 end
  return random_types(state, n)
end
cardlike.addBlind {
  id = 'iridescent_hacker',
  name = name('iridescent_hacker', 'Iridescent Hacker'),
  description = text('iridescent_hacker'),
  color = '#505860',
  minAnte = 8,
  finisher = true,
  mult = 2,
  reward = 8,
  sprite = poke.sprites.at('blinds', 0, 25),
  credits = 'Art: Catzzadilla',
  onRoundStart = function(state) pending[full('iridescent_hacker')] = hacker_types(state) end,
  onPressPlay = function(state) pending[full('iridescent_hacker')] = hacker_types(state) end,
  onDefeated = function(state)
    pending[full('iridescent_hacker')] = nil
    current[full('iridescent_hacker')] = nil
    restore_jokers(state)
  end,
}

-- Draw-time effects: type debuffs, The Mirror, The Rocket.
local seen_in_hand = {}
cardlike.on('onHandDrawn', function(state, step)
  if state.bossDisabled then
    restore_jokers(state)
    return
  end
  for _, id in ipairs({ 'star', 'iridescent_hacker' }) do
    if active(state, id) then apply_types(state, full(id)) end
  end
  if step.first and active(state, 'mirror') then
    local jokers = state.jokers or {}
    local target = jokers[#jokers]
    if target and poke.def('ditto') then
      if target:isLocked() then target:setLocked(false) end
      poke.change_form(target, 'ditto', poke.text.dict('poke_transform_success', 'Transformed!'), state)
    end
  end
  if step.first then seen_in_hand = {} end
  local rocket = active(state, 'rocket') and (state.money or 0) >= 25
  for _, c in ipairs(state.cardsInHand or {}) do
    if not seen_in_hand[c.uid] then
      seen_in_hand[c.uid] = true
      if rocket and not c:isFlipped() then c:flip(true) end
    end
  end
end)

cardlike.on('onDiscard', function(state, step)
  if active(state, 'gray_godfather') then godfather_pay(state) end
end)

-- A blind that is turned off lets its jokers go.
cardlike.on('onBlindDefeated', function(state) restore_jokers(state) end)


== file content/boosters.lua (176 lines)
-- Packs: Pocket Packs (Item and Energy cards), the Wish Pack (Jirachi) and the Starter Packs.
-- Original file: boosters/packs1.lua.
--
-- Cardlike packs let you pick 1 card and show 2 or 4 cards, so Jumbo and Mega Pocket Packs show 4 cards like the
-- normal ones (the Mega pack's "choose 2" is choose 1).
local poke = cardlike.require('lib.pokermon')

local ITEM = poke.MOD_ID .. ':item'
local ENERGY = poke.MOD_ID .. ':energy'

-- Rare cards that can replace a card of their type (Balatro soul_rate).
local ITEM_SOULS = { { 'ultraball', 0.008 }, { 'masterball', 0.003 }, { 'megastone', 0.006 } }
local ENERGY_SOULS = { { 'transformation', 0.025 } }

local function soul(state, list)
  for _, s in ipairs(list) do
    local id = poke.items.id(s[1])
    if state:randomFloat() < s[2] and cardlike.contentInfo('consumable', id) then return { consumable = id } end
  end
  return nil
end

local function owned(state, id)
  for _, c in ipairs(state.consumables or {}) do if c:getConsumableDef() == id then return true end end
  return false
end

local function energy_card(state)
  local s = soul(state, ENERGY_SOULS)
  if s then return s end
  local rainbow = poke.items.id('double_rainbow_energy')
  if state:randomFloat() < 0.10 and cardlike.contentInfo('consumable', rainbow) then return { consumable = rainbow } end
  if state:randomFloat() > 0.5 then
    -- an Energy card that matches one of your jokers, if you do not hold it yet
    local options = {}
    for _, j in ipairs(state.jokers or {}) do
      local id = poke.energy.get_matching_energy(j)
      if id and not owned(state, id) and cardlike.contentInfo('consumable', id) then options[#options + 1] = id end
    end
    if #options > 0 then return { consumable = options[state:random(1, #options)] } end
  end
  return { consumableType = ENERGY }
end

local function item_card(state)
  local s = soul(state, ITEM_SOULS)
  if s then return s end
  if state:randomFloat() > 0.92 then
    local evo = poke.poll_evo_item(state)
    if evo then return { consumable = evo } end
  end
  return { consumableType = ITEM }
end

-- A Mega Pocket Pack from the Pocket Pin can hold a Mega Stone from Ante 5 on.
local function pocket_cards(state, count, pack)
  local from_pin = poke.run.vars.pocket_pack_from_pin
  poke.run.vars.pocket_pack_from_pin = nil
  local cards = {}
  for i = 1, count do
    if i == 1 then
      cards[i] = poke.modifier('no_energy') and item_card(state) or energy_card(state)
    elseif i == 2 and from_pin and (state.ante or 0) >= 5 and not owned(state, poke.items.id('megastone')) and state:randomFloat() > 0.75 then
      cards[i] = { consumable = poke.items.id('megastone') }
    else
      cards[i] = item_card(state)
    end
  end
  return cards
end

local POCKET = {
  { key = 'pokepack_normal_1', pos = { 0, 0 }, price = 4, weight = 5 },
  { key = 'pokepack_normal_2', pos = { 1, 0 }, price = 4, weight = 5 },
  { key = 'pokepack_normal_3', pos = { 0, 1 }, price = 4, weight = 5 },
  { key = 'pokepack_normal_4', pos = { 1, 1 }, price = 4, weight = 5 },
  { key = 'pokepack_jumbo_1', pos = { 2, 0 }, price = 6, weight = 5 },
  { key = 'pokepack_jumbo_2', pos = { 2, 1 }, price = 6, weight = 5 },
  { key = 'pokepack_mega_1', pos = { 3, 0 }, price = 8, weight = 1.5 },
  { key = 'pokepack_mega_2', pos = { 3, 1 }, price = 8, weight = 1.5 },
}

for _, p in ipairs(POCKET) do
  local id = cardlike.addPack {
    id = p.key,
    readableName = poke.text.name('Other', 'p_poke_' .. p.key),
    price = p.price,
    cardsShown = 4,
    shopWeight = p.weight,
    kind = 'game',
    opensDeck = true,
    sprite = poke.sprites.at('boosters', p.pos[1], p.pos[2]),
    description = function(r) return poke.text.describe('Other', 'p_poke_' .. p.key, { 1, 3, 1 }) end,
    getCards = pocket_cards,
  }
  poke.pack_music[id] = 'pocket_music_high'
end

-- Wish Pack: 3 different wishes for Jirachi (opened by the Jirachi Pin).
local WISHES = { 'fake_banker', 'fake_booster', 'fake_power', 'fake_copy', 'fake_fixer' }

cardlike.addPack {
  id = 'pokepack_wish_pack',
  readableName = poke.text.name('Other', 'p_poke_pokepack_wish_pack'),
  price = 999,
  cardsShown = 4, -- the original shows 3; Cardlike shows 2 or 4
  shopWeight = 0,
  kind = 'admin',
  sprite = poke.sprites.at('boosters', 4, 0),
  credits = 'Art: Catzzadilla',
  description = function(r) return poke.text.describe('Other', 'p_poke_pokepack_wish_pack', {}) end,
  getCards = function(state, count, pack)
    local options = {}
    for _, w in ipairs(WISHES) do options[#options + 1] = poke.items.id(w) end
    poke.shuffle(options, state)
    local cards = {}
    for i = 1, count do cards[i] = { consumable = options[(i - 1) % #options + 1] } end
    return cards
  end,
}

-- Starter Packs: one Grass, Fire and Water starter and one extra Pokemon (Pikachu or Eevee; Bidoof or Yamper for
-- the "...?" pack). A pseudo-legendary line would be the fifth card, but Cardlike packs show at most 4.
local function starter_cards(knockoff)
  return function(state, count, pack)
    local groups = { Grass = {}, Fire = {}, Water = {}, extra = {} }
    local extra_names = knockoff and { bidoof = true, yamper = true } or { pikachu = true, eevee = true }
    for _, def in ipairs(poke.pokemon_list) do
      if not poke.family_present(def, state) and poke.get_gen_allowed(def) then
        local is_starter = knockoff and def.knockoff_starter or (not knockoff and def.starter)
        if is_starter and groups[def.ptype or ''] then table.insert(groups[def.ptype], def.id) end
        if extra_names[def.name] then table.insert(groups.extra, def.id) end
      end
    end
    local order = { 'Grass', 'Fire', 'Water', 'extra' }
    local cards = {}
    for i = 1, count do
      local list = groups[order[i] or 'extra']
      if list and #list > 0 then
        cards[i] = { joker = list[state:random(1, #list)] }
      elseif poke.def('caterpie') then
        cards[i] = { joker = poke.id('caterpie') }
      else
        cards[i] = { jokerRarity = 'Common' }
      end
    end
    return cards
  end
end

local starter = cardlike.addPack {
  id = 'pokepack_starter_pack',
  readableName = poke.text.name('Other', 'p_poke_pokepack_starter_pack'),
  price = 6,
  cardsShown = 4,
  shopWeight = 0,
  kind = 'fool',
  sprite = poke.sprites.at('boosters', 4, 1),
  description = function(r) return poke.text.describe('Other', 'p_poke_pokepack_starter_pack', { 1, 4 }) end,
  getCards = starter_cards(false),
}
poke.pack_music[starter] = 'pocket_music_high'

local starterq = cardlike.addPack {
  id = 'pokepack_starterq_pack',
  readableName = poke.text.name('Other', 'p_poke_pokepack_starterq_pack'),
  price = 6,
  cardsShown = 4,
  shopWeight = 0,
  kind = 'fool',
  sprite = poke.sprites.at('boosters', 4, 1),
  description = function(r) return poke.text.describe('Other', 'p_poke_pokepack_starterq_pack', { 1, 4 }) end,
  getCards = starter_cards(true),
}
poke.pack_music[starterq] = 'pocket_music_high_knockoff'


