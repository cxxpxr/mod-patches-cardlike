-- Clefairy 035
poke.addPokemon {
  name = 'clefairy', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Fairy', gen = 1,
  item_req = 'moonstone',
  config = { mult = 3, suit = 'Clubs' },
