---------------------------------------------------------------------------
-- Pidgey line: Mult for each different rank and suit in the scoring cards
---------------------------------------------------------------------------

local function pidgey_def(name, rarity, cost, stage, mult_mod, rounds, into)
  return {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Colorless', gen = 1,
    config = { mult_mod = mult_mod, rounds = rounds },
    megas = stage == 'Two' and { 'mega_pidgeot' } or nil,
    attributes = into and { 'rank', 'suit', 'mult', 'round_evo' } or { 'rank', 'suit', 'mult' },
    -- Pidgey and Pidgeotto: #1# rounds, #2# mult. Pidgeot: #1# mult.
    vars = function(get)
      if into then return { get('rounds'), get('mult_mod') } end
      return { get('mult_mod') }
    end,
    triggers = {
      afterAllCardsScored = function(card, state, step, result)
        local n = ranks_and_suits(step.hand.playedCards or {})
        if n > 0 then result:add(plusMult(poke.get(card, 'mult_mod') * n)) end
      end,
    },
    evolution = into and function(card, state) return poke.level_evo(card, state, into) end or nil,
  }
end

