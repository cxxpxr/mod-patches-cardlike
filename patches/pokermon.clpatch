  attributes = { 'mult', 'face' },
  vars = function(get, card, state)
    return { get('mult'), get('mult_mod'), math.max(0, mud_total(get, state)), get('rerolls') }
  end,
  triggers = { afterAllCardsScored = mud_main },
}

-- Espeon 196: X Mult if the top card of the deck (the next card drawn) is this round's suit.
poke.addPokemon {
  name = 'espeon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Psychic', gen = 2,
  config = { scry = 2, Xmult = 2.5 },
  attributes = { 'xmult', 'suit' },
  vars = function(get)
    local suit = poke.round_target('espeon_suit', 'Spades')
    return { get('scry'), get('Xmult'), poke.suit_name(suit), colours = { poke.suit_colour(suit) } }
  end,
  passives = { scry = 'scry' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local deck = state.unDrawnCards or {}
      local top = deck[#deck]
      if top and top:isSuit(poke.round_target('espeon_suit', 'Spades')) then result:add(xMult(poke.get(card, 'Xmult'))) end
    end,
  },
}

-- Umbreon 197
poke.addPokemon {
  name = 'umbreon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Dark', gen = 2,
  blueprint_compat = false,
  config = { hand_played = 'HIGH_CARD' },
  attributes = { 'discard', 'hand_type' },
  vars = function(get)
    local h = get('hand_played')
    return { h and poke.hand_name(h) or poke.text.dict('poke_none', 'None') }
  end,
  onAdded = function(card, state)
    if not poke.get(card, 'umbreon_init') then
      poke.set(card, 'umbreon_init', true)
      poke.set(card, 'hand_played', poke.random_element(poke.visible_hands(state), state) or 'HIGH_CARD')
    end
  end,
  triggers = {
    afterHand = function(card, state, step, result)
      if step.copiedBy then return end
      local list = poke.visible_hands(state)
      local cur = poke.get(card, 'hand_played')
      for i, h in ipairs(list) do
        if h == cur then
          poke.set(card, 'hand_played', list[i % #list + 1])
          return
        end
      end
      poke.set(card, 'hand_played', list[1])
    end,
    -- Only the first discard of the round counts (the round is remembered when it happens).
    onDiscardCard = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, 'umbreon_round') == state.round then return end
      poke.set(card, 'umbreon_round', state.round)
      if #(step.discardedCards or {}) ~= 1 then return end
      local h = poke.get(card, 'hand_played')
      state:upgradeHand(h, 1)
      result:say('Level up!', colors.ORANGE)
      return true
    end,
  },
}

