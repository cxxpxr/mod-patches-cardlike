  id = 'energyresearch',
  readableName = name('v_poke_energyresearch', 'Energy Research'),
  description = text('v_poke_energyresearch'),
  sprite = poke.sprites.at('vouchers', 3, 0),
  price = 10,
  precursor = 'energysearch',
  action = function(ctx) poke.run.energy_plus = (poke.run.energy_plus or 0) + 3 end,
