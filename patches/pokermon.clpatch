}

-- Gothitelle 576: Fruit cards and Fruit Packs in the shop are free. Earn $2 when a Fruit card is used.
poke.addPokemon {
  name = 'gothitelle',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Psychic',
  gen = 5,
  config = { money = 2 },
  attributes = { 'passive', 'planet', 'economy', 'space' },
  vars = function(get) return { get('money') } end,
  triggers = {
    onConsumableUsed = function(card, state, step, result)
      local used = step.card
      local t = used and ((used.lastInfo or {}).type or used:getConsumableType())
      if t == 'fruit' then
        result:add(plusMoney(poke.ease_poke_dollars(card, 'gothitelle', poke.get(card, 'money'), true, state)))
      end
    end,
  },
}

-- Vanillite line: +Points, -10 Points after each hand in which it scored. Melts (is destroyed) at 0.
local function melt_triggers(volatile, on_melt)
  return {
    afterAllCardsScored = function(card, state, step, result)
      if not poke.volatile_active(card, volatile, state) then return end
      poke.set(card, 'triggered', true)
      result:add(plusChips(poke.get(card, 'chips')))
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy or not poke.get(card, 'triggered') then return end
      poke.set(card, 'triggered', false)
      local chips, minus = poke.get(card, 'chips'), poke.get(card, 'chips_minus')
      if chips - minus <= 0 then
        if on_melt then on_melt(card, state) end
        result:say('Melted!', colors.CHIPS)
        result:destroySelf()
      else
        poke.set(card, 'chips', chips - minus)
        result:say('-' .. poke.text.num(minus), colors.CHIPS)
      end
    end,
  }
end

-- Vanillite 582: Volatile Left. +60 Points, -10 Points for every hand played. Evolves after 3 rounds.
poke.addPokemon {
  name = 'vanillite',
  rarity = 1,
  cost = 5,
  stage = 'Basic',
  ptype = 'Water',
  gen = 5,
  config = { chips = 60, chips_minus = 10, rounds = 3, triggered = false, volatile = 'left' },
  attributes = { 'chips', 'scaling', 'food', 'volatile', 'round_evo' },
  vars = function(get) return { get('chips'), get('rounds'), get('chips_minus') } end,
  triggers = melt_triggers('left'),
  evolution = function(card, state) return poke.level_evo(card, state, 'vanillish') end,
}

