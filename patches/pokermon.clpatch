  attributes = { 'holding', 'passive', 'applies' },
  splash = true,
  onAdded = function(card, state) poke.holding(card, 'heartscale', state) end,
}

-- The Bagon line: Mult for each Straight played this run.
local function straights_played(state)
  if not state or not state.getHand then return 0 end
  local h = state:getHand('STRAIGHT')
  return h and h.played or 0
end

local function straight_mult(card, state, result)
  local total = straights_played(state) * poke.get(card, 'mult_mod')
  if total > 0 then result:add(plusMult(total)) end
end

-- Bagon 371: -1 hand size. +3 Mult for each Straight played this run. Evolves after playing 5 Straights.
poke.addPokemon {
  name = 'bagon',
  rarity = 2,
  cost = 6,
  stage = 'Basic',
  ptype = 'Dragon',
  gen = 3,
  pseudol = true,
  config = { mult_mod = 3, h_size = 1, triggers = 0 },
  evo_rqmt = 5,
  attributes = { 'mult', 'hand_type', 'condition_evo' },
  vars = function(get, card, state)
    return { get('mult_mod'), get('h_size'), math.max(0, 5 - get('triggers')), straights_played(state) * get('mult_mod') }
  end,
  passives = { hand_size = '-h_size' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.copiedBy and step.hand.handType == 'STRAIGHT' then poke.add(card, 'triggers', 1) end
      straight_mult(card, state, result)
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'shelgon', poke.get(card, 'triggers'), 5)
  end,
}

-- Shelgon 372: -2 hand size. +3 Mult for each Straight played this run. A Straight takes 1 round off the rounds to
-- evolve. Evolves after 8 rounds.
poke.addPokemon {
  name = 'shelgon',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Dragon',
  gen = 3,
  config = { mult_mod = 3, h_size = 2, rounds = 8 },
  attributes = { 'mult', 'hand_type', 'round_evo' },
  vars = function(get, card, state)
    return { get('mult_mod'), get('h_size'), get('rounds'), straights_played(state) * get('mult_mod') }
  end,
  passives = { hand_size = '-h_size' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.copiedBy and step.hand.handType == 'STRAIGHT' and poke.get(card, 'rounds') > 0 then
        poke.add(card, 'rounds', -1)
        result:say(poke.text.dict('poke_evolve_level', 'Level up!'), colors.ORANGE)
      end
      straight_mult(card, state, result)
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'salamence') end,
}

-- Salamence 373: when a blind starts, +1 hand size this round for every 5 Straights played this run. +5 Mult for
-- each Straight played this run.
poke.addPokemon {
  name = 'salamence',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Dragon',
  gen = 3,
  config = { mult_mod = 5, h_size = 2, h_size_temp = 1, divisor = 5 },
  attributes = { 'mult', 'hand_type', 'hand_type' },
  vars = function(get, card, state)
    return { get('mult_mod'), get('h_size'), get('h_size_temp'), get('divisor'), straights_played(state) * get('mult_mod') }
  end,
  triggers = {
    beforeRound = function(card, state, step, result)
      local n = math.floor(straights_played(state) / poke.get(card, 'divisor')) * poke.get(card, 'h_size_temp')
      if n > 0 then
        state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + n
        result:say('+' .. poke.text.num(n) .. ' Hand Size', colors.ORANGE)
      end
    end,
    afterAllCardsScored = function(card, state, step, result) straight_mult(card, state, result) end,
  },
}

-- The Beldum line: Points that grow with Four of a Kind and Aces.
local function metal_scaling(card, step, aces_needed)
  if step.copiedBy then return end
  if poke.get_ancient_amount(step.hand.playedCards, 14) >= aces_needed then poke.add(card, 'chips', poke.get(card, 'chip_mod')) end
  if step.hand.handType == 'FOUR_OF_A_KIND' then poke.add(card, 'chips', poke.get(card, 'chip_mod')) end
end

local function give_chips(card, result)
  local chips = poke.get(card, 'chips')
  if chips > 0 then result:add(plusChips(chips)) end
end

