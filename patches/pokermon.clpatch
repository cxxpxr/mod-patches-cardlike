  stage = 'One',
  ptype = 'Psychic',
  gen = 5,
  config = { hazard_level = 1, interval = 3, Xmult_multi = 1.3, num = 1, dem = 3 },
  attributes = { 'hazards', 'xmult', 'chance' },
  vars = function(get, card, state)
    return { get('hazard_level'), get('Xmult_multi'), poke.chance_num(get('num'), state), get('dem') }
  end,
  passives = { hazard_level = 'hazard_level' },
  triggers = { onScoreInHand = golem_trigger },
}

-- Pawniard / Bisharp: gain X0.25 Mult for each face card destroyed (removed from the deck).
local function faces_removed(step)
  local faces, kings = 0, 0
  for _, c in ipairs(step.cards or {}) do
    local info = c.lastInfo or {}
    if info.kind == nil or info.kind == 'playing' then
      if info.face then faces = faces + 1 end
      if info.rank == 13 and not info.noRank then kings = kings + 1 end
    end
  end
  return faces, kings
end

-- Pawniard 624: gains X0.25 Mult when a face card is destroyed. Evolves at X2 Mult.
poke.addPokemon {
  name = 'pawniard',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Metal',
  gen = 5,
  config = { Xmult = 1, Xmult_mod = 0.25 },
  evo_rqmt = 2,
  attributes = { 'xmult', 'face', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod'), 2 } end,
  triggers = {
    onCardsRemoved = function(card, state, step, result)
      if step.copiedBy then return end
      local faces = faces_removed(step)
      if faces > 0 then
        local x = poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * faces)
        result:say('X' .. poke.text.num(x) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'bisharp', poke.get(card, 'Xmult'), 2)
  end,
}

-- Bisharp 625: gains X0.25 Mult when a face card is destroyed. If the first hand of the round is a single face
-- card, destroy it. Evolves after destroying 3 Kings.
poke.addPokemon {
  name = 'bisharp',
  rarity = 'poke_safari',
  cost = 9,
  stage = 'One',
  ptype = 'Metal',
  gen = 5,
  config = { Xmult = 1, Xmult_mod = 0.25, kings_destroyed = 0 },
  evo_rqmt = 3,
  attributes = { 'xmult', 'face', 'hands', 'destroy_card', 'scaling', 'condition_evo' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod'), math.max(0, 3 - get('kings_destroyed')) } end,
  triggers = {
    onCardsRemoved = function(card, state, step, result)
      if step.copiedBy then return end
      local faces, kings = faces_removed(step)
      if kings > 0 then poke.add(card, 'kings_destroyed', kings) end
      if faces > 0 then
        local x = poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * faces)
        result:say('X' .. poke.text.num(x) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    destroyCard = function(card, state, step, result)
      if step.copiedBy then return end
      local all = step.hand and step.hand.allCards or {}
      -- the game counts the hand when Play is pressed, so the first hand of the round has handsPlayed 1
      if #all == 1 and all[1] == step.card and step.card:isFace() and (state.handsPlayed or 0) <= 1 then
        card:punch()
        return true
      end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'kingambit', poke.get(card, 'kings_destroyed'), 3)
  end,
}


== file jokers/pokejokers_22.lua (162 lines)
-- Pokermon jokers 631-660: Deino, Zweilous, Hydreigon, Bunnelby, Diggersby.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Drawn cards whose rank has no card left in the undrawn deck (the rank is depleted).
local function depleted_draws(state, step)
  local out = {}
  for _, c in ipairs(poke.drawn_cards(state, step)) do
    local info = c.lastInfo or {}
    if not info.noRank then
      local rank = info.rank or c:getRank()
      if poke.get_depleted(function(v) return poke.rank_of(v) == rank end, state) then out[#out + 1] = c end
    end
  end
  return out
end

local function is_three_of_a_kind(step)
  return step.hand and step.hand.handType == 'THREE_OF_A_KIND'
end

---------------------------------------------------------------------------
-- Deino 633
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'deino', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Dark', gen = 5,
  config = { Xmult = 1.5, hand_played = 0 },
  evo_rqmt = 8,
  attributes = { 'xmult', 'hand_type', 'trigger_evo' },
  vars = function(get) return { get('Xmult'), math.max(0, 8 - get('hand_played')) } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if is_three_of_a_kind(step) and not step.copiedBy then poke.add(card, 'hand_played', 1) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      if is_three_of_a_kind(step) then result:add(xMult(poke.get(card, 'Xmult'))) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'zweilous', poke.get(card, 'hand_played'), 8)
  end,
}

---------------------------------------------------------------------------
-- Zweilous 634
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'zweilous', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Dark', gen = 5,
  config = { Xmult = 2, hand_played = 0 },
  evo_rqmt = 10,
  attributes = { 'xmult', 'hand_type', 'trigger_evo' },
  vars = function(get) return { get('Xmult'), math.max(0, 10 - get('hand_played')) } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if is_three_of_a_kind(step) and not step.copiedBy then poke.add(card, 'hand_played', 1) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      if is_three_of_a_kind(step) then result:add(xMult(poke.get(card, 'Xmult'))) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'hydreigon', poke.get(card, 'hand_played'), 10)
  end,
}

---------------------------------------------------------------------------
-- Hydreigon 635: destroys the unscored cards of a Three of a Kind, gains X Mult for every destroyed playing card.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'hydreigon', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Dark', gen = 5,
  config = { Xmult = 3.33, Xmult_mod = 0.33 },
  attributes = { 'xmult', 'hand_type', 'destroy_card', 'scaling' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
      if is_three_of_a_kind(step) and not step.copiedBy then
        local scoring = {}
        for _, c in ipairs(step.hand.playedCards or {}) do scoring[c.uid] = true end
        for _, c in ipairs(step.hand.allCards or {}) do
          if not scoring[c.uid] then c:destroy() end
        end
      end
    end,
    -- Cardlike fires onCardsRemoved for every playing card that leaves the deck (destroyed or removed).
    onCardsRemoved = function(card, state, step, result)
      if step.copiedBy then return end
      local n = #(step.cards or {})
      if n > 0 then
        poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * n)
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      end
    end,
  },
}

