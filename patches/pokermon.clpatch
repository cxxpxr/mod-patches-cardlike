== file jokers/pokejokers_01.lua (693 lines)
-- Pokemon jokers 001 to 030 (Bulbasaur to Nidorina), from pokejokers_01.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Held cards of this round's rank earn money (Bulbasaur line). amount(card) gives the money for one card.
local function bulba_held(card, state, step, result, amount, count_earned)
  local info = step.card.lastInfo or {}
  if info.noRank or step.card:getRank() ~= poke.round_rank_id('bulb1card') then return end
  if step.card:getDebuffState() then
    result:say('Debuffed', colors.MULT, step.card)
    return
  end
  local n = amount()
  if count_earned and not step.copiedBy then poke.add(card, 'earned', n) end
  result:add(plusMoney(poke.ease_poke_dollars(card, 'bulba', n, true, state)))
end

-- Queens held in hand give Points (Nidoran F line).
local function queen_held(card, state, step, result)
  local info = step.card.lastInfo or {}
  if info.noRank or step.card:getRank() ~= 12 then return end
  if step.card:getDebuffState() then
    result:say('Debuffed', colors.MULT, step.card)
    return
  end
  result:add(plusChips(poke.get(card, 'chips')))
end

-- Number of different ranks plus different suits in the scoring cards (Pidgey line). A Plaid card counts for
-- every suit, a card with no rank adds no rank.
local function ranks_and_suits(cards)
  local suits = 0
  for _, s in ipairs(poke.all_suits()) do
    for _, c in ipairs(cards) do
      if c:isSuit(s) then suits = suits + 1; break end
    end
  end
  local ranks, seen = 0, {}
  for _, c in ipairs(cards) do
    local r = poke.rank_of(c)
    if r and not seen[r] then seen[r] = true; ranks = ranks + 1 end
  end
  return ranks + suits
end

-- The interest cap that Mega Raichu X jokers add.
local function mega_raichu_x_cap(state)
  local n = 0
  for _, j in ipairs(state.jokers or {}) do
    if poke.name(j) == 'mega_raichu_x' and not j:getDebuffState() then n = n + poke.get(j, 'interest_cap') end
  end
  return n
end

-- Mega Raichu X: +$25 interest cap. The extra interest shows as a line of the round rewards.
cardlike.filter('cashOut', function(total)
  local state = cardlike.state
  if not state or state.money == nil then return nil end
  local extra = mega_raichu_x_cap(state)
  if extra <= 0 then return nil end
  local more = poke.interest(state, extra) - poke.interest(state, 0)
  if more > 0 then return total + more end
end)

-- Spearow line: after drawing card_threshold cards, the next played hand gains a level.
local function spearow_draw(card, state, step, result)
  if step.copiedBy then return end
  local total = poke.get(card, 'cards_drawn') + #poke.drawn_cards(state, step)
  local threshold = poke.get(card, 'card_threshold')
  if total >= threshold then
    poke.set(card, 'upgrade', true)
    total = total % threshold
    card:punch()
    card:popup('Active!', colors.ORANGE)
  end
  poke.set(card, 'cards_drawn', total)
end

local function spearow_play(card, state, step, result, count_trigger)
  if not poke.get(card, 'upgrade') then return end
  if not step.copiedBy then
    poke.set(card, 'upgrade', false)
    if count_trigger then poke.add(card, 'triggers', 1) end
  end
  state:upgradeHand(step.hand.handType, 1)
  result:say('Level Up!', colors.ORANGE)
end

local function spearow_active(get)
  if get('upgrade') then return '(Active!)' end
  return ''
end

---------------------------------------------------------------------------
-- Bulbasaur line
---------------------------------------------------------------------------

-- Bulbasaur 001
poke.addPokemon {
  name = 'bulbasaur', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Grass', gen = 1, starter = true,
  config = { money_mod = 1, earned = 0, h_size = 1 },
  evo_rqmt = 16,
  attributes = { 'starter', 'hand_size', 'passive', 'rank', 'economy', 'trigger_evo' },
  -- #1# money, #2# money left to evolve, #3# rank of the round, #4# hand size
  vars = function(get)
    return { get('money_mod'), math.max(0, 16 - get('earned')), poke.round_rank('bulb1card'), get('h_size') }
  end,
  passives = { hand_size = 'h_size' },
  triggers = {
    onScoreInHand = function(card, state, step, result)
      bulba_held(card, state, step, result, function() return poke.get(card, 'money_mod') end, true)
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'ivysaur', poke.get(card, 'earned'), 16)
  end,
}

-- Ivysaur 002
poke.addPokemon {
  name = 'ivysaur', rarity = 'poke_safari', cost = 9, stage = 'One', ptype = 'Grass', gen = 1,
  config = { money_mod = 1, earned = 0, h_size = 1 },
  evo_rqmt = 16,
  attributes = { 'starter', 'hand_size', 'passive', 'rank', 'economy', 'trigger_evo' },
  -- #1# money, #2# money left, #3# hand size, #4# rank, #5# money + 1
  vars = function(get)
    return { get('money_mod'), math.max(0, 16 - get('earned')), get('h_size'), poke.round_rank('bulb1card'), get('money_mod') + 1 }
  end,
  passives = { hand_size = 'h_size' },
  triggers = {
    onScoreInHand = function(card, state, step, result)
      bulba_held(card, state, step, result, function()
        return poke.get(card, 'money_mod') + (state:randomFloat() < 0.5 and 1 or 0)
      end, true)
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'venusaur', poke.get(card, 'earned'), 16)
  end,
}

-- Venusaur 003
poke.addPokemon {
  name = 'venusaur', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 1,
  config = { money_mod = 2, earned = 0, h_size = 1 },
  megas = { 'mega_venusaur' },
  attributes = { 'starter', 'hand_size', 'passive', 'rank', 'economy' },
  -- #1# money, #2# earned, #3# hand size, #4# rank
  vars = function(get)
    return { get('money_mod'), get('earned'), get('h_size'), poke.round_rank('bulb1card') }
  end,
  passives = { hand_size = 'h_size' },
  triggers = {
    onScoreInHand = function(card, state, step, result)
      bulba_held(card, state, step, result, function() return poke.get(card, 'money_mod') end, false)
    end,
  },
}

-- Mega Venusaur 003-1
poke.addPokemon {
  name = 'mega_venusaur', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Grass', gen = 1,
  blueprint_compat = false,
  config = { h_size = 4, rounds = 1 },
  attributes = { 'starter', 'hand_size', 'passive' },
  vars = function(get) return { get('h_size') } end,
  passives = { hand_size = 'h_size' },
}

---------------------------------------------------------------------------
-- Charmander line
---------------------------------------------------------------------------

local function charmander_def(name, rarity, cost, stage, mult_mod, target, into)
  return {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Fire', gen = 1, starter = stage == 'Basic' or nil,
    config = { mult = 0, mult_mod = mult_mod, d_remaining = 0, d_size = 1 },
    evo_rqmt = target,
    attributes = { 'starter', 'discard', 'passive', 'mult', 'scaling', 'scaling_evo' },
    -- #1# mult, #2# mult gain, #3# discards remaining, #4# discards
    vars = function(get) return { get('mult'), get('mult_mod'), get('d_remaining'), get('d_size') } end,
    passives = { discards = 'd_size' },
    triggers = {
      beforeAllCardsScored = function(card, state, step, result)
        if step.copiedBy or state.discardsLeft ~= poke.get(card, 'd_remaining') then return end
        local gain = poke.get(card, 'mult_mod')
        poke.add(card, 'mult', gain)
        result:say('+' .. poke.text.num(gain) .. ' Mult', colors.MULT)
      end,
      afterAllCardsScored = function(card, state, step, result)
        local mult = poke.get(card, 'mult')
        if mult > 0 then result:add(plusMult(mult)) end
      end,
    },
    evolution = function(card, state)
      return poke.scaling_evo(card, state, into, poke.get(card, 'mult'), target)
    end,
  }
end

