local function dragon_scale(card, state, step, result)
  if not step.copiedBy and #(step.hand.allCards or {}) <= poke.get(card, 'size') then
    poke.add(card, 'mult', poke.get(card, 'mult_mod'))
  end
end

local function dragon_mult(card, state, step, result)
  local mult = poke.get(card, 'mult')
  if mult > 0 then result:add(plusMult(mult)) end
end

