  config = { chips = 40, money = 1, rounds = 4 },
  attributes = { 'chips', 'economy', 'hand_type', 'round_evo' },
  vars = function(get) return { get('chips'), get('money'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.hand.contains.PAIR then return end
      result:add(plusChips(poke.get(card, 'chips')))
      result:add(plusMoney(poke.ease_poke_dollars(card, 'chinchou', poke.get(card, 'money'), true, state)))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'lanturn') end,
}

-- Lanturn 171: Pair gives Points (more per Water joker) and money (more per Lightning joker).
local function lanturn_values(card, state, get)
  get = get or function(k) return poke.get(card, k) end
  local lightning = #poke.find_pokemon_type('Lightning', nil, nil, state)
  local water = #poke.find_pokemon_type('Water', nil, nil, state)
  return get('money') + get('money_mod') * lightning, get('chips') + get('chip_mod') * water
end
poke.addPokemon {
  name = 'lanturn', rarity = 2, cost = 7, stage = 'One', ptype = 'Lightning', gen = 2,
  config = { chips = 60, chip_mod = 20, money = 1, money_mod = 1 },
  attributes = { 'chips', 'economy', 'hand_type', 'types', 'joker' },
  vars = function(get, card, state)
    local money, chips = get('money'), get('chips')
    if state then money, chips = lanturn_values(card, state, get) end
    return { get('chips'), get('money'), get('chip_mod'), get('money_mod'), money, chips }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.hand.contains.PAIR then return end
      local money, chips = lanturn_values(card, state)
      result:add(plusChips(chips))
      result:add(plusMoney(poke.ease_poke_dollars(card, 'lanturn', money, true, state)))
    end,
  },
}

