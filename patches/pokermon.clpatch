  vars = function(get) return { get('Xmult_minus'), get('rounds') } end,
  triggers = { afterAllCardsScored = poke.baby_main, afterRound = baby_creates('cart_card_8') },  -- The World: Malice
  evolution = function(card, state) return poke.level_evo(card, state, 'jigglypuff') end,
}

-- Togepi 175: Baby, random X0.5 to X1.5 Mult (in steps of 0.05). Only appears when the deck has a Paperback card.
poke.addPokemon {
  name = 'togepi', rarity = 2, cost = 4, stage = 'Baby', ptype = 'Fairy', gen = 2,
  config = { Xmult1 = 0.50, Xmult2 = 1.5, rounds = 2 },
  -- the library compares enhancement_gate with Cardlike enhancement ids: Paperback is Balatro's Lucky Card
  enhancement_gate = 'Paperback',
  attributes = { 'baby', 'xmult', 'round_evo' },
  text = {
    '{C:attention}Baby{}, {X:mult,C:white} X#2# {} to {X:mult,C:white} X#3# {} Mult',
    '{C:inactive}(Random, in steps of 0.05)',
    '{C:inactive,s:0.8}(Evolves after {C:attention,s:0.8}#1#{C:inactive,s:0.8} rounds)',
  },
  vars = function(get) return { get('rounds'), get('Xmult1'), get('Xmult2') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      poke.faint_baby_poke(card, state, step)
      local x1, x2 = poke.get(card, 'Xmult1'), poke.get(card, 'Xmult2')
      local x = math.floor(20 * (x1 + state:randomFloat() * (x2 - x1)) + 0.5) / 20
      result:add(xMult(x))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'togetic') end,
}

-- Togetic 176: Paperback cards have a 1 in 5 chance for +100 Points and a 1 in 10 chance for X1.5 Mult.
poke.addPokemon {
  name = 'togetic', rarity = 'poke_safari', cost = 6, stage = 'Basic', ptype = 'Fairy', gen = 2,
  item_req = 'shinystone',
  config = { num = 1, chip_dem = 5, Xmult_dem = 10, chips = 100, Xmult_multi = 1.5 },
  attributes = { 'enhancements', 'chance', 'chips', 'xmult', 'item_evo' },
  vars = function(get, card, state)
    return { poke.chance_num(get('num'), state), get('chip_dem'), get('Xmult_dem'), get('chips'), get('Xmult_multi') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_lucky') then return end
      local num = poke.get(card, 'num')
      if state:chance(num / poke.get(card, 'chip_dem')) then result:add(plusChips(poke.get(card, 'chips'))) end
      if state:chance(num / poke.get(card, 'Xmult_dem')) then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'togekiss') end,
}

-- Natu 177: Fruit cards level up their hand one more time.
poke.addPokemon {
  name = 'natu', rarity = 2, cost = 4, stage = 'Basic', ptype = 'Psychic', gen = 2,
  config = { rounds = 4 },
  attributes = { 'planet', 'round_evo' },
  vars = function(get) return { get('rounds') } end,
