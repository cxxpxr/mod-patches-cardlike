-- Spinda 327
local SPINDA_ENHANCEMENTS = { 'm_bonus', 'm_mult', 'm_wild', 'm_glass', 'm_steel', 'm_gold', 'm_lucky', 'm_poke_seed' }
local ENHANCEMENT_NAMES = { ['pokermon:seed'] = 'Seed' }

poke.addPokemon {
  name = 'spinda', rarity = 2, cost = 7, gen = 3, stage = 'Basic', ptype = 'Colorless',
  config = {
    enhancements = { 'Chipped', 'Multicard', 'Plaid' },
    targets = { { value = 'Ace', id = 14 }, { value = 'King', id = 13 }, { value = 'Queen', id = 12 } },
  },
  attributes = { 'holding', 'modify_card', 'nature', 'rank', 'enhancements' },
  -- #1# to #3# enhancements, #4# to #6# ranks
  vars = function(get)
    local vars = {}
    for _, e in ipairs(get('enhancements') or {}) do vars[#vars + 1] = ENHANCEMENT_NAMES[e] or e end
    return poke.add_target_cards_to_vars(vars, get('targets'))
  end,
  -- Holding a Wheel of Fortune (Cardlike Chance); the nature is picked when Spinda first joins.
  onAdded = function(card, state)
    if poke.get(card, 'spinda_nature') then return end
    poke.set(card, 'spinda_nature', true)
    poke.set(card, 'enhancements', poke.get_target_card_enhancements(3, SPINDA_ENHANCEMENTS, state))
    poke.set(card, 'targets', poke.get_target_card_ranks(3, poke.get(card, 'targets'), false, state))
    poke.holding(card, 'cart_card_12', state)
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local list = poke.get(card, 'enhancements') or {}
      if #list == 0 then return end
      local changed = 0
      for _, c in ipairs(step.hand.playedCards) do
        for _, t in ipairs(poke.get(card, 'targets') or {}) do
          if poke.rank_of(c) == t.id then
            c:setEnhancement(poke.random_element(list, state))
            c:punch()
            changed = changed + 1
          end
        end
      end
      if changed > 0 then result:say(poke.text.dict('poke_teeter_dance_ex', 'Teeter Dance!'), poke.colours.colorless) end
    end,
  },
}


== file jokers/pokejokers_12.lua (762 lines)
-- Pokemon jokers 331-360 (original file pokejokers_12.lua): Cacnea to Wynaut.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local HAZARD = 'm_poke_hazard'

-- Playing cards that Claydol returns to the hand (destroyed and copied): Cacnea does not pay for them.
local returned = {}

-- Pay for each destroyed playing card (Cacnea, Cacturne).
local function pay_per_removed(card, state, step, result)
  for _, c in ipairs(step.cards or {}) do
    if returned[c.uid] then
      returned[c.uid] = nil
    else
      result:add(plusMoney(poke.ease_poke_dollars(card, 'cacnea', poke.get(card, 'money_mod'), true, state)))
    end
  end
end

-- Ancient cards (fossils): count them before scoring, reset after the hand.
local function ancient_before(rank)
  return function(card, state, step, result)
    poke.get_ancient_amount(step.hand.playedCards, rank, card)
  end
end
local function ancient_reset(card, state, step, result)
  if not step.copiedBy then poke.set(card, 'ancient_count', 0) end
end

-- Lileep and Cradily: +hand size this round (1+), sell value (2+).
local function lileep_common(card, state, result)
  local count = poke.get(card, 'ancient_count', 0)
  state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
  result:say('+' .. poke.text.num(poke.get(card, 'h_size')) .. ' Hand Size', colors.ORANGE)
  if count > 1 then
    local amount = poke.get(card, 'money_mod')
    card:addSellValue(amount)
    card:popup('Value Up!', colors.MONEY)
    for _, c in ipairs(state.consumables or {}) do
      c:addSellValue(amount)
      c:popup('Value Up!', colors.MONEY)
    end
  end
end

-- Held cards give +Points while 3+ Ancient cards were played (Lileep, Cradily).
local function lileep_held(card, state, step, result)
  if poke.get(card, 'ancient_count', 0) <= 2 then return end
  if step.card:getDebuffState() then
    result:say('Debuffed', colors.MULT, step.card)
  else
    result:add(plusChips(poke.get(card, 'chip_mod')))
  end
end

-- Anorith and Armaldo: destroy a deck card ranked above 7 (3+), add a 7 to the deck (2+, chance).
local function anorith_common(card, state, step, count, enhanced)
  if count > 2 then
    local targets = {}
    for _, c in ipairs(state.unDrawnCards or {}) do
      local r = poke.rank_of(c)
      if r and r > 7 then targets[#targets + 1] = c end
    end
    local target = poke.random_element(targets, state)
    if target then poke.remove_card(target, card) end
  end
  if count > 1 and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
    cardlike.addPlayingCard({ rank = 7, enhancement = enhanced and 'random' or nil }, { area = 'deck' })
    card:popup('+1 Card', colors.ORANGE)
  end
end

local function armaldo_xmult(card, state)
  local n = 0
  for _, c in ipairs(state and state.allCards or {}) do
    local info = c.lastInfo or {}
    if poke.rank_of(c) == 7 and info.enhancement and info.enhancement ~= 'Default' then n = n + 1 end
  end
  return 1 + n * poke.get(card, 'Xmult_multi')
end

local function unscored_natures(card, step)
  local scoring = {}
  for _, c in ipairs(step.hand.playedCards or {}) do scoring[c.uid] = true end
  local n = 0
  for _, c in ipairs(step.hand.allCards or {}) do
    if not scoring[c.uid] then
      local r = poke.rank_of(c)
      for _, t in ipairs(poke.get(card, 'targets') or {}) do
        if r == t.id then n = n + 1 end
      end
    end
  end
  return n
end

-- Kecleon: takes the type of the joker to its right (Colorless when there is none).
local function kecleon_sync(card, state)
  local t = 'Colorless'
  local jokers = state and state.jokers or {}
  for i, j in ipairs(jokers) do
    if j == card then
      local other = jokers[i + 1]
      t = other and poke.get_type(other) or 'Colorless'
      break
    end
  end
  if poke.type_sticker_applied(card) ~= t then
    card:getDataStore():set('poke_tera', t)
    card:popup(t .. '!', poke.colours[t:lower()] or colors.ORANGE)
  end
  return t
end

-- Shuppet and Banette: a joker sold while a blind is on.
local function sold_during_blind(card, state, step, result)
  if step.copiedBy or not step.card or step.card:getKind() ~= 'joker' then return end
  if not (state:isPhase('play') or state:isPhase('scoring')) then return end
  local n = poke.add(card, 'mult', poke.get(card, 'mult_mod'))
  result:say('+' .. poke.text.num(poke.get(card, 'mult_mod')) .. ' Mult', colors.MULT)
  return n
end

-- Duskull and Dusclops: the first 4 scoring cards of the last hand of the round score again.
local function final_hand_retrigger(card, state, step)
  if state.handsLeft ~= 0 then return 0 end
  for i, c in ipairs(step.hand.playedCards or {}) do
    if i > 4 then break end
    if c == step.card then return poke.get(card, 'retriggers') end
  end
  return 0
end

---------------------------------------------------------------------------
-- Cacnea 331
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'cacnea', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 3,
  config = { hazard_level = 1, money_mod = 3, rounds = 5 },
  attributes = { 'hazards', 'economy', 'round_evo' },
  vars = function(get) return { get('hazard_level'), get('money_mod'), get('rounds') } end,
  passives = { hazard_level = 'hazard_level' },
  triggers = { onCardsRemoved = pay_per_removed },
  evolution = function(card, state) return poke.level_evo(card, state, 'cacturne') end,
}

-- Cacturne 332
poke.addPokemon {
  name = 'cacturne', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Grass', gen = 3,
  config = { hazard_level = 1, money_mod = 5 },
  attributes = { 'hazards', 'economy', 'destroy_card', 'hands' },
  vars = function(get) return { get('hazard_level'), get('money_mod') } end,
  passives = { hazard_level = 'hazard_level' },
  triggers = {
    onCardsRemoved = pay_per_removed,
    -- Hazard cards in the first hand of the round are destroyed after scoring.
    destroyCard = function(card, state, step, result)
      return not step.copiedBy and state.handsPlayed == 1 and poke.has_enhancement(step.card, HAZARD)
    end,
  },
}

---------------------------------------------------------------------------
-- Swablu 333
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'swablu', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Colorless', gen = 3,
  config = { chips = 0, chip_mod = 2 },
  evo_rqmt = 36,
  attributes = { 'rank', 'nine', 'chips', 'economy', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('chips'), get('chip_mod'), 36 } end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(poke.drawn_cards(state, step)) do
        if poke.rank_of(c) == 9 then
          poke.add(card, 'chips', poke.get(card, 'chip_mod'))
          result:say('+' .. poke.text.num(poke.get(card, 'chip_mod')), colors.CHIPS)
        end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'altaria', poke.get(card, 'chips'), 36) end,
}

-- Altaria 334
poke.addPokemon {
  name = 'altaria', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Dragon', gen = 3,
  config = { chips = 0, chip_mod = 3, money_mod = 1, num = 1, dem = 3 },
  attributes = { 'rank', 'nine', 'chips', 'economy', 'scaling', 'types', 'joker' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('chips'), get('chip_mod'), get('money_mod'), num, dem }
  end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      local dragon = #poke.find_pokemon_type('Dragon', card, nil, state) > 0
      for _, c in ipairs(poke.drawn_cards(state, step)) do
        if poke.rank_of(c) == 9 then
          if not step.copiedBy then
            poke.add(card, 'chips', poke.get(card, 'chip_mod'))
            result:say('+' .. poke.text.num(poke.get(card, 'chip_mod')), colors.CHIPS)
          end
          if dragon or state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
            result:add(plusMoney(poke.ease_poke_dollars(card, 'altaria', poke.get(card, 'money_mod'), true, state)))
          end
        end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

---------------------------------------------------------------------------
-- Zangoose 335: 2 random held cards also score with the hand. Cardlike cannot move held cards into the played hand,
-- so the cards give what they would give when scored (points, enhancement, edition) and stay in the hand. They are
-- never part of the played hand, so the poker hand does not change (the original get_poker_hand_info patch).
---------------------------------------------------------------------------
local zangoose_picked = { hand = nil, uids = {} }
poke.addPokemon {
  name = 'zangoose', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Colorless', gen = 3,
  config = { amount = 2 },
  vars = function(get) return { get('amount') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if zangoose_picked.hand ~= state.totalHandsPlayed then
        zangoose_picked.hand, zangoose_picked.uids = state.totalHandsPlayed, {}
      end
      local options = {}
      for _, c in ipairs(step.held or {}) do
        if not zangoose_picked.uids[c.uid] then options[#options + 1] = c end
      end
      poke.shuffle(options, state)
      local n = math.min(poke.get(card, 'amount'), #options)
      if n <= 0 then return end
      result:say(poke.text.dict('poke_crush_claw_ex', 'Crush Claw!'), colors.ORANGE)
      for i = 1, n do
        local c = options[i]
        zangoose_picked.uids[c.uid] = true
        if not c:getDebuffState() then
          local eval = c:getEvaluation(false) or {}
          if (eval.points or 0) ~= 0 then result:add(plusChips(eval.points)) end
          for _, b in ipairs(eval.bonuses or {}) do result:add(b) end
          for _, b in ipairs(eval.edition or {}) do result:add(b) end
          c:punch()
        end
      end
    end,
  },
}

-- Seviper 336
poke.addPokemon {
  name = 'seviper', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Dark', gen = 3,
  config = { req_size = 3, h_size = 1 },
  vars = function(get) return { get('req_size'), get('h_size') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if #(step.hand.allCards or {}) == poke.get(card, 'req_size') then
        state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
        result:say('+' .. poke.text.num(poke.get(card, 'h_size')) .. ' Hand Size', colors.ORANGE)
      end
    end,
    onDiscard = function(card, state, step, result)
      if #(step.discardedCards or {}) == poke.get(card, 'req_size') then
        state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
        result:say('+' .. poke.text.num(poke.get(card, 'h_size')) .. ' Hand Size', colors.ORANGE)
      end
    end,
  },
}

