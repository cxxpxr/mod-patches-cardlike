-- Misdreavus 200
poke.addPokemon {
  name = 'misdreavus', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Psychic', gen = 2,
  item_req = 'duskstone',
  config = { chip_mod = 5, chips = 0 },
  attributes = { 'face', 'modify_card', 'scaling', 'chips', 'item_evo' },
  vars = function(get) return { get('chip_mod'), get('chips') } end,
  triggers = {
    onScore = function(card, state, step, result)
      local c = step.card
      if step.copiedBy or not c:isFace() or poke.is_debuffed(c) then return end
      local drained = poke.drain_chips(c, poke.get(card, 'chip_mod'))
      if drained > 0 then
        poke.add(card, 'chips', drained)
        result:say('Eroded!', colors.CHIPS, c)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'mismagius') end,
}

-- Unown 201: a letter form and a Nature rank when it appears; sells for $0; flees at the end of the round.
poke.addPokemon {
  name = 'unown', rarity = 'poke_safari', cost = 5, stage = 'Basic', ptype = 'Psychic', gen = 2,
  aux_poke = true,
  config = { mult = 6, form = 'A', targets = { { value = 'Ace', id = 14 } } },
  attributes = { 'rank', 'mult', 'nature' },
  vars = function(get)
    local v = { get('mult') }
    poke.add_target_cards_to_vars(v, get('targets'))
    return v
  end,
  in_pool = function(state) return false end,
  onAdded = function(card, state)
    if not poke.get(card, 'unown_init') then
      poke.set(card, 'unown_init', true)
      local taken = {}
      for _, j in ipairs(state.jokers or {}) do
        if j ~= card then
          local name = poke.name(j)
          if name == 'unown' then taken[poke.get(j, poke.UNOWN.form, '')] = true end
          if name == 'ruins_of_alph' then
            for _, f in ipairs(poke.get(j, 'forms', {}) or {}) do taken[f] = true end
          end
        end
      end
      local forms = {}
      for _, f in ipairs(UNOWN_FORMS) do if not taken[f] then forms[#forms + 1] = f end end
      poke.set(card, poke.UNOWN.form, poke.random_element(forms, state) or 'A')
      poke.set(card, 'targets', poke.get_target_card_ranks(1, poke.get(card, 'targets'), false, state))
    end
    -- Unown sells for $0
    local v = card:getSellValue() or 0
    if v > 0 then card:addSellValue(-v) end
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local target = ((poke.get(card, 'targets') or {})[1] or {}).id or 14
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.rank_of(c) == target then
          if not step.copiedBy then poke.set(card, poke.UNOWN.triggered, true) end
          result:add(plusMult(poke.get(card, 'mult')))
          return
        end
      end
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, poke.UNOWN.triggered) and poke.owns(state, 'ruins_of_alph') then result:destroySelf() end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      result:say(poke.text.dict('poke_flees_ex', 'Flees!'), colors.GREY)
      result:destroySelf()
    end,
  },
}

-- Wobbuffet 202
poke.addPokemon {
  name = 'wobbuffet', rarity = 'poke_safari', cost = 8, stage = 'Basic', ptype = 'Psychic', gen = 2,
  config = { retriggers = 1, volatile = 'left' },
  attributes = { 'retrigger', 'rank', 'six', 'seven', 'eight', 'nine', 'ten', 'volatile' },
  vars = function(get) return { get('retriggers') } end,
  triggers = {
