poke.addPokemon {
  name = 'delibird', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Water', gen = 2,
  blueprint_compat = false,
  attributes = { 'economy', 'generation', 'item', 'joker', 'tag' },
  vars = function(get) return {} end,
  text = function(get, card, state, vars)
    return poke.text.joker('delibird', vars,
      colorize('35%', colors.GREEN) .. ' - ' .. colorize('$8', colors.MONEY),
      colorize('30%', colors.GREEN) .. ' - ' .. colorize('Item', poke.colours.item) .. ' card',
      colorize('20%', colors.GREEN) .. ' - ' .. colorize('Shop Pin', colors.ORANGE),
      colorize('15%', colors.GREEN) .. ' - ' .. colorize('Chroma', '#5d5dff') .. ' ' .. colorize('Birthday Present', colors.ORANGE))
  end,
  dollarsAtRoundEnd = function(card, state)
    local gift = state:randomFloat()
    card:popup(poke.text.dict('poke_gift_ex', 'Present!'), colors.GREEN)
    if gift > .65 then return 8 end
    if gift > .35 then
      if (state.freeConsumableSlots or 0) > 0 then poke.create_consumeable({ set = 'poke_item' }, card) end
    elseif gift > .15 then
      cardlike.addPin('pin_4') -- Shop Pin (Balatro Coupon Tag)
    elseif (state.freeJokerSlots or 0) > 0 then
      cardlike.createJoker('joker_voucher', { edition = 'Chroma' }) -- Birthday Present (Balatro Gift Card)
    end
    return 0
  end,
}

