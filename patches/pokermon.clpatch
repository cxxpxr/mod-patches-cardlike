poke.addPokemon {
  name = 'mega_steelix', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Metal', gen = 2,
  blueprint_compat = false,
  config = { stone_held = 4 },
  attributes = { 'enhancements', 'retrigger', 'hazards', 'passive' },
  vars = function(get) return { get('stone_held') } end,
  triggers = {
    onScoreInHand = rock_as_wooden,
    repeatHeldCard = function(card, state, step, result)
      local n = 0
      for _, c in ipairs(state.cardsInHand or {}) do if poke.info(c).noRank then n = n + 1 end end
      local times = math.floor(n / math.max(1, poke.get(card, 'stone_held')))
      if times > 0 then return times end
    end,
  },
}

