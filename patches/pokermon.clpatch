-- Jirachi's wishes: Admin cards from the Wish Pack that change Jirachi into one of its forms.
-- Original file: consumables/07_mart_jirachi.lua. They never appear in the shop or in random packs.
local poke = cardlike.require('lib.pokermon')

-- Art of a frame of the Series A Gen 3 sheet, or the Basic Series frame when that one is empty.
local function art(x, y)
  return poke.sprites.frame('AtlasJokersSeriesAGen03', x, y) or poke.sprites.frame('AtlasJokersBasicGen03', x, y)
end

local function find_jirachi(state)
  return poke.find_card(function(j) return poke.name(j) == 'jirachi' end, state)
end

local function wish(key, pos, soul, form, extra)
  local t = {
    id = key,
    type = 'admin',
    readableName = poke.text.name('Spectral', 'c_poke_' .. key),
    price = 4,
    hidden = true,
    sprite = pos,
    layerSprite = soul,
    description = function(r) return poke.text.describe('Spectral', 'c_poke_' .. key, {}) end,
    action = function(ctx)
      local jirachi = find_jirachi(ctx.state)
      if not jirachi then return end
      local into = type(form) == 'function' and form(ctx.state) or form
      if into and poke.def(into) then poke.change_form(jirachi, into, nil, ctx.state) end
    end,
  }
  for k, v in pairs(extra or {}) do t[k] = v end
  return cardlike.addConsumable(t)
end

wish('fake_banker', art(4, 2), art(5, 2), 'jirachi_banker')
wish('fake_booster', art(6, 2), art(7, 2), 'jirachi_booster')
wish('fake_power', art(8, 2), art(9, 2), 'jirachi_power')
wish('fake_negging', art(10, 2), nil, 'jirachi_negging')
wish('fake_copy', art(10, 2), art(11, 2), 'jirachi_invis')
wish('fake_fixer', art(0, 3), art(1, 3), 'jirachi_fixer')
wish('fake_masterball', poke.sprites.at('consumables', 3, 3), poke.sprites.at('consumables', 4, 2), function(state)
  return poke.get_random_poke_key({ stage = 'Legendary', exclude_keys = { 'jirachi' } }, state)
end)


== file content/consumables/machine.lua (88 lines)
-- Rotom's appliances: Item cards that change the leftmost Rotom into a form and give a bonus.
-- Original file: consumables/08_mart_machine.lua. They appear only while you own a Rotom.
local poke = cardlike.require('lib.pokermon')

local ROTOMS = { rotom = true, rotomh = true, rotomw = true, rotomf = true, rotomfan = true, rotomm = true }

local function lines_of(key)
  local e = poke.text.entry('poke_item', key)
  local out = {}
  for _, l in ipairs(e and e.text or {}) do out[#out + 1] = (l:gsub('^({br:[^}]*}).*$', '%1')) end
  return out
end

local function have_rotom(state)
  for _, j in ipairs(state.jokers or {}) do
    if ROTOMS[poke.name(j) or ''] then return true end
  end
  return false
end

-- Change the leftmost Rotom that is not already this form.
local function transform(state, form)
  poke.set_spoon_item(form.item)
  local rotom = poke.find_card(function(j)
    local n = poke.name(j)
    return n ~= nil and ROTOMS[n] and n ~= form.joker
  end, state)
  if rotom and poke.def(form.joker) then poke.change_form(rotom, form.joker, nil, state) end
end

local function in_blind(state) return state:isPhase('play') or state:isPhase('scoring') end

local MACHINES = {
  { item = 'oven', joker = 'rotomh', pos = { 7, 6 }, vars = { 1 },
    effect = function(state) if in_blind(state) then state.discardsLeft = state.discardsLeft + 1 end end },
  { item = 'washing_machine', joker = 'rotomw', pos = { 8, 6 }, vars = { 1 },
    effect = function(state) if in_blind(state) then state.handsLeft = state.handsLeft + 1 end end },
  { item = 'fridge', joker = 'rotomf', pos = { 9, 6 }, vars = {},
    effect = function(state)
      local types = { 'game', 'fruit', 'admin', 'item', 'energy' }
      for _ = 1, 2 do
        local t = types[state:random(1, #types)]
        if t == 'item' or t == 'energy' then t = poke.MOD_ID .. ':' .. t end
        if not poke.create_consumeable({ set = t }) then break end
      end
    end },
  { item = 'fan', joker = 'rotomfan', pos = { 0, 7 }, vars = {},
    effect = function(state)
      for _ = 1, 2 do if not cardlike.createJoker('Common') then break end end
    end },
  { item = 'lawn_mower', joker = 'rotomm', pos = { 1, 7 }, vars = { 1 },
    effect = function(state)
      if in_blind(state) then
        state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + 1
        cardlike.drawCards(1)
      end
    end },
}

local machine_ids = {}
for _, m in ipairs(MACHINES) do
  local key = 'c_poke_' .. m.item
  machine_ids[poke.items.id(m.item)] = true
  cardlike.addConsumable {
    id = m.item,
    type = 'item',
    readableName = poke.text.name('poke_item', key),
    price = 4,
    sprite = poke.sprites.at('consumables', m.pos[1], m.pos[2]),
    description = function(r) return (poke.text.format(lines_of(key), m.vars):gsub(' or selected', '')) end,
    action = function(ctx)
      transform(ctx.state, m)
      m.effect(ctx.state)
    end,
  }
end

-- Appliances appear only while you own a Rotom.
cardlike.filter('consumablePool', function(ids, ctype)
  local state = cardlike.state
  if not state or state.money == nil or have_rotom(state) then return nil end
  local keep, removed = {}, false
  for _, id in ipairs(ids) do
    if machine_ids[id] then removed = true else keep[#keep + 1] = id end
  end
  if removed then return keep end
end)


== file content/consumables/rare.lua (165 lines)
-- Rare Items (original consumables/04_mart_rare.lua): Leftovers, Heavy-Duty Boots and Thick Club are reusable once
-- per round; Tera Orb changes a joker's type.
local poke = cardlike.require('lib.pokermon')
local C = cardlike.require('content.consumables.common')

local REUSABLE = '\n' .. colorize('(Reusable: not used up, once per round)', colors.GREY)

local function used_note(card)
  if card and not poke.items.usable(card) then return '\n' .. colorize('(Used this round)', colors.MULT) end
  return ''
end

-- Leftovers: +$2 sell value to the leftmost joker. Hidden: it comes from other effects (Pickup), not the shop.
cardlike.addConsumable {
  id = 'leftovers',
  type = 'pokermon:item',
  readableName = C.name('poke_item', 'c_poke_leftovers'),
  price = 3,
  hidden = true,
  sprite = poke.sprites.at('consumables', 7, 4),
  layerSprite = poke.sprites.at('consumables', 6, 5),
  description = function(r)
    return C.desc('poke_item', 'c_poke_leftovers', { 1, 2 }) .. REUSABLE .. used_note(r and r.card)
  end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    if #(ctx.state.jokers or {}) == 0 then return 'No joker' end
    return ''
  end,
  action = function(ctx)
    local target = (ctx.state.jokers or {})[1]
    if target then
      target:addSellValue(2)
      target:popup('Value Up!', colors.MONEY)
    end
    poke.items.keep_on_use(ctx)
  end,
}

-- Heavy-Duty Boots: Hazard cards cannot be destroyed by their chance until the end of the round.
-- The flag is poke.run.vars.hazard_off (the Hazard enhancement reads it); it clears after the round.
cardlike.addConsumable {
  id = 'heavyboots',
  type = 'pokermon:item',
  readableName = C.name('poke_item', 'c_poke_heavyboots'),
  price = 4,
  credits = 'Art: Emma, Catzzadilla',
  sprite = poke.sprites.at('consumables', 3, 7),
  layerSprite = poke.sprites.at('consumables', 4, 7),
  description = function(r)
    return C.desc('poke_item', 'c_poke_heavyboots', {}) .. REUSABLE .. used_note(r and r.card)
  end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    return ''
  end,
  action = function(ctx)
    poke.run.vars.hazard_off = true
    poke.items.keep_on_use(ctx)
  end,
}

cardlike.on('onBlindDefeated', function(state)
  if poke.run.vars then poke.run.vars.hazard_off = nil end
end)

-- Tera Orb: the leftmost joker gets the orb's Tera type (and 1 Energy if it already has that type).
-- The orb's type changes with every discard; it is kept in its data store ('change_to_type', 'type_bag').
local TERAORB = poke.MOD_ID .. ':teraorb'

local function next_type(card, state)
  local ds = card:getDataStore()
  local bag = ds:get('type_bag')
  if type(bag) ~= 'table' or #bag < 1 then
    bag = {}
    for i, t in ipairs(poke.TYPES) do bag[i] = t end
    poke.shuffle(bag, state)
  end
  local t = table.remove(bag)
  ds:set('type_bag', bag)
  ds:set('change_to_type', t)
  return t
end

local function orb_type(card)
  return card and card:getDataStore():get('change_to_type') or 'Grass'
end

cardlike.addConsumable {
  id = 'teraorb',
  type = 'pokermon:item',
  readableName = C.name('poke_item', 'c_poke_teraorb'),
  price = 3,
  sprite = poke.sprites.at('consumables', 2, 9),
  layerSprite = poke.sprites.at('consumables', 3, 9),
  description = function(r)
    local t = orb_type(r and r.card)
    return C.desc('poke_item', 'c_poke_teraorb', { t, colours = { poke.colours[t:lower()], poke.colours[t:lower()] } })
  end,
  canUse = function(ctx)
    if #(ctx.state.jokers or {}) > 0 then return '' end
    return 'No joker'
  end,
  action = function(ctx)
    poke.set_spoon_item('teraorb')
    local t = orb_type(ctx.self)
    local choice = (ctx.state.jokers or {})[1]
    if not choice then return end
    if poke.is_type(choice, t) then poke.energy.increase(choice, t) end
    poke.apply_type_sticker(choice, t, ctx.state)
  end,
}

-- A new orb rolls its first type when you get it.
cardlike.on('onCardObtained', function(state, step)
  local c = step.card
  if c and c:getKind() == 'consumable' and c:getConsumableDef() == TERAORB and not c:getDataStore():get('change_to_type') then
    next_type(c, state)
  end
end)

cardlike.on('onDiscard', function(state, step)
  for _, orb in ipairs(C.held(state, TERAORB)) do
    local t = next_type(orb, state)
    orb:popup(t, poke.colours[t:lower()] or colors.ORANGE)
  end
end)

-- Thick Club: +10 permanent Points to 1 selected card.
cardlike.addConsumable {
  id = 'thickclub',
  type = 'pokermon:item',
  readableName = C.name('poke_item', 'c_poke_thickclub'),
  price = 3,
  sprite = poke.sprites.at('consumables', 9, 4),
  layerSprite = poke.sprites.at('consumables', 8, 5),
  description = function(r)
    return C.desc('poke_item', 'c_poke_thickclub', { 1, 10 }) .. REUSABLE .. used_note(r and r.card)
  end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    return C.need(ctx, 1, 1)
  end,
  action = function(ctx)
    local c = C.sel(ctx)[1]
    if c then
      c:addAdditionalPointValue(10)
      c:popup('+10', colors.CHIPS)
    end
    poke.items.keep_on_use(ctx)
  end,
}

-- Pool rule (Balatro in_pool): Heavy-Duty Boots only appear while the hazard level is above 0.
cardlike.filter('consumablePool', function(ids, ctype)
  if (poke.run.hazard_level or 0) > 0 then return nil end
  local boots = poke.MOD_ID .. ':heavyboots'
  local keep, removed = {}, false
  for _, id in ipairs(ids) do
    if id == boots then removed = true else keep[#keep + 1] = id end
  end
  if removed then return keep end
  return nil
end)


== file content/consumables/specific.lua (195 lines)
-- Item cards tied to one Pokemon: Leek (Farfetch'd), Dubious Disc (Porygon2), Heart Scale (Luvdisc),
-- Meteorite (Deoxys). Original file: consumables/05_mart_specific.lua.
local poke = cardlike.require('lib.pokermon')

-- Loc lines with the {br:N} divider lines kept as dividers only (their text is a placeholder in the mod).
local function lines_of(set, key)
  local e = poke.text.entry(set, key)
  local out = {}
  for _, l in ipairs(e and e.text or {}) do out[#out + 1] = (l:gsub('^({br:[^}]*}).*$', '%1')) end
  return out
end

-- Cardlike has no joker selection: these cards always pick the leftmost joker.
local function desc(set, key, vars)
  return (poke.text.format(lines_of(set, key), vars):gsub(' or selected', ''))
end

local function chance_vars(num, dem)
  local m = (cardlike.state and cardlike.state.chanceMultiplier) or 1
  return { num * m, dem }
end

local function in_run(state) return state and state.money ~= nil end

-- Leek: reusable. 1 in 2 chance to give itself Luna, Holo or Chroma until the end of the round.
local function roll_edition(state)
  local r = state:randomFloat()
  if r < 0.5 then return 'Luna' elseif r < 0.85 then return 'Holo' end
  return 'Chroma'
end

cardlike.addConsumable {
  id = 'leek',
  type = 'item',
  readableName = poke.text.name('poke_item', 'c_poke_leek'),
  price = 3,
  sprite = poke.sprites.at('consumables', 8, 4),
  layerSprite = poke.sprites.at('consumables', 7, 5),
  description = function(r) return desc('poke_item', 'c_poke_leek', chance_vars(1, 2)) end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    return ''
  end,
  action = function(ctx)
    local state = ctx.state
    local edition
    if state:chance(0.5) then edition = roll_edition(state) end
    local copy = poke.items.keep_on_use(ctx)
    if copy then
      if edition then
        copy:setEdition(edition)
        copy:getDataStore():set('poke_leek_edition', true)
      else
        poke.nope(copy)
      end
    end
  end,
}

-- The Leek loses its edition at the end of the round.
cardlike.on('onBlindDefeated', function(state)
  for _, c in ipairs(state.consumables or {}) do
    local ds = c:getDataStore()
    if ds:get('poke_leek_edition') then
      ds:delete('poke_leek_edition')
      c:setEdition('default')
    end
  end
end)

-- Dubious Disc: evolution item. Gives every card held in hand a random enhancement.
local ENHANCEMENTS = { 'Chipped', 'Multicard', 'Plaid', 'Fragile', 'Wooden', 'Rock', 'Gilded', 'Paperback' }

cardlike.addConsumable {
  id = 'dubious_disc',
  type = 'item',
  readableName = poke.text.name('poke_item', 'c_poke_dubious_disc'),
  price = 4,
  sprite = poke.sprites.at('consumables', 0, 5),
  description = function(r) return desc('poke_item', 'c_poke_dubious_disc', {}) end,
  canUse = function(ctx)
    if poke.evo_item_target('dubious_disc', ctx.state) then return '' end
    if #(ctx.state.cardsInHand or {}) > 0 then return '' end
    return 'No cards in hand'
  end,
  action = function(ctx)
    local state = ctx.state
    poke.set_spoon_item('dubious_disc')
    for _, c in ipairs(state.cardsInHand or {}) do
      c:setEnhancement(ENHANCEMENTS[state:random(1, #ENHANCEMENTS)])
      c:punch()
    end
    poke.evo_item_use('dubious_disc', state)
  end,
}

-- Heart Scale: select 2 cards; the left card becomes a copy of the right card, then both become Hearts.
cardlike.addConsumable {
  id = 'heartscale',
  type = 'item',
  readableName = poke.text.name('poke_item', 'c_poke_heartscale'),
  price = 2,
  hidden = true, -- only Luvdisc makes it
  sprite = poke.sprites.at('consumables', 9, 5),
  credits = 'Art: MyDude_YT',
  description = function(r) return desc('poke_item', 'c_poke_heartscale', { 2, 'Hearts' }) end,
  canUse = function(ctx)
    if #ctx.selectedCards ~= 2 then return 'Select 2 cards' end
    return ''
  end,
  action = function(ctx)
    poke.set_spoon_item('heartscale')
    local a, b = ctx.selectedCards[1], ctx.selectedCards[2]
    local right, left = a, b
    if (b:getIndex() or 0) > (a:getIndex() or 0) then right, left = b, a end
    left:setRank(right:getRank())
    left:setEnhancement(right:getEnhancement())
    left:setEdition(right:getEdition())
    left:setStamp(right:getStamp())
    local extra = (right:getAdditionalPointValue() or 0) - (left:getAdditionalPointValue() or 0)
    if extra ~= 0 then left:addAdditionalPointValue(extra) end
    for _, c in ipairs({ left, right }) do
      c:setSuit('Hearts')
      c:punch()
    end
  end,
}

-- Meteorite: reusable Admin card. Destroys 1 random card left in the deck and changes Deoxys into this Forme.
-- The Forme changes on every shop reroll.
local FORMES = { 'Attack', 'Defense', 'Speed', 'Normal' }

local function forme_of(card)
  local f = card and card:getDataStore():get('forme')
  return f or 'Normal'
end

cardlike.addConsumable {
  id = 'meteorite',
  type = 'admin',
  readableName = poke.text.name('Spectral', 'c_poke_meteorite'),
  price = 3,
  hidden = true, -- Deoxys makes it
  sprite = poke.sprites.at('consumables', 5, 7),
  layerSprite = poke.sprites.at('consumables', 6, 7),
  description = function(r) return desc('Spectral', 'c_poke_meteorite', { forme_of(r and r.card) }) end,
  canUse = function(ctx)
    if not poke.items.usable(ctx.self) then return 'Used this round' end
    if #(ctx.state.unDrawnCards or {}) == 0 then return 'No cards in deck' end
    return ''
  end,
  action = function(ctx)
    local state = ctx.state
    local forme = forme_of(ctx.self)
    local deck = state.unDrawnCards or {}
    if #deck > 0 then deck[state:random(1, #deck)]:destroy() end
    local deoxys = poke.find_card(function(j) return poke.name(j) == 'deoxys' end, state)
    if deoxys then
      local index = 4
      for i, f in ipairs(FORMES) do if f == forme then index = i end end
      if poke.get(deoxys, 'form') ~= index then
        poke.set(deoxys, 'form', index)
        deoxys:punch()
        deoxys:popup(poke.text.dict('poke_transform_success', 'Transformed!'), colors.ORANGE)
      end
    end
    poke.items.keep_on_use(ctx, { forme = forme })
  end,
}

cardlike.on('onShopReroll', function(state)
  for _, c in ipairs(state.consumables or {}) do
    if c:getConsumableDef() == poke.items.id('meteorite') then
      local cur = forme_of(c)
      local nxt = 'Attack'
      for i, f in ipairs(FORMES) do if f == cur then nxt = FORMES[i % #FORMES + 1] end end
      c:getDataStore():set('forme', nxt)
      c:popup(poke.text.dict('poke_' .. nxt:lower() .. '_forme', nxt), colors.ORANGE)
    end
  end
end)

-- Dubious Disc only appears while you own Porygon2.
cardlike.filter('consumablePool', function(ids, ctype)
  local state = cardlike.state
  if not in_run(state) then return nil end
  local disc = poke.items.id('dubious_disc')
  local keep, removed = {}, false
  for _, id in ipairs(ids) do
    if id == disc and not state:hasJoker(poke.id('porygon2')) then removed = true
    else keep[#keep + 1] = id end
  end
  if removed then return keep end
end)


