  config = { rank = '8', chip_mod = 10, money_mod = 1, h_size = 1, money_minus = 2, third_times = 0 },
  evo_rqmt = 5,
  attributes = { 'ancient', 'rank', 'eight', 'hand_size', 'sell_value', 'chips', 'trigger_evo' },
  text = poke.text.tiers('j_poke_lileep'),
  vars = function(get)
    return { '8', get('chip_mod'), get('money_mod'), get('h_size'), get('money_minus'), math.max(0, 5 - get('third_times')) }
  end,
  triggers = {
    beforeAllCardsScored = ancient_before(8),
    onScoreInHand = lileep_held,
