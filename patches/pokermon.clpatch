poke.addPokemon {
  name = 'mewtwo', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Psychic', gen = 1,
  blueprint_compat = false,
  config = { Xmult_multi = 1.2 },
  vars = function(get) return { get('Xmult_multi') } end,
  megas = { 'mega_mewtwo_x', 'mega_mewtwo_y' },
  attributes = { 'boss_blind', 'generation', 'editions', 'destroy_card', 'joker', 'xmult', 'energy_count' },
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local leftmost = (state.jokers or {})[1]
      if not leftmost or leftmost.uid == card.uid then return end
      card:popup('Duplicated!', colors.ORANGE)
      local locked = leftmost:isLocked()
      if not locked or (state.freeJokerSlots or 0) > 0 then
        local copy = leftmost:copy()
        if copy then
          copy:setEdition('Chroma')
          local etype = energize_type(copy)
          if etype then poke.energy.increase(copy, etype) end
          if copy:getDebuffState() then copy:setDebuffState(false) end
        end
      end
      if not locked then leftmost:destroy() end
    end,
    onOtherJoker = function(card, state, step, result)
      if step.other and step.other:getEdition() == 'Chroma' then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}

poke.addPokemon {
  name = 'mega_mewtwo_x', rarity = 'poke_mega', cost = 30, stage = 'Mega', ptype = 'Fighting', gen = 1,
  config = { Xmult_multi = 2.5 },
  vars = function(get) return { get('Xmult_multi') } end,
  attributes = { 'xmult', 'joker' },
  triggers = {
    onOtherJoker = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult_multi')))
    end,
  },
}

poke.addPokemon {
  name = 'mega_mewtwo_y', rarity = 'poke_mega', cost = 30, stage = 'Mega', ptype = 'Psychic', gen = 1,
  blueprint_compat = false,
  config = { Xmult_mod = 3, rounds = 1 },
  vars = function(get) return { get('Xmult_mod') } end,
  attributes = { 'boss_blind', 'energy_count', 'energy_limit' },
  triggers = {
    onShopExit = function(card, state, step, result)
      if step.copiedBy then return end
      local leftmost = (state.jokers or {})[1]
      if not leftmost or leftmost.uid == card.uid then return end
      local etype = energize_type(leftmost)
      if etype then
        for _ = 1, 2 do poke.energy.increase(leftmost, etype) end
      end
    end,
    afterRound = function(card, state, step, result)
      if not (state.blind and state.blind.boss) then return end
      poke.run.energy_plus = (poke.run.energy_plus or 0) + 1
      result:say(poke.text.dict('poke_future_sight', 'Future Sight!'), poke.colours.psychic)
    end,
  },
}


