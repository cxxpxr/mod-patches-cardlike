-- Diglett and Dugtrio: Points with a Three of a Kind, Mult (or X Mult) with a scoring 2, 3 or 4.
local function dig_check(hand)
  local chips = hand.contains.THREE_OF_A_KIND == true
  local mult = false
  for _, c in ipairs(hand.playedCards) do
    if poke.rank_is(c, 2, 3, 4) then mult = true break end
  end
  return chips, mult
end

-- Diglett 050
poke.addPokemon {
  name = 'diglett', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Earth', gen = 1,
  config = { rounds = 4, chips = 60, mult = 4 },
  attributes = { 'chips', 'hand_type', 'mult', 'rank', 'two', 'three', 'four', 'round_evo' },
  vars = function(get) return { get('rounds'), get('chips'), get('mult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips, mult = dig_check(step.hand)
      if chips then result:add(plusChips(poke.get(card, 'chips'))) end
      if mult then result:add(plusMult(poke.get(card, 'mult'))) end
      if chips and mult then result:say(poke.text.dict('poke_dig_ex', 'Dig!'), colors.MULT) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'dugtrio') end,
}

-- Dugtrio 051
poke.addPokemon {
  name = 'dugtrio', rarity = 2, cost = 6, stage = 'One', ptype = 'Earth', gen = 1,
  config = { chips = 120, Xmult = 1.5 },
  attributes = { 'chips', 'hand_type', 'xmult', 'rank', 'two', 'three', 'four' },
  vars = function(get) return { get('Xmult'), get('chips') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips, mult = dig_check(step.hand)
      if chips then result:add(plusChips(poke.get(card, 'chips'))) end
      if mult then result:add(xMult(poke.get(card, 'Xmult'))) end
      if chips and mult then result:say(poke.text.dict('poke_dig_ex', 'Dig!'), colors.MULT) end
    end,
  },
}

-- Meowth and Persian: the first successful Paperback (Lucky) card trigger each round raises the payout.
local function lucky_payout_up(card, state, step, result)
  if step.copiedBy or step.enhancement ~= 'Paperback' then return end
  if poke.get(card, 'triggers') >= poke.get(card, 'limit') then return end
  poke.add(card, 'triggers', 1)
  local n = poke.get(card, 'money_mod')
  poke.add(card, 'money', n)
  result:say('+$' .. poke.text.num(n), colors.MONEY)
end
local function reset_triggers(card, state, step, result)
  if not step.copiedBy then poke.set(card, 'triggers', 0) end
end

-- Meowth 052
poke.addPokemon {
  name = 'meowth', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Colorless', gen = 1,
  enhancement_gate = 'Paperback',
  blueprint_compat = false,
  config = { money = 1, money_mod = 2, limit = 1, triggers = 0 },
  evo_rqmt = 9,
  attributes = { 'economy', 'enhancements', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('money'), get('money_mod'), 9 } end,
  triggers = { enhancementScore = lucky_payout_up, afterRound = reset_triggers },
  dollarsAtRoundEnd = function(card, state)
    return poke.ease_poke_dollars(card, 'meowth', poke.get(card, 'money'), true, state)
  end,
  evolution = function(card, state) return poke.scaling_evo(card, state, 'persian', poke.get(card, 'money'), 9) end,
}

-- Persian 053
poke.addPokemon {
  name = 'persian', rarity = 'poke_safari', cost = 9, stage = 'One', ptype = 'Colorless', gen = 1,
  enhancement_gate = 'Paperback',
  blueprint_compat = false,
  config = { money = 1, money_mod = 2, limit = 1, triggers = 0, num = 1, dem = 5 },
  attributes = { 'economy', 'enhancements', 'scaling', 'chance' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('money'), get('money_mod'), num, dem }
  end,
  triggers = { enhancementScore = lucky_payout_up, afterRound = reset_triggers },
  dollarsAtRoundEnd = function(card, state)
    local payout = poke.get(card, 'money')
    if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then payout = payout * 2 end
    return poke.ease_poke_dollars(card, 'persian', payout, true, state)
  end,
}

-- Psyduck 054
poke.addPokemon {
  name = 'psyduck', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Water', gen = 1, knockoff_starter = true,
  config = { money = 3, rounds = 5 },
  attributes = { 'economy', 'face', 'round_evo' },
  vars = function(get) return { get('money'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not single_face(step.hand) then return end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'psyduck', poke.get(card, 'money'), true, state)))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'golduck') end,
}

-- Golduck 055: a single played face card becomes Gilded; earn money when any card becomes Gilded.
poke.addPokemon {
  name = 'golduck', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Water', gen = 1,
  config = { money = 3 },
  attributes = { 'economy', 'face', 'modify_card', 'enhancements' },
  vars = function(get) return { get('money') } end,
  onAdded = function(card, state) golduck_snapshot(card, state) end,
  onRemoved = function(card, state) golduck_seen[card.uid] = nil end,
  triggers = {
    beforeRound = function(card, state, step, result) golduck_snapshot(card, state, step) end,
    beforeAllCardsScored = function(card, state, step, result)
      if not single_face(step.hand) then return end
      local face = step.hand.playedCards[1]
      if enhancement_of(face) ~= 'Gilded' then
        face:setEnhancement('Gilded')
        face:punch()
        golduck_table(card, step)[face.uid] = 'Gilded'
        result:say('Gold', colors.MONEY)
        result:add(plusMoney(poke.ease_poke_dollars(card, 'golduck', poke.get(card, 'money'), true, state)))
      end
    end,
    onCardChanged = function(card, state, step, result)
      local c = step.card
      if not c or not c.lastInfo or c.lastInfo.kind ~= 'playing' then return end
      local t = golduck_table(card, step)
      local now = c.lastInfo.enhancement
      local before = t[c.uid]
      t[c.uid] = now
      if now == 'Gilded' and before ~= nil and before ~= 'Gilded' then
        result:add(plusMoney(poke.ease_poke_dollars(card, 'golduck', poke.get(card, 'money'), true, state)))
      end
    end,
  },
}

