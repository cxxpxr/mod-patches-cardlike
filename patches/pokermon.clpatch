  vars = function(get)
    return { get('Xmult_multi'), get('every') + 1, poke.loyalty_text(get('loyalty_remaining')) }
  end,
  onAdded = poke.loyalty_start,
  in_pool = function() return false end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'loyalty_remaining', poke.loyalty_remaining(card, state))
    end,
    onScore = function(card, state, step, result)
      if poke.get(card, 'loyalty_remaining') == poke.get(card, 'every') then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
}

-- Jirachi (Fixer wish): if the first discard of the round has exactly 1 card, destroy it and create Mage (Death),
-- COMMAND (Cryptid) or a Metal Coat. The card needs room.
local FIXER_CARDS = { 'cart_card_3', 'admin_card_1', 'metalcoat' }

poke.addPokemon {
  name = 'jirachi_fixer',
  rarity = 4,
  cost = 20,
  stage = 'Legendary',
  ptype = 'Metal',
  gen = 3,
  aux_poke = true,
  config = {},
  attributes = { 'hands', 'discard', 'editions', 'destroy_card' },
  in_pool = function() return false end,
  triggers = {
    onDiscardCard = function(card, state, step, result)
      if (state.discardsUsed or 0) ~= 1 or #(step.discardedCards or {}) ~= 1 then return nil end
      if (state.freeConsumableSlots or 0) > 0 then
        local pick = poke.random_element(FIXER_CARDS, state)
        poke.create_consumeable(pick, card)
      end
      card:punch()
      return true
    end,
  },
}

-- Deoxys 386: if the first discard of the round has only 1 card, it gets a DNA Stamp. The Meteorite changes its
-- Forme (data store 'form': 1 Attack, 2 Defense, 3 Speed, 4 Normal); the DNA Stamp reads it (content/seals.lua).
local DEOXYS_KEYS = { 'j_poke_deoxys_attack', 'j_poke_deoxys_defense', 'j_poke_deoxys_speed' }

poke.addPokemon {
  name = 'deoxys',
  rarity = 4,
  cost = 20,
  stage = 'Legendary',
  ptype = 'Psychic',
  gen = 3,
  blueprint_compat = false,
  config = { form = 4, Xmult_multi = 0.25, money_mod = 2, chip_mod = 40 },
  attributes = { 'discard', 'seals', 'perma_bonus', 'chips', 'xmult', 'economy', 'space' },
  vars = function(get) return { get('Xmult_multi'), get('money_mod'), get('chip_mod') } end,
  text = function(get, card, state, vars)
    return poke.text.joker(DEOXYS_KEYS[get('form')] or 'j_poke_deoxys', vars)
  end,
  triggers = {
    onDiscard = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'form') ~= 4 then return end
      local cards = step.discardedCards or {}
      if (state.discardsUsed or 0) == 1 and #cards == 1 then
        poke.convert_cards(cards, { seal = 'poke_dna_seal' }, state)
        result:say('DNA!', colors.PURPLE, cards[1])
      end
    end,
  },
}


