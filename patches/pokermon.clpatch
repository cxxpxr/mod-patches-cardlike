poke.addPokemon {
  name = 'stantler', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Colorless', gen = 2,
  config = { scry = 2, triggered = 0 },
  evo_rqmt = 12,
  attributes = { 'foresight', 'mult', 'trigger_evo' },
  vars = function(get) return { get('scry'), math.max(0, 12 - get('triggered')) } end,
  passives = { scry = 'scry' },
  triggers = {
    -- The Foresight card with the highest rank adds its rank points to Mult.
    afterAllCardsScored = function(card, state, step, result)
      local best, best_rank
      for _, c in ipairs(poke.scry.cards(state)) do
        local r = poke.rank_of(c)
        if r and (not best_rank or r > best_rank) then best, best_rank = c, r end
      end
      if not best or best:getDebuffState() then return end
      if not step.copiedBy then poke.add(card, 'triggered', 1) end
      result:add(plusMult(best:getBasePointValue()))
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'wyrdeer', poke.get(card, 'triggered'), 12) end,
}

---------------------------------------------------------------------------
-- Smeargle 235: Sketch. When a blind starts it copies the Pokemon joker to its right (like Copycat) until that
-- joker leaves (lib/copy.lua: Pokemon jokers only).
---------------------------------------------------------------------------
local function sketch_target(card, state, depth)
  depth = depth or 0
  local uid = poke.get(card, 'sketch_uid')
  if not uid or depth > 8 then return nil end
  for _, j in ipairs(state.jokers or {}) do
    if j.uid == uid and j ~= card then
      if poke.name(j) == 'smeargle' then return sketch_target(j, state, depth + 1) end
      return j
    end
  end
  return nil
end

local smeargle_triggers = poke.copy_triggers { target = sketch_target }
local sketch_before_round = smeargle_triggers.beforeRound
-- When a blind starts: sketch the joker to the right first, then copy its beforeRound.
smeargle_triggers.beforeRound = function(card, state, step, result)
  if not step.copiedBy then
    local other = poke.right_joker(card, state)
    local def = other and poke.def(other)
    if def and def.blueprint_compat ~= false then
      poke.set(card, 'sketch_uid', other.uid)
      result:say(poke.text.dict('k_copied_ex', 'Copied!'), colors.ORANGE)
    end
  end
  return sketch_before_round(card, state, step, result)
end

poke.addPokemon {
  name = 'smeargle', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Colorless', gen = 2,
  attributes = { 'copying', 'applies', 'suit', 'diamonds', 'hearts', 'clubs', 'spades' },
  vars = function(get) return {} end,
  text = function(get, card, state, vars)
    local target = card and state and state.jokers and sketch_target(card, state)
    return poke.text.joker('smeargle', vars, target and colorize('(Copying ' .. target:getName() .. ')', colors.GREY))
  end,
  triggers = smeargle_triggers,
}

---------------------------------------------------------------------------
-- Tyrogue 236, Hitmontop 237
---------------------------------------------------------------------------
local function first_action_of_round(state, discarding)
  -- Cardlike counts a hand when Play is pressed and a discard when Discard is pressed.
  if discarding then return (state.handsPlayed or 0) == 0 and (state.discardsUsed or 0) <= 1 end
  return (state.handsPlayed or 0) <= 1 and (state.discardsUsed or 0) == 0
end

poke.addPokemon {
  name = 'tyrogue', rarity = 2, cost = 4, stage = 'Baby', ptype = 'Fighting', gen = 2,
  config = { Xmult_minus = 0.5, rounds = 2 },
  attributes = { 'baby', 'hands', 'discard', 'generation', 'destroy_card', 'round_evo' },
  vars = function(get) return { get('Xmult_minus'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not first_action_of_round(state, false) then return end
      local all = step.hand.allCards or {}
      if #all ~= 5 then return end
      local target = poke.random_element(all, state)
      if target and target:copy('hand') then result:say(poke.text.dict('k_copied_ex', 'Copied!'), colors.CHIPS) end
    end,
    onDiscard = function(card, state, step, result)
      if step.copiedBy or not first_action_of_round(state, true) then return end
      local all = step.discardedCards or {}
      if #all ~= 5 then return end
      local pick = poke.random_element(all, state)
      if pick then poke.set(card, 'tyrogue_pick', pick.uid) end
    end,
    onDiscardCard = function(card, state, step, result)
      if step.copiedBy then return end
      if step.card and poke.get(card, 'tyrogue_pick') == step.card.uid then
        card:getDataStore():delete('tyrogue_pick')
        return true
      end
    end,
  },
  -- Evolves by deck size: more cards than at the start: Hitmonchan; fewer: Hitmonlee; the same: Hitmontop.
  evolution = function(card, state)
    local n, start = #(state.allCards or {}), poke.starting_deck_size()
    local into = n > start and 'hitmonchan' or (n < start and 'hitmonlee' or 'hitmontop')
    return poke.level_evo(card, state, into)
  end,
}

poke.addPokemon {
  name = 'hitmontop', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Fighting', gen = 2,
  config = { Xmult = 1.5, Xmult_mod = .15 },
  attributes = { 'xmult', 'scaling', 'full_deck' },
  vars = function(get, card, state) return { get('Xmult'), poke.starting_deck_size(), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result) result:add(xMult(poke.get(card, 'Xmult'))) end,
    beforeRound = function(card, state, step, result)
      if step.copiedBy or #(state.allCards or {}) ~= poke.starting_deck_size() then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
    end,
  },
}

