  config = { mult = 8, rounds = 5 },
  attributes = { 'mult', 'full_deck', 'generation', 'round_evo' },
  vars = function(get) return { get('mult'), get('rounds'), poke.starting_deck_size() } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if poke.deck_size(state) > poke.starting_deck_size() then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
    afterRound = function(card, state, step, result)
