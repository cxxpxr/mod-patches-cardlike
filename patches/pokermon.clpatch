-- Lapras 131
---------------------------------------------------------------------------
local function lapras_chips(card)
  return poke.blinds_skipped() * poke.get(card, 'chip_mod')
end

poke.addPokemon {
  name = 'lapras', rarity = 3, cost = 5, stage = 'Basic', ptype = 'Water', gen = 1,
  -- the second ability (skipping a Blind still opens the shop) has no Cardlike API: its line is left out
  text = { '{C:chips}+#2#{} Chips for each', '{C:attention}Blind{} skipped this run', '{C:inactive}(Currently {C:chips}+#1# {C:inactive}Chips)' },
  config = { chips = 0, chip_mod = 25 },
  vars = function(get, card) return { card and lapras_chips(card) or 0, get('chip_mod') } end,
  attributes = { 'chips', 'scaling', 'skip' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips = lapras_chips(card)
      poke.set(card, 'chips', chips)
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

---------------------------------------------------------------------------
-- Ditto 132
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'ditto', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Colorless', gen = 1,
  blueprint_compat = false,
  config = { volatile = 'right' },
  attributes = { 'joker', 'volatile' },
  in_pool = function(state)
    if not state or not state.jokers then return true end
    if state:hasJoker('joker_world_line') then return true end
    for _, j in ipairs(state.jokers) do
      if j:getSticker() == 'timed' then return false end
    end
    return true
  end,
  triggers = {
    onShopExit = function(card, state, step, result)
      if step.copiedBy or not poke.volatile_active(card, poke.get(card, 'volatile'), state) then return end
      local target
      for _, j in ipairs(state.jokers or {}) do
        if j.uid ~= card.uid and poke.name(j) ~= 'ditto' then target = j break end
      end
      if not target then
        result:say('No other Jokers', colors.GREY)
        return
      end
      poke.apply_type_sticker(card, 'Colorless', state)
      poke.evolve(card, target:getJokerDef(), { transformation = true, message = poke.text.dict('poke_transform_success', 'Transformed!') }, state)
      card:setSticker('timed')
    end,
  },
}

---------------------------------------------------------------------------
-- Eevee 133 and the first Eeveelutions
---------------------------------------------------------------------------
local function count_evolvable(state)
  local n = 0
  for _, j in ipairs(state and state.jokers or {}) do
    if poke.has_highest_evo(j) then n = n + 1 end
  end
  return n
end

poke.addPokemon {
  name = 'eevee', rarity = 1, cost = 3, stage = 'Basic', ptype = 'Colorless', gen = 1,
  item_req = { 'waterstone', 'thunderstone', 'firestone', 'sunstone', 'moonstone', 'leafstone', 'icestone', 'shinystone' },
  evo_list = { waterstone = 'j_poke_vaporeon', thunderstone = 'j_poke_jolteon', firestone = 'j_poke_flareon',
    sunstone = 'j_poke_espeon', moonstone = 'j_poke_umbreon', leafstone = 'j_poke_leafeon', icestone = 'j_poke_glaceon',
    shinystone = 'j_poke_sylveon' },
  config = { mult_mod = 4 },
  vars = function(get, card, state) return { get('mult_mod'), get('mult_mod') * (card and count_evolvable(state) or 0) } end,
  attributes = { 'mult', 'item_evo' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local n = count_evolvable(state)
      if n > 0 then result:add(plusMult(poke.get(card, 'mult_mod') * n)) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, nil) end,
}

poke.addPokemon {
  name = 'vaporeon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Water', gen = 1,
  enhancement_gate = 'Chipped',
  config = { chip_mod = 4 },
  vars = function(get) return { get('chip_mod') } end,
  attributes = { 'modify_card', 'chips', 'perma_bonus', 'enhancements' },
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'Chipped') then return end
      for _, c in ipairs(step.hand.playedCards or {}) do
        c:addAdditionalPointValue(poke.get(card, 'chip_mod'))
        result:say('Upgrade!', colors.CHIPS, c)
      end
    end,
  },
}

poke.addPokemon {
  name = 'jolteon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Lightning', gen = 1,
  enhancement_gate = 'Gilded',
  config = { money = 5 },
  vars = function(get) return { get('money') } end,
  attributes = { 'discard', 'economy', 'enhancements' },
  triggers = {
    onDiscardCard = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'Gilded') then return end
      if poke.is_debuffed(step.card) then
        result:say('Debuffed', colors.MULT, step.card)
      else
        result:add(plusMoney(poke.ease_poke_dollars(card, 'jolteon', poke.get(card, 'money'), true, state)))
      end
    end,
  },
}

poke.addPokemon {
  name = 'flareon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Fire', gen = 1,
  enhancement_gate = 'Multicard',
  config = { Xmult_multi = 2 },
  vars = function(get) return { get('Xmult_multi') } end,
  attributes = { 'xmult', 'enhancements' },
  triggers = {
    onScore = function(card, state, step, result)
      local mult_cards = {}
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.has_enhancement(c, 'Multicard') then mult_cards[#mult_cards + 1] = c.uid end
      end
      local n = #mult_cards
      if n > 0 and (step.card.uid == mult_cards[n] or (n > 1 and step.card.uid == mult_cards[n - 1])) then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}

