poke.addPokemon {
  name = 'rhydon', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Earth', gen = 1,
  enhancement_gate = 'Rock',
  item_req = 'linkcable',
  config = { chips = 16, retriggers = 1 },
  attributes = { 'enhancements', 'modify_card', 'chips', 'perma_bonus', 'retrigger', 'item_evo' },
  vars = function(get) return { get('chips') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_stone') then return end
      step.card:addAdditionalPointValue(poke.get(card, 'chips'))
      result:say('Upgrade!', colors.CHIPS, step.card)
    end,
