      if (state.freeConsumableSlots or 0) <= 0 then return end
      local forced = poke.energy.get_matching_energy((state.jokers or {})[1], true)
      if forced == poke.energy.card_id('Bird') and not step.copiedBy then poke.evolve(card, 'porygonz') end
      local made = poke.create_consumeable(forced and { key = forced } or { set = 'poke_energy' }, card)
      if made then result:say(poke.text.dict('poke_plus_energy', '+1 Energy'), poke.colours.pink) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'porygonz') end,
}

