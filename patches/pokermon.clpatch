-- Heracross 214 and Mega Heracross
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'heracross', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 2,
  config = { Xmult = 2 },
  megas = { 'mega_heracross' },
  attributes = { 'rank', 'xmult' },
  vars = function(get) return { get('Xmult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local ranks = {}
      for _, c in ipairs(step.hand.playedCards or {}) do
        local r = poke.rank_of(c)
        if r then ranks[r] = true end
      end
      for _, c in ipairs(step.held or state.cardsInHand or {}) do
        local r = poke.rank_of(c)
        if r and ranks[r] then return end
      end
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
  },
}

poke.addPokemon {
  name = 'mega_heracross', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Grass', gen = 2,
  config = { retriggers = 2 },
  attributes = { 'retrigger' },
  vars = function(get) return {} end,
  triggers = {
    -- Fewer than 5 cards played: it faints before the cards score, so it gives no retriggers.
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      if #(step.hand.allCards or {}) < 5 then
        card:punch()
        poke.faint(card, state)
      end
    end,
    repeatCard = function(card, state, step, result)
      if card:getDebuffState() then return 0 end
      return poke.get(card, 'retriggers')
    end,
    onDiscard = function(card, state, step, result)
      if step.copiedBy then return end
      if #(step.discardedCards or {}) < 5 then
        card:punch()
        poke.faint(card, state)
      end
    end,
  },
}

