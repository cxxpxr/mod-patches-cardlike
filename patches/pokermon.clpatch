      result:add(plusMult(card:getSellValue()))
    end,
    onOtherJoker = function(card, state, step, result)
      local other = step.other
      if other and other:getSellValue() < 2 then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
