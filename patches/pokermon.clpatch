-- Lickitung 108
poke.addPokemon {
  name = 'lickitung', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Colorless', gen = 1,
  config = { Xmult_multi = 1.5, jacks_played = 0 },
  evo_rqmt = 15,
  attributes = { 'xmult', 'rank', 'jack', 'trigger_evo' },
  vars = function(get) return { get('Xmult_multi'), math.max(0, 15 - get('jacks_played')) } end,
  triggers = {
    onScore = function(card, state, step, result)
      local found = 0
      for _, c in ipairs(step.hand.playedCards) do
        if poke.rank_of(c) == 11 then
          found = found + 1
          if c == step.card then
            if not step.copiedBy then poke.add(card, 'jacks_played', 1) end
            result:add(xMult(poke.get(card, 'Xmult_multi')))
            return
          end
          if found >= 2 then return end
        end
      end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'lickilicky', poke.get(card, 'jacks_played'), 15)
  end,
}

