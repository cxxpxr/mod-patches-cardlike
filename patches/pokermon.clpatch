  config = { mult_mod = 4, money_count = 10, money_threshold = 50 },
  megas = { 'mega_raichu_x', 'mega_raichu_y' },
  attributes = { 'mult', 'economy' },
  -- #1# mult, #2# money step, #3# current mult, #4# threshold (unused by the text)
  vars = function(get, card, state)
    return { get('mult_mod'), get('money_count'), card and money_mult(card, state) or 0, get('money_threshold') }
  end,
  triggers = {
    beforeRound = function(card, state, step, result)
      local earned = poke.interest(state, mega_raichu_x_cap(state))
      if earned > 0 then
        card:punch()
        result:add(plusMoney(poke.ease_poke_dollars(card, 'raichu', earned, true, state)))
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = money_mult(card, state)
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
}

