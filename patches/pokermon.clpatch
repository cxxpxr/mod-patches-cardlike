== file content/consumables/balls.lua (38 lines)
-- Poke Balls: create a random Pokemon joker of a stage (original consumables/00_mart_balls.lua).
local poke = cardlike.require('lib.pokermon')
local C = cardlike.require('content.consumables.common')

local function ball(t)
  cardlike.addConsumable {
    id = t.id,
    type = t.type,
    readableName = C.name(t.set, 'c_poke_' .. t.id),
    price = t.cost,
    hidden = t.hidden,
    sprite = poke.sprites.at('consumables', t.pos[1], t.pos[2]),
    layerSprite = t.soul and poke.sprites.at('consumables', t.soul[1], t.soul[2]) or nil,
    description = function(r)
      return C.desc(t.set, 'c_poke_' .. t.id, {}) .. '\n' .. colorize(t.note, colors.GREY)
    end,
    canUse = function(ctx)
      if (ctx.state.freeJokerSlots or 0) < 1 then return 'No room for a joker' end
      return ''
    end,
    action = function(ctx)
      if t.spoon then poke.set_spoon_item(t.id) end
      local joker = poke.create_random_poke_joker({ stage = t.stage })
      if joker then joker:popup(poke.text.name(t.set, 'c_poke_' .. t.id) .. '!', colors.ORANGE) end
    end,
  }
end

ball { id = 'pokeball', set = 'poke_item', type = 'pokermon:item', cost = 3, pos = { 0, 3 }, stage = 'Basic', spoon = true,
  note = '(Basic: a Pokemon that has not evolved)' }
ball { id = 'greatball', set = 'poke_item', type = 'pokermon:item', cost = 4, pos = { 1, 3 }, stage = 'One', spoon = true,
  note = '(Stage 1: a Pokemon that has evolved once)' }
-- Ultra Ball and Master Ball are Admin cards that appear rarely in place of an Item (soul_rate 0.008 and 0.003).
ball { id = 'ultraball', set = 'Spectral', type = 'admin', cost = 4, pos = { 2, 3 }, stage = 'Two', hidden = true,
  note = '(Stage 2: a Pokemon that has evolved twice)' }
ball { id = 'masterball', set = 'Spectral', type = 'admin', cost = 4, pos = { 3, 3 }, soul = { 4, 2 }, stage = 'Legendary',
  hidden = true, note = '(A Legendary Pokemon)' }


== file content/consumables/berry.lua (165 lines)
-- Berry Juice Item cards (made by Shuckle). Original file: consumables/06_mart_berry.lua.
-- They never appear in the shop or in packs.
local poke = cardlike.require('lib.pokermon')

-- Cardlike has no joker selection: these cards always pick the leftmost joker.
local function desc(key, vars) return (poke.text.describe('poke_item', key, vars):gsub(' or selected', '')) end
local function chance_vars(num, dem)
  local m = (cardlike.state and cardlike.state.chanceMultiplier) or 1
  return { num * m, dem }
end

-- The Berry Juice made from each consumable type (Balatro pokermon.juice_list), for Shuckle.
poke.juice_list = {
  game = poke.items.id('berry_juice_tarot'),
  fruit = poke.items.id('berry_juice_planet'),
  admin = poke.items.id('berry_juice_spectral'),
  [poke.MOD_ID .. ':item'] = poke.items.id('berry_juice_item'),
  [poke.MOD_ID .. ':energy'] = poke.items.id('berry_juice_energy'),
}

local function juice(t)
  t.type = 'item'
  t.price = 12
  t.hidden = true
  t.readableName = poke.text.name('poke_item', 'c_poke_' .. t.id)
  t.credits = t.credits or 'Art: Sonfive'
  return cardlike.addConsumable(t)
end

-- Berry Juice: its effect depends on the consumable Shuckle destroyed; by itself it does nothing.
juice {
  id = 'berry_juice',
  sprite = poke.sprites.at('consumables', 1, 6),
  description = function(r) return desc('c_poke_berry_juice', {}) end,
  canUse = function(ctx) return 'No effect' end,
}

-- Energized: energy of its type to the leftmost joker with a type.
local function energy_target(state)
  return poke.find_card(function(j) return poke.get_type(j) ~= nil end, state)
end

juice {
  id = 'berry_juice_energy',
  sprite = poke.sprites.at('consumables', 6, 6),
  description = function(r)
    local limit = poke.settings.unlimited_energy and 'Infinity' or (poke.energy.max + (poke.run.energy_plus or 0))
    return desc('c_poke_berry_juice_energy', { limit })
  end,
  canUse = function(ctx)
    if not energy_target(ctx.state) then return 'No joker with a type' end
    return ''
  end,
  action = function(ctx)
    local target = energy_target(ctx.state)
    cardlike.playSound('energy_use', { volume = 0.5 })
    if target then poke.energy.increase(target, poke.get_type(target)) end
    -- Like Double Rainbow Energy: no interest this round (content/rules.lua reads these modifiers).
    if not poke.modifier('no_interest') then
      poke.set_modifier('no_interest', true)
      poke.set_modifier('reset_no_interest', true)
    end
  end,
}

-- Ghostly: 1 selected card gets a random edition (Luna, Holo or Chroma) and a random stamp.
local STAMPS = { 'Replay Stamp', 'Cash Stamp', 'Fruit Stamp', 'Game Stamp' }

juice {
  id = 'berry_juice_spectral',
  sprite = poke.sprites.at('consumables', 4, 6),
  description = function(r) return desc('c_poke_berry_juice_spectral', { 1 }) end,
  canUse = function(ctx)
    if #ctx.selectedCards ~= 1 then return 'Select 1 card' end
    return ''
  end,
  action = function(ctx)
    local state = ctx.state
    local r = state:randomFloat()
    local edition = r < 0.5 and 'Luna' or r < 0.85 and 'Holo' or 'Chroma'
    local card = ctx.selectedCards[1]
    card:setEdition(edition)
    card:setStamp(STAMPS[state:random(1, #STAMPS)])
    card:punch()
  end,
}

-- Starry: +1 level to the hand type with the highest level.
juice {
  id = 'berry_juice_planet',
  sprite = poke.sprites.at('consumables', 3, 6),
  description = function(r) return desc('c_poke_berry_juice_planet', {}) end,
  action = function(ctx)
    local state = ctx.state
    local best, level = nil, -1
    for _, id in ipairs({ 'HIGH_CARD', 'PAIR', 'TWO_PAIR', 'THREE_OF_A_KIND', 'STRAIGHT', 'FLUSH', 'FULL_HOUSE', 'FOUR_OF_A_KIND',
        'STRAIGHT_FLUSH', 'ROYAL_FLUSH', 'FLUSH_HOUSE', 'FIVE_OF_A_KIND', 'FLUSH_FIVE' }) do
      local h = state:getHand(id)
      if h and h.level > level then best, level = id, h.level end
    end
    for id, h in pairs(state.hands or {}) do
      if type(h) == 'table' and (h.level or 0) > level then best, level = id, h.level end
    end
    if best then
      state:upgradeHand(best, 1)
      ctx.self:popup('Upgrade!', colors.ORANGE)
    end
  end,
}

