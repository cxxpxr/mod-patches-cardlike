  ptype = 'Water',
  gen = 4,
  config = { chips = 30, rounds = 4 },
  attributes = { 'chips', 'round_evo' },
  vars = function(get) return { get('chips'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result) unscored_chips(card, step, result) end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'floatzel') end,
}

-- Floatzel 419: +45 Points for each unscored card in the played hand.
poke.addPokemon {
  name = 'floatzel',
