---------------------------------------------------------------------------
-- Squirtle line
---------------------------------------------------------------------------

local function squirtle_def(name, rarity, cost, stage, chips, chip_mod, target, into)
  return {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Water', gen = 1, starter = stage == 'Basic' or nil,
    copy_scaled = stage == 'One' or nil,
    config = { chips = chips, chip_mod = chip_mod, hands = 1 },
    evo_rqmt = target,
    attributes = { 'starter', 'hands', 'passive', 'chips', 'scaling', 'scaling_evo' },
    -- #1# chips, #2# hands, #3# chips to evolve, #4# chips per remaining hand
    vars = function(get) return { get('chips'), get('hands'), target, get('chip_mod') } end,
    passives = { hands = 'hands' },
    triggers = {
      beforeAllCardsScored = function(card, state, step, result)
        if step.copiedBy then return end
        local gain = poke.get(card, 'chip_mod') * state.handsLeft
        if gain <= 0 then return end
        poke.add(card, 'chips', gain)
        result:say('+' .. poke.text.num(gain) .. ' Points', colors.CHIPS)
      end,
      afterAllCardsScored = function(card, state, step, result)
        local chips = poke.get(card, 'chips')
        if chips > 0 then result:add(plusChips(chips)) end
      end,
    },
    evolution = function(card, state)
      return poke.scaling_evo(card, state, into, poke.get(card, 'chips'), target)
    end,
  }
end

