-- Chansey 113: the first 2 Paperback (Lucky) cards that trigger each round are copied into the hand.
poke.addPokemon {
  name = 'chansey', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Colorless', gen = 1,
  enhancement_gate = 'Paperback',
  config = { limit = 2, triggers = 0 },
  attributes = { 'enhancements', 'generation', 'condition_evo' },
  vars = function(get, card, state)
    local deck_data = ''
    if card and state and state.allCards then
      local n = 0
      for _, c in ipairs(state.allCards) do if poke.has_enhancement(c, 'm_lucky') then n = n + 1 end end
      deck_data = '[' .. n .. '/' .. math.ceil(#state.allCards / 4) .. '] '
    end
    return { get('limit'), get('triggers'), deck_data }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.enhancement_triggered('Paperback') or not poke.has_enhancement(step.card, 'm_lucky') then return end
      if poke.get(card, 'triggers') >= poke.get(card, 'limit') then return end
      local copy = step.card:copy('hand')
      if not step.copiedBy then poke.add(card, 'triggers', 1) end
      if copy then result:say('Copied!', colors.CHIPS) end
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'triggers', 0) end
    end,
  },
  evolution = function(card, state) return poke.deck_enhance_evo(card, state, 'blissey', 'm_lucky', .25) end,
}

-- Tangela 114
poke.addPokemon {
  name = 'tangela', rarity = 1, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 1,
  enhancement_gate = 'Plaid',
  config = { mult = 10, chips = 50, money_mod = 3, num = 1, dem = 4, wilds_scored = 0 },
  evo_rqmt = 10,
  attributes = { 'enhancements', 'chips', 'mult', 'economy', 'chance', 'trigger_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('mult'), get('chips'), get('money_mod'), num, dem, math.max(0, 10 - get('wilds_scored')) }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_wild') then return end
      if not step.copiedBy then poke.add(card, 'wilds_scored', 1) end
      local money = function() return plusMoney(poke.ease_poke_dollars(card, 'tangela', poke.get(card, 'money_mod'), true, state)) end
      if poke.roll(card, state) then
        result:add(plusMult(poke.get(card, 'mult')))
        result:add(plusChips(poke.get(card, 'chips')))
        result:add(money())
        result:say(poke.text.dict('poke_tangela_bonus', 'All three!'), colors.GREEN)
      else
        local pick = state:random(1, 3)
        if pick == 1 then result:add(plusMult(poke.get(card, 'mult')))
        elseif pick == 2 then result:add(plusChips(poke.get(card, 'chips')))
        else result:add(money()) end
      end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'tangrowth', poke.get(card, 'wilds_scored'), 10)
  end,
}

