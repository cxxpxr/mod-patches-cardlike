  config = { money = 4, num = 1, dem = 4 },
  attributes = { 'holding', 'chance', 'economy' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num', 1), get('dem'), state)
    return { get('money'), num, dem }
  end,
  onAdded = function(card, state) poke.holding(card, 'leek', state) end,
  triggers = {
    onConsumableUsed = function(card, state, step, result)
      local used = step.card and ((step.card.lastInfo or {}).consumable or step.card:getConsumableDef())
      if used == poke.items.id('leek') or state:chance(poke.get(card, 'num', 1) / poke.get(card, 'dem')) then
        card:punch()
        result:add(plusMoney(poke.ease_poke_dollars(card, 'farfet', poke.get(card, 'money'), true, state)))
      end
    end,
  },
}

-- Doduo 084
