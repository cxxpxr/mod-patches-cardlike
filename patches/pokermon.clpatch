-- Dusclops 356: in the final hand, a single unscored card is destroyed and makes an Admin card.
poke.addPokemon {
  name = 'dusclops', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Psychic', gen = 3,
  item_req = 'linkcable',
  config = { retriggers = 1 },
  attributes = { 'retrigger', 'hands', 'destroy_card', 'spectral', 'item_evo' },
  vars = function(get) return { get('retriggers') } end,
  triggers = {
    repeatCard = function(card, state, step, result) return final_hand_retrigger(card, state, step) end,
    afterAllCardsScored = function(card, state, step, result)
      if step.copiedBy or state.handsLeft ~= 0 then return end
      local all, scoring = step.hand.allCards or {}, step.hand.playedCards or {}
      if #all - #scoring ~= 1 then return end
      local in_scoring = {}
      for _, c in ipairs(scoring) do in_scoring[c.uid] = true end
      for _, c in ipairs(all) do
        if not in_scoring[c.uid] then
          if state.freeConsumableSlots > 0 then poke.create_consumeable({ set = 'admin' }, card) end
          c:destroy()
          break
        end
      end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'dusknoir') end,
}

---------------------------------------------------------------------------
-- Tropius 357: a Banana joker (Mona or Mona Lisa, Balatro Gros Michel or Cavendish) once per ante; X Mult when a
-- joker is destroyed (the library's destroyed-joker tracker: jokers that leave without being sold).
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'tropius', rarity = 2, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 3,
  config = { Xmult = 1, Xmult_mod = 0.5, cavendish_chance = 0, chance_increase = 0.2, active = true },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 1 then result:add(xMult(x)) end
    end,
    afterRound = function(card, state, step, result)
      if not poke.get(card, 'active') then return end
      if not step.copiedBy then poke.set(card, 'active', false) end
      if state.freeJokerSlots <= 0 then return end
      local id = state:randomFloat() > poke.get(card, 'cavendish_chance') and 'joker_prado' or 'joker_mona_lisa'
      local banana = cardlike.createJoker(id)
      if banana then banana:popup('Banana!', colors.ORANGE) end
    end,
    onAnteChanged = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'active', true) end
    end,
  },
}

-- A destroyed joker (not sold) gives every Tropius X Mult; a destroyed Mona (Gros Michel) raises the Mona Lisa
-- chance.
poke.on_joker_destroyed(function(state, uid, joker_id)
  for _, t in ipairs(poke.active_jokers(state, 'tropius')) do
    if joker_id == 'joker_prado' then poke.add(t, 'cavendish_chance', poke.get(t, 'chance_increase')) end
    local x = poke.add(t, 'Xmult', poke.get(t, 'Xmult_mod'))
    t:popup('X' .. poke.text.num(x), colors.MULT)
  end
end)

---------------------------------------------------------------------------
-- Chimecho 358: Tickets are free. The first 2 Fragile (Glass) cards destroyed each round come back.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'chimecho', rarity = 'poke_safari', cost = 7, stage = 'Basic', ptype = 'Psychic', gen = 3,
  config = { glass_restored = 0, glass_limit = 2 },
  enhancement_gate = 'Fragile',
  attributes = { 'enhancements', 'generation' },
  vars = function(get)
    local used = get('glass_restored') >= get('glass_limit')
    return { get('glass_limit'), get('glass_limit') - get('glass_restored'), colours = { used and colors.GREY or nil } }
  end,
  triggers = {
    onCardsRemoved = function(card, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(step.cards or {}) do
        if poke.get(card, 'glass_restored') >= poke.get(card, 'glass_limit') then break end
        local info = c.lastInfo or {}
        if info.enhancement == 'Fragile' then
          local area = (state:isPhase('play') or state:isPhase('scoring')) and 'hand' or 'deck'
          local copy = cardlike.addPlayingCard({ rank = info.rank, suit = info.suit, enhancement = 'Fragile',
            edition = info.edition ~= 'default' and info.edition or nil, stamp = info.stamp, bonusPoints = info.bonusPoints }, { area = area })
          if copy then
            poke.add(card, 'glass_restored', 1)
            result:say('Copied!', colors.CHIPS)
          end
        end
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'glass_restored') <= 0 then return end
      poke.set(card, 'glass_restored', 0)
      result:say('Reset', colors.GREEN)
    end,
  },
}

cardlike.filter('price', function(price, card)
  local kind = card and ((card.lastInfo and card.lastInfo.kind) or card.kind)
  if kind == 'ticket' and #poke.active_jokers(cardlike.state, 'chimecho') > 0 then return 0 end
end)

