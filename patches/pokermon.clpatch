-- Hitmonlee 106
poke.addPokemon {
  name = 'hitmonlee', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Fighting', gen = 1,
  config = { Xmult_mod = 0.15 },
  attributes = { 'xmult', 'full_deck' },
  vars = function(get, card, state)
    local start = poke.starting_deck_size()
    local below = state and (start - poke.deck_size(state)) or 0
    return { get('Xmult_mod'), start, math.max(1, 1 + below * get('Xmult_mod')) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + (poke.starting_deck_size() - poke.deck_size(state)) * poke.get(card, 'Xmult_mod')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

