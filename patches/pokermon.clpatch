    return { num, dem, get('retriggers') }
  end,
  triggers = {
    repeatCard = function(card, state, step, result)
      if #(step.hand.playedCards or {}) ~= 5 or step.card:getDebuffState() then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        result:say('Again!', colors.ORANGE)
        return poke.get(card, 'retriggers')
      end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'cloyster') end,
}


== file jokers/pokejokers_04.lua (728 lines)
-- Pokemon jokers 091 to 120 (original file pokemon/pokejokers_04.lua).
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Turn a random joker (from a filtered list) Inverted. Returns the joker or nil.
local function lick_random_joker(state, keep)
  local eligible = {}
  for _, j in ipairs(state.jokers or {}) do
    if keep(j) then eligible[#eligible + 1] = j end
  end
  local pick = poke.random_element(eligible, state)
  if pick then
    pick:setEdition('Inverted')
    pick:popup(poke.text.dict('poke_lick_ex', 'Lick!'), colors.PURPLE)
  end
  return pick
end

-- Held consumables, with Thick Clubs counted twice (Cubone, Marowak).
local THICK_CLUB = poke.items.id('thickclub')
local function consumable_count(state)
  if not state then return 0 end
  local n = 0
  for _, c in ipairs(state.consumables or {}) do
    n = n + 1
    if c:getConsumableDef() == THICK_CLUB then n = n + 1 end
  end
  return n
end

-- Gold (Gilded) cards held at the end of the round pay again (Goldeen, Seaking). Cardlike pays Gilded cards at the
-- round end without a retrigger step, so the extra payouts are given here: $3 plus the card's held-money bonus.
local GILDED_MONEY = 3
local function retrigger_gilded(card, state, result, times)
  for _, c in ipairs(state.cardsInHand or {}) do
    if poke.has_enhancement(c, 'm_gold') and not c:getDebuffState() then
      local amount = (GILDED_MONEY + poke.get_perma_bonus(c, 'h_dollars')) * times
      if amount > 0 then
        state:mutateMoney(amount)
        result:say('Again!', colors.MONEY, c)
      end
    end
  end
end

---------------------------------------------------------------------------
-- The Pokemon
---------------------------------------------------------------------------

-- Cloyster 091
poke.addPokemon {
  name = 'cloyster', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Water', gen = 1,
  config = { retriggers = 1, num = 1, dem = 2 },
  attributes = { 'chance', 'retrigger' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem, get('retriggers') }
  end,
  triggers = {
    repeatCard = function(card, state, step, result)
      if #step.hand.playedCards == 5 and poke.roll(card, state) then
        return poke.get(card, 'retriggers')
      end
    end,
  },
}

-- Gastly 092
poke.addPokemon {
  name = 'gastly', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Psychic', gen = 1,
  blueprint_compat = false,
  config = { num = 1, dem = 6, rounds = 3 },
  attributes = { 'chance', 'editions', 'round_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem, get('rounds') }
  end,
  triggers = {
    afterRound = function(card, state, step, result)
      if not poke.roll(card, state) then return end
      local picked = lick_random_joker(state, function(j) return j ~= card end)
      if picked then result:destroySelf() end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'haunter') end,
}

-- Haunter 093
poke.addPokemon {
  name = 'haunter', rarity = 3, cost = 9, stage = 'One', ptype = 'Psychic', gen = 1,
  item_req = 'linkcable',
  blueprint_compat = false,
  config = { num = 1, dem = 4 },
  attributes = { 'chance', 'editions', 'item_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem }
  end,
  triggers = {
    afterRound = function(card, state, step, result)
      if not poke.roll(card, state) then return end
      local picked = lick_random_joker(state, function(j) return j ~= card end)
      if picked then result:destroySelf() end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'gengar') end,
}

-- Gengar 094: counts down a random number of rounds (2 to 8, most often 5), then makes a random joker Inverted.
local function set_gengar_rounds(card, state)
  local p = state:randomFloat()
  local rounds
  if p < .05 then rounds = 2
  elseif p < .15 then rounds = 3
  elseif p < .35 then rounds = 4
  elseif p < .65 then rounds = 5
  elseif p < .85 then rounds = 6
  elseif p < .95 then rounds = 7
  else rounds = 8 end
  poke.set(card, 'gengar_rounds', rounds)
end

poke.addPokemon {
  name = 'gengar', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Psychic', gen = 1,
  blueprint_compat = false,
  config = { gengar_rounds = 5 },
  megas = { 'mega_gengar' },
  attributes = { 'editions' },
  vars = function(get) return { get('gengar_rounds') } end,
  onAdded = function(card, state) set_gengar_rounds(card, state) end,
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      local rounds = poke.add(card, 'gengar_rounds', -1)
      if rounds > 0 then
        result:say(poke.text.dict('poke_nasty_plot_ex', 'Nasty Plot!'), colors.PURPLE)
        return
      end
      set_gengar_rounds(card, state)
      if lick_random_joker(state, function(j) return poke.name(j) ~= 'gengar' end) then card:punch() end
    end,
  },
}

