      if step.copiedBy then return end
      local n = 0
      for _, c in ipairs(step.hand.playedCards or {}) do
        local e = c.lastInfo and c.lastInfo.enhancement or c:getEnhancement()
        if e and e ~= 'Default' and not poke.is_debuffed(c) then
          c:setEnhancement('Default')
          c:punch()
          n = n + 1
        end
      end
      if n > 0 then
        result:add(plusMoney(poke.ease_poke_dollars(card, 'rotomw', poke.get(card, 'money') * n, true, state)))
      end
    end,
  },
}

