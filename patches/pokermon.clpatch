-- Pokemon jokers 541-570 (Trubbish, Garbodor, Zorua). Port of pokejokers_19.lua.
local poke = cardlike.require('lib.pokermon')

-- Trubbish 568: gains +3 Points and earns $2 per unused discard if no discards are used by the end of the round.
-- Evolves after triggering 4 times.
poke.addPokemon {
  name = 'trubbish',
  rarity = 1,
  cost = 5,
  stage = 'Basic',
  ptype = 'Dark',
  gen = 5,
  config = { chips = 0, chip_mod = 3, money = 2, triggers = 0 },
  evo_rqmt = 4,
  attributes = { 'discard', 'economy', 'chips', 'scaling', 'trigger_evo' },
  vars = function(get)
    return { get('chips'), get('chip_mod'), get('money'), math.max(0, 4 - get('triggers')) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      if (state.discardsUsed or 0) == 0 and (state.discardsLeft or 0) > 0 then
        local gain = poke.get(card, 'chip_mod') * state.discardsLeft
        poke.add(card, 'chips', gain)
        poke.add(card, 'triggers', 1)
        result:say('+' .. poke.text.num(gain), colors.CHIPS)
      end
    end,
  },
  dollarsAtRoundEnd = function(card, state)
    if (state.discardsUsed or 0) == 0 and (state.discardsLeft or 0) > 0 then
      return poke.ease_poke_dollars(card, 'trubbish', state.discardsLeft * poke.get(card, 'money'), true, state)
    end
    return 0
  end,
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'garbodor', poke.get(card, 'triggers'), 4)
  end,
}

-- Garbodor 569: gains +5 Points per unused discard if no discards are used by the end of the round. Creates a
-- Trash Pin (Garbage Tag) if no discards are used during the whole ante (checked when the Boss Blind is beaten).
poke.addPokemon {
  name = 'garbodor',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Dark',
  gen = 5,
  config = { chips = 0, chip_mod = 5, triggers = 0, active = false },
  attributes = { 'discard', 'economy', 'chips', 'scaling', 'tag', 'generation' },
  vars = function(get)
    return { get('chips'), get('chip_mod'), get('money') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      if (state.discardsUsed or 0) == 0 and (state.discardsLeft or 0) > 0 then
        local gain = poke.get(card, 'chip_mod') * state.discardsLeft
        poke.add(card, 'chips', gain)
        result:say('+' .. poke.text.num(gain), colors.CHIPS)
      end
      -- The original pays this out with the round money (calc_dollar_bonus); the pin is the same either way.
      if (poke.run.ante_discards_used or 0) == 0 and state.blind and state.blind.boss then
        cardlike.addPin('pin_20')
        result:say('+1 Pin', colors.ORANGE)
      end
    end,
  },
}

-- Zorua 570: copies the ability of the rightmost joker (lib/copy.lua). After a hand scores while copying, the copy
-- stops until the end of the round. Evolves after 5 rounds.
local function zorua_active(card, state) return poke.get(card, 'active') ~= false end

local zorua_own = {
  afterHand = function(card, state, step, result)
    if step.copiedBy then return end
    if poke.get(card, 'active') and poke.copyable_def(poke.rightmost_joker(card, state), card) then
      poke.set(card, 'active', false)
      result:say('Revealed!', colors.GREY)
    end
  end,
  afterRound = function(card, state, step, result)
    if step.copiedBy then return end
    if not poke.get(card, 'active') then
      poke.set(card, 'active', true)
      result:say('Reset', colors.GREEN)
    end
  end,
}
poke.addPokemon {
  name = 'zorua',
  rarity = 3,
  cost = 8,
  stage = 'Basic',
  ptype = 'Dark',
  gen = 5,
  config = { rounds = 5, active = true },
  attributes = { 'copying', 'round_evo' },
  vars = function(get)
    return { get('rounds'), colours = { get('active') == false and colors.GREY or nil } }
  end,
  text = function(get, card, state, vars)
    local line = card and state and poke.copy_line(card, state, poke.rightmost_joker(card, state), get('active'))
    return poke.text.joker('zorua', vars, line)
  end,
  triggers = poke.copy_triggers { target = poke.rightmost_joker, active = zorua_active, own = zorua_own },
  evolution = function(card, state)
    return poke.level_evo(card, state, 'zoroark')
  end,
}


