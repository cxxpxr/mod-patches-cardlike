---------------------------------------------------------------------------
-- Caterpie and Weedle lines: flat Mult and Points
---------------------------------------------------------------------------

local function flat_def(name, rarity, cost, stage, key, value, rounds, into, attrs)
  local config = { [key] = value }
  if rounds then config.rounds = rounds end
  local bonus = key == 'mult' and plusMult or plusChips
  return {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Grass', gen = 1,
    config = config,
    attributes = attrs,
    vars = function(get) return { get(key), get('rounds') } end,
    triggers = {
      afterAllCardsScored = function(card, state, step, result)
        result:add(bonus(poke.get(card, key)))
      end,
    },
    evolution = into and function(card, state) return poke.level_evo(card, state, into) end or nil,
  }
end

