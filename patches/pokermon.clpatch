  triggers = {
    onScore = function(card, state, step, result)
      if step.card:isFace() then result:add(plusChips(poke.get(card, 'chips'))) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'kingler') end,
}

-- Kingler 099
poke.addPokemon {
  name = 'kingler', rarity = 2, cost = 7, stage = 'One', ptype = 'Water', gen = 1,
  config = { chips = 20 },
  attributes = { 'chips', 'face', 'modify_card', 'enhancements' },
  vars = function(get) return { get('chips') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local changed = 0
      for _, c in ipairs(step.hand.playedCards) do
        if c:isFace() and c:getEnhancement() == 'Default' then
          c:setEnhancement('Chipped')
          c:punch()
          changed = changed + 1
        end
      end
      if changed > 0 then result:say(poke.text.dict('poke_surf_ex', 'Surf!'), colors.CHIPS) end
    end,
    onScore = function(card, state, step, result)
      if step.card:isFace() then result:add(plusChips(poke.get(card, 'chips'))) end
    end,
  },
}

