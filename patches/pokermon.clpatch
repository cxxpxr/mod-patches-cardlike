-- Bunnelby 659
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'bunnelby', rarity = 1, cost = 6, stage = 'Basic', ptype = 'Colorless', gen = 6,
  config = { num = 1, dem = 3, triggers = 0 },
  evo_rqmt = 4,
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem, math.max(4 - get('triggers'), 0) }
  end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      for _, drawn in ipairs(depleted_draws(state, step)) do
        if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
          if state.freeConsumableSlots > 0 then
            if not step.copiedBy then poke.add(card, 'triggers', 1) end
            poke.create_consumeable({ set = 'game' }, step.copiedBy or card)
          end
        else
          poke.nope(step.copiedBy or card)
        end
      end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'diggersby', poke.get(card, 'triggers'), 4)
  end,
}

---------------------------------------------------------------------------
-- Diggersby 660
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'diggersby', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Earth', gen = 6,
