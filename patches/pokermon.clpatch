}

-- Golett / Golurk: cards held in hand have a chance to give X Mult (always for Hazard cards).
local function golem_trigger(card, state, step, result)
  local c = step.card
  if poke.has_enhancement(c, 'm_poke_hazard') or state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
    if c:getDebuffState() then
      result:say('Debuffed', colors.MULT)
    else
      result:add(xMult(poke.get(card, 'Xmult_multi')))
    end
  end
end

-- Golett 622: +1 hazard layer. 1 in 4 chance for cards held in hand to give X1.2 Mult, always for Hazard cards.
-- Evolves after 5 rounds.
poke.addPokemon {
  name = 'golett',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Psychic',
  gen = 5,
  config = { hazard_level = 1, Xmult_multi = 1.2, rounds = 5, num = 1, dem = 4 },
  attributes = { 'hazards', 'xmult', 'chance', 'round_evo' },
  vars = function(get, card, state)
    return { get('hazard_level'), get('Xmult_multi'), get('rounds'), poke.chance_num(get('num'), state), get('dem') }
  end,
  passives = { hazard_level = 'hazard_level' },
  triggers = { onScoreInHand = golem_trigger },
  evolution = function(card, state) return poke.level_evo(card, state, 'golurk') end,
}

-- Golurk 623: +1 hazard layer. 1 in 3 chance for cards held in hand to give X1.3 Mult, always for Hazard cards.
poke.addPokemon {
