-- Wailmer 320, Wailord 321: Points for each Club left in the deck.
local function clubs_left(card, state)
  if not state or state.money == nil then return 0 end
  local suit = poke.get(card, 'suit')
  return #poke.find_playing_card(function(c) return c:isSuit(suit) end, nil, state)
end

local function wail_score(card, state, step, result)
  local n = clubs_left(card, state)
  if n > 0 then result:add(plusChips(poke.get(card, 'chip_mod') * n)) end
end

poke.addPokemon {
  name = 'wailmer', rarity = 1, cost = 5, gen = 3, stage = 'Basic', ptype = 'Water',
  config = { chip_mod = 6, rounds = 5, suit = 'Clubs' },
  vars = function(get, card, state)
    return { get('chip_mod'), get('chip_mod') * clubs_left(card, state), get('rounds'), 'Club' }
  end,
  triggers = { afterAllCardsScored = wail_score },
  evolution = function(card, state) return poke.level_evo(card, state, 'wailord') end,
}

poke.addPokemon {
  name = 'wailord', rarity = 'poke_safari', cost = 7, gen = 3, stage = 'One', ptype = 'Water',
  config = { chip_mod = 10, suit = 'Clubs' },
  vars = function(get, card, state)
    return { get('chip_mod'), get('chip_mod') * clubs_left(card, state), 'Club', 'Clubs' }
  end,
  triggers = {
    afterAllCardsScored = wail_score,
    -- Playing cards in an opened pack (Balatro Standard packs) become Clubs.
    onPackOpened = function(card, state, step, result)
      if step.copiedBy then return end
      local suit = poke.get(card, 'suit')
      for _, c in ipairs(state.packCards or {}) do
        if c:getKind() == 'playing' and c:getSuit() ~= suit then c:setSuit(suit) end
      end
    end,
  },
}

