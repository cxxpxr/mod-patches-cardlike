---------------------------------------------------------------------------
-- Skarmory 227 and Mega Skarmory
---------------------------------------------------------------------------
local function count_held(list, fn, skip_selected)
  local n = 0
  for _, c in ipairs(list or {}) do
    if fn(c) and not (skip_selected and (c.lastInfo or {}).selected) then n = n + 1 end
  end
  return n
end
local function hazard_or_steel(c) return poke.has_enhancement(c, 'm_poke_hazard', 'm_steel') end
local function gold_or_steel(c) return poke.has_enhancement(c, 'm_steel', 'm_gold') end

poke.addPokemon {
  name = 'skarmory', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Metal', gen = 2,
  config = { hazard_level = 1, Xmult_mod = 0.4, hazard_max = 1 },
  megas = { 'mega_skarmory' },
  attributes = { 'hazards', 'xmult', 'enhancements' },
  vars = function(get, card, state)
    local n = state and count_held(state.cardsInHand, hazard_or_steel) or 0
    return { get('hazard_level'), get('Xmult_mod'), 1 + get('Xmult_mod') * n, get('hazard_max') }
  end,
  passives = { hazard_max = 'hazard_max', hazard_level = 'hazard_level' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.get(card, 'Xmult_mod') * count_held(step.held or state.cardsInHand, hazard_or_steel)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

poke.addPokemon {
  name = 'mega_skarmory', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Metal', gen = 1,
  config = { hazard_level = 1, hazard_max = 1, Xmult_multi = 1 },
  attributes = { 'hazards', 'xmult', 'enhancements' },
  vars = function(get, card, state)
    local n = state and count_held(state.cardsInHand, gold_or_steel, true) or 0
    return { get('hazard_level'), get('Xmult_multi'), 1 + n * get('Xmult_multi') }
  end,
  passives = { hazard_max = 'hazard_max', hazard_level = 'hazard_level' },
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_poke_hazard') then return end
      local x = 1 + count_held(state.cardsInHand, gold_or_steel) * poke.get(card, 'Xmult_multi')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

