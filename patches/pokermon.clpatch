      end
    end,
  },
}

-- Sentret 161: +1 Mult per hand in a row that is not the last hand played; resets otherwise. Evolves at +15 Mult.
local function sentret_added(card, state)
  local h = poke.last_hand()
  poke.set(card, 'last_hand', h and h.type or false)
  if h then poke.set(card, 'last_hand_name', h.name) else card:getDataStore():delete('last_hand_name') end
end
local function sentret_vars(get)
  return { get('mult'), get('mult_mod'), get('last_hand_name') or none_text() }
end
poke.addPokemon {
  name = 'sentret', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Colorless', gen = 2,
  config = { mult = 0, mult_mod = 1 },
  evo_rqmt = 15,
  attributes = { 'hand_type', 'mult', 'scaling', 'reset', 'scaling_evo' },
  vars = sentret_vars,
  onAdded = sentret_added,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, 'last_hand') ~= step.hand.handType then
        poke.set(card, 'last_hand', step.hand.handType)
        poke.set(card, 'last_hand_name', step.hand.handName)
        local mod = poke.get(card, 'mult_mod')
        poke.add(card, 'mult', mod)
        result:say('+' .. poke.text.num(mod) .. ' Mult', colors.MULT)
      else
        poke.set(card, 'mult', 0)
        result:say('Reset', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult ~= 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'furret', poke.get(card, 'mult'), 15) end,
}

-- Furret 162: gains +1 Mult when the played hand is not the last hand played.
poke.addPokemon {
  name = 'furret', rarity = 2, cost = 6, stage = 'One', ptype = 'Colorless', gen = 2,
  config = { mult = 0, mult_mod = 1 },
  attributes = { 'hand_type', 'mult', 'scaling' },
  vars = sentret_vars,
  onAdded = sentret_added,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'last_hand') == step.hand.handType then return end
      poke.set(card, 'last_hand', step.hand.handType)
      poke.set(card, 'last_hand_name', step.hand.handName)
      local mod = poke.get(card, 'mult_mod')
      poke.add(card, 'mult', mod)
      result:say('+' .. poke.text.num(mod) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult ~= 0 then result:add(plusMult(mult)) end
    end,
  },
}

