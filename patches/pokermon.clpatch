-- Slakoth line: lose a hand this round each time a hand is played.
local function lose_hand(card, state, step, result)
  local n = poke.get(card, 'hands')
  state.handsLeft = math.max(0, state.handsLeft - n)
  result:say('-' .. n .. ' Hand', colors.CHIPS)
end

