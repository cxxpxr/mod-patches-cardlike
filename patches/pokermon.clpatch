== file jokers/pokejokers_05.lua (888 lines)
-- Pokemon jokers 121-150 (original file pokejokers_05.lua): Starmie to Mega Mewtwo Y.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Number of scoring cards of a rank (Ancient jokers).
local function ancient(step, rank)
  return poke.get_ancient_amount(step.hand and step.hand.playedCards or {}, rank)
end

-- The type used to Energize a joker: its Tera type, else the type of a Pokemon (not stage Other).
local function energize_type(j)
  local tera = poke.type_sticker_applied(j)
  if tera then return tera end
  local def = poke.def(j)
  if def and def.stage and def.stage ~= 'Other' then return def.ptype end
  return nil
end

---------------------------------------------------------------------------
-- Starmie 121
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'starmie', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Water', gen = 1,
  config = { mult = 2, money_mod = 2, suit = 'Diamonds' },
