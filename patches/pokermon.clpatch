-- Jirachi (Banker wish): X3 round rewards.
cardlike.filter('cashOut', function(total)
  local state = cardlike.state
  if type(total) ~= 'number' or total <= 0 or not state or state.money == nil then return nil end
  local out, changed = total, false
  for _, j in ipairs(state.jokers or {}) do
    if poke.name(j) == 'jirachi_banker' and not (j.lastInfo or {}).debuffed then
      out = out * (poke.get(j, 'multiply', 3) or 3)
      changed = true
    end
  end
  if changed then return out end
end)

poke.addPokemon {
  name = 'jirachi_banker',
  rarity = 4,
  cost = 20,
  stage = 'Legendary',
  ptype = 'Metal',
  gen = 3,
  aux_poke = true,
  blueprint_compat = false,
  config = { multiply = 3 },
  attributes = { 'economy' },
  vars = function(get) return { get('multiply') } end,
  in_pool = function() return false end,
}

-- Jirachi (Booster wish): the first 3 rerolls of each shop add a pack to the shop.
local function random_shop_pack(state)
  local list = {}
  for _, p in ipairs(cardlike.listContent('pack') or {}) do
    local name = type(p.name) == 'string' and p.name or ''
    if p.id and not name:find('Wish') and not name:find('Starter') then list[#list + 1] = p.id end
  end
  return poke.random_element(list, state)
end

poke.addPokemon {
  name = 'jirachi_booster',
  rarity = 4,
  cost = 20,
  stage = 'Legendary',
  ptype = 'Metal',
  gen = 3,
  aux_poke = true,
  config = { reroll_max = 3, rerolls = 0, bonus_choices = 1 },
  attributes = { 'passive' },
  vars = function(get)
    return { get('reroll_max'), math.max(get('reroll_max') - get('rerolls'), 0), get('bonus_choices') }
  end,
  -- Cardlike packs cannot hold more cards, so the "+1 card in packs" line is left out.
  text = { 'The first {C:attention}#1#{} {C:inactive}[#2#] {C:green}rerolls', 'each {C:attention}shop{} add', 'a {C:attention}Pack{} to the {C:attention}shop' },
  in_pool = function() return false end,
  triggers = {
    onShopReroll = function(card, state, step, result)
      if poke.get(card, 'rerolls') >= poke.get(card, 'reroll_max') then return end
      if not step.copiedBy then poke.add(card, 'rerolls', 1) end
      local pack = random_shop_pack(state)
      if pack then cardlike.addShopItem(pack) end
      card:punch()
      result:say(poke.text.dict('poke_wish_ex', 'Wish!'), colors.PURPLE)
    end,
    onShopExit = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'rerolls', 0)
      result:say('Reset', colors.GREEN)
    end,
  },
}

-- Jirachi (Copy wish): copies the joker to the right while you have 3+ energized jokers (lib/copy.lua).
local function invis_active(card, state)
  return poke.energized_count(state) >= (poke.get(card, 'energy_target', 3) or 3)
end

poke.addPokemon {
  name = 'jirachi_invis',
  rarity = 4,
  cost = 20,
  stage = 'Legendary',
  ptype = 'Metal',
  gen = 3,
  aux_poke = true,
  config = { energy_target = 3 },
  attributes = { 'joker', 'generation' },
  vars = function(get, card, state) return { get('energy_target'), poke.energized_count(state) } end,
  text = function(get, card, state, vars)
    local line = card and state and poke.copy_line(card, state, poke.right_joker(card, state), invis_active(card, state))
    return poke.text.joker('jirachi_invis', vars, line)
  end,
  in_pool = function() return false end,
  triggers = poke.copy_triggers { target = poke.right_joker, active = invis_active },
}

