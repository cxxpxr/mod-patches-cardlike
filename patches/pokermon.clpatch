---------------------------------------------------------------------------
-- Mr. Mime 122: retrigger the leftmost card held in hand
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'mrmime', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Psychic', gen = 1,
  config = { retriggers = 3 },
  vars = function(get) return { get('retriggers') } end,
  attributes = { 'retrigger' },
  triggers = {
    repeatHeldCard = function(card, state, step, result)
      local first = (state.cardsInHand or {})[1]
      if first and step.card and first.uid == step.card.uid then
        result:say('Again!', colors.ORANGE)
        return poke.get(card, 'retriggers')
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Scyther 123
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'scyther', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 1,
  item_req = 'hardstone',
  config = { mult = 0, mult_mod = 4 },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  attributes = { 'destroy_card', 'mult', 'editions', 'scaling', 'type_evo', 'item_evo' },
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local sliced = poke.right_joker(card, state)
      if not sliced or sliced:isLocked() then return end
      local rarity = sliced:getRarity()
      if rarity ~= 'Common' and rarity ~= 'Uncommon' and card:getEdition() == 'default' then
        card:setEdition(poke.random_edition(state))
      end
      sliced:destroy()
      local mult = poke.add(card, 'mult', poke.get(card, 'mult_mod'))
      result:say('+' .. poke.text.num(mult) .. ' Mult', colors.MULT)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state)
    return poke.type_evo(card, state, 'scizor', 'Metal') or poke.item_evo(card, state, 'kleavor')
  end,
}

---------------------------------------------------------------------------
-- Jynx 124
---------------------------------------------------------------------------
local jynx_copying = false

poke.addPokemon {
  name = 'jynx', rarity = 3, cost = 5, stage = 'Basic', ptype = 'Psychic', gen = 1,
  config = { h_size = 2, deck_size = 12 },
  vars = function(get) return { get('h_size'), poke.starting_deck_size() + get('deck_size') } end,
  attributes = { 'generation', 'passive', 'hand_size' },
  triggers = {
    onCardsAdded = function(card, state, step, result)
      if jynx_copying then return end
      local copies = 0
      jynx_copying = true
      for _, c in ipairs(step.cards or {}) do
        -- cards that a Jynx made are not copied again
        if c.uid and c.getDataStore and not c:getDataStore():get('poke_jynx_copy') then
          local copy = c:copy('deck')
          if copy then
            copy:getDataStore():set('poke_jynx_copy', true)
            copies = copies + 1
          end
        end
      end
      jynx_copying = false
      if copies > 0 then result:say('Copied!', colors.ORANGE) end
    end,
    beforeRound = function(card, state, step, result)
      if #(state.allCards or {}) >= poke.starting_deck_size() + poke.get(card, 'deck_size') then
        state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
        card:punch()
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Electabuzz 125
---------------------------------------------------------------------------
-- The money at the end of the round: a share of the sell value, up to max. get reads the values (collection too).
local function electabuzz_earn(card, get)
  get = get or function(k) return poke.get(card, k) end
  local sell = card and card:getSellValue() or 3
  return math.min(get('max'), math.ceil(sell * get('percent') / 100))
end

poke.addPokemon {
  name = 'electabuzz', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Lightning', gen = 1,
  item_req = 'linkcable', blueprint_compat = false,
  config = { money_mod = 2, percent = 25, max = 20 },
  vars = function(get, card) return { get('money_mod'), get('percent'), electabuzz_earn(card, get), get('max') } end,
  attributes = { 'sell_value', 'scaling', 'economy', 'item_evo' },
  triggers = {
    onCardSold = function(card, state, step, result)
      if step.copiedBy then return end
      poke.sell_value_up(card, poke.get(card, 'money_mod'))
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.sell_value_up(card, poke.get(card, 'money_mod'))
    end,
  },
  dollarsAtRoundEnd = function(card, state)
    return poke.ease_poke_dollars(card, 'electabuzz', electabuzz_earn(card), true, state)
  end,
  evolution = function(card, state) return poke.item_evo(card, state, 'electivire') end,
}

