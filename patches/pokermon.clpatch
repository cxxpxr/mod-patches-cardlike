}

-- Cleffa 173 / Igglybuff 174: Baby, X0.75 Mult. Create an Inverted Game card at the end of the round.
local function baby_creates(id)
  return function(card, state, step, result)
    poke.create_consumeable({ key = id, edition = 'e_negative' }, card)
  end
end
poke.addPokemon {
