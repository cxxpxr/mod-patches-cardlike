-- Pokemon jokers 991 to 1020 (original pokemon/pokejokers_34.lua).
local poke = cardlike.require('lib.pokermon')

local GILDED = 'Gilded'

-- Gimmighoul 999 (Chest Form): scored Gilded cards earn $3. Skipping a pack puts a free Roaming Gimmighoul in the
-- shop. Evolves after earning or spending $999.
poke.addPokemon {
  name = 'gimmighoul',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Psychic',
  gen = 9,
  enhancement_gate = GILDED,
  config = { money = 3, money_goal = 999, money_seen = 0 },
  attributes = { 'enhancements', 'economy', 'condition_evo' },
  vars = function(get) return { get('money'), get('money_seen'), get('money_goal') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:getDebuffState() or not poke.has_enhancement(step.card, GILDED) then return end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'gimmi', poke.get(card, 'money'), true, state)))
    end,
    onPackSkipped = function(card, state, step, result)
      poke.add_shop_card(poke.id('gimmighoulr'), step.copiedBy or card, true)
    end,
    onMoneyChanged = function(card, state, step, result)
      if step.copiedBy or type(step.amount) ~= 'number' then return end
      poke.add(card, 'money_seen', math.abs(step.amount))
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'gholdengo', poke.get(card, 'money_seen'), poke.get(card, 'money_goal'))
  end,
}

-- Gimmighoul (Roaming Form): only from Gimmighoul. When taken, earns a random amount of money and destroys itself.
-- It takes no joker slot (the original is Negative): no_slot lets you take it with full joker slots.
local ROAMING_TABLE = {
  { 0.50, 1 }, { 0.70, 3 }, { 0.90, 5 }, { 0.97, 10 }, { 0.99, 30 }, { 0.999, 50 }, { 0.9999, 100 }, { 1.01, 200 },
}
poke.addPokemon {
  name = 'gimmighoulr',
  rarity = 'poke_safari',
  cost = 0,
  stage = 'Basic',
  ptype = 'Psychic',
  gen = 9,
  aux_poke = true,
  hidden = true,
  no_slot = true,
  config = {},
  attributes = { 'economy' },
  vars = function() return {} end,
  in_pool = function() return false end,
  onAdded = function(card, state)
    local r = state:randomFloat()
    local amount = 200
    for _, row in ipairs(ROAMING_TABLE) do
      if r < row[1] then amount = row[2] break end
    end
    local earned = poke.ease_poke_dollars(card, 'gimmir', amount, false, state)
    card:popup('$' .. poke.text.num(earned), colors.MONEY)
    card:destroy()
  end,
}

-- Gholdengo 1000: scored Gilded cards spend $3 and multiply this joker's X Mult by X1.5. Resets at the end of the
-- round. This joker cannot be debuffed.
poke.addPokemon {
  name = 'gholdengo',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Metal',
  gen = 9,
  enhancement_gate = GILDED,
  config = { Xmult = 1, money_minus = 3, Xmult1 = 1, Xmult_multi = 1.5 },
  -- cannot be debuffed (the library takes the debuff off again: lib/rules.lua)
  undebuffable = true,
  attributes = { 'enhancements', 'economy', 'xmult' },
  vars = function(get) return { get('Xmult'), get('money_minus'), get('Xmult_multi') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:getDebuffState() or not poke.has_enhancement(step.card, GILDED) then return end
      -- the game takes the money of each scored card before the next card scores, so state.money is current
      local cost = poke.get(card, 'money_minus')
      if (state.money or 0) - cost < 0 then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult') * poke.get(card, 'Xmult_multi'))
      result:add(plusMoney(-cost))
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 1 then
        result:add(xMult(x))
        result:say(poke.text.dict('poke_make_it_rain', 'Make it Rain!'), colors.MONEY)
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult1'))
      result:say('Reset', colors.MULT)
    end,
  },
}


