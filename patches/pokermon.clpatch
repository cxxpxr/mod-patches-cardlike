-- Larvitar 246, Pupitar 247, Tyranitar 248, Mega Tyranitar
---------------------------------------------------------------------------
local function full_house_line(name, rarity, cost, stage, chip_mod, target, into)
  poke.addPokemon {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Earth', gen = 2,
    config = { chip_mod = chip_mod, full_houses = 0 },
    evo_rqmt = target,
    attributes = { 'hand_type', 'chips', 'modify_card', 'perma_bonus', 'trigger_evo' },
    vars = function(get) return { get('chip_mod'), math.max(0, target - get('full_houses')) } end,
    triggers = {
      beforeAllCardsScored = function(card, state, step, result)
        if step.hand.handType == 'FULL_HOUSE' and not step.copiedBy then poke.add(card, 'full_houses', 1) end
      end,
      onScore = function(card, state, step, result)
        if step.hand.handType ~= 'FULL_HOUSE' then return end
        step.card:addAdditionalPointValue(poke.get(card, 'chip_mod'))
        result:say('Upgrade!', colors.CHIPS, step.card)
      end,
    },
    evolution = function(card, state) return poke.scaling_evo(card, state, into, poke.get(card, 'full_houses'), target) end,
  }
end
full_house_line('larvitar', 2, 6, 'Basic', 10, 6, 'pupitar')
full_house_line('pupitar', 'poke_safari', 8, 'One', 15, 8, 'tyranitar')

poke.addPokemon {
  name = 'tyranitar', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Dark', gen = 2,
  config = { chip_mod_minus = 4, Xmult_multi = 0.1 },
  megas = { 'mega_tyranitar' },
  attributes = { 'hand_type', 'chips', 'modify_card', 'perma_bonus', 'xmult' },
  vars = function(get) return { get('chip_mod_minus'), get('Xmult_multi') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.hand.handType ~= 'FULL_HOUSE' then return end
      if poke.drain_chips(step.card, poke.get(card, 'chip_mod_minus')) > 0 then
        poke.add_perma_bonus(step.card, 'x_mult', poke.get(card, 'Xmult_multi'))
        result:say('Eroded!', colors.CHIPS, step.card)
        result:say('Upgrade!', colors.MULT, step.card)
      end
    end,
  },
}

poke.addPokemon {
  name = 'mega_tyranitar', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Dark', gen = 2,
  config = {},
  attributes = { 'hand_type', 'chips', 'modify_card', 'perma_bonus' },
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.hand.handType ~= 'FULL_HOUSE' then return end
      state:upgradeHand('FULL_HOUSE', 1)
      result:say('Level Up!', colors.ORANGE)
    end,
    onScore = function(card, state, step, result)
      if step.hand.handType ~= 'FULL_HOUSE' then return end
      local hand = state:getHand('FULL_HOUSE')
      step.card:addAdditionalPointValue(hand and hand.level or 1)
      result:say('Upgrade!', colors.CHIPS, step.card)
    end,
  },
}

---------------------------------------------------------------------------
-- Lugia 249: gains X1 Mult for every 40 cards drawn during blinds.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'lugia', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Psychic', gen = 2,
  config = { Xmult = 1, Xmult_mod = 1, to_draw = 40, drawn = 0 },
  attributes = { 'xmult', 'scaling' },
  vars = function(get)
    return { get('Xmult'), get('Xmult_mod'), get('to_draw'), get('to_draw') - (get('drawn') % get('to_draw')) }
  end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      if step.copiedBy then return end
      local drawn = #poke.drawn_cards(state, step)
      local total = poke.add(card, 'drawn', drawn)
      local to_draw = poke.get(card, 'to_draw')
      if total >= to_draw then
        local x = poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * math.floor(total / to_draw))
        poke.set(card, 'drawn', total % to_draw)
        result:say('X' .. poke.text.num(x) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
  },
}

---------------------------------------------------------------------------
-- Ho-Oh 250: the first consumable used each round is copied with the Chroma edition.
---------------------------------------------------------------------------
local NOT_COPIED = {}
for _, name in ipairs({ 'megastone', 'leftovers', 'heavyboots', 'thickclub', 'leek', 'meteorite', 'fake_banker', 'fake_booster',
    'fake_power', 'fake_negging', 'fake_copy', 'fake_fixer', 'fake_masterball' }) do
  NOT_COPIED[poke.items.id(name)] = true
end

poke.addPokemon {
  name = 'ho_oh', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Fire', gen = 2,
  config = { limit = 1, used = 0 },
  attributes = { 'generation' },
  vars = function(get) return { get('limit'), get('limit') - get('used') } end,
  triggers = {
    onConsumableUsed = function(card, state, step, result)
      local used = step.card
      local id = used and ((used.lastInfo or {}).consumable or used:getConsumableDef())
      if not id or NOT_COPIED[id] or poke.get(card, 'used') >= poke.get(card, 'limit') then return end
      if not step.copiedBy then poke.add(card, 'used', 1) end
      if id == poke.items.id('bird_energy') then id = poke.items.id('double_rainbow_energy') end
      local copy = cardlike.createConsumable(id, { edition = 'Chroma' })
      if copy then
        copy:setEdition('Chroma')
        result:say('Duplicated!', colors.PURPLE)
      end
    end,
    beforeRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'used', 0) end
    end,
  },
}

---------------------------------------------------------------------------
-- Celebi 251: -1 Ante every N blinds skipped (N grows each time). X Mult for each round played.
---------------------------------------------------------------------------
local function celebi_skips() return math.max(1, poke.run.celebi_skips or 1) end

poke.addPokemon {
  name = 'celebi', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Grass', gen = 2,
  config = { reward = 1, skip_count = 0, Xmult_mod = 0.05 },
  attributes = { 'skip', 'xmult' },
  vars = function(get, card, state)
    local round = (state and state.round) or 0
    return { celebi_skips(), get('reward'), celebi_skips() - get('skip_count'), get('Xmult_mod'), 1 + round * get('Xmult_mod') }
  end,
  triggers = {
    onBlindSkipped = function(card, state, step, result)
      if step.copiedBy then return end
      card:punch()
      local count = poke.add(card, 'skip_count', 1)
      if count >= celebi_skips() then
        state.ante = math.max(1, state.ante - poke.get(card, 'reward'))
        poke.run.celebi_skips = celebi_skips() + 1
        poke.set(card, 'skip_count', 0)
        result:say('-' .. poke.get(card, 'reward') .. ' Ante', colors.GREEN)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(1 + (state.round or 0) * poke.get(card, 'Xmult_mod')))
    end,
  },
}

---------------------------------------------------------------------------
-- Treecko 252, Grovyle 253, Sceptile 254 (+1 hand size, money from Nature ranks)
---------------------------------------------------------------------------
local function money_nature_trigger(extra_fn, count_triggers)
  return function(card, state, step, result)
    if not is_target_rank(step.card, poke.get(card, 'targets')) then return end
    local amount = extra_fn(card, state)
    local earned = poke.ease_poke_dollars(card, 'treecko', amount, true, state)
    if count_triggers and not step.copiedBy then poke.add(card, 'triggers', 1) end
    if count_triggers == nil then poke.add(card, 'money_earned', earned) end
    result:add(plusMoney(earned))
  end
end

poke.addPokemon {
  name = 'treecko', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Grass', gen = 3, starter = true,
  config = { money_mod = 1, triggers = 0, targets = DEFAULT_RANKS, h_size = 1 },
  nature = poke.rank_nature(3),
  passives = { hand_size = 'h_size' },
  evo_rqmt = 16,
  attributes = { 'starter', 'hand_size', 'passive', 'nature', 'rank', 'economy', 'trigger_evo' },
  vars = function(get)
    return poke.add_target_cards_to_vars({ get('money_mod'), math.max(0, 16 - get('triggers')), get('h_size') }, get('targets'))
  end,
  triggers = { onScore = money_nature_trigger(function(card) return poke.get(card, 'money_mod') end, true) },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'grovyle', poke.get(card, 'triggers'), 16) end,
}

poke.addPokemon {
  name = 'grovyle', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Grass', gen = 3,
  config = { money_mod = 1, triggers = 0, targets = DEFAULT_RANKS, h_size = 1 },
  nature = poke.rank_nature(3),
  passives = { hand_size = 'h_size' },
  evo_rqmt = 16,
  attributes = { 'starter', 'hand_size', 'passive', 'nature', 'rank', 'economy', 'trigger_evo' },
  vars = function(get)
    return poke.add_target_cards_to_vars({ get('money_mod'), math.max(0, 16 - get('triggers')), get('h_size'), get('money_mod') + 1 }, get('targets'))
  end,
  triggers = {
    onScore = money_nature_trigger(function(card, state)
      return poke.get(card, 'money_mod') + (state:randomFloat() < 0.5 and 0 or 1)
    end, true),
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'sceptile', poke.get(card, 'triggers'), 16) end,
}

local function sceptile_money(card, state)
  return poke.get(card, 'money_mod') + #poke.find_pokemon_type('Grass', card, nil, state) * poke.get(card, 'money_increase')
end
poke.addPokemon {
  name = 'sceptile', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Grass', gen = 3,
  config = { money_mod = 2, money_increase = 1, money_earned = 0, targets = DEFAULT_RANKS, h_size = 1 },
  nature = poke.rank_nature(3),
  passives = { hand_size = 'h_size' },
  attributes = { 'starter', 'hand_size', 'passive', 'nature', 'rank', 'economy', 'types' },
  vars = function(get, card, state)
    local total = get('money_mod') + (card and #poke.find_pokemon_type('Grass', card, nil, state) or 0) * get('money_increase')
    return poke.add_target_cards_to_vars({ get('money_mod'), get('money_earned'), get('h_size'), total, get('money_increase') }, get('targets'))
  end,
  triggers = { onScore = money_nature_trigger(sceptile_money, nil) },
}

---------------------------------------------------------------------------
-- Torchic 255, Combusken 256, Blaziken 257 (+1 discard, Mult from Nature ranks)
---------------------------------------------------------------------------
local function mult_nature_trigger(count_triggers)
  return function(card, state, step, result)
    if not is_target_rank(step.card, poke.get(card, 'targets')) then return end
    if count_triggers and not step.copiedBy then poke.add(card, 'triggers', 1) end
    result:add(plusMult(poke.get(card, 'mult_mod')))
  end
end

for _, t in ipairs({ { 'torchic', 2, 5, 'Basic', 5, 'combusken' }, { 'combusken', 'poke_safari', 8, 'One', 8, 'blaziken' } }) do
  local name, rarity, cost, stage, mult_mod, into = t[1], t[2], t[3], t[4], t[5], t[6]
  poke.addPokemon {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Fire', gen = 3, starter = name == 'torchic' or nil,
    config = { mult_mod = mult_mod, triggers = 0, targets = DEFAULT_RANKS, d_size = 1 },
    nature = poke.rank_nature(3),
    passives = { discards = 'd_size' },
    evo_rqmt = 16,
    attributes = { 'starter', 'discard', 'passive', 'nature', 'rank', 'mult', 'trigger_evo' },
    vars = function(get)
      return poke.add_target_cards_to_vars({ get('mult_mod'), math.max(0, 16 - get('triggers')), get('d_size') }, get('targets'))
    end,
    triggers = { onScore = mult_nature_trigger(true) },
    evolution = function(card, state) return poke.scaling_evo(card, state, into, poke.get(card, 'triggers'), 16) end,
  }
end

poke.addPokemon {
  name = 'blaziken', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Fire', gen = 3,
  config = { mult_mod = 10, Xmult_multi = 1.5, cards_discarded = 0, discard_target = 5, targets = DEFAULT_RANKS, d_size = 1 },
  nature = poke.rank_nature(3),
  passives = { discards = 'd_size' },
  attributes = { 'starter', 'discard', 'passive', 'nature', 'rank', 'mult', 'xmult', 'types' },
  vars = function(get)
    return poke.add_target_cards_to_vars({ get('mult_mod'), get('Xmult_multi'), get('d_size'), get('discard_target'),
      math.max(0, get('discard_target') - get('cards_discarded')) }, get('targets'))
  end,
  triggers = {
    onScore = mult_nature_trigger(false),
    onDiscard = function(card, state, step, result)
      if step.copiedBy then return end
      local targets = poke.get(card, 'targets')
      for _, c in ipairs(step.discardedCards or {}) do
        if not c:getDebuffState() and is_target_rank(c, targets) then poke.add(card, 'cards_discarded', 1) end
      end
    end,
    onOtherJoker = function(card, state, step, result)
      if poke.get(card, 'cards_discarded') < poke.get(card, 'discard_target') then return end
      if poke.is_type(step.other, 'Fire') or poke.is_type(step.other, 'Fighting') then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'cards_discarded', 0)
      result:say('Reset', colors.ORANGE)
    end,
  },
}

---------------------------------------------------------------------------
-- Mudkip 258, Marshtomp 259, Swampert 260 (+1 hand, Points from Nature ranks)
---------------------------------------------------------------------------
local function chips_nature_trigger(count_triggers)
  return function(card, state, step, result)
    if not is_target_rank(step.card, poke.get(card, 'targets')) then return end
    if count_triggers and not step.copiedBy then poke.add(card, 'triggers', 1) end
    result:add(plusChips(poke.get(card, 'chip_mod')))
  end
end

for _, t in ipairs({ { 'mudkip', 2, 5, 'Basic', 30, 'marshtomp' }, { 'marshtomp', 'poke_safari', 8, 'One', 50, 'swampert' } }) do
  local name, rarity, cost, stage, chip_mod, into = t[1], t[2], t[3], t[4], t[5], t[6]
  poke.addPokemon {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Water', gen = 3, starter = name == 'mudkip' or nil,
    config = { chip_mod = chip_mod, triggers = 0, targets = DEFAULT_RANKS, hands = 1 },
    nature = poke.rank_nature(3),
    passives = { hands = 'hands' },
    evo_rqmt = 16,
    attributes = { 'starter', 'hands', 'passive', 'nature', 'rank', 'chips', 'trigger_evo' },
    vars = function(get)
      return poke.add_target_cards_to_vars({ get('chip_mod'), math.max(0, 16 - get('triggers')), get('hands') }, get('targets'))
    end,
    triggers = { onScore = chips_nature_trigger(true) },
    evolution = function(card, state) return poke.scaling_evo(card, state, into, poke.get(card, 'triggers'), 16) end,
  }
end

poke.addPokemon {
  name = 'swampert', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Water', gen = 3,
  config = { chip_mod = 60, nature_target = 5, targets = DEFAULT_RANKS, hands = 1 },
  nature = poke.rank_nature(3),
  passives = { hands = 'hands' },
  attributes = { 'starter', 'hands', 'passive', 'nature', 'rank', 'chips', 'types', 'tarot', 'generation' },
  vars = function(get)
    return poke.add_target_cards_to_vars({ get('chip_mod'), get('hands'), get('nature_target') }, get('targets'))
  end,
  triggers = {
    onScore = chips_nature_trigger(false),
    afterAllCardsScored = function(card, state, step, result)
      local targets = poke.get(card, 'targets')
      local count = 0
      for _, c in ipairs(step.hand.playedCards) do if is_target_rank(c, targets) then count = count + 1 end end
      if count < poke.get(card, 'nature_target') then return end
      local n = math.floor((#poke.find_pokemon_type('Water', nil, nil, state) + #poke.find_pokemon_type('Earth', nil, nil, state)) / 2)
      local made = 0
      for _ = 1, n do
        if state.freeConsumableSlots <= 0 then break end
        if cardlike.createConsumable('game') then made = made + 1 end
      end
      if made > 0 then result:say('+' .. made .. ' Game Card', colors.PURPLE) end
    end,
  },
}

---------------------------------------------------------------------------
-- Poochyena 261, Mightyena 262: gain Mult when a playing card is destroyed.
---------------------------------------------------------------------------
local function destroyed_trigger(extra_fn)
  return function(card, state, step, result)
    if step.copiedBy then return end
    local n = #(step.cards or {})
    if n == 0 then return end
    local per = poke.get(card, 'mult_mod') + (extra_fn and extra_fn(card, state) or 0)
    poke.add(card, 'mult', per * n)
    result:say('+' .. poke.text.num(per * n) .. ' Mult', colors.MULT)
  end
end

poke.addPokemon {
  name = 'poochyena', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Dark', gen = 3, credits = nil,
  config = { mult = 0, mult_mod = 2, rounds = 5 },
  attributes = { 'mult', 'scaling', 'round_evo' },
  vars = function(get) return { get('mult'), get('mult_mod'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local m = poke.get(card, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
    -- onCardsRemoved fires for every playing card that leaves the deck (also destroyed played cards).
    onCardsRemoved = destroyed_trigger(nil),
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'mightyena') end,
}

poke.addPokemon {
  name = 'mightyena', rarity = 2, cost = 5, stage = 'One', ptype = 'Dark', gen = 3,
  config = { mult = 0, mult_mod = 2, mult_scaling_mod = 1 },
  attributes = { 'mult', 'scaling', 'types' },
  vars = function(get) return { get('mult'), get('mult_mod'), get('mult_scaling_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local m = poke.get(card, 'mult')
      if m > 0 then result:add(plusMult(m)) end
    end,
    onCardsRemoved = destroyed_trigger(function(card, state)
      return #poke.find_pokemon_type('Dark', nil, nil, state) * poke.get(card, 'mult_scaling_mod')
    end),
  },
}

---------------------------------------------------------------------------
-- Zigzagoon 263, Linoone 264: Pickup items.
---------------------------------------------------------------------------
local function pickup(card, state, result)
  if state.freeConsumableSlots <= 0 then return end
  local key = poke.generate_pickup_item_key(state)
  local made = poke.create_consumeable(key and { key = key } or { set = 'poke_item' }, card)
  if made then result:say('+1 Item', poke.colours.pink) end
end

poke.addPokemon {
  name = 'zigzagoon', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Colorless', gen = 3,
  config = { num = 1, dem = 4, rounds = 5 },
  attributes = { 'chance', 'generation', 'item', 'round_evo' },
  vars = function(get, card, state) return { poke.chance_num(get('num'), state), get('dem'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if state.freeConsumableSlots > 0 and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then pickup(card, state, result) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'linoone') end,
}

poke.addPokemon {
  name = 'linoone', rarity = 2, cost = 5, stage = 'One', ptype = 'Colorless', gen = 3,
  config = { num = 1, dem = 3, rounds = 5 },
  attributes = { 'chance', 'generation', 'item', 'hand_type' },
  vars = function(get, card, state) return { poke.chance_num(get('num'), state), get('dem'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if state.freeConsumableSlots <= 0 then return end
      if step.hand.contains.STRAIGHT or state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then pickup(card, state, result) end
    end,
  },
}

---------------------------------------------------------------------------
-- Wurmple 265, Silcoon 266, Beautifly 267, Cascoon 268, Dustox 269 (Nature suit)
---------------------------------------------------------------------------
local function count_nature_scored(card, state, step)
  if not step.copiedBy and step.card:isSuit(nature_suit(function(k) return poke.get(card, k) end)) then
    poke.add(card, 'nature_scored', 1)
  end
end

poke.addPokemon {
  name = 'wurmple', rarity = 1, cost = 2, stage = 'Basic', ptype = 'Grass', gen = 3,
  config = { mult = 3, chips = 20, targets = { { suit = 'Spades' } }, nature_scored = 0 },
  evo_rqmt = 5,
  attributes = { 'chips', 'mult', 'nature', 'suit', 'condition_evo' },
  vars = function(get)
    local hidden = get('nature_scored') <= 0
    local suit = nature_suit(get)
    local v = { get('mult'), get('chips'), math.max(0, 5 - get('nature_scored')), hidden and '??? Suit' or suit }
    v.colours = { hidden and colors.GREY or poke.suit_colour(suit) }
    return v
  end,
  nature = poke.suit_nature({ 'Spades', 'Hearts', 'Diamonds', 'Clubs' }),
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if state:randomFloat() < 0.5 then result:add(plusMult(poke.get(card, 'mult')))
      else result:add(plusChips(poke.get(card, 'chips'))) end
    end,
    onScore = count_nature_scored,
  },
  evolution = function(card, state)
    local suit = nature_suit(function(k) return poke.get(card, k) end)
    local into = (suit == 'Hearts' or suit == 'Diamonds') and 'silcoon' or 'cascoon'
    return poke.scaling_evo(card, state, into, poke.get(card, 'nature_scored'), 5)
  end,
}

local function suit_vars(first, get, ...)
  local suit = nature_suit(get)
  local v = { first, suit, ... }
  v.colours = { poke.suit_colour(suit) }
  return v
end

poke.addPokemon {
  name = 'silcoon', rarity = 2, cost = 4, stage = 'One', ptype = 'Grass', gen = 3,
  config = { mult = 8, targets = { { suit = 'Hearts' } }, nature_scored = 0 },
  evo_rqmt = 15,
  attributes = { 'mult', 'nature', 'suit', 'condition_evo' },
  vars = function(get) return suit_vars(get('mult'), get, math.max(0, 15 - get('nature_scored'))) end,
  nature = poke.suit_nature({ 'Hearts', 'Diamonds' }),
  triggers = {
    afterAllCardsScored = function(card, state, step, result) result:add(plusMult(poke.get(card, 'mult'))) end,
    onScore = count_nature_scored,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'beautifly', poke.get(card, 'nature_scored'), 15) end,
}

poke.addPokemon {
  name = 'beautifly', rarity = 'poke_safari', cost = 7, stage = 'Two', ptype = 'Grass', gen = 3,
  config = { mult = 8, targets = { { suit = 'Hearts' } }, num = 1, dem = 3 },
  attributes = { 'mult', 'nature', 'suit', 'chance', 'hand_type' },
  vars = function(get, card, state) return suit_vars(get('mult'), get, poke.chance_num(get('num'), state), get('dem')) end,
  nature = poke.suit_nature({ 'Hearts', 'Diamonds' }),
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      local suit = nature_suit(function(k) return poke.get(card, k) end)
      local has = false
      for _, c in ipairs(step.hand.playedCards) do if c:isSuit(suit) then has = true break end end
      if has and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        state:upgradeHand('FLUSH', 1)
        result:say('Upgrade!', colors.ORANGE)
      end
    end,
    afterAllCardsScored = function(card, state, step, result) result:add(plusMult(poke.get(card, 'mult'))) end,
  },
}

poke.addPokemon {
  name = 'cascoon', rarity = 2, cost = 4, stage = 'One', ptype = 'Grass', gen = 3,
  config = { chips = 60, targets = { { suit = 'Spades' } }, nature_scored = 0 },
  evo_rqmt = 15,
  attributes = { 'chips', 'nature', 'suit', 'condition_evo' },
  vars = function(get) return suit_vars(get('chips'), get, math.max(0, 15 - get('nature_scored'))) end,
  nature = poke.suit_nature({ 'Spades', 'Clubs' }),
  triggers = {
    afterAllCardsScored = function(card, state, step, result) result:add(plusChips(poke.get(card, 'chips'))) end,
    onScore = count_nature_scored,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'dustox', poke.get(card, 'nature_scored'), 15) end,
}

poke.addPokemon {
  name = 'dustox', rarity = 'poke_safari', cost = 7, stage = 'Two', ptype = 'Grass', gen = 3,
  config = { chips = 60, targets = { { suit = 'Spades' } }, Xmult = 3 },
  attributes = { 'chips', 'nature', 'suit', 'xmult' },
  vars = function(get) return suit_vars(get('chips'), get, get('Xmult')) end,
  nature = poke.suit_nature({ 'Spades', 'Clubs' }),
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local suit = nature_suit(function(k) return poke.get(card, k) end)
      local all = true
      for _, c in ipairs(step.held or state.cardsInHand or {}) do
        if not c:isSuit(suit) then all = false break end
      end
      result:add(plusChips(poke.get(card, 'chips')))
      if all then
        result:add(xMult(poke.get(card, 'Xmult')))
        result:say('Bug Buzz!', colors.MULT)
      end
    end,
  },
}


