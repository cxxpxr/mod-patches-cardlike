-- Horsea 116
poke.addPokemon {
  name = 'horsea', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Water', gen = 1,
  config = { mult = 0, mult_mod = 1 },
  evo_rqmt = 12,
  attributes = { 'mult', 'rank', 'six', 'scaling', 'scaling_evo' },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local sixes = 0
      for _, c in ipairs(step.hand.playedCards) do if poke.rank_of(c) == 6 then sixes = sixes + 1 end end
      if sixes > 0 then
        local gain = poke.get(card, 'mult_mod') * sixes
        poke.add(card, 'mult', gain)
        result:say('+' .. poke.text.num(gain) .. ' Mult', colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult ~= 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'seadra', poke.get(card, 'mult'), 12) end,
}

-- Seadra 117
poke.addPokemon {
  name = 'seadra', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Water', gen = 1,
  config = { mult = 0, mult_mod = 1 },
  attributes = { 'mult', 'rank', 'six', 'king', 'scaling', 'type_evo' },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult ~= 0 then result:add(plusMult(mult)) end
    end,
    onScore = function(card, state, step, result)
      if step.copiedBy or poke.rank_of(step.card) ~= 6 then return end
      local has_king = false
      for _, c in ipairs(state.cardsInHand or {}) do
        if poke.rank_of(c) == 13 then has_king = true break end
      end
      local gain = poke.get(card, 'mult_mod') * (has_king and 2 or 1)
      poke.add(card, 'mult', gain)
      result:say('+' .. poke.text.num(gain) .. ' Mult', colors.MULT)
    end,
  },
  evolution = function(card, state) return poke.type_evo(card, state, 'kingdra', 'Dragon') end,
}

