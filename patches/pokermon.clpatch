-- Mega: the leftmost joker that can Mega Evolve does.
local function mega_target(state)
  return poke.find_card(function(j) return poke.get_mega(j, state) ~= nil and not j:getDebuffState() end, state)
end

juice {
  id = 'berry_juice_mega',
  sprite = poke.sprites.at('consumables', 7, 7),
  credits = 'Art: Sonfive, Emma',
  description = function(r) return desc('c_poke_berry_juice_mega', {}) end,
  canUse = function(ctx)
    if not mega_target(ctx.state) then return 'No joker can Mega Evolve' end
    return ''
  end,
