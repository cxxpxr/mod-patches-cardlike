poke.addPokemon {
  name = 'snorlax', rarity = 3, cost = 6, stage = 'Basic', ptype = 'Colorless', gen = 1,
  config = { Xmult_mod = 0.2, Xmult = 1 },
  vars = function(get) return { get('Xmult_mod'), get('Xmult') } end,
  attributes = { 'holding', 'xmult', 'scaling' },
  onAdded = function(card, state) poke.holding(card, 'leftovers', state) end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      local leftovers = poke.items.id('leftovers')
      local count = 0
      for _, c in ipairs(state.consumables or {}) do
        if c:getConsumableDef() == leftovers then count = count + 1 end
      end
      if count > 0 then
        poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * count)
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
      end
    end,
  },
}

