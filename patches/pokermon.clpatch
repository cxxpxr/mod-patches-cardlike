-- Vouchers -> Cardlike tickets: Energy Search, Energy Research, Good Rod, Super Rod (original vouchers/pokevouchers.lua).
local poke = cardlike.require('lib.pokermon')

local function text(key) return poke.text.describe('Voucher', key) end
local function name(key, fallback) return poke.text.name('Voucher', key, fallback) end

-- Energy Search: +2 energy limit.
cardlike.addTicket {
  id = 'energysearch',
  readableName = name('v_poke_energysearch', 'Energy Search'),
