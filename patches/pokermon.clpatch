-- Pokemon jokers 271-300 (original pokejokers_10.lua): Seedot to Skitty.
local poke = cardlike.require('lib.pokermon')

local SEED = poke.ENHANCEMENT_IDS.m_poke_seed
local FLOWER = poke.ENHANCEMENT_IDS.m_poke_flower

-- Drawn Flower cards become Seed cards (Nuzleaf, Shiftry).
local function flowers_to_seeds(card, state, step)
  if step.copiedBy then return end
  for _, c in ipairs(poke.drawn_cards(state, step)) do
    if poke.has_enhancement(c, 'm_poke_flower') then
      c:setEnhancement(SEED)
      c:getDataStore():delete('poke_seed_level')
      c:punch()
    end
  end
end

local function seed_chips(card, state, step, result)
  if poke.has_enhancement(step.card, 'm_poke_seed') and not poke.is_debuffed(step.card) then
    result:add(plusChips(poke.get(card, 'chips')))
  end
end

-- Seedot 273
poke.addPokemon {
  name = 'seedot', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 3,
  enhancement_gate = SEED,
  config = { chips = 40, rounds = 5 },
  vars = function(get) return { get('chips'), get('rounds') } end,
  triggers = { onScore = seed_chips },
  evolution = function(card, state) return poke.level_evo(card, state, 'nuzleaf') end,
}

-- Nuzleaf 274
poke.addPokemon {
  name = 'nuzleaf', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Dark', gen = 3,
  enhancement_gate = SEED, item_req = 'leafstone',
  config = { chips = 50 },
  vars = function(get) return { get('chips') } end,
  triggers = { onScore = seed_chips, onHandDrawn = flowers_to_seeds },
  evolution = function(card, state) return poke.item_evo(card, state, 'shiftry') end,
}

-- Shiftry 275
poke.addPokemon {
  name = 'shiftry', rarity = 'poke_safari', cost = 8, stage = 'Two', ptype = 'Dark', gen = 3,
  enhancement_gate = SEED,
  config = { chips = 60, growth = 1 },
  vars = function(get) return { get('chips'), get('growth') } end,
  passives = { growth = 'growth' },
  triggers = { onScore = seed_chips, onHandDrawn = flowers_to_seeds },
}

-- Taillow and Swellow: +Mult for each Ace drawn during the Blind, reset at the end of the round.
local function ace_drawn(card, state, step, result)
  if step.copiedBy then return end
  local n = 0
  for _, c in ipairs(poke.drawn_cards(state, step)) do
    if poke.rank_is(c, 14) then n = n + 1 end
  end
  if n > 0 then
    local gain = n * poke.get(card, 'mult_mod')
    poke.add(card, 'mult', gain)
    result:say('+' .. poke.text.num(gain) .. ' Mult', colors.MULT)
  end
end
local function mult_main(card, state, step, result)
  local mult = poke.get(card, 'mult')
  if mult > 0 then result:add(plusMult(mult)) end
end
local function mult_reset(card, state, step, result)
  if step.copiedBy then return end
  poke.set(card, 'mult', 0)
  result:say('Reset', colors.CHIPS)
end

-- Taillow 276
poke.addPokemon {
  name = 'taillow', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Colorless', gen = 3,
  config = { mult = 0, mult_mod = 4, rounds = 4 },
  vars = function(get) return { get('mult'), get('mult_mod'), get('rounds') } end,
  triggers = { afterAllCardsScored = mult_main, onHandDrawn = ace_drawn, afterRound = mult_reset },
  evolution = function(card, state) return poke.level_evo(card, state, 'swellow') end,
}

-- Swellow 277
poke.addPokemon {
  name = 'swellow', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Colorless', gen = 3,
  config = { mult = 0, mult_mod = 6 },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    -- Boss Blind: the top 2 cards of the deck (the next ones drawn) become Aces.
    beforeRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      local deck = state.unDrawnCards or {}
      for i = 0, 1 do
        local top = deck[#deck - i]
        if top then top:setRank(14) end
      end
      result:say('Aces!', colors.ORANGE)
    end,
    afterAllCardsScored = mult_main, onHandDrawn = ace_drawn, afterRound = mult_reset,
  },
}

-- Wingull and Pelipper: money for each discarded card of this round's rank.
local function wingull_discard(extra_fn)
  return function(card, state, step, result)
    local want = poke.round_rank_id('wingullcard')
    local total = 0
    for _, c in ipairs(step.discardedCards or {}) do
      if not poke.is_debuffed(c) and poke.rank_is(c, want) then
        local earned = poke.ease_poke_dollars(card, 'wingull', poke.get(card, 'money_mod'), true, state)
        if extra_fn then earned = earned + extra_fn(card, state) end
        total = total + earned
      end
    end
    if total > 0 then
      state:mutateMoney(total)
      card:popup('$' .. poke.text.num(total), colors.MONEY)
    end
  end
end

-- Wingull 278
poke.addPokemon {
  name = 'wingull', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Water', gen = 3,
  config = { money_mod = 4, rounds = 4 },
  vars = function(get) return { get('money_mod'), get('rounds'), poke.round_rank('wingullcard') } end,
  triggers = { onDiscard = wingull_discard() },
  evolution = function(card, state) return poke.level_evo(card, state, 'pelipper') end,
}

-- Pelipper 279
poke.addPokemon {
  name = 'pelipper', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Water', gen = 3,
  config = { money_mod = 4, water_money = 1 },
  vars = function(get) return { get('money_mod'), get('water_money'), poke.round_rank('wingullcard') } end,
  triggers = {
    onDiscard = wingull_discard(function(card, state)
      return poke.get(card, 'water_money') * #poke.find_pokemon_type('Water', nil, nil, state)
    end),
  },
}

-- Ralts line: Mult for each Energized joker and held Fruit card.
local function fruit_held(state)
  if not state or not state.consumables then return 0 end
  return #poke.get_consumeables('fruit', state)
end
local function ralts_total(get, state) return get('mult_mod') * (poke.energized_count(state) + fruit_held(state)) end
local function ralts_main(card, state, step, result)
  local total = ralts_total(function(k) return poke.get(card, k) end, state)
  if total > 0 then result:add(plusMult(total)) end
end

-- Ralts 280
poke.addPokemon {
  name = 'ralts', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 3,
  config = { mult_mod = 5, rounds = 5 },
  vars = function(get, card, state) return { get('mult_mod'), get('rounds'), ralts_total(get, state) } end,
  triggers = { afterAllCardsScored = ralts_main },
  evolution = function(card, state) return poke.level_evo(card, state, 'kirlia') end,
}

-- Kirlia 281
poke.addPokemon {
  name = 'kirlia', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Psychic', gen = 3,
  item_req = 'dawnstone', evo_rqmt = 15,
  config = { mult_mod = 8, planets_used = 0 },
  vars = function(get, card, state)
    return { get('mult_mod'), ralts_total(get, state), math.max(0, 15 - get('planets_used')) }
  end,
  triggers = {
    afterAllCardsScored = ralts_main,
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not step.card or step.card:getConsumableType() ~= 'fruit' then return end
      poke.add(card, 'planets_used', 1)
    end,
  },
  evolution = function(card, state)
    return poke.item_evo(card, state, 'gallade') or poke.scaling_evo(card, state, 'gardevoir', poke.get(card, 'planets_used'), 15)
  end,
}

-- Gardevoir 282
local function gardevoir_total(get, state)
  local hands = 0
  for _, h in pairs(state and state.hands or {}) do
    if (h.level or 0) >= get('hand_level') then hands = hands + 1 end
  end
  return 1 + get('Xmult_mod') * (hands + poke.energized_count(state))
end
poke.addPokemon {
  name = 'gardevoir', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Psychic', gen = 3,
  config = { Xmult_mod = 0.3, hand_level = 5 },
  vars = function(get, card, state) return { get('Xmult_mod'), gardevoir_total(get, state), get('hand_level') } end,
  -- Holding: comes with UPDATE (Balatro Black Hole).
  onAdded = function(card, state) poke.holding(card, 'admin_card_16', state) end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = gardevoir_total(function(k) return poke.get(card, k) end, state)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

-- Surskit 283: Straights can be made with duplicate ranks (a hand rule of the library, lib/rules.lua)
poke.addPokemon {
  name = 'surskit', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 3,
  blueprint_compat = false, evo_rqmt = 8,
  hand_rules = { pairs_fill = true },
  config = { straights_played = 0 },
  vars = function(get) return { math.max(0, 8 - get('straights_played')) } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not step.copiedBy and step.hand.handType == 'STRAIGHT' then poke.add(card, 'straights_played', 1) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'masquerain', poke.get(card, 'straights_played'), 8) end,
}

-- Masquerain 284: Straights with duplicate ranks, like Surskit
poke.addPokemon {
  name = 'masquerain', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Grass', gen = 3,
  blueprint_compat = false,
  hand_rules = { pairs_fill = true },
  config = { scry = 4 },
  passives = { scry = 'scry' },
  vars = function(get) return { get('scry') } end,
}

-- Shroomish and Breloom: when the Blind is selected, +hands, +discards or +hand size this round.
local function mushroom_bonus(card, state, step, result)
  local r = state:randomFloat()
  if r > .66 then
    local n = poke.get(card, 'hands')
    state.handsLeft = state.handsLeft + n
    result:say('+' .. n .. ' Hand' .. (n == 1 and '' or 's'), colors.CHIPS)
  elseif r > .33 then
    local n = poke.get(card, 'd_size')
    state.discardsLeft = state.discardsLeft + n
    result:say('+' .. n .. ' Discard' .. (n == 1 and '' or 's'), colors.MULT)
  else
    local n = poke.get(card, 'h_size')
    state.extraEphemeralHandSize = state.extraEphemeralHandSize + n
    result:say('+' .. n .. ' Hand Size', colors.ORANGE)
  end
end

-- Shroomish 285
poke.addPokemon {
