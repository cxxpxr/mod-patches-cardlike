-- A random playing card (random rank and suit, no edition) in the deck.
local function add_random_card(state)
  return cardlike.addPlayingCard({ rank = state:random(2, 14), suit = state:getRandomSuit() }, { area = 'deck' })
end

-- Grimer 088
