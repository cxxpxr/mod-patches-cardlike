-- Medicham 308
poke.addPokemon {
  name = 'medicham', rarity = 'poke_safari', cost = 7, gen = 3, stage = 'One', ptype = 'Fighting',
  config = { mult_mod = 12, d_remaining = 0 },
  attributes = { 'mult', 'discard', 'applies' },
  vars = function(get, card, state)
    return { get('mult_mod'), 0, get('d_remaining'), meditate_total(get, state) }
  end,
  triggers = {
    afterAllCardsScored = meditate,
    -- Sixth Sense (Cardlike JOK3R): a single 6 played as the first hand of the round is destroyed and makes an
    -- Admin card (Balatro Spectral card).
    destroyCard = function(card, state, step, result)
      if step.copiedBy then return end
      local all = step.hand.allCards or {}
      if #all ~= 1 or all[1] ~= step.card or poke.hands_played_this_round() > 0 then return end
      if step.card:getRank() ~= 6 or (step.card.lastInfo or {}).noRank then return end
      if (state.freeConsumableSlots or 0) > 0 then poke.create_consumeable({ set = 'admin' }, card) end
      return true
    end,
  },
}

-- Plusle 311
poke.addPokemon {
  name = 'plusle', rarity = 1, cost = 4, gen = 3, stage = 'Basic', ptype = 'Lightning',
  config = { mult_mod = 2, Xmult = 2.5 },
  vars = function(get, card, state)
    local count = state and state.money ~= nil and (#(state.jokers or {}) + #(state.consumables or {})) or 0
    return { get('mult_mod'), get('mult_mod') * count, get('Xmult') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local count = #(state.jokers or {}) + #(state.consumables or {})
      if count > 0 then result:add(plusMult(poke.get(card, 'mult_mod') * count)) end
    end,
    onOtherJoker = function(card, state, step, result)
      if step.other and step.other:getJokerDef() == poke.id('minun') then
        result:add(xMult(poke.get(card, 'Xmult')))
      end
    end,
  },
}

-- Minun 312 (the price change is the filter above)
poke.addPokemon {
  name = 'minun', rarity = 1, cost = 3, gen = 3, stage = 'Basic', ptype = 'Lightning',
  blueprint_compat = false,
  config = { money_minus = 1, money = 10 },
  vars = function(get) return { get('money_minus'), get('money') } end,
  dollarsAtRoundEnd = function(card, state)
    local plusles = state:countJoker(poke.id('plusle')) or 0
    if plusles > 0 then
      return poke.ease_poke_dollars(card, 'minun', poke.get(card, 'money') * plusles, true, state)
    end
    return 0
  end,
}

-- Volbeat 313
poke.addPokemon {
  name = 'volbeat', rarity = 2, cost = 5, gen = 3, stage = 'Basic', ptype = 'Grass',
  config = { chips = 0, chip_mod = 6, Xmult_mod = 0.08, Xmult = 1 },
  attributes = { 'chips', 'planet', 'types', 'joker', 'xmult' },
  vars = function(get) return { get('chips'), get('chip_mod'), get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips, x = poke.get(card, 'chips'), poke.get(card, 'Xmult')
      if chips > 0 then result:add(plusChips(chips)) end
      if x ~= 1 then result:add(xMult(x)) end
    end,
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not step.card then return end
      local t = (step.card.lastInfo and step.card.lastInfo.type) or step.card:getConsumableType()
      if t ~= 'fruit' then return end
      if #poke.find_pokemon_type('Grass', card, nil, state) > 0 then
        poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
      else
        poke.add(card, 'chips', poke.get(card, 'chip_mod'))
        result:say('+' .. poke.text.num(poke.get(card, 'chips')) .. ' Points', colors.CHIPS)
      end
    end,
  },
}

