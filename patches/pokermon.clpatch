  attributes = { 'rank', 'suit', 'xmult' },
  -- The original text says "X#1# Mult for each": the bonus is X(1 + #1# x count).
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local n = ranks_and_suits(step.hand.playedCards or {})
      if n > 0 then result:add(xMult(1 + poke.get(card, 'Xmult_multi') * n)) end
    end,
  },
}

---------------------------------------------------------------------------
-- Rattata line: retrigger the first scored cards
---------------------------------------------------------------------------

local function rattata_def(name, rarity, cost, stage, first, rounds, into)
  return {
    name = name, rarity = rarity, cost = cost, stage = stage, ptype = 'Colorless', gen = 1,
    config = { retriggers = 1, rounds = rounds },
    attributes = into and { 'retrigger', 'round_evo' } or { 'retrigger' },
    vars = function(get) return { get('retriggers'), get('rounds') } end,
    triggers = {
      repeatCard = function(card, state, step, result)
        local scoring = step.hand and step.hand.playedCards or {}
        for i = 1, math.min(first, #scoring) do
          if scoring[i].uid == step.card.uid then
            result:say('Again!', colors.ORANGE)
            return poke.get(card, 'retriggers')
          end
        end
      end,
    },
    evolution = into and function(card, state) return poke.level_evo(card, state, into) end or nil,
  }
end

