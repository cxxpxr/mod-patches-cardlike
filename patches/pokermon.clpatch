  config = { debt = 15 },
  attributes = { 'economy', 'passive', 'item', 'generation' },
  vars = function(get) return { get('debt') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if (state.money or 0) < 0 and state.freeConsumableSlots > 0 then
        poke.create_consumeable({ set = 'poke_item' }, card)
      end
    end,
  },
}

-- Rotom 479: packs cost $1 less for each Rotom (normal form) you own.
cardlike.filter('price', function(price, c)
  local state = cardlike.state
  if not c or not state or state.money == nil then return nil end
  local kind = (c.lastInfo or {}).kind
  if kind ~= 'pack' then return nil end
  local n = #poke.active_jokers(state, 'rotom')
  if n == 0 then return nil end
  return math.max(0, price - n)
end)

