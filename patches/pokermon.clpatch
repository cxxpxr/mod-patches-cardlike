    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not step.hand.contains.STRAIGHT then return end
      poke.add(card, 'chips', poke.get(card, 'chip_mod'))
      poke.add(card, 'chip_mod', 1)
      result:say('Upgrade!', colors.CHIPS)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

-- Slowpoke 079
poke.addPokemon {
  name = 'slowpoke', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Water', gen = 1,
  item_req = 'kingsrock',
  knockoff_starter = true,
  config = { Xmult = 2, last_counter = 0, num = 1, dem = 7, shell_used = 0 },
  evo_rqmt = 4,
  attributes = { 'xmult', 'hands', 'trigger_evo', 'item_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('Xmult'), math.max(0, 4 - get('last_counter')), num, dem }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if state.handsLeft ~= 0 then return end
      if not step.copiedBy then poke.add(card, 'last_counter', 1) end
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    -- 1 in 7 chance per reroll to put a free Shellder...? (it evolves Slowpoke) in the shop.
    onShopReroll = function(card, state, step, result)
      if step.copiedBy then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        poke.add_shop_card(poke.id('shell'), card, true)
      end
    end,
  },
  evolution = function(card, state)
    return poke.item_evo(card, state, 'slowking')
      or poke.scaling_evo(card, state, 'slowbro', poke.get(card, 'last_counter'), 4)
      or poke.scaling_evo(card, state, 'slowbro', poke.get(card, 'shell_used'), 1)
  end,
}

-- Slowbro 080
poke.addPokemon {
  name = 'slowbro', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Water', gen = 1,
  config = { Xmult_mod = 0.4, Xmult = 1 },
  megas = { 'mega_slowbro' },
  attributes = { 'xmult', 'hands', 'scaling', 'reset' },
  vars = function(get, card, state)
    local total = get('Xmult')
    if state and state.isPhase and (state:isPhase('play') or state:isPhase('scoring')) then
      total = total + (state.handsPlayed or 0) * get('Xmult_mod')
    end
    return { get('Xmult_mod'), total }
  end,
  triggers = {
    -- Cardlike counts the hand that is scoring in handsPlayed (Balatro: 1 + hands_played).
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult') + (state.handsPlayed or 1) * poke.get(card, 'Xmult_mod')))
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then result:say('Reset', colors.MULT) end
    end,
  },
}

-- Mega Slowbro 080-1
poke.addPokemon {
  name = 'mega_slowbro', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Water', gen = 1,
  config = { Xmult_mod = 0.5, Xmult = 1, hands_played = 0 },
  attributes = { 'xmult', 'hands', 'scaling', 'reset', 'boss_blind' },
  vars = function(get) return { get('Xmult_mod'), get('Xmult') + get('hands_played') * get('Xmult_mod') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if not step.copiedBy then poke.add(card, 'hands_played', 1) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult') + poke.get(card, 'hands_played') * poke.get(card, 'Xmult_mod')))
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      poke.set(card, 'hands_played', 0)
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Shellder...? (Slowpoke's shell): evolves the leftmost Slowpoke that has not eaten a shell, then destroys itself.
-- The original shell is Negative, so it can be bought with full joker slots (no_slot). It destroys itself at once.
poke.addPokemon {
  name = 'shell', rarity = 'poke_safari', cost = 0, stage = 'Basic', ptype = 'Water', gen = 1,
  aux_poke = true,
  no_slot = true,
  config = {},
  in_pool = function(state) return false end,
  onAdded = function(card, state)
    for _, j in ipairs(state.jokers or {}) do
      if poke.name(j) == 'slowpoke' and poke.get(j, 'shell_used') ~= 1 then
        poke.set(j, 'shell_used', 1)
        j:popup('Chomp!', colors.ORANGE)
        cardlike.playSound('shellchomp', { volume = 0.5 })
        break
      end
    end
    card:destroy()
  end,
}


