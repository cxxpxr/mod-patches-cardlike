  vars = function(get, card) return { get('money_minus'), sell_value(card, poke.pokemon.lampent) } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(plusMult(card:getSellValue()))
    end,
    afterRound = function(card, state, step, result)
      for _, v in ipairs(state.jokers or {}) do
        if v ~= card then poke.drain_value(card, v, poke.get(card, 'money_minus')) end
      end
