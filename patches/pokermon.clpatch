  vars = function(get) return { get('chips'), get('chip_mod'), get('size'), 50 } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result) metal_scaling(card, step, 1) end,
    afterAllCardsScored = function(card, state, step, result) give_chips(card, result) end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'metang', poke.get(card, 'chips'), 50) end,
}

