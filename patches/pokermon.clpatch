-- Pokemon jokers 961 to 990 (original pokemon/pokejokers_33.lua).
local poke = cardlike.require('lib.pokermon')

-- Wugtrio 961: X1.5 Mult with a Three of a Kind, +120 Points with a scoring 5, 6 or 7.
poke.addPokemon {
  name = 'wugtrio',
  rarity = 2,
  cost = 6,
  stage = 'One',
  ptype = 'Water',
  gen = 9,
  config = { chips = 120, Xmult = 1.5 },
  attributes = { 'xmult', 'chips', 'hand_type', 'rank', 'five', 'six', 'seven' },
  vars = function(get) return { get('Xmult'), get('chips') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips, mult = poke.any_rank(step.hand.playedCards, 5, 6, 7), step.hand.contains.THREE_OF_A_KIND == true
      if chips then result:add(plusChips(poke.get(card, 'chips'))) end
      if mult then result:add(xMult(poke.get(card, 'Xmult'))) end
      if chips and mult then result:say(poke.text.dict('poke_dig_ex', 'Dig!'), colors.MULT) end
    end,
  },
}

-- Annihilape 979: scored 2, 3, 5 and 7 give +5 Mult and +7 Points for each hand played this round (this one
-- included).
local PRIME = { [2] = true, [3] = true, [5] = true, [7] = true }
poke.addPokemon {
  name = 'annihilape',
  rarity = 'poke_safari',
  cost = 11,
  stage = 'Two',
  ptype = 'Fighting',
  gen = 9,
  config = { mult_mod = 5, chip_mod = 7 },
  attributes = { 'chips', 'mult', 'rank', 'two', 'three', 'five', 'seven' },
  vars = function(get, card, state)
    -- the next hand counts as hand number handsPlayed + 1
    local n = 1 + (state and state.handsPlayed or 0)
    return { get('mult_mod'), get('chip_mod'), get('mult_mod') * n, get('chip_mod') * n }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:getDebuffState() or not PRIME[poke.rank_of(step.card) or 0] then return end
      -- Cardlike counts the hand in handsPlayed when Play is pressed, so this hand is already in it
      local n = math.max(1, state.handsPlayed or 1)
      result:add(plusChips(poke.get(card, 'chip_mod') * n))
      result:add(plusMult(poke.get(card, 'mult_mod') * n))
    end,
  },
}

-- Farigiraf 981: comes with COMMAND (Cryptid). With a Two Pair, the first and last scoring face cards give X2.2 Mult.
poke.addPokemon {
  name = 'farigiraf',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Psychic',
  gen = 9,
  config = { Xmult_multi = 2.2 },
  attributes = { 'holding', 'face', 'xmult', 'hand_type' },
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    -- the Cryptid comes when the joker is obtained, not when Girafarig evolves into it
    onCardObtained = function(card, state, step, result)
      if step.copiedBy or not step.card or step.card.uid ~= card.uid then return end
      poke.create_consumeable('admin_card_1', card)
    end,
    onScore = function(card, state, step, result)
      if not step.hand.contains.TWO_PAIR then return end
      local first, last
      for _, c in ipairs(step.hand.playedCards or {}) do
        if c:isFace() then
          first = first or c
          last = c
        end
      end
      if last and first and last.uid == first.uid then last = nil end
      local uid = step.card.uid
      if (first and first.uid == uid) or (last and last.uid == uid) then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}

-- Dudunsparce 982: +1 card slot and +1 pack in the shop. In 1 of 6 cases it is the three-segment form, which also
-- comes with a Shop Pin (Coupon Tag). Cardlike has no Ticket slot count in the shop, so the Ticket slot is not given.
local DUDUN_TEXT = {
  '{C:attention}+#1#{} card slot in shop',
  '{C:attention}+#1#{} Booster Pack in shop',
}
local DUDUN_PASSIVES = { shop_cards = 'card_slots', shop_packs = 'pack_slots' }

poke.addPokemon {
  name = 'dudunsparce',
  rarity = 'poke_safari',
  cost = 9,
  stage = 'One',
  ptype = 'Colorless',
  gen = 9,
  blueprint_compat = false,
  config = { card_slots = 1, pack_slots = 1, voucher_slots = 1, form = 0 },
  attributes = { 'passive' },
  text = DUDUN_TEXT,
  vars = function(get) return { get('card_slots'), get('pack_slots'), get('voucher_slots') } end,
  passives = DUDUN_PASSIVES,
  onAdded = function(card, state)
    local ds = card:getDataStore()
    if ds:get('poke_form_rolled') then return end
    ds:set('poke_form_rolled', true)
    if state:randomFloat() < 1 / 6 then
      poke.change_form(card, 'dudunsparce2', poke.text.dict('poke_wowthree', 'Wow! Three!'), state)
    end
  end,
}

-- Dudunsparce, three-segment form (only from Dudunsparce's 1 in 6 roll).
poke.addPokemon {
  name = 'dudunsparce2',
  loc_key = 'j_poke_dudunsparce2',
  rarity = 'poke_safari',
  cost = 9,
  stage = 'One',
  ptype = 'Colorless',
  gen = 9,
  hidden = true,
  aux_poke = true,
  blueprint_compat = false,
  sprite = poke.sprites.frame('AtlasJokersBasicGen09', 8, 3),
  config = { card_slots = 1, pack_slots = 1, voucher_slots = 1, form = 1 },
  attributes = { 'passive' },
  text = { '{C:attention}Holding Coupon Tag{}', DUDUN_TEXT[1], DUDUN_TEXT[2] },
  vars = function(get) return { get('card_slots'), get('pack_slots'), get('voucher_slots') } end,
  in_pool = function() return false end,
  passives = DUDUN_PASSIVES,
  onAdded = function(card, state)
    local ds = card:getDataStore()
    ds:set('poke_form_rolled', true)
    if not ds:get('poke_pin_given') then
      ds:set('poke_pin_given', true)
      cardlike.addPin('pin_4')
    end
  end,
}
poke.add_to_family('dudunsparce', { 'dudunsparce2' })

-- Kingambit 983: X2 Mult. When the only King of the full deck is held in hand, scored non-face cards give X1 Mult
-- (half of this joker's X Mult).
local function lone_king_held(state)
  local kings = 0
  for _, c in ipairs(state.allCards or {}) do
    if poke.rank_of(c) == 13 then kings = kings + 1 end
  end
  if kings ~= 1 then return false end
  for _, c in ipairs(state.cardsInHand or {}) do
    if poke.rank_of(c) == 13 then return true end
  end
  return false
end

poke.addPokemon {
  name = 'kingambit',
  rarity = 'poke_safari',
  cost = 11,
  stage = 'Two',
  ptype = 'Metal',
  gen = 9,
  config = { Xmult = 2 },
  attributes = { 'xmult', 'rank', 'king', 'face', 'full_deck' },
  vars = function(get) return { get('Xmult'), get('Xmult') / 2 } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    onScore = function(card, state, step, result)
      if step.card:isFace() or not lone_king_held(state) then return end
      local x = poke.get(card, 'Xmult') / 2
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}


