  config = { mult = 6, rounds = 4 },
  attributes = { 'mult', 'face', 'round_evo' },
  vars = function(get) return { get('mult'), get('rounds') } end,
  triggers = {
    onScore = function(card, state, step, result)
      for _, uid in ipairs(first_faces(step.hand.playedCards, 2)) do
        if uid == step.card.uid then result:add(plusMult(poke.get(card, 'mult'))) return end
