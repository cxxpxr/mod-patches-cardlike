local HERD = { tauros = true, taurosh = true, miltank = true }

poke.addPokemon {
  name = 'tauros', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Colorless', gen = 1,
  config = { Xmult_multi = 1.75, num = 1, dem = 15 },
  vars = function(get, card, state) return { get('Xmult_multi'), poke.chance_num(get('num'), state), get('dem') } end,
  attributes = { 'xmult', 'reroll', 'chance', 'joker', 'generation' },
  triggers = {
    onOtherJoker = function(card, state, step, result)
      if step.other and HERD[poke.name(step.other) or ''] then
        step.other:punch()
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
    onShopReroll = function(card, state, step, result)
      if step.copiedBy then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        poke.add_shop_card(poke.id('taurosh'), card)
      end
    end,
  },
}

