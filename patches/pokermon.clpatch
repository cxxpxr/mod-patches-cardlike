  triggers = {
    onPackOpened = function(card, state, step, result) rotom_pack_item(card, state, result) end,
    -- at the end of the round: lower the rank of the first 2 cards held in hand
    afterRound = function(card, state, step, result)
      local hand = state.cardsInHand or {}
      for i = 1, math.min(2, #hand) do poke.vary_rank(hand[i], true, state) end
    end,
  },
}


== file jokers/pokejokers_17.lua (72 lines)
-- Pokemon jokers 481-510 (original file pokejokers_17.lua).
-- Flower cards give X3 Mult with a Shaymin: content/enhancements.lua reads it. Shaymin Sky's "Flower cards are also
-- Wild cards" is a hand rule of the library (lib/rules.lua: Flower cards count as every suit for Flushes).
local poke = cardlike.require('lib.pokermon')

local FLOWER = poke.MOD_ID .. ':flower'
local DEATH = 'cart_card_3' -- Mage, the Cardlike Death card

-- Shaymin 492: the rightmost scoring card of the first hand of each round becomes a Flower card. Transforms into
-- Shaymin Sky after 10 Flower cards scored.
poke.addPokemon {
  name = 'shaymin',
  rarity = 4,
  cost = 10,
  stage = 'Legendary',
  ptype = 'Grass',
  gen = 4,
  config = { flowers_scored = 0 },
  evo_rqmt = 10,
  attributes = { 'hands', 'modify_card', 'enhancements' },
  vars = function(get) return { math.max(0, 10 - get('flowers_scored')) } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or poke.hands_played_this_round() > 0 then return end
      local scoring = step.hand.playedCards or {}
      local last = scoring[#scoring]
      if last then
        last:setEnhancement(FLOWER)
        last:punch()
      end
    end,
    onScore = function(card, state, step, result)
      if step.copiedBy or step.card:getDebuffState() then return end
      if step.card:getEnhancement() == FLOWER then poke.add(card, 'flowers_scored', 1) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'shaymin_sky', poke.get(card, 'flowers_scored'), 10,
      poke.text.dict('poke_transform_success', 'Transformed!'))
  end,
}

-- Shaymin (Sky Forme): Flower cards are also Wild cards. Transforms back after a Mage (Death) card is used.
poke.addPokemon {
  name = 'shaymin_sky',
  rarity = 4,
  cost = 10,
  stage = 'Legendary',
  ptype = 'Grass',
  gen = 4,
  aux_poke = true,
  config = { death_used = 0 },
  hand_rules = { flower_wild = true },
  attributes = { 'modify_card', 'enhancements', 'passive' },
  in_pool = function() return false end,
  text = {
    '{C:attention}Flower{} cards give {X:mult,C:white} X3 {} Mult', 'instead of {X:mult,C:white} X2 {} Mult',
    '{br:2}ERROR - CONTACT STEAK', '{C:attention}Flower{} cards count as', 'every suit for {C:attention}Flushes{}',
    '{C:inactive,s:0.8}(Transforms with a {C:attention,s:0.8}Mage{C:inactive,s:0.8} card)',
  },
  triggers = {
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not step.card then return end
      if step.card:getConsumableDef() == DEATH then poke.add(card, 'death_used', 1) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'shaymin', poke.get(card, 'death_used'), 1,
      poke.text.dict('poke_transform_success', 'Transformed!'))
  end,
}


== file jokers/pokejokers_18.lua (373 lines)
-- Pokemon jokers 511-540 (original file pokejokers_18.lua).
-- Pansear, Simisear (4-card Flushes and Straights) and Pansage, Simisage (Straights that skip a rank) are hand rules of
-- the library (lib/rules.lua, one handType filter with Aipom, Ambipom, Surskit, Masquerain and Shaymin Sky).
-- Panpour and Simipour make every card with a rank a face card (Pareidolia, Cardlike Joyful Joker).
local poke = cardlike.require('lib.pokermon')

-- Panpour and Simipour: every card with a rank is a face card (face_rule, lib/rules.lua).
local function ranked(c) return not (c.lastInfo or {}).noRank end

local function unenhanced(c)
  local e = poke.info(c).enhancement
  return e == nil or e == 'Default'
end

-- Pansage 511: applies Bridge (Shortcut). Evolves with a Leaf Stone.
poke.addPokemon {
  name = 'pansage',
  rarity = 2,
  cost = 5,
  stage = 'Basic',
  ptype = 'Grass',
  gen = 5,
  item_req = 'leafstone',
  knockoff_starter = true,
  blueprint_compat = false,
  hand_rules = { shortcut = true },
  attributes = { 'applies', 'passive', 'hand_type', 'item_evo' },
  evolution = function(card, state) return poke.item_evo(card, state, 'simisage') end,
}

-- Simisage 512: applies Bridge. Each played unenhanced card has a 1 in 3 chance to become a Paperback (Lucky) card.
poke.addPokemon {
  name = 'simisage',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Grass',
  gen = 5,
  blueprint_compat = false,
  hand_rules = { shortcut = true },
  config = { num = 1, dem = 3 },
  attributes = { 'applies', 'passive', 'hand_type', 'modify_card', 'enhancements', 'chance' },
  vars = function(get, card, state)
    return { get('num') * (state and state.chanceMultiplier or 1), get('dem') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local any = false
      for _, c in ipairs(step.hand.allCards or {}) do
        if unenhanced(c) and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
          c:setEnhancement('Paperback')
          c:punch()
          any = true
        end
      end
      if any then result:say('Upgrade!', colors.GREEN) end
    end,
  },
}

-- Pansear 513: applies Fourk (Four Fingers). Evolves with a Fire Stone.
poke.addPokemon {
  name = 'pansear',
  rarity = 2,
  cost = 5,
  stage = 'Basic',
  ptype = 'Fire',
  gen = 5,
  item_req = 'firestone',
  knockoff_starter = true,
  blueprint_compat = false,
  hand_rules = { four_fingers = true },
  attributes = { 'applies', 'passive', 'hand_type', 'item_evo' },
  evolution = function(card, state) return poke.item_evo(card, state, 'simisear') end,
}

local STRAIGHT_OR_FLUSH = { STRAIGHT = true, FLUSH = true, STRAIGHT_FLUSH = true, ROYAL_FLUSH = true, FLUSH_HOUSE = true,
  FLUSH_FIVE = true }

-- Simisear 514: applies Fourk. If the first hand of the round contains a Straight or a Flush, create a Grace
-- (The Empress) card and destroy each unscored card.
poke.addPokemon {
  name = 'simisear',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Fire',
  gen = 5,
  blueprint_compat = false,
  hand_rules = { four_fingers = true },
  config = {},
  attributes = { 'applies', 'passive', 'hand_type', 'generation', 'tarot', 'destroy_card' },
  vars = function(get, card, state)
    local active = card and state and state.money ~= nil and poke.hands_played_this_round() == 0
    return { active and '(Active!)' or '' }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or poke.hands_played_this_round() > 0 then return end
      local hand = step.hand
      if not (STRAIGHT_OR_FLUSH[hand.handType] or (hand.contains or {}).STRAIGHT or (hand.contains or {}).FLUSH) then return end
      if (state.freeConsumableSlots or 0) > 0 then
        poke.create_consumeable('cart_card_18', card)
      end
      local scored = {}
      for _, c in ipairs(hand.playedCards or {}) do scored[c.uid] = true end
      for _, c in ipairs(hand.allCards or {}) do
        if not scored[c.uid] then c:destroy() end
      end
    end,
  },
}

-- Panpour 515: applies Joyful Joker (Pareidolia). Evolves with a Water Stone.
poke.addPokemon {
  name = 'panpour',
  rarity = 2,
  cost = 5,
  stage = 'Basic',
  ptype = 'Water',
  gen = 5,
  item_req = 'waterstone',
  knockoff_starter = true,
  blueprint_compat = false,
  face_rule = ranked,
  attributes = { 'applies', 'passive', 'modify_card', 'face', 'item_evo' },
  evolution = function(card, state) return poke.item_evo(card, state, 'simipour') end,
}

-- Simipour 516: applies Joyful Joker. The leftmost unenhanced card with the lowest base Points in the played hand
-- becomes a Chipped (Bonus) card.
poke.addPokemon {
  name = 'simipour',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Water',
  gen = 5,
  blueprint_compat = false,
  face_rule = ranked,
  attributes = { 'applies', 'passive', 'modify_card', 'face', 'enhancements' },
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local lowest, lowest_value
      for _, c in ipairs(step.hand.allCards or {}) do
        if unenhanced(c) then
          local v = c:getBasePointValue()
          if not lowest or v < lowest_value then lowest, lowest_value = c, v end
        end
      end
      if lowest then
        lowest:setEnhancement('Chipped')
        lowest:punch()
      end
    end,
  },
}

-- Munna 517: +2 Foresight. When a hand is played, gains X0.05 Mult for each Enhanced Foreseen card and removes its
-- Enhancement. Evolves with a Moon Stone.
poke.addPokemon {
  name = 'munna',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Psychic',
  gen = 5,
  item_req = 'moonstone',
  copy_scaled = true,
  config = { Xmult_multi = 1, Xmult_mod = 0.05, scry = 2 },
  attributes = { 'foresight', 'enhancements', 'modify_card', 'xmult', 'item_evo' },
  vars = function(get) return { get('Xmult_multi'), get('Xmult_mod'), get('scry') } end,
  passives = { scry = 'scry' },
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local eaten = 0
      for _, c in ipairs(poke.scry.cards(state)) do
        if not unenhanced(c) and not c:getDebuffState() then
          c:setEnhancement('Default')
          c:punch()
          eaten = eaten + 1
        end
      end
      if eaten > 0 then poke.add(card, 'Xmult_multi', poke.get(card, 'Xmult_mod') * eaten) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult_multi')))
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'musharna') end,
}

-- Musharna 518: when a blind starts, +2 Foresight this round for each Psychic joker. Each Enhanced Foreseen card gives
-- X Mult (inherited from Munna).
poke.addPokemon {
  name = 'musharna',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Psychic',
  gen = 5,
  config = { Xmult_multi = 1, scry = 2, scry_added = 0 },
  attributes = { 'foresight', 'enhancements', 'xmult', 'joker', 'types' },
  vars = function(get) return { get('Xmult_multi'), get('scry') } end,
  onRemoved = function(card, state)
    local added = poke.get(card, 'scry_added') or 0
    if added > 0 then
      poke.scry.add(-added)
      poke.set(card, 'scry_added', 0)
    end
  end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local count = #poke.find_pokemon_type('Psychic', nil, nil, state)
      if count > 0 then
        local n = count * poke.get(card, 'scry')
        poke.scry.add(n)
        poke.add(card, 'scry_added', n)
        card:punch()
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.scry.add(-(poke.get(card, 'scry_added') or 0))
      poke.set(card, 'scry_added', 0)
    end,
    afterAllCardsScored = function(card, state, step, result)
      for _, c in ipairs(poke.scry.cards(state)) do
        if not unenhanced(c) and not c:getDebuffState() then
          result:add(xMult(poke.get(card, 'Xmult_multi')))
        end
      end
    end,
  },
}

-- Cards with no rank held in hand give +Mult (Roggenrola line).
local function no_rank_held(card, state, step, result, count)
  local i = step.card.lastInfo or {}
  if not i.noRank then return end
  if step.card:getDebuffState() then
    result:say('Debuffed', colors.MULT, step.card)
    return
  end
  if count and not step.copiedBy then poke.add(card, 'hazard_triggered', 1) end
  result:add(plusMult(poke.get(card, 'mult_mod')))
end

-- Roggenrola 524: +1 hazard layer. Each card with no rank held in hand gives +5 Mult. Evolves after 10 triggers.
poke.addPokemon {
  name = 'roggenrola',
  rarity = 1,
  cost = 4,
  stage = 'Basic',
  ptype = 'Earth',
  gen = 5,
