-- Yanma 193
poke.addPokemon {
  name = 'yanma', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 2,
  config = { mult_mod = 3, chip_mod = 6, mult_mod2 = 6, chip_mod2 = 12, num = 1, dem = 3, scored = 0 },
  evo_rqmt = 36,
  attributes = { 'chips', 'mult', 'rank', 'three', 'six', 'chance', 'trigger_evo' },
  vars = function(get, card, state)
    return { get('mult_mod'), get('chip_mod'), get('mult_mod2'), get('chip_mod2'), poke.chance_num(get('num'), state), get('dem'),
      math.max(0, 36 - get('scored')) }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.rank_is(step.card, 3, 6) then return end
      if not step.copiedBy then poke.add(card, 'scored', 1) end
      local mult, chips = poke.get(card, 'mult_mod'), poke.get(card, 'chip_mod')
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        mult, chips = poke.get(card, 'mult_mod2'), poke.get(card, 'chip_mod2')
      end
      result:add(plusMult(mult))
      result:add(plusChips(chips))
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'yanmega', poke.get(card, 'scored'), 36) end,
}

-- Wooper 194, Quagsire 195: +Mult, minus 1 for each face card left in the deck.
local function faces_left(state)
  local n = 0
  for _, c in ipairs(state and state.unDrawnCards or {}) do if (c.lastInfo or {}).face then n = n + 1 end end
  return n
end
local function mud_total(get, state)
  return get('mult') - get('mult_mod') * faces_left(state)
end
local function mud_main(card, state, step, result)
  local m = mud_total(function(k) return poke.get(card, k) end, state)
  if m > 0 then result:add(plusMult(m)) end
end

poke.addPokemon {
  name = 'wooper', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Water', gen = 2,
  config = { mult = 15, mult_mod = 1, rounds = 4 },
  attributes = { 'mult', 'face', 'round_evo' },
  vars = function(get, card, state)
    return { get('mult'), get('rounds'), get('mult_mod'), math.max(0, mud_total(get, state)) }
  end,
  triggers = { afterAllCardsScored = mud_main },
  evolution = function(card, state) return poke.level_evo(card, state, 'quagsire') end,
}

