-- Aerodactyl 142 (Ancient Aces)
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'aerodactyl', rarity = 3, cost = 6, stage = 'Basic', ptype = 'Earth', gen = 1,
  text = poke.text.tiers('aerodactyl'),
  config = { rank = 'Ace', Xmult = 2, Xmult_mod = .5, Xmult1 = 2 },
  vars = function(get) return { 'Ace', get('Xmult'), get('Xmult_mod') } end,
  megas = { 'mega_aerodactyl' },
  attributes = { 'ancient', 'rank', 'ace', 'xmult', 'scaling', 'modify_card', 'enhancements', 'reset' },
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or ancient(step, 14) <= 2 then return end
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.rank_is(c, 14) and c:getEnhancement() == 'Default' then
          poke.convert_cards(c, { mod_conv = 'm_glass' }, state)
          break
        end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local count = ancient(step, 14)
      if count <= 0 then return end
      if not step.copiedBy then
        if count > 1 then poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod')) end
        if count > 3 then poke.set(card, 'Xmult', poke.get(card, 'Xmult') * 2) end
      end
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult1'))
      result:say('Reset', colors.MULT)
    end,
  },
}

poke.addPokemon {
  name = 'mega_aerodactyl', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Earth', gen = 1,
  config = { rank = 'Ace', Xmult_multi = 1, num = 1, dem = 4 },
  vars = function(get, card, state) return { 'Ace', get('Xmult_multi'), poke.chance_num(get('num'), state), get('dem') } end,
  attributes = { 'rank', 'ace', 'xmult', 'chance', 'destroy_card' },
  triggers = {
    onScore = function(card, state, step, result)
      if poke.rank_is(step.card, 14) then
        local aces = ancient(step, 14)
        result:add(xMult(poke.get(card, 'Xmult_multi') * aces))
      end
    end,
    destroyCard = function(card, state, step, result)
      if step.copiedBy or not poke.rank_is(step.card, 14) then return false end
      return state:chance(poke.get(card, 'num') / poke.get(card, 'dem'))
    end,
  },
}

