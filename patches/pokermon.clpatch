  effect = function(ctx)
    local cards = C.sel(ctx)
    local right = C.rightmost(cards)
    for _, c in ipairs(cards) do poke.vary_rank(c, c == right, ctx.state) end
  end,
}

item {
  id = 'kingsrock', pos = { 5, 2 }, evo = true,
  vars = function() return { 1 } end,
  fits = function(ctx) return C.need(ctx, 1, 1) end,
  effect = function(ctx) C.sel(ctx)[1]:setRank(13) end,
}

local UPGRADE_ENH = { 'Chipped', 'Multicard', 'Plaid', 'Fragile', 'Wooden', 'Gilded', 'Paperback', poke.MOD_ID .. ':seed' }
item {
  id = 'upgrade', pos = { 8, 2 }, evo = true,
  vars = function() return { 2 } end,
  fits = function(ctx) return C.need(ctx, 1, 2) end,
  effect = function(ctx)
    local options = {}
    for _, e in ipairs(UPGRADE_ENH) do
      if not e:find(':', 1, true) or cardlike.contentInfo('enhancement', e) then options[#options + 1] = e end
    end
    local e = poke.random_element(options, ctx.state)
    each_sel(ctx, function(c) c:setEnhancement(e) end)
  end,
}

item {
  id = 'hardstone', pos = { 5, 5 }, evo = true, credits = 'Art: Sonfive',
  vars = function() return { 1, 10 } end,
  fits = function(ctx) return C.need(ctx, 1, 1) end,
  effect = function(ctx)
    local c = C.sel(ctx)[1]
    c:setEnhancement('Rock')
    local bonus = 10 * #poke.find_pokemon_type('Earth', nil, nil, ctx.state)
    if bonus > 0 then c:addAdditionalPointValue(bonus) end
  end,
}

-- Prism Scale: 4 random other cards held in hand take the suit of the selected card.
item {
  id = 'prismscale', pos = { 3, 5 }, evo = true,
  vars = function() return { 1, 4 } end,
  fits = function(ctx) return C.need(ctx, 1, 1) end,
  effect = function(ctx)
    local sel = C.sel(ctx)[1]
    local suit = sel:getSuit()
    local others = {}
    for _, c in ipairs(ctx.state.cardsInHand or {}) do if c ~= sel then others[#others + 1] = c end end
    poke.shuffle(others, ctx.state)
    for i = 1, math.min(4, #others) do
      others[i]:setSuit(suit)
      others[i]:punch()
    end
  end,
}

---------------------------------------------------------------------------
-- Type changers and Miracle Seed
---------------------------------------------------------------------------

-- Metal Coat: the leftmost joker becomes Metal type; a Wooden copy of the selected card joins your hand.
item {
  id = 'metalcoat', pos = { 6, 2 },
  vars = function() return { 1 } end,
  note = '(Type Changer: Metal type for the leftmost Joker)',
  fits = function(ctx) return C.need(ctx, 1, 1) end,
  effect = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if choice then poke.apply_type_sticker(choice, 'Metal', ctx.state) end
    local src = C.sel(ctx)[1]
    if src then cardlike.addPlayingCard({ copyOf = src, enhancement = 'Wooden' }, { area = 'hand' }) end
  end,
}

-- Dragon Scale: the leftmost joker becomes Dragon type; up to 3 random Item or Energy cards.
item {
  id = 'dragonscale', pos = { 7, 2 },
  canUse = function(ctx)
    if #(ctx.state.jokers or {}) > 0 then return '' end
    return 'No joker'
  end,
  effect = function(ctx)
    local choice = (ctx.state.jokers or {})[1]
    if choice then poke.apply_type_sticker(choice, 'Dragon', ctx.state) end
    local in_slots = ctx.self and ctx.self:getArea() == 'consumables'
    for _ = 1, math.min(3, C.consumable_room(ctx)) do
      local set = (poke.modifier('no_energy') or ctx.state:randomFloat() > 0.5) and 'pokermon:item' or 'pokermon:energy'
      poke.create_consumeable({ key = set, force = in_slots }, ctx.self)
    end
  end,
}

item {
  id = 'miracleseed', pos = { 2, 7 }, credits = 'Art: Emma, Catzzadilla',
  vars = function() return { 1 } end,
  fits = function(ctx) return C.need(ctx, 1, 1) end,
  effect = function(ctx) C.sel(ctx)[1]:setEnhancement(poke.MOD_ID .. ':seed') end,
}

---------------------------------------------------------------------------
-- Pool rules of Items (Balatro in_pool): Upgrade stays out while you own Porygon2.
---------------------------------------------------------------------------

cardlike.filter('consumablePool', function(ids, ctype)
  local state = cardlike.state
  if not state or state.money == nil then return nil end
  local upgrade = poke.MOD_ID .. ':upgrade'
  if not state:hasJoker(poke.id('porygon2')) then return nil end
  local keep = {}
  for _, id in ipairs(ids) do if id ~= upgrade then keep[#keep + 1] = id end end
  return keep
end)


