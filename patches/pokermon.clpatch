-- Pokermon jokers 811-840: Nickit, Thievul, Yamper, Boltund.
local poke = cardlike.require('lib.pokermon')

local function has_straight(step)
  local c = step.hand and step.hand.contains or {}
  return c.STRAIGHT or c.STRAIGHT_FLUSH or c.ROYAL_FLUSH
end

-- Thievul's money: double the sell value of the leftmost joker (not itself), at most $15.
local function thievul_amount(card, state)
  local jokers = state and state.jokers or {}
  local first = jokers[1]
  if not card or not first or first == card then return 0 end
  return math.min(first:getSellValue() * 2, 15)
end

-- Nickit 827
poke.addPokemon {
  name = 'nickit', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Dark', gen = 8,
  blueprint_compat = false,
  config = { money = 3, rounds = 5 },
  attributes = { 'economy', 'round_evo' },
  vars = function(get) return { get('money'), get('rounds') } end,
  dollarsAtRoundEnd = function(card, state)
    return poke.ease_poke_dollars(card, 'nickit', poke.get(card, 'money'), true, state)
  end,
  evolution = function(card, state) return poke.level_evo(card, state, 'thievul') end,
}

-- Thievul 828
poke.addPokemon {
  name = 'thievul', rarity = 'poke_safari', cost = 9, stage = 'One', ptype = 'Dark', gen = 8,
  blueprint_compat = false,
  config = {},
  attributes = { 'economy', 'sell_value' },
  vars = function(get, card, state) return { thievul_amount(card, state) } end,
  dollarsAtRoundEnd = function(card, state)
    local amount = thievul_amount(card, state)
    if amount > 0 then return poke.ease_poke_dollars(card, 'thievul', amount, true, state) end
    return 0
  end,
}

-- Yamper 835
poke.addPokemon {
  name = 'yamper', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Lightning', gen = 8,
  config = { mult = 3, money = 3, rounds = 4 },
  attributes = { 'mult', 'economy', 'hand_type', 'round_evo' },
  vars = function(get) return { get('mult'), get('money'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not has_straight(step) then return end
      result:add(plusMult(poke.get(card, 'mult')))
      result:add(plusMoney(poke.ease_poke_dollars(card, 'yamper', poke.get(card, 'money'), true, state)))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'boltund') end,
}

-- Boltund 836
poke.addPokemon {
  name = 'boltund', rarity = 3, cost = 8, stage = 'One', ptype = 'Lightning', gen = 8,
  config = { Xmult = 2, money = 4 },
  attributes = { 'xmult', 'economy', 'hand_type' },
  vars = function(get) return { get('Xmult'), get('money') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not has_straight(step) then return end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'boltund', poke.get(card, 'money'), true, state)))
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
  },
}


