---------------------------------------------------------------------------
-- Omanyte 138, Omastar 139 (Ancient 3s)
---------------------------------------------------------------------------
local function fossil_three(card, state, step, result, count)
  if (state.freeConsumableSlots or 0) > 0 then poke.create_consumeable('game') end
  if count > 2 and (state.freeConsumableSlots or 0) > 0 then poke.create_consumeable({ set = 'poke_item' }) end
end

poke.addPokemon {
  name = 'omanyte', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Water', gen = 1,
  text = poke.text.tiers('omanyte'),
  evo_rqmt = 5,
  config = { rank = '3', money = 2, third_goal = 5, third_times = 0 },
  vars = function(get) return { '3', get('money'), math.max(0, 5 - get('third_times')) } end,
  attributes = { 'ancient', 'rank', 'three', 'generation', 'tarot', 'item', 'economy', 'trigger_evo' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local count = ancient(step, 3)
      if count <= 0 then return end
      if count > 2 and not step.copiedBy then poke.add(card, 'third_times', 1) end
      fossil_three(card, state, step, result, count)
      if count > 1 then result:add(plusMoney(poke.ease_poke_dollars(card, 'omanyte', poke.get(card, 'money'), true, state))) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'omastar', poke.get(card, 'third_times'), 5)
  end,
}

-- Omastar's pins: Teapot (Handy), Trash (Garbage), Cash (Investment), Gold (Economy), Discount (D6).
local OMASTAR_PINS = { 'pin_19', 'pin_20', 'pin_8', 'pin_22', 'pin_23' }

poke.addPokemon {
  name = 'omastar', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Water', gen = 1,
  text = poke.text.tiers('omastar'),
  config = { rank = '3', money = 4, tag_created = false },
  vars = function(get) return { '3', get('money'), not get('tag_created') and ' (Active!)' or '' } end,
  attributes = { 'ancient', 'rank', 'three', 'generation', 'tarot', 'item', 'economy', 'tag' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local count = ancient(step, 3)
      if count <= 0 then return end
      fossil_three(card, state, step, result, count)
      if count > 3 and not poke.get(card, 'tag_created') then
        poke.set(card, 'tag_created', true)
        cardlike.addPin(poke.random_element(OMASTAR_PINS, state))
        result:say('+1 Pin', colors.ORANGE)
      end
      if count > 1 then result:add(plusMoney(poke.ease_poke_dollars(card, 'omastar', poke.get(card, 'money'), true, state))) end
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'tag_created', false) end
    end,
  },
}

---------------------------------------------------------------------------
-- Kabuto 140, Kabutops 141 (Ancient 2s)
---------------------------------------------------------------------------
local function fossil_two_chips(card, state, step, result, count_third)
  local count = ancient(step, 2)
  if count <= 0 then return end
  local chips = poke.get(card, 'chips1')
  if count > 2 then
    chips = chips + poke.get(card, 'chips3')
    if count_third and not step.copiedBy then poke.add(card, 'third_times', 1) end
  end
  if chips > 0 then result:add(plusChips(chips)) end
end

local function fossil_two_upgrade(card, state, step, result)
  if ancient(step, 2) > 1 and poke.rank_is(step.card, 2) then
    step.card:addAdditionalPointValue(poke.get(card, 'chips2'))
    result:say('Upgrade!', colors.CHIPS, step.card)
  end
end

poke.addPokemon {
  name = 'kabuto', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Earth', gen = 1,
  text = poke.text.tiers('kabuto'),
  evo_rqmt = 5,
  config = { rank = '2', chips1 = 50, chips2 = 5, chips3 = 50, third_times = 0 },
  vars = function(get) return { '2', get('chips1'), get('chips2'), get('chips3'), math.max(0, 5 - get('third_times')) } end,
  attributes = { 'ancient', 'rank', 'two', 'chips', 'modify_card', 'perma_bonus', 'trigger_evo' },
  triggers = {
    onScore = fossil_two_upgrade,
    afterAllCardsScored = function(card, state, step, result) fossil_two_chips(card, state, step, result, true) end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'kabutops', poke.get(card, 'third_times'), 5)
  end,
}

