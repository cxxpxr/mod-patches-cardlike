== file jokers/pokejokers_03.lua (695 lines)
-- Pokemon jokers 061 to 090 (Poliwhirl to Shellder), from pokejokers_03.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local function poli_suit()
  return poke.run.poli_suit or 'Spades'
end

-- Vars of the Poliwag line texts: #2# the suit, {V:1} its colour, #3# to #6# the suit cycle.
local function poli_vars(first)
  local suit = poli_suit()
  local v = { first, poke.suit_name(suit), 'Spades', 'Hearts', 'Clubs', 'Diamonds' }
  v.colours = { poke.suit_colour(suit) }
  return v
end

-- Abra line: a Game card or an Item card when the poker hand was already played this round.
local function abra_line(card, state, step, result, dem_key, item_id, game_id)
  if poke.times_played_this_round(step.hand.handType) == 0 then return end
  if (state.freeConsumableSlots or 0) < 1 then return end
  if not state:chance(poke.get(card, 'num') / poke.get(card, dem_key or 'dem')) then return end
  if state:randomFloat() < 0.5 then
    poke.create_consumeable(item_id and { key = item_id } or { set = 'poke_item' })
  else
    poke.create_consumeable(game_id and { key = game_id } or { set = 'game' })
  end
  result.activated = true
end

-- The first n scoring face cards.
local function first_faces(cards, n)
  local out = {}
  for _, c in ipairs(cards or {}) do
    if c:isFace() then
      out[#out + 1] = c.uid
      if #out >= n then break end
    end
  end
  return out
end

---------------------------------------------------------------------------
-- Pokemon
---------------------------------------------------------------------------

-- Poliwhirl 061
poke.addPokemon {
  name = 'poliwhirl', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Water', gen = 1,
  item_req = { 'waterstone', 'kingsrock' },
  evo_list = { waterstone = 'poliwrath', kingsrock = 'politoed' },
  config = { mult = 6 },
  attributes = { 'mult', 'suit', 'item_evo' },
  vars = function(get) return poli_vars(get('mult')) end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:isSuit(poli_suit()) then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state) end,
}

-- Poliwrath 062
poke.addPokemon {
  name = 'poliwrath', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Water', gen = 1,
  config = { Xmult_multi = 1.3, mult = 3 },
  attributes = { 'mult', 'xmult', 'suit' },
  vars = function(get)
    local v = poli_vars(get('Xmult_multi'))
    v[7] = get('mult')
    return v
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:isSuit(poli_suit()) then
        result:add(plusMult(poke.get(card, 'mult')))
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}

-- Abra 063
poke.addPokemon {
  name = 'abra', rarity = 1, cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 1,
