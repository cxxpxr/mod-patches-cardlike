  stage = 'One',
  ptype = 'Dark',
  gen = 5,
  config = {},
  attributes = { 'copying' },
  text = function(get, card, state, vars)
    local line = card and state and state.jokers and poke.copy_line(card, state, poke.rightmost_joker(card, state))
    return poke.text.joker('zoroark', vars, line)
  end,
  triggers = poke.copy_triggers { target = poke.rightmost_joker },
}

