-- Pokemon jokers 421-450 (original file pokejokers_15.lua).
-- Ambipom's three-card Flushes and Straights are a hand rule of the library (lib/rules.lua).
local poke = cardlike.require('lib.pokermon')

local function bronzo_suit() return poke.round_target('bronzo_suit', 'Spades') end
local function bronzo_rank() return poke.round_target('bronzo_rank', 'Ace') end
local function bronzo_id() return poke.round_target('bronzo_id', 14) end

-- Ambipom 424: Flushes and Straights can be made with exactly 3 cards (a hand rule of the library, lib/rules.lua).
poke.addPokemon {
  name = 'ambipom',
  rarity = 'poke_safari',
  cost = 9,
  stage = 'One',
  ptype = 'Colorless',
  gen = 4,
  config = { limit = 2 },
  hand_rules = { three_cards = 'exact' },
  attributes = { 'passive', 'hand_type' },
  vars = function(get) return { get('limit') } end,
}

-- Buneary 427: +3 Mult for each unscored card in the played hand. Evolves after 4 rounds.
poke.addPokemon {
  name = 'buneary',
  rarity = 1,
  cost = 5,
  stage = 'Basic',
  ptype = 'Colorless',
  gen = 4,
  config = { mult = 3, rounds = 4 },
  attributes = { 'mult', 'round_evo' },
  vars = function(get) return { get('mult'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult') * #poke.unscored_cards(step.hand)
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'lopunny') end,
}

-- Lopunny 428: +2 Foresight. +5 Mult for each unscored card, X2 Mult if an unscored card has the rank of a
-- Foreseen card.
poke.addPokemon {
  name = 'lopunny',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Colorless',
  gen = 4,
  config = { mult = 5, Xmult = 2, scry = 2 },
  megas = { 'mega_lopunny' },
  attributes = { 'foresight', 'mult', 'xmult', 'rank' },
  vars = function(get) return { get('mult'), get('Xmult'), get('scry') } end,
  passives = { scry = 'scry' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local cards = poke.unscored_cards(step.hand)
      local mult = poke.get(card, 'mult') * #cards
      if mult <= 0 then return end
      local ranks = {}
      for _, c in ipairs(cards) do
        local r = poke.rank_of(c)
        if r then ranks[r] = true end
      end
      local jump = false
      for _, c in ipairs(poke.scry.cards(state)) do
        local r = poke.rank_of(c)
        if r and ranks[r] then jump = true break end
      end
      result:add(plusMult(mult))
      if jump then
        result:add(xMult(poke.get(card, 'Xmult')))
        result:say(poke.text.dict('poke_highjumpkick_ex', 'High Jump Kick!'), colors.MULT)
      end
    end,
  },
}

-- The poker hand that the Foreseen cards make (Mega Lopunny).
local function foreseen_hand(state)
  if not state or state.money == nil then return nil end
  local cards = poke.scry.cards(state)
  if #cards == 0 then return nil end
  return cardlike.evaluateHand(cards)
end

-- Mega Lopunny 428-1: +5 Foresight. X Mult equal to the level of the Foreseen hand.
poke.addPokemon {
  name = 'mega_lopunny',
  rarity = 'poke_mega',
  cost = 12,
  stage = 'Mega',
  ptype = 'Fighting',
  gen = 4,
  config = { scry = 5 },
  attributes = { 'foresight', 'xmult', 'hand_type' },
  vars = function(get, card, state)
    local hand = card and foreseen_hand(state)
    return { get('scry'), hand and hand.name or 'None' }
  end,
  passives = { scry = 'scry' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local hand = foreseen_hand(state)
      if not hand then return end
      local h = state:getHand(hand.handType)
      local level = h and h.level or 1
      result:add(xMult(level))
    end,
  },
}

-- Mismagius 429: scored face cards lose up to 5 bonus Points, which this joker gains as Points. 1 in 4 chance for the
-- card to gain 20 Points instead.
poke.addPokemon {
  name = 'mismagius',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Psychic',
  gen = 4,
  config = { chip_mod = 5, chips = 0, chips2 = 20, num = 1, dem = 4 },
  attributes = { 'face', 'modify_card', 'scaling', 'chance', 'perma_bonus', 'chips' },
  vars = function(get, card, state)
    return { get('chip_mod'), get('chips'), poke.chance_num(get('num'), state), get('dem'), get('chips2') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.copiedBy or not step.card:isFace() or step.card:getDebuffState() then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        step.card:addAdditionalPointValue(poke.get(card, 'chips2'))
        result:say('Upgrade!', colors.CHIPS, step.card)
      else
        local drained = poke.drain_chips(step.card, poke.get(card, 'chip_mod'))
        if drained > 0 then
          poke.add(card, 'chips', drained)
          result:say('Eroded!', colors.CHIPS, step.card)
        end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
}

