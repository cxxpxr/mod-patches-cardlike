      for _, drawn in ipairs(depleted_draws(state, step)) do
        if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
          if state.freeConsumableSlots > 0 then
            poke.create_consumeable({ set = 'game' }, step.copiedBy or card)
          end
          if not step.copiedBy then
            poke.add(card, 'mult', poke.get(card, 'mult_mod'))
            result:say('+' .. poke.text.num(poke.get(card, 'mult_mod')) .. ' Mult', colors.MULT)
          end
        else
          poke.nope(step.copiedBy or card)
        end
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
}


