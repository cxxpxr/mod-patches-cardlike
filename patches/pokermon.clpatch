-- Nincada 290
poke.addPokemon {
  name = 'nincada', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Grass', gen = 3,
  config = { chips = 65, chips_minus = 5, num = 1, dem = 2 },
  vars = function(get, card, state)
    return { get('chips'), get('chips_minus'), poke.chance_num(get('num'), state), get('dem') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      local found = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.rank_is(c, 9, 11) then found = true break end
      end
      if not found then return end
      if not step.copiedBy and poke.get(card, 'chips') > 0 then
        local minus = poke.get(card, 'chips_minus')
        poke.set(card, 'chips', math.max(0, poke.get(card, 'chips') - minus))
        result:say('-' .. poke.text.num(minus) .. ' Points', colors.CHIPS)
      end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) and (state.freeConsumableSlots or 0) > 0 then
        poke.create_consumeable({ set = poke.random_element(poke.CONSUMABLE_TYPES, state) }, card)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
  },
  -- Multi Evolution: at 0 Points it becomes Ninjask, and a copy becomes Shedinja when there is room.
  evolution = function(card, state)
    if poke.get(card, 'chips') > 0 or not poke.can_evolve(card, 'ninjask', false, state) then return false end
    if (state.freeJokerSlots or 0) > 0 then
      local copy = card:copy()
      if copy then poke.evolve(copy, 'shedinja', nil, state) end
    end
    return poke.evolve(card, 'ninjask', nil, state) ~= nil
  end,
}

-- Ninjask 291
