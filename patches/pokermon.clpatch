-- Qwilfish 211
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'qwilfish', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Water', gen = 2,
  config = { hazard_level = 1, chips = 0, chip_mod = 15 },
  attributes = { 'hazards', 'chips', 'scaling', 'enhancements' },
  vars = function(get) return { get('hazard_level'), get('chip_mod'), get('chips') } end,
  passives = { hazard_level = 'hazard_level' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chips')
      if chips > 0 then result:add(plusChips(chips)) end
    end,
    -- Any destroyed playing card (played, discarded, used up by a consumable) with an enhancement.
    onCardsRemoved = function(card, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(step.cards or {}) do
        local e = (c.lastInfo or {}).enhancement
        if e and e ~= 'Default' then
          poke.add(card, 'chips', poke.get(card, 'chip_mod'))
          result:say('+' .. poke.text.num(poke.get(card, 'chip_mod')) .. ' Points', colors.CHIPS)
        end
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Scizor 212 and Mega Scizor
---------------------------------------------------------------------------
local EDITION_BONUS = { Luna = { chips = 50 }, Holo = { mult = 10 }, Chroma = { xmult = 1.5 } }

local function scizor_vars(get, card)
  local e = card and EDITION_BONUS[card:getEdition()] or {}
  return { get('mult') + (e.mult or 0), get('scizor_chips') + (e.chips or 0), get('scizor_Xmult') * (e.xmult or 1), get('mult_mod') }
end

poke.addPokemon {
  name = 'scizor', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Metal', gen = 2,
  config = { mult = 0, scizor_chips = 0, scizor_Xmult = 1, mult_mod = 4 },
  custom_values_to_keep = { 'mult', 'scizor_chips', 'scizor_Xmult', 'mult_mod' },
  megas = { 'mega_scizor' },
  attributes = { 'destroy_card', 'mult', 'editions', 'scaling', 'chips', 'xmult' },
  vars = scizor_vars,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local jokers = state.jokers or {}
      local target
      for i, j in ipairs(jokers) do if j == card then target = jokers[i + 1] break end end
      if not target or target:isLocked() then return end
      local rarity = target:getRarity()
      if rarity ~= 'Common' and rarity ~= 'Uncommon' then
        -- keep the scoring ability of the current edition, then take a new one
        local own = EDITION_BONUS[card:getEdition()]
        if own then
          if own.chips then poke.add(card, 'scizor_chips', own.chips) end
          if own.mult then poke.add(card, 'mult', own.mult) end
          if own.xmult then poke.set(card, 'scizor_Xmult', poke.get(card, 'scizor_Xmult') * own.xmult) end
        end
        local edition = target:getEdition()
        if not EDITION_BONUS[edition] then
          edition = poke.random_edition(state)
        end
        card:setEdition(edition)
      end
      target:destroy()
      poke.add(card, 'mult', poke.get(card, 'mult_mod'))
      card:punch()
      result:say(poke.text.dict('k_upgrade_ex', 'Upgrade!'), colors.MULT)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult, chips, x = poke.get(card, 'mult'), poke.get(card, 'scizor_chips'), poke.get(card, 'scizor_Xmult')
      if mult <= 0 and chips <= 0 and x <= 1 then return end
      if chips > 0 then result:add(plusChips(chips)) end
      if mult > 0 then result:add(plusMult(mult)) end
      if x > 1 then result:add(xMult(x)) end
      result:say(poke.text.dict('poke_x_scissor_ex', 'X-Scissor!'), poke.colours.metal)
    end,
  },
}

poke.addPokemon {
  name = 'mega_scizor', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Metal', gen = 2,
  config = { Xmult_multi = 4, mult = 0, scizor_chips = 0, scizor_Xmult = 1, mult_mod = 4 },
  custom_values_to_keep = { 'mult', 'scizor_chips', 'scizor_Xmult', 'mult_mod' },
  attributes = { 'destroy_card', 'joker', 'xmult' },
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    onOtherJoker = function(card, state, step, result)
      if step.other and step.other:getRarity() == 'Common' then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
    afterRound = function(card, state, step, result)
      card:punch()
      for _, j in ipairs(state.jokers or {}) do
        if j ~= card and j:getRarity() == 'Common' and not j:isLocked() then j:destroy() end
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Shuckle 213
---------------------------------------------------------------------------
local function is_berry_juice(id) return type(id) == 'string' and id:find(poke.MOD_ID .. ':berry_juice', 1, true) == 1 end

poke.addPokemon {
  name = 'shuckle', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Grass', gen = 2,
  blueprint_compat = false,
  attributes = { 'destroy_card', 'generation', 'item' },
  vars = function(get) return {} end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local target = (state.consumables or {})[1]
      if not target then return end
      local id = target:getConsumableDef()
      if is_berry_juice(id) then return end
      local key
      if id == poke.items.id('megastone') then
        key = poke.items.id('berry_juice_mega')
      else
        key = (poke.juice_list or {})[target:getConsumableType()] or poke.items.id('berry_juice_mystery')
      end
      card:punch()
      target:destroy()
      local juice = cardlike.createConsumable(key, { force = true })
      if juice then juice:popup(poke.text.dict('poke_plus_pokeitem', '+1 Item'), colors.PURPLE) end
    end,
  },
}

