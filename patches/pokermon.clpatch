}

-- Clefable 036
poke.addPokemon {
  name = 'clefable', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Fairy', gen = 1,
  config = { mult_mod = 1, suit = 'Clubs', clubs_scored = 0 },
  megas = { 'mega_clefable' },
  attributes = { 'mult', 'suit', 'clubs', 'reset', 'space' },
  vars = function(get)
    return { get('mult_mod'), poke.suit_name(get('suit')), get('mult_mod') * get('clubs_scored'), 5 * get('mult_mod') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local suit = poke.get(card, 'suit')
      local count = 0
      for _, c in ipairs(step.hand.playedCards) do
        if c:isSuit(suit) then count = count + 1 end
      end
      if count > 0 then poke.add(card, 'clubs_scored', count) end
    end,
    onScore = function(card, state, step, result)
      if step.card:isSuit(poke.get(card, 'suit')) and not poke.is_debuffed(step.card) then
        local mult = poke.get(card, 'mult_mod') * poke.get(card, 'clubs_scored')
        if mult > 0 then result:add(plusMult(mult)) end
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, 'clubs_scored') > 0 then
        poke.set(card, 'clubs_scored', 0)
        result:say('Reset')
      end
    end,
  },
}

-- Mega Clefable 036-1
poke.addPokemon {
  name = 'mega_clefable', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Fairy', gen = 1,
  config = { Xmult_multi = 0.03, Xmult_multi1 = 0, Xmult_multi2 = 1 },
  attributes = { 'xmult', 'scaling', 'suit', 'clubs', 'reset', 'space' },
  vars = function(get) return { get('Xmult_multi'), get('Xmult_multi1') + get('Xmult_multi2') } end,
  triggers = {
    -- Clubs drawn this blind.
    onHandDrawn = function(card, state, step, result)
      if step.copiedBy then return end
      local clubs = 0
      for _, c in ipairs(poke.drawn_cards(state, step)) do
        if c:isSuit('Clubs') then clubs = clubs + 1 end
      end
      if clubs > 0 then
        poke.add(card, 'Xmult_multi1', poke.get(card, 'Xmult_multi') * clubs)
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult_multi1') + poke.get(card, 'Xmult_multi2')), colors.MULT)
      end
    end,
    onScore = function(card, state, step, result)
      if step.card:isSuit('Clubs') then
        result:add(xMult(poke.get(card, 'Xmult_multi1') + poke.get(card, 'Xmult_multi2')))
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult_multi1', 0)
      result:say('Reset')
    end,
  },
}

-- Vulpix and Ninetales: each played 9 has a chance to create a Game card.
local function nine_makes_game_card(card, state, step, result)
  if poke.rank_of(step.card) ~= 9 or poke.is_debuffed(step.card) then return end
  if (state.freeConsumableSlots or 0) < 1 then return end
  if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
    if cardlike.createConsumable('game') then result:say('+1 Game Card', colors.PURPLE) end
  end
end

-- Vulpix 037
poke.addPokemon {
  name = 'vulpix', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Fire', gen = 1, knockoff_starter = true,
