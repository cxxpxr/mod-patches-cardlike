}

-- Drowzee 096
poke.addPokemon {
  name = 'drowzee', rarity = 2, cost = 5, stage = 'Basic', ptype = 'Psychic', gen = 1,
  config = { Xmult_mod = 0.2, planets_used = 0 },
  evo_rqmt = 7,
  attributes = { 'xmult', 'planet', 'condition_evo' },
  text = { '{X:mult,C:white}X#2#{} Mult per unique', '{C:planet}Planet{} card used this run', '{C:inactive}(Currently {X:mult,C:white}X#1#{C:inactive} Mult)',
    '{C:inactive,s:0.8}(Evolves after using {C:planet,s:0.8}#3#{C:inactive,s:0.8} more unique Planet cards)' },
  vars = function(get, card, state)
    local used = card and poke.unique_fruits_used() or 0
    return { 1 + used * get('Xmult_mod'), get('Xmult_mod'), math.max(0, 7 - used) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local used = poke.unique_fruits_used()
      if used > 0 then result:add(xMult(1 + used * poke.get(card, 'Xmult_mod'))) end
    end,
  },
  evolution = function(card, state)
    local used = poke.unique_fruits_used()
    poke.set(card, 'planets_used', used)
    return poke.scaling_evo(card, state, 'hypno', used, 7)
  end,
}

