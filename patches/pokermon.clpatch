  evo_rqmt = 2,
  config = { hands = 1, d_size = 1, h_size = 1, boss_defeated = 0 },
  vars = function(get) return { get('hands'), get('d_size'), get('h_size'), math.max(0, 2 - get('boss_defeated')) } end,
  triggers = { beforeRound = mushroom_bonus },
  evolution = function(card, state)
    if state.blind and state.blind.boss and not card:getDebuffState() then poke.add(card, 'boss_defeated', 1) end
    return poke.scaling_evo(card, state, 'breloom', poke.get(card, 'boss_defeated'), 2)
  end,
}

