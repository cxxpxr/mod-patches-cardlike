  enhancement_gate = 'Wooden',
  config = { Xmult_multi = 1.5, rounds = 4 },
  attributes = { 'xmult', 'enhancements', 'round_evo' },
  vars = function(get) return { get('Xmult_multi'), get('rounds') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.has_enhancement(step.card, 'm_steel') then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'magneton') end,
}

local function metal_neighbours(card, state)
  local n = 0
  for _, j in ipairs(poke.get_adjacent_jokers(card, state)) do
    if poke.is_type(j, 'Metal') then n = n + 1 end
  end
  return n
end

-- Magneton 082
poke.addPokemon {
  name = 'magneton', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Lightning', gen = 1,
  enhancement_gate = 'Wooden',
  item_req = 'thunderstone',
  config = { Xmult_multi = 1.5, Xmult_multi2 = 0.2 },
  attributes = { 'xmult', 'enhancements', 'types', 'joker', 'item_evo' },
  vars = function(get, card, state)
    local adjacent = (card and state) and metal_neighbours(card, state) or 0
    return { get('Xmult_multi'), get('Xmult_multi2'), get('Xmult_multi') + adjacent * get('Xmult_multi2') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_steel') then return end
      result:add(xMult(poke.get(card, 'Xmult_multi') + metal_neighbours(card, state) * poke.get(card, 'Xmult_multi2')))
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'magnezone') end,
}

-- Farfetch'd 083
poke.addPokemon {
