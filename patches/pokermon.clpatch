}

-- Muk 089
poke.addPokemon {
  name = 'muk', rarity = 'poke_safari', cost = 6, stage = 'One', ptype = 'Dark', gen = 1,
  config = { mult_mod = 2 },
  attributes = { 'mult', 'full_deck', 'generation', 'destroy_card' },
  vars = function(get, card, state)
    local over = state and (poke.deck_size(state) - poke.starting_deck_size()) or 0
    return { get('mult_mod'), poke.starting_deck_size(), math.max(0, over * get('mult_mod')) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local over = poke.deck_size(state) - poke.starting_deck_size()
      if over > 0 then result:add(plusMult(poke.get(card, 'mult_mod') * over)) end
    end,
    afterRound = function(card, state, step, result)
      add_random_card(state)
      add_random_card(state)
      local target = poke.random_element(state.allCards or {}, state)
      if target then target:destroy() end
      card:punch()
    end,
  },
}

