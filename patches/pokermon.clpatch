}

-- Spinarak 167 / Ariados 168: +Points, with a 1 in 3 chance for more Points instead.
local function spider_score(card, state, step, result)
  local chips = poke.get(card, 'chips')
  if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then chips = poke.get(card, 'chips2') end
  result:add(plusChips(chips))
end
poke.addPokemon {
