-- Nosepass 299
poke.addPokemon {
  name = 'nosepass', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Earth', gen = 3,
  item_req = 'thunderstone',
  config = { Xmult_multi = 2.5 },
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'first') then return end
      for _, c in ipairs(step.hand.playedCards or {}) do
        if c:isFace() then
          c:setEnhancement('Rock')
          c:punch()
          poke.set(card, 'first', c.uid)
          break
        end
      end
    end,
    onScore = function(card, state, step, result)
      local first = poke.get(card, 'first')
      if first and step.card.uid == first then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then card:getDataStore():delete('first') end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'probopass') end,
}

-- Skitty 300: copies the joker to its right when that joker has this round's type (Pokemon jokers only, see
-- lib/copy.lua).
local function skitty_target(card, state)
  local other = poke.right_joker(card, state)
  if other and poke.is_type(other, poke.round_target('cattype', 'Grass')) then return other end
  return nil
end

poke.addPokemon {
  name = 'skitty', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Colorless', gen = 3,
  item_req = 'moonstone',
  config = {},
  vars = function(get)
    local t = poke.round_target('cattype', 'Grass')
    local c = poke.colours[t:lower()] or colors.ORANGE
    return { t, colours = { c, c } }
  end,
  text = function(get, card, state, vars)
    local line
    if card and state and state.jokers then
      line = skitty_target(card, state) and colorize('Compatible', colors.GREEN) or colorize('Incompatible', colors.MULT)
    end
    return poke.text.joker('skitty', vars, line)
  end,
  triggers = poke.copy_triggers { target = skitty_target },
  evolution = function(card, state) return poke.item_evo(card, state, 'delcatty') end,
}


== file jokers/pokejokers_11.lua (542 lines)
-- Pokemon jokers 301-330 (original pokejokers_11.lua): Delcatty to Spinda.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Destroy the joker to the right unless it is Locked (Carvanha, Sharpedo). Returns true when a joker was destroyed.
local function slice_right(card, state)
  local target = poke.right_joker(card, state)
  if not target or target:isLocked() then return false end
  card:punch()
  target:destroy()
  return true
end

-- Per-joker marks for cards to destroy after scoring (Aron line): marks[joker uid][card uid] = true.
local marks = {}
local function mark(card, target)
  marks[card.uid] = marks[card.uid] or {}
  marks[card.uid][target.uid] = true
end
local function is_marked(card, target)
  return marks[card.uid] ~= nil and marks[card.uid][target.uid] == true
end

-- Aron, Lairon, Aggron: gain Xmult for each scoring card with one of `eats`, then destroy those cards.
local function eater(eats)
  local set = {}
  for _, e in ipairs(eats) do set[e] = true end
  return {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      marks[card.uid] = {}
      local n = 0
      for _, c in ipairs(step.hand.playedCards) do
        if set[poke.enhancement(c)] and not poke.is_debuffed(c) then
          n = n + 1
          mark(card, c)
          c:punch()
        end
      end
      if n > 0 then
        poke.add(card, 'eaten', n)
        poke.add(card, 'Xmult', n * poke.get(card, 'Xmult_mod'))
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    destroyCard = function(card, state, step, result)
      if step.copiedBy then return end
      return is_marked(card, step.card) and set[poke.enhancement(step.card)] == true
    end,
  }
end

-- Numel, Camerupt: X Mult on the hand after enough cards were scored. double: enhancement that counts twice.
local function eruption(double)
  return {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, 'active') then poke.set(card, 'cards_scored', 0) end
    end,
    onScore = function(card, state, step, result)
      if step.copiedBy then return end
      local n = 1
      if double and poke.enhancement(step.card) == double then n = 2 end
      poke.add(card, 'cards_scored', n)
    end,
    afterAllCardsScored = function(card, state, step, result)
      if not poke.get(card, 'active') then return end
      if not step.copiedBy then poke.set(card, 'active', false) end
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.get(card, 'cards_scored') >= poke.get(card, 'score_goal') and not poke.get(card, 'active') then
        poke.set(card, 'active', true)
        result:say('Active!', colors.ORANGE)
      end
    end,
  }
end

local function eruption_vars(get)
  return math.max(0, get('score_goal') - get('cards_scored'))
end

-- Meditite, Medicham: +Mult for each empty consumable slot when the discards left match.
local function meditate_total(get, state)
  if not state or state.money == nil then return 0 end
  if state.discardsLeft ~= get('d_remaining') then return 0 end
  return math.max(0, state.freeConsumableSlots or 0) * get('mult_mod')
end

local function meditate(card, state, step, result)
  local total = meditate_total(function(k) return poke.get(card, k) end, state)
  if total > 0 then result:add(plusMult(total)) end
end

---------------------------------------------------------------------------
-- Delcatty: copies the joker to the right when it has this round's type, with extra energy (lib/copy.lua).
---------------------------------------------------------------------------

local function cattype()
  return poke.round_target('cattype', 'Grass')
end

-- The joker Delcatty copies now, or nil.
local function delcatty_target(card, state)
  local other = poke.right_joker(card, state)
  if not other or poke.name(other) == 'delcatty' or not poke.is_type(other, cattype()) then return nil end
  return other
end

---------------------------------------------------------------------------
-- Minun: jokers, packs and consumables cost $1 less for each Minun (original lovely patch on Card:set_cost).
---------------------------------------------------------------------------

local MINUN_KINDS = { joker = true, pack = true, consumable = true }
cardlike.filter('price', function(price, card)
  local state = cardlike.state
  if not state or state.money == nil or not card or type(price) ~= 'number' then return nil end
  local info = card.lastInfo or {}
  if not MINUN_KINDS[info.kind] then return nil end
  local n = state:countJoker(poke.id('minun')) or 0
  if n <= 0 then return nil end
  return math.max(0, price - n)
end)

---------------------------------------------------------------------------
-- The Pokemon
---------------------------------------------------------------------------

-- Delcatty 301
poke.addPokemon {
  name = 'delcatty', rarity = 'poke_safari', cost = 9, gen = 3, stage = 'One', ptype = 'Colorless',
  config = { energy_buff = 1 },
  attributes = { 'copying', 'types', 'energy_count' },
  -- #1# type of the round, #2# extra energy
  vars = function(get)
    local t = cattype()
    local c = poke.colours[t:lower()] or colors.ORANGE
    return { t, get('energy_buff'), colours = { c, c } }
  end,
  triggers = poke.copy_triggers {
    target = delcatty_target,
    energy_buff = function(card) return poke.get(card, 'energy_buff') end,
  },
}

-- Sableye 302
poke.addPokemon {
  name = 'sableye', rarity = 3, cost = 7, gen = 3, stage = 'Basic', ptype = 'Dark',
  config = { Xmult = 1, Xmult1 = 1, Xmult_mod = 0.5, enhancements = {} },
  vars = function(get) return { get('Xmult_mod'), get('Xmult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 1 then result:add(xMult(x)) end
    end,
    -- Each drawn enhanced card whose enhancement is now gone from the deck (depleted) counts once per round.
    onHandDrawn = function(card, state, step, result)
      if step.copiedBy then return end
      local seen = poke.get(card, 'enhancements') or {}
      local gained = false
      for _, c in ipairs(poke.drawn_cards(state, step)) do
        local e = poke.enhancement(c)
        if e and e ~= 'Default' and not seen[e] then
          if poke.get_depleted(function(d) return poke.enhancement(d) == e end, state) then
            seen[e] = true
            poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
            gained = true
          end
        end
      end
      if gained then
        poke.set(card, 'enhancements', seen)
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult1'))
      poke.set(card, 'enhancements', {})
      result:say('Reset', colors.MULT)
    end,
  },
}

