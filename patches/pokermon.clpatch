-- Aipom 190 (selection limit above; 3-card Straights and Flushes are a hand rule of the library, lib/rules.lua)
poke.addPokemon {
  name = 'aipom', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Colorless', gen = 2,
  blueprint_compat = false,
  config = { straights_played = 0, flushes_played = 0, limit = 2 },
  hand_rules = { three_cards = true },
  straight_rqmt = 5, flush_rqmt = 5,
  attributes = { 'passive', 'hand_type', 'condition_evo' },
  vars = function(get)
    return { math.max(0, 5 - get('straights_played')), math.max(0, 5 - get('flushes_played')), get('limit') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local t = step.hand.handType
      local contains = step.hand.contains or {}
      if contains.STRAIGHT or t == 'STRAIGHT' or t == 'STRAIGHT_FLUSH' or t == 'ROYAL_FLUSH' then poke.add(card, 'straights_played', 1) end
      if contains.FLUSH or t == 'FLUSH' or t == 'STRAIGHT_FLUSH' or t == 'ROYAL_FLUSH' or t == 'FLUSH_HOUSE' or t == 'FLUSH_FIVE' then
        poke.add(card, 'flushes_played', 1)
      end
    end,
  },
  evolution = function(card, state)
    local total = math.min(5, poke.get(card, 'straights_played')) + math.min(5, poke.get(card, 'flushes_played'))
    return poke.scaling_evo(card, state, 'ambipom', total, 10)
  end,
}

-- Sunkern 191, Sunflora 192
local function sun_money(seed)
  return function(card, state, step, result)
    result:add(plusMoney(poke.ease_poke_dollars(card, seed, poke.get(card, 'money'), true, state)))
  end
end

