-- Typhlosion 157: +1 discard. +8 Mult and X0.3 Mult for each discard left.
poke.addPokemon {
  name = 'typhlosion', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Fire', gen = 2,
  config = { mult = 8, Xmult = 0.3, d_size = 1 },
  attributes = { 'starter', 'discard', 'passive', 'mult', 'xmult' },
  vars = function(get, card, state)
    local d = state and state.discardsLeft or 0
    return { get('d_size'), get('mult'), get('Xmult'), get('mult') * d, 1 + get('Xmult') * d }
  end,
  passives = { discards = 'd_size' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local d = state.discardsLeft or 0
      if d <= 0 then return end
      result:add(plusMult(poke.get(card, 'mult') * d))
      result:add(xMult(1 + poke.get(card, 'Xmult') * d))
      result:say(poke.text.dict('poke_fire_blast_ex', 'Fire Blast!'), colors.MULT)
    end,
  },
}

