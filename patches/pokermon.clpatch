-- Pokemon jokers 931 to 960 (original pokemon/pokejokers_32.lua).
local poke = cardlike.require('lib.pokermon')

local ITEM = poke.MOD_ID .. ':item'
local function is_item(card) return poke.consumable_type(card) == ITEM end
-- Items used this run (the library's run counter).
local function items_used() return poke.consumables_used(ITEM) end

-- Charcadet 935: gains Mult after each hand, resets at the end of the round. Evolves with a Dawn Stone (Armarouge)
-- or a Dusk Stone (Ceruledge).
poke.addPokemon {
  name = 'charcadet',
  rarity = 2,
  cost = 5,
  stage = 'Basic',
  ptype = 'Fire',
  gen = 9,
  item_req = { 'dawnstone', 'duskstone' },
  evo_list = { dawnstone = 'armarouge', duskstone = 'ceruledge' },
  config = { mult = 0, mult_mod = 5, mult_original = 0 },
  attributes = { 'mult', 'scaling', 'reset', 'item_evo' },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy then return end
      local n = poke.get(card, 'mult_mod')
      poke.add(card, 'mult', n)
      result:say('+' .. poke.text.num(n) .. ' Mult', colors.MULT)
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'mult', poke.get(card, 'mult_original'))
      result:say('Reset', colors.MULT)
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, nil) end,
}

-- Armarouge 936: X3 Mult, loses X1 Mult after each hand, resets at the end of the round.
poke.addPokemon {
  name = 'armarouge',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Fire',
  gen = 9,
  config = { Xmult = 3, Xmult_mod = 1, Xmult2 = 3 },
  attributes = { 'xmult', 'scaling', 'reset' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'Xmult') <= 1 then return end
      local n = poke.get(card, 'Xmult_mod')
      poke.set(card, 'Xmult', math.max(1, poke.get(card, 'Xmult') - n))
      result:say('-X' .. poke.text.num(n) .. ' Mult', colors.MULT)
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult2'))
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Ceruledge 937: gains X0.75 Mult after each hand and drains $1 of sell value from another random joker. Resets at
-- the end of the round.
poke.addPokemon {
  name = 'ceruledge',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Fire',
  gen = 9,
  config = { Xmult = 1, Xmult_mod = 0.75, Xmult2 = 1, money_minus = 1 },
  attributes = { 'xmult', 'scaling', 'reset', 'drain' },
  vars = function(get) return { get('Xmult'), get('Xmult_mod'), get('money_minus') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
    afterHand = function(card, state, step, result)
      if step.copiedBy then return end
      local targets = {}
      for _, j in ipairs(state.jokers or {}) do
        if j ~= card and j:getSellValue() > 1 then targets[#targets + 1] = j end
      end
      local target = poke.random_element(targets, state)
      if target then poke.drain_value(card, target, poke.get(card, 'money_minus')) end
      local n = poke.get(card, 'Xmult_mod')
      poke.add(card, 'Xmult', n)
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')) .. ' Mult', colors.MULT)
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult2'))
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Bramblin and Brambleghast: the second scoring card of this round's rank becomes a Seed card (once per round).
local SEED = poke.MOD_ID .. ':seed'
local function seed_second_rank(card, step, reset_seed)
  if poke.get(card, 'seed_added') > 0 then return end
  local want = poke.round_rank_id('bramblincard')
  for _, c in ipairs(step.hand.playedCards or {}) do
    if poke.rank_of(c) == want then
      local n = poke.add(card, 'rank_scored', 1)
      if n == 2 then
        c:setEnhancement(SEED)
        if reset_seed then c:getDataStore():delete('poke_seed_level') end
        c:punch()
        poke.add(card, 'seed_added', 1)
        return
      end
    end
  end
end

local function reset_seed_counts(card)
  poke.set(card, 'rank_scored', 0)
  poke.set(card, 'seed_added', 0)
end

-- Bramblin counts the cards drawn during blinds.
local function count_draws(card, state, step)
  local drawn = #poke.drawn_cards(state, step)
  if drawn > 0 then poke.add(card, 'cards_drawn', drawn) end
end

-- Bramblin 946: the second scoring card of this round's rank becomes a Seed card. Evolves after drawing 160 cards.
poke.addPokemon {
  name = 'bramblin',
  rarity = 1,
  cost = 6,
  stage = 'Basic',
  ptype = 'Grass',
  gen = 9,
  blueprint_compat = false,
  config = { cards_drawn = 0, seed_added = 0, rank_scored = 0 },
  evo_rqmt = 160,
  attributes = { 'rank', 'modify_card', 'enhancements', 'condition_evo' },
  vars = function(get) return { poke.round_rank('bramblincard'), math.max(0, 160 - get('cards_drawn')) } end,
  triggers = {
    onHandDrawn = function(card, state, step, result)
      if not step.copiedBy then count_draws(card, state, step) end
    end,
    beforeAllCardsScored = function(card, state, step, result)
      if not step.copiedBy then seed_second_rank(card, step, false) end
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then reset_seed_counts(card) end
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'brambleghast', poke.get(card, 'cards_drawn'), 160) end,
}

-- Brambleghast 947: +1 growth level, +2 Points for each $1 you have, and the Seed card effect of Bramblin.
poke.addPokemon {
  name = 'brambleghast',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Grass',
  gen = 9,
  config = { chip_mod = 2, seed_added = 0, rank_scored = 0, growth = 1 },
  attributes = { 'rank', 'modify_card', 'enhancements', 'chips' },
  vars = function(get, card, state)
    local money = state and state.money or 0
    return { get('chip_mod'), get('chip_mod') * math.max(0, money), poke.round_rank('bramblincard'), get('growth') }
  end,
  passives = { growth = 'growth' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local chips = poke.get(card, 'chip_mod') * math.max(0, state.money or 0)
      if chips > 0 then result:add(plusChips(chips)) end
    end,
    beforeAllCardsScored = function(card, state, step, result)
      if not step.copiedBy then seed_second_rank(card, step, true) end
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then reset_seed_counts(card) end
    end,
  },
}

-- Rellor 953: +1 Mult per Item used this run. Evolves after using 5 Items.
poke.addPokemon {
  name = 'rellor',
  rarity = 1,
  cost = 6,
  stage = 'Basic',
  ptype = 'Grass',
  gen = 9,
  config = { items_used = 0, mult_mod = 1 },
  evo_rqmt = 5,
  attributes = { 'mult', 'item', 'condition_evo' },
  vars = function(get) return { get('mult_mod'), items_used() * get('mult_mod'), math.max(0, 5 - get('items_used')) } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = items_used() * poke.get(card, 'mult_mod')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not is_item(step.card) then return end
      poke.add(card, 'items_used', 1)
      result:say('Upgrade!', colors.MULT)
    end,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'rabsca', poke.get(card, 'items_used'), 5) end,
}

-- Rabsca 954: +1 Mult per Item used this run. 1 in 4 chance to create a Game card when you use an Item.
poke.addPokemon {
  name = 'rabsca',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Grass',
  gen = 9,
  config = { mult_mod = 1, num = 1, dem = 4 },
  attributes = { 'mult', 'item', 'tarot' },
  vars = function(get, card, state)
    return { get('mult_mod'), items_used() * get('mult_mod'), poke.chance_num(get('num'), state), get('dem') }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = items_used() * poke.get(card, 'mult_mod')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    onConsumableUsed = function(card, state, step, result)
      if not is_item(step.card) then return end
      if (state.freeConsumableSlots or 0) > 0 and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        poke.create_consumeable({ set = 'game' }, step.copiedBy or card)
      end
      result:say('Upgrade!', colors.MULT)
    end,
  },
}

-- Tinkatink line: played cards give +Mult. When a blind starts, some non-Wooden cards of the deck are debuffed for
-- the round. The joker keeps the uids of the cards it debuffed and frees them at the end of the round.
local function tink_debuff(card, state)
  local list = poke.get(card, 'poke_tink_debuffed', {}) or {}
  local picks = poke.pseudorandom_multi({
    array = state.allCards or {},
    amt = poke.get(card, 'cards_debuffed'),
    add_con = function(c) return not poke.has_enhancement(c, 'Wooden') and not c:getDebuffState() end,
  }, state)
  for _, c in ipairs(picks) do
    c:setDebuffState(true)
    list[#list + 1] = c.uid
  end
  poke.set(card, 'poke_tink_debuffed', list)
end

local function tink_free(card)
  for _, uid in ipairs(poke.get(card, 'poke_tink_debuffed', {}) or {}) do
    local c = cardlike.card(uid)
    if c and c:exists() then c:setDebuffState(false) end
  end
  if card and card.uid then card:getDataStore():delete('poke_tink_debuffed') end
end

local function tink_def(def)
  def.attributes = def.attributes or { 'mult', 'enhancements' }
  def.vars = function(get) return { get('mult'), get('rounds'), get('cards_debuffed') } end
  def.onRemoved = function(card, state) tink_free(card) end
  local triggers = def.triggers or {}
  triggers.beforeRound = function(card, state, step, result) tink_debuff(card, state) end
  triggers.onScore = function(card, state, step, result)
    if step.card:getDebuffState() then return end
    result:add(plusMult(poke.get(card, 'mult')))
    if def.extra_score then def.extra_score(card, state, step, result) end
  end
  triggers.afterRound = function(card, state, step, result) tink_free(card) end
  def.triggers = triggers
  return poke.addPokemon(def)
end

-- Tinkatink 957: played cards give +5 Mult. Debuffs 12 non-Wooden cards each blind. Evolves after 5 rounds.
tink_def {
  name = 'tinkatink',
  rarity = 3,
  cost = 7,
  stage = 'Basic',
  ptype = 'Fairy',
  gen = 9,
  config = { mult = 5, rounds = 5, cards_debuffed = 12 },
  attributes = { 'mult', 'enhancements', 'round_evo' },
  evolution = function(card, state) return poke.level_evo(card, state, 'tinkatuff') end,
}

