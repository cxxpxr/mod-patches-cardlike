      local count = poke.get(card, 'ancient_count', 0)
      if count <= 0 then return end
      lileep_common(card, state, result)
      if count > 2 and not step.copiedBy then poke.add(card, 'third_times', 1) end
    end,
    afterHand = ancient_reset,
  },
  evolution = function(card, state) return poke.scaling_evo(card, state, 'cradily', poke.get(card, 'third_times'), 5) end,
}

-- Cradily 346
poke.addPokemon {
  name = 'cradily', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Grass', gen = 3,
  config = { rank = '8', chip_mod = 20, money_mod = 2, h_size = 1, money_minus = 4, money_minus2 = 26 },
  attributes = { 'ancient', 'rank', 'eight', 'hand_size', 'sell_value', 'chips', 'economy' },
  text = poke.text.tiers('j_poke_cradily'),
  vars = function(get)
    return { '8', get('chip_mod'), get('money_mod'), get('h_size'), get('money_minus'), get('money_minus2') }
  end,
  triggers = {
    beforeAllCardsScored = ancient_before(8),
    onScoreInHand = lileep_held,
    afterAllCardsScored = function(card, state, step, result)
      local count = poke.get(card, 'ancient_count', 0)
      if count <= 0 then return end
      lileep_common(card, state, result)
      if count > 3 then
        local highest = 0
        for _, c in ipairs(state.consumables or {}) do
          local v = c:getSellValue() or 0
          if v > highest then highest = v end
        end
        if highest > 0 then result:add(plusMoney(poke.ease_poke_dollars(card, 'cradily', highest, true, state))) end
      end
    end,
    afterHand = ancient_reset,
  },
}

