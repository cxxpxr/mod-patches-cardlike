}

-- Tinkaton 959: played cards give +15 Mult. Debuffs 20 non-Wooden cards each blind. Wooden cards also work as
-- Fragile cards when scored (X2 Mult, 1 in 4 chance to break).
local FRAGILE_X, FRAGILE_BREAK = 2, 1 / 4
tink_def {
  name = 'tinkaton',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'Two',
  ptype = 'Fairy',
  gen = 9,
  config = { mult = 15, rounds = 5, cards_debuffed = 20 },
  attributes = { 'mult', 'enhancements', 'passive', 'modify_card' },
  text = {
    'Played cards give {C:mult}+#1#{} Mult',
    '{br:3}ERROR - CONTACT STEAK',
    'When {C:attention}Blind{} is selected, debuff',
    '{C:attention}#3#{} {C:attention}non-Steel{} cards in your deck',
    '{br:4}ERROR - CONTACT STEAK',
    'Scored {C:attention}Steel{} cards also give {X:mult,C:white}X2{} Mult',
    'and can break like {C:attention}Glass{} cards',
  },
  extra_score = function(card, state, step, result)
    if poke.has_enhancement(step.card, 'Wooden') then result:add(xMult(FRAGILE_X)) end
  end,
  triggers = {
    destroyCard = function(card, state, step, result)
      if step.copiedBy then return end
      if poke.has_enhancement(step.card, 'Wooden') and not step.card:getDebuffState() then
        return state:chance(FRAGILE_BREAK)
      end
    end,
  },
}

-- Wiglett and Wugtrio: bonus for a Three of a Kind, and Points for a scoring 5, 6 or 7.
