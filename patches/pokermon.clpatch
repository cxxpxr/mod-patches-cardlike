}


== file content/consumables/common.lua (97 lines)
-- Helpers shared by the consumable files (balls, energy, spectral, items, rare).
local poke = cardlike.require('lib.pokermon')
local C = {}

-- Loc text with the parts that do not apply in Cardlike removed: the "ERROR - CONTACT STEAK" filler after a
-- divider, and "or selected" (Cardlike has no joker selection: effects go to the leftmost joker).
local function clean(lines)
  local out = {}
  for i, l in ipairs(lines or {}) do
    out[i] = l:gsub('ERROR %- CONTACT STEAK', ''):gsub(' or selected', ''):gsub('leftmost or$', 'leftmost')
  end
  return out
end

function C.desc(set, key, vars)
  local e = poke.text.entry(set, key)
  if not e then return '' end
  return poke.text.format(clean(e.text), vars)
end

function C.name(set, key) return poke.text.name(set, key) end

--- Whether a run is going (description functions also run in the collection).
function C.in_run()
  local s = cardlike.state
  return s ~= nil and s.money ~= nil
end

--- Energy limit text for the Energy descriptions (#1#).
function C.energy_limit()
  if poke.settings.unlimited_energy then return 'Infinity' end
  return poke.energy.max + ((poke.run and poke.run.energy_plus) or 0)
end

--- Selected cards of a consumable context.
function C.sel(ctx) return ctx.selectedCards or {} end

--- Selection size check: '' when between min and max cards are selected, else a reason.
function C.need(ctx, min, max)
  local n = #C.sel(ctx)
  if n >= min and n <= max then return '' end
  if min == max then return 'Select ' .. min .. ' card' .. (min == 1 and '' or 's') end
  return 'Select ' .. min .. ' to ' .. max .. ' cards'
end

--- Free consumable slots for cards created by a consumable in use (the used card frees its own slot).
function C.consumable_room(ctx)
  local s = ctx.state
  local room = s.freeConsumableSlots or 0
  if ctx.self and ctx.self:getArea() == 'consumables' then room = room + 1 end
  return room
end

--- Create one consumable when there is room (counts the slot of the card in use). Returns the card or nil.
function C.create(ctx, what)
  if C.consumable_room(ctx) <= 0 then return nil end
  local in_slots = ctx.self and ctx.self:getArea() == 'consumables'
  -- what: a full consumable id or type id ('pokermon:item', 'pokermon:energy', 'pokermon:leek')
  return poke.create_consumeable({ key = what, force = in_slots }, ctx.self)
end

--- Rightmost card of a list by its position in hand.
function C.rightmost(cards)
  local best, bi = nil, -1
  for _, c in ipairs(cards) do
    local i = c:getIndex() or 0
    if i > bi then best, bi = c, i end
  end
  return best
end

--- Consumable cards you hold with this id.
function C.held(state, id)
  local out = {}
  for _, c in ipairs(state.consumables or {}) do
    if c:getConsumableDef() == id then out[#out + 1] = c end
  end
  return out
end

--- Evolution item: canUse is '' when a joker needs the item, or when the selection fits (fits(ctx) returns '').
function C.evo_can_use(name, ctx, fits)
  if poke.evo_item_target(name, ctx.state) then return '' end
  local r = fits and fits(ctx) or 'No Pokemon needs this item'
  if r == '' then return '' end
  return r
end

--- Evolution item action: run effect(ctx) when the selection fits, then flag the leftmost joker that needs it.
function C.evo_use(name, ctx, fits, effect)
  poke.set_spoon_item(name)
  if fits and fits(ctx) == '' and effect then effect(ctx) end
  poke.evo_item_use(name, ctx.state)
end

return C


