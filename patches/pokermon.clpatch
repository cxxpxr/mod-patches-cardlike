---------------------------------------------------------------------------
-- Swinub 220, Piloswine 221
---------------------------------------------------------------------------
local function swinub_score(card, state, step, result)
  local played = step.hand.playedCards or {}
  if step.card ~= played[1] then return end
  local n = 0
  for _, c in ipairs(played) do if poke.has_enhancement(c, 'm_stone', 'm_glass') then n = n + 1 end end
  if n > 0 then result:add(plusMult(poke.get(card, 'mult') * n)) end
end

local function swinub_dollars(card, state)
  if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
    return poke.ease_poke_dollars(card, 'swinub', poke.get(card, 'money'), true, state)
  end
  return 0
end

poke.addPokemon {
  name = 'swinub', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Earth', gen = 2,
  config = { mult = 5, money = 3, num = 1, dem = 2, rounds = 5 },
  attributes = { 'mult', 'enhancements', 'chance', 'economy', 'round_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('mult'), get('money'), num, dem, get('rounds') }
  end,
  triggers = { onScore = swinub_score },
  dollarsAtRoundEnd = swinub_dollars,
  evolution = function(card, state) return poke.level_evo(card, state, 'piloswine') end,
}

poke.addPokemon {
  name = 'piloswine', rarity = 3, cost = 8, stage = 'One', ptype = 'Earth', gen = 2,
  config = { mult = 10, money = 6, num = 1, dem = 2, scored = 0 },
  evo_rqmt = 15,
  attributes = { 'mult', 'enhancements', 'chance', 'economy', 'trigger_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('mult'), get('money'), num, dem, math.max(0, 15 - get('scored')) }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not step.copiedBy and poke.has_enhancement(step.card, 'm_stone', 'm_glass') then poke.add(card, 'scored', 1) end
      swinub_score(card, state, step, result)
    end,
  },
  dollarsAtRoundEnd = swinub_dollars,
  evolution = function(card, state) return poke.scaling_evo(card, state, 'mamoswine', poke.get(card, 'scored'), 15) end,
}

