-- Pokermon jokers 721-750: Grubbin, Charjabug, Vikavolt, Rockruff, Lycanroc (Midday, Midnight, Dusk).
local poke = cardlike.require('lib.pokermon')

local function lightning_count(state)
  if not state or not state.jokers then return 0 end
  return #poke.find_pokemon_type('Lightning', nil, nil, state)
end

-- Grubbin 736
poke.addPokemon {
  name = 'grubbin', rarity = 1, cost = 3, stage = 'Basic', ptype = 'Grass', gen = 7,
  config = { mult = 3, rounds = 4 },
  attributes = { 'mult', 'types', 'round_evo' },
  vars = function(get) return { get('mult'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if lightning_count(state) > 0 then mult = mult * 3 end
      result:add(plusMult(mult))
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'charjabug') end,
}

-- Charjabug 737
poke.addPokemon {
  name = 'charjabug', rarity = 'poke_safari', cost = 5, stage = 'One', ptype = 'Lightning', gen = 7,
  item_req = 'thunderstone',
  config = { mult = 7 },
  attributes = { 'mult', 'types', 'joker', 'item_evo' },
  vars = function(get, card, state) return { get('mult'), get('mult') * lightning_count(state) } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local count = lightning_count(state)
      if count > 0 then result:add(plusMult(poke.get(card, 'mult') * count)) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'vikavolt') end,
}

-- Vikavolt 738
poke.addPokemon {
  name = 'vikavolt', rarity = 'poke_safari', cost = 6, stage = 'Two', ptype = 'Lightning', gen = 7,
  config = { Xmult = .5 },
  attributes = { 'mult', 'xmult', 'types', 'joker' },
  vars = function(get, card, state)
    return { get('Xmult'), math.max(1, 1 + get('Xmult') * lightning_count(state)) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.get(card, 'Xmult') * lightning_count(state)
      if x > 1 then
        result:add(xMult(x))
        result:say(poke.text.dict('poke_thunder_ex', 'Thunder!'), colors.MULT)
      end
    end,
  },
}

-- Rockruff 744: +Mult for each scored non-face card. Evolves by the even and odd cards it scored:
-- both counts done: Dusk, else even count done: Midday, else odd count done: Midnight.
poke.addPokemon {
  name = 'rockruff', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Earth', gen = 7,
  config = { mult = 2, even_to_score = 20, odd_to_score = 20 },
  evo_rqmt = 20,
  attributes = { 'mult', 'face', 'condition_evo' },
  vars = function(get) return { get('mult'), get('even_to_score'), get('odd_to_score') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:isFace() then return end
      if not step.copiedBy then
        if poke.is_even(step.card) and poke.get(card, 'even_to_score') > 0 then poke.add(card, 'even_to_score', -1) end
        if poke.is_odd(step.card) and poke.get(card, 'odd_to_score') > 0 then poke.add(card, 'odd_to_score', -1) end
      end
      result:add(plusMult(poke.get(card, 'mult')))
    end,
  },
  evolution = function(card, state)
    local even, odd = poke.get(card, 'even_to_score'), poke.get(card, 'odd_to_score')
    return poke.scaling_evo(card, state, 'lycanroc_dusk', 40 - odd - even, 40)
      or poke.scaling_evo(card, state, 'lycanroc_day', 20 - even, 20)
      or poke.scaling_evo(card, state, 'lycanroc_night', 20 - odd, 20)
  end,
}

-- Lycanroc (Midday) 745: even cards give +Mult. A first hand of exactly 1 card gives +Points and +1 hand.
poke.addPokemon {
  name = 'lycanroc_day', rarity = 'poke_safari', cost = 5, stage = 'One', ptype = 'Earth', gen = 7,
  config = { mult = 4, chip_mod = 40, hands = 1 },
  attributes = { 'mult', 'rank', 'two', 'four', 'six', 'eight', 'ten', 'hands', 'chips' },
  vars = function(get) return { get('mult'), get('chip_mod'), get('hands') } end,
  triggers = {
    onScore = function(card, state, step, result)
      local even = poke.is_even(step.card)
      -- Cardlike counts the hand as played when Play is pressed, so the first hand has handsPlayed == 1.
      if (state.handsPlayed or 0) <= 1 and #(step.hand.allCards or {}) == 1 then
        poke.ease_hands_played(poke.get(card, 'hands'), state)
        result:add(plusChips(poke.get(card, 'chip_mod')))
        if even then result:add(plusMult(poke.get(card, 'mult'))) end
        return
      end
      if even then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
  },
}

-- Lycanroc (Midnight): odd cards give +Mult. At a Boss Blind: +1 hand, +1 discard and +1 hand size this round.
poke.addPokemon {
  name = 'lycanroc_night', rarity = 'poke_safari', cost = 5, stage = 'One', ptype = 'Earth', gen = 7,
  config = { mult = 5, hands = 1, discards = 1, h_size = 1 },
  attributes = { 'mult', 'rank', 'ace', 'three', 'five', 'seven', 'nine', 'boss_blind', 'hands', 'discard', 'hand_size' },
  vars = function(get) return { get('mult'), get('hands'), get('discards'), get('h_size') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if not (state.blind and state.blind.boss) then return end
      poke.ease_hands_played(poke.get(card, 'hands'), state)
      state.discardsLeft = state.discardsLeft + poke.get(card, 'discards')
      state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + poke.get(card, 'h_size')
      result:say('Night!', poke.colours.dark)
    end,
    onScore = function(card, state, step, result)
      if poke.is_odd(step.card) then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
  },
}

-- Lycanroc (Dusk): non-face cards give +Mult. Retriggers the first even and the first odd scoring card.
poke.addPokemon {
  name = 'lycanroc_dusk', rarity = 'poke_safari', cost = 5, stage = 'One', ptype = 'Earth', gen = 7,
  config = { mult = 4, retriggers = 1 },
  attributes = { 'mult', 'face', 'rank', 'ace', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'retrigger' },
  vars = function(get) return { get('mult') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if not step.card:isFace() then result:add(plusMult(poke.get(card, 'mult'))) end
    end,
    repeatCard = function(card, state, step, result)
      local first_even, first_odd
      for _, c in ipairs(step.hand.playedCards or {}) do
        if not first_even and poke.is_even(c) then first_even = c end
        if not first_odd and poke.is_odd(c) then first_odd = c end
      end
      if step.card == first_even or step.card == first_odd then
        result:say('Again!', colors.ORANGE, step.card)
        return poke.get(card, 'retriggers')
      end
    end,
  },
}


