    beforeRound = function(card, state, step, result)
      if state.freeConsumableSlots <= 0 then return end
      local types = {}
      for _, t in ipairs(cardlike.listContent('consumableType') or {}) do
        if t.id then types[#types + 1] = t.id end
      end
      if #types == 0 then types = poke.CONSUMABLE_TYPES end
      local c = cardlike.createConsumable(poke.random_element(types, state), { edition = poke.random_edition(state) })
      if c then c:popup(poke.text.dict('poke_plus_consumable', '+1 Consumable'), colors.ORANGE) end
    end,
  },
}

poke.addPokemon {
  name = 'rotomfan',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'Basic',
  ptype = 'Colorless',
  gen = 4,
  aux_poke = true,
  hidden = true,
  in_pool = no_pool,
  config = { num = 1, dem = 2 },
  attributes = { 'chance', 'item', 'generation', 'destroy_card', 'tag' },
  vars = function(get, card, state) return { poke.chance_num(get('num'), state), get('dem') } end,
  triggers = {
    onPackOpened = function(card, state, step, result) rotom_pack_item(card, state, result) end,
    -- when a blind starts: destroy the joker to the right (not Locked) and get a random pin (not the Reroll Pin)
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local jokers = state.jokers or {}
      local right
      for i, j in ipairs(jokers) do if j == card then right = jokers[i + 1] break end end
      if not right or right:isLocked() then return end
      card:punch()
      right:destroy()
      local pin
      for _ = 1, 10 do
        pin = cardlike.randomPin()
        if pin ~= 'pin_12' then break end
      end
      if pin and pin ~= 'pin_12' then cardlike.addPin(pin) end
    end,
  },
}

poke.addPokemon {
