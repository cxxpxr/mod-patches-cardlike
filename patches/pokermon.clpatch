-- Missingno (original file pokemon/zmissingno.lua).
local poke = cardlike.require('lib.pokermon')

-- Pins that Missingno never makes: the Reroll Pin (Balatro Boss Tag) and the Pokermon pins that are never offered.
local NO_PIN = { pin_12 = true, ['pokermon:jirachi_tag'] = true, ['pokermon:starterq_tag'] = true }

local function random_pin()
  for _ = 1, 10 do
    local id = cardlike.randomPin()
    if id and not NO_PIN[id] then return id end
  end
  return 'pin_0'
end

-- Missingno: creates consumables when obtained and random pins at the end of each round.
poke.addPokemon {
  name = 'missingno',
  rarity = 4,
  cost = 21,
  stage = 'Legendary',
  ptype = 'Bird',
  gen = 1,
  config = { tags_created = 2 },
  attributes = { 'tag', 'generation' },
  vars = function(get) return { get('tags_created') } end,
  -- Fills the empty consumable slots with copies of the first consumable (an Item when there is none). The original
  -- also put copies into the empty joker slots; Cardlike keeps consumables in their own row, so those copies go to
  -- the consumables above the limit.
  onAdded = function(card, state)
    local first = (state.consumables or {})[1]
    local id, edition
    if first then
      id = first:getConsumableDef()
      edition = first:getEdition()
    else
      local made = poke.create_consumeable({ set = 'poke_item' }, card)
      if not made then return end
      id = made:getConsumableDef()
      edition = made:getEdition()
    end
    if edition == 'default' then edition = nil end
    local empty_con = math.max(0, state.freeConsumableSlots or 0)
    local empty_jokers = math.max(0, state.freeJokerSlots or 0)
    for _ = 1, empty_con do cardlike.createConsumable(id, { edition = edition }) end
    for _ = 1, empty_jokers do cardlike.createConsumable(id, { edition = edition, force = true }) end
    card:popup('???', colors.PURPLE)
  end,
  triggers = {
    afterRound = function(card, state, step, result)
      local more = state:randomFloat() > 0.90 and 1 or 0
      for _ = 1, poke.get(card, 'tags_created') + more do cardlike.addPin(random_pin()) end
      result:say('+' .. (poke.get(card, 'tags_created') + more) .. ' Pins?', colors.ORANGE)
    end,
  },
}


== file jokers/zotherjokers.lua (645 lines)
-- Jokers that are not Pokemon (original file pokemon/zotherjokers.lua): Pokedex, Rotom Dex, Everstone, Tall Grass,
-- food, eggs, rivals, the Ruins of Alph and the professors. They use stage 'Other' so the library finds them.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

local function in_run(state) return state ~= nil and state.money ~= nil end

local function run_flag(key) return (poke.run.vars or {})[key] == true end
local function set_run_flag(key)
  poke.run.vars = poke.run.vars or {}
  poke.run.vars[key] = true
end

-- Messages of the "after N rounds, sell this" jokers.
local function round_counter(card, result)
  local total, current = poke.get(card, 'rounds_total'), poke.add(card, 'rounds_current', 1)
  if current < total then
    result:say(current .. '/' .. total, colors.ORANGE)
  else
    result:say('Active!', colors.ORANGE)
  end
end

local function stage_of(card)
  local def = poke.def(card)
  return def and def.stage
end

-- A playing card list has a card with an enhancement.
local function any_enhanced(cards, enhancement)
  return poke.any(cards, function(c) return poke.has_enhancement(c, enhancement) end)
end

---------------------------------------------------------------------------
-- Pokedex: other Pokemon of the same evolution line can appear (the library checks for this joker).
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'pokedex',
  rarity = 2,
  cost = 5,
  stage = 'Other',
  blueprint_compat = false,
  attributes = { 'passive' },
}

---------------------------------------------------------------------------
-- Rotom Dex: Packs cost $1 less for each different type among your jokers.
---------------------------------------------------------------------------
local function type_count(state)
  if not in_run(state) then return 0 end
  local seen, n = {}, 0
  for _, j in ipairs(state.jokers or {}) do
    local t = poke.get_type(j)
    if t and not seen[t] then
      seen[t] = true
      n = n + 1
    end
  end
  return n
end

poke.addPokemon {
  name = 'rotomdex',
  rarity = 2,
  cost = 6,
  stage = 'Other',
  blueprint_compat = false,
  attributes = { 'types', 'joker', 'economy' },
  vars = function(get, card, state) return { type_count(state) } end,
}

cardlike.filter('price', function(price, card)
  local state = cardlike.state
  if not in_run(state) or not card then return nil end
  local kind = (card.lastInfo or {}).kind or card.kind
  if kind ~= 'pack' then return nil end
  local count = state:countJoker(poke.id('rotomdex')) or 0
  if count <= 0 then return nil end
  local discount = type_count(state) * count
  if discount <= 0 then return nil end
  return math.max(0, price - discount)
end)

---------------------------------------------------------------------------
-- Everstone: Pokemon cannot evolve (the library checks for this joker). Basic and Baby Pokemon give X Mult.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'everstone',
  rarity = 3,
  cost = 8,
  stage = 'Other',
  config = { Xmult_multi = 1.75, Xmult_multi2 = 1.5 },
  attributes = { 'xmult' },
  vars = function(get) return { get('Xmult_multi'), get('Xmult_multi2') } end,
  triggers = {
    onOtherJoker = function(card, state, step, result)
      local stage = stage_of(step.other)
      local x = 1
      if stage == 'Basic' then x = poke.get(card, 'Xmult_multi2')
      elseif stage == 'Baby' then x = poke.get(card, 'Xmult_multi') end
      if x > 1 then
        step.other:punch()
        result:add(xMult(x))
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Tall Grass: 1 in 2 chance (sure with a scoring Plaid card) to create a Common Pokemon when a hand is played.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'tall_grass',
  rarity = 1,
  cost = 6,
  stage = 'Other',
  config = { num = 1, dem = 2 },
  attributes = { 'generation', 'enhancements', 'joker' },
  vars = function(get, card, state)
    local m = in_run(state) and (state.chanceMultiplier or 1) or 1
    return { get('num') * m, get('dem') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if (state.freeJokerSlots or 0) <= 0 then return end
      local wild = any_enhanced(step.hand.playedCards, 'm_wild')
      if wild or state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        local id = poke.get_random_poke_key({ rarity = 1 }, state)
        local made = id and cardlike.createJoker(id)
        if made then
          cardlike.playSound('timpani')
          result:say('+1 Joker', colors.CHIPS)
        end
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Jelly Donut: creates a Colorless Energy when a blind is picked, for 4 rounds.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'jelly_donut',
  rarity = 2,
  cost = 6,
  stage = 'Other',
  config = { rounds = 4 },
  attributes = { 'generation', 'energy', 'food' },
  vars = function(get) return { get('rounds') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if not step.copiedBy then poke.add(card, 'rounds', -1) end
      if (state.freeConsumableSlots or 0) > 0 then
        cardlike.createConsumable(poke.MOD_ID .. ':colorless_energy')
        result:say('Energy!', poke.colours.pink)
      else
        result:say('No Room!', colors.MULT)
      end
      if not step.copiedBy and poke.get(card, 'rounds') <= 0 then
        result:say('Eaten!', colors.MULT)
        result:destroySelf()
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Treasure Eatery: when a blind is picked, the leftmost joker gets the type of the rightmost joker, for 4 rounds.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'treasure_eatery',
  rarity = 2,
  cost = 5,
  stage = 'Other',
  blueprint_compat = false,
  config = { rounds = 4 },
  attributes = { 'types' },
  vars = function(get) return { get('rounds') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      poke.add(card, 'rounds', -1)
      local jokers = state.jokers or {}
      if #jokers > 1 then
        local t = poke.get_type(jokers[#jokers])
        if t then
          poke.apply_type_sticker(jokers[1], t, state)
          card:punch()
          result:say(poke.text.dict('poke_tera_ex', 'Tera!'), '#4584fa', jokers[1])
        end
      end
      if poke.get(card, 'rounds') <= 0 then
        result:say(poke.text.dict('poke_closed_ex', 'Closed!'), colors.MULT)
        result:destroySelf()
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Mystery Egg: hatches into a Basic or Baby Pokemon (with 1 energy) after some rounds.
---------------------------------------------------------------------------

-- Pokemon with a Flame Body style ability: an egg next to one hatches faster when you own the Oologist.
local EGG_HELPERS = {}
for _, n in ipairs({ 'rolycoly', 'carkol', 'coalossal', 'slugma', 'magcargo', 'camerupt', 'magby', 'magmar', 'magmortar',
    'litwick', 'lampent', 'chandelure', 'larvesta', 'volcarona', 'fletchinder', 'talonflame', 'sizzlipede', 'centiskorch',
    'moltres', 'heatran', 'charcadet' }) do EGG_HELPERS[n] = true end

-- The Pokemon in the egg and its hatch time: Common 2 rounds, Uncommon 2 or 3, Rare 3.
local function fill_egg(card, state)
  local id = poke.get_random_poke_key({ stage = { 'Baby', 'Basic' }, rarity = { 1, 2, 3 } }, state)
  local def = poke.def(id)
  local r = def and def.poke_rarity
  local rounds = 3
  if r == 1 then rounds = 2
  elseif r == 2 then rounds = 2 + (state:randomFloat() > 0.5 and 1 or 0) end
  poke.set(card, 'key', id)
  poke.set(card, 'rounds', rounds)
end

poke.addPokemon {
  name = 'mystery_egg',
  rarity = 1,
  cost = 1,
  stage = 'Other',
  blueprint_compat = false,
  config = { rounds = 3 },
  attributes = { 'energy_count' },
  vars = function(get) return { math.max(0, math.ceil(get('rounds'))) } end,
  onAdded = function(card, state)
    if in_run(state) and not poke.get(card, 'key') then fill_egg(card, state) end
  end,
  -- Runs at the end of each won round, like the original end_of_round step.
  evolution = function(card, state)
    local adjacent = 0
    for _, j in ipairs(poke.get_adjacent_jokers(card, state)) do
      if EGG_HELPERS[poke.name(j) or ''] then adjacent = adjacent + 1 end
    end
    local rounds = poke.get(card, 'rounds') - 1
    if state:hasJoker(poke.id('oologist')) then
      local fire = 0
      for _, c in ipairs(state.consumables or {}) do
        if c:getConsumableDef() == poke.MOD_ID .. ':fire_energy' then fire = fire + 1 end
      end
      if adjacent + fire > 0 and state:randomFloat() < (adjacent + fire) / 4 then rounds = rounds - 1 end
      rounds = rounds - adjacent / 4
    end
    poke.set(card, 'rounds', rounds)
    if rounds <= 0 then
      local key = poke.get(card, 'key')
      if not key then
        fill_egg(card, state)
        key = poke.get(card, 'key')
      end
      return poke.evolve(card, key, { message = poke.text.dict('poke_crack_ex', 'CRACK!'), transformation = true, energize_amount = 1 }, state) ~= nil
    end
    card:popup(poke.text.dict('poke_shake_ex', 'Shake!'), colors.ORANGE)
    return false
  end,
}

---------------------------------------------------------------------------
-- Rival, Bitter Rival, Champion: a three-joker story. Each one appears after the one before was beaten.
---------------------------------------------------------------------------
local function rival_def(name, defeated_flag, money, money_mod, in_pool)
  poke.addPokemon {
    name = name,
    rarity = 1,
    cost = 5,
    stage = 'Other',
    blueprint_compat = false,
    config = { money = money, money_mod = money_mod },
    attributes = { 'skip', 'economy', 'boss_blind', 'scaling' },
    vars = function(get) return { get('money'), get('money_mod') } end,
    triggers = {
      onBlindSkipped = function(card, state, step, result)
        if step.copiedBy then return end
        poke.add(card, 'money', poke.get(card, 'money_mod'))
        result:say('+$' .. poke.text.num(poke.get(card, 'money_mod')), colors.MONEY)
      end,
      afterRound = function(card, state, step, result)
        if step.copiedBy or not (state.blind and state.blind.boss) then return end
        set_run_flag(defeated_flag)
        poke.ease_poke_dollars(card, name, poke.get(card, 'money'), false, state)
        result:say(poke.text.dict('poke_smell_ya', 'Smell Ya Later!'), colors.ORANGE)
        result:destroySelf()
      end,
    },
    in_pool = in_pool,
  }
end

rival_def('rival', 'rival_defeated', 15, 10, function() return not run_flag('rival_defeated') end)
rival_def('bitter_rival', 'bitter_rival_defeated', 25, 20,
  function() return run_flag('rival_defeated') and not run_flag('bitter_rival_defeated') end)

poke.addPokemon {
  name = 'champion',
  rarity = 1,
  cost = 5,
  stage = 'Other',
  config = { Xmult_mod = 0.2 },
  attributes = { 'xmult', 'skip', 'boss_blind', 'tag', 'generation' },
  vars = function(get) return { get('Xmult_mod'), 1 + poke.blinds_skipped() * get('Xmult_mod') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = 1 + poke.blinds_skipped() * poke.get(card, 'Xmult_mod')
      if x > 1 then result:add(xMult(x)) end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) then return end
      cardlike.addPin('pin_18')
      result:say('+1 Pin', colors.ORANGE)
    end,
  },
  in_pool = function() return run_flag('bitter_rival_defeated') end,
}

---------------------------------------------------------------------------
-- Ruins of Alph: makes 3 Inverted Unown each blind, merges Unown that triggered, and gives a reward when sold.
---------------------------------------------------------------------------

-- A random Safari Pokemon that may appear (Balatro SMODS.add_card with rarity poke_safari).
local function random_safari_id(state)
  local list = {}
  for _, def in ipairs(poke.pokemon_list) do
    if def.poke_rarity == 'poke_safari' and not def.hidden and poke.get_gen_allowed(def)
        and not poke.family_present(def, state) and (not def.in_pool or def.in_pool(state) ~= false) then
      list[#list + 1] = def.id
    end
  end
  return poke.random_element(list, state)
end

poke.addPokemon {
  name = 'ruins_of_alph',
  rarity = 3,
  cost = 8,
  stage = 'Other',
  config = { mult = 0, mult_mod = 2, merged = 0, forms = {}, quest1 = 5, quest2 = 10, quest3 = 20, quest4 = 28 },
  attributes = { 'joker', 'generation', 'mult', 'scaling' },
  vars = function(get) return { get('mult_mod'), get('merged'), get('mult') } end,
  text = function(get, card, state, vars)
    local entry = poke.text.entry('Joker', 'j_poke_ruins_of_alph')
    local base = entry and poke.text.format(entry.text, vars) or ''
    local rewards = poke.text.describe('Other', 'rewards_ruins_of_alph', { get('quest1'), get('quest2'), get('quest3'), get('quest4') })
    return base .. '\n' .. colorize('Rewards when sold:', colors.GREY) .. '\n' .. rewards
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    -- Unown that triggered this hand merge (the original did this after the hand; Unown leaves after the hand).
    finalScoring = function(card, state, step, result)
      if step.copiedBy then return end
      local added = false
      local forms = poke.get(card, 'forms') or {}
      for _, j in ipairs(state.jokers or {}) do
        if poke.name(j) == 'unown' and poke.get(j, poke.UNOWN.triggered) and not poke.get(j, poke.UNOWN.merged) then
          poke.add(card, 'mult', poke.get(card, 'mult_mod'))
          poke.add(card, 'merged', 1)
          poke.set(j, poke.UNOWN.merged, true)
          local form = poke.get(j, poke.UNOWN.form)
          if form ~= nil then forms[#forms + 1] = form end
          added = true
        end
      end
      if added then
        table.sort(forms, function(a, b) return tostring(a) < tostring(b) end)
        poke.set(card, 'forms', forms)
        card:popup('Merged!', colors.MULT)
      end
    end,
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      for _ = 1, 3 do cardlike.createJoker(poke.id('unown'), { edition = 'Inverted' }) end
    end,
    onSold = function(card, state, step, result)
      local merged = poke.get(card, 'merged')
      if merged >= poke.get(card, 'quest4') then
        cardlike.createJoker(poke.id('unown_swarm'), { force = true })
        local soul = cardlike.createConsumable('admin_card_17', { force = true })
        if soul then soul:popup('+1 Admin Card', '#4584fa') end
      elseif merged >= poke.get(card, 'quest3') then
        cardlike.createJoker('joker_left_cat', { force = true })
      elseif merged >= poke.get(card, 'quest2') then
        local others = {}
        for _, j in ipairs(state.jokers or {}) do if j ~= card then others[#others + 1] = j end end
        if #others > 0 then
          result:say('Duplicated!', colors.ORANGE)
          local chosen = poke.random_element(others, state)
          local copy = chosen:copy()
          if copy and chosen:getEdition() == 'Inverted' then copy:setEdition('default') end
        else
          result:say('No other Jokers', colors.GREY)
        end
      elseif merged >= poke.get(card, 'quest1') then
        local id = random_safari_id(state)
        if id then cardlike.createJoker(id, { force = true }) end
      end
    end,
  },
}

-- A copy of the Ruins of Alph starts with no merged Unown (original lovely patch on copy_card).
cardlike.on('onCardCopied', function(state, step)
  local c = step and step.card
  if c and c.uid and poke.name(c) == 'ruins_of_alph' then
    poke.set(c, 'merged', 0)
    poke.set(c, 'forms', {})
  end
end)

---------------------------------------------------------------------------
-- Unown Swarm: each Legendary joker gives +28 Mult and X2.8 Mult. Only from the Ruins of Alph.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'unown_swarm',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Other',
  ptype = 'Psychic',
  config = { mult = 28, Xmult_multi = 2.8 },
  attributes = { 'joker', 'xmult', 'mult' },
  sprite = poke.sprites.at('unown_swarm', 0, 0),
  layerSprite = poke.sprites.at('unown_swarm', 1, 0),
  vars = function(get) return { get('mult'), get('Xmult_multi') } end,
  triggers = {
    onOtherJoker = function(card, state, step, result)
      local other = step.other
      local rarity = other and ((other.lastInfo or {}).rarity or other:getRarity())
      if rarity ~= 'Legendary' then return end
      other:punch()
      result:say(poke.text.dict('poke_hidden_power_ex', 'Hidden Power!'), colors.MULT)
      result:add(plusMult(poke.get(card, 'mult')))
      result:add(xMult(poke.get(card, 'Xmult_multi')))
    end,
  },
  in_pool = function() return false end,
}

---------------------------------------------------------------------------
-- Professor and Imposter Professor: after 2 rounds, sell for a Starter Pin (and a Pokedex).
---------------------------------------------------------------------------

-- The Starter Pack can offer something: every starter group still has a Pokemon that may appear.
local function starters_available(state, knockoff)
  local grass, fire, water, pseudo, extra
  for _, def in ipairs(poke.pokemon_list) do
    if def.stage and def.stage ~= 'Other' and not poke.family_present(def, state) then
      local starter = knockoff and def.knockoff_starter or (not knockoff and def.starter)
      if starter and def.ptype == 'Grass' then grass = true end
      if starter and def.ptype == 'Fire' then fire = true end
      if starter and def.ptype == 'Water' then water = true end
      if (knockoff and def.knockoff_pseudol) or (not knockoff and def.pseudol) then pseudo = true end
      if knockoff and (def.name == 'yamper' or def.name == 'bidoof') then extra = true end
      if not knockoff and (def.name == 'pikachu' or def.name == 'eevee') then extra = true end
      if grass and fire and water and pseudo and extra then return true end
    end
  end
  return false
end

poke.addPokemon {
  name = 'professor',
  rarity = 1,
  cost = 6,
  stage = 'Other',
  blueprint_compat = false,
  config = { rounds_total = 2, rounds_current = 0 },
  attributes = { 'tag', 'generation', 'on_sell' },
  vars = function(get) return { get('rounds_total'), get('rounds_current') } end,
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      round_counter(card, result)
    end,
    onSold = function(card, state, step, result)
      if poke.get(card, 'rounds_current') >= poke.get(card, 'rounds_total') then
        cardlike.addPin(poke.MOD_ID .. ':starter_tag')
      end
    end,
  },
  in_pool = function(state) return starters_available(state or cardlike.state, false) end,
}

-- The original shows the real Professor's art in the shop and its own art once bought. Cardlike cannot change a
-- card's art, so it keeps the disguise.
poke.addPokemon {
  name = 'imposter_professor',
  rarity = 2,
  cost = 5,
  stage = 'Other',
  blueprint_compat = false,
  config = { rounds_total = 2, rounds_current = 0, form = 0 },
  attributes = { 'tag', 'generation', 'on_sell' },
  vars = function(get) return { get('rounds_total'), get('rounds_current') } end,
  onAdded = function(card, state) poke.set(card, 'form', 1) end,
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      round_counter(card, result)
    end,
    onSold = function(card, state, step, result)
      if poke.get(card, 'rounds_current') < poke.get(card, 'rounds_total') then return end
      cardlike.playSound('timpani')
      local dex = cardlike.createJoker(poke.id('pokedex'), { force = true, sticker = 'subscription' })
      if dex then
        dex:setSticker('subscription')
        dex:popup('+1 Joker', colors.CHIPS)
      end
      cardlike.addPin(poke.MOD_ID .. ':starterq_tag')
    end,
  },
  in_pool = function(state) return starters_available(state or cardlike.state, true) end,
}

---------------------------------------------------------------------------
-- Oologist: after 3 rounds, sell for an Inverted Mystery Egg, and one more for every 3 more rounds.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'oologist',
  rarity = 2,
  cost = 7,
  stage = 'Other',
  blueprint_compat = false,
  config = { rounds_total = 3, rounds_current = 0 },
  attributes = { 'joker', 'generation' },
  vars = function(get) return { get('rounds_total'), get('rounds_current') } end,
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy then return end
      round_counter(card, result)
    end,
    onSold = function(card, state, step, result)
      local total, current = poke.get(card, 'rounds_total'), poke.get(card, 'rounds_current')
      if current < total then return end
      for _ = 1, math.floor(current / total) do
        cardlike.createJoker(poke.id('mystery_egg'), { edition = 'Inverted' })
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Daycare: sell it next to two Pokemon to get a Mystery Egg of the first form of one of them.
---------------------------------------------------------------------------
local function breedable(j)
  local def = poke.def(j)
  if not def or not def.stage or def.stage == 'Other' or def.stage == 'Baby' then return false end
  local lowest = poke.def(poke.get_lowest_evo(j))
  return not (lowest and lowest.stage == 'Legendary')
end

poke.addPokemon {
  name = 'daycare',
  rarity = 3,
  cost = 8,
  stage = 'Other',
  blueprint_compat = false,
  attributes = { 'joker', 'generation', 'on_sell' },
  triggers = {
    onSold = function(card, state, step, result)
      local adjacent = poke.get_adjacent_jokers(card, state)
      local count = 0
      for _, j in ipairs(adjacent) do if breedable(j) then count = count + 1 end end
      if count < 2 then return end
      local parent = poke.random_element(adjacent, state)
      local lowest = parent and poke.get_lowest_evo(parent)
      if type(lowest) ~= 'string' then return end
      local egg = cardlike.createJoker(poke.id('mystery_egg'), { force = true })
      if egg then
        poke.set(egg, 'key', poke.id(lowest))
        poke.set(egg, 'rounds', 3)
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Rage Candy Bar: the first hand of each round destroys the top 2 cards of your deck, for 3 hands.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'rage_candy_bar',
  rarity = 2,
  cost = 6,
  stage = 'Other',
  blueprint_compat = false,
  config = { hands = 3 },
  attributes = { 'destroy_card', 'food' },
  sprite = poke.sprites.at('placeholder_joker', 0, 0),
  vars = function(get) return { get('hands') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'first_hand', true) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not poke.get(card, 'first_hand') then return end
      poke.set(card, 'first_hand', false)
      local left = poke.add(card, 'hands', -1)
      -- the game draws from the end of the undrawn list
      local deck = state.unDrawnCards or {}
      for i = #deck, math.max(1, #deck - 1), -1 do deck[i]:destroy() end
      if left <= 0 then
        result:say('Eaten!', colors.MULT)
        result:destroySelf()
      else
        result:say('Crunch!', colors.MULT)
      end
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'first_hand', false) end
    end,
  },
}

---------------------------------------------------------------------------
-- Repel: sell it to disable the boss blind and get a Discount Pin. Not in the original's joker list, so it never
-- appears in the shop or packs.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'repel',
  rarity = 2,
  cost = 6,
  stage = 'Other',
  blueprint_compat = false,
  attributes = { 'tag', 'generation', 'boss_blind', 'on_sell' },
  sprite = poke.sprites.at('placeholder_joker', 0, 0),
  triggers = {
    onSold = function(card, state, step, result)
      if state.blind and state.blind.boss and not state.bossDisabled and (state:isPhase('play') or state:isPhase('scoring')) then
        state:disableBoss()
        result:say('Boss Disabled', colors.ORANGE)
      end
      cardlike.addPin('pin_23')
    end,
  },
  in_pool = function() return false end,
}


== file jokers/zzzapril_fools.lua (218 lines)
-- Joke jokers (original file pokemon/zzzapril_fools.lua). Like the original, they exist only with the setting
-- "Joke content" (poke.settings.pokemon_aprilfools) on.
local poke = cardlike.require('lib.pokermon')

if not poke.settings.pokemon_aprilfools then return end

local HAZARD = poke.HAZARD_ID

local function is_hazard(c) return poke.has_enhancement(c, HAZARD) end

---------------------------------------------------------------------------
-- A Billion Lions: when a blind is picked, destroys every other joker with a type and gains X1 Mult for each.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'billion_lions',
  rarity = 4,
  cost = 6,
  stage = 'Legendary',
  gen = 9,
  config = { Xmult = 1, Xmult_mod = 1, lions = 1000000000 },
  vars = function(get) return { get('Xmult'), get('Xmult_mod'), get('lions') } end,
  triggers = {
    beforeRound = function(card, state, step, result)
      if step.copiedBy then return end
      local destroyed = 0
      for _, j in ipairs(state.jokers or {}) do
        if j ~= card and poke.get_type(j) and not j:isLocked() then
          destroyed = destroyed + 1
          j:destroy()
        end
      end
      if destroyed == 0 then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod') * destroyed)
      local lions = poke.add(card, 'lions', -destroyed)
      card:punch()
      if lions <= 0 then
        result:say('They lose!', colors.MULT)
        result:destroySelf()
      else
        result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

---------------------------------------------------------------------------
-- Ludicolo (Miror B.): adds itself to your deck as a Ludicolo card.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'miror_budicolo',
  rarity = 1,
  cost = 1,
  stage = 'Basic',
  ptype = 'Water',
  gen = 3,
  blueprint_compat = false,
  sprite = poke.sprites.at('miror_budicolo', 0, 0),
  onAdded = function(card, state)
    cardlike.addPlayingCard({ enhancement = poke.MOD_ID .. ':ludicolo' })
    card:destroy()
  end,
}

---------------------------------------------------------------------------
-- Spiclops: hazards, hand size, stamps and Fruit cards.
---------------------------------------------------------------------------

poke.addPokemon {
  name = 'spiclops',
  rarity = 2,
  cost = 10,
  stage = 'Legendary',
  config = { hazard_level = 1, h_size = 4, card_goal = 8, cards_added = 0, planet_goal = 2, hazards_drawn = 0 },
  vars = function(get)
    return { get('hazard_level'), get('h_size'), get('card_goal'), get('cards_added'), get('planet_goal'), get('hazards_drawn') }
  end,
  passives = { hand_size = 'h_size', hazard_level = 'hazard_level' },
  triggers = {
    -- Every 8th playing card added to the deck gets a random stamp.
    onCardsAdded = function(card, state, step, result)
      if step.copiedBy then return end
      for _, c in ipairs(step.cards or {}) do
        local n = poke.add(card, 'cards_added', 1)
        if n >= poke.get(card, 'card_goal') then
          result:say(poke.text.dict('poke_sticky_web_ex', 'Sticky Web!'), colors.ORANGE)
          c:setStamp(poke.random_stamp(state))
          poke.set(card, 'cards_added', 0)
        end
      end
    end,
    -- Blind picked: +hand size equal to the hazard level for this round, -1 discard.
    beforeRound = function(card, state, step, result)
      state.discardsLeft = math.max(0, state.discardsLeft - 1)
      local level = poke.get_hazard_level_vars()[1]
      if level > 0 then state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + level end
      result:say('+' .. level .. ' Hand Size', colors.ORANGE)
      if not step.copiedBy then poke.set(card, 'first_hand', true) end
    end,
    -- First hand all Hazard cards: +1 hand size this round for each scoring card.
    afterAllCardsScored = function(card, state, step, result)
      if step.copiedBy or not poke.get(card, 'first_hand') then return end
      poke.set(card, 'first_hand', false)
      local cards = step.hand.allCards or {}
      if #cards == 0 then return end
      for _, c in ipairs(cards) do if not is_hazard(c) then return end end
      local up = #step.hand.playedCards
      state.extraEphemeralHandSize = (state.extraEphemeralHandSize or 0) + up
      result:say('+' .. up .. ' Hand Size', colors.ORANGE)
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'first_hand', false) end
    end,
    -- End of round: every third Hazard card held in hand gets a Fruit Stamp.
    afterRound = function(card, state, step, result)
      local count = 0
      for _, c in ipairs(state.cardsInHand or {}) do
        if is_hazard(c) then
          count = count + 1
          if count % 3 == 0 then c:setStamp('Fruit Stamp') end
        end
      end
    end,
    -- For every 2 Hazard cards drawn, a Fruit card of your most played hand.
    onHandDrawn = function(card, state, step, result)
      local count = 0
      for _, c in ipairs(state.cardsInHand or {}) do if is_hazard(c) then count = count + 1 end end
      if count == 0 then return end
      if not step.copiedBy then poke.add(card, 'hazards_drawn', count) end
      local drawn, goal = poke.get(card, 'hazards_drawn'), poke.get(card, 'planet_goal')
      if drawn < goal or (state.freeConsumableSlots or 0) <= 0 then return end
      local n = math.floor(drawn / goal)
      poke.set(card, 'hazards_drawn', drawn % goal)
      local fruit = poke.FRUIT_OF_HAND[state.mostPlayedHand or ''] or 'fruit'
      for _ = 1, n do
        if (state.freeConsumableSlots or 0) <= 0 then break end
        if cardlike.createConsumable(fruit) then result:say('+1 Fruit Card', '#13afce') end
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Capture Disc: gains +1 Mult when shaken (dragged around), resets at the end of the round.
---------------------------------------------------------------------------

-- Shake distance needed for the next +Mult: the original needs 25 x Mult table units; a card is about 2.1 units
-- wide, so in screen pixels that is about 12 card widths x Mult.
local SHAKE_WIDTHS = 25 / 2.1
local drag = {} -- uid -> { x, y, dist }

poke.addPokemon {
  name = 'capture_disc',
  rarity = 1,
  cost = 4,
  stage = 'Other',
  config = { mult_mod = 1, mult = 0 },
  sprite = poke.sprites.at('capture_disc', 0, 0),
  vars = function(get) return { get('mult_mod'), get('mult') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy or poke.get(card, 'mult') <= 0 then return end
      poke.set(card, 'mult', 0)
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Cardlike has no drag event: while the left button is held, follow the Capture Disc on screen and add up how far
-- it moves.
cardlike.onFrame(function(frame)
  if not frame.inRun then
    drag = {}
    return
  end
  local held = false
  for _, b in pairs(frame.mouse and frame.mouse.buttons or {}) do if b == 1 or b == true then held = true end end
  local id = poke.id('capture_disc')
  local seen = {}
  for _, j in ipairs(cardlike.state.jokers or {}) do
    if j:getJokerDef() == id then
      seen[j.uid] = true
      local rect = held and j:screenRect() or nil
      local m = frame.mouse or {}
      -- only while the pointer holds this card (a dragged card follows the pointer)
      if rect and not (m.x and m.y and m.x >= rect.x and m.x <= rect.x + rect.width and m.y >= rect.y and m.y <= rect.y + rect.height) then
        rect = nil
      end
      if not rect then
        drag[j.uid] = nil
      else
        local d = drag[j.uid]
        if d then
          d.dist = d.dist + math.sqrt((rect.x - d.x) ^ 2 + (rect.y - d.y) ^ 2)
          d.x, d.y = rect.x, rect.y
          local need = SHAKE_WIDTHS * rect.width * poke.get(j, 'mult')
          if d.dist > need then
            d.dist = 0
            local mod = poke.get(j, 'mult_mod')
            poke.add(j, 'mult', mod)
            j:popup('+' .. poke.text.num(mod) .. ' Mult', colors.MULT)
          end
        else
          drag[j.uid] = { x = rect.x, y = rect.y, dist = 0 }
        end
      end
    end
  end
  for uid in pairs(drag) do if not seen[uid] then drag[uid] = nil end end
end)


