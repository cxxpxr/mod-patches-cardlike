poke.addPokemon {
  name = 'porygon2', rarity = 'poke_safari', cost = 8, stage = 'One', ptype = 'Colorless', gen = 2,
  item_req = 'dubious_disc',
  attributes = { 'energy_limit', 'generation', 'energy', 'types', 'item_evo' },
