}

-- Dusknoir 477
-- Admin (Spectral) cards may appear in the shop: Cardlike has no shop weight for built-in card types, so each shop
-- card slot gets a spec_up / 30 chance (about the Balatro rate) to add an Admin card to the shop.
local function dusknoir_shop(card, state)
  local chance = poke.get(card, 'spec_up') / 30
  for _ = 1, state.cardsAvailableInShopCount or 2 do
    if state:randomFloat() < chance then
      local id = cardlike.randomConsumable('admin')
      if id then cardlike.addShopItem(id) end
    end
  end
end
poke.addPokemon {
  name = 'dusknoir',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'Two',
  ptype = 'Psychic',
  gen = 4,
  config = { retriggers = 1, spec_up = 2 },
  attributes = { 'hands', 'spectral', 'retrigger', 'passive' },
  vars = function(get) return { get('retriggers') } end,
  text = { 'Retrigger all scored cards', 'in {C:attention}final hand{} of round', '{br:2}x',
    '{C:spectral}Spectral{} cards may', 'appear in the shop', '{C:inactive}(Each shop slot has a small chance to add one){}' },
  triggers = {
    repeatCard = function(card, state, step, result)
      if state.handsLeft == 0 then return poke.get(card, 'retriggers') end
    end,
    onShopEnter = function(card, state, step, result)
      if not step.copiedBy then dusknoir_shop(card, state) end
    end,
    onShopReroll = function(card, state, step, result)
      if not step.copiedBy then dusknoir_shop(card, state) end
    end,
  },
}

-- Froslass 478: go up to -$15 in debt (config debt: the library debt hook, lib/rules.lua). Creates an Item when a hand is played
-- while in debt.
poke.addPokemon {
