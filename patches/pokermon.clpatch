      if step.copiedBy or not poke.get(card, 'active') or not poke.has_enhancement(step.card, 'm_stone') then return end
      poke.set(card, 'active', false)
      poke.add(card, 'stones_destroyed', 1)
      card:popup(poke.text.dict('poke_drill_ex', 'Drill!'), poke.colours.earth)
      poke.create_treasure(card, state)
      return true
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'active', true) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'excadrill', poke.get(card, 'stones_destroyed'), 4)
  end,
}

-- Excadrill 530: played Rock cards are destroyed and create Treasure. +2 Mult for each card below the starting deck size.
poke.addPokemon {
  name = 'excadrill',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Earth',
  gen = 5,
  config = { mult_mod = 2 },
  attributes = { 'enhancements', 'destroy_card', 'generation', 'item', 'economy', 'full_deck', 'mult' },
  vars = function(get, card, state)
    local start = poke.starting_deck_size()
    local now = state and state.deckSize or start
    return { get('mult_mod'), start, math.max(0, get('mult_mod') * (start - now)) }
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local mult = math.max(0, poke.get(card, 'mult_mod') * (poke.starting_deck_size() - poke.deck_size(state)))
      if mult > 0 then result:add(plusMult(mult)) end
    end,
    destroyCard = function(card, state, step, result)
      if step.copiedBy or not poke.has_enhancement(step.card, 'm_stone') then return end
      card:popup(poke.text.dict('poke_drill_ex', 'Drill!'), poke.colours.earth)
      poke.create_treasure(card, state, true)
      return true
    end,
  },
}


