  config = { mult_mod = 13, num = 1, dem = 2 },
  vars = function(get, card, state)
    return { get('mult_mod'), poke.chance_num(get('num'), state), get('dem') }
  end,
  triggers = {
    -- Energy Drink Pin is Cardlike's Speed Tag.
    beforeRound = function(card, state, step, result)
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        cardlike.addPin('pin_18')
        result:say('+1 Pin', colors.GREEN)
      end
    end,
    -- The first hand of the round (Cardlike counts the hand when Play is pressed).
    onScore = function(card, state, step, result)
      if (state.handsPlayed or 0) <= 1 and poke.rank_is(step.card, 9, 11) then
        result:add(plusMult(poke.get(card, 'mult_mod')))
      end
    end,
  },
}

-- Shedinja 292
poke.addPokemon {
  name = 'shedinja', rarity = 'poke_safari', cost = 8, stage = '???', ptype = 'Psychic', gen = 3,
  config = { Xmult = 1, Xmult_mod = 0.5 },
  vars = function(get) return { get('Xmult'), get('Xmult_mod') } end,
  -- Cardlike has no way to prevent a loss, so the "Prevents Death" part (and its X Mult gain) is left out of the text.
  text = function(get, card, state, vars)
    local lines = poke.text.entry('Joker', 'j_poke_shedinja').text
    local keep = { '{X:mult,C:white}X#1#{} Mult' }
    for i = 6, #lines do keep[#keep + 1] = lines[i] end
    return poke.text.format(keep, vars)
  end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x > 1 then result:add(xMult(x)) end
    end,
    -- Self destructs at the end of the shop with a Fire, Earth, Dark or Psychic joker (other Shedinjas do not count).
    onShopExit = function(card, state, step, result)
      if step.copiedBy then return end
      for _, t in ipairs({ 'Fire', 'Earth', 'Dark', 'Psychic' }) do
        if #poke.find_pokemon_type(t, nil, 'shedinja', state) > 0 then
          card:popup(poke.text.dict('poke_screech_ex', 'Screech!'), colors.MULT)
          card:destroy()
          return
        end
      end
    end,
  },
}

