-- Magmar 126
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'magmar', rarity = 3, cost = 7, stage = 'Basic', ptype = 'Fire', gen = 1,
  item_req = 'linkcable',
  config = { mult = 0, mult_mod = 2 },
  vars = function(get) return { get('mult'), get('mult_mod') } end,
  attributes = { 'discard', 'destroy_card', 'mult', 'scaling', 'item_evo' },
  triggers = {
    onDiscardCard = function(card, state, step, result)
      -- discardsUsed already counts this discard
      if step.copiedBy or state.discardsUsed ~= 1 or #(step.discardedCards or {}) ~= 1 then return end
      poke.add(card, 'mult', poke.get(card, 'mult_mod'))
      result:say('+' .. poke.text.num(poke.get(card, 'mult_mod')) .. ' Mult', colors.MULT)
      return true
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult = poke.get(card, 'mult')
      if mult > 0 then result:add(plusMult(mult)) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'magmortar') end,
}

---------------------------------------------------------------------------
-- Pinsir 127
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'pinsir', rarity = 2, cost = 6, stage = 'Basic', ptype = 'Grass', gen = 1,
  config = { Xmult = 2 },
  vars = function(get) return { get('Xmult') } end,
  megas = { 'mega_pinsir' },
  attributes = { 'xmult', 'rank' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local ranks = {}
      for _, c in ipairs(step.hand.playedCards or {}) do
        local r = poke.rank_of(c)
        if r then ranks[r] = true end
      end
      for _, c in ipairs(step.held or state.cardsInHand or {}) do
        local r = poke.rank_of(c)
        if r and ranks[r] then
          result:add(xMult(poke.get(card, 'Xmult')))
          return
        end
      end
    end,
  },
}

poke.addPokemon {
  name = 'mega_pinsir', rarity = 'poke_mega', cost = 12, stage = 'Mega', ptype = 'Grass', gen = 1,
  config = { Xmult_multi = 2 },
  vars = function(get) return { get('Xmult_multi') } end,
  attributes = { 'xmult', 'enhancements' },
  triggers = {
    onScore = function(card, state, step, result)
      if step.card:getEnhancement() == 'Default' then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
}

