-- Pokemon jokers 391-420 (Bidoof ... Floatzel). Port of pokejokers_14.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Free rerolls (Bidoof, Bibarel): "N free Rerolls per shop".
-- Cardlike sets the reroll price when the shop opens, after the onShopEnter event, so the first frame of a new shop
-- sets the price to $0 while free rerolls are left. A free reroll does not raise the price: after the last free one,
-- the price goes back to what it was when the shop opened.
---------------------------------------------------------------------------

local FREE_REROLL = { bidoof = true, bibarel = true }
local free = { pending = false, base = nil, used = 0, zeroed = false }

local function free_total(state)
  local n = 0
  for _, j in ipairs((state and state.jokers) or {}) do
    if FREE_REROLL[poke.name(j) or ''] and not (j.lastInfo or {}).debuffed then
      n = n + (tonumber(poke.get(j, 'rerolls', 0)) or 0)
    end
  end
  return math.floor(n)
end

local function apply_free(state)
  if not free.base or not state or not state:isPhase('shop') then return end
  if free_total(state) - free.used > 0 then
    free.zeroed = true
    state.rerollCost = 0
  elseif free.zeroed then
    free.zeroed = false
    state.rerollCost = free.base
  end
end

cardlike.on('onShopEnter', function(state)
  free.pending, free.base, free.used, free.zeroed = true, nil, 0, false
end)
cardlike.on('onShopExit', function(state)
  free.pending, free.base, free.zeroed = false, nil, false
end)
cardlike.on('onShopReroll', function(state, step)
  if not free.base then return end
  if free.zeroed then
    free.used = free.used + 1
    free.zeroed = false
    -- the game raised the price from $0; a free reroll keeps the price of the shop
    state.rerollCost = free.base
  end
  apply_free(state)
end)
cardlike.onFrame(function(frame)
  if not free.pending or not frame.inRun then return end
  local state = cardlike.state
  if not state:isPhase('shop') then return end
  free.pending = false
  free.base = state.rerollCost
  apply_free(state)
end)

---------------------------------------------------------------------------

-- Bidoof 399: 1 free reroll per shop. Evolves after rerolling 7 times.
poke.addPokemon {
  name = 'bidoof',
  rarity = 1,
  cost = 5,
  stage = 'Basic',
  ptype = 'Colorless',
  gen = 4,
  config = { rerolls = 1, rerolls_to_evolve = 7 },
  evo_rqmt = 7,
  attributes = { 'economy', 'passive', 'condition_evo' },
  vars = function(get) return { get('rerolls'), get('rerolls_to_evolve') } end,
  onAdded = function(card, state) apply_free(state) end,
  onRemoved = function(card, state) apply_free(state) end,
  triggers = {
    onShopReroll = function(card, state, step, result)
      if not step.copiedBy and poke.get(card, 'rerolls_to_evolve') > 0 then poke.add(card, 'rerolls_to_evolve', -1) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'bibarel', 7 - poke.get(card, 'rerolls_to_evolve'), 7)
  end,
}

-- Bibarel 400: 1 free reroll per shop. Free rerolls go up by 1 when a Boss Blind is beaten.
poke.addPokemon {
  name = 'bibarel',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Colorless',
  gen = 4,
  config = { rerolls = 1, increase = 1 },
  attributes = { 'economy', 'passive', 'boss_blind' },
  vars = function(get)
    return { get('rerolls'), get('increase'), get('rerolls') > 1 and poke.text.dict('poke_reroll_plural', 'Rerolls')
      or poke.text.dict('poke_reroll_singular', 'Reroll') }
  end,
  onAdded = function(card, state) apply_free(state) end,
  onRemoved = function(card, state) apply_free(state) end,
  triggers = {
    afterRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind or {}).boss then return end
      poke.add(card, 'rerolls', poke.get(card, 'increase'))
      result:say('Upgrade!', colors.GREEN)
    end,
  },
}

-- The Kricketot line: money when the played hand is exactly 4 cards of 4 different suits.
local function four_suits(step)
  local cards = step.hand.allCards or {}
  return #cards == 4 and poke.suit_check(cards, 4)
end

-- Kricketot 401: earn $4 if the played hand is exactly 4 cards of 4 different suits. Evolves after 4 rounds.
poke.addPokemon {
  name = 'kricketot',
  rarity = 1,
  cost = 4,
  stage = 'Basic',
  ptype = 'Grass',
  gen = 4,
  config = { money = 4, rounds = 4 },
  attributes = { 'economy', 'suit', 'round_evo' },
  vars = function(get) return { get('money'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if four_suits(step) then result:add(plusMoney(poke.ease_poke_dollars(card, 'kriketot', poke.get(card, 'money'), true, state))) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'kricketune') end,
}

-- Kricketune 402: earn $4 if the played hand is exactly 4 cards of 4 different suits, with a 1 in 2 chance to also
-- create a Game card (Tarot card).
poke.addPokemon {
  name = 'kricketune',
  rarity = 'poke_safari',
  cost = 6,
  stage = 'One',
  ptype = 'Grass',
  gen = 4,
  config = { money = 4, num = 1, dem = 2 },
  attributes = { 'economy', 'suit', 'chance', 'tarot', 'generation' },
  vars = function(get, card, state) return { get('money'), poke.chance_num(get('num'), state), get('dem') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not four_suits(step) then return end
      result:add(plusMoney(poke.ease_poke_dollars(card, 'kriketune', poke.get(card, 'money'), true, state)))
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) and (state.freeConsumableSlots or 0) > 0 then
        poke.create_consumeable({ set = 'game' }, card)
      end
    end,
  },
}

-- Budew 406: Baby, X0.75 Mult. Creates an Inverted Miracle Seed at the end of the round. Evolves after 2 rounds.
poke.addPokemon {
  name = 'budew',
  rarity = 1,
  cost = 3,
  stage = 'Baby',
  ptype = 'Grass',
  gen = 4,
  config = { Xmult_minus = 0.75, rounds = 2 },
  attributes = { 'baby', 'item', 'generation', 'round_evo' },
  vars = function(get) return { get('Xmult_minus'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      poke.create_consumeable({ key = 'miracleseed', edition = 'e_negative' }, card)
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'roselia') end,
}

-- Roserade 407: if the first scoring card is odd, retrigger it 2 times. Flower cards need only 3+ suits (checked by
-- the Flower enhancement in content/enhancements.lua).
poke.addPokemon {
  name = 'roserade',
  rarity = 'poke_safari',
  cost = 9,
  stage = 'One',
  ptype = 'Grass',
  gen = 4,
  config = { retriggers = 2 },
  attributes = { 'rank', 'ace', 'three', 'five', 'seven', 'nine', 'retrigger', 'enhancements' },
  vars = function(get) return { get('retriggers') } end,
  triggers = {
    repeatCard = function(card, state, step, result)
      local first = (step.hand.playedCards or {})[1]
      if first and step.card == first and poke.is_odd(step.card) then return poke.get(card, 'retriggers') end
    end,
  },
}

-- The Buizel line: Points for each unscored card in the played hand.
local function unscored_chips(card, step, result)
  local chips = poke.get(card, 'chips') * #poke.unscored_cards(step.hand)
  if chips > 0 then result:add(plusChips(chips)) end
end

-- Buizel 418: +30 Points for each unscored card in the played hand. Evolves after 4 rounds.
poke.addPokemon {
  name = 'buizel',
