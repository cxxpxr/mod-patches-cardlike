  config = { num = 1, dem = 3 },
  attributes = { 'chance', 'rank', 'nine', 'tarot', 'generation', 'item_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { num, dem }
  end,
  triggers = { onScore = nine_makes_game_card },
  evolution = function(card, state) return poke.item_evo(card, state, 'ninetales') end,
}

