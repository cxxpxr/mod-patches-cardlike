poke.addPokemon {
  name = 'sneasel', rarity = 2, cost = 7, stage = 'Basic', ptype = 'Dark', gen = 2,
  item_req = 'duskstone',
  blueprint_compat = false,
  config = { money = 4 },
  attributes = { 'rank', 'destroy_card', 'economy', 'item_evo' },
  vars = function(get) return { poke.round_rank('sneaselcard'), get('money') } end,
  triggers = {
    finalScoring = function(card, state, step, result)
      if step.copiedBy then return end
      local all = step.hand.allCards or {}
      if #all ~= 1 or poke.rank_of(all[1]) ~= poke.round_rank_id('sneaselcard') then return end
      poke.set(card, 'sneasel_target', all[1].uid)
      card:punch()
      result:add(plusMoney(poke.ease_poke_dollars(card, 'sneasel', poke.get(card, 'money'), true, state)))
    end,
    destroyCard = function(card, state, step, result)
      if step.copiedBy then return end
      if step.card and poke.get(card, 'sneasel_target') == step.card.uid then
        card:getDataStore():delete('sneasel_target')
        return true
      end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'weavile') end,
}

