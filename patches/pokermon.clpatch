-- Stamps a random stamp can be (the Pokermon DNA stamp never rolls).
local RANDOM_STAMPS = { 'Replay Stamp', 'Cash Stamp', 'Fruit Stamp', 'Game Stamp', 'pokermon:pink_seal', 'pokermon:silver' }

poke.addPokemon {
  name = 'articuno', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Water', gen = 1,
  blueprint_compat = false,
  config = {},
  attributes = { 'modify_card', 'seals', 'editions' },
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local target = (step.hand.playedCards or {})[1]
      if not target then return end
      target:setEdition('Luna')
      target:setStamp(poke.random_stamp(state, RANDOM_STAMPS))
      target:punch()
    end,
  },
}

local function zapdos_xmult(card, state)
  local money = state and state.money or 0
  return 1 + poke.get(card, 'Xmult') * math.floor(money / poke.get(card, 'money_threshold'))
end

poke.addPokemon {
  name = 'zapdos', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Lightning', gen = 1,
  config = { Xmult = 0.08, money_threshold = 2 },
  vars = function(get, card, state) return { get('Xmult'), get('money_threshold'), card and zapdos_xmult(card, state) or 1 } end,
  attributes = { 'xmult' },
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local x = zapdos_xmult(card, state)
      if x > 1 then result:add(xMult(x)) end
    end,
  },
}

poke.addPokemon {
  name = 'moltres', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Fire', gen = 1,
  config = {},
  attributes = { 'discard', 'hand_type' },
  triggers = {
    onDiscard = function(card, state, step, result)
      -- discardsUsed already counts this discard
      if state.discardsUsed ~= 1 then return end
      local best = cardlike.evaluateHand(step.discardedCards or {})
      if best and best.handType then
        state:upgradeHand(best.handType, 3)
        result:say('Upgrade!', colors.ORANGE)
      end
    end,
  },
}

