    local c = C.sel(ctx)[1]
    local rank = c:getRank()
    cardlike.addPlayingCard({ rank = rank, suit = ctx.state:getRandomSuit(), enhancement = 'Gilded' }, { area = 'hand' })
    cardlike.addPlayingCard({ rank = rank, suit = ctx.state:getRandomSuit(), enhancement = 'Gilded' }, { area = 'deck' })
    c:destroy()
  end,
}

item {
