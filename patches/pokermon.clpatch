== file jokers/pokejokers_13.lua (680 lines)
-- Pokemon jokers 361-390 (Snorunt ... Deoxys). Port of pokejokers_13.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- "+N hand size while opening packs" (Clamperl, Huntail, Gorebyss). The hand size goes up when a pack opens.
-- Cardlike has no "pack closed" event, so the next frame outside the pack phase takes it back (and the round and
-- shop events do too, as a fallback).
---------------------------------------------------------------------------

local pack_open = false

local function pack_size_up(card, state)
  if poke.get(card, 'increased_handsize') then return end
  local n = poke.get(card, 'h_size', 0) or 0
  state.handSize = state.handSize + n
  poke.set(card, 'increased_handsize', n)
  pack_open = true
end

local function pack_size_down(card, state)
  local n = poke.get(card, 'increased_handsize')
  if not n then return end
  state.handSize = state.handSize - n
  card:getDataStore():delete('increased_handsize')
end

local function settle_pack_sizes(state)
  if not state or state.money == nil or state:isPhase('pack') then return end
  pack_open = false
  for _, j in ipairs(state.jokers or {}) do
    if (j.lastInfo and j.lastInfo.store or {}).increased_handsize ~= nil then pack_size_down(j, state) end
  end
end

cardlike.onFrame(function(frame)
  if pack_open and frame.inRun then settle_pack_sizes(cardlike.state) end
end)
for _, event in ipairs({ 'onRoundStart', 'onShopEnter', 'onShopExit' }) do
  cardlike.on(event, function(state) settle_pack_sizes(state) end)
end

local function is_game_or_item(card)
  local t = poke.consumable_type(card)
  return t == 'game' or t == poke.MOD_ID .. ':item'
end

---------------------------------------------------------------------------
-- Ancient ranks and depleted ranks (Relicanth)
---------------------------------------------------------------------------

--- Ranks (2 to Ace) that have no card left in the undrawn deck.
local function depleted_ranks(state)
  local have = {}
  for _, c in ipairs(state.unDrawnCards or {}) do
    local r = poke.rank_of(c)
    if r then have[r] = true end
  end
  local n = 0
  for r = 2, 14 do
    if not have[r] then n = n + 1 end
  end
  return n
end

-- Art of the Jirachi forms that have no entry in the sprite table: the Series A Gen 3 frames used by the wishes.
local function gen3_art(x, y)
  return poke.sprites.frame('AtlasJokersSeriesAGen03', x, y) or poke.sprites.frame('AtlasJokersBasicGen03', x, y)
end

---------------------------------------------------------------------------

-- Snorunt 361: go up to -$15 in debt (config debt: the library's debt hook, lib/rules.lua). Evolves into Glalie after 4 rounds that end in debt, or into Froslass with a
-- Dawn Stone.
poke.addPokemon {
  name = 'snorunt',
  rarity = 1,
  cost = 2,
  stage = 'Basic',
  ptype = 'Water',
  gen = 3,
  item_req = 'dawnstone',
  config = { debt = 15, rounds = 4 },
  attributes = { 'economy', 'round_evo', 'item_evo' },
  vars = function(get) return { get('debt'), get('rounds') } end,
  evolution = function(card, state)
    if poke.item_evo(card, state, 'froslass') then return true end
    if (state.money or 0) < 0 then return poke.level_evo(card, state, 'glalie') end
    return false
  end,
}

-- Glalie 362: go up to -$20 in debt. At the end of the round, sets money to $0.
poke.addPokemon {
  name = 'glalie',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Water',
  gen = 3,
  config = { debt = 20 },
  attributes = { 'economy' },
  vars = function(get) return { get('debt') } end,
  triggers = {
    afterRound = function(card, state, step, result)
      card:punch()
      if (state.money or 0) ~= 0 then state:setMoneyDirect(0) end
    end,
  },
}

-- Clamperl 366: holding a Key Cap Pin (Ethereal Tag). +4 hand size while opening packs. Evolves into Huntail after
-- selling a Linking Cord, or into Gorebyss when a Linking Cord is used on it.
poke.addPokemon {
  name = 'clamperl',
  rarity = 3,
  cost = 6,
  stage = 'Basic',
  ptype = 'Water',
  gen = 3,
  item_req = 'linkcable',
  blueprint_compat = false,
  config = { h_size = 4, link_sold = 0 },
  attributes = { 'holding', 'hand_size', 'item_evo', 'condition_evo' },
  vars = function(get) return { get('h_size') } end,
  onAdded = function(card, state)
    cardlike.addPin('pin_21')
    card:popup('+1 Pin', colors.ORANGE)
  end,
  onRemoved = function(card, state) pack_size_down(card, state) end,
  triggers = {
    onPackOpened = function(card, state, step, result)
      if not step.copiedBy then pack_size_up(card, state) end
    end,
    onCardSold = function(card, state, step, result)
      if step.copiedBy or not step.card then return end
      if (step.card.lastInfo or {}).consumable == poke.items.id('linkcable') then poke.add(card, 'link_sold', 1) end
    end,
  },
  evolution = function(card, state)
    if poke.item_evo(card, state, 'gorebyss') then return true end
    return poke.scaling_evo(card, state, 'huntail', poke.get(card, 'link_sold'), 1)
  end,
}

-- Huntail 367: +4 hand size while opening packs. Gains X0.1 Mult and destroys a random card held in hand when a
-- Game card or Item is sold while a pack is open.
poke.addPokemon {
  name = 'huntail',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Water',
  gen = 3,
  config = { h_size = 4, Xmult_mod = 0.1, Xmult = 1 },
  attributes = { 'hand_size', 'xmult', 'scaling', 'destroy_card', 'tarot', 'item' },
  vars = function(get) return { get('h_size'), get('Xmult_mod'), get('Xmult') } end,
  onRemoved = function(card, state) pack_size_down(card, state) end,
  triggers = {
    onPackOpened = function(card, state, step, result)
      if not step.copiedBy then pack_size_up(card, state) end
    end,
    onCardSold = function(card, state, step, result)
      if step.copiedBy or not state:isPhase('pack') or not is_game_or_item(step.card) then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      local held = state.cardsInHand or {}
      if #held > 0 then poke.remove_card(held[state:random(1, #held)], card) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

-- Gorebyss 368: +4 hand size while opening packs. Gains X0.15 Mult when a Game card or Item is used while a pack
-- is open.
poke.addPokemon {
  name = 'gorebyss',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Water',
  gen = 3,
  config = { h_size = 4, Xmult_mod = 0.15, Xmult = 1 },
  attributes = { 'hand_size', 'xmult', 'scaling', 'tarot', 'item' },
  vars = function(get) return { get('h_size'), get('Xmult_mod'), get('Xmult') } end,
  onRemoved = function(card, state) pack_size_down(card, state) end,
  triggers = {
    onPackOpened = function(card, state, step, result)
      if not step.copiedBy then pack_size_up(card, state) end
    end,
    onConsumableUsed = function(card, state, step, result)
      if step.copiedBy or not state:isPhase('pack') or not is_game_or_item(step.card) then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
    end,
    afterAllCardsScored = function(card, state, step, result)
      local x = poke.get(card, 'Xmult')
      if x ~= 1 then result:add(xMult(x)) end
    end,
  },
}

-- Relicanth 369: Ancient 4s. 1+: the last scored card gives +40 Points. 2+: it also earns $4. 3+: the bottom
-- non-4 card of the deck becomes a Rock card. 4+: X0.75 Mult for each depleted rank.
poke.addPokemon {
  name = 'relicanth',
  rarity = 3,
  cost = 6,
  stage = 'Basic',
  ptype = 'Earth',
  gen = 3,
  config = { rank = '4', chips = 40, money_mod = 4, Xmult_mod = 0.75, ancient_count = 0 },
  attributes = { 'ancient', 'rank', 'four', 'chips', 'modify_card', 'enhancements', 'economy', 'xmult', 'destroy_card' },
  vars = function(get, card, state)
    local depleted = (state and state.unDrawnCards) and depleted_ranks(state) or 0
    return { get('rank'), get('chips'), get('money_mod'), get('Xmult_mod'), math.max(1, 1 + get('Xmult_mod') * depleted) }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      local count = poke.get_ancient_amount(step.hand.playedCards, 4, card)
      if count > 2 then
        -- the bottom of the deck is the start of the undrawn list (the game draws from the end)
        for _, c in ipairs(state.unDrawnCards or {}) do
          local r = poke.rank_of(c)
          if r and r ~= 4 then
            c:setEnhancement('Rock')
            card:punch()
            break
          end
        end
      end
    end,
    onScore = function(card, state, step, result)
      local count = poke.get(card, 'ancient_count', 0) or 0
      if count < 1 then return end
      local scoring = step.hand.playedCards
      if step.card ~= scoring[#scoring] then return end
      result:add(plusChips(poke.get(card, 'chips')))
      if count > 1 then result:add(plusMoney(poke.ease_poke_dollars(card, 'relicanth', poke.get(card, 'money_mod'), true, state))) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      if (poke.get(card, 'ancient_count', 0) or 0) <= 3 then return end
      local depleted = depleted_ranks(state)
      if depleted > 0 then result:add(xMult(1 + poke.get(card, 'Xmult_mod') * depleted)) end
    end,
    afterHand = function(card, state, step, result)
      if not step.copiedBy then poke.set(card, 'ancient_count', 0) end
    end,
  },
}

-- Luvdisc 370: holding a Heart Scale. Applies Splash (Cardlike Rainbow): every played card scores.
poke.addPokemon {
  name = 'luvdisc',
  rarity = 1,
  cost = 4,
  stage = 'Basic',
  ptype = 'Water',
  gen = 3,
  blueprint_compat = false,
