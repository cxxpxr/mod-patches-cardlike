-- Pokermon jokers 661-690: Litleo, Pyroar.
local poke = cardlike.require('lib.pokermon')

local function has_flush(step)
  local c = step.hand and step.hand.contains or {}
  return c.FLUSH or c.STRAIGHT_FLUSH or c.ROYAL_FLUSH or c.FLUSH_HOUSE or c.FLUSH_FIVE
end

-- Litleo 667
poke.addPokemon {
  name = 'litleo', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Fire', gen = 6,
  config = { chips = 70, rounds = 4 },
  attributes = { 'chips', 'hand_type', 'round_evo' },
  vars = function(get) return { get('chips'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if has_flush(step) then result:add(plusChips(poke.get(card, 'chips'))) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'pyroar') end,
}

-- Pyroar 668: +Points with a Flush, and an Energy card when the Flush also scores a King or Queen.
poke.addPokemon {
  name = 'pyroar', rarity = 2, cost = 5, stage = 'One', ptype = 'Fire', gen = 6,
  config = { chips = 90 },
  attributes = { 'chips', 'hand_type', 'round_evo', 'energy', 'generation', 'rank', 'king', 'queen' },
  vars = function(get) return { get('chips') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      if not has_flush(step) then return end
      result:add(plusChips(poke.get(card, 'chips')))
      if state.freeConsumableSlots > 0 then
        for _, c in ipairs(step.hand.playedCards or {}) do
          local r = poke.rank_of(c)
          if r == 13 or r == 12 then
            poke.create_consumeable({ set = 'poke_energy' }, step.copiedBy or card)
            break
          end
        end
      end
    end,
  },
}


== file jokers/pokejokers_24.lua (159 lines)
-- Pokermon jokers 691-720: Sylveon, Pumpkaboo, Gourgeist.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- Pumpkaboo and Gourgeist come in four sizes. The size (form 0 to 3) sets how many Jacks they need and their art.
-- A card cannot change its own art, so each size is its own joker: the Average size keeps the plain name
-- ('pumpkaboo'), the other sizes are hidden jokers ('pumpkaboo_small', ...). A new Pumpkaboo rolls its size when it
-- joins your jokers and becomes that size's joker.
local SIZES = { 'small', 'average', 'large', 'super' }
local function size_def(species, form)
  if form == 1 then return species end
  return species .. '_' .. SIZES[form + 1]
end

local function roll_size(card, state, species)
  local ds = card:getDataStore()
  if ds:get('poke_form_rolled') then return end
  ds:set('poke_form_rolled', true)
  local form = state:random(0, 3)
  ds:set('form', form)
  ds:set('jack_target', 4 + form)
  poke.run.seen[species] = true
  if form ~= 1 then card:setJokerDef(poke.id(size_def(species, form))) end
end

-- Discarded Jacks count toward the target. When the count reaches it, create an Admin card (must have room).
-- A Copycat copy creates the card too, but does not count: it reads the count from before this discard.
local function discard_key(state)
  return tostring(state.round) .. ':' .. tostring(state.discardsLeft) .. ':' .. tostring(state.discardsUsed)
end

local function jack_discard(card, state, step, result)
  local ds = card:getDataStore()
  local key = discard_key(state)
  local pre
  if ds:get('poke_disc_key') == key then pre = ds:get('poke_disc_pre') else pre = poke.get(card, 'jacks_discarded') end
  local target = poke.get(card, 'jack_target')
  local count, spawns = pre, 0
  for _, c in ipairs(step.discardedCards or {}) do
    if poke.rank_of(c) == 11 and not c:getDebuffState() then
      count = count + 1
      if count == target then
        spawns = spawns + 1
        count = 0
      elseif not step.copiedBy then
        result:say(poke.text.dict('poke_boo_ex', 'BOO!'), colors.RED, c)
      end
    end
  end
  if not step.copiedBy then
    ds:set('poke_disc_key', key)
    ds:set('poke_disc_pre', pre)
    poke.set(card, 'jacks_discarded', count)
  end
  for _ = 1, spawns do poke.create_consumeable({ set = 'admin' }, step.copiedBy or card) end
end

local function jack_vars(get)
  return { get('jack_target'), math.max(0, get('jack_target') - get('jacks_discarded')) }
end

---------------------------------------------------------------------------
-- Sylveon 700: at the start of the round, a Luna, Holo or Chroma copy of a random deck card joins your hand.
---------------------------------------------------------------------------
poke.addPokemon {
  name = 'sylveon', rarity = 'poke_safari', cost = 7, stage = 'One', ptype = 'Fairy', gen = 6,
  config = {},
  attributes = { 'generation', 'editions' },
  vars = function(get) return {} end,
  triggers = {
    drawInitialCards = function(card, state, step, result)
      local deck = state.unDrawnCards or {}
      if #deck == 0 then return end
      local source = deck[state:random(1, #deck)]
      local copy = source:copy('hand')
      if copy then
        copy:setEdition(poke.random_edition(state))
        result:say('Copied!', poke.colours.fairy, copy)
      end
    end,
  },
}

---------------------------------------------------------------------------
-- Pumpkaboo 710 (four sizes)
---------------------------------------------------------------------------
local PUMPKABOO_ART = { [0] = { 2, 9 }, [1] = { 4, 9 }, [2] = { 6, 9 }, [3] = { 8, 9 } }
local GOURGEIST_ART = { [0] = { 10, 9 }, [1] = { 0, 10 }, [2] = { 2, 10 }, [3] = { 4, 10 } }

local function art(pos)
  return poke.sprites.frame('AtlasJokersBasicGen06', pos[1], pos[2])
end

for form = 0, 3 do
  local size = SIZES[form + 1]
  poke.addPokemon {
    name = size_def('pumpkaboo', form),
    loc_key = 'j_poke_pumpkaboo_' .. size,
    hidden = form ~= 1 or nil,
    rarity = 2, cost = 6, stage = 'Basic', ptype = 'Psychic', gen = 6,
    item_req = 'linkcable',
    config = { jack_target = 4 + form, jacks_discarded = 0, form = form },
    custom_values_to_keep = { 'jack_target', 'jacks_discarded' },
    sprite = art(PUMPKABOO_ART[form]),
    attributes = { 'discard', 'rank', 'jack', 'spectral', 'generation', 'item_evo' },
    vars = jack_vars,
    onAdded = function(card, state)
      if form == 1 then roll_size(card, state, 'pumpkaboo') else card:getDataStore():set('poke_form_rolled', true) end
    end,
    triggers = { onDiscard = jack_discard },
    evolution = function(card, state)
      return poke.item_evo(card, state, size_def('gourgeist', poke.get(card, 'form', 1)))
    end,
  }
end

---------------------------------------------------------------------------
-- Gourgeist 711 (four sizes)
---------------------------------------------------------------------------
for form = 0, 3 do
  local size = SIZES[form + 1]
  poke.addPokemon {
    name = size_def('gourgeist', form),
    loc_key = 'j_poke_gourgeist_' .. size,
    hidden = form ~= 1 or nil,
    rarity = 'poke_safari', cost = 9, stage = 'One', ptype = 'Psychic', gen = 6,
    config = { jack_target = 4 + form, jacks_discarded = 0, form = form, money = 6 },
    sprite = art(GOURGEIST_ART[form]),
    attributes = { 'discard', 'rank', 'jack', 'spectral', 'generation', 'economy' },
    vars = function(get)
      local v = jack_vars(get)
      v[3] = get('money')
      return v
    end,
    onAdded = function(card, state)
      if form == 1 then roll_size(card, state, 'gourgeist') else card:getDataStore():set('poke_form_rolled', true) end
    end,
    triggers = {
      onDiscard = jack_discard,
      onConsumableUsed = function(card, state, step, result)
        if not step.card or step.card:getConsumableType() ~= 'admin' then return end
        result:add(plusMoney(poke.ease_poke_dollars(card, 'gourgeist', poke.get(card, 'money'), true, state)))
        local leftmost = (state.jokers or {})[1]
        if leftmost then
          poke.apply_type_sticker(leftmost, 'Psychic', state)
          leftmost:popup(poke.text.dict('poke_tera_ex', 'Tera!'), poke.colours.psychic)
        end
      end,
    },
  }
end

-- The sizes belong to the Pumpkaboo family (one per run, Pokedex view, previous and next forms).
poke.add_to_family('pumpkaboo', { 'pumpkaboo_small', 'pumpkaboo_large', 'pumpkaboo_super' })
poke.add_to_family('gourgeist', { 'gourgeist_small', 'gourgeist_large', 'gourgeist_super' })


