-- Energy cards (original consumables/01_mart_energy.lua). An Energy card energizes the leftmost joker of its type
-- (Colorless: any type at half strength). Energize: the joker's Mult, Points, money and X Mult values grow for good.
local poke = cardlike.require('lib.pokermon')
local C = cardlike.require('content.consumables.common')

local ENERGIZE = '\n' .. colorize('(Energize: permanently raises the Mult, Points, $ and X Mult values of a Joker)', colors.GREY)

for k, etype in ipairs(poke.TYPES) do
  local id = etype == 'Dark' and 'darkness_energy' or etype:lower() .. '_energy'
  cardlike.addConsumable {
    id = id,
    type = 'pokermon:energy',
    readableName = C.name('poke_energy', 'c_poke_' .. id),
    price = 4,
    sprite = poke.sprites.at('consumables', (k - 1) % 10, math.floor((k - 1) / 10)),
    description = function(r)
      return C.desc('poke_energy', 'c_poke_' .. id, { C.energy_limit() }) .. ENERGIZE
    end,
    canUse = function(ctx)
      if poke.energy.can_use(etype, ctx.state) then return '' end
      return 'No ' .. etype .. ' Joker can take Energy'
    end,
    action = function(ctx)
      poke.energy.use(etype, ctx.state, id)
    end,
  }
end

-- Bird Energy: gives a joker with a type the full energy limit at once and ignores the limit. It never appears in
-- the shop or packs (other effects create it).
cardlike.addConsumable {
  id = 'bird_energy',
  type = 'pokermon:energy',
  readableName = C.name('poke_energy', 'c_poke_bird_energy'),
  price = 4,
  hidden = true,
  credits = 'Art: Catzzadilla',
  sprite = poke.sprites.at('bird_energy', 0, 0),
  description = function(r)
    return 'Gives ' .. colorize(bold('+' .. tostring(C.energy_limit())), poke.colours.pink) .. ' Energy to the leftmost Joker with a '
      .. colorize('Type', poke.colours.pink) .. '\n' .. colorize('(Ignores the Energy limit)', colors.GREY)
  end,
  canUse = function(ctx)
    if poke.energy.can_use('Bird', ctx.state) then return '' end
    return 'No Joker with a type'
  end,
  action = function(ctx)
    poke.set_spoon_item('bird_energy')
    local target = poke.energy.find_target('Bird', ctx.state)
    if target then
      cardlike.playSound('energy_use', { volume = 0.5 })
      poke.energy.modify(target, 'Bird', poke.energy.max + (poke.run.energy_plus or 0))
    end
  end,
}

-- Double Rainbow Energy (Admin card): energizes the leftmost joker of any type twice, but you earn no interest this
-- round (content/rules.lua reads the no_interest and reset_no_interest modifiers).
cardlike.addConsumable {
  id = 'double_rainbow_energy',
  type = 'admin',
  readableName = C.name('Spectral', 'c_poke_double_rainbow_energy'),
  price = 4,
  credits = 'Art: MyDude_YT',
  sprite = poke.sprites.at('consumables', 0, 6),
  description = function(r)
    return C.desc('Spectral', 'c_poke_double_rainbow_energy', { C.energy_limit() }) .. ENERGIZE
  end,
  canUse = function(ctx)
    if poke.energy.can_use('Trans', ctx.state) then return '' end
    return 'No Joker can take Energy'
  end,
  action = function(ctx)
    local target = poke.energy.find_target('Trans', ctx.state)
    if target then
      cardlike.playSound('energy_use', { volume = 0.5 })
      for _ = 1, 2 do poke.energy.increase(target, 'Trans') end
    end
    if not poke.modifier('no_interest') then
      poke.set_modifier('no_interest', true)
      poke.set_modifier('reset_no_interest', true)
    end
  end,
}


== file content/consumables/items.lua (404 lines)
-- Items (original consumables/03_mart_items.lua): Twisted Spoon, the evolution stones and other evolution items,
-- type changers and Miracle Seed.
-- An evolution item does its effect on the selected cards, then flags the leftmost Pokemon that evolves with it
-- (it evolves at the end of the round). With no fitting selection it only flags that Pokemon.
local poke = cardlike.require('lib.pokermon')
local C = cardlike.require('content.consumables.common')

local EITEM = '\n' .. colorize('(Evolution card: evolves the leftmost eligible Joker at the end of the round)', colors.GREY)

local function item(t)
  cardlike.addConsumable {
    id = t.id,
    type = 'pokermon:item',
    readableName = C.name('poke_item', 'c_poke_' .. t.id),
    price = t.cost or 4,
    credits = t.credits,
    sprite = poke.sprites.at('consumables', t.pos[1], t.pos[2]),
    description = function(r)
      local vars = t.vars and t.vars(r and r.card) or {}
      return C.desc('poke_item', 'c_poke_' .. t.id, vars) .. (t.evo and EITEM or '') .. (t.note and ('\n' .. colorize(type(t.note) == 'function' and t.note(r and r.card) or t.note, colors.GREY)) or '')
    end,
    canUse = t.canUse or function(ctx)
      if t.evo then return C.evo_can_use(t.id, ctx, t.fits) end
      return t.fits and t.fits(ctx) or ''
    end,
    action = t.action or function(ctx)
      if t.evo then
        C.evo_use(t.id, ctx, t.fits, t.effect)
      else
        poke.set_spoon_item(t.id)
        if t.effect then t.effect(ctx) end
      end
    end,
  }
end

local function each_sel(ctx, fn) for _, c in ipairs(C.sel(ctx)) do fn(c) end end

---------------------------------------------------------------------------
-- Twisted Spoon: creates the last Item or Energy card used this run.
---------------------------------------------------------------------------

local SPOON_EXCLUDED = { twisted_spoon = true, leftovers = true, leek = true, thickclub = true }

local function spoon_target()
  local last = poke.run and poke.run.last_item
  if not last then return nil end
  if SPOON_EXCLUDED[poke.short(last)] then return nil end
  if not cardlike.contentInfo('consumable', last) then return nil end
  return last
end

item {
  id = 'twisted_spoon',
  pos = { 1, 5 },
  note = function(card)
    local last = C.in_run() and poke.run.last_item
    local info = last and cardlike.contentInfo('consumable', last)
    return '(Twisted Spoon, Leftovers, Leek and Thick Club are excluded)\nLast used: ' .. (info and info.name or 'None')
  end,
  canUse = function(ctx)
    if not spoon_target() then return 'No Item to copy' end
    if C.consumable_room(ctx) < 1 then return 'No room' end
    return ''
  end,
  action = function(ctx)
    local last = spoon_target()
    if last then C.create(ctx, last) end
    poke.set_spoon_item('twisted_spoon')
  end,
}
---------------------------------------------------------------------------
-- Evolution stones
---------------------------------------------------------------------------

item {
  id = 'firestone', pos = { 4, 3 }, evo = true,
  vars = function() return { 4 } end,
  fits = function(ctx) return C.need(ctx, 4, 4) end,
