-- Dusk Stone: earn $4 for each joker it can drain ($1 of sell value each), up to $30. After it has been held for 3
-- rounds it pays for every joker without draining. Its round counter is kept in its data store ('rounds').
local DUSK = poke.MOD_ID .. ':duskstone'
local function dusk_rounds(card) return card and card:getDataStore():getOrDefault('rounds', 0) or 0 end
local function dusk_count(state, ripe)
  local n = 0
  for _, j in ipairs(state.jokers or {}) do
    if ripe or j:getSellValue() > 1 then n = n + 1 end
  end
  return n
end
item {
  id = 'duskstone', pos = { 3, 4 }, cost = 3, evo = true,
  vars = function(card)
    local rounds = dusk_rounds(card)
    local ripe = 3 - rounds <= 0
    local n = C.in_run() and dusk_count(cardlike.state, ripe) or 0
    return { 4, 3, math.max(0, 3 - rounds), math.min(30, 4 * n), 30 }
  end,
  canUse = function(ctx) return '' end,
  action = function(ctx)
    poke.set_spoon_item('duskstone')
    local ripe = 3 - dusk_rounds(ctx.self) <= 0
    local n = 0
    for _, j in ipairs(ctx.state.jokers or {}) do
      if ripe or j:getSellValue() > 1 then
        n = n + 1
        if not ripe then poke.drain_value(nil, j, 1, true) end
      end
    end
    local money = math.min(30, 4 * n)
    if money > 0 then ctx.state:mutateMoney(money) end
    poke.evo_item_use('duskstone', ctx.state)
  end,
}
cardlike.on('onRoundStart', function(state)
  for _, c in ipairs(C.held(state, DUSK)) do
    local ds = c:getDataStore()
    ds:set('rounds', ds:getOrDefault('rounds', 0) + 1)
    if ds:get('rounds') == 3 then c:popup('Ripe!', colors.MONEY) end
  end
end)

-- Dawn Stone: the next hand played while you hold it sets its hand type; using it earns twice that hand's Mult
-- (up to $40). The hand type is kept in its data store ('hand_played').
local DAWN = poke.MOD_ID .. ':dawnstone'
local function dawn_money(card)
  local ht = card and card:getDataStore():get('hand_played')
  if not ht or not C.in_run() then return 0, nil end
  local h = cardlike.state:getHand(ht)
  return math.min(40, 2 * ((h and h.mult) or 0)), ht
end
item {
  id = 'dawnstone', pos = { 4, 4 }, cost = 3, evo = true, credits = 'Art: Lemmanade',
  vars = function(card)
    local money, ht = dawn_money(card)
    local name = 'None'
    if ht then
      for _, e in ipairs(cardlike.listContent('handType') or {}) do if e.id == ht then name = e.name or ht end end
      if name == 'None' then name = ht end
    end
    return { name, money, 40, ht and '(Hand type set!)' or '(Next hand played sets hand type)' }
  end,
  canUse = function(ctx)
    if ctx.self and ctx.self:getDataStore():get('hand_played') then return '' end
    if poke.evo_item_target('dawnstone', ctx.state) then return '' end
    return 'Play a hand first'
  end,
  action = function(ctx)
    poke.set_spoon_item('dawnstone')
    local money = dawn_money(ctx.self)
    if money > 0 then ctx.state:mutateMoney(money) end
    poke.evo_item_use('dawnstone', ctx.state)
  end,
}
cardlike.on('afterAllCardsScored', function(state, step)
  local ht = step.hand and step.hand.handType
  if not ht then return end
  for _, c in ipairs(C.held(state, DAWN)) do
    local ds = c:getDataStore()
    if not ds:get('hand_played') then
      ds:set('hand_played', ht)
      c:punch()
    end
  end
end)

item {
  id = 'icestone', pos = { 5, 4 }, evo = true,
  vars = function() return { 2, (cardlike.state and cardlike.state.chanceMultiplier) or 1, 4 } end,
  fits = function(ctx) return C.need(ctx, 1, 2) end,
