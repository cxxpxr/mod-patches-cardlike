-- Exeggcute 102
poke.addPokemon {
  name = 'exeggcute', rarity = 1, cost = 4, stage = 'Basic', ptype = 'Grass', gen = 1,
  item_req = 'leafstone',
  config = { mult = 2, suit = 'Hearts', mult2 = 6, num = 1, dem = 4 },
  attributes = { 'mult', 'suit', 'hearts', 'chance', 'item_evo' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('mult'), 'Heart', get('mult2'), num, dem }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not step.card:isSuit(poke.get(card, 'suit')) then return end
      local mult = poke.get(card, 'mult')
      if poke.roll(card, state) then mult = poke.get(card, 'mult2') end
      result:add(plusMult(mult))
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'exeggutor') end,
}

-- Exeggutor 103
poke.addPokemon {
  name = 'exeggutor', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Grass', gen = 1,
  config = { mult_mod = 2, Xmult_multi = 1.4, suit = 'Hearts', num = 1, dem = 2 },
  attributes = { 'mult', 'xmult', 'suit', 'hearts', 'chance' },
  vars = function(get, card, state)
    local num, dem = poke.chance_vars(get('num'), get('dem'), state)
    return { get('mult_mod'), get('Xmult_multi'), 'Heart', num, dem }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not step.card:isSuit(poke.get(card, 'suit')) then return end
      if poke.roll(card, state) then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
        result:say(poke.text.dict('poke_solar_ex', 'Solar Beam!'), colors.MULT)
      else
        result:add(plusMult(poke.get(card, 'mult_mod')))
      end
    end,
  },
}

-- Cubone 104: holding a Thick Club.
poke.addPokemon {
  name = 'cubone', rarity = 1, cost = 5, stage = 'Basic', ptype = 'Earth', gen = 1,
  config = { mult = 5, consumables_used = 0 },
  evo_rqmt = 20,
  attributes = { 'mult', 'holding', 'condition_evo' },
  vars = function(get, card, state)
    return { get('mult'), get('mult') * consumable_count(state), math.max(0, 20 - get('consumables_used')) }
  end,
  onAdded = function(card, state) poke.holding(card, 'thickclub', state) end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      local count = consumable_count(state)
      if count > 0 then result:add(plusMult(poke.get(card, 'mult') * count)) end
    end,
    onConsumableUsed = function(card, state, step, result)
      if not step.copiedBy then poke.add(card, 'consumables_used', 1) end
    end,
  },
  evolution = function(card, state)
    return poke.scaling_evo(card, state, 'marowak', poke.get(card, 'consumables_used'), 20)
  end,
}

