-- Energy. Energy cards raise the values of a Pokemon joker of the same type (Colorless energy works on any type at
-- half strength, Trans and Bird energy on any type).
--
-- Data store keys of the joker:
--   poke_energy    energy of the matching type (Balatro energy_count)
--   poke_c_energy  Colorless energy on a non-Colorless joker (counts half; Balatro c_energy_count)
--   poke_e_limit_up  extra energy limit of this joker (Balatro e_limit_up)
--   poke_frac_<field>  fraction left over when values are rounded (setting precise_energy off; Balatro <field>_frac)
--
-- How a value grows: each energy adds values[field] x the def's config default of that field to the current value.
-- For example mult (default 4): +0.4 x 4 = +1.6 Mult per energy. Only config fields named in P.energy.values grow.
local P = cardlike.require('lib.base')
local E = P.energy

E.values = {
  mult = .4, mult1 = .4, mult2 = .4,
  chips = .3, chips1 = .3, chips2 = .3, chips3 = .3,
  Xmult = .2, Xmult1 = .2, Xmult2 = .2,
  Xchips = .2, Xchips1 = .2, Xchips2 = .2,
  money = .3, money1 = .3, money2 = .3,
  money_mod = .1, money_mod1 = .1, money_mod2 = .1,
  mult_mod = .2, mult_mod1 = .2, mult_mod2 = .2,
  chip_mod = .2, chip_mod1 = .2, chip_mod2 = .2,
  Xmult_mod = .2, Xmult_mod1 = .2, Xmult_mod2 = .2,
  Xmult_multi = .05, Xmult_multi1 = .05, Xmult_multi2 = .05,
  Xchips_multi = .05, Xchips_multi1 = .05, Xchips_multi2 = .05,
}
E.max = 3

--- Consumable id of the Energy card of a type ('Dark' -> 'pokermon:darkness_energy').
function E.card_id(ptype)
  if not ptype then return nil end
  local t = ptype:lower()
  if t == 'dark' then t = 'darkness' end
  return P.MOD_ID .. ':' .. t .. '_energy'
end

--- Energy on a joker. get_counts = true returns energy, colorless energy.
function E.get_total_energy(card, get_counts)
  local e = P.get(card, 'poke_energy', 0) or 0
  local c = P.get(card, 'poke_c_energy', 0) or 0
  if get_counts then return e, c end
  return e + c
end

--- Energy limit of a joker.
function E.limit(card)
  return E.max + (P.run.energy_plus or 0) + (P.get(card, 'poke_e_limit_up', 0) or 0)
end

--- Whether a joker has values that energy raises.
function E.is_energizable(card)
  local def = P.def(card)
  if not def then return false end
  for name in pairs(E.values) do
    if type(def.config[name]) == 'number' then return true end
  end
  return false
end

function E.can_increase_energy(card, etype)
  local def = P.def(card)
  if P.settings.unlimited_energy or (def and def.no_energy_limit) or etype == 'Bird' then return true end
  return E.get_total_energy(card) < E.limit(card)
end

--- Whether energy of type etype works on this joker.
function E.energy_matches(card, etype, include_colorless)
  local t = P.get_type(card)
  if t and (etype == 'Trans' or etype == 'Bird') then return true end
  if t and etype == 'Colorless' and include_colorless then return true end
  return P.is_type(card, etype)
end

function E.can_apply_energy(card, etype)
  return E.energy_matches(card, etype, true) and E.is_energizable(card) and E.can_increase_energy(card, etype)
end

--- The joker an Energy card of type etype goes to: the leftmost joker it can apply to (Cardlike has no joker selection).
function E.find_target(etype, state)
  return P.find_leftmost_or_highlighted(function(j) return E.can_apply_energy(j, etype) end, state)
end

--- canUse of an Energy card.
function E.can_use(etype, state)
  return E.find_target(etype, state) ~= nil
end

--- Use an Energy card of type etype on its target.
function E.use(etype, state, source_id)
  cardlike.playSound('energy_use', { volume = 0.5 })
  if source_id then P.set_spoon_item(source_id) end
  local target = E.find_target(etype, state)
  if target then E.modify(target, etype) end
  return target
end

--- Add energy to a joker when there is room (the way to energize outside of Energy cards).
function E.increase(card, etype, amount, silent)
  if not card then return end
  amount = amount or 1
  if E.can_increase_energy(card) or amount <= E.limit(card) - E.get_total_energy(card) then
    E.modify(card, etype, amount, silent)
  end
end

--- Add energy counts and raise the values (Colorless on another type counts half).
function E.modify(card, etype, amount, silent)
  amount = amount or 1
  if E.energy_matches(card, etype, false) then
    P.add(card, 'poke_energy', amount)
    E.energize(card, etype, false, silent, amount)
  elseif etype == 'Colorless' and E.is_energizable(card) then
    P.add(card, 'poke_c_energy', amount)
    E.energize(card, etype, false, silent, amount)
  end
end

local function round_value(value, field)
  if P.settings.precise_energy then return value, nil end
  if field == 'mult' or field == 'mult2' or field == 'chips' or field == 'chips1' or field == 'chips2' or field == 'chips3' then
    return math.ceil(value), nil
  elseif field == 'money' or field == 'money1' or field == 'money2' or field == 'mult_mod' or field == 'mult_mod2'
      or field == 'chip_mod' or field == 'money_mod' then
    local int = math.floor(value)
    return int, value - int
  end
  return value, nil
end

local function set_frac(card, frac, field, increased, ratio)
  local key = 'poke_frac_' .. field
  local bonus_amt = math.ceil((P.get(card, field, 0) or 0) / (increased and 2 or 1))
  local f = (P.get(card, key, 0) or 0) + frac
  if f >= 1 then
    local int = math.floor(f)
    P.add(card, field, int)
    f = f - int
    if not increased then bonus_amt = bonus_amt / 2 end
  end
  P.set(card, key, f)
  if field == 'mult_mod' and P.get(card, 'mult') ~= nil then
    local m = P.get(card, 'mult', 0)
    if ratio then m = math.ceil(m * ratio) end
    P.set(card, 'mult', m + bonus_amt)
  end
  if field == 'chip_mod' and P.get(card, 'chips') ~= nil then
    local c = P.get(card, 'chips', 0)
    if ratio then c = math.ceil(c * ratio) end
    P.set(card, 'chips', c + bonus_amt)
  end
  if field == 'money_mod' and P.get(card, 'money') ~= nil then
    P.set(card, 'money', P.get(card, 'money', 0) + bonus_amt)
  end
end

--- Raise the energizable values. evolving = true re-applies all energy after an evolution (the values of the new
--- form grow by all of the joker's energy at once).
function E.energize(card, etype, evolving, silent, amount, def)
  amount = amount or 1
  def = def or P.def(card)
  if not def then return end
  local e, c = E.get_total_energy(card, true)
  local c_penalty = (not P.modifier('disable_colorless_penalty') and not P.is_type(card, 'Colorless') and etype == 'Colorless') and 2 or 1
  local escale = P.get(card, 'escale', 1) or 1
  for name, per in pairs(E.values) do
    local base = def.config[name]
    local current = P.get(card, name)
    if type(base) == 'number' and type(current) == 'number' then
      local previous_mod = (name == 'mult_mod' or name == 'chip_mod') and current or nil
      local addition
      if evolving then
        addition = per * (e + c / 2)
      else
        addition = per / (etype == 'Colorless' and c_penalty or 1) * amount
      end
      local updated = current + base * addition * escale
      local rounded, frac = round_value(updated, name)
      P.set(card, name, rounded)
      if frac then set_frac(card, frac, name, rounded > 0, previous_mod and previous_mod ~= 0 and (updated / previous_mod) or nil) end
    end
  end
  if not silent then card:popup(P.text.dict('poke_energized_ex', 'Energized!'), P.colours.pink) end
end

--- Energy card id that matches a joker's type (nil for jokers with no type; Bird needs allow_bird).
function E.get_matching_energy(card, allow_bird)
  local t = P.get_type(card)
  if not t or (t == 'Bird' and not allow_bird) then return nil end
  return E.card_id(t)
end

--- A line for descriptions: 'Energy: 2/3' (nil when the joker has no energy).
function E.info_line(card)
  if not card then return nil end
  local total = E.get_total_energy(card)
  local up = P.get(card, 'poke_e_limit_up', 0) or 0
  if total == 0 and up == 0 then return nil end
  local limit = P.settings.unlimited_energy and 'Infinity' or P.text.num(E.limit(card))
  return colorize('Energy: ' .. P.text.num(total) .. '/' .. limit, P.colours.pink)
end


== file lib/evolution.lua (328 lines)
-- Evolution: a Pokemon joker turns into another joker (card:setJokerDef) and keeps its growing values, its energy
-- and its Tera type.
--
-- When: at the end of each won round (onBlindDefeated) the library runs def.evolution(card, state) of every Pokemon
-- you own, from left to right. That function calls one of the checks below, which evolve the card when it is ready:
--   P.level_evo(card, state, 'ivysaur')                  after config.rounds rounds (counts down 'rounds')
--   P.scaling_evo(card, state, 'ivysaur', cur, target)   when cur >= target
--   P.item_evo(card, state, 'nidoqueen')                 after an evolution item was used on it
--   P.type_evo(card, state, 'x', 'Metal')                when its Tera type is 'Metal'
--   P.deck_suit_evo / P.deck_enhance_evo / P.deck_seal_evo  when enough deck cards match
-- P.evolve(card, 'ivysaur') evolves at once (for effects that evolve outside the round end).
local P = cardlike.require('lib.base')

--- Whether a card may evolve now: the target exists, and no Everstone (unless allow_level).
function P.can_evolve(card, into, allow_level, state)
  state = state or cardlike.state
  if not card or not card.uid or not card:exists() then return false end
  if into and not P.def(into) and not P.joker_exists(into) then return false end
  if not allow_level and state and state.hasJoker and state:hasJoker(P.id('everstone')) then return false end
  return true
end

-- Values a Pokemon keeps when it evolves (Balatro get_values_to_keep).
local SCALED = { 'mult', 'chips', 'Xmult', 'Xmult_multi', 'money' }
local KEEP = { 'targets', 'rank', 'id', 'form', 'cards_scored', 'cards_drawn' }
local SYSTEM_KEEP = { 'poke_energy', 'poke_c_energy', 'poke_e_limit_up', 'poke_tera' }

function P.get_values_to_keep(card, def)
  local values = {}
  local ds = card:getDataStore()
  local cfg = def and def.config or {}
  for _, k in ipairs(SCALED) do
    local has_mod = cfg[k .. '_mod'] ~= nil or cfg[k:sub(1, -2) .. '_mod'] ~= nil
    if cfg[k] ~= nil and (has_mod or (def and def.copy_scaled)) then values[k] = P.get(card, k) end
  end
  for _, k in ipairs(KEEP) do
    if ds:has(k) then values[k] = ds:get(k) end
  end
  local custom
  if def and def.custom_values_to_keep then
    custom = {}
    for _, k in ipairs(def.custom_values_to_keep) do custom[k] = P.get(card, k) end
  end
  return values, custom
end

--- Turn a card into another joker now and keep its values. Returns the new def (or nil).
--- opts: message (text), energize_amount (energy to add after), keep_all (keep every data store value).
function P.backend_evolve(card, into, opts, state)
  opts = opts or {}
  state = state or cardlike.state
  local new_id = P.id(into)
  local old_id = card:getJokerDef()
  if new_id == old_id then return nil end
  local old_def = P.by_id[old_id]
  local new_def = P.by_id[new_id]
  local ds = card:getDataStore()

  local values, custom = P.get_values_to_keep(card, old_def)
  local system = {}
  for _, k in ipairs(SYSTEM_KEEP) do system[k] = ds:get(k) end

  -- the old form leaves (hand size, discards and other passive effects go away)
  if old_def then P.call_removed(card, state, old_def) end
  -- reset the values to the new form's defaults
  if not opts.keep_all then
    for k in pairs(old_def and old_def.config or {}) do ds:delete(k) end
    for _, k in ipairs({ 'poke_evolve' }) do ds:delete(k) end
  end
  card:setJokerDef(new_id)
  if new_def then
    for k in pairs(new_def.config) do ds:set(k, P.default(new_def, k)) end
  end
  for k, v in pairs(system) do if v ~= nil then ds:set(k, v) end end

  -- keep scaled values that are larger than the new defaults, and the other kept values
  if new_def then
    for k, v in pairs(values) do
      local cur = ds:get(k)
      if cur ~= nil then
        if type(cur) ~= 'number' or (type(v) == 'number' and v > cur) or k == 'form' then ds:set(k, v) end
      end
    end
    if (system.poke_energy or 0) > 0 or (system.poke_c_energy or 0) > 0 then
      P.energy.energize(card, nil, true, true, nil, new_def)
    end
  end
  if custom then for k, v in pairs(custom) do ds:set(k, v) end end
  -- the new form joins, with the kept values already in place (its onAdded can read them)
  if new_def then P.call_added(card, state, new_def) end
  if new_def then P.run.seen[new_def.name] = true end

  card:punch()
  card:popup(opts.message or P.text.dict('poke_evolve_success', 'Evolved!'), colors.ORANGE)
  if opts.energize_amount then P.energy.increase(card, 'Trans', opts.energize_amount) end
  return new_def
end

--- Evolve a card into another Pokemon (name or id). In the Randomizer challenge it becomes a random Pokemon.
function P.evolve(card, into, opts, state)
  opts = opts or {}
  if P.modifier('apply_randomizer') and not opts.transformation then
    into = P.get_random_poke_key({}, state)
  end
  return P.backend_evolve(card, into, opts, state)
end

function P.devolve(card, into, message, state)
  return P.backend_evolve(card, into, { message = message or P.text.dict('poke_devolve_success', 'Reverted') }, state)
end

function P.change_form(card, into, message, state)
  return P.backend_evolve(card, into, { message = message or P.text.dict('poke_transform_success', 'Transformed!'), transformation = true }, state)
end

--- Evolve after config.rounds rounds. Counts 'rounds' down by one each call (also with an Everstone).
function P.level_evo(card, state, into)
  local rounds = P.get(card, 'rounds')
  if rounds == nil then return false end
  if card:getDebuffState() then return false end
  if rounds > 0 then
    rounds = rounds - 1
    P.set(card, 'rounds', rounds)
  end
  if rounds <= 0 and P.can_evolve(card, into, false, state) then
    return P.evolve(card, into, nil, state) ~= nil
  end
  if rounds > 0 then card:popup(P.text.dict('poke_evolve_level', 'Level up!'), colors.ORANGE) end
  return false
end

--- Evolve when current >= target.
function P.scaling_evo(card, state, into, current, target, message)
  if type(current) == 'number' and type(target) == 'number' and current >= target and P.can_evolve(card, into, false, state) then
    return P.evolve(card, into, { message = message }, state) ~= nil
  end
  return false
end

--- Evolve after an evolution item was used on the card. With several items (evo_list), the item name picks the form.
function P.item_evo(card, state, into)
  local flag = P.get(card, 'poke_evolve')
  if not flag then return false end
  local def = P.def(card)
  if type(flag) == 'string' and def and def.evo_list then into = def.evo_list[flag] or into end
  if into and P.can_evolve(card, into, false, state) then
    card:getDataStore():delete('poke_evolve')
    return P.evolve(card, into, nil, state) ~= nil
  end
  return false
end

--- Evolve when the card's Tera type is type_req.
function P.type_evo(card, state, into, type_req)
  if P.type_sticker_applied(card) == type_req and P.can_evolve(card, into, false, state) then
    return P.evolve(card, into, nil, state) ~= nil
  end
  return false
end

local function deck_count(state, fn)
  local n, total = 0, 0
  for _, c in ipairs(state.allCards or {}) do
    total = total + 1
    if fn(c) then n = n + 1 end
  end
  return n, total
end

--- Evolve when at least percentage (0..1) of the deck is of a suit.
function P.deck_suit_evo(card, state, into, suit, percentage)
  if not P.can_evolve(card, into, false, state) then return false end
  local n, total = deck_count(state, function(c) return (c.lastInfo.suits or {})[suit] == true end)
  if total > 0 and n / total >= percentage then return P.evolve(card, into, nil, state) ~= nil end
  return false
end

--- Evolve when enough deck cards have an enhancement (percentage 0..1, or a flat count).
function P.deck_enhance_evo(card, state, into, enhancement, percentage, flat)
  if not P.can_evolve(card, into, false, state) then return false end
  local n, total = deck_count(state, function(c) return P.has_enhancement(c, enhancement) end)
  if (percentage and total > 0 and n / total >= percentage) or (flat and n >= flat) then return P.evolve(card, into, nil, state) ~= nil end
  return false
end

--- Evolve when enough deck cards have a stamp (seal = nil counts any stamp).
function P.deck_seal_evo(card, state, into, seal, percentage, flat)
  if not P.can_evolve(card, into, false, state) then return false end
  local want = seal and (P.STAMP_IDS[seal] or seal)
  local n, total = deck_count(state, function(c)
    local s = c.lastInfo.stamp
    if want then return s == want end
    return s ~= nil and s ~= '' and s ~= 'none'
  end)
  if (percentage and total > 0 and n / total >= percentage) or (flat and n >= flat) then return P.evolve(card, into, nil, state) ~= nil end
  return false
end

---------------------------------------------------------------------------
-- Evolution lines
---------------------------------------------------------------------------

local function member_name(m) return type(m) == 'table' and m.key or m end

local function evo_overrides(name)
  for _, line in ipairs(P.EVO_OVERRIDES) do
    for i, stage in ipairs(line) do
      local list = type(stage) == 'table' and stage or { stage }
      for _, n in ipairs(list) do
        if n == name then
          local o = {}
          if i > 1 then o.previous_evo = line[i - 1] end
          if i < #line then o.highest_evo = line[#line] end
          return o
        end
      end
    end
  end
  return {}
end

--- The previous form of a Pokemon (name, or full id when full_key). Mega forms go back to their base form.
function P.get_previous_evo(card_or_name, full_key)
  local def = type(card_or_name) == 'string' and P.def(card_or_name) or P.def(card_or_name)
  local name = def and def.name or card_or_name
  if type(name) ~= 'string' then return nil end
  local prev
  local o = evo_overrides(name)
  if o.previous_evo then prev = o.previous_evo end
  if not prev and def and def.stage == 'Mega' then
    local base = name:gsub('^mega_', ''):gsub('_%a$', '')
    if P.def(base) then prev = base end
  end
  if not prev and def then
    local list = P.get_family_list(name)
    local index
    for i, m in ipairs(list) do if member_name(m) == name then index = i break end end
    local want = (P.STAGES[def.stage] or {}).prev
    while index and index > 1 do
      index = index - 1
      local pdef = P.def(member_name(list[index]))
      if pdef and pdef.stage == want and not def.aux_poke then prev = pdef.name break end
    end
  end
  if not prev then return nil end
  return full_key and P.id(prev) or prev
end

--- The final evolutions of a card's line (a list of names), or nil when the card is at the end of its line (false
--- when it has no family). No random roll: descriptions can call it.
function P.get_highest_evos(card)
  local def = P.def(card)
  if not def or not def.stage then return nil end
  local name = def.name
  local o = evo_overrides(name).highest_evo
  if o then return type(o) == 'table' and o or { o } end
  if (P.STAGES[def.stage] or {}).next == nil then return nil end
  local family = P.get_family_list(name)
  if #family < 2 then return false end
  local max = #family
  local function stage_of(i) local d = P.def(member_name(family[i])) return d and d.stage, d end
  local s, d = stage_of(max)
  while max > 1 and (not s or (P.STAGES[s] or {}).prev == nil or (d and d.aux_poke)) do
    max = max - 1
    s, d = stage_of(max)
  end
  if not s then return nil end
  if s ~= 'Legendary' and def.stage == s then return nil end
  local evos = { member_name(family[max]) }
  for i, m in ipairs(family) do
    local md = P.def(member_name(m))
    if i ~= max and md and md.stage == s and md.stage ~= 'Legendary' and not md.aux_poke then evos[#evos + 1] = md.name end
  end
  return evos
end

--- Whether a card can still evolve (it has a final evolution it is not at yet). No random roll.
function P.has_highest_evo(card)
  local evos = P.get_highest_evos(card)
  return type(evos) == 'table' and #evos > 0
end

--- The final evolution of a card's line (a seeded random one when there are several), or nil. Rolls the run's random:
--- call it from effects, not from descriptions (use P.get_highest_evos or P.has_highest_evo there).
function P.get_highest_evo(card, state)
  local evos = P.get_highest_evos(card)
  if type(evos) ~= 'table' then return evos end
  if #evos == 1 then return evos[1] end
  return P.random_element(evos, state)
end

--- The first form of a card's line.
function P.get_lowest_evo(card)
  local name = P.name(card) or (type(card) == 'string' and card) or 'bulbasaur'
  local family = P.get_family_list(name)
  return member_name(family[1]) or name
end

--- The Mega form a card becomes with a Mega Stone. With two Mega forms: leftmost joker X, rightmost Y, else random.
function P.get_mega(card, state)
  state = state or cardlike.state
  local def = P.def(card)
  if not def or not def.megas then return nil end
  if #def.megas == 1 then return def.megas[1] end
  local jokers = state.jokers or {}
  if #jokers == 1 then return P.random_element(def.megas, state) end
  if jokers[1] == card then return def.megas[1] end
  if jokers[#jokers] == card then return def.megas[2] end
  return P.random_element(def.megas, state)
end

---------------------------------------------------------------------------
-- The evolution step at the end of each won round
---------------------------------------------------------------------------

-- Evolution first, then the jokers that fainted this round come back: a fainted joker is still debuffed during its
-- evolution check, so the round does not count for its level evolution.
cardlike.on('onBlindDefeated', function(state)
  for _, card in ipairs(state.jokers or {}) do
    local def = P.def(card)
    if def and def.evolution and card:exists() then
      local ok, err = pcall(def.evolution, card, state)
      if not ok then cardlike.warn('evolution of ' .. def.name .. ': ' .. tostring(err)) end
    end
  end
  P.revive_fainted(state)
end)


== file lib/family.lua (113 lines)
-- Evolution families and the Pokedex order.
local P = cardlike.require('lib.base')

local family_map = {}  -- name -> family list (shared table)

local function member_name(m) return type(m) == 'table' and m.key or m end

for _, family in ipairs(cardlike.require('lib.data.family_data')) do
  for _, m in ipairs(family) do family_map[member_name(m)] = family end
end

--- The family list of a Pokemon name (lowest stage first). Members are names or { key, form }. {} when none.
function P.get_family_list(name)
  return family_map[name] or {}
end

local function contains(family, m)
  for _, v in ipairs(family) do
    if v == m or (type(v) == 'table' and type(m) == 'table' and v.key == m.key and v.form == m.form) then return true end
  end
  return false
end

--- Extend a family (or make a new one). insert_after: the member after which the new members go.
function P.add_to_family(insert_after, new_members, allow_duplicates)
  if type(new_members) ~= 'table' or new_members.key then new_members = { new_members } end
  local family = (insert_after and family_map[member_name(insert_after)])
  if not family then
    for _, m in ipairs(new_members) do
      if family_map[member_name(m)] then family = family_map[member_name(m)] break end
    end
  end
  family = family or {}
  local index
  if insert_after then
    for i, v in ipairs(family) do if member_name(v) == member_name(insert_after) then index = i end end
  end
  for i, m in ipairs(new_members) do
    if allow_duplicates or not contains(family, m) then
      family_map[member_name(m)] = family
      if index then table.insert(family, index + i, m) else family[#family + 1] = m end
    end
  end
end
P.add_family = function(family) P.add_to_family(nil, family) end

-- Pokemon that count as part of a family without being in its evolution line.
P.extended_family = {
  tauros = { 'miltank' },
  unown = { 'ruins_of_alph', 'unown_swarm' },
  luvdisc = { { item = true, name = 'heartscale' } },
  deoxys = { { item = true, name = 'meteorite' } },
}

--- Whether a family member of this Pokemon already appeared this run (so it should not appear again), unless you
--- own the Pokedex joker or Plugged In (Cardlike's Showman).
function P.family_present(def_or_name, state)
  state = state or cardlike.state
  local name = type(def_or_name) == 'table' and def_or_name.name or def_or_name
  if not name then return false end
  if state and state.hasJoker and (state:hasJoker(P.id('pokedex')) or state:hasJoker('joker_world_line')) then return false end
  local seen = P.run.seen or {}
  local family = P.get_family_list(name)
  if #family == 0 then family = { name } end
  for _, m in ipairs(family) do
    local n = member_name(m)
    if seen[n] then return true end
  end
  if state and state.jokers then
    for _, j in ipairs(state.jokers) do
      local jn = P.name(j)
      if jn then
        for _, m in ipairs(family) do if member_name(m) == jn then return true end end
      end
    end
  end
  return false
end

--- Joker ids (and item ids) of a Pokemon's family, for the Pokedex view.
function P.get_family_keys(card_or_name)
  local name = type(card_or_name) == 'string' and card_or_name or P.name(card_or_name)
  local keys = {}
  local family = P.get_family_list(name)
  if #family == 0 then family = { name } end
  for _, m in ipairs(family) do
    if type(m) == 'table' then keys[#keys + 1] = { key = P.id(m.key), form = m.form }
    else keys[#keys + 1] = P.id(m) end
  end
  for _, extra in ipairs(P.extended_family[name] or {}) do
    if type(extra) == 'table' and extra.item then keys[#keys + 1] = P.MOD_ID .. ':' .. extra.name
    else keys[#keys + 1] = P.id(member_name(extra)) end
  end
  local def = P.def(name)
  if def then P.table_append(keys, P.get_evo_item_keys(def)) end
  return keys
end

-- Pokedex numbers.
P.dex_order = cardlike.require('lib.data.dex_data')
P.dex_numbers = {}
for i, entry in ipairs(P.dex_order) do
  if type(entry) == 'table' then
    for _, n in ipairs(entry) do P.dex_numbers[n] = i end
  else
    P.dex_numbers[entry] = i
  end
end

function P.get_dex_number(name)
  return P.dex_numbers[name] or 1026
end


== file lib/hazards.lua (75 lines)
-- Hazards and growth.
-- Hazard level: at the start of each round, min(level, max) Hazard cards join your hand (and your deck). Hazard cards
-- have no rank, always score, and when held at the end of a round have a 1 in 3 chance to be destroyed.
-- Growth level: Seed cards gain 1 + growth level levels when they score.
local P = cardlike.require('lib.base')

P.HAZARD_ID = P.MOD_ID .. ':hazard'

function P.change_hazard_level(n)
  P.run.hazard_level = (P.run.hazard_level or 0) + (n or 0)
end

function P.change_hazard_max(n)
  P.run.hazard_max = (P.run.hazard_max or 3) + (n or 0)
end

--- { level shown (capped at max), max } for texts.
function P.get_hazard_level_vars()
  local max = P.run.hazard_max or 3
  return { math.min(max, P.run.hazard_level or 0), max }
end

-- Functions that change the number of Hazard cards added this round (Heavy-Duty Boots returns 0).
P.hazard_count_filters = {}
function P.add_hazard_count_filter(fn) P.hazard_count_filters[#P.hazard_count_filters + 1] = fn end

function P.hazard_count_now(state)
  local n = math.min(P.run.hazard_max or 3, P.run.hazard_level or 0)
  for _, fn in ipairs(P.hazard_count_filters) do n = fn(n, state or cardlike.state) or n end
  return n
end

function P.change_growth_level(n)
  P.run.growth_level = (P.run.growth_level or 0) + (n or 0)
end

function P.growth_level()
  return P.run.growth_level or 0
end

--- Add Hazard cards: flat cards, or one for every `ratio` non-Hazard cards in the deck. area: 'hand' or 'deck'.
function P.add_hazards(ratio, flat, area, state)
  state = state or cardlike.state
  local count = 0
  for _, c in ipairs(state.allCards or {}) do
    if (c.lastInfo or {}).enhancement ~= P.HAZARD_ID then count = count + 1 end
  end
  local n = ratio and math.floor(count / ratio) or (flat or 0)
  local added = {}
  for _ = 1, n do
    local card = cardlike.addPlayingCard({ enhancement = P.HAZARD_ID }, { area = area or 'deck' })
    if card then added[#added + 1] = card end
  end
  return added
end

--- Turn amount random plain deck cards into Hazard cards.
function P.set_hazards(amount, state)
  state = state or cardlike.state
  for _ = 1, amount do
    local valid = {}
    for _, c in ipairs(state.unDrawnCards or {}) do
      if (c.lastInfo or {}).enhancement == 'Default' then valid[#valid + 1] = c end
    end
    local pick = P.random_element(valid, state)
    if pick then pick:setEnhancement(P.HAZARD_ID) end
  end
end

-- Hazards join the hand when the first hand of the round is drawn.
cardlike.on('drawInitialCards', function(state)
  local n = P.hazard_count_now(state)
  if n > 0 then P.add_hazards(nil, n, 'hand', state) end
end)


== file lib/items.lua (204 lines)
-- Items: evolution items, held items (reusable consumables), consumable creation helpers.
--
-- Evolution items: a Pokemon def lists its item in item_req ('moonstone' or a list). Using the item flags the leftmost
-- Pokemon that needs it (data store 'poke_evolve' = true, or the item name when item_req is a list); P.item_evo then
-- evolves it at the end of the round. Cardlike has no joker selection, so the item always goes to the leftmost match.
local P = cardlike.require('lib.base')
local I = P.items

--- Consumable id of an item name ('moonstone' -> 'pokermon:moonstone').
local BUILTIN_TYPES = { game = true, fruit = true, admin = true }
function I.id(name)
  if type(name) ~= 'string' then return nil end
  if name:find(':', 1, true) or BUILTIN_TYPES[name] then return name end
  -- built-in consumables keep their ids (Game, Fruit and Admin cards)
  if name:match('^cart_card_%d+$') or name:match('^fruit_card_%d+$') or name:match('^admin_card_%d+$') then return name end
  return P.MOD_ID .. ':' .. name:gsub('^c_poke_', '')
end

local function reqs(def)
  local r = def and def.item_req
  if r == nil then return {} end
  if type(r) == 'table' then return r end
  return { r }
end

--- Whether item_name evolves this joker (and it is not flagged yet).
function P.is_evo_item_for(item_name, card)
  if not card or P.get(card, 'poke_evolve') then return false end
  if card:getDebuffState() then return false end
  local def = P.def(card)
  for _, r in ipairs(reqs(def)) do if r == item_name then return true end end
  return false
end

--- The leftmost joker that item_name can evolve, or nil.
function P.evo_item_target(item_name, state)
  return P.find_card(function(j) return P.is_evo_item_for(item_name, j) end, state)
end

--- Use an evolution item: flag the leftmost joker that needs it. Returns that joker or nil.
function P.evo_item_use(item_name, state)
  local target = P.evo_item_target(item_name, state)
  if target then
    local def = P.def(target)
    local flag = type(def.item_req) == 'table' and item_name or true
    P.set(target, 'poke_evolve', flag)
    target:punch()
    target:popup('Ready to evolve!', colors.ORANGE)
  end
  return target
end
P.evo_item_use_total = P.evo_item_use
P.highlighted_evo_item = P.evo_item_use

--- Whether a joker you own needs this item (item in_pool rule).
function P.evo_item_in_pool(item_name, state)
  state = state or cardlike.state
  for _, j in ipairs(state.jokers or {}) do
    for _, r in ipairs(reqs(P.def(j))) do if r == item_name then return true end end
  end
  return false
end

--- Consumable ids of the evolution items of a def or card.
function P.get_evo_item_keys(def_or_card)
  local def = P.def(def_or_card) or def_or_card
  local out = {}
  for _, r in ipairs(reqs(def)) do out[#out + 1] = I.id(r) end
  return out
end

--- A random evolution item that one of your jokers needs (consumable id), or nil.
function P.poll_evo_item(state)
  state = state or cardlike.state
  local set, list = {}, {}
  for _, j in ipairs(state.jokers or {}) do
    local r = reqs(P.def(j))
    if #r > 0 then
      local pick = r[state:random(1, #r)]
      local id = I.id(pick)
      if not set[id] and cardlike.contentInfo('consumable', id) then
        set[id] = true
        list[#list + 1] = id
      end
    end
  end
  return P.random_element(list, state)
end

--- Pickup: an item id or nil (34% nothing, 25% an evolution item, 20% Leftovers, 20% Twisted Spoon, 1% Transformation).
function P.generate_pickup_item_key(state)
  state = state or cardlike.state
  local r = state:randomFloat()
  if r < .34 then return nil end
  if r < .59 then return P.poll_evo_item(state) end
  if r < .79 then return I.id('leftovers') end
  if r < .99 then return I.id('twisted_spoon') end
  return I.id('transformation')
end

-- Popup text for a created consumable, by type.
local PLUS = { game = 'k_plus_tarot', fruit = 'k_plus_planet', admin = 'k_plus_spectral' }

--- Create a consumable (id, or a type such as 'pokermon:item') and show '+1 Item' on the card.
--- args: id string, or { key = id, set = type, edition = id, force = bool }. Returns the card or nil.
function P.create_consumeable(args, message_card)
  if type(args) == 'string' then args = { key = args } end
  local what = args.key and I.id(args.key) or args.set
  if what == 'poke_item' then what = P.MOD_ID .. ':item' end
  if what == 'poke_energy' then what = P.MOD_ID .. ':energy' end
  local edition = args.edition and (P.EDITION_IDS[args.edition] or args.edition)
  local card = cardlike.createConsumable(what, { edition = edition, force = args.force })
  if card then
    local t = card:getConsumableType()
    local text = '+1 Consumable'
    if t == P.MOD_ID .. ':item' then text = '+1 Item'
    elseif t == P.MOD_ID .. ':energy' then text = '+1 Energy'
    elseif t == 'game' then text = '+1 Game Card'
    elseif t == 'fruit' then text = '+1 Fruit Card'
    elseif t == 'admin' then text = '+1 Admin Card' end
    ;(message_card or card):popup(text, colors.PURPLE)
  end
  return card
end
P.create_consumable = P.create_consumeable

--- Remember the last Item used (for Twisted Spoon). Energy and Items call this when used.
function P.set_spoon_item(id)
  P.run.last_item = I.id(id)
end

--- Treasure (Drilbur line and others): money, evolution stones or rarely a Mega Stone.
function P.create_treasure(card, state, megastone)
  state = state or cardlike.state
  local t = state:randomFloat()
  local money, stones, mega = 0, 0, false
  if t > .70 then stones = 1
  elseif t > .40 then money = 5
  elseif t > .20 then stones = 2
  elseif t > .05 then money = 10
  elseif (megastone and t > 0.01) or not megastone then money = 20
  else mega = true end
  if money > 0 then P.ease_poke_dollars(card, 'treasure', money, false, state) end
  for _ = 1, stones do
    local options = {}
    for _, s in ipairs({ 'moonstone', 'sunstone', 'waterstone', 'leafstone', 'firestone', 'thunderstone', 'shinystone', 'dawnstone', 'duskstone' }) do
      local owned = false
      for _, c in ipairs(state.consumables or {}) do if c:getConsumableDef() == I.id(s) then owned = true end end
      if not owned then options[#options + 1] = s end
    end
    local pick = P.random_element(options, state)
    if pick then P.create_consumeable(pick, card) end
  end
  if mega then P.create_consumeable('megastone', card) end
end

---------------------------------------------------------------------------
-- Held items: reusable consumables (Mega Stone, Leftovers, Heavy-Duty Boots, ...)
-- Cardlike uses up a consumable when it is used, so a reusable one puts a copy of itself back into your consumables,
-- marked as used for this round ('poke_usable' = false in its data store). The copy works again next round.
---------------------------------------------------------------------------

--- Whether a reusable consumable can be used this round.
function I.usable(card)
  if not card or not card.uid then return true end
  return card:getDataStore():get('poke_usable') ~= false
end

--- Call at the end of a reusable consumable's action: puts the card back, used for this round.
--- extra: data store values to copy into the new card.
function I.keep_on_use(ctx, extra)
  local self = ctx.self
  local id = self and self:getConsumableDef()
  if not id then return nil end
  local values = {}
  local ds = self:getDataStore()
  for _, k in ipairs(ds:keys() or {}) do values[k] = ds:get(k) end
  local edition = self:getEdition()
  local copy = cardlike.createConsumable(id, { force = true, edition = edition ~= 'default' and edition or nil })
  if copy then
    local cds = copy:getDataStore()
    for k, v in pairs(values) do cds:set(k, v) end
    for k, v in pairs(extra or {}) do cds:set(k, v) end
    cds:set('poke_usable', false)
  end
  return copy
end

-- Reusable consumables work again after each round.
cardlike.on('onBlindDefeated', function(state)
  for _, c in ipairs(state.consumables or {}) do
    local ds = c:getDataStore()
    if ds:get('poke_usable') == false then
      ds:set('poke_usable', true)
      c:popup('Reset', colors.GREEN)
    end
  end
end)

--- 'Holding': a joker comes with a consumable when it joins (call from onAdded).
function P.holding(card, item, state)
  return P.create_consumeable(item, card)
end


== file lib/passives.lua (93 lines)
-- Passive effects: values that change while a joker is owned (Balatro add_to_deck / remove_from_deck), for example
-- +1 hand size or -1 discard. A def lists them in its passives field:
--   passives = { hand_size = 'h_size', discards = 'd_size', hazard_level = 'hazard_level' }
-- Each value is a config key (its value when the joker joins), '-key' (the negative), a number, or
-- function(card, state) returning a number. The library applies them when the joker joins (after the config defaults
-- and before def.onAdded) and takes them back when it leaves or evolves.
--
-- The change that really happened is kept in the card's data store ('poke_passive_<kind>'), so the joker gives back
-- exactly what it took: discards, hands left and slots never go below 0, and a later change of the value does not
-- change what is given back.
local P = cardlike.require('lib.base')

local function add_discards(state, n)
  local before = state.discardsPerRound
  state.discardsPerRound = math.max(0, before + n)
  state.discardsLeft = math.max(0, state.discardsLeft + n)
  return state.discardsPerRound - before
end

-- kind -> function(state, n) that applies n and returns the change that happened (nil: n).
P.PASSIVE_KINDS = {
  hand_size = function(state, n) state.handSize = state.handSize + n end,
  hands = function(state, n)
    state.handsPerRound = state.handsPerRound + n
    P.ease_hands_played(n, state)
  end,
  discards = add_discards,
  consumable_slots = function(state, n) state.additionalConsumableSlots = state.additionalConsumableSlots + n end,
  joker_slots = function(state, n) state.additionalJokerSlots = state.additionalJokerSlots + n end,
  shop_cards = function(state, n) state.cardsAvailableInShopCount = state.cardsAvailableInShopCount + n end,
  shop_packs = function(state, n) state.packsAvailableInShopCount = state.packsAvailableInShopCount + n end,
  scry = function(state, n)
    local before = P.run.scry_amount or 0
    P.scry.add(n)
    return (P.run.scry_amount or 0) - before
  end,
  hazard_level = function(state, n) P.change_hazard_level(n) end,
  hazard_max = function(state, n) P.change_hazard_max(n) end,
  growth = function(state, n) P.change_growth_level(n) end,
  energy_limit = function(state, n) P.run.energy_plus = (P.run.energy_plus or 0) + n end,
}
-- The order passives apply in (and are taken back in reverse).
P.PASSIVE_ORDER = { 'hand_size', 'hands', 'discards', 'consumable_slots', 'joker_slots', 'shop_cards', 'shop_packs',
  'scry', 'hazard_max', 'hazard_level', 'growth', 'energy_limit' }

local function amount_of(card, state, spec)
  if type(spec) == 'number' then return spec end
  if type(spec) == 'function' then return tonumber(spec(card, state)) or 0 end
  if type(spec) == 'string' then
    local neg = spec:sub(1, 1) == '-'
    local v = tonumber(P.get(card, neg and spec:sub(2) or spec, 0)) or 0
    return neg and -v or v
  end
  return 0
end

--- Apply a passive now and remember it on the card (it is taken back by P.remove_passives).
function P.add_passive(card, state, kind, n)
  local fn = P.PASSIVE_KINDS[kind]
  if not fn or not n or n == 0 then return 0 end
  local done = fn(state, n)
  if done == nil then done = n end
  local key = 'poke_passive_' .. kind
  P.set(card, key, (P.get(card, key, 0) or 0) + done)
  return done
end

--- Apply the passives of a def to a card that joins your jokers.
function P.apply_passives(card, state, def)
  if not card or not card.uid then return end
  local ds = card:getDataStore()
  -- a copied joker arrives with the record of the card it was copied from: it is not its own
  for _, kind in ipairs(P.PASSIVE_ORDER) do ds:delete('poke_passive_' .. kind) end
  if not def or not def.passives or not state then return end
  for _, kind in ipairs(P.PASSIVE_ORDER) do
    local spec = def.passives[kind]
    if spec ~= nil then P.add_passive(card, state, kind, amount_of(card, state, spec)) end
  end
end

--- Take back every passive a card applied (when it leaves your jokers or evolves).
function P.remove_passives(card, state)
  if not card or not card.uid or not state then return end
  local ds = card:getDataStore()
  for i = #P.PASSIVE_ORDER, 1, -1 do
    local kind = P.PASSIVE_ORDER[i]
    local key = 'poke_passive_' .. kind
    local done = ds:get(key)
    if type(done) == 'number' and done ~= 0 then P.PASSIVE_KINDS[kind](state, -done) end
    ds:delete(key)
  end
end


