    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      local target = poke.random_element(state.allCards or {}, state)
      if not target then return end
      target:setStamp(state:randomFloat() > 0.5 and 'Replay Stamp' or 'Fruit Stamp')
      card:punch()
      result:say(poke.text.dict('poke_mime_ex', 'Mime!'), colors.CHIPS)
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'mrmime') end,
}

-- Happiny 440: Baby, X0.5 Mult. Creates an Inverted Pearl (The Magician) at the end of the round, 1 in 3 chance for 2.
poke.addPokemon {
  name = 'happiny',
  rarity = 2,
  cost = 4,
  stage = 'Baby',
  ptype = 'Colorless',
  gen = 4,
  config = { Xmult_minus = 0.5, rounds = 2, num = 1, dem = 3 },
  attributes = { 'baby', 'tarot', 'generation', 'chance', 'round_evo' },
  vars = function(get, card, state)
    return { get('Xmult_minus'), get('rounds'), poke.chance_num(get('num'), state), get('dem') }
  end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      local count = 1
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then count = 2 end
      for _ = 1, count do poke.create_consumeable({ key = 'cart_card_13', edition = 'e_negative' }, card) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'chansey') end,
}

-- Munchlax 446: Baby, X0.5 Mult. Creates an Inverted Item at the end of the round.
poke.addPokemon {
  name = 'munchlax',
  rarity = 2,
  cost = 4,
  stage = 'Baby',
  ptype = 'Colorless',
  gen = 4,
  config = { Xmult_minus = 0.5, rounds = 2 },
  attributes = { 'baby', 'item', 'generation', 'round_evo' },
  vars = function(get) return { get('Xmult_minus'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      poke.create_consumeable({ set = 'poke_item', edition = 'e_negative' }, card)
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'snorlax') end,
}

-- Riolu 447: Baby, X0.9 Mult. Creates a SHIFT (Aura) at the end of the round (must have room).
poke.addPokemon {
  name = 'riolu',
  rarity = 3,
  cost = 6,
  stage = 'Baby',
  ptype = 'Fighting',
  gen = 4,
  config = { Xmult_minus = 0.9, rounds = 2 },
  attributes = { 'baby', 'spectral', 'generation', 'round_evo' },
  vars = function(get) return { get('Xmult_minus'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      if (state.freeConsumableSlots or 0) > 0 then poke.create_consumeable('admin_card_3', card) end
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'lucario') end,
}

local function has_edition(c)
  local e = c.lastInfo and c.lastInfo.edition or c:getEdition()
  return e ~= nil and e ~= 'default' and e ~= '' and e ~= 'none'
end

-- Lucario 448: each card with an edition held in hand gives X1.3 Mult. Appears only when a deck card has an edition.
poke.addPokemon {
  name = 'lucario',
  rarity = 3,
  cost = 9,
  stage = 'Basic',
  ptype = 'Fighting',
  gen = 4,
  config = { Xmult_multi = 1.3 },
  megas = { 'mega_lucario' },
  attributes = { 'editions', 'xmult' },
  vars = function(get) return { get('Xmult_multi') } end,
  in_pool = function(state)
    if not state or not state.allCards then return false end
    for _, c in ipairs(state.allCards) do
      if has_edition(c) then return true end
    end
    return false
  end,
  triggers = {
    onScoreInHand = function(card, state, step, result)
      if not has_edition(step.card) then return end
      if step.card:getDebuffState() then
        result:say('Debuffed', colors.MULT, step.card)
      else
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}

-- Mega Lucario 448-1: each card held in hand gives X1.6 Mult when 3 or more different editions are held.
poke.addPokemon {
  name = 'mega_lucario',
  rarity = 'poke_mega',
  cost = 11,
  stage = 'Mega',
  ptype = 'Fighting',
  gen = 4,
  config = { Xmult_multi = 1.6 },
  attributes = { 'editions', 'xmult' },
  vars = function(get) return { get('Xmult_multi') } end,
  triggers = {
    onScoreInHand = function(card, state, step, result)
      local seen, count = {}, 0
      for _, c in ipairs(state.cardsInHand or {}) do
        if has_edition(c) then
          local e = c.lastInfo and c.lastInfo.edition or c:getEdition()
          if not seen[e] then seen[e] = true count = count + 1 end
        end
      end
      if count < 3 then return end
      if step.card:getDebuffState() then
        result:say('Debuffed', colors.MULT, step.card)
      else
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      end
    end,
  },
}


== file jokers/pokejokers_16.lua (698 lines)
-- Pokemon jokers 451-480 (original pokemon/pokejokers_16.lua): Mantyke, Weavile, Magnezone, Lickilicky, Rhyperior,
-- Tangrowth, Electivire, Magmortar, Togekiss, Yanmega, Leafeon, Glaceon, Gliscor, Mamoswine, Porygon-Z, Gallade,
-- Probopass, Dusknoir, Froslass, Rotom and its five forms.
local poke = cardlike.require('lib.pokermon')

-- Rotom (every form): 1 in 2 chance to create an Item when a pack is opened.
local function rotom_pack_item(card, state, result)
  if state.freeConsumableSlots > 0 and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
    poke.create_consumeable({ set = 'poke_item' }, card)
  end
end

-- Mantyke 458
poke.addPokemon {
  name = 'mantyke',
  rarity = 2,
  cost = 6,
  stage = 'Baby',
  ptype = 'Water',
  gen = 4,
  config = { Xmult_minus = 0.75, rounds = 2 },
  attributes = { 'baby', 'tarot', 'generation', 'round_evo' },
  -- #1# (unused), #2# X Mult, #3# rounds
  vars = function(get) return { 0, get('Xmult_minus'), get('rounds') } end,
  triggers = {
    afterAllCardsScored = poke.baby_main,
    afterRound = function(card, state, step, result)
      -- an Inverted (Negative) The Devil: Cardlike's Star
      poke.create_consumeable({ key = 'cart_card_15', edition = 'e_negative' }, card)
    end,
  },
  evolution = function(card, state) return poke.level_evo(card, state, 'mantine') end,
}

-- Weavile 461
poke.addPokemon {
  name = 'weavile',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Dark',
  gen = 4,
  config = { Xmult_mod = 1, Xmult = 1, Xmult2 = 1, money = 4 },
  attributes = { 'rank', 'destroy_card', 'economy', 'xmult', 'scaling', 'reset', 'boss_blind' },
  vars = function(get) return { get('Xmult_mod'), get('Xmult'), poke.round_rank('sneaselcard'), get('money') } end,
  triggers = {
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(poke.get(card, 'Xmult')))
    end,
    finalScoring = function(card, state, step, result)
      if step.copiedBy then return end
      local all = step.hand.allCards or {}
      if #all ~= 1 or poke.rank_of(all[1]) ~= poke.round_rank_id('sneaselcard') then return end
      all[1]:destroy()
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
      result:add(plusMoney(poke.ease_poke_dollars(card, 'weavile', poke.get(card, 'money'), true, state)))
    end,
    afterRound = function(card, state, step, result)
      if step.copiedBy or not (state.blind and state.blind.boss) or poke.get(card, 'Xmult') <= 1 then return end
      poke.set(card, 'Xmult', poke.get(card, 'Xmult2'))
      result:say('Reset', colors.MULT)
    end,
  },
}

-- Magnezone 462
poke.addPokemon {
  name = 'magnezone',
  rarity = 'poke_safari',
  cost = 10,
  enhancement_gate = 'Wooden',
  stage = 'Two',
  ptype = 'Lightning',
  gen = 4,
  config = { Xmult_multi = 1.5, Xmult_multi2 = .25 },
  attributes = { 'xmult', 'enhancements', 'types', 'joker' },
  vars = function(get, card, state)
    local total = state and #poke.find_pokemon_type('Metal', nil, nil, state) or 0
    return { get('Xmult_multi'), get('Xmult_multi2'), get('Xmult_multi') + total * get('Xmult_multi2') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or not poke.has_enhancement(step.card, 'm_steel') then return end
      local total = #poke.find_pokemon_type('Metal', nil, nil, state)
      result:add(xMult(poke.get(card, 'Xmult_multi') + total * poke.get(card, 'Xmult_multi2')))
    end,
  },
}

-- Lickilicky 463
poke.addPokemon {
  name = 'lickilicky',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Colorless',
  gen = 4,
  config = { Xmult_multi = 1.5, subtract = 0.3 },
  attributes = { 'xmult', 'rank', 'jack' },
  vars = function(get) return { get('Xmult_multi'), get('Xmult_multi') - get('subtract') } end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or poke.rank_of(step.card) ~= 11 then return end
      local first, second
      for _, c in ipairs(step.hand.playedCards or {}) do
        if poke.rank_of(c) == 11 then
          if not first then first = c else second = c break end
        end
      end
      if step.card == first or step.card == second then
        result:add(xMult(poke.get(card, 'Xmult_multi')))
      else
        result:add(xMult(poke.get(card, 'Xmult_multi') - poke.get(card, 'subtract')))
      end
    end,
  },
}

-- Rhyperior 464
local function rhyperior_retriggers(state)
  return 1 + math.floor(#poke.find_pokemon_type('Earth', nil, nil, state) / 3)
end
poke.addPokemon {
  name = 'rhyperior',
  rarity = 'poke_safari',
  cost = 10,
  enhancement_gate = 'Rock',
  stage = 'Two',
  ptype = 'Earth',
  gen = 4,
  config = { chips = 8 },
  attributes = { 'chips', 'perma_bonus', 'modify_card', 'enhancements', 'retrigger', 'types', 'joker' },
  vars = function(get, card, state) return { get('chips'), state and rhyperior_retriggers(state) or 1 } end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or not poke.has_enhancement(step.card, 'm_stone') then return end
      step.card:addAdditionalPointValue(poke.get(card, 'chips'))
      result:say('Upgrade!', colors.CHIPS, step.card)
    end,
    repeatCard = function(card, state, step, result)
      if poke.has_enhancement(step.card, 'm_stone') then return rhyperior_retriggers(state) end
    end,
  },
}

-- Tangrowth 465
poke.addPokemon {
  name = 'tangrowth',
  rarity = 'poke_safari',
  cost = 10,
  enhancement_gate = 'Plaid',
  stage = 'One',
  ptype = 'Grass',
  gen = 4,
  config = { mult = 15, chips = 75, money_mod = 3, num = 1, dem = 4 },
  -- Plaid (Wild) cards cannot be debuffed (the library takes the debuff off again: lib/rules.lua)
  prevent_debuff = function(c) return poke.has_enhancement(c, 'm_wild') end,
  attributes = { 'chips', 'mult', 'economy', 'enhancements', 'chance' },
  vars = function(get, card, state)
    return { get('mult'), get('chips'), get('money_mod'), poke.chance_num(get('num'), state), get('dem') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) or not poke.has_enhancement(step.card, 'm_wild') then return end
      local money = function() return plusMoney(poke.ease_poke_dollars(card, 'tangrowth', poke.get(card, 'money_mod'), true, state)) end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        result:add(plusMult(poke.get(card, 'mult')))
        result:add(plusChips(poke.get(card, 'chips')))
        result:add(money())
        result:say(poke.text.dict('poke_tangela_bonus', 'All!'), colors.GREEN)
      else
        local r = state:random(1, 3)
        if r == 1 then result:add(plusMult(poke.get(card, 'mult')))
        elseif r == 2 then result:add(plusChips(poke.get(card, 'chips')))
        else result:add(money()) end
      end
    end,
  },
}

-- Electivire 466
local function electivire_sell(card)
  if not card then return 3 end
  return card:getSellValue() or 0
end
poke.addPokemon {
  name = 'electivire',
  rarity = 'poke_safari',
  cost = 7,
  stage = 'One',
  ptype = 'Lightning',
  gen = 4,
  config = { money_mod = 2, Xmult_mod = 0.02 },
  attributes = { 'sell_value', 'scaling', 'economy', 'xmult' },
  vars = function(get, card)
    return { get('money_mod'), get('Xmult_mod'), 1 + get('Xmult_mod') * electivire_sell(card) }
  end,
  -- Sell value grows in whole dollars; the fraction from energized values carries over (poke.sell_value_up).
  triggers = {
    onCardSold = function(card, state, step, result)
      if not step.copiedBy then poke.sell_value_up(card, poke.get(card, 'money_mod')) end
    end,
    afterRound = function(card, state, step, result)
      if not step.copiedBy then poke.sell_value_up(card, poke.get(card, 'money_mod')) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      result:add(xMult(1 + poke.get(card, 'Xmult_mod') * electivire_sell(card)))
    end,
  },
}

-- Magmortar 467
poke.addPokemon {
  name = 'magmortar',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Fire',
  gen = 4,
  config = { mult = 0, mult_mod = 2, Xmult = 1, Xmult_mod = 0.05 },
  attributes = { 'discard', 'destroy_card', 'mult', 'scaling', 'xmult' },
  vars = function(get) return { get('mult'), get('mult_mod'), get('Xmult'), get('Xmult_mod') } end,
  triggers = {
    onDiscard = function(card, state, step, result)
      if step.copiedBy then return end
      poke.add(card, 'Xmult', poke.get(card, 'Xmult_mod'))
      result:say('X' .. poke.text.num(poke.get(card, 'Xmult')), colors.MULT)
    end,
    -- first discard of the round with one card (discardsUsed already counts it)
    onDiscardCard = function(card, state, step, result)
      if step.copiedBy or state.discardsUsed ~= 1 or #(step.discardedCards or {}) ~= 1 then return end
      poke.add(card, 'mult', poke.get(card, 'mult_mod'))
      result:say('+' .. poke.text.num(poke.get(card, 'mult')), colors.MULT)
      return true
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult, x = poke.get(card, 'mult'), poke.get(card, 'Xmult')
      if mult > 0 or x > 1 then
        if mult > 0 then result:add(plusMult(mult)) end
        if x > 1 then result:add(xMult(x)) end
        result:say(poke.text.dict('poke_fire_blast_ex', 'Fire Blast!'), colors.MULT)
      end
    end,
  },
}

-- Togekiss 468: +1 to the numerator of every chance. Cardlike chances are plain probabilities, so a chance p becomes
-- p x 2 (exact for "1 in X" odds): chance_mod, the library's chance filter.
poke.addPokemon {
  name = 'togekiss',
  rarity = 'poke_safari',
  cost = 10,
  stage = 'One',
  ptype = 'Fairy',
  gen = 4,
  config = { num = 1, chip_dem = 5, Xmult_dem = 10, chips = 100, Xmult_multi = 1.5, plus_odds = 1 },
  chance_mod = 'plus_odds_flat',
  attributes = { 'enhancements', 'chance', 'passive', 'chance_mod', 'chips', 'xmult' },
  vars = function(get, card, state)
    return { poke.chance_num(get('num'), state), get('chip_dem'), get('Xmult_dem'), get('chips'), get('Xmult_multi'), get('plus_odds') }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if not poke.has_enhancement(step.card, 'm_lucky') then return end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'chip_dem')) then result:add(plusChips(poke.get(card, 'chips'))) end
      if state:chance(poke.get(card, 'num') / poke.get(card, 'Xmult_dem')) then result:add(xMult(poke.get(card, 'Xmult_multi'))) end
    end,
  },
}

-- Yanmega 469
poke.addPokemon {
  name = 'yanmega',
  rarity = 'poke_safari',
  cost = 8,
  stage = 'One',
  ptype = 'Grass',
  gen = 4,
  config = { mult_mod = 6, chip_mod = 12, num = 1, dem = 3, retriggers = 1 },
  attributes = { 'chips', 'mult', 'rank', 'three', 'six', 'chance', 'retrigger' },
  vars = function(get, card, state) return { get('mult_mod'), get('chip_mod'), poke.chance_num(get('num'), state), get('dem') } end,
  triggers = {
    onScore = function(card, state, step, result)
      local r = poke.rank_of(step.card)
      if r == 3 or r == 6 then
        result:add(plusMult(poke.get(card, 'mult_mod')))
        result:add(plusChips(poke.get(card, 'chip_mod')))
      end
    end,
    repeatCard = function(card, state, step, result)
      local r = poke.rank_of(step.card)
      if (r == 3 or r == 6) and state:chance(poke.get(card, 'num') / poke.get(card, 'dem')) then
        return poke.get(card, 'retriggers')
      end
    end,
  },
}

