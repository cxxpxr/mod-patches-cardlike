-- Gligar 207
local function gligar_count(state, skip_selected)
  local suit = poke.round_target('gligar_suit', 'Clubs')
  local n = 0
  for _, c in ipairs(state and state.cardsInHand or {}) do
    if c:isSuit(suit) and not (skip_selected and (c.lastInfo or {}).selected) then n = n + 1 end
  end
  return n
end

poke.addPokemon {
  name = 'gligar', rarity = 3, cost = 8, stage = 'Basic', ptype = 'Earth', gen = 2,
  item_req = 'duskstone',
  config = { Xmult_multi = 0.15 },
  attributes = { 'xmult', 'suit', 'item_evo' },
  vars = function(get, card, state)
    local suit = poke.round_target('gligar_suit', 'Clubs')
    local current = 1
    if state and state.cardsInHand then current = 1 + get('Xmult_multi') * gligar_count(state, true) end
    return { get('Xmult_multi'), poke.suit_name(suit), current, colours = { poke.suit_colour(suit) } }
  end,
  triggers = {
    onScore = function(card, state, step, result)
      if poke.is_debuffed(step.card) then return end
      local n = gligar_count(state, false)
      if n > 0 then result:add(xMult(1 + poke.get(card, 'Xmult_multi') * n)) end
    end,
  },
  evolution = function(card, state) return poke.item_evo(card, state, 'gliscor') end,
}

