poke.addPokemon {
  name = 'suicune', rarity = 4, cost = 20, stage = 'Legendary', ptype = 'Water', gen = 2,
  config = { chips_max = 50 },
  attributes = { 'chips', 'modify_card', 'perma_bonus' },
  vars = function(get) return { get('chips_max') } end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      local max = poke.get(card, 'chips_max')
      for _, c in ipairs(step.hand.playedCards) do
        c:addAdditionalPointValue(math.min(max, c:getPointValue()))
      end
      result:say('Upgrade!', colors.CHIPS)
    end,
  },
}

