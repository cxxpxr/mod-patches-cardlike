poke.addPokemon {
  name = 'gyarados', rarity = 'poke_safari', cost = 10, stage = 'One', ptype = 'Water', gen = 1,
  config = { Xmult = 2.5 },
  vars = function(get) return { get('Xmult') } end,
  megas = { 'mega_gyarados' },
