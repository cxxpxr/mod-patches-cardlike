    return { get('chips'), poke.chance_num(get('num'), state), get('dem'), get('chips2') }
  end,
  triggers = { afterAllCardsScored = spider_score },
}

-- Crobat 169: removes the enhancement of scoring cards and gains Mult, Points, X Mult or payout by enhancement type.
local CROBAT_KIND = {
  Chipped = 'chips', Rock = 'chips',
  Wooden = 'Xmult', Fragile = 'Xmult', ['pokermon:flower'] = 'Xmult',
  Gilded = 'money',
}
local CROBAT_MOD = { mult = 'mult_mod', chips = 'chip_mod', Xmult = 'Xmult_mod', money = 'money_mod' }
poke.addPokemon {
  name = 'crobat', rarity = 'poke_safari', cost = 10, stage = 'Two', ptype = 'Dark', gen = 2,
  config = { mult = 0, mult_mod = 2, chips = 0, chip_mod = 15, Xmult = 1, Xmult_mod = .1, money = 0, money_mod = 1 },
  attributes = { 'chips', 'mult', 'xmult', 'economy', 'modify_card', 'enhancements', 'scaling' },
  vars = function(get)
    return { get('mult'), get('mult_mod'), get('chips'), get('chip_mod'), get('Xmult'), get('Xmult_mod'), get('money'), get('money_mod') }
  end,
  triggers = {
    beforeAllCardsScored = function(card, state, step, result)
      if step.copiedBy then return end
      local counts = { mult = 0, chips = 0, Xmult = 0, money = 0 }
      local any = false
      for _, c in ipairs(step.hand.playedCards or {}) do
        local e = c:getEnhancement()
        if e and e ~= 'Default' and not c:getDebuffState() then
          local kind = CROBAT_KIND[e] or 'mult'
          counts[kind] = counts[kind] + 1
          c:setEnhancement('Default')
          c:punch()
          any = true
        end
      end
      for kind, n in pairs(counts) do
        if n > 0 then poke.add(card, kind, poke.get(card, CROBAT_MOD[kind]) * n) end
      end
      if any then result:say(poke.text.dict('poke_leech_life_ex', 'Leech!'), colors.PURPLE) end
    end,
    afterAllCardsScored = function(card, state, step, result)
      local mult, chips, x = poke.get(card, 'mult'), poke.get(card, 'chips'), poke.get(card, 'Xmult')
      if mult ~= 0 then result:add(plusMult(mult)) end
      if chips ~= 0 then result:add(plusChips(chips)) end
      if x ~= 1 then result:add(xMult(x)) end
      if mult ~= 0 or chips ~= 0 or x ~= 1 then result:say(poke.text.dict('poke_screech_ex', 'Skree!'), colors.GREY) end
    end,
  },
  dollarsAtRoundEnd = function(card, state)
    local money = poke.get(card, 'money')
    if money > 0 then return poke.ease_poke_dollars(card, 'crobat', money, true, state) end
    return 0
  end,
}

-- Chinchou 170: +40 Points and $1 if the played hand contains a Pair.
poke.addPokemon {
