-- Pokemon jokers 571-600 (Zoroark, Gothita line, Vanillite line, Frillish, Jellicent, Ferroseed, Ferrothorn, Klink,
-- Klang). Port of pokejokers_20.lua.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Gothita line: Fruit cards (Planet cards) and Fruit Packs (Celestial Packs) cost less in the shop.
---------------------------------------------------------------------------

local function is_fruit_item(card)
  local info = card and card.lastInfo
  if not info then return false end
  if info.kind == 'consumable' and info.type == 'fruit' then return true end
  if info.kind == 'pack' and type(info.name) == 'string' and info.name:find('Fruit') then return true end
  return false
end

cardlike.filter('price', function(price, card)
  local state = cardlike.state
  if not state or state.money == nil or not is_fruit_item(card) then return nil end
  if state:hasJoker(poke.id('gothitelle')) then return 0 end
  local off = 2 * state:countJoker(poke.id('gothita')) + 3 * state:countJoker(poke.id('gothorita'))
  if off > 0 then return math.max(0, price - off) end
  return nil
end)

---------------------------------------------------------------------------
-- Ferroseed line: Plaid (Wild) cards and Hazard cards are also Wooden (Steel) cards: X1.5 Mult when held in hand.
---------------------------------------------------------------------------

local STEEL_XMULT = 1.5

local function steel_active(state)
  for _, j in ipairs(state.jokers or {}) do
    local name = poke.name(j)
    if (name == 'ferroseed' or name == 'ferrothorn') and not (j.lastInfo or {}).debuffed then return true end
  end
  return false
end

local function extra_steel(card)
  return poke.has_enhancement(card, 'm_wild') or poke.has_enhancement(card, 'm_poke_hazard')
end

local function counts_as_steel(card, state)
  if poke.has_enhancement(card, 'm_steel') then return true end
  return extra_steel(card) and steel_active(state)
end

cardlike.on('onScoreInHand', function(state, step, result)
  local c = step.card
  if not c or (c.lastInfo or {}).debuffed then return end
  if extra_steel(c) and not poke.has_enhancement(c, 'm_steel') and steel_active(state) then
    result:add(xMult(STEEL_XMULT))
  end
end)

-- Klink line: counts the cards drawn during Blinds.
local function klink_draw(card, state, step, result, seed)
  if step.copiedBy then return false end
  local drawn = poke.add(card, 'drawn', #poke.drawn_cards(state, step))
  local to_draw = poke.get(card, 'to_draw')
  if drawn >= to_draw then
    local earned = poke.ease_poke_dollars(card, seed, poke.get(card, 'money') * math.floor(drawn / to_draw), true, state)
    poke.set(card, 'drawn', drawn % to_draw)
    poke.add(card, 'totalEarned', earned)
    result:add(plusMoney(earned))
    return true
  end
  return false
end

---------------------------------------------------------------------------

-- Zoroark 571: copies the ability of the rightmost joker (lib/copy.lua).
poke.addPokemon {
  name = 'zoroark',
  rarity = 'poke_safari',
