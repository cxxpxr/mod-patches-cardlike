-- Pokemon jokers 211-240 (original file pokemon/pokejokers_08.lua): Qwilfish to Magby.
local poke = cardlike.require('lib.pokermon')

---------------------------------------------------------------------------
-- Local helpers
---------------------------------------------------------------------------

-- The English text of a joker without its first n lines (for lines whose effect Cardlike cannot do).
local function text_without(name, n)
  local entry = poke.text.entry('Joker', 'j_poke_' .. name)
  local out = {}
  for i, line in ipairs(entry and entry.text or {}) do if i > n then out[#out + 1] = line end end
  return out
end

-- Slugma and Magcargo (Balatro Loyalty Card formula over the hands played since the joker joined): every few hands
-- they gain Points and the first card held in hand is destroyed after the hand.
local function loyalty_before(card, state, step, result)
  if step.copiedBy then return end
  local rem = poke.loyalty_remaining(card, state)
  poke.set(card, 'loyalty_remaining', rem)
  if rem == poke.get(card, 'every', 3) then
    if #(state.cardsInHand or {}) > 0 then poke.set(card, 'remove', true) end
    poke.add(card, 'chips', poke.get(card, 'chip_mod'))
    result:say(poke.text.dict('k_upgrade_ex', 'Upgrade!'), colors.CHIPS)
  end
end

local function loyalty_after(card, state, step)
  if step.copiedBy or not poke.get(card, 'remove') then return end
  poke.set(card, 'remove', false)
  local first = (state.cardsInHand or {})[1]
  if first then poke.remove_card(first, card) end
end

